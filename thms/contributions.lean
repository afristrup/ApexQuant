import Mathlib

open MeasureTheory ProbabilityTheory Finset
open scoped ENNReal NNReal Real

namespace Progressive

/-! ## §1  The pass recursion (eq. 2.2), deterministically

The paper's eq. (2.2) is

  `s_p = ‖r_p‖,  u_p = R_p r_p / s_p,  r_{p+1} = r_p - s_p R_pᵀ q(u_p)`,  `r_0 = w`.

Everything in this section is exact linear algebra in a real inner product space: no
probability, no coordinates, no assumption on `q` whatsoever. -/
section Deterministic

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The data of a progressive (multistage) quantiser: a stream of rotations `R_p`, and a
**single fixed** quantiser `q` reused at every pass.  That `q` does not depend on `p` is the
paper's central design claim; it is expressed here by the type. -/
structure Scheme (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℝ E] where
  /-- `rot p` is the rotation `R_p` applied at pass `p`. -/
  rot : ℕ → (E ≃ₗᵢ[ℝ] E)
  /-- the codebook rounding map; in the paper, nearest-neighbour rounding applied
  coordinate-wise to a `2^b`-level Lloyd–Max codebook for `f_d`. -/
  q : E → E

variable (S : Scheme E) (w : E)

/-- `resid S w p` is `r_p` of eq. (2.2). -/
noncomputable def resid : ℕ → E
  | 0 => w
  | p + 1 =>
      resid p - ‖resid p‖ • (S.rot p).symm (S.q (‖resid p‖⁻¹ • S.rot p (resid p)))

/-- `unitVec S w p` is `u_p = R_p r_p / ‖r_p‖` of eq. (2.2).

At `r_p = 0` this evaluates to `0` by Lean's `(0 : ℝ)⁻¹ = 0` convention; every statement below
that mentions `u_p` is either guarded by `r_p ≠ 0` or is trivially true at `r_p = 0`. -/
noncomputable def unitVec (p : ℕ) : E := ‖resid S w p‖⁻¹ • S.rot p (resid S w p)

/-- The *code* emitted at pass `p`: the scale `s_p` (stored as one fp16 number per group) and
the codeword `q(u_p)` (stored as `d` `b`-bit indices).  This pair is the entire artifact of
pass `p`. -/
noncomputable def code (p : ℕ) : ℝ × E := (‖resid S w p‖, S.q (unitVec S w p))

@[simp] theorem resid_zero : resid S w 0 = w := rfl

theorem resid_succ (p : ℕ) :
    resid S w (p + 1) = resid S w p - ‖resid S w p‖ • (S.rot p).symm (S.q (unitVec S w p)) :=
  rfl

/-- `‖u_p‖ = 1` whenever the pass is not already exact. -/
theorem norm_unitVec (p : ℕ) (h : resid S w p ≠ 0) : ‖unitVec S w p‖ = 1 := by
  rw [unitVec, norm_smul, LinearIsometryEquiv.norm_map, norm_inv, norm_norm,
    inv_mul_cancel₀ (norm_ne_zero_iff.mpr h)]

/-- **The per-pass identity, exactly.**  The residual of pass `p+1` is the pass-`p` scale times
the pulled-back quantisation error of the unit direction.  This is the step the paper writes as
"because `R_p` is orthogonal, `‖r_{p+1}‖² = s_p² ‖u_p - q(u_p)‖²`", and it holds *identically*,
no probability, no hypothesis on `q`, and including the degenerate case `r_p = 0`. -/
theorem resid_succ_eq_smul (p : ℕ) :
    resid S w (p + 1)
      = ‖resid S w p‖ • (S.rot p).symm (unitVec S w p - S.q (unitVec S w p)) := by
  rw [resid_succ, map_sub, smul_sub]
  congr 1
  rw [unitVec, map_smul, LinearIsometryEquiv.symm_apply_apply, smul_smul]
  rcases eq_or_ne (resid S w p) 0 with h | h
  · simp [h]
  · rw [mul_inv_cancel₀ (norm_ne_zero_iff.mpr h), one_smul]

/-- The norm form of `resid_succ_eq_smul`: `‖r_{p+1}‖ = ‖r_p‖ · ‖u_p - q(u_p)‖`. -/
theorem norm_resid_succ (p : ℕ) :
    ‖resid S w (p + 1)‖ = ‖resid S w p‖ * ‖unitVec S w p - S.q (unitVec S w p)‖ := by
  rw [resid_succ_eq_smul, norm_smul, LinearIsometryEquiv.norm_map, norm_norm]

/-- The squared form, which is what Proposition 2 iterates. -/
theorem norm_resid_succ_sq (p : ℕ) :
    ‖resid S w (p + 1)‖ ^ 2
      = ‖resid S w p‖ ^ 2 * ‖unitVec S w p - S.q (unitVec S w p)‖ ^ 2 := by
  rw [norm_resid_succ, mul_pow]

/-- The residual norms are non-increasing along passes **iff** each pass does not increase the
normalised error; the paper's `ρ < 1` regime.  Stated as a hypothesis-carrying lemma rather
than assumed. -/
theorem norm_resid_le_of_contract {c : ℝ} (hc : 0 ≤ c)
    (h : ∀ p, ‖unitVec S w p - S.q (unitVec S w p)‖ ≤ c) (P : ℕ) :
    ‖resid S w P‖ ≤ c ^ P * ‖w‖ := by
  induction P with
  | zero => simp
  | succ P ih =>
      rw [norm_resid_succ]
      calc ‖resid S w P‖ * ‖unitVec S w P - S.q (unitVec S w P)‖
          ≤ (c ^ P * ‖w‖) * c :=
            mul_le_mul ih (h P) (norm_nonneg _) (mul_nonneg (pow_nonneg hc P) (norm_nonneg _))
        _ = c ^ (P + 1) * ‖w‖ := by ring

/-! ### Reconstruction and the telescoping identity -/

/-- `recon S w P = ŵ_P = ∑_{p<P} s_p R_pᵀ q(u_p)`, the `P`-pass reconstruction. -/
noncomputable def recon (P : ℕ) : E :=
  ∑ p ∈ range P, ‖resid S w p‖ • (S.rot p).symm (S.q (unitVec S w p))

@[simp] theorem recon_zero : recon S w 0 = 0 := by simp [recon]

/-- Auxiliary: the telescoping identity `w - ŵ_P = r_P`, from which `sub_recon` (§2) follows. -/
private theorem aux_sub_recon (P : ℕ) : w - recon S w P = resid S w P := by
  induction P with
  | zero => simp
  | succ P ih =>
      have hr : recon S w (P + 1)
          = recon S w P + ‖resid S w P‖ • (S.rot P).symm (S.q (unitVec S w P)) := by
        simp [recon, Finset.sum_range_succ]
      rw [hr, ← sub_sub, ih, ← resid_succ]

/-- **`w - ŵ_P = r_P`**: the residual after `P` passes *is* the reconstruction error, so the
error of the `P`-pass model is exactly the object Proposition 2 bounds. -/
theorem sub_recon (P : ℕ) : w - recon S w P = resid S w P := aux_sub_recon S w P

/-! ### §2  Nested decoding: the any-prefix property

The paper (§7) claims: *"pass `p` depends only on the residual of passes `< p`, so the first `P'`
passes of a `P`-pass artifact are, bit for bit, the `P'`-pass quantisation."*

The substantive half is `code_stable_of_rot_eq`: the pass-`p` code is unchanged by any
modification of the rotation stream at indices `≥ p`.  `encode_take` is then the literal
prefix statement. -/

/-- The `P`-pass artifact: the list of codes actually written to storage. -/
noncomputable def encode (P : ℕ) : List (ℝ × E) := (List.range P).map (code S w)

/-- Passes are determined by the rotations that precede them: if two schemes share the
quantiser and agree on the first `P'` rotations, their residuals agree up to pass `P'`. -/
theorem resid_stable_of_rot_eq {S₁ S₂ : Scheme E} (hq : S₁.q = S₂.q) {P' : ℕ}
    (hrot : ∀ p < P', S₁.rot p = S₂.rot p) (w : E) :
    ∀ p ≤ P', resid S₁ w p = resid S₂ w p := by
  intro p
  induction p with
  | zero => intro _; rfl
  | succ n ih =>
    intro hn
    have hn' : n < P' := hn
    have ihn := ih (Nat.le_of_lt hn')
    simp only [resid_succ, unitVec, ihn, hrot n hn', hq]

/-- …and therefore emit the same codes on the shared prefix. -/
theorem code_stable_of_rot_eq {S₁ S₂ : Scheme E} (hq : S₁.q = S₂.q) {P' : ℕ}
    (hrot : ∀ p < P', S₁.rot p = S₂.rot p) (w : E) :
    ∀ p < P', code S₁ w p = code S₂ w p := by
  intro p hp
  have hr := resid_stable_of_rot_eq hq hrot w p (Nat.le_of_lt hp)
  simp only [code, unitVec, hr, hrot p hp, hq]

/-- **Any-prefix property.**  The first `P'` entries of the `P`-pass artifact *are* the
`P'`-pass artifact, for every `P' ≤ P`.  One stored object serves every operating point
`P' ≤ P` with no re-quantisation. -/
theorem encode_take {P' P : ℕ} (h : P' ≤ P) :
    (encode S w P).take P' = encode S w P' := by
  simp only [encode, ← List.map_take, List.take_range, Nat.min_eq_left h]

/-- The prefix reconstruction is likewise the `P'`-pass reconstruction, with reconstruction
error exactly `r_{P'}`, so every prefix is itself an honest `P'`-pass quantised model
(the sense in which Corollary 1 applies to each tier). -/
theorem recon_prefix (P' : ℕ) : w - recon S w P' = resid S w P' := sub_recon S w P'

/-- **The paper's nesting claim, composed.**  The first `P'` codes of a `P`-pass artifact are
identical to the artifact of an *independently run* `P'`-pass quantisation under any scheme with
the same codebook and the same first `P'` rotations.  This is the "bit for bit, the `P'`-pass
quantisation" statement the paper verifies empirically; `encode_take` alone only re-reads one
scheme's own list and is pure list algebra. -/
theorem encode_take_eq {S₁ S₂ : Scheme E} (hq : S₁.q = S₂.q) {P' P : ℕ} (hP : P' ≤ P)
    (hrot : ∀ p < P', S₁.rot p = S₂.rot p) (w : E) :
    (encode S₁ w P).take P' = encode S₂ w P' := by
  rw [encode_take S₁ w hP]
  simp only [encode]
  refine List.map_congr_left ?_
  intro p hp
  exact code_stable_of_rot_eq hq hrot w p (List.mem_range.mp hp)

end Deterministic

/-! ## §3  Proposition 2 (geometric decay)

The paper's Proposition 2 asserts `E‖r_{p+1}‖² = ρ² E‖r_p‖²`, hence `√(E‖r_P‖²)/‖w‖ = ρ^P`.

Its proof uses exactly two probabilistic inputs, isolated here as `IsotropicPasses`:

* `indep p`: the normalised direction's squared quantisation error is independent of the
  squared scale.  Theorem 1 (§5) supplies this, `u_p ⟂ r_p` gives `u_p ⟂ s_p`.
* `distortion p`: every pass sees the *same* expected normalised distortion `ρ²`.
  Corollary 1 (§6) plus Lemma 1 (§4) supply this, the coordinate marginals are `f_d` at
  every pass, so the expectation is the same number `ρ²` at every pass.

Note what is *absent*: the closed form of `f_d`, the optimality of the codebook, and any
concentration statement.  Proposition 2 is an identity in expectation and nothing more. -/

section Decay

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}

/-- The two hypotheses Proposition 2 actually consumes, for a random weight row `W`. -/
structure IsotropicPasses (S : Ω → Scheme E) (W : Ω → E) (ρ : ℝ) (μ : Measure Ω) : Prop where
  /-- integrability of the squared residual norms (implicit in the paper). -/
  integrable : ∀ p, Integrable (fun ω => ‖resid (S ω) (W ω) p‖ ^ 2) μ
  /-- the pass-`p` squared normalised distortion is integrable. -/
  integrable_err : ∀ p,
    Integrable (fun ω => ‖unitVec (S ω) (W ω) p - (S ω).q (unitVec (S ω) (W ω) p)‖ ^ 2) μ
  /-- **direction ⟂ scale**, supplied by Theorem 1. -/
  indep : ∀ p, IndepFun (fun ω => ‖resid (S ω) (W ω) p‖ ^ 2)
    (fun ω => ‖unitVec (S ω) (W ω) p - (S ω).q (unitVec (S ω) (W ω) p)‖ ^ 2) μ
  /-- **every pass has the same normalised distortion `ρ²`**, supplied by Theorem 1 +
  Lemma 1: the coordinate marginals are `f_d` at every pass, so this expectation does not
  depend on `p`. -/
  distortion : ∀ p,
    ∫ ω, ‖unitVec (S ω) (W ω) p - (S ω).q (unitVec (S ω) (W ω) p)‖ ^ 2 ∂μ = ρ ^ 2

variable {S : Ω → Scheme E} {W : Ω → E} {ρ : ℝ}

/-- **Proposition 2, one pass.**  `E‖r_{p+1}‖² = ρ² · E‖r_p‖²`. -/
theorem integral_norm_resid_sq_succ [IsProbabilityMeasure μ]
    (h : IsotropicPasses S W ρ μ) (p : ℕ) :
    ∫ ω, ‖resid (S ω) (W ω) (p + 1)‖ ^ 2 ∂μ = ρ ^ 2 * ∫ ω, ‖resid (S ω) (W ω) p‖ ^ 2 ∂μ := by
  -- The deterministic per-pass identity `‖r_{p+1}‖² = ‖r_p‖² · ‖u_p - q u_p‖²` (§1),
  -- then independence to split the expectation of the product, then `distortion p`.
  have hpt : ∀ ω, ‖resid (S ω) (W ω) (p + 1)‖ ^ 2
      = ‖resid (S ω) (W ω) p‖ ^ 2 * ‖unitVec (S ω) (W ω) p - (S ω).q (unitVec (S ω) (W ω) p)‖ ^ 2 :=
    fun ω => norm_resid_succ_sq (S ω) (W ω) p
  simp_rw [hpt]
  rw [(h.indep p).integral_fun_mul_eq_mul_integral
      (h.integrable p).aestronglyMeasurable (h.integrable_err p).aestronglyMeasurable,
    h.distortion p, mul_comm]

/-- **Proposition 2.**  `E‖r_P‖² = ρ^{2P} · E‖w‖²` for every `P`. -/
theorem integral_norm_resid_sq [IsProbabilityMeasure μ]
    (h : IsotropicPasses S W ρ μ) (P : ℕ) :
    ∫ ω, ‖resid (S ω) (W ω) P‖ ^ 2 ∂μ = ρ ^ (2 * P) * ∫ ω, ‖W ω‖ ^ 2 ∂μ := by
  induction P with
  | zero => simp
  | succ P ih =>
      rw [integral_norm_resid_sq_succ h P, ih, Nat.mul_succ, pow_add]
      ring

/-- **Proposition 2, eq. (2.5)**, in the form the paper states it: for a *deterministic* weight
row `w` (the expectation is over the rotations alone, as the paper's proof notes), the RMS
relative error after `P` passes is exactly `ρ^P`. -/
theorem rms_relative_error [IsProbabilityMeasure μ] {w : E} (hw : w ≠ 0) (hρ : 0 ≤ ρ)
    (h : IsotropicPasses S (fun _ => w) ρ μ) (P : ℕ) :
    Real.sqrt (∫ ω, ‖resid (S ω) w P‖ ^ 2 ∂μ) / ‖w‖ = ρ ^ P := by
  -- NOTE ON `hρ`: the hypothesis `0 ≤ ρ` is genuinely load-bearing, not cosmetic.
  -- `IsotropicPasses` constrains `ρ` only through `ρ ^ 2` (field `distortion`), so it is
  -- invariant under `ρ ↦ -ρ`; the conclusion is not, for odd `P`.  Without `hρ` the
  -- statement is FALSE, see the report accompanying this fragment for an explicit
  -- counterexample.  The honest unconditional form of eq. (2.5) is `= |ρ| ^ P`.
  have h1 : ∫ ω, ‖resid (S ω) w P‖ ^ 2 ∂μ = ρ ^ (2 * P) * ∫ _ω : Ω, ‖w‖ ^ 2 ∂μ :=
    integral_norm_resid_sq h P
  rw [h1, integral_const, probReal_univ, one_smul, pow_mul',
    Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq (pow_nonneg hρ P),
    Real.sqrt_sq (norm_nonneg w), mul_div_assoc, div_self (norm_ne_zero_iff.mpr hw), mul_one]

end Decay

/-! ### §3b  Where `ρ²` comes from: the coordinate layer

`distortion` above is an assumption about vectors.  Here it is discharged from the paper's
actual hypothesis, that the `d` coordinates of `u_p` share a common marginal law `ν`, by
linearity of expectation.  The paper is careful on this point and the formalisation confirms
it: *the coordinates need not be independent, only identically distributed*. -/

section Coordinates

variable {d : ℕ} {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}

/-- `ρ²` of eq. (2.3): `d · E_{t∼ν}[(t - cb t)²]`. -/
noncomputable def rhoSq (d : ℕ) (cb : ℝ → ℝ) (ν : Measure ℝ) : ℝ :=
  (d : ℝ) * ∫ t, (t - cb t) ^ 2 ∂ν

/-- The second equality of eq. (2.3): `d · E[(t-q t)²] = E[(t-q t)²] / E[t²]` once `E[t²] = 1/d`.
The paper derives `E_{f_d}[t²] = 1/d` from `∑ᵢ E[u_i²] = 1`, i.e. from `‖u‖ = 1` and
exchangeability, not from the closed form of `f_d`. -/
theorem rhoSq_eq_ratio {cb : ℝ → ℝ} {ν : Measure ℝ} (hd : d ≠ 0)
    (hν : ∫ t, t ^ 2 ∂ν = 1 / (d : ℝ)) :
    rhoSq d cb ν = (∫ t, (t - cb t) ^ 2 ∂ν) / (∫ t, t ^ 2 ∂ν) := by
  have hd' : (d : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hd
  rw [rhoSq, hν]
  field_simp

/-- **Linearity of expectation over exchangeable coordinates.**  If the `d` coordinates of the
random unit vector `U` each have law `ν`, then `E‖U - q U‖² = d · E_ν[(t - cb t)²] = ρ²`,
where `q` is `cb` applied coordinate-wise.  No independence between coordinates is used. -/
theorem integral_norm_sub_cb_sq
    {U : Ω → EuclideanSpace ℝ (Fin d)} {cb : ℝ → ℝ} {ν : Measure ℝ}
    (hmeas : ∀ i, Measurable fun ω => U ω i)
    (hmarg : ∀ i, μ.map (fun ω => U ω i) = ν)
    (hint : Integrable (fun t => (t - cb t) ^ 2) ν) :
    ∫ ω, ‖U ω - WithLp.toLp 2 (fun i => cb (U ω i))‖ ^ 2 ∂μ = rhoSq d cb ν := by
  -- Each coordinate map pushes `μ` forward to `ν`, so `(t - cb t)^2` is `ν`-a.e. strongly
  -- measurable when read through any one of them.
  have hasm : ∀ i, AEStronglyMeasurable (fun t => (t - cb t) ^ 2)
      (μ.map (fun ω => U ω i)) := by
    intro i; rw [hmarg i]; exact hint.aestronglyMeasurable
  -- Integrability transported back along each coordinate.  This is the *only* place a
  -- side condition beyond the marginal law is needed, and it is per-coordinate: nothing
  -- about the joint law of the `d` coordinates is used.
  have hmapint : ∀ i, Integrable (fun ω => (U ω i - cb (U ω i)) ^ 2) μ := fun i =>
    (integrable_map_measure (hasm i) (hmeas i).aemeasurable).mp (by rw [hmarg i]; exact hint)
  -- Change of variables, one coordinate at a time.
  have hcoord : ∀ i : Fin d, ∫ ω, (U ω i - cb (U ω i)) ^ 2 ∂μ = ∫ t, (t - cb t) ^ 2 ∂ν := by
    intro i; rw [← hmarg i, integral_map (hmeas i).aemeasurable (hasm i)]
  -- `‖·‖²` on `EuclideanSpace` is the coordinate sum; `q` acts coordinate-wise.
  have hexp : ∀ ω : Ω, ‖U ω - WithLp.toLp 2 (fun i => cb (U ω i))‖ ^ 2
      = ∑ i, (U ω i - cb (U ω i)) ^ 2 := by
    intro ω; rw [EuclideanSpace.real_norm_sq_eq]; simp
  -- Linearity of expectation: swap `∫` and the finite `∑`.  No independence enters.
  simp_rw [hexp]
  rw [integral_finsetSum _ (fun i _ => hmapint i)]
  simp_rw [hcoord]
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, rhoSq]

/-- `E_ν[t²] = 1/d` is *forced*: it is `‖U‖ = 1` plus the coordinates sharing a law, not an
extra assumption about `f_d`.  (This is the step the paper's proof records parenthetically.) -/
theorem second_moment_eq_inv_card
    {U : Ω → EuclideanSpace ℝ (Fin d)} {ν : Measure ℝ} [IsProbabilityMeasure μ] (hd : d ≠ 0)
    (hmeas : ∀ i, Measurable fun ω => U ω i)
    (hmarg : ∀ i, μ.map (fun ω => U ω i) = ν)
    (hint : Integrable (fun t => t ^ 2) ν)
    (hunit : ∀ ω, ‖U ω‖ = 1) :
    ∫ t, t ^ 2 ∂ν = 1 / (d : ℝ) := by
  have hd' : (d : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hd
  have hasm : ∀ i, AEStronglyMeasurable (fun t : ℝ => t ^ 2) (μ.map (fun ω => U ω i)) := by
    intro i; rw [hmarg i]; exact hint.aestronglyMeasurable
  have hmapint : ∀ i, Integrable (fun ω => (U ω i) ^ 2) μ := fun i =>
    (integrable_map_measure (hasm i) (hmeas i).aemeasurable).mp (by rw [hmarg i]; exact hint)
  have hcoord : ∀ i : Fin d, ∫ ω, (U ω i) ^ 2 ∂μ = ∫ t, t ^ 2 ∂ν := by
    intro i; rw [← hmarg i, integral_map (hmeas i).aemeasurable (hasm i)]
  -- `‖U ω‖ = 1` pointwise, i.e. the coordinate squares sum to `1` on the nose.
  have hone : ∀ ω : Ω, ∑ i, (U ω i) ^ 2 = 1 := by
    intro ω
    rw [← EuclideanSpace.real_norm_sq_eq, hunit ω, one_pow]
  -- Integrate: `d · E_ν[t²] = E[‖U‖²] = 1`.  Again only linearity of expectation.
  have key : (d : ℝ) * ∫ t, t ^ 2 ∂ν = 1 := by
    have h1 : ∫ ω, ∑ i, (U ω i) ^ 2 ∂μ = 1 := by
      simp_rw [hone]; simp
    rw [integral_finsetSum _ (fun i _ => hmapint i)] at h1
    simp_rw [hcoord] at h1
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at h1
    exact h1
  field_simp at key ⊢
  linarith [key]

end Coordinates

/-! ## §4  Lemma 1 (spherical marginal) and the data-free evaluation of `ρ`

Lemma 1 states that a coordinate of a uniform point on `S^{d-1}` has density

  `f_d(t) = Γ(d/2) / (√π Γ((d-1)/2)) · (1 - t²)^((d-3)/2)`  on `[-1,1]`,

equivalently `(u_i + 1)/2 ∼ Beta((d-1)/2, (d-1)/2)`, with mean `0` and variance `1/d`.

What §3 needs from this is only `∫ t² f_d = 1/d`, which §3b already derives for free.  What
Lemma 1 is genuinely *for* is the paper's data-free design chart: it makes `ρ` a
one-dimensional quadrature that can be evaluated before any weight is touched.  The statements
below certify that `f_d` really is a probability density with the advertised moments. -/

section Marginal

variable {d : ℕ}

/-- The claimed marginal density `f_d`. -/
noncomputable def sphericalPdf (d : ℕ) (t : ℝ) : ℝ :=
  Real.Gamma ((d : ℝ) / 2) / (Real.sqrt π * Real.Gamma (((d : ℝ) - 1) / 2))
    * (1 - t ^ 2) ^ (((d : ℝ) - 3) / 2)

/-! ### Auxiliary Beta-integral machinery

Everything below `aux_` is private scaffolding for the four statements of Lemma 1.  The chain is

* `aux_beta_real` : the real-valued Euler Beta integral `∫₀¹ xᵘ⁻¹(1-x)ᵛ⁻¹ = Γu Γv / Γ(u+v)`,
  obtained from `Complex.betaIntegral_eq_Gamma_mul_div` by pushing the (genuinely real)
  integrand through `Complex.ofReal`;
* `aux_ii` : interval integrability of `t ↦ (1 - t²)^a` on `[-1,1]` for `a > -1` (needed
  because for `d = 2` the exponent is `-1/2` and the density is unbounded at `±1`);
* `aux_I` : `∫_{-1}^{1} (1-t²)^a = √π Γ(a+1) / Γ(a+3/2)`, via `t = 2x-1` and Legendre
  duplication;
* `aux_J` : the same with a `t²` weight, via `t²(1-t²)^a = (1-t²)^a - (1-t²)^(a+1)`. -/

private theorem aux_beta_real (u v : ℝ) (hu : 0 < u) (hv : 0 < v) :
    ∫ x in (0:ℝ)..1, x ^ (u - 1) * (1 - x) ^ (v - 1)
      = Real.Gamma u * Real.Gamma v / Real.Gamma (u + v) := by
  have key : (Complex.betaIntegral u v)
      = ((∫ x in (0:ℝ)..1, x ^ (u - 1) * (1 - x) ^ (v - 1) : ℝ) : ℂ) := by
    rw [Complex.betaIntegral, intervalIntegral.integral_of_le zero_le_one,
      intervalIntegral.integral_of_le zero_le_one, ← integral_complex_ofReal]
    refine setIntegral_congr_fun measurableSet_Ioc fun x hx => ?_
    have hx0 : (0:ℝ) ≤ x := le_of_lt hx.1
    have hx1 : (0:ℝ) ≤ 1 - x := by linarith [hx.2]
    rw [Complex.ofReal_mul, Complex.ofReal_cpow hx0, Complex.ofReal_cpow hx1]
    push_cast
    ring
  rw [Complex.betaIntegral_eq_Gamma_mul_div _ _ (by simpa using hu) (by simpa using hv)] at key
  rw [← Complex.ofReal_inj, ← key,
    show ((u:ℂ) + v) = ((u + v : ℝ) : ℂ) by push_cast; ring,
    Complex.Gamma_ofReal, Complex.Gamma_ofReal, Complex.Gamma_ofReal]
  push_cast
  ring

private theorem aux_ii_right (a : ℝ) (ha : -1 < a) :
    IntervalIntegrable (fun t : ℝ => (1 - t ^ 2) ^ a) volume 0 1 := by
  have h1 : IntervalIntegrable (fun t : ℝ => (1 - t) ^ a) volume 0 1 := by
    have := (intervalIntegral.intervalIntegrable_rpow' (a := 0) (b := 1) ha).comp_sub_left 1
    simpa using this.symm
  have h2 : ContinuousOn (fun t : ℝ => (1 + t) ^ a) (Set.uIcc (0:ℝ) 1) := by
    apply ContinuousOn.rpow_const (by fun_prop)
    intro x hx
    rw [Set.uIcc_of_le (by norm_num : (0:ℝ) ≤ 1)] at hx
    left; nlinarith [hx.1]
  refine (h1.mul_continuousOn h2).congr ?_
  intro x hx
  rw [Set.uIoc_of_le (by norm_num : (0:ℝ) ≤ 1)] at hx
  have hx1 : (0:ℝ) ≤ 1 - x := by linarith [hx.2]
  have hx2 : (0:ℝ) ≤ 1 + x := by linarith [hx.1]
  simp only
  rw [← Real.mul_rpow hx1 hx2]
  ring_nf

private theorem aux_ii (a : ℝ) (ha : -1 < a) :
    IntervalIntegrable (fun t : ℝ => (1 - t ^ 2) ^ a) volume (-1) 1 := by
  have hR := aux_ii_right a ha
  have hL : IntervalIntegrable (fun t : ℝ => (1 - t ^ 2) ^ a) volume (-1) 0 := by
    have := (IntervalIntegrable.iff_comp_neg (f := fun t : ℝ => (1 - t ^ 2) ^ a)
      (a := 0) (b := 1) (by finiteness)).mp hR
    simpa using this.symm
  exact hL.trans hR

private theorem aux_I (a : ℝ) (ha : -1 < a) :
    ∫ t in (-1:ℝ)..1, (1 - t ^ 2) ^ a
      = Real.sqrt π * Real.Gamma (a + 1) / Real.Gamma (a + 3/2) := by
  have hsub := intervalIntegral.smul_integral_comp_mul_add (a := (0:ℝ)) (b := 1)
    (f := fun t => (1 - t^2) ^ a) 2 (-1)
  simp only [smul_eq_mul] at hsub
  norm_num at hsub
  have hB : ∫ x in (0:ℝ)..1, x ^ a * (1 - x) ^ a
      = Real.Gamma (a+1) * Real.Gamma (a+1) / Real.Gamma (2*a+2) := by
    have := aux_beta_real (a+1) (a+1) (by linarith) (by linarith)
    simpa [add_sub_cancel_right, show a+1+(a+1) = 2*a+2 by ring] using this
  have hcong : ∫ x in (0:ℝ)..1, (1 - (2*x + -1)^2) ^ a
      = (4:ℝ)^a * ∫ x in (0:ℝ)..1, x^a * (1-x)^a := by
    rw [← intervalIntegral.integral_const_mul]
    refine intervalIntegral.integral_congr fun x hx => ?_
    rw [Set.uIcc_of_le zero_le_one] at hx
    have h1 : (0:ℝ) ≤ x := hx.1
    have h2 : (0:ℝ) ≤ 1 - x := by linarith [hx.2]
    rw [show 1 - (2*x + -1)^2 = 4 * (x * (1-x)) by ring,
      Real.mul_rpow (by norm_num) (by positivity), Real.mul_rpow h1 h2]
    try ring
  rw [← hsub, hcong, hB]
  have hg1 : 0 < Real.Gamma (a+1) := Real.Gamma_pos_of_pos (by linarith)
  have hg2 : 0 < Real.Gamma (a+3/2) := Real.Gamma_pos_of_pos (by linarith)
  have hg3 : 0 < Real.Gamma (2*a+2) := Real.Gamma_pos_of_pos (by linarith)
  have hdup : Real.Gamma (a+1) * Real.Gamma (a+3/2)
      = Real.Gamma (2*a+2) * (2:ℝ)^(-1-2*a) * Real.sqrt π := by
    have h := Real.Gamma_mul_Gamma_add_half (a+1)
    rw [show a+1+1/2 = a+3/2 by ring, show (1:ℝ)-2*(a+1) = -1-2*a by ring,
      show 2*(a+1) = 2*a+2 by ring] at h
    exact h
  have h4 : 2 * (4:ℝ)^a * (2:ℝ)^(-1-2*a) = 1 := by
    rw [show (4:ℝ) = 2 * 2 by norm_num, Real.mul_rpow (by norm_num) (by norm_num),
      mul_assoc, mul_assoc, ← Real.rpow_add (by norm_num : (0:ℝ) < 2),
      ← Real.rpow_add (by norm_num : (0:ℝ) < 2),
      show a + (a + (-1 - 2*a)) = -1 by ring, Real.rpow_neg_one]
    norm_num
  have hkey : 2 * (4:ℝ)^a * (Real.Gamma (a+1) * Real.Gamma (a+1)) * Real.Gamma (a+3/2)
      = Real.sqrt π * Real.Gamma (a+1) * Real.Gamma (2*a+2) := by
    calc 2 * (4:ℝ)^a * (Real.Gamma (a+1) * Real.Gamma (a+1)) * Real.Gamma (a+3/2)
        = 2 * (4:ℝ)^a * Real.Gamma (a+1) * (Real.Gamma (a+1) * Real.Gamma (a+3/2)) := by ring
      _ = 2 * (4:ℝ)^a * Real.Gamma (a+1)
            * (Real.Gamma (2*a+2) * (2:ℝ)^(-1-2*a) * Real.sqrt π) := by rw [hdup]
      _ = (2 * (4:ℝ)^a * (2:ℝ)^(-1-2*a))
            * (Real.sqrt π * Real.Gamma (a+1) * Real.Gamma (2*a+2)) := by ring
      _ = _ := by rw [h4, one_mul]
  rw [show 2 * ((4:ℝ)^a * (Real.Gamma (a+1) * Real.Gamma (a+1) / Real.Gamma (2*a+2)))
      = (2 * (4:ℝ)^a * (Real.Gamma (a+1) * Real.Gamma (a+1))) / Real.Gamma (2*a+2) by ring,
    div_eq_div_iff hg3.ne' hg2.ne']
  linear_combination hkey

private theorem aux_J (a : ℝ) (ha : -1 < a) :
    ∫ t in (-1:ℝ)..1, t ^ 2 * (1 - t ^ 2) ^ a
      = Real.sqrt π * Real.Gamma (a + 1) / Real.Gamma (a + 3/2)
        - Real.sqrt π * Real.Gamma (a + 2) / Real.Gamma (a + 5/2) := by
  have hcongr : ∫ t in (-1:ℝ)..1, t ^ 2 * (1 - t ^ 2) ^ a
      = ∫ t in (-1:ℝ)..1, ((1 - t ^ 2) ^ a - (1 - t ^ 2) ^ (a + 1)) := by
    refine intervalIntegral.integral_congr fun t ht => ?_
    rw [Set.uIcc_of_le (by norm_num : (-1:ℝ) ≤ 1)] at ht
    have hs : (0:ℝ) ≤ 1 - t ^ 2 := by nlinarith [ht.1, ht.2]
    rcases eq_or_lt_of_le hs with h | h
    · have ht2 : t ^ 2 = 1 := by linarith
      rw [← h, Real.zero_rpow (by linarith : a + 1 ≠ 0), ht2]
      ring
    · rw [Real.rpow_add h a 1, Real.rpow_one]
      ring
  have hI2 := aux_I (a + 1) (by linarith)
  rw [show a + 1 + 1 = a + 2 by ring, show a + 1 + 3/2 = a + 5/2 by ring] at hI2
  rw [hcongr, intervalIntegral.integral_sub (aux_ii a ha) (aux_ii (a+1) (by linarith)),
    aux_I a ha, hI2]

theorem sphericalPdf_nonneg {d : ℕ} {t : ℝ} (ht : t ∈ Set.Icc (-1 : ℝ) 1) (hd : 2 ≤ d) :
    0 ≤ sphericalPdf d t := by
  have hdR : (2:ℝ) ≤ (d:ℝ) := by exact_mod_cast hd
  have h1 : 0 < Real.Gamma ((d:ℝ)/2) := Real.Gamma_pos_of_pos (by linarith)
  have h2 : 0 < Real.Gamma (((d:ℝ)-1)/2) := Real.Gamma_pos_of_pos (by linarith)
  have h3 : 0 < Real.sqrt π := Real.sqrt_pos.mpr Real.pi_pos
  obtain ⟨h5, h6⟩ := ht
  have h4 : (0:ℝ) ≤ 1 - t ^ 2 := by nlinarith
  exact mul_nonneg (by positivity) (Real.rpow_nonneg h4 _)

/-- `f_d` is a probability density: a Beta integral. -/
theorem sphericalPdf_integral (hd : 2 ≤ d) :
    ∫ t in (-1 : ℝ)..1, sphericalPdf d t = 1 := by
  have hdR : (2:ℝ) ≤ (d:ℝ) := by exact_mod_cast hd
  have ha : (-1:ℝ) < ((d:ℝ) - 3) / 2 := by linarith
  have h1 : 0 < Real.Gamma ((d:ℝ)/2) := Real.Gamma_pos_of_pos (by linarith)
  have h2 : 0 < Real.Gamma (((d:ℝ)-1)/2) := Real.Gamma_pos_of_pos (by linarith)
  have h3 : 0 < Real.sqrt π := Real.sqrt_pos.mpr Real.pi_pos
  have hI := aux_I (((d:ℝ) - 3) / 2) ha
  rw [show ((d:ℝ) - 3) / 2 + 1 = ((d:ℝ) - 1) / 2 by ring,
    show ((d:ℝ) - 3) / 2 + 3/2 = (d:ℝ) / 2 by ring] at hI
  simp only [sphericalPdf]
  rw [intervalIntegral.integral_const_mul, hI]
  field_simp

/-- `f_d` has mean zero (it is even). -/
theorem sphericalPdf_first_moment (hd : 2 ≤ d) :
    ∫ t in (-1 : ℝ)..1, t * sphericalPdf d t = 0 := by
  have hodd : ∀ t : ℝ, (fun s : ℝ => s * sphericalPdf d s) (-t)
      = -((fun s : ℝ => s * sphericalPdf d s) t) := by
    intro t
    simp only [sphericalPdf, neg_mul, neg_inj]
    rw [show (-t) ^ 2 = t ^ 2 by ring]
  have h := intervalIntegral.integral_comp_neg (a := (-1:ℝ)) (b := 1)
    (fun s : ℝ => s * sphericalPdf d s)
  simp only [hodd, intervalIntegral.integral_neg] at h
  norm_num at h
  linarith

/-- `f_d` has variance `1/d`, matching `§3b`'s `second_moment_eq_inv_card`.  That these two
routes agree is the consistency check between Lemma 1 and Proposition 2. -/
theorem sphericalPdf_second_moment (hd : 2 ≤ d) :
    ∫ t in (-1 : ℝ)..1, t ^ 2 * sphericalPdf d t = 1 / (d : ℝ) := by
  have hdR : (2:ℝ) ≤ (d:ℝ) := by exact_mod_cast hd
  have ha : (-1:ℝ) < ((d:ℝ) - 3) / 2 := by linarith
  have h1 : 0 < Real.Gamma ((d:ℝ)/2) := Real.Gamma_pos_of_pos (by linarith)
  have h2 : 0 < Real.Gamma (((d:ℝ)-1)/2) := Real.Gamma_pos_of_pos (by linarith)
  have h3 : 0 < Real.sqrt π := Real.sqrt_pos.mpr Real.pi_pos
  have h5 : 0 < Real.Gamma (((d:ℝ)+2)/2) := Real.Gamma_pos_of_pos (by linarith)
  -- the two Gamma recurrences that make the answer collapse to `1/d`
  have e1 : Real.Gamma (((d:ℝ)+1)/2) = (((d:ℝ)-1)/2) * Real.Gamma (((d:ℝ)-1)/2) := by
    have := Real.Gamma_add_one (s := ((d:ℝ)-1)/2) (by intro h; linarith [h])
    rw [show ((d:ℝ)-1)/2 + 1 = ((d:ℝ)+1)/2 by ring] at this
    exact this
  have e2 : Real.Gamma (((d:ℝ)+2)/2) = ((d:ℝ)/2) * Real.Gamma ((d:ℝ)/2) := by
    have := Real.Gamma_add_one (s := (d:ℝ)/2) (by intro h; linarith [h])
    rw [show (d:ℝ)/2 + 1 = ((d:ℝ)+2)/2 by ring] at this
    exact this
  have hJ := aux_J (((d:ℝ) - 3) / 2) ha
  rw [show ((d:ℝ) - 3) / 2 + 1 = ((d:ℝ) - 1) / 2 by ring,
    show ((d:ℝ) - 3) / 2 + 3/2 = (d:ℝ) / 2 by ring,
    show ((d:ℝ) - 3) / 2 + 2 = ((d:ℝ) + 1) / 2 by ring,
    show ((d:ℝ) - 3) / 2 + 5/2 = ((d:ℝ) + 2) / 2 by ring] at hJ
  have hmul : ∀ t : ℝ, t ^ 2 * sphericalPdf d t
      = (Real.Gamma ((d : ℝ) / 2) / (Real.sqrt π * Real.Gamma (((d : ℝ) - 1) / 2)))
        * (t ^ 2 * (1 - t ^ 2) ^ (((d : ℝ) - 3) / 2)) := by
    intro t; simp only [sphericalPdf]; ring
  simp only [hmul]
  rw [intervalIntegral.integral_const_mul, hJ, e1, e2]
  have hdne : (d:ℝ) ≠ 0 := by linarith
  field_simp
  ring

/-! ### §4b  The coordinate law, and the link to `ρ`

Without it, `ν` in §3b/§6 and `sphericalPdf` in §4
would be formally unrelated symbols that the prose identifies.  `sphericalCoordLaw d` is
that identification made explicit: the probability measure on `ℝ` whose density is `f_d`.  With
it, `rhoSq_eq_ratio` applies to the paper's actual `ρ` with no side hypothesis. -/

/-- The coordinate law claimed by Lemma 1: the measure on `ℝ` with density `f_d` on `[-1,1]`. -/
noncomputable def sphericalCoordLaw (d : ℕ) : Measure ℝ :=
  (volume.restrict (Set.Icc (-1 : ℝ) 1)).withDensity fun t => ENNReal.ofReal (sphericalPdf d t)

/-! The bridge from the interval integrals above to the measure `sphericalCoordLaw` is pure
bookkeeping: `Set.Icc (-1) 1` and `Set.Ioc (-1) 1` differ by a Lebesgue-null set, and
`∫ x in a..b` *is* the integral against `volume.restrict (Set.Ioc a b)` when `a ≤ b`. -/

private theorem aux_restrict_Icc_eq (a b : ℝ) :
    volume.restrict (Set.Icc a b) = volume.restrict (Set.Ioc a b) :=
  (Measure.restrict_congr_set Ioc_ae_eq_Icc).symm

private theorem aux_meas_pdf (d : ℕ) : Measurable (sphericalPdf d) := by
  unfold sphericalPdf
  fun_prop

private theorem aux_ii_pdf (hd : 2 ≤ d) :
    IntervalIntegrable (sphericalPdf d) volume (-1) 1 := by
  have hdR : (2:ℝ) ≤ (d:ℝ) := by exact_mod_cast hd
  have ha : (-1:ℝ) < ((d:ℝ) - 3) / 2 := by linarith
  unfold sphericalPdf
  exact (aux_ii (((d:ℝ) - 3) / 2) ha).const_mul
      (Real.Gamma ((d : ℝ) / 2) / (Real.sqrt π * Real.Gamma (((d : ℝ) - 1) / 2)))

private theorem aux_integrable_pdf (hd : 2 ≤ d) :
    Integrable (sphericalPdf d) (volume.restrict (Set.Icc (-1:ℝ) 1)) := by
  rw [aux_restrict_Icc_eq]
  exact (intervalIntegrable_iff_integrableOn_Ioc_of_le (by norm_num)).mp (aux_ii_pdf hd)

private theorem aux_integral_pdf (hd : 2 ≤ d) :
    ∫ t, sphericalPdf d t ∂(volume.restrict (Set.Icc (-1:ℝ) 1)) = 1 := by
  rw [aux_restrict_Icc_eq, ← intervalIntegral.integral_of_le (by norm_num : (-1:ℝ) ≤ 1)]
  exact sphericalPdf_integral hd

private theorem aux_integral_sq_pdf (hd : 2 ≤ d) :
    ∫ t, t ^ 2 * sphericalPdf d t ∂(volume.restrict (Set.Icc (-1:ℝ) 1)) = 1 / (d : ℝ) := by
  rw [aux_restrict_Icc_eq, ← intervalIntegral.integral_of_le (by norm_num : (-1:ℝ) ≤ 1)]
  exact sphericalPdf_second_moment hd

/-- `f_d` really is a probability density. -/
theorem isProbabilityMeasure_sphericalCoordLaw (hd : 2 ≤ d) :
    IsProbabilityMeasure (sphericalCoordLaw d) := by
  constructor
  have hnn : 0 ≤ᵐ[volume.restrict (Set.Icc (-1:ℝ) 1)] sphericalPdf d := by
    rw [Filter.EventuallyLE, ae_restrict_iff' measurableSet_Icc]
    exact Filter.Eventually.of_forall fun t ht => sphericalPdf_nonneg ht hd
  rw [sphericalCoordLaw, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ,
    ← ofReal_integral_eq_lintegral_ofReal (aux_integrable_pdf hd) hnn,
    aux_integral_pdf hd, ENNReal.ofReal_one]

/-- The second moment of the coordinate law is `1/d`, matching what `second_moment_eq_inv_card`
of §3b derives from `‖u‖ = 1` alone.  That these two routes agree is the only place where
Lemma 1 and Proposition 2 make contact. -/
theorem integral_sq_sphericalCoordLaw (hd : 2 ≤ d) :
    ∫ t, t ^ 2 ∂(sphericalCoordLaw d) = 1 / (d : ℝ) := by
  rw [sphericalCoordLaw,
    integral_withDensity_eq_integral_toReal_smul
      (f := fun t => ENNReal.ofReal (sphericalPdf d t))
      (ENNReal.measurable_ofReal.comp (aux_meas_pdf d))
      (Filter.Eventually.of_forall fun t => ENNReal.ofReal_lt_top)]
  rw [show (∫ t, (ENNReal.ofReal (sphericalPdf d t)).toReal • t ^ 2
        ∂(volume.restrict (Set.Icc (-1:ℝ) 1)))
      = ∫ t, t ^ 2 * sphericalPdf d t ∂(volume.restrict (Set.Icc (-1:ℝ) 1)) from
    setIntegral_congr_fun measurableSet_Icc fun t ht => by
      rw [ENNReal.toReal_ofReal (sphericalPdf_nonneg ht hd), smul_eq_mul, mul_comm]]
  exact aux_integral_sq_pdf hd

end Marginal

/-! ## §5  Theorem 1 (re-isotropisation)

The paper: *"Let `r ∈ ℝ^d \ {0}` be a random vector and `R` Haar on `O(d)`, independent of `r`.
Then `u := Rr/‖Rr‖` is uniform on `S^{d-1}` and independent of `‖r‖`, regardless of the
distribution of `r`."*

The proof given in the paper is a right-invariance argument, and right-invariance is genuinely
all it needs.  Formalising it abstractly makes that visible: the statement is about a compact
group acting transitively on a set, and has nothing to do with spheres, rotations, or `ℝ^d`.

`orbitLaw κ x₀` is the law of `g • x₀` for `g ∼ κ`.

**Read the scope of this section carefully.**  `orbitLaw κ x₀` is *defined* as a pushforward.
Nothing below identifies it with the normalised surface measure on `S^{d-1}`, so the paper's
phrase "`u` is uniform on the sphere" is **not** established here: that identification needs
(a) Haar measure on the orthogonal group, (b) uniqueness of the rotation-invariant probability
measure on the sphere, and (c) a Mathlib handle on the uniform measure on `Metric.sphere`.
Mathlib currently supplies none of the three, there is no `MeasurableSpace` instance on
`E ≃ₗᵢ[ℝ] E` and no Haar measure on the orthogonal group, so the abstract results below cannot
presently even be *instantiated* at the paper's setting.  What is proved is the
distributional-invariance half of Theorem 1: the law of `R • x` is the same for every `x` in the
orbit, whatever the law of `x`.  That is the paper's right-invariance argument, and it is the
part Proposition 2 consumes; the "uniform" wording is stronger than the proof. -/

section Reisotropisation

variable {G X : Type*} [Group G] [MeasurableSpace G] [MeasurableSpace X]
variable [MulAction G X] [MeasurableSMul G X]
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}

/-- The law of `g • x` when `g ∼ κ`. -/
noncomputable def orbitLaw (κ : Measure G) (x : X) : Measure X := κ.map (fun g => g • x)

/-- **The whole content of Theorem 1.**  Right-invariance of Haar measure makes the orbit law
*constant along the orbit*: it is the same measure whichever base point of the orbit you push
forward from.  (Paper: "by right invariance of the Haar measure, `R T_a =ᵈ R`".) -/
theorem orbitLaw_smul (κ : Measure G) [κ.IsMulRightInvariant] [MeasurableMul G] (h : G) (x : X) :
    orbitLaw κ (h • x) = orbitLaw κ x := by
  unfold orbitLaw
  have hcomp : (fun g : G => g • (h • x)) = (fun g : G => g • x) ∘ (fun g : G => g * h) := by
    funext g; simp [mul_smul]
  rw [hcomp, ← Measure.map_map (measurable_smul_const x) (measurable_mul_const h),
    map_mul_right_eq_self]

/-- Consequently the orbit law does not depend on the base point chosen within an orbit. -/
theorem orbitLaw_eq_of_mem_orbit (κ : Measure G) [κ.IsMulRightInvariant] [MeasurableMul G]
    {x₀ x : X} (hx : x ∈ MulAction.orbit G x₀) : orbitLaw κ x = orbitLaw κ x₀ := by
  obtain ⟨g, rfl⟩ := hx
  exact orbitLaw_smul κ g x₀

/-! ### Auxiliary machinery for the three probabilistic statements

Everything past the two lemmas just proved needs the action to be **jointly** measurable,
`MeasurableSMul₂ G X` (i.e. `(g, x) ↦ g • x` measurable on `G × X`), and not merely separately
measurable in each variable, which is all that `MeasurableSMul G X` provides.  The `aux_`
lemmas below record the complete proofs under that extra instance; see the `FIXME`s for why the
three `theorem`s *as stated* cannot be discharged from `MeasurableSMul` alone. -/

private theorem aux_orbitLaw_apply (κ : Measure G) (x : X) {s : Set X} (hs : MeasurableSet s) :
    orbitLaw κ x s = κ {g | g • x ∈ s} :=
  Measure.map_apply (measurable_smul_const x) hs

private theorem aux_isProbabilityMeasure_orbitLaw (κ : Measure G) [IsProbabilityMeasure κ] (x : X) :
    IsProbabilityMeasure (orbitLaw κ x) :=
  Measure.isProbabilityMeasure_map (measurable_smul_const x).aemeasurable

/-- The joint law of `(R • r, r)` is the product of the orbit law and the law of `r`.  This is
the single computation behind all three of `law_smul_eq_orbitLaw`, `indepFun_smul_left` and
`indepFun_smul_comp`; it is proved here in full, but only under `[MeasurableSMul₂ G X]`. -/
private theorem aux_map_pair [MeasurableSMul₂ G X] [IsProbabilityMeasure μ]
    {κ : Measure G} [IsProbabilityMeasure κ] [κ.IsMulRightInvariant] [MeasurableMul G]
    {R : Ω → G} {r : Ω → X} (hRmeas : Measurable R) (hrmeas : Measurable r)
    (hR : μ.map R = κ) (hindep : IndepFun R r μ)
    {x₀ : X} (horb : ∀ᵐ ω ∂μ, r ω ∈ MulAction.orbit G x₀) :
    μ.map (fun ω => (R ω • r ω, r ω)) = (orbitLaw κ x₀).prod (μ.map r) := by
  haveI := aux_isProbabilityMeasure_orbitLaw κ x₀
  haveI : IsProbabilityMeasure (μ.map r) :=
    Measure.isProbabilityMeasure_map hrmeas.aemeasurable
  have hΦ : Measurable (fun p : G × X => (p.1 • p.2, p.2)) := by fun_prop
  have hpair : μ.map (fun ω => (R ω, r ω)) = κ.prod (μ.map r) := by
    rw [hindep.map_prod_eq_prod_map_map hRmeas.aemeasurable hrmeas.aemeasurable, hR]
  have h1 : μ.map (fun ω => (R ω • r ω, r ω))
      = (κ.prod (μ.map r)).map (fun p : G × X => (p.1 • p.2, p.2)) := by
    rw [← hpair, Measure.map_map hΦ (hRmeas.prodMk hrmeas)]; rfl
  rw [h1]
  refine (Measure.prod_eq ?_).symm
  intro s t hs ht
  have hst : MeasurableSet ((fun p : G × X => (p.1 • p.2, p.2)) ⁻¹' (s ×ˢ t)) := hΦ (hs.prod ht)
  rw [Measure.map_apply hΦ (hs.prod ht), Measure.prod_apply_symm hst]
  set F : X → ℝ≥0∞ :=
    fun y => κ ((fun x : G => (x, y)) ⁻¹' ((fun p : G × X => (p.1 • p.2, p.2)) ⁻¹' (s ×ˢ t)))
    with hF
  have hFmeas : Measurable F := measurable_measure_prodMk_right hst
  -- the orbit hypothesis turns the inner measure into the *constant* `orbitLaw κ x₀ s`
  have hstep : ∀ᵐ ω ∂μ, F (r ω) = t.indicator (fun _ => orbitLaw κ x₀ s) (r ω) := by
    filter_upwards [horb] with ω horbω
    by_cases hyt : r ω ∈ t
    · have he : (fun x : G => (x, r ω)) ⁻¹'
          ((fun p : G × X => (p.1 • p.2, p.2)) ⁻¹' (s ×ˢ t)) = {g : G | g • r ω ∈ s} := by
        ext g; simp [hyt]
      simp only [hF, he, Set.indicator_of_mem hyt]
      rw [← aux_orbitLaw_apply κ (r ω) hs, orbitLaw_eq_of_mem_orbit κ horbω]
    · have he : (fun x : G => (x, r ω)) ⁻¹'
          ((fun p : G × X => (p.1 • p.2, p.2)) ⁻¹' (s ×ˢ t)) = ∅ := by
        ext g; simp [hyt]
      simp only [hF, he, Set.indicator_of_notMem hyt, measure_empty]
  rw [lintegral_map hFmeas hrmeas]
  calc ∫⁻ ω, F (r ω) ∂μ
      = ∫⁻ ω, (r ⁻¹' t).indicator (fun _ => orbitLaw κ x₀ s) ω ∂μ := by
        refine lintegral_congr_ae ?_
        filter_upwards [hstep] with ω hstepω
        rw [hstepω]
        by_cases hyt : r ω ∈ t <;> simp [hyt, Set.indicator_of_mem, Set.indicator_of_notMem]
    _ = orbitLaw κ x₀ s * (μ.map r) t := by
        rw [lintegral_indicator (hrmeas ht), setLIntegral_const, Measure.map_apply hrmeas ht]

/-- `law_smul_eq_orbitLaw`, proved, but with the joint-measurability instance added. -/
private theorem aux_law_smul_eq_orbitLaw [MeasurableSMul₂ G X] [IsProbabilityMeasure μ]
    {κ : Measure G} [IsProbabilityMeasure κ] [κ.IsMulRightInvariant] [MeasurableMul G]
    {R : Ω → G} {r : Ω → X} (hRmeas : Measurable R) (hrmeas : Measurable r)
    (hR : μ.map R = κ) (hindep : IndepFun R r μ)
    {x₀ : X} (horb : ∀ᵐ ω ∂μ, r ω ∈ MulAction.orbit G x₀) :
    μ.map (fun ω => R ω • r ω) = orbitLaw κ x₀ := by
  haveI : IsProbabilityMeasure (μ.map r) :=
    Measure.isProbabilityMeasure_map hrmeas.aemeasurable
  have hpm : Measurable (fun ω => (R ω • r ω, r ω)) := (hRmeas.smul hrmeas).prodMk hrmeas
  have h := congrArg (Measure.map Prod.fst) (aux_map_pair hRmeas hrmeas hR hindep horb)
  rwa [Measure.map_map measurable_fst hpm, Measure.map_fst_prod, measure_univ, one_smul] at h

/-- `indepFun_smul_left`, proved, but with the joint-measurability instance added. -/
private theorem aux_indepFun_smul_left [MeasurableSMul₂ G X] [IsProbabilityMeasure μ]
    {κ : Measure G} [IsProbabilityMeasure κ] [κ.IsMulRightInvariant] [MeasurableMul G]
    {R : Ω → G} {r : Ω → X} (hRmeas : Measurable R) (hrmeas : Measurable r)
    (hR : μ.map R = κ) (hindep : IndepFun R r μ)
    {x₀ : X} (horb : ∀ᵐ ω ∂μ, r ω ∈ MulAction.orbit G x₀) :
    IndepFun (fun ω => R ω • r ω) r μ := by
  refine (indepFun_iff_map_prod_eq_prod_map_map
    (hRmeas.smul hrmeas).aemeasurable hrmeas.aemeasurable).2 ?_
  show μ.map (fun ω => (R ω • r ω, r ω)) = (μ.map (fun ω => R ω • r ω)).prod (μ.map r)
  rw [aux_map_pair hRmeas hrmeas hR hindep horb,
    aux_law_smul_eq_orbitLaw hRmeas hrmeas hR hindep horb]

/-- `indepFun_smul_comp`, proved, but with the joint-measurability instance added. -/
private theorem aux_indepFun_smul_comp [MeasurableSMul₂ G X] [IsProbabilityMeasure μ]
    {κ : Measure G} [IsProbabilityMeasure κ] [κ.IsMulRightInvariant] [MeasurableMul G]
    {β : Type*} [MeasurableSpace β] {f : X → β}
    {R : Ω → G} {r : Ω → X} (hRmeas : Measurable R) (hrmeas : Measurable r)
    (hfmeas : Measurable f) (hR : μ.map R = κ) (hindep : IndepFun R r μ)
    {x₀ : X} (horb : ∀ᵐ ω ∂μ, r ω ∈ MulAction.orbit G x₀) :
    IndepFun (fun ω => R ω • r ω) (fun ω => f (r ω)) μ :=
  (aux_indepFun_smul_left hRmeas hrmeas hR hindep horb).comp measurable_id hfmeas

/-- **Theorem 1, abstract form, part 1 (the law).**  If `R ∼ κ` is Haar-distributed and
independent of `r`, and `r` lives in a single orbit, then `R • r` has the orbit law, *whatever
the law of `r`*.  This is the "`r` may be anything" clause that licenses reuse of one codebook
across residual passes. -/
theorem law_smul_eq_orbitLaw [IsProbabilityMeasure μ] {κ : Measure G} [IsProbabilityMeasure κ]
    [κ.IsMulRightInvariant] [MeasurableMul G] [MeasurableSMul₂ G X]
    {R : Ω → G} {r : Ω → X} (hRmeas : Measurable R) (hrmeas : Measurable r)
    (hR : μ.map R = κ) (hindep : IndepFun R r μ)
    {x₀ : X} (horb : ∀ᵐ ω ∂μ, r ω ∈ MulAction.orbit G x₀) :
    μ.map (fun ω => R ω • r ω) = orbitLaw κ x₀ :=
  aux_law_smul_eq_orbitLaw hRmeas hrmeas hR hindep horb

/-- **Theorem 1, abstract form, part 2 (the independence).**  `R • r` is independent of `r`.
This, not the uniformity, is what Proposition 2 consumes, via `u_p ⟂ s_p`. -/
theorem indepFun_smul_left [IsProbabilityMeasure μ] {κ : Measure G} [IsProbabilityMeasure κ]
    [κ.IsMulRightInvariant] [MeasurableMul G] [MeasurableSMul₂ G X]
    {R : Ω → G} {r : Ω → X} (hRmeas : Measurable R) (hrmeas : Measurable r)
    (hR : μ.map R = κ) (hindep : IndepFun R r μ)
    {x₀ : X} (horb : ∀ᵐ ω ∂μ, r ω ∈ MulAction.orbit G x₀) :
    IndepFun (fun ω => R ω • r ω) r μ :=
  aux_indepFun_smul_left hRmeas hrmeas hR hindep horb

/-- Composing: any function of `r`, in particular `‖r‖`, is independent of `R • r`. -/
theorem indepFun_smul_comp [IsProbabilityMeasure μ] {κ : Measure G} [IsProbabilityMeasure κ]
    [κ.IsMulRightInvariant] [MeasurableMul G] [MeasurableSMul₂ G X] {β : Type*} [MeasurableSpace β] {f : X → β}
    {R : Ω → G} {r : Ω → X} (hRmeas : Measurable R) (hrmeas : Measurable r)
    (hfmeas : Measurable f) (hR : μ.map R = κ) (hindep : IndepFun R r μ)
    {x₀ : X} (horb : ∀ᵐ ω ∂μ, r ω ∈ MulAction.orbit G x₀) :
    IndepFun (fun ω => R ω • r ω) (fun ω => f (r ω)) μ :=
  aux_indepFun_smul_comp hRmeas hrmeas hfmeas hR hindep horb

/-- The joint law of `(R • r, Z)` for an auxiliary variable `Z` carried alongside `r`.  This is
`aux_map_pair` with the action applied to the *first* component of `X × β` while `β` is dragged
through untouched: the orbit hypothesis still makes the inner `κ`-measure the constant
`orbitLaw κ x₀ s`, so Fubini factorises exactly as before.  Note that the second factor is the
law of `Z` alone, all information about `r` beyond its orbit has been washed out. -/
private theorem aux_map_pair_snd [MeasurableSMul₂ G X] [IsProbabilityMeasure μ]
    {κ : Measure G} [IsProbabilityMeasure κ] [κ.IsMulRightInvariant] [MeasurableMul G]
    {β : Type*} [MeasurableSpace β]
    {R : Ω → G} {r : Ω → X} {Z : Ω → β}
    (hRmeas : Measurable R) (hrmeas : Measurable r) (hZmeas : Measurable Z)
    (hR : μ.map R = κ) (hindep : IndepFun R (fun ω => (r ω, Z ω)) μ)
    {x₀ : X} (horb : ∀ᵐ ω ∂μ, r ω ∈ MulAction.orbit G x₀) :
    μ.map (fun ω => (R ω • r ω, Z ω)) = (orbitLaw κ x₀).prod (μ.map Z) := by
  haveI := aux_isProbabilityMeasure_orbitLaw κ x₀
  haveI : IsProbabilityMeasure (μ.map Z) :=
    Measure.isProbabilityMeasure_map hZmeas.aemeasurable
  have hYmeas : Measurable (fun ω => (r ω, Z ω)) := hrmeas.prodMk hZmeas
  haveI : IsProbabilityMeasure (μ.map (fun ω => (r ω, Z ω))) :=
    Measure.isProbabilityMeasure_map hYmeas.aemeasurable
  have hΦ : Measurable (fun p : G × (X × β) => (p.1 • p.2.1, p.2.2)) := by fun_prop
  have hpair : μ.map (fun ω => (R ω, (r ω, Z ω)))
      = κ.prod (μ.map fun ω => (r ω, Z ω)) := by
    rw [hindep.map_prod_eq_prod_map_map hRmeas.aemeasurable hYmeas.aemeasurable, hR]
  have h1 : μ.map (fun ω => (R ω • r ω, Z ω))
      = (κ.prod (μ.map fun ω => (r ω, Z ω))).map
          (fun p : G × (X × β) => (p.1 • p.2.1, p.2.2)) := by
    rw [← hpair, Measure.map_map hΦ (hRmeas.prodMk hYmeas)]; rfl
  rw [h1]
  refine (Measure.prod_eq ?_).symm
  intro s t hs ht
  have hst : MeasurableSet
      ((fun p : G × (X × β) => (p.1 • p.2.1, p.2.2)) ⁻¹' (s ×ˢ t)) := hΦ (hs.prod ht)
  rw [Measure.map_apply hΦ (hs.prod ht), Measure.prod_apply_symm hst]
  set F : X × β → ℝ≥0∞ :=
    fun y => κ ((fun x : G => (x, y)) ⁻¹'
      ((fun p : G × (X × β) => (p.1 • p.2.1, p.2.2)) ⁻¹' (s ×ˢ t))) with hF
  have hFmeas : Measurable F := measurable_measure_prodMk_right hst
  -- the orbit hypothesis turns the inner measure into the *constant* `orbitLaw κ x₀ s`,
  -- independently of `ω`; only the `Z`-slice survives
  have hstep : ∀ᵐ ω ∂μ, F (r ω, Z ω) = (Z ⁻¹' t).indicator (fun _ => orbitLaw κ x₀ s) ω := by
    filter_upwards [horb] with ω horbω
    by_cases hyt : Z ω ∈ t
    · have he : (fun x : G => (x, (r ω, Z ω))) ⁻¹'
          ((fun p : G × (X × β) => (p.1 • p.2.1, p.2.2)) ⁻¹' (s ×ˢ t))
            = {g : G | g • r ω ∈ s} := by
        ext g; simp [hyt]
      simp only [hF, he, Set.indicator_of_mem (show ω ∈ Z ⁻¹' t from hyt)]
      rw [← aux_orbitLaw_apply κ (r ω) hs, orbitLaw_eq_of_mem_orbit κ horbω]
    · have he : (fun x : G => (x, (r ω, Z ω))) ⁻¹'
          ((fun p : G × (X × β) => (p.1 • p.2.1, p.2.2)) ⁻¹' (s ×ˢ t)) = ∅ := by
        ext g; simp [hyt]
      simp only [hF, he, Set.indicator_of_notMem (show ω ∉ Z ⁻¹' t from hyt), measure_empty]
  rw [lintegral_map hFmeas hYmeas]
  calc ∫⁻ ω, F (r ω, Z ω) ∂μ
      = ∫⁻ ω, (Z ⁻¹' t).indicator (fun _ => orbitLaw κ x₀ s) ω ∂μ := lintegral_congr_ae hstep
    _ = orbitLaw κ x₀ s * (μ.map Z) t := by
        rw [lintegral_indicator (hZmeas ht), setLIntegral_const, Measure.map_apply hZmeas ht]

/-- **The statement Proposition 2 actually consumes.**

`indepFun_smul_comp` above is, at `G = O(d)` acting on `ℝ^d`, *vacuous* for the paper's purpose:
the hypothesis `∀ ω, r ω ∈ orbit G x₀` forces `‖r ω‖` to be a.s. constant, so these lemmas can
only be instantiated with the *normalised* residual `r̂ = r/‖r‖`, and then `f(r̂) = ‖r̂‖ ≡ 1`.
The paper's claim is `u ⟂ ‖r‖`, and `‖r‖` is not a function of `r̂`.

The correct statement carries the scale along as a separate variable `Z`: `R • r̂` is independent
of *any* auxiliary variable `Z` that is jointly independent of the fresh rotation.  Taking
`Z = ‖r‖` gives the paper's "`u` is independent of `‖r‖`", and taking `Z = (‖r‖, R_0, …, R_{p-1})`
gives the inductive step across passes. -/
theorem indepFun_smul_of_indepPair [IsProbabilityMeasure μ] {κ : Measure G}
    [IsProbabilityMeasure κ] [κ.IsMulRightInvariant] [MeasurableMul G] [MeasurableSMul₂ G X]
    {β : Type*} [MeasurableSpace β]
    {R : Ω → G} {r : Ω → X} {Z : Ω → β}
    (hRmeas : Measurable R) (hrmeas : Measurable r) (hZmeas : Measurable Z)
    (hR : μ.map R = κ) (hindep : IndepFun R (fun ω => (r ω, Z ω)) μ)
    {x₀ : X} (horb : ∀ᵐ ω ∂μ, r ω ∈ MulAction.orbit G x₀) :
    IndepFun (fun ω => R ω • r ω) Z μ := by
  haveI := aux_isProbabilityMeasure_orbitLaw κ x₀
  haveI : IsProbabilityMeasure (μ.map Z) :=
    Measure.isProbabilityMeasure_map hZmeas.aemeasurable
  have hmp := aux_map_pair_snd hRmeas hrmeas hZmeas hR hindep horb
  -- the first marginal of that joint law is the orbit law: the scale variable integrates out
  have hfst : μ.map (fun ω => R ω • r ω) = orbitLaw κ x₀ := by
    have hpm : Measurable (fun ω => (R ω • r ω, Z ω)) := (hRmeas.smul hrmeas).prodMk hZmeas
    have h := congrArg (Measure.map Prod.fst) hmp
    rwa [Measure.map_map measurable_fst hpm, Measure.map_fst_prod, measure_univ, one_smul] at h
  refine (indepFun_iff_map_prod_eq_prod_map_map
    (hRmeas.smul hrmeas).aemeasurable hZmeas.aemeasurable).2 ?_
  show μ.map (fun ω => (R ω • r ω, Z ω)) = (μ.map fun ω => R ω • r ω).prod (μ.map Z)
  rw [hmp, hfst]

end Reisotropisation
/-! ### §5b  Instantiating at the sphere

The orbit of a unit vector under the linear isometry group is the whole unit sphere: this is the
transitivity the paper invokes when it writes "complete `â` to an orthonormal basis". -/

section Sphere

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]

/-- The tautological action of the isometry group on the space.  (Mathlib has
`LinearEquiv.applyDistribMulAction` but no isometric analogue, so we supply it.) -/
scoped instance isoApplyMulAction : MulAction (E ≃ₗᵢ[ℝ] E) E where
  smul L x := L x
  one_smul _ := rfl
  mul_smul _ _ _ := rfl

@[simp] theorem isoApplyMulAction_smul (L : E ≃ₗᵢ[ℝ] E) (x : E) : L • x = L x := rfl

/-- A unit vector occurs as a prescribed member of some orthonormal basis indexed by
`Fin (finrank ℝ E)`. -/
private theorem aux_exists_orthonormalBasis_apply_eq {u : E} (hu : ‖u‖ = 1)
    (i₀ : Fin (Module.finrank ℝ E)) :
    ∃ b : OrthonormalBasis (Fin (Module.finrank ℝ E)) ℝ E, b i₀ = u := by
  have ho : Orthonormal ℝ (Set.restrict ({i₀} : Set (Fin (Module.finrank ℝ E))) (fun _ => u)) := by
    rw [orthonormal_subsingleton_iff]
    intro i; simpa using hu
  obtain ⟨b, hb⟩ := ho.exists_orthonormalBasis_extension_of_card_eq (by simp)
  exact ⟨b, hb i₀ rfl⟩

/-- Transitivity: the isometry group acts transitively on the unit sphere. -/
theorem exists_isometry_map_eq {u v : E} (hu : ‖u‖ = 1) (hv : ‖v‖ = 1) :
    ∃ L : E ≃ₗᵢ[ℝ] E, L u = v := by
  -- a unit vector is nonzero, so the space has positive rank and `Fin (finrank ℝ E)` is inhabited
  have hune : u ≠ 0 := by
    intro h; rw [h, norm_zero] at hu; norm_num at hu
  have hpos : 0 < Module.finrank ℝ E := Module.finrank_pos_iff_exists_ne_zero.2 ⟨u, hune⟩
  obtain ⟨bu, hbu⟩ := aux_exists_orthonormalBasis_apply_eq hu ⟨0, hpos⟩
  obtain ⟨bv, hbv⟩ := aux_exists_orthonormalBasis_apply_eq hv ⟨0, hpos⟩
  refine ⟨bu.equiv bv (Equiv.refl _), ?_⟩
  rw [← hbu, bu.equiv_apply_basis, Equiv.refl_apply, hbv]

/-- Hence the unit sphere is a single orbit. -/
theorem orbit_eq_sphere {u : E} (hu : ‖u‖ = 1) :
    MulAction.orbit (E ≃ₗᵢ[ℝ] E) u = {v : E | ‖v‖ = 1} := by
  ext v
  constructor
  · rintro ⟨L, rfl⟩
    simpa using hu
  · intro hv
    obtain ⟨L, hL⟩ := exists_isometry_map_eq hu hv
    exact ⟨L, by simpa using hL⟩

end Sphere

/-! ## §6  Corollary 1 and the design rule

Corollary 1: since every pass sees the same marginal, the codebook minimising the per-coordinate
MSE minimises it at *every* pass, hence minimises `ρ`, hence minimises the whole envelope `ρ^P`.

The formal content is a monotonicity statement, trivial, and worth stating precisely for that
reason: the corollary is a consequence of Theorem 1, not an independent optimality theorem, and
its scope is *scalar quantisers applied coordinate-wise*. -/

section Optimality

variable {d : ℕ} {ν : Measure ℝ}

/-- Per-coordinate distortion of a scalar quantiser under `ν`. -/
noncomputable def distortion (cb : ℝ → ℝ) (ν : Measure ℝ) : ℝ := ∫ t, (t - cb t) ^ 2 ∂ν

/-- `ρ = √(d · D(cb))`. -/
noncomputable def rho (d : ℕ) (cb : ℝ → ℝ) (ν : Measure ℝ) : ℝ :=
  Real.sqrt (rhoSq d cb ν)

/-- **Corollary 1, per pass.**  A codebook with smaller per-coordinate distortion has a smaller
decay constant. -/
theorem rho_le_of_distortion_le {cb₁ cb₂ : ℝ → ℝ} (h : distortion cb₁ ν ≤ distortion cb₂ ν) :
    rho d cb₁ ν ≤ rho d cb₂ ν := by
  unfold rho rhoSq
  exact Real.sqrt_le_sqrt (mul_le_mul_of_nonneg_left h (Nat.cast_nonneg d))

/-- **Corollary 1, whole envelope.**  …and therefore a smaller error at *every* pass count:
optimality per pass upgrades to optimality of the geometric envelope `ρ^P`.  This is the exact
sense in which "the fixed density-matched codebook is optimal not only per pass but for the
entire geometric envelope". -/
theorem rho_pow_le_of_distortion_le {cb₁ cb₂ : ℝ → ℝ}
    (h : distortion cb₁ ν ≤ distortion cb₂ ν) (P : ℕ) :
    rho d cb₁ ν ^ P ≤ rho d cb₂ ν ^ P := by
  exact pow_le_pow_left₀ (Real.sqrt_nonneg _) (rho_le_of_distortion_le h) P

/-- **Corollary 1 as stated**: if `cb★` minimises the per-coordinate distortion over a class `Q`
of `2^b`-level scalar quantisers, it minimises the `P`-pass error for every `P`, so no per-pass
re-fitting can improve on it. -/
theorem optimal_codebook_optimal_at_every_pass {Q : Set (ℝ → ℝ)} {cb : ℝ → ℝ}
    (hmem : cb ∈ Q) (hmin : ∀ c ∈ Q, distortion cb ν ≤ distortion c ν) (P : ℕ) :
    ∀ c ∈ Q, rho d cb ν ^ P ≤ rho d c ν ^ P :=
  fun c hc => rho_pow_le_of_distortion_le (hmin c hc) P

/-! ### The pass-count design rule -/

/-- **`P = ⌈ln ε / ln ρ⌉` passes suffice** to reach relative error `ε`.  With `ρ` computable by
quadrature (§4), this is the paper's data-free design rule: the number of passes is known before
any weight is touched. -/
theorem rho_pow_ceil_le {ρ ε : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hε0 : 0 < ε) (hε1 : ε ≤ 1) :
    ρ ^ (⌈Real.log ε / Real.log ρ⌉₊) ≤ ε := by
  have hL : Real.log ρ < 0 := Real.log_neg hρ0 hρ1
  set n : ℕ := ⌈Real.log ε / Real.log ρ⌉₊ with hn
  -- `n * log ρ ≤ log ε`, the inequality flipping because `log ρ < 0`.
  have hstep : (n : ℝ) * Real.log ρ ≤ Real.log ε := by
    have := mul_le_mul_of_nonpos_right (Nat.le_ceil (Real.log ε / Real.log ρ)) hL.le
    rwa [div_mul_cancel₀ _ hL.ne] at this
  rw [← Real.log_le_log_iff (pow_pos hρ0 n) hε0, Real.log_pow]
  exact hstep

/-- …and it is the least such `P`. -/
theorem le_ceil_of_rho_pow_le {ρ ε : ℝ} {P : ℕ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hε0 : 0 < ε)
    (h : ρ ^ P ≤ ε) : Real.log ε / Real.log ρ ≤ P := by
  have hL : Real.log ρ < 0 := Real.log_neg hρ0 hρ1
  rw [div_le_iff_of_neg hL, ← Real.log_pow]
  exact Real.log_le_log (pow_pos hρ0 P) h

/-! ### §6b  The paper's `ρ`

`rho d cb (sphericalCoordLaw d)` is the constant of eq. (2.3) as the paper defines it, the one
plotted in the design chart, computable by quadrature before any weight is touched. -/

/-- Eq. (2.3) at the Lemma 1 coordinate law: `ρ² = E[(t-q t)²] / E[t²]` with no side hypothesis,
because §4b supplies `E[t²] = 1/d`. -/
theorem rhoSq_paper_eq_ratio {d : ℕ} (hd : 2 ≤ d) (cb : ℝ → ℝ) :
    rhoSq d cb (sphericalCoordLaw d)
      = (∫ t, (t - cb t) ^ 2 ∂(sphericalCoordLaw d)) / ∫ t, t ^ 2 ∂(sphericalCoordLaw d) := by
  have hd0 : d ≠ 0 := by omega
  exact rhoSq_eq_ratio hd0 (integral_sq_sphericalCoordLaw hd)

end Optimality

/-! ## §7  The counterfactual: freshness of the rotation is necessary

The paper's ablation A1 reports that *"reusing a fixed rotation across passes stalls the decay
precisely as the proposition predicts"*.  Formally, what fails when the rotation is reused is not
a rate but the *existence of a rate*: with a fixed rotation the per-pass ratio is a function of
the starting direction, and no single constant describes it.

Here `d = 2` and `cb` is the two-level codebook `{-1/2, 1/2}`; the rotation stream is constantly
the identity.  Two starting rows give two different one-pass ratios, so no `ρ` can satisfy
`‖r_1‖ = ρ‖w‖` for both. -/

section Counterfactual

/-- The fixed-rotation scheme in `ℝ²` with the two-level codebook `{-1/2, 1/2}`. -/
noncomputable def stallScheme : Scheme (EuclideanSpace ℝ (Fin 2)) where
  rot := fun _ => LinearIsometryEquiv.refl ℝ _
  q := fun v => WithLp.toLp 2 (fun i => if 0 ≤ v i then (1 : ℝ) / 2 else -(1 / 2))

private theorem aux_sq2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)

private theorem aux_sq2_lb : (1 : ℝ) ≤ Real.sqrt 2 := by
  nlinarith [aux_sq2, Real.sqrt_nonneg 2]

/-- One pass of `stallScheme`, unfolded.  The rotation is the identity, so the pull-back `R₀ᵀ`
disappears and `r₁ = w - ‖w‖ · q(w/‖w‖)`. -/
private theorem aux_resid_eq (w : EuclideanSpace ℝ (Fin 2)) :
    resid stallScheme w 1 = w - ‖w‖ • stallScheme.q (‖w‖⁻¹ • w) := rfl

private theorem aux_norm_w1 :
    ‖(WithLp.toLp 2 ![(1 : ℝ), 1] : EuclideanSpace ℝ (Fin 2))‖ = Real.sqrt 2 := by
  rw [EuclideanSpace.norm_eq]
  norm_num [Fin.sum_univ_two]

private theorem aux_norm_w2 :
    ‖(WithLp.toLp 2 ![(1 : ℝ), 0] : EuclideanSpace ℝ (Fin 2))‖ = 1 := by
  rw [EuclideanSpace.norm_eq]
  norm_num [Fin.sum_univ_two]

/-- `w = (1,1)`: `‖w‖ = √2`, `u = (1/√2)(1,1)`, both coordinates are `≥ 0` so `q(u) = (½,½)`,
and `r₁ = (1 - √2/2)(1,1)` has norm `√2 - 1`.  The one-pass ratio is `1 - 1/√2 ≈ 0.293`. -/
private theorem aux_resid_w1 :
    ‖resid stallScheme (WithLp.toLp 2 ![(1 : ℝ), 1]) 1‖ = Real.sqrt 2 - 1 := by
  have h0 : (0 : ℝ) ≤ (Real.sqrt 2)⁻¹ := by positivity
  rw [aux_resid_eq, EuclideanSpace.norm_eq, aux_norm_w1]
  norm_num [Fin.sum_univ_two, stallScheme, h0]
  rw [show (1 - Real.sqrt 2 * (1 / 2)) ^ 2 + (1 - Real.sqrt 2 * (1 / 2)) ^ 2
        = (Real.sqrt 2 - 1) ^ 2 by nlinarith [aux_sq2],
    Real.sqrt_sq (by linarith [aux_sq2_lb])]

/-- `w = (1,0)`: `‖w‖ = 1`, `u = (1,0)`, and since `0 ≤ 0` the codebook still returns
`q(u) = (½,½)`, so `r₁ = (½,-½)` has norm `1/√2`.  The one-pass ratio is `1/√2 ≈ 0.707`. -/
private theorem aux_resid_w2 :
    ‖resid stallScheme (WithLp.toLp 2 ![(1 : ℝ), 0]) 1‖ = Real.sqrt 2 / 2 := by
  rw [aux_resid_eq, EuclideanSpace.norm_eq, aux_norm_w2]
  norm_num [Fin.sum_univ_two, stallScheme]
  have h2 : Real.sqrt 2 ≠ 0 := by positivity
  field_simp
  nlinarith [aux_sq2]

/-- **Freshness is necessary.**  With a fixed rotation there is no constant `ρ` for which the
one-pass residual satisfies `‖r_1‖ = ρ ‖w‖` at every input: the ratio depends on the direction
of `w`, which is exactly what a fresh rotation removes.  Hence the hypothesis of Theorem 1 is
not decorative, the conclusion of Proposition 2 fails without it. -/
theorem no_universal_ratio :
    ¬ ∃ ρ : ℝ, ∀ w : EuclideanSpace ℝ (Fin 2), w ≠ 0 →
      ‖resid stallScheme w 1‖ = ρ * ‖w‖ := by
  rintro ⟨ρ, h⟩
  have hw1 : (WithLp.toLp 2 ![(1 : ℝ), 1] : EuclideanSpace ℝ (Fin 2)) ≠ 0 :=
    fun hc => by simpa using congrFun (congrArg WithLp.ofLp hc) 0
  have hw2 : (WithLp.toLp 2 ![(1 : ℝ), 0] : EuclideanSpace ℝ (Fin 2)) ≠ 0 :=
    fun hc => by simpa using congrFun (congrArg WithLp.ofLp hc) 0
  -- `√2 - 1 = ρ·√2` from `w = (1,1)`, and `√2/2 = ρ·1` from `w = (1,0)`;
  -- together these force `√2 = 2`, i.e. `2 = 4`.
  have h1 := h _ hw1
  have h2 := h _ hw2
  rw [aux_resid_w1, aux_norm_w1] at h1
  rw [aux_resid_w2, aux_norm_w2] at h2
  nlinarith [aux_sq2, Real.sqrt_nonneg 2]

end Counterfactual

/-! ## §9  Beyond scalar codebooks: where Corollary 1's optimality actually stops

Corollary 1 (§6) says the density-matched Lloyd–Max codebook is MSE-optimal *among `2^b`-level
scalar quantisers applied coordinate-wise*.  That qualifier is not a footnote.  Trellis-coded
quantisation (QTIP) and lattice codebooks (QuIP#'s E8P) exist precisely to leave that class, and
on a Gaussian source they recover a shaping gain that no scalar quantiser can reach at any rate.
A reader who takes "one codebook is optimal at every pass" at face value will be misled about
exactly the comparison the low-bit literature cares about.

Two facts, both proved below, place the boundary precisely:

* **The decay law never used the coordinate structure.**  `Scheme.q` is an arbitrary map
  `E → E`, and `IsotropicPasses.distortion` is stated as `∫‖u_p − q u_p‖² = ρ²` with no
  reference to coordinates.  So §3's geometric envelope applies verbatim to a trellis or lattice
  stage quantiser (`integral_norm_resid_sq_vectorStage`).  The progressive construction is *not*
  tied to scalar codebooks; only the evaluation of `ρ` by 1-D quadrature is.

* **Enlarging the class can only help** (`sInf_stageDistortion_le_of_subset`).  So "optimal at
  every pass" is optimality within a strictly smaller class whenever the containment is strict,
  and the attainable decay constant over a richer class is no larger.

Nothing here quantifies the gap, that is an information-theoretic statement about the source,
not a consequence of this recursion.  What is established is that the gap is on the right side of
the inequality, and that the framework does not have to pay it. -/

section VectorStage

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]

/-- The stage distortion of an **arbitrary** quantiser `Q` against the direction law `σ`, the
measure §5 calls `orbitLaw`, i.e. the law of `u_p` on the unit sphere.  This is `ρ²` of
eq. (2.3) with the coordinate structure removed. -/
noncomputable def stageDistortion (Q : E → E) (σ : Measure E) : ℝ := ∫ u, ‖u - Q u‖ ^ 2 ∂σ

theorem stageDistortion_nonneg (Q : E → E) (σ : Measure E) : 0 ≤ stageDistortion Q σ :=
  integral_nonneg fun _ => by positivity

/-- **Corollary 1's optimality is optimality within a class.**  If `Q₁ ⊆ Q₂`, for instance `Q₁`
the coordinate-wise scalar quantisers and `Q₂` those together with the lattice or trellis
quantisers of the same rate, then the best attainable stage distortion over `Q₂` is no worse
than over `Q₁`.  Corollary 1 is therefore silent about, not evidence against, the richer class. -/
theorem sInf_stageDistortion_le_of_subset {Q₁ Q₂ : Set (E → E)} (hsub : Q₁ ⊆ Q₂)
    (hne : Q₁.Nonempty) (σ : Measure E) :
    sInf ((fun Q => stageDistortion Q σ) '' Q₂) ≤ sInf ((fun Q => stageDistortion Q σ) '' Q₁) :=
  csInf_le_csInf ⟨0, fun _ hx => by obtain ⟨Q, _, rfl⟩ := hx; exact stageDistortion_nonneg Q σ⟩
    (hne.image _) (Set.image_mono hsub)

/-- …and a smaller stage distortion gives a smaller `P`-pass envelope, for every `P`, the
vector-valued form of `rho_pow_le_of_distortion_le`. -/
theorem stage_rho_pow_le_of_le {Q₁ Q₂ : E → E} {σ : Measure E}
    (h : stageDistortion Q₂ σ ≤ stageDistortion Q₁ σ) (P : ℕ) :
    Real.sqrt (stageDistortion Q₂ σ) ^ P ≤ Real.sqrt (stageDistortion Q₁ σ) ^ P :=
  pow_le_pow_left₀ (Real.sqrt_nonneg _) (Real.sqrt_le_sqrt h) P

/-- The coordinate-wise scalar quantisers built from a set `C` of scalar codebooks.  This is the
class Corollary 1 optimises over; `sInf_stageDistortion_le_of_subset` applies to any class
containing it. -/
def scalarStages (d : ℕ) (C : Set (ℝ → ℝ)) :
    Set (EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d)) :=
  {Q | ∃ cb ∈ C, Q = fun v => WithLp.toLp 2 fun i => cb (v i)}

/-- Instantiating the previous lemma: whatever richer class `Qs` a trellis or lattice stage
quantiser lives in, as long as it also contains the scalar stages, its optimum is at least as
good.  This is the formal content of "Corollary 1's scope is scalar quantisers". -/
theorem sInf_stageDistortion_scalarStages_le {d : ℕ} {C : Set (ℝ → ℝ)}
    {Qs : Set (EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d))}
    (hsub : scalarStages d C ⊆ Qs) (hne : (scalarStages d C).Nonempty)
    (σ : Measure (EuclideanSpace ℝ (Fin d))) :
    sInf ((fun Q => stageDistortion Q σ) '' Qs)
      ≤ sInf ((fun Q => stageDistortion Q σ) '' scalarStages d C) :=
  sInf_stageDistortion_le_of_subset hsub hne σ

end VectorStage

/-- **The decay law is quantiser-agnostic.**  A restatement of `integral_norm_resid_sq` whose only
purpose is to be citable at an arbitrary stage quantiser: `Scheme.q` is an unrestricted map, and
neither `IsotropicPasses` nor the proof of §3 mentions coordinates, so a trellis-coded or lattice
stage quantiser inherits the same `ρ^{2P}` envelope with no change.  (This is definitionally the
same theorem; it is named separately because the paper's prose ties `ρ` to a scalar codebook and
the independence is worth making explicit.) -/
theorem integral_norm_resid_sq_vectorStage {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    [IsProbabilityMeasure μ] {S : Ω → Scheme E} {W : Ω → E} {ρ : ℝ}
    (h : IsotropicPasses S W ρ μ) (P : ℕ) :
    ∫ ω, ‖resid (S ω) (W ω) P‖ ^ 2 ∂μ = ρ ^ (2 * P) * ∫ ω, ‖W ω‖ ^ 2 ∂μ :=
  integral_norm_resid_sq h P

/-! ## §10  Why the scheme needs no calibration data: indifference to the Hessian

The objection this section answers is the strongest one available against
\S3: unweighted per-coordinate MSE is a *proxy*, and the literature is explicit that
minimising a layerwise reconstruction error is not the same as minimising end-to-end
divergence.  Data-aware methods weight the error by an input-side second-moment matrix `H`
and beat the unweighted objective by doing so.

The scheme here has a specific, provable relationship to that objective, and it is neither
"we also minimise it" nor "we ignore it".  Re-isotropisation makes the residual *direction*
isotropic, and for an isotropic direction the weighted objective `E[uᵀ H u]` collapses to
`tr(H)/d`, the **same number for every `H`**.  The scheme is therefore *indifferent* to the
input-side Hessian rather than ignorant of it.

That cuts exactly two ways, and the paper should say both:

* it is why no calibration data is needed, there is nothing about `H` left to learn, because
  `H` has been averaged out of the objective by the rotation; and
* it is why a data-aware method can still win, indifference also means the scheme *cannot*
  exploit `H` when it is available, which is precisely the fixed-budget gap the paper
  concedes rather than hides.

Only the input-side term is addressed here.  The output-side (cross-layer) factor is
untouched by this argument, and nothing below says anything about it. -/

section HessianIndifference

variable {d : ℕ}

open Finset

/-- The isotropy that a fresh Haar rotation delivers, stated in the only form the quadratic
objective consumes: coordinates uncorrelated, with common variance `1/d`.  For a uniform
direction on `S^{d-1}` both facts hold, the variance is `second_moment_eq_inv_card` of §3b,
forced by `‖u‖ = 1`, and the vanishing cross-moments are the reflection symmetry of the
sphere. -/
structure IsotropicDirection (σ : Measure (EuclideanSpace ℝ (Fin d))) (d : ℕ) : Prop where
  /-- `E[uᵢuⱼ] = δᵢⱼ / d`. -/
  moment : ∀ i j, ∫ u, u i * u j ∂σ = if i = j then (1 : ℝ) / d else 0
  /-- each product is integrable (automatic on the sphere, where `|uᵢ| ≤ 1`). -/
  integrable : ∀ i j, Integrable (fun u => u i * u j) σ

/-- **The weighted objective sees only the dimension.**  For an isotropic direction law, the
layerwise proxy loss `E[uᵀ H u]` equals `tr(H)/d` for *every* `H`, no dependence on the
eigenvectors of `H` at all, and dependence on its eigenvalues only through their sum. -/
theorem integral_quadraticForm_isotropic
    {σ : Measure (EuclideanSpace ℝ (Fin d))} (hσ : IsotropicDirection σ d)
    (H : Matrix (Fin d) (Fin d) ℝ) :
    ∫ u, ∑ i, ∑ j, H i j * (u i * u j) ∂σ = (∑ i, H i i) / d := by
  have hrow : ∀ i : Fin d, ∫ u, ∑ j, H i j * (u i * u j) ∂σ = H i i / d := by
    intro i
    rw [integral_finsetSum _ fun j _ => (hσ.integrable i j).const_mul (H i j)]
    simp_rw [integral_const_mul, hσ.moment i]
    simp [mul_ite, Finset.sum_ite_eq, div_eq_mul_inv]
  rw [integral_finsetSum _ fun i _ =>
    integrable_finsetSum _ fun j _ => (hσ.integrable i j).const_mul (H i j)]
  simp_rw [hrow]
  rw [← Finset.sum_div]

/-- **Indifference, as the paper states it.**  Two input-side second-moment matrices with the
same trace induce exactly the same proxy loss under an isotropic residual direction.  There is
therefore nothing about `H` for a calibration set to reveal, which is why the construction is
data-free, and equally why it cannot profit from data when data is available. -/
theorem quadraticForm_indifferent
    {σ : Measure (EuclideanSpace ℝ (Fin d))} (hσ : IsotropicDirection σ d)
    (H K : Matrix (Fin d) (Fin d) ℝ) (htr : ∑ i, H i i = ∑ i, K i i) :
    ∫ u, ∑ i, ∑ j, H i j * (u i * u j) ∂σ
      = ∫ u, ∑ i, ∑ j, K i j * (u i * u j) ∂σ := by
  rw [integral_quadraticForm_isotropic hσ, integral_quadraticForm_isotropic hσ, htr]

end HessianIndifference

/-! ## §11  The bridge: a rotation stream *derives* `IsotropicPasses`

Header item 3 records that §3's Proposition 2 is conditional on `IsotropicPasses`, and that
nothing connected §5's re-isotropisation machinery to it.  This section builds that connection.

The setting is the one §5 can actually be instantiated in.  Mathlib has no `MeasurableSpace` on
`E ≃ₗᵢ[ℝ] E`, so the rotations are drawn from an abstract measurable group `G` acting on `E`,
together with a map `ι : G → (E ≃ₗᵢ[ℝ] E)` that *implements* the action (`ι g x = g • x`).  For
the paper's `O(d)` one takes `G = O(d)` with its Borel structure; for the deployed randomised
Hadamard transform, `G` is the finite sign-flip group, the results below are indifferent to
which, exactly as §5 is.

The chain is:

* `resid_rotScheme_eq_residPast`, `r_p` is a fixed function of `(w, g_0, …, g_{p-1})` only;
* `measurable_residPast`, that function is measurable;
* `unitVec_rotScheme_eq_smul`, `u_p = g_p • r̂_p` with `r̂_p` a function of the past;
* `indepFun_rot_past`, mutual independence of `(W, R_0, R_1, …)` makes the fresh `R_p`
  independent of the whole past, hence of `(r̂_p, ‖r_p‖²)`;
* `law_unitVec_eq_orbitLaw`, therefore `u_p` has the *same* law `σ = orbitLaw κ x₀` at every
  pass.  This is the statement re-isotropisation is for, and it is what makes the per-pass
  distortion the same number at every pass;
* `isotropicPasses_of_rotationStream`, assembly.

What is thereby removed from the hypothesis list of Proposition 2: `IsotropicPasses.indep` and
`IsotropicPasses.distortion`, the two substantive fields, and both integrability fields. -/

section BridgeAlgebra

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
variable {G : Type*} [Group G] [MulAction G E]

/-- The scheme whose pass-`p` rotation is `ι (g p)` and whose (single, fixed) quantiser is `q`. -/
def rotScheme (ι : G → (E ≃ₗᵢ[ℝ] E)) (q : E → E) (g : ℕ → G) : Scheme E where
  rot p := ι (g p)
  q := q

/-- `residPast q p` computes `r_p` from the pair `(w, (g_0,…,g_{p-1}))`, the *past* alone. -/
noncomputable def residPast (q : E → E) : ∀ p : ℕ, E × (Fin p → G) → E
  | 0, x => x.1
  | (p + 1), x =>
      let r := residPast q p (x.1, fun i => x.2 i.castSucc)
      r - ‖r‖ • ((x.2 (Fin.last p))⁻¹ • q (‖r‖⁻¹ • ((x.2 (Fin.last p)) • r)))

/-- The normalised residual `r̂_p = r_p/‖r_p‖`, as a function of the past. -/
noncomputable def residDirPast (q : E → E) (p : ℕ) (x : E × (Fin p → G)) : E :=
  ‖residPast q p x‖⁻¹ • residPast q p x

variable {ι : G → (E ≃ₗᵢ[ℝ] E)}

/-- If `ι` implements the `G`-action, the inverse isometry implements the inverse action. -/
theorem symm_apply_eq_inv_smul (hι : ∀ (g : G) (x : E), ι g x = g • x) (g : G) (y : E) :
    (ι g).symm y = g⁻¹ • y := by
  have h : ι g (g⁻¹ • y) = y := by rw [hι, smul_inv_smul]
  conv_lhs => rw [← h]
  rw [LinearIsometryEquiv.symm_apply_apply]

/-- If `ι` implements the `G`-action, that action is `ℝ`-linear. -/
theorem smul_comm_real (hι : ∀ (g : G) (x : E), ι g x = g • x) (g : G) (c : ℝ) (x : E) :
    g • (c • x) = c • (g • x) := by
  rw [← hι, ← hι, map_smul]

/-- **The residual factors through the past.**  `r_p` is the value at `(w, g_0,…,g_{p-1})` of a
fixed map: it does not see `g_p, g_{p+1}, …`.  This is the inductive fact the paper argues in
prose after eq. (2.2), and it is what makes the pass-`p` rotation *fresh*. -/
theorem resid_rotScheme_eq_residPast (hι : ∀ (g : G) (x : E), ι g x = g • x) (q : E → E) (w : E)
    (g : ℕ → G) (p : ℕ) :
    resid (rotScheme ι q g) w p = residPast q p (w, fun i : Fin p => g i) := by
  induction p with
  | zero => rfl
  | succ p ih =>
      have hcast : (fun i : Fin p => (fun j : Fin (p + 1) => g j) i.castSucc)
          = fun i : Fin p => g i := by
        funext i; simp
      rw [resid_succ, unitVec, ih, residPast]
      simp only [hcast, Fin.val_last]
      rw [show (rotScheme ι q g).rot p = ι (g p) from rfl, show (rotScheme ι q g).q = q from rfl,
        symm_apply_eq_inv_smul hι, hι]

/-- **The unit direction is the fresh rotation applied to a function of the past.**  This is the
exact shape `indepFun_smul_of_indepPair` (§5) consumes. -/
theorem unitVec_rotScheme_eq_smul (hι : ∀ (g : G) (x : E), ι g x = g • x) (q : E → E) (w : E)
    (g : ℕ → G) (p : ℕ) :
    unitVec (rotScheme ι q g) w p = g p • residDirPast q p (w, fun i : Fin p => g i) := by
  rw [unitVec, residDirPast, smul_comm_real hι, resid_rotScheme_eq_residPast hι,
    show (rotScheme ι q g).rot p = ι (g p) from rfl, hι]

/-- The normalised residual is a unit vector whenever the pass is not already exact. -/
theorem norm_residDirPast (hι : ∀ (g : G) (x : E), ι g x = g • x) {q : E → E} {w : E}
    {g : ℕ → G} {p : ℕ} (h : resid (rotScheme ι q g) w p ≠ 0) :
    ‖residDirPast q p (w, fun i : Fin p => g i)‖ = 1 := by
  rw [resid_rotScheme_eq_residPast hι] at h
  rw [residDirPast, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (norm_ne_zero_iff.mpr h)]

end BridgeAlgebra

section BridgeMeasurable

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
variable {G : Type*} [Group G] [MeasurableSpace G] [MulAction G E] [MeasurableSMul₂ G E]
  [MeasurableInv G]

theorem measurable_residPast {q : E → E} (hq : Measurable q) (p : ℕ) :
    Measurable (residPast (G := G) q p) := by
  induction p with
  | zero => exact measurable_fst
  | succ p ih =>
      have h1 : Measurable (fun x : E × (Fin (p + 1) → G) =>
          (x.1, fun i : Fin p => x.2 i.castSucc)) :=
        measurable_fst.prodMk (measurable_pi_lambda _ fun i =>
          (measurable_pi_apply (i.castSucc)).comp measurable_snd)
      have hr : Measurable (fun x : E × (Fin (p + 1) → G) =>
          residPast (G := G) q p (x.1, fun i : Fin p => x.2 i.castSucc)) := ih.comp h1
      have hg : Measurable (fun x : E × (Fin (p + 1) → G) => x.2 (Fin.last p)) :=
        (measurable_pi_apply _).comp measurable_snd
      exact hr.sub ((hr.norm).smul
        ((hg.inv).smul (hq.comp (((hr.norm).inv).smul (hg.smul hr)))))

theorem measurable_residDirPast {q : E → E} (hq : Measurable q) (p : ℕ) :
    Measurable (residDirPast (G := G) q p) :=
  ((measurable_residPast hq p).norm.inv).smul (measurable_residPast hq p)

end BridgeMeasurable

/-! ### §11b  Mutual independence of the stream makes each rotation fresh

The remaining structural fact is that the pass-`p` rotation is independent of *everything the
recursion has already used*.  Stated for the family `(W, R_0, R_1, …)` indexed by `Option ℕ`
(`none` = the weight row), this is a disjoint-index-sets consequence of mutual independence.

The `Option ℕ`-indexed family is heterogeneous (`E` at `none`, `G` elsewhere), which forces `E`
and `G` into a common universe here; nothing downstream of this subsection needs that, because
`indepFun_rot_past_of_iIndepFun`'s *conclusion* is universe-polymorphic and is the only thing
the assembly consumes. -/

section BridgeStream

universe u

variable {E : Type u} [MeasurableSpace E] {G : Type u} [MeasurableSpace G]
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}

/-- The state space of the joint randomness: the weight row at `none`, a rotation at `some p`. -/
def streamSpace (E G : Type u) : Option ℕ → Type u
  | none => E
  | some _ => G

instance streamSpaceMeasurableSpace (E G : Type u) [MeasurableSpace E] [MeasurableSpace G] :
    ∀ i : Option ℕ, MeasurableSpace (streamSpace E G i)
  | none => inferInstanceAs (MeasurableSpace E)
  | some _ => inferInstanceAs (MeasurableSpace G)

/-- The joint randomness of the scheme, as one family of random variables. -/
def streamVar (W : Ω → E) (R : Ω → ℕ → G) : ∀ i : Option ℕ, Ω → streamSpace E G i
  | none => W
  | some p => fun ω => R ω p

/-- **The fresh-rotation lemma.**  If the weight row and the whole rotation stream are mutually
independent, then the pass-`p` rotation is independent of the pair *(weight row, all earlier
rotations)*, which by `resid_rotScheme_eq_residPast` is everything `r_p` depends on. -/
theorem indepFun_rot_past_of_iIndepFun {W : Ω → E} {R : Ω → ℕ → G}
    (hW : Measurable W) (hR : ∀ p, Measurable (fun ω => R ω p))
    (h : iIndepFun (streamVar W R) μ) (p : ℕ) :
    IndepFun (fun ω => R ω p) (fun ω => (W ω, fun i : Fin p => R ω i)) μ := by
  have hmeas : ∀ i, Measurable (streamVar W R i) := by
    rintro (_ | q)
    · exact hW
    · exact hR q
  have hdisj : Disjoint ({some p} : Finset (Option ℕ))
      (insert none ((Finset.range p).image some)) := by
    simp [Finset.disjoint_singleton_left]
  have key := h.indepFun_finset {some p} (insert none ((Finset.range p).image some)) hdisj hmeas
  have hmemp : some p ∈ ({some p} : Finset (Option ℕ)) := Finset.mem_singleton_self _
  have hmemn : none ∈ insert none ((Finset.range p).image some) := Finset.mem_insert_self _ _
  have hmemi : ∀ i : Fin p, some (i : ℕ) ∈ insert none ((Finset.range p).image some) := fun i =>
    Finset.mem_insert_of_mem (Finset.mem_image_of_mem some (Finset.mem_range.mpr i.isLt))
  have hφ : Measurable (fun v : ((i : ({some p} : Finset (Option ℕ))) → streamSpace E G i) =>
      v ⟨some p, hmemp⟩) := measurable_pi_apply _
  have hψ : Measurable
      (fun v : ((i : (insert none ((Finset.range p).image some) : Finset (Option ℕ))) →
          streamSpace E G i) =>
        ((v ⟨none, hmemn⟩ : E), fun i : Fin p => (v ⟨some (i : ℕ), hmemi i⟩ : G))) :=
    (measurable_pi_apply _).prodMk
      (measurable_pi_lambda _ fun _ => measurable_pi_apply _)
  exact key.comp hφ hψ

end BridgeStream

/-! ### §11c  Assembling `IsotropicPasses` -/

section BridgeAssembly

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
variable {G : Type*} [Group G] [MeasurableSpace G] [MulAction G E] [MeasurableSMul₂ G E]
  [MeasurableInv G]
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}

/-- **The hypotheses of the re-isotropised scheme.**  A rotation stream `R` drawn from a
measurable group `G` that acts on `E` through isometries `ι`, together with the regularity the
measure-theoretic argument needs.

Every field is a statement about the *inputs* of the algorithm, never about a residual law, and
never about a per-pass expectation.  That is the whole point: `IsotropicPasses.indep` and
`IsotropicPasses.distortion`, which are statements about residuals, become theorems. -/
structure RotationStream (ι : G → (E ≃ₗᵢ[ℝ] E)) (q : E → E) (W : Ω → E) (R : Ω → ℕ → G)
    (κ : Measure G) (x₀ : E) (μ : Measure Ω) : Prop where
  /-- `ι` implements the `G`-action: this is what makes `G` "a group of rotations". -/
  implements : ∀ (g : G) (x : E), ι g x = g • x
  /-- the quantiser is measurable. -/
  meas_q : Measurable q
  /-- the weight row is measurable. -/
  meas_W : Measurable W
  /-- every rotation is measurable. -/
  meas_R : ∀ p, Measurable (fun ω => R ω p)
  /-- **every pass draws from the same law `κ`**, one Haar draw per pass. -/
  law_R : ∀ p, μ.map (fun ω => R ω p) = κ
  /-- **the pass-`p` rotation is fresh**: independent of the weight row and of all earlier
  rotations, which by `resid_rotScheme_eq_residPast` is everything `r_p` can depend on.
  `indepFun_rot_past_of_iIndepFun` derives this from mutual independence of `(W, R_0, R_1, …)`. -/
  fresh : ∀ p, IndepFun (fun ω => R ω p) (fun ω => (W ω, fun i : Fin p => R ω i)) μ
  /-- no pass is exact, almost surely.  §5's orbit hypothesis is stated `∀ᵐ ω ∂μ`, which is the
  honest measure-theoretic form and lets this field be a.e.\ rather than pointwise. -/
  exact_never : ∀ p, ∀ᵐ ω ∂μ, resid (rotScheme ι q (R ω)) (W ω) p ≠ 0
  /-- `G` is transitive on the unit sphere, with base point `x₀`.  For `G = O(d)` this is
  `orbit_eq_sphere` of §5b; for a finite subgroup it is false, and the conclusions below then
  genuinely do not apply (cf. header item 4). -/
  transitive : ∀ x : E, ‖x‖ = 1 → x ∈ MulAction.orbit G x₀

variable {ι : G → (E ≃ₗᵢ[ℝ] E)} {q : E → E} {W : Ω → E} {R : Ω → ℕ → G} {κ : Measure G} {x₀ : E}

omit [BorelSpace E] [SecondCountableTopology E] [MeasurableSMul₂ G E] [MeasurableInv G] in
private theorem aux_meas_past (h : RotationStream ι q W R κ x₀ μ) (p : ℕ) :
    Measurable (fun ω => (W ω, fun i : Fin p => R ω i)) :=
  h.meas_W.prodMk (measurable_pi_lambda _ fun i => h.meas_R i)

private theorem aux_meas_dir (h : RotationStream ι q W R κ x₀ μ) (p : ℕ) :
    Measurable (fun ω => residDirPast q p (W ω, fun i : Fin p => R ω i)) :=
  (measurable_residDirPast h.meas_q p).comp (aux_meas_past h p)

private theorem aux_meas_unitVec (h : RotationStream ι q W R κ x₀ μ) (p : ℕ) :
    Measurable (fun ω => unitVec (rotScheme ι q (R ω)) (W ω) p) := by
  simp only [unitVec_rotScheme_eq_smul h.implements]
  exact (h.meas_R p).smul (aux_meas_dir h p)

omit [BorelSpace E] [SecondCountableTopology E] [MeasurableSMul₂ G E] [MeasurableInv G] in
private theorem aux_orbit (h : RotationStream ι q W R κ x₀ μ) (p : ℕ) :
    ∀ᵐ ω ∂μ, residDirPast q p (W ω, fun i : Fin p => R ω i) ∈ MulAction.orbit G x₀ := by
  filter_upwards [h.exact_never p] with ω hω
  exact h.transitive _ (norm_residDirPast h.implements hω)

omit [BorelSpace E] [SecondCountableTopology E] [MeasurableSMul₂ G E] [MeasurableInv G] in
private theorem aux_isProb (h : RotationStream ι q W R κ x₀ μ) [IsProbabilityMeasure μ] :
    IsProbabilityMeasure κ := by
  rw [← h.law_R 0]
  exact Measure.isProbabilityMeasure_map (h.meas_R 0).aemeasurable

/-- The fresh rotation is independent of the pair *(normalised residual, squared scale)*, the
exact hypothesis of `indepFun_smul_of_indepPair`.  This is `RotationStream.fresh` pushed through
the measurable map `resid_rotScheme_eq_residPast` supplies. -/
theorem indepFun_rot_dirScale (h : RotationStream ι q W R κ x₀ μ) (p : ℕ) :
    IndepFun (fun ω => R ω p)
      (fun ω => (residDirPast q p (W ω, fun i : Fin p => R ω i),
        ‖resid (rotScheme ι q (R ω)) (W ω) p‖ ^ 2)) μ := by
  have hΨ : Measurable (fun x : E × (Fin p → G) =>
      (residDirPast (G := G) q p x, ‖residPast (G := G) q p x‖ ^ 2)) :=
    (measurable_residDirPast h.meas_q p).prodMk
      ((measurable_residPast h.meas_q p).norm.pow_const 2)
  have hc := (h.fresh p).comp (measurable_id (α := G)) hΨ
  simpa [Function.comp_def, resid_rotScheme_eq_residPast h.implements] using hc

private theorem aux_meas_scale (h : RotationStream ι q W R κ x₀ μ) (p : ℕ) :
    Measurable (fun ω => ‖resid (rotScheme ι q (R ω)) (W ω) p‖ ^ 2) := by
  simp only [resid_rotScheme_eq_residPast h.implements]
  exact ((measurable_residPast h.meas_q p).comp (aux_meas_past h p)).norm.pow_const 2

variable [MeasurableMul G] [IsProbabilityMeasure μ] [κ.IsMulRightInvariant]

/-- **Re-isotropisation, the statement the paper is really making.**  The unit direction `u_p`
has *the same law* `orbitLaw κ x₀` at every pass `p`, no matter what the residual `r_p` looks
like, and no matter what the quantiser `q` has done to it in the previous `p` passes.

This is the fact `IsotropicPasses.distortion` was assuming.  It is the payoff of §5's
`law_smul_eq_orbitLaw` combined with `resid_rotScheme_eq_residPast`: the residual direction is a
function of the past, the fresh rotation is independent of the past, and the orbit law is
constant along the orbit. -/
theorem law_unitVec_eq_orbitLaw (h : RotationStream ι q W R κ x₀ μ) (p : ℕ) :
    μ.map (fun ω => unitVec (rotScheme ι q (R ω)) (W ω) p) = orbitLaw κ x₀ := by
  haveI := aux_isProb h
  have hindep : IndepFun (fun ω => R ω p)
      (fun ω => residDirPast q p (W ω, fun i : Fin p => R ω i)) μ := by
    simpa [Function.comp_def] using
      (indepFun_rot_dirScale h p).comp (measurable_id (α := G)) measurable_fst
  have hkey := law_smul_eq_orbitLaw (R := fun ω => R ω p)
      (r := fun ω => residDirPast q p (W ω, fun i : Fin p => R ω i))
      (h.meas_R p) (aux_meas_dir h p) (h.law_R p) hindep (aux_orbit h p)
  simpa only [unitVec_rotScheme_eq_smul h.implements] using hkey

/-- **`IsotropicPasses.distortion`, derived.**  The expected squared normalised quantisation
error is the *same number* at every pass, namely the stage distortion of `q` against the
direction law.  The paper asserts this; here it is a consequence of `law_unitVec_eq_orbitLaw`. -/
theorem integral_stageErr_eq_stageDistortion (h : RotationStream ι q W R κ x₀ μ) (p : ℕ) :
    ∫ ω, ‖unitVec (rotScheme ι q (R ω)) (W ω) p
        - q (unitVec (rotScheme ι q (R ω)) (W ω) p)‖ ^ 2 ∂μ
      = stageDistortion q (orbitLaw κ x₀) := by
  have hasm : AEStronglyMeasurable (fun u : E => ‖u - q u‖ ^ 2)
      (μ.map (fun ω => unitVec (rotScheme ι q (R ω)) (W ω) p)) :=
    ((measurable_id.sub h.meas_q).norm.pow_const 2).aestronglyMeasurable
  rw [stageDistortion, ← law_unitVec_eq_orbitLaw h p,
    integral_map (aux_meas_unitVec h p).aemeasurable hasm]

/-- **`IsotropicPasses.integrable_err`, derived** from finiteness of the stage distortion. -/
theorem integrable_stageErr (h : RotationStream ι q W R κ x₀ μ)
    (hint : Integrable (fun u : E => ‖u - q u‖ ^ 2) (orbitLaw κ x₀)) (p : ℕ) :
    Integrable (fun ω => ‖unitVec (rotScheme ι q (R ω)) (W ω) p
        - q (unitVec (rotScheme ι q (R ω)) (W ω) p)‖ ^ 2) μ := by
  rw [← law_unitVec_eq_orbitLaw h p] at hint
  have hasm : AEStronglyMeasurable (fun u : E => ‖u - q u‖ ^ 2)
      (μ.map (fun ω => unitVec (rotScheme ι q (R ω)) (W ω) p)) :=
    ((measurable_id.sub h.meas_q).norm.pow_const 2).aestronglyMeasurable
  exact (integrable_map_measure hasm (aux_meas_unitVec h p).aemeasurable).mp hint

/-- **`IsotropicPasses.indep`, derived.**  The squared scale `‖r_p‖²`, a function of the past,
is independent of the squared normalised quantisation error at pass `p`, because the latter is a
function of `R_p • r̂_p` and `R_p` is fresh.  This is the inductive discharge across all passes
that the header records as missing. -/
theorem indepFun_scale_stageErr (h : RotationStream ι q W R κ x₀ μ) (p : ℕ) :
    IndepFun (fun ω => ‖resid (rotScheme ι q (R ω)) (W ω) p‖ ^ 2)
      (fun ω => ‖unitVec (rotScheme ι q (R ω)) (W ω) p
        - q (unitVec (rotScheme ι q (R ω)) (W ω) p)‖ ^ 2) μ := by
  haveI := aux_isProb h
  have key := indepFun_smul_of_indepPair (R := fun ω => R ω p)
    (r := fun ω => residDirPast q p (W ω, fun i : Fin p => R ω i))
    (Z := fun ω => ‖resid (rotScheme ι q (R ω)) (W ω) p‖ ^ 2)
    (h.meas_R p) (aux_meas_dir h p) (aux_meas_scale h p) (h.law_R p)
    (indepFun_rot_dirScale h p) (aux_orbit h p)
  have hmeasφ : Measurable (fun u : E => ‖u - q u‖ ^ 2) :=
    (measurable_id.sub h.meas_q).norm.pow_const 2
  have hrw : ∀ ω, R ω p • residDirPast q p (W ω, fun i : Fin p => R ω i)
      = unitVec (rotScheme ι q (R ω)) (W ω) p :=
    fun ω => (unitVec_rotScheme_eq_smul h.implements q (W ω) (R ω) p).symm
  simp only [hrw] at key
  exact (key.comp hmeasφ (measurable_id (α := ℝ))).symm

/-- **`IsotropicPasses.integrable`, derived** by induction along the passes, using
`IndepFun.integrable_mul` at each step. -/
theorem integrable_normSq_resid (h : RotationStream ι q W R κ x₀ μ)
    (hW : Integrable (fun ω => ‖W ω‖ ^ 2) μ)
    (hint : Integrable (fun u : E => ‖u - q u‖ ^ 2) (orbitLaw κ x₀)) (p : ℕ) :
    Integrable (fun ω => ‖resid (rotScheme ι q (R ω)) (W ω) p‖ ^ 2) μ := by
  induction p with
  | zero => simpa using hW
  | succ p ih =>
      have hmul := (indepFun_scale_stageErr h p).integrable_mul ih (integrable_stageErr h hint p)
      have heq : (fun ω => ‖resid (rotScheme ι q (R ω)) (W ω) (p + 1)‖ ^ 2)
          = (fun ω => ‖resid (rotScheme ι q (R ω)) (W ω) p‖ ^ 2) *
            (fun ω => ‖unitVec (rotScheme ι q (R ω)) (W ω) p
              - q (unitVec (rotScheme ι q (R ω)) (W ω) p)‖ ^ 2) := by
        funext ω; exact norm_resid_succ_sq _ _ p
      rw [heq]; exact hmul

/-- **The bridge.**  A rotation stream satisfying `RotationStream`, hypotheses about the
*inputs* only, supplies `IsotropicPasses` with `ρ² = stageDistortion q (orbitLaw κ x₀)`.  All
four fields, including the two substantive ones, are derived. -/
theorem isotropicPasses_of_rotationStream (h : RotationStream ι q W R κ x₀ μ)
    (hW : Integrable (fun ω => ‖W ω‖ ^ 2) μ)
    (hint : Integrable (fun u : E => ‖u - q u‖ ^ 2) (orbitLaw κ x₀)) :
    IsotropicPasses (fun ω => rotScheme ι q (R ω)) W
      (Real.sqrt (stageDistortion q (orbitLaw κ x₀))) μ where
  integrable p := integrable_normSq_resid h hW hint p
  integrable_err p := integrable_stageErr h hint p
  indep p := indepFun_scale_stageErr h p
  distortion p := by
    rw [Real.sq_sqrt (stageDistortion_nonneg q (orbitLaw κ x₀))]
    exact integral_stageErr_eq_stageDistortion h p

/-- **Proposition 2, unconditionally**, for a re-isotropised progressive quantiser: the geometric
decay law with the constant *identified* as the stage distortion of the codebook against the
direction law, rather than assumed to exist. -/
theorem integral_norm_resid_sq_rotationStream (h : RotationStream ι q W R κ x₀ μ)
    (hW : Integrable (fun ω => ‖W ω‖ ^ 2) μ)
    (hint : Integrable (fun u : E => ‖u - q u‖ ^ 2) (orbitLaw κ x₀)) (P : ℕ) :
    ∫ ω, ‖resid (rotScheme ι q (R ω)) (W ω) P‖ ^ 2 ∂μ
      = stageDistortion q (orbitLaw κ x₀) ^ P * ∫ ω, ‖W ω‖ ^ 2 ∂μ := by
  have hkey := integral_norm_resid_sq (isotropicPasses_of_rotationStream h hW hint) P
  rwa [pow_mul, Real.sq_sqrt (stageDistortion_nonneg q (orbitLaw κ x₀))] at hkey

/-- The direction law is *the same at every pair of passes*, the citable form of
"re-isotropisation restores isotropy at every stage". -/
theorem law_unitVec_eq_law_unitVec (h : RotationStream ι q W R κ x₀ μ) (p p' : ℕ) :
    μ.map (fun ω => unitVec (rotScheme ι q (R ω)) (W ω) p)
      = μ.map (fun ω => unitVec (rotScheme ι q (R ω)) (W ω) p') := by
  rw [law_unitVec_eq_orbitLaw h p, law_unitVec_eq_orbitLaw h p']

/-- **Eq. (2.5), unconditionally**, for a deterministic weight row: the RMS relative error after
`P` passes is exactly `ρ^P` with `ρ = √(stage distortion)`. -/
theorem rms_relative_error_rotationStream {w : E} (hw : w ≠ 0)
    (h : RotationStream ι q (fun _ => w) R κ x₀ μ)
    (hint : Integrable (fun u : E => ‖u - q u‖ ^ 2) (orbitLaw κ x₀)) (P : ℕ) :
    Real.sqrt (∫ ω, ‖resid (rotScheme ι q (R ω)) w P‖ ^ 2 ∂μ) / ‖w‖
      = Real.sqrt (stageDistortion q (orbitLaw κ x₀)) ^ P :=
  rms_relative_error hw (Real.sqrt_nonneg _)
    (isotropicPasses_of_rotationStream h (integrable_const _) hint) P

end BridgeAssembly
/-! ## §12  A witness: the hypotheses of §11 are satisfiable

`isotropicPasses_of_rotationStream` derives `IsotropicPasses` from `RotationStream`.  That is
only worth something if some object *satisfies* `RotationStream`: a bundle of contradictory
hypotheses would make every theorem of §11 vacuously true, and the file would certify nothing.
This section rules that out by exhibiting one.

The witness is `E = ℝ` with the two-element rotation group `{+1,-1}`, which is exactly `O(1)`,
and which is genuinely transitive on the unit sphere `{±1}`, the uniform law on it, and the
halving quantiser `q(x) = x/2`.  Every field of `RotationStream` is discharged, including the
two that carry the content: `law_R` (one draw from a right-invariant law per pass) and `fresh`
(the pass-`p` rotation is independent of the weight row and all earlier rotations), the latter
obtained from a genuinely i.i.d. rotation stream via `Measure.exists_iid`.

**What this does and does not settle.**  It settles that §11 is not vacuous, and it pins `ρ` to
a number: `witness_stageDistortion` computes the stage distortion to be `1/4`, so §11's
general theorem returns `err(P) = (1/2)^P` for this scheme, which `exists_witness_decay`
reads off.  It
does **not** close the instantiation gap of §5: `d = 1` is the one dimension in which the
orthogonal group is finite, and Mathlib still has neither a `MeasurableSpace` on `E ≃ₗᵢ[ℝ] E`
nor a Haar measure on `O(d)` for `d ≥ 2`, so the paper's `R ∼ Haar(O(d))` remains uninstantiable
here.  A witness proves consistency, not generality. -/

namespace Witness

/-- The rotation group of the line: two elements acting by `±1`.  This is `O(1)`. -/
inductive Sign : Type
  | pos : Sign
  | neg : Sign
  deriving DecidableEq

instance : Fintype Sign where
  elems := {Sign.pos, Sign.neg}
  complete := by rintro (_ | _) <;> simp

instance : MeasurableSpace Sign := ⊤

instance : MeasurableSingletonClass Sign := ⟨fun _ => trivial⟩

instance : Mul Sign :=
  ⟨fun a b => match a, b with
    | .pos, b => b
    | .neg, .pos => .neg
    | .neg, .neg => .pos⟩

instance : One Sign := ⟨.pos⟩

instance : Inv Sign := ⟨id⟩

instance : Group Sign where
  mul_assoc := by decide
  one_mul := by decide
  mul_one := by decide
  inv_mul_cancel := by decide

instance : MeasurableMul Sign :=
  ⟨fun _ => measurable_of_countable _, fun _ => measurable_of_countable _⟩

instance : MeasurableInv Sign := ⟨measurable_of_countable _⟩

/-- The scalar `±1` that a sign denotes. -/
def val : Sign → ℝ
  | .pos => 1
  | .neg => -1

@[simp] theorem val_pos : val .pos = 1 := rfl

@[simp] theorem val_neg : val .neg = -1 := rfl

instance : SMul Sign ℝ := ⟨fun s x => val s * x⟩

@[simp] theorem smul_def (s : Sign) (x : ℝ) : s • x = val s * x := rfl

theorem val_mul (a b : Sign) : val (a * b) = val a * val b := by
  cases a <;> cases b <;> norm_num [val]

@[simp] theorem abs_val (s : Sign) : |val s| = 1 := by cases s <;> norm_num

instance : MulAction Sign ℝ where
  one_smul x := by simp [show val 1 = 1 from rfl]
  mul_smul a b x := by simp [val_mul, mul_assoc]

instance : MeasurableSMul₂ Sign ℝ :=
  ⟨measurable_from_prod_countable_right fun s => by
    simpa using measurable_const_mul (val s)⟩

/-- The uniform law on the two rotations: the counting measure halved. -/
noncomputable def unif : Measure Sign := (2 : ℝ≥0∞)⁻¹ • Measure.count

instance : IsProbabilityMeasure unif := by
  constructor
  have hcard : (ENat.card Sign) = 2 := by
    rw [ENat.card_eq_coe_natCard, Nat.card_eq_fintype_card]
    rfl
  rw [unif, Measure.smul_apply, Measure.count_univ, hcard, smul_eq_mul,
    show ((2 : ℕ∞) : ℝ≥0∞) = (2 : ℝ≥0∞) by simp]
  exact ENNReal.inv_mul_cancel (by norm_num) (by norm_num)

instance : unif.IsMulRightInvariant := by
  rw [unif]; infer_instance

/-- The rotation `ι` of §11: multiplication by `±1`, as a linear isometry of `ℝ`. -/
def rot : Sign → (ℝ ≃ₗᵢ[ℝ] ℝ)
  | .pos => LinearIsometryEquiv.refl ℝ ℝ
  | .neg => LinearIsometryEquiv.neg ℝ

theorem rot_implements (s : Sign) (x : ℝ) : rot s x = s • x := by
  cases s <;> simp [rot]

/-- The stage quantiser: halve.  Chosen because it is measurable, never exact on a nonzero
residual (so `RotationStream.exact_never` holds pointwise, as §5's orbit hypothesis demands),
and has an explicitly computable stage distortion. -/
noncomputable def half (x : ℝ) : ℝ := x / 2

theorem measurable_half : Measurable half := by unfold half; fun_prop

theorem measurable_err : Measurable (fun u : ℝ => ‖u - half u‖ ^ 2) := by
  unfold half; fun_prop

theorem norm_sub_half (u : ℝ) : ‖u - half u‖ = ‖u‖ / 2 := by
  have : u - half u = u / 2 := by rw [half]; ring
  rw [this, norm_div]
  norm_num

/-! ### The residual never vanishes, and shrinks by exactly one half per pass -/

theorem norm_resid_witness (g : ℕ → Sign) {w : ℝ} (hw : w ≠ 0) (p : ℕ) :
    ‖resid (rotScheme rot half g) w p‖ = ‖w‖ / 2 ^ p := by
  induction p with
  | zero => simp
  | succ p ih =>
      have hpos : (0 : ℝ) < ‖w‖ / 2 ^ p := by
        have := norm_pos_iff.mpr hw
        positivity
      have hne : resid (rotScheme rot half g) w p ≠ 0 := by
        rw [← norm_ne_zero_iff, ih]
        exact ne_of_gt hpos
      rw [norm_resid_succ]
      have hq : (rotScheme rot half g).q = half := rfl
      rw [hq, norm_sub_half, norm_unitVec _ _ _ hne, ih]
      ring

theorem resid_witness_ne_zero (g : ℕ → Sign) {w : ℝ} (hw : w ≠ 0) (p : ℕ) :
    resid (rotScheme rot half g) w p ≠ 0 := by
  rw [← norm_ne_zero_iff, norm_resid_witness g hw p]
  have := norm_pos_iff.mpr hw
  positivity

/-- `Sign` is transitive on the unit sphere of `ℝ`, which is `{±1}`.  This is the one dimension
in which the orthogonal group is finite and the transitivity is provable by cases. -/
theorem transitive_on_sphere (x : ℝ) (hx : ‖x‖ = 1) : x ∈ MulAction.orbit Sign (1 : ℝ) := by
  rw [Real.norm_eq_abs, abs_eq (by norm_num : (0:ℝ) ≤ 1)] at hx
  rcases hx with h | h
  · exact ⟨.pos, by simp [h]⟩
  · exact ⟨.neg, by simp [h]⟩

/-! ### The stage distortion is exactly `1/4`, so `ρ = 1/2` -/

private theorem aux_meas_orbit : Measurable (fun s : Sign => s • (1 : ℝ)) :=
  measurable_of_countable _

private theorem aux_err_const (s : Sign) : ‖s • (1 : ℝ) - half (s • (1 : ℝ))‖ ^ 2 = 1 / 4 := by
  rw [norm_sub_half, smul_def, mul_one, Real.norm_eq_abs, abs_val]
  norm_num

theorem witness_integrable :
    Integrable (fun u : ℝ => ‖u - half u‖ ^ 2) (orbitLaw unif (1 : ℝ)) := by
  rw [orbitLaw,
    integrable_map_measure measurable_err.aestronglyMeasurable aux_meas_orbit.aemeasurable]
  exact (integrable_const (1 / 4 : ℝ)).congr
    (Filter.Eventually.of_forall fun s => (aux_err_const s).symm)

theorem witness_stageDistortion : stageDistortion half (orbitLaw unif (1 : ℝ)) = 1 / 4 := by
  rw [stageDistortion, orbitLaw,
    integral_map aux_meas_orbit.aemeasurable measurable_err.aestronglyMeasurable]
  simp only [aux_err_const]
  simp

theorem witness_rho : Real.sqrt (stageDistortion half (orbitLaw unif (1 : ℝ))) = 1 / 2 := by
  rw [witness_stageDistortion]
  rw [show (1 / 4 : ℝ) = (1 / 2) ^ 2 by norm_num]
  exact Real.sqrt_sq (by norm_num)

/-! ### Assembling the witness -/

/-- **`RotationStream` is satisfiable.**  Everything is concrete except the probability space,
which is produced by `Measure.exists_iid`: an i.i.d. stream of rotations, each with law `unif`.
`fresh` is then the disjoint-index-set consequence of mutual independence, exactly as
`indepFun_rot_past_of_iIndepFun` obtains it in §11b, here over `ℕ` rather than `Option ℕ`,
because the weight row is a constant and carries no randomness to separate. -/
theorem exists_rotationStream :
    ∃ (Ω : Type) (_ : MeasurableSpace Ω) (μ : Measure Ω) (R : Ω → ℕ → Sign),
      IsProbabilityMeasure μ ∧
        RotationStream rot half (fun _ => (1 : ℝ)) R unif (1 : ℝ) μ := by
  obtain ⟨Ω, mΩ, P, X, hmeas, hlaw, hindep, hprob⟩ := ProbabilityTheory.exists_iid ℕ unif
  refine ⟨Ω, mΩ, P, fun ω p => X p ω, hprob, ?_⟩
  refine
    { implements := rot_implements
      meas_q := measurable_half
      meas_W := measurable_const
      meas_R := hmeas
      law_R := fun p => (hlaw p).map_eq
      fresh := ?_
      exact_never := fun p =>
        Filter.Eventually.of_forall fun ω => resid_witness_ne_zero _ one_ne_zero p
      transitive := transitive_on_sphere }
  intro p
  have hdisj : Disjoint ({p} : Finset ℕ) (Finset.range p) := by
    simp [Finset.disjoint_singleton_left]
  have key := hindep.indepFun_finset ({p} : Finset ℕ) (Finset.range p) hdisj hmeas
  have hmemp : p ∈ ({p} : Finset ℕ) := Finset.mem_singleton_self p
  have hmemi : ∀ i : Fin p, (i : ℕ) ∈ Finset.range p := fun i => Finset.mem_range.mpr i.isLt
  have hφ : Measurable (fun v : (({p} : Finset ℕ) → Sign) => v ⟨p, hmemp⟩) :=
    measurable_pi_apply _
  have hψ : Measurable (fun v : (↥(Finset.range p) → Sign) =>
      ((1 : ℝ), fun i : Fin p => v ⟨(i : ℕ), hmemi i⟩)) :=
    measurable_const.prodMk (measurable_pi_lambda _ fun _ => measurable_pi_apply _)
  exact key.comp hφ hψ

/-- **The witness, with its decay constant.**  For this scheme §11's general theorem returns
`err(P) = (1/2)^P`, not assumed, but computed from the codebook by `witness_stageDistortion`
and pushed through `rms_relative_error_rotationStream`.  The existence of this object is what
makes §11 a theorem about something. -/
theorem exists_witness_decay :
    ∃ (Ω : Type) (_ : MeasurableSpace Ω) (μ : Measure Ω) (R : Ω → ℕ → Sign),
      IsProbabilityMeasure μ ∧
        RotationStream rot half (fun _ => (1 : ℝ)) R unif (1 : ℝ) μ ∧
          ∀ P : ℕ,
            Real.sqrt (∫ ω, ‖resid (rotScheme rot half (R ω)) (1 : ℝ) P‖ ^ 2 ∂μ) / ‖(1 : ℝ)‖
              = (1 / 2 : ℝ) ^ P := by
  obtain ⟨Ω, mΩ, μ, R, hprob, hstream⟩ := exists_rotationStream
  refine ⟨Ω, mΩ, μ, R, hprob, hstream, fun P => ?_⟩
  rw [rms_relative_error_rotationStream one_ne_zero hstream witness_integrable P, witness_rho]

end Witness
/-! ## §13  Concentration: what a per-pass variance bound actually buys

Proposition 2 (§3) is an identity in *expectation*.  The paper's Remark ("Concentration")
claims more: that `err(P) = ρ^P` holds "essentially deterministically", on the grounds that the
per-pass ratio `‖r_{p+1}‖²/‖r_p‖²` has mean `ρ²` and variance `O(1/d)`.

That variance estimate is not formalised here; §25 later derives it, with an explicit constant
and for every nearest-codeword stage, from the Poincaré inequality on the sphere taken as a
hypothesis, and item 5 of the header records what remains.  What is formalised here is the half the prose
leaves implicit: the passage from a *per-pass* deviation bound to a *`P`-pass* one.

That passage is not free, and writing it down is the point of this section.  The per-pass ratios
multiply, so relative deviations compound as `(1 ± ε)^P`; the failure events union, so the
confidence degrades as `Pδ`.  Both prices are invisible in the statement `err(P) = ρ^P`, and
both are what "essentially deterministically" has to mean if it is to mean anything. -/

section Concentration

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The pass-`p` squared normalised stage error `‖u_p − q(u_p)‖²`.  This is the paper's per-pass
ratio `‖r_{p+1}‖²/‖r_p‖²`, defined without the division so that it is total: by
`norm_resid_succ_sq` the two agree whenever `r_p ≠ 0`, and at `r_p = 0` the ratio is undefined
while this is not. -/
noncomputable def stageErrSq (S : Scheme E) (w : E) (p : ℕ) : ℝ :=
  ‖unitVec S w p - S.q (unitVec S w p)‖ ^ 2

theorem stageErrSq_nonneg (S : Scheme E) (w : E) (p : ℕ) : 0 ≤ stageErrSq S w p := sq_nonneg _

/-- **The product form of the recursion.**  `‖r_P‖² = ‖w‖² · ∏_{p<P} ‖u_p − q(u_p)‖²`.

Deterministic and hypothesis-free: this is `norm_resid_succ_sq` iterated, and it is the reason
concentration of the decay law is a statement about a *product* rather than a sum. -/
theorem norm_resid_sq_eq_prod (S : Scheme E) (w : E) (P : ℕ) :
    ‖resid S w P‖ ^ 2 = ‖w‖ ^ 2 * ∏ p ∈ range P, stageErrSq S w p := by
  induction P with
  | zero => simp
  | succ P ih =>
      rw [norm_resid_succ_sq, ih, Finset.prod_range_succ]
      simp only [stageErrSq]
      ring

/-- `DecayWithin S w ρ ε P`: the `P`-pass squared error lies inside the band the decay law
predicts, widened by the compounded relative factor `(1 ± ε)^P`. -/
def DecayWithin (S : Scheme E) (w : E) (ρ ε : ℝ) (P : ℕ) : Prop :=
  (1 - ε) ^ P * ρ ^ (2 * P) * ‖w‖ ^ 2 ≤ ‖resid S w P‖ ^ 2 ∧
    ‖resid S w P‖ ^ 2 ≤ (1 + ε) ^ P * ρ ^ (2 * P) * ‖w‖ ^ 2

/-- **The deterministic sandwich.**  If each of the first `P` passes has its ratio within a
relative `ε` of `ρ²`, then the `P`-pass squared error is within a relative `(1 ± ε)^P` of
`ρ^{2P}‖w‖²`.

No probability is used: this is the pure compounding step.  The exponent `P` on `(1 ± ε)` is not
an artefact of the proof, the ratios genuinely multiply, which is why a per-pass bound that
looks tight can still be loose after several passes. -/
theorem decayWithin_of_forall {S : Scheme E} {w : E} {ρ ε : ℝ} {P : ℕ}
    (hε1 : ε ≤ 1)
    (h : ∀ p ∈ range P, |stageErrSq S w p - ρ ^ 2| ≤ ε * ρ ^ 2) :
    DecayWithin S w ρ ε P := by
  have hlow : ∀ p ∈ range P, (1 - ε) * ρ ^ 2 ≤ stageErrSq S w p := by
    intro p hp
    have h' := (abs_le.mp (h p hp)).1
    nlinarith [h']
  have hhigh : ∀ p ∈ range P, stageErrSq S w p ≤ (1 + ε) * ρ ^ 2 := by
    intro p hp
    have h' := (abs_le.mp (h p hp)).2
    nlinarith [h']
  have h0 : (0 : ℝ) ≤ (1 - ε) * ρ ^ 2 := mul_nonneg (by linarith) (sq_nonneg _)
  have hprod_low : ((1 - ε) * ρ ^ 2) ^ P ≤ ∏ p ∈ range P, stageErrSq S w p := by
    calc ((1 - ε) * ρ ^ 2) ^ P = ∏ _p ∈ range P, (1 - ε) * ρ ^ 2 := by
          rw [Finset.prod_const, Finset.card_range]
      _ ≤ ∏ p ∈ range P, stageErrSq S w p := Finset.prod_le_prod (fun _ _ => h0) hlow
  have hprod_high : ∏ p ∈ range P, stageErrSq S w p ≤ ((1 + ε) * ρ ^ 2) ^ P := by
    calc ∏ p ∈ range P, stageErrSq S w p ≤ ∏ _p ∈ range P, (1 + ε) * ρ ^ 2 :=
          Finset.prod_le_prod (fun p _ => stageErrSq_nonneg S w p) hhigh
      _ = ((1 + ε) * ρ ^ 2) ^ P := by rw [Finset.prod_const, Finset.card_range]
  have hexp : ∀ c : ℝ, (c * ρ ^ 2) ^ P = c ^ P * ρ ^ (2 * P) := by
    intro c; rw [mul_pow, pow_mul]
  constructor
  · rw [norm_resid_sq_eq_prod, ← hexp (1 - ε), mul_comm (‖w‖ ^ 2)]
    exact mul_le_mul_of_nonneg_right hprod_low (sq_nonneg _)
  · rw [norm_resid_sq_eq_prod, ← hexp (1 + ε), mul_comm (‖w‖ ^ 2)]
    exact mul_le_mul_of_nonneg_right hprod_high (sq_nonneg _)

variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}

/-- **The union bound over passes.**  If each of the first `P` passes misses its relative-`ε`
band with probability at most `δ`, then the `P`-pass decay law holds to relative `(1 ± ε)^P`
with probability at least `1 − Pδ`.

This is the precise content of "essentially deterministically": *both* prices are explicit, the
accuracy `(1 ± ε)^P` and the confidence `Pδ`.  Neither appears in `err(P) = ρ^P`. -/
theorem meas_not_decayWithin_le {S : Ω → Scheme E} {W : Ω → E} {ρ ε : ℝ} {δ : ℝ≥0∞} {P : ℕ}
    (hε1 : ε ≤ 1)
    (h : ∀ p < P, μ {ω | ¬ |stageErrSq (S ω) (W ω) p - ρ ^ 2| ≤ ε * ρ ^ 2} ≤ δ) :
    μ {ω | ¬ DecayWithin (S ω) (W ω) ρ ε P} ≤ P * δ := by
  have hsub : {ω | ¬ DecayWithin (S ω) (W ω) ρ ε P}
      ⊆ ⋃ p ∈ range P, {ω | ¬ |stageErrSq (S ω) (W ω) p - ρ ^ 2| ≤ ε * ρ ^ 2} := by
    intro ω hω
    rcases Classical.em (∀ p ∈ range P, |stageErrSq (S ω) (W ω) p - ρ ^ 2| ≤ ε * ρ ^ 2) with
      hall | hall
    · exact absurd (decayWithin_of_forall hε1 hall) hω
    · push Not at hall
      obtain ⟨p, hp, hbad⟩ := hall
      exact Set.mem_iUnion₂_of_mem hp (not_le.mpr hbad)
  calc μ {ω | ¬ DecayWithin (S ω) (W ω) ρ ε P}
      ≤ μ (⋃ p ∈ range P, {ω | ¬ |stageErrSq (S ω) (W ω) p - ρ ^ 2| ≤ ε * ρ ^ 2}) :=
        measure_mono hsub
    _ ≤ ∑ p ∈ range P, μ {ω | ¬ |stageErrSq (S ω) (W ω) p - ρ ^ 2| ≤ ε * ρ ^ 2} :=
        measure_biUnion_finset_le _ _
    _ ≤ ∑ _p ∈ range P, δ := Finset.sum_le_sum fun p hp => h p (mem_range.mp hp)
    _ = P * δ := by rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]

/-- **The Chebyshev instantiation.**  A per-pass variance bound `Var ≤ v` supplies
`δ = v/(ερ²)²` in `meas_not_decayWithin_le`.

The paper's Remark asserts `v = O(1/d)`; that assertion is a computation about the spherical
marginal and is *not* proved here.  What is proved is that such a bound suffices, and exactly
what it yields: substituting `v = C/d` gives failure probability at most `P·C/(d ε² ρ⁴)`, so the
pass count enters linearly and the tolerance quadratically. -/
theorem meas_not_decayWithin_le_of_variance [IsFiniteMeasure μ]
    {S : Ω → Scheme E} {W : Ω → E} {ρ ε v : ℝ} {P : ℕ}
    (hε0 : 0 < ε) (hε1 : ε ≤ 1) (hρ : ρ ≠ 0)
    (hmem : ∀ p < P, MemLp (fun ω => stageErrSq (S ω) (W ω) p) 2 μ)
    (hmean : ∀ p < P, ∫ ω, stageErrSq (S ω) (W ω) p ∂μ = ρ ^ 2)
    (hvar : ∀ p < P, variance (fun ω => stageErrSq (S ω) (W ω) p) μ ≤ v) :
    μ {ω | ¬ DecayWithin (S ω) (W ω) ρ ε P} ≤ P * ENNReal.ofReal (v / (ε * ρ ^ 2) ^ 2) := by
  refine meas_not_decayWithin_le hε1 fun p hp => ?_
  have hρ2 : (0 : ℝ) < ρ ^ 2 := lt_of_le_of_ne (sq_nonneg ρ) (Ne.symm (pow_ne_zero 2 hρ))
  have hc : (0 : ℝ) < ε * ρ ^ 2 := mul_pos hε0 hρ2
  have hsub : {ω | ¬ |stageErrSq (S ω) (W ω) p - ρ ^ 2| ≤ ε * ρ ^ 2}
      ⊆ {ω | ε * ρ ^ 2 ≤
          |stageErrSq (S ω) (W ω) p - ∫ ω, stageErrSq (S ω) (W ω) p ∂μ|} := by
    intro ω hω
    simp only [Set.mem_setOf_eq] at hω ⊢
    rw [hmean p hp]
    exact le_of_lt (not_le.mp hω)
  calc μ {ω | ¬ |stageErrSq (S ω) (W ω) p - ρ ^ 2| ≤ ε * ρ ^ 2}
      ≤ μ {ω | ε * ρ ^ 2 ≤
          |stageErrSq (S ω) (W ω) p - ∫ ω, stageErrSq (S ω) (W ω) p ∂μ|} := measure_mono hsub
    _ ≤ ENNReal.ofReal (variance (fun ω => stageErrSq (S ω) (W ω) p) μ / (ε * ρ ^ 2) ^ 2) :=
        meas_ge_le_variance_div_sq (hmem p hp) hc
    _ ≤ ENNReal.ofReal (v / (ε * ρ ^ 2) ^ 2) := by
        gcongr
        exact hvar p hp

end Concentration
/-! ## §15  Per-layer allocation: why the frontier is a separable problem

The paper's calibrated allocation (`fig:frontier`) grants extra residual passes to
sensitive layers and reports a Pareto improvement over uniform allocation.  That
experiment presupposes something never stated: that the aggregate weight-space
error *decomposes* over layers, so choosing a pass count per layer is a knapsack
over independent terms rather than a joint optimisation.

This section states and proves the decomposition.  It is not deep -- linearity of
the integral over a finite family -- but it is the step that makes the allocation
search well-posed, and without it the frontier plot is a heuristic rather than an
optimisation over a known objective.

What this does **not** license, and the paper is careful about elsewhere: the
*choice* of `P` per layer.  `allocation_separable` says the objective is a sum of
per-layer terms `ρ^{2P_i}‖w_i‖²`; it says nothing about how one learns which
layers are sensitive.  The paper's answer there is a single calibration forward
pass, which is the one place the zero-data constraint is spent, and it is flagged
as such wherever it appears.  Note also that `‖w_i‖²` appears with weight: two
layers with equal sensitivity but different norms do not deserve equal passes,
which is visible here and is easy to miss when reading the frontier plot.

The hypothesis is one `IsotropicPasses` bundle per layer *at a shared `ρ`*.  That
is the honest form: `ρ` is a property of the stage quantiser and the direction
law, not of the layer, so layers sharing a codebook and a group size share `ρ`.
Layers with different fan-in `d` would have different `ρ` and want the
`ρ`-indexed variant below. -/

section Allocation

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}

/-- **The aggregate error decomposes over layers.**  For a finite family of
weight rows, each quantised by its own scheme for its own number of passes, the
expected total squared residual is the sum of the per-layer envelopes.

This is what makes `fig:frontier`'s allocation a separable problem: the objective
is `∑ᵢ ρ^{2Pᵢ}‖wᵢ‖²` and the constraint is `∑ᵢ Pᵢ·(b + 16/g)`, so the search is a
knapsack, not a joint optimisation over interacting layers. -/
theorem integral_sum_resid_sq [IsProbabilityMeasure μ] {ι : Type*} [Fintype ι]
    {S : ι → Ω → Scheme E} {W : ι → Ω → E} {ρ : ℝ} (P : ι → ℕ)
    (h : ∀ i, IsotropicPasses (S i) (W i) ρ μ) :
    ∫ ω, ∑ i, ‖resid (S i ω) (W i ω) (P i)‖ ^ 2 ∂μ
      = ∑ i, ρ ^ (2 * P i) * ∫ ω, ‖W i ω‖ ^ 2 ∂μ := by
  rw [integral_finset_sum _ (fun i _ => (h i).integrable (P i))]
  exact Finset.sum_congr rfl fun i _ => integral_norm_resid_sq (h i) (P i)

/-- The same with a per-layer decay constant, which is what differing fan-in
gives: `ρ` is a functional of the stage quantiser and the direction law, so
layers of different width do not share one. -/
theorem integral_sum_resid_sq_of_rho [IsProbabilityMeasure μ] {ι : Type*} [Fintype ι]
    {S : ι → Ω → Scheme E} {W : ι → Ω → E} {ρ : ι → ℝ} (P : ι → ℕ)
    (h : ∀ i, IsotropicPasses (S i) (W i) (ρ i) μ) :
    ∫ ω, ∑ i, ‖resid (S i ω) (W i ω) (P i)‖ ^ 2 ∂μ
      = ∑ i, ρ i ^ (2 * P i) * ∫ ω, ‖W i ω‖ ^ 2 ∂μ := by
  rw [integral_finset_sum _ (fun i _ => (h i).integrable (P i))]
  exact Finset.sum_congr rfl fun i _ => integral_norm_resid_sq (h i) (P i)

/-- **Adding a pass to any layer cannot increase the objective**, when `|ρ| ≤ 1`.

The monotonicity the allocation search relies on: the per-layer term is
non-increasing in that layer's pass count, so the knapsack has no incentive to
withhold budget from a layer, and a greedy pass-granting sweep is not fighting a
non-monotone objective.  `|ρ| ≤ 1` is the regime the paper measures
(`ρ = 0.342` at two bits); nothing here assumes it. -/
theorem term_le_of_succ {ρ : ℝ} (hρ : |ρ| ≤ 1) (c : ℝ) (hc : 0 ≤ c) (p : ℕ) :
    ρ ^ (2 * (p + 1)) * c ≤ ρ ^ (2 * p) * c := by
  have hsq : ρ ^ 2 ≤ 1 := by
    have := abs_le.mp hρ
    nlinarith [this.1, this.2]
  have hnn : (0 : ℝ) ≤ ρ ^ (2 * p) := by
    rw [pow_mul]; exact pow_nonneg (sq_nonneg ρ) p
  have hexp : ρ ^ (2 * (p + 1)) = ρ ^ (2 * p) * ρ ^ 2 := by
    rw [Nat.mul_succ, pow_add]
  rw [hexp]
  exact mul_le_mul_of_nonneg_right
    (by nlinarith [hnn, hsq]) hc

end Allocation

/-! ## §16  Corollary 1 for every codebook

Corollary 1 (§6) is stated for scalar codebooks applied coordinate-wise, and §9 records that its
optimality is optimality *within a class*.  This section removes the word *scalar*.  A *codebook*
is any set `C ⊆ E` of reproduction points, and a stage quantiser *implements* `C` if it always
returns a nearest codeword.  The scalar Lloyd–Max stage (`C` a product of `2^b`-point sets),
QuIP#'s E8P stage (`C` a finite subset of the `E₈` lattice, one copy per block of eight) and
QTIP's trellis stage (`C` the codeword set of the trellis code, which the Viterbi search rounds
to exactly) are all of this form; §17 checks the per-block case.

The objective is `codebookDistortion C σ = E_σ dist(u, C)²` against the direction law
`σ = orbitLaw κ x₀`, and §11's `law_unitVec_eq_orbitLaw` makes `σ` the same measure at every
pass.  So whichever codebook minimises it over a class is optimal at every pass, and no per-pass
re-fitting can improve on it in expectation (§18 states this at the residual level).  Nothing
here uses coordinates, block structure, or finiteness of `C`; finiteness enters only in
`exists_isNearest`, which supplies a nearest-codeword map for every finite codebook. -/

section Codebook

variable {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E]
variable {C C' : Set E} {Q Q' : E → E} {σ : Measure E}

/-- `Q` implements the codebook `C`: it takes values in `C` and always picks a nearest point. -/
def IsNearest (C : Set E) (Q : E → E) : Prop :=
  ∀ x, Q x ∈ C ∧ ∀ c ∈ C, ‖x - Q x‖ ≤ ‖x - c‖

/-- The distortion of a codebook against the direction law: the expected squared distance from
a direction to its nearest codeword.  This is `ρ²` as a functional of the codebook alone. -/
noncomputable def codebookDistortion (C : Set E) (σ : Measure E) : ℝ :=
  ∫ u, Metric.infDist u C ^ 2 ∂σ

omit [MeasurableSpace E] in
/-- A nearest-codeword quantiser attains the distance to the codebook. -/
theorem norm_sub_eq_infDist (hQ : IsNearest C Q) (x : E) :
    ‖x - Q x‖ = Metric.infDist x C := by
  refine le_antisymm ?_ ?_
  · refine not_lt.mp fun hlt => ?_
    obtain ⟨c, hc, hlt'⟩ := (Metric.infDist_lt_iff ⟨Q x, (hQ x).1⟩).1 hlt
    rw [dist_eq_norm] at hlt'
    exact absurd ((hQ x).2 c hc) (not_le.mpr hlt')
  · rw [← dist_eq_norm]
    exact Metric.infDist_le_dist_of_mem (hQ x).1

/-- Hence its stage distortion is the codebook distortion. -/
theorem stageDistortion_eq_codebookDistortion (hQ : IsNearest C Q) (σ : Measure E) :
    stageDistortion Q σ = codebookDistortion C σ := by
  unfold stageDistortion codebookDistortion
  simp_rw [norm_sub_eq_infDist hQ]

/-- Any quantiser with values in `C'` errs at least the distance to `C'`, in expectation. -/
theorem codebookDistortion_le_stageDistortion (hQ' : ∀ x, Q' x ∈ C')
    (hint : Integrable (fun u => ‖u - Q' u‖ ^ 2) σ) :
    codebookDistortion C' σ ≤ stageDistortion Q' σ :=
  integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => by positivity) hint
    (Filter.Eventually.of_forall fun x => by
      show Metric.infDist x C' ^ 2 ≤ ‖x - Q' x‖ ^ 2
      rw [← dist_eq_norm]
      exact pow_le_pow_left₀ Metric.infDist_nonneg (Metric.infDist_le_dist_of_mem (hQ' x)) 2)

/-- Nearest-codeword rounding is optimal among all maps into the same codebook. -/
theorem stageDistortion_le_of_isNearest (hQ : IsNearest C Q) (hQ' : ∀ x, Q' x ∈ C)
    (hint : Integrable (fun u => ‖u - Q' u‖ ^ 2) σ) :
    stageDistortion Q σ ≤ stageDistortion Q' σ := by
  rw [stageDistortion_eq_codebookDistortion hQ]
  exact codebookDistortion_le_stageDistortion hQ' hint

/-- **Corollary 1, for every codebook class.**  If `C` minimises the codebook distortion over a
class `𝒞` of codebooks, all `2^b`-level product codebooks, all E8P copies, all trellis codes of
a given rate, or all of them together, then a nearest-codeword stage for `C` has stage
distortion no larger than any stage with values in any member of `𝒞`.  By
`stage_rho_pow_le_of_le` (§9) its `P`-pass envelope is then no larger for every `P`. -/
theorem stageDistortion_le_of_codebook_optimal {𝒞 : Set (Set E)}
    (hmin : ∀ C'' ∈ 𝒞, codebookDistortion C σ ≤ codebookDistortion C'' σ)
    (hQ : IsNearest C Q) (hC' : C' ∈ 𝒞) (hQ' : ∀ x, Q' x ∈ C')
    (hint : Integrable (fun u => ‖u - Q' u‖ ^ 2) σ) :
    stageDistortion Q σ ≤ stageDistortion Q' σ := by
  rw [stageDistortion_eq_codebookDistortion hQ]
  exact (hmin C' hC').trans (codebookDistortion_le_stageDistortion hQ' hint)

omit [MeasurableSpace E] in
/-- Every finite nonempty codebook has a nearest-codeword quantiser. -/
theorem exists_isNearest (hC : C.Finite) (hne : C.Nonempty) : ∃ Q : E → E, IsNearest C Q := by
  choose Q hQ using fun x => Set.exists_min_image C (fun c => ‖x - c‖) hC hne
  exact ⟨Q, hQ⟩

end Codebook
/-! ## §17  Block stages: the vector quadrature for `ρ`

Proposition 2 (§3, §11) never used coordinates.  What *is* tied to the scalar stage is the
evaluation of `ρ²` as `d · E_{f_d}[(t − q t)²]` (§3b).  This section is the same computation for
a stage that quantises `m` blocks of a space `F` at once: `F = ℝ` is the scalar stage,
`F = EuclideanSpace ℝ (Fin 8)` the `E₈` stage, `F = EuclideanSpace ℝ (Fin T)` a trellis stage of
length `T`.  The answer has the same shape, `ρ² = m · E_ν‖x − q_B x‖²` with `ν` the common law of
one block, and `E_ν‖x‖² = 1/m` is again forced by `‖u‖ = 1`.  Only linearity of expectation is
used: the blocks need not be independent, only identically distributed, and §17b derives that
from invariance of the direction law whenever the rotation group contains the block swaps. -/

section Block

variable {m : ℕ} {F : Type*} [NormedAddCommGroup F] [MeasurableSpace F]

/-- `m` blocks of `F` with the Euclidean norm across blocks.  `BlockSpace m ℝ` is
`EuclideanSpace ℝ (Fin m)` definitionally. -/
abbrev BlockSpace (m : ℕ) (F : Type*) := PiLp 2 (fun _ : Fin m => F)

/-- The stage that applies one block quantiser `qB` to every block. -/
def blockStage (qB : F → F) (v : BlockSpace m F) : BlockSpace m F :=
  WithLp.toLp 2 fun j => qB (v j)

omit [NormedAddCommGroup F] in
theorem measurable_block (j : Fin m) : Measurable (fun v : BlockSpace m F => v j) :=
  (measurable_pi_apply j).comp (WithLp.measurable_ofLp 2 _)

omit [NormedAddCommGroup F] in
theorem measurable_blockStage {qB : F → F} (hq : Measurable qB) :
    Measurable (blockStage (m := m) qB) :=
  (WithLp.measurable_toLp 2 _).comp (measurable_pi_lambda _ fun j => hq.comp (measurable_block j))

/-- The scalar stages of §9 are the block stages at `F = ℝ`, definitionally. -/
theorem scalarStages_eq_blockStage (d : ℕ) (C : Set (ℝ → ℝ)) :
    scalarStages d C = {Q | ∃ cb ∈ C, Q = blockStage cb} := rfl

omit [MeasurableSpace F] in
/-- The squared stage error splits over blocks, exactly and pointwise. -/
theorem norm_sub_blockStage_sq (qB : F → F) (v : BlockSpace m F) :
    ‖v - blockStage qB v‖ ^ 2 = ∑ j, ‖v j - qB (v j)‖ ^ 2 := by
  rw [PiLp.norm_sq_eq_of_L2]; simp [blockStage]

omit [MeasurableSpace F] in
/-- Nearest-codeword per block is nearest-codeword for the product codebook.  So coordinate-wise
Lloyd–Max rounding implements the product of `2^b`-point sets and per-block E8P rounding
implements the product of E8P copies, in the sense of §16. -/
theorem isNearest_blockStage {qB : F → F} {CB : Set F} (h : IsNearest CB qB) :
    IsNearest {v : BlockSpace m F | ∀ j, v j ∈ CB} (blockStage qB) := by
  intro v
  refine ⟨fun j => by simpa [blockStage] using (h (v j)).1, fun c hc => ?_⟩
  rw [← pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero,
    norm_sub_blockStage_sq, PiLp.norm_sq_eq_of_L2]
  simp only [PiLp.sub_apply]
  exact Finset.sum_le_sum fun j _ => pow_le_pow_left₀ (norm_nonneg _) ((h (v j)).2 _ (hc j)) 2

variable {σ : Measure (BlockSpace m F)} {ν : Measure F}

private theorem aux_integrable_block (qB : F → F) (hmarg : ∀ j, σ.map (fun v => v j) = ν)
    (hint : Integrable (fun x => ‖x - qB x‖ ^ 2) ν) (j : Fin m) :
    Integrable (fun v : BlockSpace m F => ‖v j - qB (v j)‖ ^ 2) σ := by
  have hasm : AEStronglyMeasurable (fun x => ‖x - qB x‖ ^ 2) (σ.map (fun v => v j)) := by
    rw [hmarg j]; exact hint.aestronglyMeasurable
  exact (integrable_map_measure hasm (measurable_block j).aemeasurable).mp
    (by rw [hmarg j]; exact hint)

private theorem aux_integral_block (qB : F → F) (hmarg : ∀ j, σ.map (fun v => v j) = ν)
    (hint : Integrable (fun x => ‖x - qB x‖ ^ 2) ν) (j : Fin m) :
    ∫ v, ‖v j - qB (v j)‖ ^ 2 ∂σ = ∫ x, ‖x - qB x‖ ^ 2 ∂ν := by
  have hasm : AEStronglyMeasurable (fun x => ‖x - qB x‖ ^ 2) (σ.map (fun v => v j)) := by
    rw [hmarg j]; exact hint.aestronglyMeasurable
  rw [← hmarg j, integral_map (measurable_block j).aemeasurable hasm]

/-- Integrability of the stage error, from integrability of one block's error. -/
theorem integrable_blockStage_err (qB : F → F) (hmarg : ∀ j, σ.map (fun v => v j) = ν)
    (hint : Integrable (fun x => ‖x - qB x‖ ^ 2) ν) :
    Integrable (fun v : BlockSpace m F => ‖v - blockStage qB v‖ ^ 2) σ := by
  simp_rw [norm_sub_blockStage_sq]
  exact integrable_finsetSum _ fun j _ => aux_integrable_block qB hmarg hint j

/-- **The block quadrature.**  If every block of the direction has the same law `ν`, the stage
distortion of the block stage is `m · E_ν‖x − q_B x‖²`.  This is `integral_norm_sub_cb_sq` (§3b)
with the coordinate replaced by a block; no independence between blocks is used. -/
theorem stageDistortion_blockStage (qB : F → F) (hmarg : ∀ j, σ.map (fun v => v j) = ν)
    (hint : Integrable (fun x => ‖x - qB x‖ ^ 2) ν) :
    stageDistortion (blockStage qB) σ = m * ∫ x, ‖x - qB x‖ ^ 2 ∂ν := by
  unfold stageDistortion
  simp_rw [norm_sub_blockStage_sq]
  rw [integral_finsetSum _ (fun j _ => aux_integrable_block qB hmarg hint j)]
  simp_rw [aux_integral_block qB hmarg hint]
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]

/-- `E_ν‖x‖² = 1/m` is forced by `‖u‖ = 1` and identically distributed blocks, exactly as
`second_moment_eq_inv_card` (§3b) forces `E_{f_d}[t²] = 1/d`. -/
theorem integral_norm_sq_block [IsProbabilityMeasure σ] (hm : m ≠ 0)
    (hmarg : ∀ j, σ.map (fun v => v j) = ν) (hint : Integrable (fun x : F => ‖x‖ ^ 2) ν)
    (hunit : ∀ᵐ v ∂σ, ‖v‖ = 1) :
    ∫ x, ‖x‖ ^ 2 ∂ν = 1 / (m : ℝ) := by
  have hm' : (m : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hm
  have hint' : Integrable (fun x : F => ‖x - (fun _ => 0) x‖ ^ 2) ν := by simpa using hint
  have h1 : ∫ v, ∑ j, ‖v j‖ ^ 2 ∂σ = 1 := by
    have hone : ∀ᵐ v ∂σ, ∑ j, ‖v j‖ ^ 2 = 1 := by
      filter_upwards [hunit] with v hv
      rw [← PiLp.norm_sq_eq_of_L2, hv, one_pow]
    rw [integral_congr_ae hone]; simp
  have hmapint := fun j => by simpa using aux_integrable_block (σ := σ) (fun _ => 0) hmarg hint' j
  have hblock := fun j => by simpa using aux_integral_block (σ := σ) (fun _ => 0) hmarg hint' j
  rw [integral_finsetSum _ (fun j _ => hmapint j)] at h1
  simp_rw [hblock] at h1
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at h1
  field_simp
  linarith [h1]

/-- **Eq. (2.3) for a block stage**: `ρ² = E_ν‖x − q_B x‖² / E_ν‖x‖²`, the normalised block
distortion, with no reference to `m` or `d`. -/
theorem stageDistortion_blockStage_eq_ratio [IsProbabilityMeasure σ] (hm : m ≠ 0) (qB : F → F)
    (hmarg : ∀ j, σ.map (fun v => v j) = ν)
    (hint : Integrable (fun x => ‖x - qB x‖ ^ 2) ν) (hint₂ : Integrable (fun x : F => ‖x‖ ^ 2) ν)
    (hunit : ∀ᵐ v ∂σ, ‖v‖ = 1) :
    stageDistortion (blockStage qB) σ = (∫ x, ‖x - qB x‖ ^ 2 ∂ν) / ∫ x, ‖x‖ ^ 2 ∂ν := by
  rw [stageDistortion_blockStage qB hmarg hint, integral_norm_sq_block hm hmarg hint₂ hunit]
  have hm' : (m : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hm
  field_simp

/-- At `F = ℝ` the block quadrature is §3b's `rhoSq`: the scalar quadrature is the block
quadrature with one-dimensional blocks. -/
theorem stageDistortion_blockStage_real {σ : Measure (EuclideanSpace ℝ (Fin m))} {ν : Measure ℝ}
    (cb : ℝ → ℝ) (hmarg : ∀ j, σ.map (fun v => v j) = ν)
    (hint : Integrable (fun t => (t - cb t) ^ 2) ν) :
    stageDistortion (blockStage cb) σ = rhoSq m cb ν := by
  have hint' : Integrable (fun t : ℝ => ‖t - cb t‖ ^ 2) ν := by
    simpa [Real.norm_eq_abs, sq_abs] using hint
  rw [stageDistortion_blockStage cb hmarg hint', rhoSq]
  simp [Real.norm_eq_abs, sq_abs]

end Block

/-! ### §17b  Identically distributed blocks, from invariance of the direction law

`stageDistortion_blockStage` assumes every block has the same law.  For the paper's uniform law
that is permutation invariance; here it is derived from the rotation stream alone: the orbit law
is invariant under the group when `κ` is left-invariant (Haar on a compact group is), so if the
group contains an element that moves block `j'` to block `j`, the two block marginals agree. -/

section BlockExchange

variable {G : Type*} [Group G] [MeasurableSpace G] [MeasurableMul G]
variable {X : Type*} [MeasurableSpace X] [MulAction G X] [MeasurableSMul G X]

/-- Under a left-invariant `κ` the orbit law is `G`-invariant. -/
theorem orbitLaw_map_smul (κ : Measure G) [κ.IsMulLeftInvariant] (h : G) (x₀ : X) :
    (orbitLaw κ x₀).map (fun v => h • v) = orbitLaw κ x₀ := by
  unfold orbitLaw
  rw [Measure.map_map (measurable_const_smul h) (measurable_smul_const x₀)]
  have hcomp : (fun v : X => h • v) ∘ (fun g : G => g • x₀)
      = (fun g : G => g • x₀) ∘ (fun g : G => h * g) := by
    funext g; simp [mul_smul]
  rw [hcomp, ← Measure.map_map (measurable_smul_const x₀) (measurable_const_mul h),
    map_mul_left_eq_self]

variable {m : ℕ} {F : Type*} [NormedAddCommGroup F] [MeasurableSpace F]
  [MulAction G (BlockSpace m F)] [MeasurableSMul G (BlockSpace m F)]

omit [NormedAddCommGroup F] in
/-- If some rotation carries block `j'` to block `j`, the two block marginals of the direction
law coincide.  With all block swaps available (they are in `O(d)`), every block has the same
law, which is the `hmarg` hypothesis of `stageDistortion_blockStage`. -/
theorem blockMarginal_eq_of_swap (κ : Measure G) [κ.IsMulLeftInvariant] (x₀ : BlockSpace m F)
    {j j' : Fin m} {h : G} (hswap : ∀ v : BlockSpace m F, (h • v) j = v j') :
    (orbitLaw κ x₀).map (fun v => v j) = (orbitLaw κ x₀).map (fun v => v j') := by
  conv_lhs => rw [← orbitLaw_map_smul κ h x₀]
  rw [Measure.map_map (measurable_block j) (measurable_const_smul h)]
  congr 1
  funext v
  exact hswap v

end BlockExchange
/-! ## §18  Every pass, for every stage

§16 and §17 compare stage distortions.  This section pushes the comparison through §11 to the
quantity the paper measures, the expected squared residual after `P` passes, for any two stages
run through the same rotation stream from the same weight rows.  Nothing is assumed about the
stages beyond what `RotationStream` already asks of them (measurable, never exact), so the
statements cover scalar, `E₈` and trellis stages alike; `integral_norm_resid_sq_blockStage` is
Proposition 2 for a block stage with `ρ²` supplied by §17's block quadrature. -/

section EveryPass

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
variable {G : Type*} [Group G] [MeasurableSpace G] [MulAction G E] [MeasurableSMul₂ G E]
  [MeasurableInv G] [MeasurableMul G]
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
variable {ι : G → (E ≃ₗᵢ[ℝ] E)} {W : Ω → E} {R : Ω → ℕ → G} {κ : Measure G}
  [κ.IsMulRightInvariant] {x₀ : E}

omit [BorelSpace E] [SecondCountableTopology E] [MeasurableInv G] [MeasurableMul G]
  [IsProbabilityMeasure μ] [κ.IsMulRightInvariant] in
/-- The direction law lives on the unit sphere: `G` acts by isometries and `‖x₀‖ = 1`. -/
theorem norm_eq_one_ae_orbitLaw [OpensMeasurableSpace E]
    (hι : ∀ (g : G) (x : E), ι g x = g • x) (hx₀ : ‖x₀‖ = 1) :
    ∀ᵐ v ∂(orbitLaw κ x₀), ‖v‖ = 1 := by
  unfold orbitLaw
  refine (ae_map_iff (measurable_smul_const x₀).aemeasurable (p := fun v : E => ‖v‖ = 1)
    (measurable_norm (measurableSet_singleton (1 : ℝ)))).2 ?_
  exact Filter.Eventually.of_forall fun g => by rw [← hι, LinearIsometryEquiv.norm_map, hx₀]

/-- **Corollary 1 at the residual level, for every stage.**  Of two stages driven by the same
rotation stream from the same weight rows, the one with the smaller stage distortion has the
smaller expected squared residual after every number of passes. -/
theorem integral_norm_resid_sq_le_of_stageDistortion_le {q q' : E → E}
    (h : RotationStream ι q W R κ x₀ μ) (h' : RotationStream ι q' W R κ x₀ μ)
    (hW : Integrable (fun ω => ‖W ω‖ ^ 2) μ)
    (hint : Integrable (fun u : E => ‖u - q u‖ ^ 2) (orbitLaw κ x₀))
    (hint' : Integrable (fun u : E => ‖u - q' u‖ ^ 2) (orbitLaw κ x₀))
    (hle : stageDistortion q (orbitLaw κ x₀) ≤ stageDistortion q' (orbitLaw κ x₀)) (P : ℕ) :
    ∫ ω, ‖resid (rotScheme ι q (R ω)) (W ω) P‖ ^ 2 ∂μ
      ≤ ∫ ω, ‖resid (rotScheme ι q' (R ω)) (W ω) P‖ ^ 2 ∂μ := by
  rw [integral_norm_resid_sq_rotationStream h hW hint P,
    integral_norm_resid_sq_rotationStream h' hW hint' P]
  exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (stageDistortion_nonneg _ _) hle P)
    (integral_nonneg fun _ => by positivity)

/-- **Corollary 1 for every codebook, at the residual level.**  A nearest-codeword stage for the
codebook that minimises `codebookDistortion` over a class beats every stage with values in any
member of that class, at every pass count.  The paper's Corollary 1 is the case where the class
is the `2^b`-level product codebooks; the E8P and trellis classes are the same theorem. -/
theorem integral_norm_resid_sq_le_of_codebook_optimal {𝒞 : Set (Set E)} {C C' : Set E}
    {q q' : E → E}
    (hmin : ∀ C'' ∈ 𝒞, codebookDistortion C (orbitLaw κ x₀) ≤ codebookDistortion C'' (orbitLaw κ x₀))
    (hQ : IsNearest C q) (hC' : C' ∈ 𝒞) (hQ' : ∀ x, q' x ∈ C')
    (h : RotationStream ι q W R κ x₀ μ) (h' : RotationStream ι q' W R κ x₀ μ)
    (hW : Integrable (fun ω => ‖W ω‖ ^ 2) μ)
    (hint : Integrable (fun u : E => ‖u - q u‖ ^ 2) (orbitLaw κ x₀))
    (hint' : Integrable (fun u : E => ‖u - q' u‖ ^ 2) (orbitLaw κ x₀)) (P : ℕ) :
    ∫ ω, ‖resid (rotScheme ι q (R ω)) (W ω) P‖ ^ 2 ∂μ
      ≤ ∫ ω, ‖resid (rotScheme ι q' (R ω)) (W ω) P‖ ^ 2 ∂μ :=
  integral_norm_resid_sq_le_of_stageDistortion_le h h' hW hint hint'
    (stageDistortion_le_of_codebook_optimal hmin hQ hC' hQ' hint') P

end EveryPass

section BlockEveryPass

variable {m : ℕ} {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F]
  [MeasurableSpace F] [BorelSpace F] [SecondCountableTopology F]
variable {G : Type*} [Group G] [MeasurableSpace G] [MulAction G (BlockSpace m F)]
  [MeasurableSMul₂ G (BlockSpace m F)] [MeasurableInv G] [MeasurableMul G]
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
variable {ι : G → (BlockSpace m F ≃ₗᵢ[ℝ] BlockSpace m F)} {W : Ω → BlockSpace m F}
  {R : Ω → ℕ → G} {κ : Measure G} [κ.IsMulRightInvariant] {x₀ : BlockSpace m F}

/-- **Proposition 2 for a block stage**, with `ρ²` evaluated by the block quadrature: for an
`E₈` stage `m = d/8` and `ν` is the law of eight coordinates of the direction, for a trellis
stage of length `T` it is `m = d/T`, and for the scalar stage `m = d` and `ν = f_d`. -/
theorem integral_norm_resid_sq_blockStage {qB : F → F} {ν : Measure F}
    (h : RotationStream ι (blockStage qB) W R κ x₀ μ)
    (hW : Integrable (fun ω => ‖W ω‖ ^ 2) μ)
    (hmarg : ∀ j, (orbitLaw κ x₀).map (fun v => v j) = ν)
    (hint : Integrable (fun x => ‖x - qB x‖ ^ 2) ν) (P : ℕ) :
    ∫ ω, ‖resid (rotScheme ι (blockStage qB) (R ω)) (W ω) P‖ ^ 2 ∂μ
      = (m * ∫ x, ‖x - qB x‖ ^ 2 ∂ν) ^ P * ∫ ω, ‖W ω‖ ^ 2 ∂μ := by
  rw [integral_norm_resid_sq_rotationStream h hW (integrable_blockStage_err qB hmarg hint) P,
    stageDistortion_blockStage qB hmarg hint]

/-- The same with `ρ²` in the normalised form of eq. (2.3), `E_ν‖x − q_B x‖² / E_ν‖x‖²`; the
sphere constraint `‖u‖ = 1` is now derived from the stream rather than assumed. -/
theorem integral_norm_resid_sq_blockStage_ratio {qB : F → F} {ν : Measure F} (hm : m ≠ 0)
    (h : RotationStream ι (blockStage qB) W R κ x₀ μ) (hx₀ : ‖x₀‖ = 1)
    (hW : Integrable (fun ω => ‖W ω‖ ^ 2) μ)
    (hmarg : ∀ j, (orbitLaw κ x₀).map (fun v => v j) = ν)
    (hint : Integrable (fun x => ‖x - qB x‖ ^ 2) ν) (hint₂ : Integrable (fun x : F => ‖x‖ ^ 2) ν)
    (P : ℕ) :
    ∫ ω, ‖resid (rotScheme ι (blockStage qB) (R ω)) (W ω) P‖ ^ 2 ∂μ
      = ((∫ x, ‖x - qB x‖ ^ 2 ∂ν) / ∫ x, ‖x‖ ^ 2 ∂ν) ^ P * ∫ ω, ‖W ω‖ ^ 2 ∂μ := by
  haveI : IsProbabilityMeasure κ := by
    rw [← h.law_R 0]; exact Measure.isProbabilityMeasure_map (h.meas_R 0).aemeasurable
  haveI : IsProbabilityMeasure (orbitLaw κ x₀) :=
    Measure.isProbabilityMeasure_map (measurable_smul_const x₀).aemeasurable
  rw [integral_norm_resid_sq_rotationStream h hW (integrable_blockStage_err qB hmarg hint) P,
    stageDistortion_blockStage_eq_ratio hm qB hmarg hint hint₂
      (norm_eq_one_ae_orbitLaw h.implements hx₀)]

end BlockEveryPass
/-! ## §19  The uniform measure on the sphere, and its polar decomposition

Header item 1 records that Lemma 1's content, that a coordinate of a uniform point on `S^{d−1}`
has density `f_d`, was absent because "Mathlib has no usable handle on the uniform measure on a
sphere".  It does: `MeasureTheory.Measure.toSphere` is the surface measure obtained from
Lebesgue measure by the cone construction, and `measurePreserving_homeomorphUnitSphereProd` is
the polar decomposition `volume ≅ toSphere ⊗ r^{d−1} dr` on `E ∖ {0}`.  §19 to §21 use it to
prove Lemma 1, in the block form the vector stages of §17 need.

This section has the tools: the polar formula for a Lebesgue integral in `lintegral` form
(`lintegral_eq_polar`), the radial constant `∫₀¹ rⁿ dr`, and the two-dimensional polar change
of variables on a quadrant, which is where the two radii of a block decomposition `E = U × V`
meet.  Everything is done in `ℝ≥0∞`, so no integrability side condition ever arises. -/

open Measure Set Metric

section Polar
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

/-- Polar decomposition of a Lebesgue integral on a finite-dimensional inner product space. -/
theorem lintegral_eq_polar (F : E → ℝ≥0∞) (hF : Measurable F) :
    ∫⁻ x, F x = ∫⁻ u : sphere (0 : E) 1, (∫⁻ r in Set.Ioi (0 : ℝ),
      ENNReal.ofReal (r ^ (Module.finrank ℝ E - 1)) * F (r • (u : E))) ∂volume.toSphere := by
  have h1 : ∫⁻ x, F x = ∫⁻ x in ({0}ᶜ : Set E), F x := by rw [restrict_compl_singleton]
  have h2 : ∫⁻ x in ({0}ᶜ : Set E), F x
      = ∫⁻ x : ({0}ᶜ : Set E), F x ∂(volume.comap Subtype.val) := by
    rw [← setLIntegral_univ (μ := volume.comap Subtype.val),
      setLIntegral_subtype (measurableSet_singleton _).compl Set.univ F, Set.image_univ, Subtype.range_coe]
  have h3 := (measurePreserving_homeomorphUnitSphereProd (volume : Measure E)).lintegral_comp_emb
    (Homeomorph.measurableEmbedding _)
    (fun p : sphere (0 : E) 1 × Set.Ioi (0 : ℝ) => F ((p.2 : ℝ) • (p.1 : E)))
  have h4 : ∀ a : ({0}ᶜ : Set E),
      F (((homeomorphUnitSphereProd E a).2 : ℝ) • ((homeomorphUnitSphereProd E a).1 : E)) = F a := by
    intro a
    rw [homeomorphUnitSphereProd_apply_snd_coe, homeomorphUnitSphereProd_apply_fst_coe, smul_smul,
      mul_inv_cancel₀ (norm_ne_zero_iff.mpr (Set.mem_compl_singleton_iff.mp a.2)), one_smul]
  simp only [h4] at h3
  have hmeas : Measurable (fun p : sphere (0 : E) 1 × Set.Ioi (0 : ℝ) => F ((p.2 : ℝ) • (p.1 : E))) := by
    fun_prop
  rw [h1, h2, h3, lintegral_prod _ hmeas.aemeasurable]
  refine lintegral_congr fun u => ?_
  rw [volumeIoiPow, lintegral_withDensity_eq_lintegral_mul _ (by fun_prop) (by fun_prop)]
  have hpt : ((fun r : Set.Ioi (0 : ℝ) => ENNReal.ofReal ((r : ℝ) ^ (Module.finrank ℝ E - 1)))
      * fun y : Set.Ioi (0 : ℝ) => F (((u, y).2 : ℝ) • ((u, y).1 : E)))
      = fun r : Set.Ioi (0 : ℝ) =>
        (fun t : ℝ => ENNReal.ofReal (t ^ (Module.finrank ℝ E - 1)) * F (t • (u : E))) r := by
    funext r; rfl
  rw [hpt, ← setLIntegral_univ (μ := volume.comap Subtype.val),
    setLIntegral_subtype measurableSet_Ioi Set.univ
      (fun t : ℝ => ENNReal.ofReal (t ^ (Module.finrank ℝ E - 1)) * F (t • (u : E))),
    Set.image_univ, Subtype.range_coe]

end Polar

section Radial

/-- `∫₀¹ rⁿ dr`, in the form the polar formula produces it. -/
noncomputable def radialConst (n : ℕ) : ℝ≥0∞ :=
  ∫⁻ r in Set.Ioi (0 : ℝ), ENNReal.ofReal (r ^ n) * (Set.Iio (1 : ℝ)).indicator 1 r

theorem radialConst_eq (n : ℕ) : radialConst n = ENNReal.ofReal (1 / (n + 1)) := by
  have h1 : radialConst n = ∫⁻ r in Set.Ioo (0 : ℝ) 1, ENNReal.ofReal (r ^ n) := by
    unfold radialConst
    rw [setLIntegral_congr_fun measurableSet_Ioi (g := (Set.Iio (1 : ℝ)).indicator
        fun r => ENNReal.ofReal (r ^ n)) (fun r _ => by
          by_cases h : r < 1 <;> simp [Set.indicator, h]),
      lintegral_indicator measurableSet_Iio, Measure.restrict_restrict measurableSet_Iio,
      Set.inter_comm, Set.Ioi_inter_Iio]
  have h2 : ∫⁻ r in Set.Ioo (0 : ℝ) 1, ENNReal.ofReal (r ^ n) = ENNReal.ofReal (1 / (n + 1)) := by
    rw [← ofReal_integral_eq_lintegral_ofReal]
    · rw [← integral_Ioc_eq_integral_Ioo, ← intervalIntegral.integral_of_le zero_le_one,
        integral_pow]
      simp
    · exact (intervalIntegral.intervalIntegrable_pow n).1.mono_set Ioo_subset_Ioc_self
    · exact (ae_restrict_mem measurableSet_Ioo).mono fun r hr => pow_nonneg hr.1.le n
  rw [h1, h2]

end Radial

section Polar2D

/-- The angular weight `cos^a θ · sin^b θ`. -/
noncomputable def angWeight (a b : ℕ) (θ : ℝ) : ℝ≥0∞ :=
  ENNReal.ofReal (Real.cos θ ^ a * Real.sin θ ^ b)

theorem measurable_angWeight (a b : ℕ) : Measurable (angWeight a b) := by
  unfold angWeight; fun_prop

/-- The quadrant integrand: `ρ^a s^b · g(ρ/√(ρ²+s²)) · 1[ρ²+s²<1]`. -/
noncomputable def quadFun (a b : ℕ) (g : ℝ → ℝ≥0∞) (p : ℝ × ℝ) : ℝ≥0∞ :=
  ENNReal.ofReal (p.1 ^ a) * (ENNReal.ofReal (p.2 ^ b) *
    (g ((√(p.1 ^ 2 + p.2 ^ 2))⁻¹ * p.1) * (Set.Iio (1 : ℝ)).indicator 1 (p.1 ^ 2 + p.2 ^ 2)))

theorem measurable_quadFun (a b : ℕ) {g : ℝ → ℝ≥0∞} (hg : Measurable g) :
    Measurable (quadFun a b g) := by
  unfold quadFun
  exact (by fun_prop : Measurable fun p : ℝ × ℝ => ENNReal.ofReal (p.1 ^ a)).mul
    ((by fun_prop : Measurable fun p : ℝ × ℝ => ENNReal.ofReal (p.2 ^ b)).mul
      ((hg.comp (by fun_prop)).mul
        ((measurable_const.indicator measurableSet_Iio).comp (by fun_prop))))

/-- The radial factor after the change of variables. -/
noncomputable def radFun (n : ℕ) (R : ℝ) : ℝ≥0∞ :=
  ENNReal.ofReal (R ^ n) * (Set.Iio (1 : ℝ)).indicator 1 R

theorem measurable_radFun (n : ℕ) : Measurable (radFun n) :=
  (by fun_prop : Measurable fun R : ℝ => ENNReal.ofReal (R ^ n)).mul
    (measurable_const.indicator measurableSet_Iio)

/-- The angular factor, cut off to the first quadrant. -/
noncomputable def angFun (a b : ℕ) (g : ℝ → ℝ≥0∞) (θ : ℝ) : ℝ≥0∞ :=
  (Set.Ioo 0 (Real.pi / 2)).indicator (fun θ => angWeight a b θ * g (Real.cos θ)) θ

theorem measurable_angFun (a b : ℕ) {g : ℝ → ℝ≥0∞} (hg : Measurable g) :
    Measurable (angFun a b g) :=
  ((measurable_angWeight a b).mul (hg.comp Real.measurable_cos)).indicator measurableSet_Ioo

/-- **Pointwise polar identity in the first quadrant.** -/
theorem quadFun_polar (a b : ℕ) (g : ℝ → ℝ≥0∞) {R θ : ℝ} (hR : 0 < R)
    (hθ : θ ∈ Set.Ioo (-Real.pi) Real.pi) :
    ENNReal.ofReal R * (Set.Ioi (0 : ℝ) ×ˢ Set.Ioi (0 : ℝ)).indicator (quadFun a b g)
        (R * Real.cos θ, R * Real.sin θ)
      = radFun (a + b + 1) R * angFun a b g θ := by
  by_cases hq : θ ∈ Set.Ioo 0 (Real.pi / 2)
  · have hcos : 0 < Real.cos θ := Real.cos_pos_of_mem_Ioo ⟨by linarith [hq.1, Real.pi_pos], hq.2⟩
    have hsin : 0 < Real.sin θ :=
      Real.sin_pos_of_pos_of_lt_pi hq.1 (by linarith [hq.2, Real.pi_pos])
    have hmem : (R * Real.cos θ, R * Real.sin θ) ∈ Set.Ioi (0 : ℝ) ×ˢ Set.Ioi (0 : ℝ) :=
      ⟨mul_pos hR hcos, mul_pos hR hsin⟩
    rw [Set.indicator_of_mem hmem, angFun, Set.indicator_of_mem hq, quadFun, radFun, angWeight]
    simp only
    have hsq : (R * Real.cos θ) ^ 2 + (R * Real.sin θ) ^ 2 = R ^ 2 := by
      have := Real.cos_sq_add_sin_sq θ
      nlinarith [this]
    have hsqrt : √((R * Real.cos θ) ^ 2 + (R * Real.sin θ) ^ 2) = R := by
      rw [hsq, Real.sqrt_sq hR.le]
    have hind : (Set.Iio (1 : ℝ)).indicator (1 : ℝ → ℝ≥0∞) ((R * Real.cos θ) ^ 2 + (R * Real.sin θ) ^ 2)
        = (Set.Iio (1 : ℝ)).indicator (1 : ℝ → ℝ≥0∞) R := by
      rw [hsq]
      by_cases h1 : R < 1
      · rw [Set.indicator_of_mem (Set.mem_Iio.mpr (by nlinarith)),
          Set.indicator_of_mem (Set.mem_Iio.mpr h1)]
        rfl
      · have h1' : 1 ≤ R := not_lt.mp h1
        rw [Set.indicator_of_notMem
            (fun h' => absurd (Set.mem_Iio.mp h') (not_lt.mpr (by nlinarith))),
          Set.indicator_of_notMem (fun h' => h1 (Set.mem_Iio.mp h'))]
    rw [hsqrt, hind, inv_mul_cancel_left₀ hR.ne', mul_pow, mul_pow,
      ENNReal.ofReal_mul (pow_nonneg hR.le _), ENNReal.ofReal_mul (pow_nonneg hR.le _),
      ENNReal.ofReal_mul (pow_nonneg hcos.le _), pow_succ, pow_add,
      ENNReal.ofReal_mul (mul_nonneg (pow_nonneg hR.le _) (pow_nonneg hR.le _)),
      ENNReal.ofReal_mul (pow_nonneg hR.le _)]
    ring
  · have hnot : (R * Real.cos θ, R * Real.sin θ) ∉ Set.Ioi (0 : ℝ) ×ˢ Set.Ioi (0 : ℝ) := by
      rintro ⟨h1, h2⟩
      simp only [Set.mem_Ioi] at h1 h2
      have hcos : 0 < Real.cos θ := pos_of_mul_pos_right h1 hR.le
      have hsin : 0 < Real.sin θ := pos_of_mul_pos_right h2 hR.le
      apply hq
      constructor
      · by_contra h
        exact absurd hsin (not_lt.mpr
          (Real.sin_nonpos_of_nonpos_of_neg_pi_le (not_lt.mp h) hθ.1.le))
      · by_contra h
        exact absurd hcos (not_lt.mpr
          (Real.cos_nonpos_of_pi_div_two_le_of_le (not_lt.mp h) (by linarith [hθ.2, Real.pi_pos])))
    rw [Set.indicator_of_notMem hnot, angFun, Set.indicator_of_notMem hq, mul_zero, mul_zero]

/-- **The 2D polar step.**  The quadrant double integral factors as the radial constant times
the angular integral over `(0, π/2)`. -/
theorem lintegral_quadFun (a b : ℕ) {g : ℝ → ℝ≥0∞} (hg : Measurable g) :
    ∫⁻ ρ in Set.Ioi (0 : ℝ), ∫⁻ s in Set.Ioi (0 : ℝ), quadFun a b g (ρ, s)
      = radialConst (a + b + 1) *
          ∫⁻ θ in Set.Ioo 0 (Real.pi / 2), angWeight a b θ * g (Real.cos θ) := by
  have hmq := measurable_quadFun a b hg
  have h1 : ∫⁻ ρ in Set.Ioi (0 : ℝ), ∫⁻ s in Set.Ioi (0 : ℝ), quadFun a b g (ρ, s)
      = ∫⁻ p, (Set.Ioi (0 : ℝ) ×ˢ Set.Ioi (0 : ℝ)).indicator (quadFun a b g) p := by
    rw [← lintegral_prod _ hmq.aemeasurable, Measure.prod_restrict,
      lintegral_indicator (measurableSet_Ioi.prod measurableSet_Ioi), volume_eq_prod]
  have h2 : ∫⁻ p, (Set.Ioi (0 : ℝ) ×ˢ Set.Ioi (0 : ℝ)).indicator (quadFun a b g) p
      = ∫⁻ p in polarCoord.target, radFun (a + b + 1) p.1 * angFun a b g p.2 := by
    rw [← lintegral_comp_polarCoord_symm, polarCoord_target]
    refine setLIntegral_congr_fun (measurableSet_Ioi.prod measurableSet_Ioo) fun p hp => ?_
    rw [polarCoord_symm_apply, smul_eq_mul]
    exact quadFun_polar a b g hp.1 hp.2
  have h3 : ∫⁻ p in polarCoord.target, radFun (a + b + 1) p.1 * angFun a b g p.2
      = radialConst (a + b + 1) * ∫⁻ θ in Set.Ioo (-Real.pi) Real.pi, angFun a b g θ := by
    rw [polarCoord_target, volume_eq_prod, ← Measure.prod_restrict,
      lintegral_prod_mul (measurable_radFun _).aemeasurable (measurable_angFun a b hg).aemeasurable]
    rfl
  have h4 : ∫⁻ θ in Set.Ioo (-Real.pi) Real.pi, angFun a b g θ
      = ∫⁻ θ in Set.Ioo 0 (Real.pi / 2), angWeight a b θ * g (Real.cos θ) := by
    unfold angFun
    rw [lintegral_indicator measurableSet_Ioo, Measure.restrict_restrict measurableSet_Ioo,
      Set.inter_eq_left.mpr (Set.Ioo_subset_Ioo (by linarith [Real.pi_pos]) (by linarith [Real.pi_pos]))]
  rw [h1, h2, h3, h4]

end Polar2D
/-! ## §20  Lemma 1, block form: the marginal of a block of coordinates

For `E = U × V` (Euclidean product) and `u` uniform on the sphere of `E`, the `U`-block of `u`
has density proportional to `(1 − ‖x‖²)^{(dim V − 2)/2}` on the unit ball of `U`.  The proof is
the classical one, made exact: integrate a test function `ψ(u_U)` cut off at the unit ball, once
by the polar formula on `E`, once by the product structure and the polar formulas on `U` and `V`
followed by a polar change on the two radii.  The radial factors agree and cancel, leaving an
angular integral on the sphere of `U` (`lintegral_sphere_fst`); the same angular integral is what
the candidate density produces after the substitution `ρ = cos θ` (`lintegral_ball_density`).
`toSphere_map_fst` states the result as an equality of measures. -/

section Block
variable {U V : Type*} [NormedAddCommGroup U] [InnerProductSpace ℝ U] [MeasurableSpace U]
  [BorelSpace U] [FiniteDimensional ℝ U] [Nontrivial U]
  [NormedAddCommGroup V] [InnerProductSpace ℝ V] [MeasurableSpace V] [BorelSpace V]
  [FiniteDimensional ℝ V] [Nontrivial V]

/-- The test function: `ψ` of the `U`-block of the direction, cut off at the unit ball. -/
noncomputable def testFun (ψ : U → ℝ≥0∞) (z : WithLp 2 (U × V)) : ℝ≥0∞ :=
  ψ (‖z‖⁻¹ • (WithLp.ofLp z).1) * (ball (0 : WithLp 2 (U × V)) 1).indicator 1 z

theorem measurable_testFun {ψ : U → ℝ≥0∞} (hψ : Measurable ψ) : Measurable (testFun (V := V) ψ) := by
  unfold testFun
  exact (hψ.comp (by fun_prop)).mul (measurable_const.indicator measurableSet_ball)

theorem testFun_smul_sphere (ψ : U → ℝ≥0∞) (u : sphere (0 : WithLp 2 (U × V)) 1) {r : ℝ}
    (hr : 0 < r) :
    testFun ψ (r • (u : WithLp 2 (U × V))) = ψ (WithLp.ofLp (u : WithLp 2 (U × V))).1
      * (Set.Iio (1 : ℝ)).indicator 1 r := by
  have hu : ‖(u : WithLp 2 (U × V))‖ = 1 := mem_sphere_zero_iff_norm.mp u.2
  have hn : ‖r • (u : WithLp 2 (U × V))‖ = r := by
    rw [norm_smul, hu, mul_one, Real.norm_eq_abs, abs_of_pos hr]
  unfold testFun
  rw [hn]
  congr 1
  · rw [WithLp.ofLp_smul, Prod.smul_fst, inv_smul_smul₀ hr.ne']
  · by_cases h : r < 1
    · rw [Set.indicator_of_mem (by rwa [mem_ball_zero_iff, hn]),
        Set.indicator_of_mem (Set.mem_Iio.mpr h)]
      rfl
    · rw [Set.indicator_of_notMem (by rwa [mem_ball_zero_iff, hn]),
        Set.indicator_of_notMem (fun h' => h (Set.mem_Iio.mp h'))]

/-- **Left side.**  The polar formula on `E` evaluates the test integral to the sphere
marginal times the radial constant. -/
theorem lintegral_testFun_eq_sphere {ψ : U → ℝ≥0∞} (hψ : Measurable ψ) :
    ∫⁻ z, testFun (V := V) ψ z
      = (∫⁻ u : sphere (0 : WithLp 2 (U × V)) 1, ψ (WithLp.ofLp (u : WithLp 2 (U × V))).1
          ∂volume.toSphere) * radialConst (Module.finrank ℝ (WithLp 2 (U × V)) - 1) := by
  rw [lintegral_eq_polar _ (measurable_testFun hψ), ← lintegral_mul_const _ (by fun_prop)]
  refine lintegral_congr fun u => ?_
  have hm : Measurable (fun r : ℝ => ENNReal.ofReal
      (r ^ (Module.finrank ℝ (WithLp 2 (U × V)) - 1)) * (Set.Iio (1 : ℝ)).indicator 1 r) :=
    (by fun_prop : Measurable fun r : ℝ => ENNReal.ofReal
      (r ^ (Module.finrank ℝ (WithLp 2 (U × V)) - 1))).mul
      (measurable_const.indicator measurableSet_Iio)
  rw [radialConst, ← lintegral_const_mul _ hm]
  refine setLIntegral_congr_fun measurableSet_Ioi fun r hr => ?_
  rw [testFun_smul_sphere ψ u hr]
  ring

/-- The integrand of the `V`-slice at a fixed `x : U`, as a function of `‖y‖`. -/
noncomputable def sliceFun (ψ : U → ℝ≥0∞) (x : U) (s : ℝ) : ℝ≥0∞ :=
  ψ ((√(‖x‖ ^ 2 + s ^ 2))⁻¹ • x) * (Set.Iio (1 : ℝ)).indicator 1 (‖x‖ ^ 2 + s ^ 2)

omit [Nontrivial U] [Nontrivial V] in
theorem measurable_sliceFun_uncurry {ψ : U → ℝ≥0∞} (hψ : Measurable ψ) :
    Measurable (fun p : U × ℝ => sliceFun ψ p.1 p.2) := by
  unfold sliceFun
  exact (hψ.comp (by fun_prop)).mul
    ((measurable_const.indicator measurableSet_Iio).comp (by fun_prop))

omit [Nontrivial U] [Nontrivial V] in
theorem testFun_toLp (ψ : U → ℝ≥0∞) (x : U) (y : V) :
    testFun ψ (WithLp.toLp 2 (x, y)) = sliceFun ψ x ‖y‖ := by
  unfold testFun sliceFun
  rw [WithLp.prod_norm_eq_of_L2]
  simp only [WithLp.fst, WithLp.snd]
  congr 1
  have hmem : WithLp.toLp 2 (x, y) ∈ ball (0 : WithLp 2 (U × V)) 1 ↔ ‖x‖ ^ 2 + ‖y‖ ^ 2 < 1 := by
    rw [mem_ball_zero_iff, WithLp.prod_norm_eq_of_L2, Real.sqrt_lt' one_pos, one_pow]
    simp only [WithLp.fst, WithLp.snd]
  by_cases h : ‖x‖ ^ 2 + ‖y‖ ^ 2 < 1
  · rw [Set.indicator_of_mem (hmem.mpr h), Set.indicator_of_mem (Set.mem_Iio.mpr h)]
    rfl
  · rw [Set.indicator_of_notMem (fun h' => h (hmem.mp h')),
      Set.indicator_of_notMem (fun h' => h (Set.mem_Iio.mp h'))]

/-- **Right side, first two steps.**  Split `E = U × V`, then apply the polar formula on `V`. -/
theorem lintegral_testFun_eq_slices {ψ : U → ℝ≥0∞} (hψ : Measurable ψ) :
    ∫⁻ z, testFun (V := V) ψ z
      = ∫⁻ x, (∫⁻ s in Set.Ioi (0 : ℝ), ENNReal.ofReal (s ^ (Module.finrank ℝ V - 1)) * sliceFun ψ x s)
          * volume.toSphere (Set.univ : Set (sphere (0 : V) 1)) := by
  rw [← (WithLp.volume_preserving_toLp U V).lintegral_comp (measurable_testFun hψ),
    volume_eq_prod, lintegral_prod (fun a : U × V => testFun ψ (WithLp.toLp 2 a))
      ((measurable_testFun hψ).comp (WithLp.measurable_toLp 2 (U × V))).aemeasurable]
  refine lintegral_congr fun x => ?_
  simp_rw [testFun_toLp]
  have hm : Measurable fun y : V => sliceFun ψ x ‖y‖ :=
    (measurable_sliceFun_uncurry hψ).comp (measurable_const.prodMk measurable_norm)
  rw [lintegral_eq_polar _ hm]
  have hw : ∀ w : sphere (0 : V) 1,
      (∫⁻ s in Set.Ioi (0 : ℝ), ENNReal.ofReal (s ^ (Module.finrank ℝ V - 1))
        * sliceFun ψ x ‖s • (w : V)‖)
      = ∫⁻ s in Set.Ioi (0 : ℝ), ENNReal.ofReal (s ^ (Module.finrank ℝ V - 1)) * sliceFun ψ x s := by
    intro w
    refine setLIntegral_congr_fun measurableSet_Ioi fun s hs => ?_
    rw [norm_smul, mem_sphere_zero_iff_norm.mp w.2, mul_one, Real.norm_eq_abs, abs_of_pos hs]
  simp_rw [hw]
  rw [lintegral_const]

omit [Nontrivial U] [Nontrivial V] in
theorem measurable_sliceIntegral {ψ : U → ℝ≥0∞} (hψ : Measurable ψ) :
    Measurable fun x : U =>
      ∫⁻ s in Set.Ioi (0 : ℝ), ENNReal.ofReal (s ^ (Module.finrank ℝ V - 1)) * sliceFun ψ x s :=
  Measurable.lintegral_prod_right
    ((by fun_prop : Measurable fun p : U × ℝ =>
      ENNReal.ofReal (p.2 ^ (Module.finrank ℝ V - 1))).mul (measurable_sliceFun_uncurry hψ))

/-- **Right side, third step.**  The polar formula on `U`. -/
theorem lintegral_testFun_eq_triple {ψ : U → ℝ≥0∞} (hψ : Measurable ψ) :
    ∫⁻ z, testFun (V := V) ψ z
      = (∫⁻ v : sphere (0 : U) 1, (∫⁻ ρ in Set.Ioi (0 : ℝ),
          ENNReal.ofReal (ρ ^ (Module.finrank ℝ U - 1)) *
            ∫⁻ s in Set.Ioi (0 : ℝ), ENNReal.ofReal (s ^ (Module.finrank ℝ V - 1))
              * sliceFun ψ (ρ • (v : U)) s) ∂volume.toSphere)
        * volume.toSphere (Set.univ : Set (sphere (0 : V) 1)) := by
  rw [lintegral_testFun_eq_slices hψ, lintegral_mul_const _ (measurable_sliceIntegral hψ),
    lintegral_eq_polar _ (measurable_sliceIntegral hψ)]

end Block

section Assemble
variable {U V : Type*} [NormedAddCommGroup U] [InnerProductSpace ℝ U] [MeasurableSpace U]
  [BorelSpace U] [FiniteDimensional ℝ U] [Nontrivial U]
  [NormedAddCommGroup V] [InnerProductSpace ℝ V] [MeasurableSpace V] [BorelSpace V]
  [FiniteDimensional ℝ V] [Nontrivial V]

/-- The slice integrand at `ρ • v` is the quadrant integrand with `g t = ψ (t • v)`. -/
theorem sliceFun_smul_sphere (ψ : U → ℝ≥0∞) (v : sphere (0 : U) 1) {ρ : ℝ} (hρ : 0 < ρ) (s : ℝ) :
    ENNReal.ofReal (ρ ^ (Module.finrank ℝ U - 1)) *
      (ENNReal.ofReal (s ^ (Module.finrank ℝ V - 1)) * sliceFun ψ (ρ • (v : U)) s)
      = quadFun (Module.finrank ℝ U - 1) (Module.finrank ℝ V - 1) (fun t => ψ (t • (v : U))) (ρ, s) := by
  have hv : ‖(v : U)‖ = 1 := mem_sphere_zero_iff_norm.mp v.2
  have hn : ‖ρ • (v : U)‖ = ρ := by
    rw [norm_smul, hv, mul_one, Real.norm_eq_abs, abs_of_pos hρ]
  unfold sliceFun quadFun
  simp only [hn, smul_smul]

omit [Nontrivial U] [Nontrivial V] in
theorem finrank_withLp_prod :
    Module.finrank ℝ (WithLp 2 (U × V)) = Module.finrank ℝ U + Module.finrank ℝ V := by
  rw [(WithLp.linearEquiv 2 ℝ (U × V)).finrank_eq, Module.finrank_prod]

theorem finrank_withLp_prod_sub_one :
    Module.finrank ℝ (WithLp 2 (U × V)) - 1
      = (Module.finrank ℝ U - 1) + (Module.finrank ℝ V - 1) + 1 := by
  have hU : 0 < Module.finrank ℝ U := Module.finrank_pos
  have hV : 0 < Module.finrank ℝ V := Module.finrank_pos
  rw [finrank_withLp_prod]
  omega

set_option maxHeartbeats 1000000 in
/-- **The sphere marginal in polar form.**  For the uniform measure on the sphere of
`E = U × V`, the law of the `U`-block, integrated against `ψ`, is a constant times an angular
integral on the sphere of `U`. -/
theorem lintegral_sphere_fst {ψ : U → ℝ≥0∞} (hψ : Measurable ψ) :
    ∫⁻ u : sphere (0 : WithLp 2 (U × V)) 1, ψ (WithLp.ofLp (u : WithLp 2 (U × V))).1
        ∂volume.toSphere
      = volume.toSphere (Set.univ : Set (sphere (0 : V) 1)) *
          ∫⁻ v : sphere (0 : U) 1, (∫⁻ θ in Set.Ioo 0 (Real.pi / 2),
            angWeight (Module.finrank ℝ U - 1) (Module.finrank ℝ V - 1) θ * ψ (Real.cos θ • (v : U)))
            ∂volume.toSphere := by
  have hL := lintegral_testFun_eq_sphere (V := V) hψ
  have hR := lintegral_testFun_eq_triple (V := V) hψ
  have hinner : ∀ v : sphere (0 : U) 1,
      (∫⁻ ρ in Set.Ioi (0 : ℝ), ENNReal.ofReal (ρ ^ (Module.finrank ℝ U - 1)) *
          ∫⁻ s in Set.Ioi (0 : ℝ), ENNReal.ofReal (s ^ (Module.finrank ℝ V - 1))
            * sliceFun ψ (ρ • (v : U)) s)
      = radialConst (Module.finrank ℝ (WithLp 2 (U × V)) - 1) *
          ∫⁻ θ in Set.Ioo 0 (Real.pi / 2),
            angWeight (Module.finrank ℝ U - 1) (Module.finrank ℝ V - 1) θ
              * ψ (Real.cos θ • (v : U)) := by
    intro v
    have hg : Measurable fun t : ℝ => ψ (t • (v : U)) := hψ.comp (by fun_prop)
    rw [finrank_withLp_prod_sub_one, ← lintegral_quadFun _ _ hg]
    refine setLIntegral_congr_fun measurableSet_Ioi fun ρ hρ => ?_
    have hm : Measurable fun s : ℝ =>
        ENNReal.ofReal (s ^ (Module.finrank ℝ V - 1)) * sliceFun ψ (ρ • (v : U)) s := by
      exact (by fun_prop : Measurable fun s : ℝ =>
        ENNReal.ofReal (s ^ (Module.finrank ℝ V - 1))).mul
          ((measurable_sliceFun_uncurry hψ).comp (measurable_const.prodMk measurable_id))
    rw [← lintegral_const_mul _ hm]
    exact setLIntegral_congr_fun measurableSet_Ioi fun s _ => sliceFun_smul_sphere ψ v hρ s
  have hF : Measurable fun p : sphere (0 : U) 1 × ℝ =>
      angWeight (Module.finrank ℝ U - 1) (Module.finrank ℝ V - 1) p.2 * ψ (Real.cos p.2 • (p.1 : U)) :=
    ((measurable_angWeight _ _).comp measurable_snd).mul
      (hψ.comp ((Real.measurable_cos.comp measurable_snd).smul
        (measurable_subtype_coe.comp measurable_fst)))
  have hA : Measurable fun v : sphere (0 : U) 1 => ∫⁻ θ in Set.Ioo 0 (Real.pi / 2),
      angWeight (Module.finrank ℝ U - 1) (Module.finrank ℝ V - 1) θ * ψ (Real.cos θ • (v : U)) :=
    hF.lintegral_prod_right'
  have hR' : ∫⁻ z, testFun (V := V) ψ z
      = (radialConst (Module.finrank ℝ (WithLp 2 (U × V)) - 1) *
          ∫⁻ v : sphere (0 : U) 1, (∫⁻ θ in Set.Ioo 0 (Real.pi / 2),
            angWeight (Module.finrank ℝ U - 1) (Module.finrank ℝ V - 1) θ * ψ (Real.cos θ • (v : U)))
            ∂volume.toSphere)
        * volume.toSphere (Set.univ : Set (sphere (0 : V) 1)) := by
    rw [hR, ← lintegral_const_mul _ hA]
    congr 1
    exact lintegral_congr hinner
  rw [hR'] at hL
  have h0 : radialConst (Module.finrank ℝ (WithLp 2 (U × V)) - 1) ≠ 0 := by
    rw [radialConst_eq]; simp; positivity
  have htop : radialConst (Module.finrank ℝ (WithLp 2 (U × V)) - 1) ≠ ⊤ := by
    rw [radialConst_eq]; exact ENNReal.ofReal_ne_top
  have key : (∫⁻ u : sphere (0 : WithLp 2 (U × V)) 1,
        ψ (WithLp.ofLp (u : WithLp 2 (U × V))).1 ∂volume.toSphere)
        * radialConst (Module.finrank ℝ (WithLp 2 (U × V)) - 1)
      = (volume.toSphere (Set.univ : Set (sphere (0 : V) 1)) *
          ∫⁻ v : sphere (0 : U) 1, (∫⁻ θ in Set.Ioo 0 (Real.pi / 2),
            angWeight (Module.finrank ℝ U - 1) (Module.finrank ℝ V - 1) θ * ψ (Real.cos θ • (v : U)))
            ∂volume.toSphere)
        * radialConst (Module.finrank ℝ (WithLp 2 (U × V)) - 1) := by
    rw [← hL]; ring
  exact (ENNReal.mul_left_inj h0 htop).mp key

end Assemble

section Density
variable {U : Type*} [NormedAddCommGroup U] [InnerProductSpace ℝ U] [MeasurableSpace U]
  [BorelSpace U] [FiniteDimensional ℝ U] [Nontrivial U]

theorem image_cos_Ioo : Real.cos '' Set.Ioo 0 (Real.pi / 2) = Set.Ioo 0 1 := by
  ext ρ
  constructor
  · rintro ⟨θ, hθ, rfl⟩
    refine ⟨Real.cos_pos_of_mem_Ioo ⟨by linarith [hθ.1, Real.pi_pos], hθ.2⟩, ?_⟩
    have := Real.cos_lt_cos_of_nonneg_of_le_pi_div_two le_rfl hθ.2.le hθ.1
    rwa [Real.cos_zero] at this
  · intro hρ
    exact ⟨Real.arccos ρ, ⟨Real.arccos_pos.mpr hρ.2, Real.arccos_lt_pi_div_two.mpr hρ.1⟩,
      Real.cos_arccos (by linarith [hρ.1]) hρ.2.le⟩

/-- The density of the `U`-block marginal, before normalisation: `(1 − ‖x‖²)^{(m−2)/2}`. -/
noncomputable def blockDensity (m : ℕ) (x : U) : ℝ≥0∞ :=
  ENNReal.ofReal ((1 - ‖x‖ ^ 2) ^ (((m : ℝ) - 2) / 2))

theorem measurable_blockDensity (m : ℕ) : Measurable (blockDensity (U := U) m) := by
  unfold blockDensity; fun_prop

/-- `sin θ · (1 − cos²θ)^{(m−2)/2} = sin^{m−1} θ` on `(0, π/2)`. -/
theorem sin_mul_rpow (m : ℕ) (hm : 1 ≤ m) {θ : ℝ} (hθ : θ ∈ Set.Ioo 0 (Real.pi / 2)) :
    Real.sin θ * (1 - Real.cos θ ^ 2) ^ (((m : ℝ) - 2) / 2) = Real.sin θ ^ (m - 1) := by
  have hs : 0 < Real.sin θ := Real.sin_pos_of_pos_of_lt_pi hθ.1 (by linarith [hθ.2, Real.pi_pos])
  have h1 : (1 - Real.cos θ ^ 2) ^ (((m : ℝ) - 2) / 2) = Real.sin θ ^ ((m : ℝ) - 2) := by
    rw [← Real.sin_sq, ← Real.rpow_two, ← Real.rpow_mul hs.le, mul_div_cancel₀ _ two_ne_zero]
  rw [h1, show Real.sin θ * Real.sin θ ^ ((m : ℝ) - 2)
      = Real.sin θ ^ (1 : ℝ) * Real.sin θ ^ ((m : ℝ) - 2) by rw [Real.rpow_one],
    ← Real.rpow_add hs, show (1 : ℝ) + ((m : ℝ) - 2) = ((m - 1 : ℕ) : ℝ) by
      rw [Nat.cast_sub hm, Nat.cast_one]; ring,
    Real.rpow_natCast]

/-- **The density side.**  The candidate density integrated against `ψ` over the unit ball of
`U` is the same angular integral as `lintegral_sphere_fst` produces. -/
theorem lintegral_ball_density {ψ : U → ℝ≥0∞} (hψ : Measurable ψ) (m : ℕ) (hm : 1 ≤ m) :
    ∫⁻ x in ball (0 : U) 1, blockDensity m x * ψ x
      = ∫⁻ v : sphere (0 : U) 1, (∫⁻ θ in Set.Ioo 0 (Real.pi / 2),
          angWeight (Module.finrank ℝ U - 1) (m - 1) θ * ψ (Real.cos θ • (v : U)))
          ∂volume.toSphere := by
  rw [← lintegral_indicator measurableSet_ball,
    lintegral_eq_polar (fun x => (ball (0 : U) 1).indicator (fun x => blockDensity m x * ψ x) x)
      (by exact ((measurable_blockDensity m).mul hψ).indicator measurableSet_ball)]
  refine lintegral_congr fun v => ?_
  have hv : ‖(v : U)‖ = 1 := mem_sphere_zero_iff_norm.mp v.2
  have hpt : ∀ ρ ∈ Set.Ioi (0 : ℝ), ENNReal.ofReal (ρ ^ (Module.finrank ℝ U - 1)) *
        (ball (0 : U) 1).indicator (fun x => blockDensity m x * ψ x) (ρ • (v : U))
      = (Set.Iio (1 : ℝ)).indicator (fun ρ => ENNReal.ofReal (ρ ^ (Module.finrank ℝ U - 1)) *
          (ENNReal.ofReal ((1 - ρ ^ 2) ^ (((m : ℝ) - 2) / 2)) * ψ (ρ • (v : U)))) ρ := by
    intro ρ hρ
    have hn : ‖ρ • (v : U)‖ = ρ := by
      rw [norm_smul, hv, mul_one, Real.norm_eq_abs, abs_of_pos hρ]
    by_cases h1 : ρ < 1
    · rw [Set.indicator_of_mem (by rwa [mem_ball_zero_iff, hn]),
        Set.indicator_of_mem (Set.mem_Iio.mpr h1), blockDensity, hn]
    · rw [Set.indicator_of_notMem (by rwa [mem_ball_zero_iff, hn]),
        Set.indicator_of_notMem (fun h' => h1 (Set.mem_Iio.mp h')), mul_zero]
  rw [setLIntegral_congr_fun measurableSet_Ioi hpt, lintegral_indicator measurableSet_Iio,
    Measure.restrict_restrict measurableSet_Iio, Set.inter_comm, Set.Ioi_inter_Iio, ← image_cos_Ioo,
    lintegral_image_eq_lintegral_abs_deriv_mul measurableSet_Ioo
      (fun θ _ => (Real.hasDerivAt_cos θ).hasDerivWithinAt)
      (Real.injOn_cos.mono (Set.Ioo_subset_Icc_self.trans
        (Set.Icc_subset_Icc le_rfl (by linarith [Real.pi_pos]))))]
  refine setLIntegral_congr_fun measurableSet_Ioo fun θ hθ => ?_
  have hs : 0 < Real.sin θ := Real.sin_pos_of_pos_of_lt_pi hθ.1 (by linarith [hθ.2, Real.pi_pos])
  have hc : 0 ≤ Real.cos θ :=
    (Real.cos_pos_of_mem_Ioo ⟨by linarith [hθ.1, Real.pi_pos], hθ.2⟩).le
  rw [abs_neg, abs_of_pos hs, angWeight, ← sin_mul_rpow m hm hθ,
    ENNReal.ofReal_mul (pow_nonneg hc _), ENNReal.ofReal_mul hs.le]
  ring

end Density

section MeasureForm
variable {U V : Type*} [NormedAddCommGroup U] [InnerProductSpace ℝ U] [MeasurableSpace U]
  [BorelSpace U] [FiniteDimensional ℝ U] [Nontrivial U]
  [NormedAddCommGroup V] [InnerProductSpace ℝ V] [MeasurableSpace V] [BorelSpace V]
  [FiniteDimensional ℝ V] [Nontrivial V]

theorem measurable_sphere_fst :
    Measurable fun u : sphere (0 : WithLp 2 (U × V)) 1 => (WithLp.ofLp (u : WithLp 2 (U × V))).1 :=
  measurable_fst.comp ((WithLp.measurable_ofLp 2 (U × V)).comp measurable_subtype_coe)

/-- The unnormalised density measure of the `U`-block: `(1 − ‖x‖²)^{(m−2)/2}` on the unit ball. -/
noncomputable def blockMeasure (U : Type*) [NormedAddCommGroup U] [InnerProductSpace ℝ U]
    [MeasurableSpace U] [BorelSpace U] [FiniteDimensional ℝ U] (m : ℕ) : Measure U :=
  (volume.restrict (ball (0 : U) 1)).withDensity (blockDensity m)

/-- **The block marginal of the sphere measure, unnormalised.**  The pushforward of
`volume.toSphere` on `sphere (0 : U × V) 1` along the `U`-block is `σ_V(Set.univ)` times the
density `(1 − ‖x‖²)^{(dim V − 2)/2}` on the unit ball of `U`. -/
theorem toSphere_map_fst :
    (volume.toSphere : Measure (sphere (0 : WithLp 2 (U × V)) 1)).map
        (fun u : sphere (0 : WithLp 2 (U × V)) 1 => (WithLp.ofLp (u : WithLp 2 (U × V))).1)
      = volume.toSphere (Set.univ : Set (sphere (0 : V) 1)) • blockMeasure U (Module.finrank ℝ V) := by
  ext s hs
  have hψ : Measurable (s.indicator (1 : U → ℝ≥0∞)) := measurable_const.indicator hs
  rw [Measure.map_apply measurable_sphere_fst hs, Measure.smul_apply, blockMeasure,
    withDensity_apply _ hs, Measure.restrict_restrict hs, smul_eq_mul]
  have hL : volume.toSphere ((fun u : sphere (0 : WithLp 2 (U × V)) 1 =>
        (WithLp.ofLp (u : WithLp 2 (U × V))).1) ⁻¹' s)
      = ∫⁻ u : sphere (0 : WithLp 2 (U × V)) 1,
          s.indicator 1 (WithLp.ofLp (u : WithLp 2 (U × V))).1 ∂volume.toSphere := by
    rw [← lintegral_indicator_one (measurable_sphere_fst hs)]
    refine lintegral_congr fun u => ?_
    by_cases h : (WithLp.ofLp (u : WithLp 2 (U × V))).1 ∈ s
    · rw [Set.indicator_of_mem h, Set.indicator_of_mem (show u ∈ (fun u : sphere (0 : WithLp 2 (U × V)) 1 =>
        (WithLp.ofLp (u : WithLp 2 (U × V))).1) ⁻¹' s from h)]
      rfl
    · rw [Set.indicator_of_notMem h, Set.indicator_of_notMem
        (show u ∉ (fun u : sphere (0 : WithLp 2 (U × V)) 1 =>
          (WithLp.ofLp (u : WithLp 2 (U × V))).1) ⁻¹' s from h)]
  have hR : ∫⁻ x in s ∩ ball (0 : U) 1, blockDensity (Module.finrank ℝ V) x
      = ∫⁻ x in ball (0 : U) 1, blockDensity (Module.finrank ℝ V) x * s.indicator 1 x := by
    rw [← Measure.restrict_restrict hs, ← lintegral_indicator hs]
    refine lintegral_congr fun x => ?_
    by_cases h : x ∈ s
    · rw [Set.indicator_of_mem h, Set.indicator_of_mem h]
      simp
    · rw [Set.indicator_of_notMem h, Set.indicator_of_notMem h, mul_zero]
  rw [hL, hR, lintegral_sphere_fst hψ, lintegral_ball_density hψ _ Module.finrank_pos]

end MeasureForm
/-! ## §21  Lemma 1, closed: the uniform direction law and its marginals

`sphereUniform E` is the normalised surface measure, the paper's "uniform on `S^{d−1}`".  Its
block marginal is `blockLaw U (dim V)` (`sphereUniform_map_fst`), which at `U = ℝ` is exactly
the paper's `sphericalCoordLaw d` of §4b (`blockLaw_real`); the constant in `f_d` is forced by
both sides being probability measures, so §4's Beta integral is what identifies it.  The sphere
measure is natural under linear isometries (`toSphere_map_sphereMap`), which transports the
statement to any unit vector `e` of any finite-dimensional inner product space of dimension at
least two (`sphereUniform_map_inner`), and to any orthogonal decomposition `E ≃ U × V`
(`sphereUniform_map_block`).  `sphereUniformAmbient E` is the same law as a measure on `E`, the
`σ` of §9 and §17; `sphereUniformAmbient_map_block` and `sphereUniformAmbient_map_inner` are the
`hmarg` hypotheses of §17 and §3b, discharged.

What this does not touch is header item 2: that the *rotated* direction `R r/‖R r‖` has this law
still needs Haar measure on `O(d)`. -/

section Normalise

variable (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E]

/-- The uniform probability measure on the unit sphere of `E`: normalised surface measure. -/
noncomputable def sphereUniform : Measure (sphere (0 : E) 1) :=
  (volume.toSphere (Set.univ : Set (sphere (0 : E) 1)))⁻¹ • volume.toSphere

theorem toSphere_univ_ne_zero [Nontrivial E] :
    volume.toSphere (Set.univ : Set (sphere (0 : E) 1)) ≠ 0 := by
  rw [Measure.toSphere_apply_univ]
  refine mul_ne_zero ?_ (measure_ball_pos volume (0 : E) one_pos).ne'
  exact_mod_cast Module.finrank_pos.ne'

instance sphereUniform_isProbabilityMeasure [Nontrivial E] :
    IsProbabilityMeasure (sphereUniform E) := by
  constructor
  rw [sphereUniform, Measure.smul_apply, smul_eq_mul,
    ENNReal.inv_mul_cancel (toSphere_univ_ne_zero E) (measure_ne_top _ _)]

variable {E}

/-- The law of a `U`-block of a uniform direction: the density `(1 − ‖x‖²)^{(m−2)/2}` on the
unit ball, normalised. -/
noncomputable def blockLaw (U : Type*) [NormedAddCommGroup U] [InnerProductSpace ℝ U]
    [MeasurableSpace U] [BorelSpace U] [FiniteDimensional ℝ U] (m : ℕ) : Measure U :=
  (blockMeasure U m Set.univ)⁻¹ • blockMeasure U m

variable {U V : Type*} [NormedAddCommGroup U] [InnerProductSpace ℝ U] [MeasurableSpace U]
  [BorelSpace U] [FiniteDimensional ℝ U] [Nontrivial U]
  [NormedAddCommGroup V] [InnerProductSpace ℝ V] [MeasurableSpace V] [BorelSpace V]
  [FiniteDimensional ℝ V] [Nontrivial V]

/-- **Lemma 1, block form.**  Under the uniform law on the sphere of `U × V`, the `U`-block has
law `blockLaw U (dim V)`, i.e. density proportional to `(1 − ‖x‖²)^{(dim V − 2)/2}` on the unit
ball of `U`. -/
theorem sphereUniform_map_fst :
    (sphereUniform (WithLp 2 (U × V))).map
        (fun u : sphere (0 : WithLp 2 (U × V)) 1 => (WithLp.ofLp (u : WithLp 2 (U × V))).1)
      = blockLaw U (Module.finrank ℝ V) := by
  have h1 : ((sphereUniform (WithLp 2 (U × V))).map
      (fun u : sphere (0 : WithLp 2 (U × V)) 1 => (WithLp.ofLp (u : WithLp 2 (U × V))).1)) Set.univ
      = 1 := by
    rw [Measure.map_apply measurable_sphere_fst MeasurableSet.univ, Set.preimage_univ,
      measure_univ]
  rw [sphereUniform, Measure.map_smul, toSphere_map_fst, smul_smul] at h1 ⊢
  rw [Measure.smul_apply, smul_eq_mul] at h1
  rw [blockLaw, ENNReal.eq_inv_of_mul_eq_one_left h1]

/-! ### The scalar case `U = ℝ`: the paper's `f_d` -/

theorem blockDensity_real (m : ℕ) (t : ℝ) :
    blockDensity m t = ENNReal.ofReal ((1 - t ^ 2) ^ (((m : ℝ) - 2) / 2)) := by
  rw [blockDensity, Real.norm_eq_abs, sq_abs]

/-- `f_{m+1}` is a positive constant times the block density at `U = ℝ`. -/
theorem sphericalCoordLaw_eq_smul_blockMeasure (m : ℕ) (hm : 1 ≤ m) :
    sphericalCoordLaw (m + 1)
      = ENNReal.ofReal (Real.Gamma (((m + 1 : ℕ) : ℝ) / 2) /
          (Real.sqrt Real.pi * Real.Gamma ((((m + 1 : ℕ) : ℝ) - 1) / 2))) • blockMeasure ℝ m := by
  rw [sphericalCoordLaw, blockMeasure, Real.ball_eq_Ioo, zero_sub, zero_add,
    ← Measure.restrict_congr_set Ioo_ae_eq_Icc, ← withDensity_smul _ (measurable_blockDensity m)]
  congr 1
  funext t
  have hm' : (1 : ℝ) ≤ m := by exact_mod_cast hm
  have hc : 0 ≤ Real.Gamma (((m + 1 : ℕ) : ℝ) / 2) /
      (Real.sqrt Real.pi * Real.Gamma ((((m + 1 : ℕ) : ℝ) - 1) / 2)) :=
    div_nonneg (Real.Gamma_pos_of_pos (by positivity)).le
      (mul_nonneg (Real.sqrt_nonneg _) (Real.Gamma_pos_of_pos (by push_cast; linarith)).le)
  rw [Pi.smul_apply, smul_eq_mul, blockDensity_real, sphericalPdf,
    ← ENNReal.ofReal_mul hc]
  congr 2
  push_cast
  ring_nf

/-- **Lemma 1, scalar form**: the normalised block density at `U = ℝ`, `V` of dimension `d − 1`,
is the paper's coordinate law `sphericalCoordLaw d`. -/
theorem blockLaw_real (m : ℕ) (hm : 1 ≤ m) :
    blockLaw ℝ m = sphericalCoordLaw (m + 1) := by
  have hprob := isProbabilityMeasure_sphericalCoordLaw (d := m + 1) (by omega)
  have h1 := hprob.measure_univ
  rw [sphericalCoordLaw_eq_smul_blockMeasure m hm] at h1 ⊢
  rw [Measure.smul_apply, smul_eq_mul] at h1
  rw [blockLaw, ENNReal.eq_inv_of_mul_eq_one_left h1]

end Normalise

section Naturality
open scoped Pointwise

variable {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup F] [InnerProductSpace ℝ F] [MeasurableSpace F] [BorelSpace F]
  [FiniteDimensional ℝ F]

/-- A linear isometry equivalence restricted to the unit spheres. -/
def sphereMap (L : E ≃ₗᵢ[ℝ] F) (u : sphere (0 : E) 1) : sphere (0 : F) 1 :=
  ⟨L u, by rw [mem_sphere_zero_iff_norm, L.norm_map]; exact mem_sphere_zero_iff_norm.mp u.2⟩

@[simp] theorem sphereMap_coe (L : E ≃ₗᵢ[ℝ] F) (u : sphere (0 : E) 1) :
    ((sphereMap L u : sphere (0 : F) 1) : F) = L u := rfl

theorem continuous_sphereMap (L : E ≃ₗᵢ[ℝ] F) : Continuous (sphereMap L) :=
  (L.continuous.comp continuous_subtype_val).subtype_mk _

theorem measurable_sphereMap (L : E ≃ₗᵢ[ℝ] F) : Measurable (sphereMap L) :=
  (continuous_sphereMap L).measurable

/-- The cone over `s` pulls back along `L` to the cone over the pullback of `s`. -/
theorem preimage_cone (L : E ≃ₗᵢ[ℝ] F) (s : Set (sphere (0 : F) 1)) :
    ⇑L ⁻¹' (Set.Ioo (0 : ℝ) 1 • (Subtype.val '' s))
      = Set.Ioo (0 : ℝ) 1 • (Subtype.val '' (sphereMap L ⁻¹' s)) := by
  ext x
  simp only [Set.mem_preimage, Set.mem_smul, Set.mem_image]
  constructor
  · rintro ⟨r, hr, y, ⟨v, hv, rfl⟩, hx⟩
    refine ⟨r, hr, L.symm v, ⟨sphereMap L.symm v, ?_, rfl⟩, ?_⟩
    · show sphereMap L (sphereMap L.symm v) ∈ s
      convert hv using 1
      ext
      simp
    · apply L.injective
      rw [← hx, map_smul, L.apply_symm_apply]
  · rintro ⟨r, hr, y, ⟨w, hw, rfl⟩, rfl⟩
    exact ⟨r, hr, L w, ⟨sphereMap L w, hw, rfl⟩, by rw [map_smul]⟩

/-- **The sphere measure is natural under linear isometries.** -/
theorem toSphere_map_sphereMap (L : E ≃ₗᵢ[ℝ] F) :
    (volume.toSphere : Measure (sphere (0 : E) 1)).map (sphereMap L)
      = (volume.toSphere : Measure (sphere (0 : F) 1)) := by
  ext s hs
  rw [Measure.map_apply (measurable_sphereMap L) hs,
    Measure.toSphere_apply' _ (measurable_sphereMap L hs), Measure.toSphere_apply' _ hs,
    ← preimage_cone, L.measurePreserving.measure_preimage_emb L.toHomeomorph.measurableEmbedding,
    L.toLinearEquiv.finrank_eq]

theorem toSphere_univ_eq (L : E ≃ₗᵢ[ℝ] F) :
    volume.toSphere (Set.univ : Set (sphere (0 : E) 1)) = volume.toSphere (Set.univ : Set (sphere (0 : F) 1)) := by
  rw [← toSphere_map_sphereMap L, Measure.map_apply (measurable_sphereMap L) MeasurableSet.univ,
    Set.preimage_univ]

/-- The uniform sphere law is natural under linear isometries. -/
theorem sphereUniform_map_sphereMap (L : E ≃ₗᵢ[ℝ] F) :
    (sphereUniform E).map (sphereMap L) = sphereUniform F := by
  rw [sphereUniform, sphereUniform, Measure.map_smul, toSphere_map_sphereMap, toSphere_univ_eq L]

end Naturality

section Coordinate

open scoped InnerProductSpace

/-- The model space `ℝ × ℝⁿ` with the Euclidean norm. -/
abbrev modelSpace (n : ℕ) := WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))

theorem finrank_modelSpace (n : ℕ) : Module.finrank ℝ (modelSpace n) = n + 1 := by
  rw [finrank_withLp_prod, Module.finrank_self, finrank_euclideanSpace_fin]
  ring

/-- The distinguished unit vector `(1, 0)` of the model space. -/
noncomputable def modelVec (n : ℕ) : modelSpace n := WithLp.toLp 2 (1, 0)

theorem norm_modelVec (n : ℕ) : ‖modelVec n‖ = 1 := by
  rw [modelVec, WithLp.norm_toLp_fst, norm_one]

theorem inner_modelVec (n : ℕ) (x : modelSpace n) : ⟪modelVec n, x⟫_ℝ = (WithLp.ofLp x).1 := by
  rw [modelVec, WithLp.prod_inner_apply]
  simp [RCLike.inner_apply]

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E]

/-- An isometry from `E` onto the model space of the same dimension. -/
noncomputable def toModel (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] (hd : 1 ≤ Module.finrank ℝ E) :
    E ≃ₗᵢ[ℝ] modelSpace (Module.finrank ℝ E - 1) :=
  (stdOrthonormalBasis ℝ E).repr.trans
    ((LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ
      (finCongr (by rw [finrank_modelSpace]; omega))).trans
        (stdOrthonormalBasis ℝ (modelSpace (Module.finrank ℝ E - 1))).repr.symm)

/-- **Lemma 1.**  For `u` uniform on the unit sphere of `E` (`dim E ≥ 2`) and any unit vector
`e`, the coordinate `⟪e, u⟫` has the law `sphericalCoordLaw (dim E)`, i.e. the density `f_d`. -/
theorem sphereUniform_map_inner (hd : 2 ≤ Module.finrank ℝ E) {e : E} (he : ‖e‖ = 1) :
    (sphereUniform E).map (fun u : sphere (0 : E) 1 => ⟪e, (u : E)⟫_ℝ)
      = sphericalCoordLaw (Module.finrank ℝ E) := by
  haveI : Nonempty (Fin (Module.finrank ℝ E - 1)) := ⟨⟨0, by omega⟩⟩
  haveI : Nontrivial (EuclideanSpace ℝ (Fin (Module.finrank ℝ E - 1))) :=
    (WithLp.equiv 2 _).symm.injective.nontrivial
  haveI : Nontrivial E := Module.nontrivial_of_finrank_pos (R := ℝ) (by omega)
  let L₀ := toModel E (by omega)
  obtain ⟨M, hM⟩ := exists_isometry_map_eq (u := L₀ e) (v := modelVec _)
    (by rw [L₀.norm_map, he]) (norm_modelVec _)
  let L := L₀.trans M
  have hL : L e = modelVec _ := by simp [L, hM]
  have hcoord : ∀ u : E, ⟪e, u⟫_ℝ = (WithLp.ofLp (L u)).1 := by
    intro u
    rw [← L.inner_map_map e u, hL, inner_modelVec]
  have hcomp : (fun u : sphere (0 : E) 1 => ⟪e, (u : E)⟫_ℝ)
      = (fun u : sphere (0 : modelSpace (Module.finrank ℝ E - 1)) 1 =>
          (WithLp.ofLp (u : modelSpace (Module.finrank ℝ E - 1))).1) ∘ sphereMap L := by
    funext u
    simp [hcoord]
  rw [hcomp, ← Measure.map_map measurable_sphere_fst (measurable_sphereMap L),
    sphereUniform_map_sphereMap L, sphereUniform_map_fst, finrank_euclideanSpace_fin,
    blockLaw_real _ (by omega)]
  congr 1
  omega

/-- **Lemma 1, block form, for any orthogonal decomposition.**  If `L : E ≃ U × V` is a linear
isometry, the `U`-component of a uniform direction has law `blockLaw U (dim V)`.  For
`E = ℝ^d`, `U` the coordinates of one block of eight and `V` the rest, this is the law `f_{d,8}`
that the `E₈` stage's `ρ` is a quadrature over; for a trellis block of length `T` it is
`f_{d,T}`. -/
theorem sphereUniform_map_block {U V : Type*} [NormedAddCommGroup U] [InnerProductSpace ℝ U]
    [MeasurableSpace U] [BorelSpace U] [FiniteDimensional ℝ U] [Nontrivial U]
    [NormedAddCommGroup V] [InnerProductSpace ℝ V] [MeasurableSpace V] [BorelSpace V]
    [FiniteDimensional ℝ V] [Nontrivial V] (L : E ≃ₗᵢ[ℝ] WithLp 2 (U × V)) :
    (sphereUniform E).map (fun u : sphere (0 : E) 1 => (WithLp.ofLp (L u)).1)
      = blockLaw U (Module.finrank ℝ V) := by
  have hcomp : (fun u : sphere (0 : E) 1 => (WithLp.ofLp (L u)).1)
      = (fun u : sphere (0 : WithLp 2 (U × V)) 1 => (WithLp.ofLp (u : WithLp 2 (U × V))).1)
          ∘ sphereMap L := by
    funext u; rfl
  rw [hcomp, ← Measure.map_map measurable_sphere_fst (measurable_sphereMap L),
    sphereUniform_map_sphereMap L, sphereUniform_map_fst]

/-- The uniform direction law as a measure on the ambient space `E`, supported on the sphere:
the measure §11 calls `orbitLaw κ x₀` when the rotation is Haar, and the `σ` against which
§9 and §17 evaluate `ρ²`. -/
noncomputable def sphereUniformAmbient (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [MeasurableSpace E] [BorelSpace E] [FiniteDimensional ℝ E] : Measure E :=
  (sphereUniform E).map Subtype.val

instance [Nontrivial E] : IsProbabilityMeasure (sphereUniformAmbient E) :=
  Measure.isProbabilityMeasure_map measurable_subtype_coe.aemeasurable

/-- The block marginal of the ambient uniform law: the `hmarg` hypothesis of §17's block
quadrature, discharged for the uniform direction. -/
theorem sphereUniformAmbient_map_block {U V : Type*} [NormedAddCommGroup U]
    [InnerProductSpace ℝ U] [MeasurableSpace U] [BorelSpace U] [FiniteDimensional ℝ U]
    [Nontrivial U] [NormedAddCommGroup V] [InnerProductSpace ℝ V] [MeasurableSpace V]
    [BorelSpace V] [FiniteDimensional ℝ V] [Nontrivial V] (L : E ≃ₗᵢ[ℝ] WithLp 2 (U × V)) :
    (sphereUniformAmbient E).map (fun x : E => (WithLp.ofLp (L x)).1)
      = blockLaw U (Module.finrank ℝ V) := by
  have hg : Measurable fun x : E => (WithLp.ofLp (L x)).1 := by
    exact measurable_fst.comp ((WithLp.measurable_ofLp 2 (U × V)).comp L.continuous.measurable)
  rw [sphereUniformAmbient, Measure.map_map hg measurable_subtype_coe]
  exact sphereUniform_map_block L

/-- The coordinate marginal of the ambient uniform law: the paper's Lemma 1 in the form §3b
consumes it (`hmarg : ∀ i, μ.map (fun ω => U ω i) = ν` with `ν = sphericalCoordLaw d`). -/
theorem sphereUniformAmbient_map_inner (hd : 2 ≤ Module.finrank ℝ E) {e : E} (he : ‖e‖ = 1) :
    (sphereUniformAmbient E).map (fun x : E => ⟪e, x⟫_ℝ)
      = sphericalCoordLaw (Module.finrank ℝ E) := by
  have hg : Measurable fun x : E => ⟪e, x⟫_ℝ := (continuous_const.inner continuous_id).measurable
  rw [sphereUniformAmbient, Measure.map_map hg measurable_subtype_coe]
  exact sphereUniform_map_inner hd he

end Coordinate
/-! ## §22  The Haar identification: the direction law *is* the uniform law

Header item 2 was the last gap between §11 and the paper: `orbitLaw κ x₀`, the law of the
rotated direction, was not identified with the uniform law on the sphere.  The identification
needs no construction of Haar measure at all.  If `κ` is a right-invariant probability measure
on a group acting on `E` by isometries and transitively on the unit sphere, the hypotheses
`RotationStream` already carries, then `orbitLaw κ x₀ = sphereUniformAmbient E`
(`orbitLaw_eq_sphereUniformAmbient`).  The proof is the uniqueness-of-invariant-measure step of
Proposition 1 done by hand: the uniform law is `G`-invariant (§21), so integrating a test
function against it and averaging over `κ` changes nothing; swapping the integrals and using
that the orbit law is constant along the orbit (§5) returns the orbit law.

Consequences: `u_p` is uniform on the sphere at every pass (`law_unitVec_eq_sphereUniform`),
`ρ²` is the stage distortion against the uniform law (`integral_norm_resid_sq_uniform`), and
every coordinate of the uniform direction on `ℝ^d` has the law `sphericalCoordLaw d`
(`sphereUniformAmbient_map_coord`), which is the `hmarg` hypothesis of §3b. -/

open scoped InnerProductSpace

section OrbitLawSphere

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E]
variable {G : Type*} [Group G] [MeasurableSpace G] [MulAction G E] [MeasurableSMul₂ G E]
  [MeasurableMul G]

/-- The ambient uniform law is invariant under every element of a group acting by isometries. -/
theorem sphereUniformAmbient_map_smul {ι : G → (E ≃ₗᵢ[ℝ] E)}
    (hι : ∀ (g : G) (x : E), ι g x = g • x) (g : G) :
    (sphereUniformAmbient E).map (fun x => g • x) = sphereUniformAmbient E := by
  have h1 : (fun x : E => g • x) ∘ (Subtype.val : sphere (0 : E) 1 → E)
      = Subtype.val ∘ sphereMap (ι g) := by
    funext u; simp [hι]
  rw [sphereUniformAmbient, Measure.map_map (measurable_const_smul g) measurable_subtype_coe, h1,
    ← Measure.map_map measurable_subtype_coe (measurable_sphereMap _), sphereUniform_map_sphereMap]

/-- The ambient uniform law lives on the unit sphere. -/
theorem sphereUniformAmbient_ae_norm : ∀ᵐ x ∂(sphereUniformAmbient E), ‖x‖ = 1 := by
  rw [sphereUniformAmbient, ae_map_iff measurable_subtype_coe.aemeasurable
    (p := fun x : E => ‖x‖ = 1) (measurable_norm (measurableSet_singleton (1 : ℝ)))]
  exact Filter.Eventually.of_forall fun u => mem_sphere_zero_iff_norm.mp u.2

theorem lintegral_orbitLaw (κ : Measure G) (x : E) {f : E → ℝ≥0∞} (hf : Measurable f) :
    ∫⁻ y, f y ∂(orbitLaw κ x) = ∫⁻ g, f (g • x) ∂κ := by
  rw [orbitLaw, lintegral_map hf (measurable_smul_const x)]

/-- **The Haar identification.**  If `κ` is a right-invariant probability measure on a group `G`
acting on `E` by isometries and transitively on the unit sphere, then the law of `g • x₀` for
`g ∼ κ` is the uniform law on the sphere.  This is the uniqueness-of-invariant-measure step of
Proposition 1, proved directly: the uniform law is `G`-invariant (§21), so integrating a test
function against it, then averaging over `κ`, swapping the integrals, and using that the orbit
law is constant along the orbit (§5) returns the orbit law. -/
theorem orbitLaw_eq_sphereUniformAmbient [Nontrivial E] {ι : G → (E ≃ₗᵢ[ℝ] E)}
    (hι : ∀ (g : G) (x : E), ι g x = g • x)
    (κ : Measure G) [IsProbabilityMeasure κ] [κ.IsMulRightInvariant] {x₀ : E}
    (htrans : ∀ x : E, ‖x‖ = 1 → x ∈ MulAction.orbit G x₀) :
    orbitLaw κ x₀ = sphereUniformAmbient E := by
  have key : ∀ f : E → ℝ≥0∞, Measurable f →
      ∫⁻ y, f y ∂(orbitLaw κ x₀) = ∫⁻ y, f y ∂(sphereUniformAmbient E) := by
    intro f hf
    have h1 : ∀ g : G, ∫⁻ x, f (g • x) ∂(sphereUniformAmbient E)
        = ∫⁻ y, f y ∂(sphereUniformAmbient E) := by
      intro g
      rw [← lintegral_map hf (measurable_const_smul g), sphereUniformAmbient_map_smul hι g]
    have h2 : ∫⁻ y, f y ∂(sphereUniformAmbient E)
        = ∫⁻ g, ∫⁻ x, f (g • x) ∂(sphereUniformAmbient E) ∂κ := by
      simp_rw [h1]; rw [lintegral_const, measure_univ, mul_one]
    have hmeas : Measurable (fun p : G × E => f (p.1 • p.2)) := hf.comp measurable_smul
    have h3 : ∫⁻ g, ∫⁻ x, f (g • x) ∂(sphereUniformAmbient E) ∂κ
        = ∫⁻ x, ∫⁻ g, f (g • x) ∂κ ∂(sphereUniformAmbient E) :=
      lintegral_lintegral_swap hmeas.aemeasurable
    have h4 : ∀ᵐ x ∂(sphereUniformAmbient E),
        ∫⁻ g, f (g • x) ∂κ = ∫⁻ y, f y ∂(orbitLaw κ x₀) := by
      filter_upwards [sphereUniformAmbient_ae_norm (E := E)] with x hx
      rw [← lintegral_orbitLaw κ x hf, orbitLaw_eq_of_mem_orbit κ (htrans x hx)]
    rw [h2, h3, lintegral_congr_ae h4, lintegral_const, measure_univ, mul_one]
  refine Measure.ext fun s hs => ?_
  have := key (s.indicator 1) (measurable_const.indicator hs)
  rwa [lintegral_indicator_one hs, lintegral_indicator_one hs] at this

end OrbitLawSphere

section RotationStreamUniform

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E] [FiniteDimensional ℝ E]
variable {G : Type*} [Group G] [MeasurableSpace G] [MulAction G E] [MeasurableSMul₂ G E]
  [MeasurableInv G] [MeasurableMul G]
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
variable {ι : G → (E ≃ₗᵢ[ℝ] E)} {q : E → E} {W : Ω → E} {R : Ω → ℕ → G} {κ : Measure G}
  [κ.IsMulRightInvariant] {x₀ : E}

/-- For a rotation stream with a unit base point, the direction law of §11 *is* the uniform
law on the sphere: header item 2, discharged from the stream's own hypotheses. -/
theorem RotationStream.orbitLaw_eq (h : RotationStream ι q W R κ x₀ μ) (hx₀ : ‖x₀‖ = 1) :
    orbitLaw κ x₀ = sphereUniformAmbient E := by
  haveI : IsProbabilityMeasure κ := by
    rw [← h.law_R 0]; exact Measure.isProbabilityMeasure_map (h.meas_R 0).aemeasurable
  haveI : Nontrivial E := ⟨⟨x₀, 0, by rintro rfl; simp at hx₀⟩⟩
  exact orbitLaw_eq_sphereUniformAmbient h.implements κ h.transitive

/-- **Re-isotropisation, closed**: the unit direction `u_p` is uniform on the sphere at every
pass. -/
theorem law_unitVec_eq_sphereUniform (h : RotationStream ι q W R κ x₀ μ) (hx₀ : ‖x₀‖ = 1)
    (p : ℕ) :
    μ.map (fun ω => unitVec (rotScheme ι q (R ω)) (W ω) p) = sphereUniformAmbient E := by
  rw [law_unitVec_eq_orbitLaw h p, h.orbitLaw_eq hx₀]

/-- **Proposition 2 with the uniform law**: `ρ²` is the stage distortion against the uniform
direction, the quantity Table 2 measures. -/
theorem integral_norm_resid_sq_uniform (h : RotationStream ι q W R κ x₀ μ) (hx₀ : ‖x₀‖ = 1)
    (hW : Integrable (fun ω => ‖W ω‖ ^ 2) μ)
    (hint : Integrable (fun u : E => ‖u - q u‖ ^ 2) (sphereUniformAmbient E)) (P : ℕ) :
    ∫ ω, ‖resid (rotScheme ι q (R ω)) (W ω) P‖ ^ 2 ∂μ
      = stageDistortion q (sphereUniformAmbient E) ^ P * ∫ ω, ‖W ω‖ ^ 2 ∂μ := by
  rw [← h.orbitLaw_eq hx₀] at hint ⊢
  exact integral_norm_resid_sq_rotationStream h hW hint P

end RotationStreamUniform

section Coordinates

/-- Lemma 1 for the coordinates of `ℝ^d`: every coordinate of the uniform direction has law
`sphericalCoordLaw d`. -/
theorem sphereUniformAmbient_map_coord {d : ℕ} (hd : 2 ≤ d) (i : Fin d) :
    (sphereUniformAmbient (EuclideanSpace ℝ (Fin d))).map (fun x => x i) = sphericalCoordLaw d := by
  have h := sphereUniformAmbient_map_inner (E := EuclideanSpace ℝ (Fin d))
    (by rw [finrank_euclideanSpace_fin]; exact hd) (e := EuclideanSpace.single i (1 : ℝ))
    (by rw [PiLp.norm_single 2 _, norm_one])
  rw [finrank_euclideanSpace_fin] at h
  convert h using 2
  funext x
  rw [EuclideanSpace.inner_single_left]
  simp

end Coordinates
/-! ## §23  `O(d)` with its Haar measure: the paper's setting, instantiated

§22 identifies the direction law for any group and any right-invariant probability measure with
the right properties.  This section exhibits the paper's own: `O(d)` as Mathlib's
`Matrix.orthogonalGroup`, made a Borel space, shown compact (a closed subset of a box, since the
entries of an orthogonal matrix lie in `[-1, 1]`), given its normalised Haar measure `haarOd d`,
shown right-invariant by `isMulRightInvariant_of_compactSpace`, a general fact about compact
groups proved from uniqueness of Haar measure.  Mathlib's existing action of `O(d)` on `ℝ^d` is
matrix-vector multiplication; it is continuous, hence jointly measurable, by isometries
(`inner_smul`), and transitive on the unit sphere (`transitive`, from §5b and the fact that the
matrix of an isometry in an orthonormal basis is orthogonal).  `orbitLaw_haar` is then
Proposition 1 in full: the law of `g • x₀` for `g` Haar on `O(d)` is the uniform law. -/

/-! ### Right-invariance of Haar measure on a compact group -/

section Unimodular
variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [MeasurableSpace G] [BorelSpace G] [SecondCountableTopology G]

/-- On a compact group every left Haar measure is right-invariant: the right translate is again
left-invariant, hence a multiple of the Haar measure by uniqueness, and the total masses agree. -/
theorem isMulRightInvariant_of_compactSpace (μ : Measure G) [IsHaarMeasure μ] :
    μ.IsMulRightInvariant := by
  constructor
  intro g
  haveI : (μ.map (fun x => x * g)).IsMulLeftInvariant := by
    constructor
    intro h
    rw [Measure.map_map (measurable_const_mul h) (measurable_mul_const g)]
    have hcomp : (fun x : G => h * x) ∘ (fun x : G => x * g) = (fun x : G => x * g) ∘ (fun x : G => h * x) := by
      funext x; simp [mul_assoc]
    rw [hcomp, ← Measure.map_map (measurable_mul_const g) (measurable_const_mul h),
      map_mul_left_eq_self]
  haveI : IsFiniteMeasure (μ.map (fun x => x * g)) := isFiniteMeasure_map μ _
  have hK : (⊤ : TopologicalSpace.PositiveCompacts G) = ⊤ := rfl
  have h1 := haarMeasure_unique (μ.map (fun x => x * g)) ⊤
  have h2 := haarMeasure_unique μ ⊤
  have huniv : (μ.map (fun x => x * g)) ((⊤ : TopologicalSpace.PositiveCompacts G) : Set G)
      = μ ((⊤ : TopologicalSpace.PositiveCompacts G) : Set G) := by
    rw [TopologicalSpace.PositiveCompacts.coe_top,
      Measure.map_apply (measurable_mul_const g) MeasurableSet.univ, Set.preimage_univ]
  rw [h1, huniv, ← h2]

end Unimodular

namespace Orthogonal

variable (d : ℕ)

/-- The orthogonal group `O(d)`, as Mathlib's `Matrix.orthogonalGroup`. -/
abbrev Od := Matrix.orthogonalGroup (Fin d) ℝ

/-- `ℝ^d` with its Euclidean structure. -/
abbrev Ed := EuclideanSpace ℝ (Fin d)

instance : SecondCountableTopology (Matrix (Fin d) (Fin d) ℝ) :=
  inferInstanceAs (SecondCountableTopology (Fin d → Fin d → ℝ))

instance : SecondCountableTopology (Od d) :=
  inferInstanceAs (SecondCountableTopology
    ((Matrix.orthogonalGroup (Fin d) ℝ : Submonoid _) : Set (Matrix (Fin d) (Fin d) ℝ)))

instance : MeasurableSpace (Od d) := borel _
instance : BorelSpace (Od d) := ⟨rfl⟩

/-! ### Compactness -/

theorem entry_mem_Icc (g : Od d) (i j : Fin d) :
    (g : Matrix (Fin d) (Fin d) ℝ) i j ∈ Set.Icc (-1 : ℝ) 1 := by
  have h : star (g : Matrix (Fin d) (Fin d) ℝ) * g = 1 := Matrix.mem_unitaryGroup_iff'.mp g.2
  have hjj : (star (g : Matrix (Fin d) (Fin d) ℝ) * g) j j = 1 := by rw [h]; simp
  rw [Matrix.mul_apply] at hjj
  simp only [Matrix.star_apply, star_trivial] at hjj
  have hle : (g : Matrix (Fin d) (Fin d) ℝ) i j * (g : Matrix (Fin d) (Fin d) ℝ) i j ≤ 1 := by
    rw [← hjj]
    exact Finset.single_le_sum (f := fun k => (g : Matrix (Fin d) (Fin d) ℝ) k j *
      (g : Matrix (Fin d) (Fin d) ℝ) k j) (fun k _ => mul_self_nonneg _) (Finset.mem_univ i)
  constructor <;> nlinarith [hle]

theorem isClosed_orthogonalGroup :
    IsClosed ((Matrix.orthogonalGroup (Fin d) ℝ : Submonoid _) : Set (Matrix (Fin d) (Fin d) ℝ)) := by
  have : ((Matrix.orthogonalGroup (Fin d) ℝ : Submonoid _) : Set (Matrix (Fin d) (Fin d) ℝ))
      = {A | star A * A = 1} := by
    ext A; exact Matrix.mem_unitaryGroup_iff'
  rw [this]
  exact isClosed_eq (continuous_star.mul continuous_id) continuous_const

theorem isCompact_box :
    IsCompact (Set.pi Set.univ fun _ : Fin d => Set.pi Set.univ fun _ : Fin d => Set.Icc (-1 : ℝ) 1 :
      Set (Matrix (Fin d) (Fin d) ℝ)) :=
  isCompact_univ_pi fun _ => isCompact_univ_pi fun _ => isCompact_Icc

instance : CompactSpace (Od d) := by
  refine isCompact_iff_compactSpace.mp
    (IsCompact.of_isClosed_subset (isCompact_box d) (isClosed_orthogonalGroup d) ?_)
  intro A hA i _ j _
  exact entry_mem_Icc d ⟨A, hA⟩ i j

/-! ### Haar probability measure -/

/-- Normalised Haar measure on `O(d)`. -/
noncomputable def haarOd : Measure (Od d) := haarMeasure ⊤

instance : IsProbabilityMeasure (haarOd d) :=
  ⟨by rw [haarOd, ← TopologicalSpace.PositiveCompacts.coe_top]; exact haarMeasure_self⟩

instance : IsHaarMeasure (haarOd d) := by unfold haarOd; infer_instance

instance : (haarOd d).IsMulLeftInvariant := inferInstance

instance : (haarOd d).IsMulRightInvariant := isMulRightInvariant_of_compactSpace (haarOd d)

/-! ### The action on `ℝ^d` -/

/-- The action of `O(d)` on `ℝ^d` Mathlib already provides is matrix-vector multiplication. -/
theorem smul_def (g : Od d) (x : Ed d) :
    g • x = Matrix.toEuclideanLin (g : Matrix (Fin d) (Fin d) ℝ) x := by
  rw [Matrix.toEuclideanLin_apply]; rfl

instance : ContinuousSMul (Od d) (Ed d) := by
  constructor
  simp only [smul_def, Matrix.toEuclideanLin_apply]
  fun_prop

instance : MeasurableSMul₂ (Od d) (Ed d) := ContinuousSMul.measurableSMul₂

theorem inner_smul (g : Od d) (x y : Ed d) : ⟪g • x, g • y⟫_ℝ = ⟪x, y⟫_ℝ := by
  rw [smul_def, smul_def, ← LinearMap.adjoint_inner_right,
    ← Matrix.toEuclideanLin_conjTranspose_eq_adjoint, Matrix.toEuclideanLin_apply,
    Matrix.toEuclideanLin_apply, Matrix.mulVec_mulVec, ← Matrix.star_eq_conjTranspose,
    Matrix.mem_unitaryGroup_iff'.mp g.2, Matrix.one_mulVec, WithLp.toLp_ofLp]

theorem norm_smul' (g : Od d) (x : Ed d) : ‖g • x‖ = ‖x‖ := by
  rw [norm_eq_sqrt_real_inner, norm_eq_sqrt_real_inner, inner_smul]

/-- The rotation `g` as a linear isometry equivalence of `ℝ^d`. -/
noncomputable def iso (g : Od d) : Ed d ≃ₗᵢ[ℝ] Ed d :=
  LinearIsometry.toLinearIsometryEquiv
    ⟨Matrix.toEuclideanLin (g : Matrix (Fin d) (Fin d) ℝ), norm_smul' d g⟩ rfl

theorem iso_apply (g : Od d) (x : Ed d) : iso d g x = g • x := by
  rw [iso, LinearIsometry.coe_toLinearIsometryEquiv]; rfl

/-! ### Transitivity on the unit sphere -/

theorem transitive {x₀ : Ed d} (h₀ : ‖x₀‖ = 1) (x : Ed d) (hx : ‖x‖ = 1) :
    x ∈ MulAction.orbit (Od d) x₀ := by
  obtain ⟨L, hL⟩ := exists_isometry_map_eq h₀ hx
  let b := EuclideanSpace.basisFun (Fin d) ℝ
  refine ⟨⟨LinearMap.toMatrix b.toBasis b.toBasis L.toLinearEquiv,
    L.toMatrix_mem_unitaryGroup b b⟩, ?_⟩
  show Matrix.toEuclideanLin (LinearMap.toMatrix b.toBasis b.toBasis L.toLinearEquiv) x₀ = x
  rw [Matrix.toEuclideanLin_eq_toLin, ← EuclideanSpace.basisFun_toBasis, Matrix.toLin_toMatrix]
  exact hL

/-! ### The identification -/

/-- **Proposition 1 at `O(d)`, in full.**  The law of `g • x₀` for `g` Haar-distributed on
`O(d)` and `x₀` a unit vector is the uniform law on the sphere. -/
theorem orbitLaw_haar (x₀ : Ed d) (h₀ : ‖x₀‖ = 1) :
    orbitLaw (haarOd d) x₀ = sphereUniformAmbient (Ed d) := by
  haveI : Nontrivial (Ed d) := ⟨⟨x₀, 0, by rintro rfl; simp at h₀⟩⟩
  exact orbitLaw_eq_sphereUniformAmbient (ι := iso d) (fun g x => iso_apply d g x) (haarOd d)
    (fun x hx => transitive d h₀ x hx)

end Orthogonal
/-! ## §24  Proposition 2 as the paper states it, and a witness in every dimension

`integral_norm_resid_sq_paper` is Proposition 2 with nothing abstract left: Haar rotations on
`O(d)`, a scalar codebook applied coordinate-wise, and `ρ²` the quadrature `d·E_{f_d}[(t−q t)²]`
over the spherical marginal of Lemma 1.  Every hypothesis is about the inputs.

`exists_rotationStream_Od` shows the `RotationStream` bundle is satisfiable at `O(d)` for every
`d`: an i.i.d. Haar stream from `Measure.exists_iid`, the halving stage `x ↦ x/2`, and a unit
base point discharge every field.  `exists_witness_decay_Od` reads `err(P) = (1/2)^P` off the
general theorem, with `ρ² = 1/4` computed against the uniform law.  §12's `d = 1` witness is
now the special case it always was. -/

section Halving
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The halving stage in any space: `q(x) = x/2`, never exact on a nonzero residual. -/
noncomputable def halfE (x : E) : E := (2 : ℝ)⁻¹ • x

theorem norm_sub_halfE (u : E) : ‖u - halfE u‖ = ‖u‖ / 2 := by
  have : u - halfE u = (2 : ℝ)⁻¹ • u := by
    rw [halfE, sub_eq_iff_eq_add, ← add_smul]; norm_num
  rw [this, norm_smul, norm_inv, Real.norm_ofNat, div_eq_inv_mul]

theorem norm_resid_halfE (rot : ℕ → (E ≃ₗᵢ[ℝ] E)) {w : E} (hw : w ≠ 0) (p : ℕ) :
    ‖resid ⟨rot, halfE⟩ w p‖ = ‖w‖ / 2 ^ p := by
  induction p with
  | zero => simp
  | succ p ih =>
      have hpos : (0 : ℝ) < ‖w‖ / 2 ^ p := by
        have := norm_pos_iff.mpr hw
        positivity
      have hne : resid ⟨rot, halfE⟩ w p ≠ 0 := by
        rw [← norm_ne_zero_iff, ih]
        exact ne_of_gt hpos
      rw [norm_resid_succ]
      have hq : (⟨rot, halfE⟩ : Scheme E).q = halfE := rfl
      rw [hq, norm_sub_halfE, norm_unitVec _ _ _ hne, ih]
      ring

theorem resid_halfE_ne_zero (rot : ℕ → (E ≃ₗᵢ[ℝ] E)) {w : E} (hw : w ≠ 0) (p : ℕ) :
    resid ⟨rot, halfE⟩ w p ≠ 0 := by
  rw [← norm_ne_zero_iff, norm_resid_halfE rot hw p]
  have := norm_pos_iff.mpr hw
  positivity

theorem measurable_halfE [MeasurableSpace E] [BorelSpace E] : Measurable (halfE : E → E) :=
  (continuous_const_smul _).measurable

/-- The stage distortion of the halving stage against any probability law on the unit sphere
is exactly `1/4`. -/
theorem stageDistortion_halfE [MeasurableSpace E] {σ : Measure E} [IsProbabilityMeasure σ]
    (hσ : ∀ᵐ u ∂σ, ‖u‖ = 1) : stageDistortion halfE σ = 1 / 4 := by
  unfold stageDistortion
  have h : ∀ᵐ u ∂σ, ‖u - halfE u‖ ^ 2 = 1 / 4 := by
    filter_upwards [hσ] with u hu
    rw [norm_sub_halfE, hu]; norm_num
  rw [integral_congr_ae h, integral_const, probReal_univ, one_smul]

theorem integrable_halfE_err [MeasurableSpace E] [BorelSpace E] {σ : Measure E}
    [IsProbabilityMeasure σ] (hσ : ∀ᵐ u ∂σ, ‖u‖ = 1) :
    Integrable (fun u : E => ‖u - halfE u‖ ^ 2) σ := by
  have h : ∀ᵐ u ∂σ, ‖u - halfE u‖ ^ 2 = 1 / 4 := by
    filter_upwards [hσ] with u hu
    rw [norm_sub_halfE, hu]; norm_num
  exact (integrable_const (1 / 4 : ℝ)).congr (h.mono fun u hu => hu.symm)

end Halving

section PaperStatement
open Orthogonal

variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]

/-- **Proposition 2, exactly as the paper states it.**  Haar rotations on `O(d)`, a scalar
codebook `cb` applied coordinate-wise, and `ρ²` the quadrature `d·E_{f_d}[(t − cb t)²]` over the
spherical marginal: the expected squared residual after `P` passes is `ρ^{2P}` times the
expected squared weight.  Every hypothesis is about the inputs; nothing about any residual law
is assumed. -/
theorem integral_norm_resid_sq_paper {d : ℕ} (hd : 2 ≤ d) {cb : ℝ → ℝ} {W : Ω → Ed d}
    {R : Ω → ℕ → Od d} {x₀ : Ed d}
    (h : RotationStream (iso d) (blockStage cb) W R (haarOd d) x₀ μ) (hx₀ : ‖x₀‖ = 1)
    (hW : Integrable (fun ω => ‖W ω‖ ^ 2) μ)
    (hint : Integrable (fun t => (t - cb t) ^ 2) (sphericalCoordLaw d)) (P : ℕ) :
    ∫ ω, ‖resid (rotScheme (iso d) (blockStage cb) (R ω)) (W ω) P‖ ^ 2 ∂μ
      = rhoSq d cb (sphericalCoordLaw d) ^ P * ∫ ω, ‖W ω‖ ^ 2 ∂μ := by
  have hmarg : ∀ j : Fin d,
      (sphereUniformAmbient (Ed d)).map (fun v => v j) = sphericalCoordLaw d :=
    fun j => sphereUniformAmbient_map_coord hd j
  have hint' : Integrable (fun t : ℝ => ‖t - cb t‖ ^ 2) (sphericalCoordLaw d) := by
    simpa [Real.norm_eq_abs, sq_abs] using hint
  rw [integral_norm_resid_sq_uniform h hx₀ hW (integrable_blockStage_err cb hmarg hint') P,
    stageDistortion_blockStage_real cb hmarg hint]

end PaperStatement

section WitnessOd
open Orthogonal

variable (d : ℕ)

/-- **The hypotheses are satisfiable at `O(d)` for every `d`.**  An i.i.d. Haar rotation stream
on `O(d)` (from `Measure.exists_iid`), the halving stage, and a unit base point satisfy every
field of `RotationStream`.  This replaces §12's `d = 1` witness: the bundle is consistent in the
paper's own setting. -/
theorem exists_rotationStream_Od (x₀ : Ed d) (h₀ : ‖x₀‖ = 1) :
    ∃ (Ω : Type) (_ : MeasurableSpace Ω) (μ : Measure Ω) (R : Ω → ℕ → Od d),
      IsProbabilityMeasure μ ∧
        RotationStream (iso d) halfE (fun _ => x₀) R (haarOd d) x₀ μ := by
  obtain ⟨Ω, mΩ, P, X, hmeas, hlaw, hindep, hprob⟩ := ProbabilityTheory.exists_iid ℕ (haarOd d)
  refine ⟨Ω, mΩ, P, fun ω p => X p ω, hprob, ?_⟩
  have hx₀ : x₀ ≠ 0 := by rintro rfl; simp at h₀
  refine
    { implements := fun g x => iso_apply d g x
      meas_q := measurable_halfE
      meas_W := measurable_const
      meas_R := hmeas
      law_R := fun p => (hlaw p).map_eq
      fresh := ?_
      exact_never := fun p =>
        Filter.Eventually.of_forall fun ω => resid_halfE_ne_zero _ hx₀ p
      transitive := fun x hx => transitive d h₀ x hx }
  intro p
  have hdisj : Disjoint ({p} : Finset ℕ) (Finset.range p) := by
    simp [Finset.disjoint_singleton_left]
  have key := hindep.indepFun_finset ({p} : Finset ℕ) (Finset.range p) hdisj hmeas
  have hmemp : p ∈ ({p} : Finset ℕ) := Finset.mem_singleton_self p
  have hmemi : ∀ i : Fin p, (i : ℕ) ∈ Finset.range p := fun i => Finset.mem_range.mpr i.isLt
  have hφ : Measurable (fun v : (({p} : Finset ℕ) → Od d) => v ⟨p, hmemp⟩) :=
    measurable_pi_apply _
  have hψ : Measurable (fun v : (↥(Finset.range p) → Od d) =>
      (x₀, fun i : Fin p => v ⟨(i : ℕ), hmemi i⟩)) :=
    measurable_const.prodMk (measurable_pi_lambda _ fun _ => measurable_pi_apply _)
  exact key.comp hφ hψ

/-- **The witness, with its decay constant, in every dimension**: `err(P) = (1/2)^P`, read off
the general theorem with `ρ² = 1/4` computed against the uniform law. -/
theorem exists_witness_decay_Od (x₀ : Ed d) (h₀ : ‖x₀‖ = 1) :
    ∃ (Ω : Type) (_ : MeasurableSpace Ω) (μ : Measure Ω) (R : Ω → ℕ → Od d),
      IsProbabilityMeasure μ ∧
        RotationStream (iso d) halfE (fun _ => x₀) R (haarOd d) x₀ μ ∧
          ∀ P : ℕ,
            Real.sqrt (∫ ω, ‖resid (rotScheme (iso d) halfE (R ω)) x₀ P‖ ^ 2 ∂μ) / ‖x₀‖
              = (1 / 2 : ℝ) ^ P := by
  obtain ⟨Ω, mΩ, μ, R, hprob, hstream⟩ := exists_rotationStream_Od d x₀ h₀
  refine ⟨Ω, mΩ, μ, R, hprob, hstream, fun P => ?_⟩
  have hx₀ : x₀ ≠ 0 := by rintro rfl; simp at h₀
  haveI : Nontrivial (Ed d) := ⟨⟨x₀, 0, hx₀⟩⟩
  have hσ := sphereUniformAmbient_ae_norm (E := Ed d)
  have hint : Integrable (fun u : Ed d => ‖u - halfE u‖ ^ 2) (orbitLaw (haarOd d) x₀) := by
    rw [hstream.orbitLaw_eq h₀]; exact integrable_halfE_err hσ
  rw [rms_relative_error_rotationStream hx₀ hstream hint P, hstream.orbitLaw_eq h₀,
    stageDistortion_halfE hσ, show (1 / 4 : ℝ) = (1 / 2) ^ 2 by norm_num,
    Real.sqrt_sq (by norm_num)]

end WitnessOd
/-! ## §25  The concentration remark, reduced to the Poincaré inequality on the sphere

Header item 5 records that the `Var = O(1/d)` estimate behind the paper's Remark (Concentration)
was not formalised, and that the paper's own route to it, Dirichlet mixed moments and the
`O(1/d³)` covariances of the spherical marginal, is a computation specific to the scalar stage.
There is a better route.  For a nearest-codeword stage the per-pass ratio is
`F(u) = dist(u, C)²`, whose pointwise Lipschitz constant is `2 dist(u, C)`; the Poincaré
inequality on `S^{d−1}`, with the spectral-gap constant `1/(d−1)`, therefore gives
`Var F ≤ 4 ρ²/(d−1)` at once, for scalar, `E₈` and trellis stages alike.

This section takes that one inequality as a hypothesis, `SpherePoincare σ c`, in a two-point
Lipschitz form that needs no differentiability, and proves everything downstream of it: the
variance bound (`variance_stageErr_le`), its transport to the rotation stream through the
uniform law of §22 (`variance_stageErrSq_le`), and the concentration statement with its
constants (`meas_not_decayWithin_le_poincare`), feeding §13.  `SpherePoincare` is taken as a
hypothesis here; §26 derives it from the Gaussian inequality and §39 proves that
(`spherePoincare_sphereUniformAmbient`). -/

section PoincareForm

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]

/-- **The Poincaré inequality on the sphere, in the form the concentration remark needs.**
For a law `σ` and a constant `c`: whenever `F` satisfies the two-point Lipschitz bound
`|F x − F y| ≤ ‖x − y‖ (g x + g y)` with `g` continuous, so that the pointwise Lipschitz constant
of `F` is at most `2g`, the variance of `F` is at most `c ∫ (2g)²`.  For the uniform law on
`S^{d−1}` this holds with `c = 1/(d−1)`, the spectral gap of the sphere; it is the one classical
inequality this development takes as a hypothesis rather than proving. -/
structure SpherePoincare (σ : Measure E) (c : ℝ) : Prop where
  bound : ∀ (F g : E → ℝ), Continuous g →
    (∀ x y, |F x - F y| ≤ ‖x - y‖ * (g x + g y)) →
    MemLp F 2 σ → Integrable (fun x => g x ^ 2) σ →
    variance F σ ≤ c * ∫ x, (2 * g x) ^ 2 ∂σ

variable {C : Set E} {q : E → E}

/-- The two-point Lipschitz bound for the squared distance to a codebook, with slope function
`g = dist(·, C) = ‖x − q x‖`. -/
theorem abs_stageErr_sub_le (hq : IsNearest C q) (x y : E) :
    |‖x - q x‖ ^ 2 - ‖y - q y‖ ^ 2| ≤ ‖x - y‖ * (‖x - q x‖ + ‖y - q y‖) := by
  rw [norm_sub_eq_infDist hq, norm_sub_eq_infDist hq, sq_sub_sq, abs_mul,
    abs_of_nonneg (add_nonneg Metric.infDist_nonneg Metric.infDist_nonneg), mul_comm,
    add_comm (Metric.infDist x C)]
  refine mul_le_mul_of_nonneg_right ?_ (add_nonneg Metric.infDist_nonneg Metric.infDist_nonneg)
  have := (Metric.lipschitz_infDist_pt C).dist_le_mul x y
  rwa [Real.dist_eq, NNReal.coe_one, one_mul, dist_eq_norm] at this

theorem continuous_stageErrSlope (hq : IsNearest C q) : Continuous fun x => ‖x - q x‖ := by
  have : (fun x => ‖x - q x‖) = fun x => Metric.infDist x C := by
    funext x; exact norm_sub_eq_infDist hq x
  rw [this]; exact Metric.continuous_infDist_pt C

/-- **The variance bound.**  Under a law satisfying Poincaré with constant `c`, every
nearest-codeword stage has `Var ‖u − q u‖² ≤ 4 c ρ²`, with `ρ² = stageDistortion q σ`.  For the
uniform law and `c = 1/(d−1)` this is the `O(1/d)` the paper asserts, for scalar, `E₈` and
trellis stages alike, and with an explicit constant. -/
theorem variance_stageErr_le {σ : Measure E} [IsProbabilityMeasure σ] {c : ℝ}
    (hP : SpherePoincare σ c) (hq : IsNearest C q)
    (hmem : MemLp (fun x => ‖x - q x‖ ^ 2) 2 σ) :
    variance (fun x => ‖x - q x‖ ^ 2) σ ≤ 4 * c * stageDistortion q σ := by
  have h := hP.bound (fun x => ‖x - q x‖ ^ 2) (fun x => ‖x - q x‖) (continuous_stageErrSlope hq)
    (abs_stageErr_sub_le hq) hmem (hmem.integrable one_le_two)
  refine h.trans (le_of_eq ?_)
  have h4 : ∫ x, (2 * ‖x - q x‖) ^ 2 ∂σ = 4 * ∫ x, ‖x - q x‖ ^ 2 ∂σ := by
    rw [← integral_const_mul]
    exact integral_congr_ae (Filter.Eventually.of_forall fun x => by ring)
  rw [h4, stageDistortion]; ring

/-- A bounded codebook gives a bounded stage error on the sphere, hence one in every `L^p`. -/
theorem memLp_stageErr_of_bounded [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]
    (hq : IsNearest C q) (hC : Bornology.IsBounded C) (hmeas : Measurable q) :
    MemLp (fun x => ‖x - q x‖ ^ 2) 2 (sphereUniformAmbient E) := by
  obtain ⟨M, hM⟩ := hC.exists_norm_le
  refine (memLp_top_of_bound ((measurable_id.sub hmeas).norm.pow_const 2).aestronglyMeasurable
    ((1 + M) ^ 2) ?_).mono_exponent le_top
  filter_upwards [sphereUniformAmbient_ae_norm (E := E)] with x hx
  rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
  have : ‖x - q x‖ ≤ 1 + M :=
    (norm_sub_le _ _).trans (by rw [hx]; linarith [hM (q x) (hq x).1])
  exact pow_le_pow_left₀ (norm_nonneg _) this 2

end PoincareForm

section StreamConcentration

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E] [FiniteDimensional ℝ E]
variable {G : Type*} [Group G] [MeasurableSpace G] [MulAction G E] [MeasurableSMul₂ G E]
  [MeasurableInv G] [MeasurableMul G]
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
variable {ι : G → (E ≃ₗᵢ[ℝ] E)} {q : E → E} {W : Ω → E} {R : Ω → ℕ → G} {κ : Measure G}
  [κ.IsMulRightInvariant] {x₀ : E}

omit [FiniteDimensional ℝ E] [MeasurableMul G] [IsProbabilityMeasure μ]
  [κ.IsMulRightInvariant] in
theorem measurable_unitVec_stream (h : RotationStream ι q W R κ x₀ μ) (p : ℕ) :
    Measurable fun ω => unitVec (rotScheme ι q (R ω)) (W ω) p := by
  simp only [unitVec_rotScheme_eq_smul h.implements]
  exact (h.meas_R p).smul ((measurable_residDirPast h.meas_q p).comp
    (h.meas_W.prodMk (measurable_pi_lambda _ fun i => h.meas_R i)))

/-- The pass-`p` direction is a measure-preserving map onto the uniform law. -/
theorem measurePreserving_unitVec_stream (h : RotationStream ι q W R κ x₀ μ) (hx₀ : ‖x₀‖ = 1)
    (p : ℕ) :
    MeasurePreserving (fun ω => unitVec (rotScheme ι q (R ω)) (W ω) p) μ
      (sphereUniformAmbient E) :=
  ⟨measurable_unitVec_stream h p, law_unitVec_eq_sphereUniform h hx₀ p⟩

/-- **The per-pass variance bound on the stream**, transported from the uniform law. -/
theorem variance_stageErrSq_le (h : RotationStream ι q W R κ x₀ μ) (hx₀ : ‖x₀‖ = 1) {c : ℝ}
    (hP : SpherePoincare (sphereUniformAmbient E) c) {C : Set E} (hq : IsNearest C q)
    (hC : Bornology.IsBounded C) (p : ℕ) :
    variance (fun ω => stageErrSq (rotScheme ι q (R ω)) (W ω) p) μ
      ≤ 4 * c * stageDistortion q (sphereUniformAmbient E) := by
  haveI : Nontrivial E := ⟨⟨x₀, 0, by rintro rfl; simp at hx₀⟩⟩
  have hmp := measurePreserving_unitVec_stream h hx₀ p
  have hF : Measurable fun x : E => ‖x - q x‖ ^ 2 := (measurable_id.sub h.meas_q).norm.pow_const 2
  have heq : (fun ω => stageErrSq (rotScheme ι q (R ω)) (W ω) p)
      = (fun x : E => ‖x - q x‖ ^ 2) ∘ (fun ω => unitVec (rotScheme ι q (R ω)) (W ω) p) := rfl
  rw [heq, ← variance_map (by rw [hmp.map_eq]; exact hF.aemeasurable) hmp.measurable.aemeasurable,
    hmp.map_eq]
  exact variance_stageErr_le hP hq (memLp_stageErr_of_bounded hq hC h.meas_q)

/-- **Concentration of the decay law, with explicit constants.**  Under Poincaré with constant
`c` for the uniform law, a nearest-codeword stage with a bounded codebook, and `P` passes of a
rotation stream: the `P`-pass squared error lies within the compounded band `(1 ± ε)^P ρ^{2P}‖w‖²`
except on an event of probability at most `P · 4c / (ε² ρ²)`.  With `c = 1/(d−1)` this is the
paper's Remark (Concentration), with its rate `P/(d ε² ρ²)` made explicit, and it holds for
scalar, `E₈` and trellis stages alike. -/
theorem meas_not_decayWithin_le_poincare (h : RotationStream ι q W R κ x₀ μ) (hx₀ : ‖x₀‖ = 1)
    {c : ℝ} (hP : SpherePoincare (sphereUniformAmbient E) c) {C : Set E} (hq : IsNearest C q)
    (hC : Bornology.IsBounded C) {ε : ℝ} (hε0 : 0 < ε) (hε1 : ε ≤ 1)
    (hρ : 0 < stageDistortion q (sphereUniformAmbient E)) (P : ℕ) :
    μ {ω | ¬ DecayWithin (rotScheme ι q (R ω)) (W ω)
        (Real.sqrt (stageDistortion q (sphereUniformAmbient E))) ε P}
      ≤ P * ENNReal.ofReal (4 * c / (ε ^ 2 * stageDistortion q (sphereUniformAmbient E))) := by
  haveI : Nontrivial E := ⟨⟨x₀, 0, by rintro rfl; simp at hx₀⟩⟩
  set D := stageDistortion q (sphereUniformAmbient E) with hD
  have hρ2 : Real.sqrt D ^ 2 = D := Real.sq_sqrt hρ.le
  have hmem : ∀ p < P, MemLp (fun ω => stageErrSq (rotScheme ι q (R ω)) (W ω) p) 2 μ := fun p _ =>
    (memLp_stageErr_of_bounded hq hC h.meas_q).comp_measurePreserving
      (measurePreserving_unitVec_stream h hx₀ p)
  have hmean : ∀ p < P, ∫ ω, stageErrSq (rotScheme ι q (R ω)) (W ω) p ∂μ = Real.sqrt D ^ 2 := by
    intro p _
    rw [hρ2, hD, ← h.orbitLaw_eq hx₀]
    exact integral_stageErr_eq_stageDistortion h p
  have hvar : ∀ p < P, variance (fun ω => stageErrSq (rotScheme ι q (R ω)) (W ω) p) μ
      ≤ 4 * c * D := fun p _ => variance_stageErrSq_le h hx₀ hP hq hC p
  have hρne : Real.sqrt D ≠ 0 := (Real.sqrt_pos.mpr hρ).ne'
  have key := meas_not_decayWithin_le_of_variance hε0 hε1 hρne hmem hmean hvar
  have hD0 : D ≠ 0 := hρ.ne'
  have hε : ε ≠ 0 := hε0.ne'
  have hconst : 4 * c * D / (ε * Real.sqrt D ^ 2) ^ 2 = 4 * c / (ε ^ 2 * D) := by
    rw [hρ2]; field_simp
  rw [← hconst]; exact key

end StreamConcentration
/-! ## §26  Sphere Poincaré from Gaussian Poincaré

§25 takes the Poincaré inequality on the sphere, `SpherePoincare`, as a hypothesis.  This
section derives it, with constant `4/(d − 2)`, from the Poincaré inequality for the standard
Gaussian measure, stated as `GaussPoincare` in the same two-point Lipschitz form.  The mechanism
is the classical one: a function `F` of the direction is the `0`-homogeneous function
`f = F ∘ dir` of a Gaussian vector `Z`, whose slope at `z` is the sphere slope at `z/‖z‖` divided
by `‖z‖` (`norm_dir_sub_dir_le`), and `E[1/‖Z‖²] = 1/(d − 2)` because the direction of `Z` is
uniform and independent of the radius, whose law has the radial density `r^{d−1} e^{−r²/2}`.

Everything is proved with the polar machinery of §19: the Gaussian measure `gaussianE E` is
`e^{−‖x‖²/2} dx` normalised, its direction is uniform (`gaussianE_map_dir`), the weighted
integral `E[ψ(Z/‖Z‖)/‖Z‖²]` factorises (`lintegral_gaussianE_dir_div_normSq`), and the radial
integrals satisfy `R_{n+2} = (n+1) R_n` by integration by parts on `(0, ∞)`
(`radGauss_succ_succ`).  `GaussPoincare` is taken as a hypothesis here and proved in §39
(`gaussPoincare_gaussianE`).  With it, `meas_not_decayWithin_le_gauss` is the concentration
remark at rate `16 P/((d − 2) ε² ρ²)`. -/

open Filter
open scoped Topology

section RadialGauss

/-- The radial Gaussian integral `R_n = ∫₀^∞ rⁿ e^{−r²/2} dr`. -/
noncomputable def radGauss (n : ℕ) : ℝ :=
  ∫ r in Set.Ioi (0 : ℝ), r ^ n * Real.exp (-(r ^ 2) / 2)

theorem integrableOn_radGauss (n : ℕ) :
    IntegrableOn (fun r : ℝ => r ^ n * Real.exp (-(r ^ 2) / 2)) (Set.Ioi 0) := by
  have h := integrableOn_rpow_mul_exp_neg_mul_sq (b := (1 / 2 : ℝ)) (by norm_num) (s := n)
    (neg_one_lt_zero.trans_le (Nat.cast_nonneg n))
  refine h.congr_fun (fun r hr => ?_) measurableSet_Ioi
  show r ^ (n : ℝ) * Real.exp (-(1 / 2) * r ^ 2) = r ^ n * Real.exp (-(r ^ 2) / 2)
  rw [Real.rpow_natCast]
  congr 2
  ring

theorem radGauss_pos (n : ℕ) : 0 < radGauss n := by
  unfold radGauss
  rw [setIntegral_pos_iff_support_of_nonneg_ae]
  · have hsupp : (Function.support fun r : ℝ => r ^ n * Real.exp (-(r ^ 2) / 2)) ∩ Set.Ioi 0
        = Set.Ioi 0 := by
      ext r
      simp only [Set.mem_inter_iff, Function.mem_support, Set.mem_Ioi, ne_eq, mul_eq_zero,
        pow_eq_zero_iff', Real.exp_ne_zero, or_false, not_and, Decidable.not_not]
      constructor
      · exact fun h => h.2
      · intro hr; exact ⟨fun h => absurd h hr.ne', hr⟩
    rw [hsupp]; simp
  · exact (ae_restrict_mem measurableSet_Ioi).mono fun r hr =>
      mul_nonneg (pow_nonneg hr.le n) (Real.exp_pos _).le
  · exact integrableOn_radGauss n

/-- `rⁿ⁺¹ e^{−r²/2} → 0` at infinity. -/
theorem tendsto_pow_mul_exp_neg_sq (n : ℕ) :
    Tendsto (fun r : ℝ => r ^ n * Real.exp (-(r ^ 2) / 2)) atTop (𝓝 0) := by
  have h := Real.tendsto_pow_mul_exp_neg_atTop_nhds_zero n
  refine squeeze_zero' ((eventually_ge_atTop 0).mono fun r hr => ?_)
    ((eventually_ge_atTop 2).mono fun r hr => ?_) h
  · exact mul_nonneg (pow_nonneg hr n) (Real.exp_pos _).le
  · exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (by nlinarith)) (pow_nonneg (by linarith) n)

/-- **The recursion `R_{n+2} = (n+1) R_n`**, by integration by parts on `(0, ∞)`. -/
theorem radGauss_succ_succ (n : ℕ) : radGauss (n + 2) = (n + 1) * radGauss n := by
  unfold radGauss
  have hu : ∀ r ∈ Set.Ioi (0 : ℝ), HasDerivAt (fun r : ℝ => r ^ (n + 1)) ((n + 1 : ℝ) * r ^ n) r := by
    intro r _
    simpa [Nat.cast_succ] using hasDerivAt_pow (n + 1) r
  have hv : ∀ r ∈ Set.Ioi (0 : ℝ), HasDerivAt (fun r : ℝ => -Real.exp (-(r ^ 2) / 2))
      (r * Real.exp (-(r ^ 2) / 2)) r := by
    intro r _
    have := (((hasDerivAt_pow 2 r).neg.div_const 2).exp).neg
    refine this.congr_deriv ?_
    norm_num <;> ring
  have h1 : IntegrableOn ((fun r : ℝ => r ^ (n + 1)) * fun r => r * Real.exp (-(r ^ 2) / 2))
      (Set.Ioi 0) :=
    (integrableOn_radGauss (n + 2)).congr_fun (fun r _ => by simp only [Pi.mul_apply]; ring)
      measurableSet_Ioi
  have h2 : IntegrableOn ((fun r : ℝ => (n + 1 : ℝ) * r ^ n) * fun r => -Real.exp (-(r ^ 2) / 2))
      (Set.Ioi 0) :=
    IntegrableOn.congr_fun (Integrable.const_mul (integrableOn_radGauss n) (-(n + 1 : ℝ)))
      (fun r _ => by simp only [Pi.mul_apply]; ring) measurableSet_Ioi
  have h0 : Tendsto ((fun r : ℝ => r ^ (n + 1)) * fun r => -Real.exp (-(r ^ 2) / 2)) (𝓝[>] 0)
      (𝓝 0) := by
    have hc : Continuous ((fun r : ℝ => r ^ (n + 1)) * fun r => -Real.exp (-(r ^ 2) / 2)) := by
      fun_prop
    have := (hc.tendsto 0).mono_left (nhdsWithin_le_nhds (s := Set.Ioi (0 : ℝ)))
    simpa using this
  have hinf : Tendsto ((fun r : ℝ => r ^ (n + 1)) * fun r => -Real.exp (-(r ^ 2) / 2)) atTop
      (𝓝 0) := by
    have := (tendsto_pow_mul_exp_neg_sq (n + 1)).neg
    rw [neg_zero] at this
    refine this.congr fun r => ?_
    simp only [Pi.mul_apply]; ring
  have key := integral_Ioi_mul_deriv_eq_deriv_mul hu hv h1 h2 h0 hinf
  rw [sub_zero, zero_sub] at key
  have hl : ∫ r in Set.Ioi (0 : ℝ), r ^ (n + 1) * (r * Real.exp (-(r ^ 2) / 2))
      = ∫ r in Set.Ioi (0 : ℝ), r ^ (n + 2) * Real.exp (-(r ^ 2) / 2) :=
    setIntegral_congr_fun measurableSet_Ioi fun r _ => by ring
  have hr : ∫ r in Set.Ioi (0 : ℝ), (n + 1 : ℝ) * r ^ n * -Real.exp (-(r ^ 2) / 2)
      = -((n + 1 : ℝ) * ∫ r in Set.Ioi (0 : ℝ), r ^ n * Real.exp (-(r ^ 2) / 2)) := by
    rw [← integral_const_mul, ← integral_neg]
    exact setIntegral_congr_fun measurableSet_Ioi fun r _ => by ring
  rw [hl, hr, neg_neg] at key
  exact key

end RadialGauss

section Direction

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- `‖z/‖z‖ − w/‖w‖‖ ≤ 2‖z − w‖/‖z‖` for `z ≠ 0`. -/
theorem norm_dir_sub_dir_le {z w : E} (hz : z ≠ 0) :
    ‖‖z‖⁻¹ • z - ‖w‖⁻¹ • w‖ ≤ 2 * ‖z - w‖ / ‖z‖ := by
  have hz' : 0 < ‖z‖ := norm_pos_iff.mpr hz
  have h1 : ‖‖z‖⁻¹ • z - ‖w‖⁻¹ • w‖ ≤ ‖‖z‖⁻¹ • z - ‖z‖⁻¹ • w‖ + ‖‖z‖⁻¹ • w - ‖w‖⁻¹ • w‖ :=
    norm_sub_le_norm_sub_add_norm_sub _ _ _
  have h2 : ‖‖z‖⁻¹ • z - ‖z‖⁻¹ • w‖ = ‖z - w‖ / ‖z‖ := by
    rw [← smul_sub, norm_smul, norm_inv, norm_norm, div_eq_inv_mul]
  have h3 : ‖‖z‖⁻¹ • w - ‖w‖⁻¹ • w‖ ≤ ‖z - w‖ / ‖z‖ := by
    rcases eq_or_ne w 0 with hw | hw
    · simp [hw]; positivity
    · have hw' : 0 < ‖w‖ := norm_pos_iff.mpr hw
      rw [← sub_smul, norm_smul, Real.norm_eq_abs]
      have hrew : |‖z‖⁻¹ - ‖w‖⁻¹| * ‖w‖ = |‖w‖ - ‖z‖| / ‖z‖ := by
        rw [show ‖z‖⁻¹ - ‖w‖⁻¹ = (‖w‖ - ‖z‖) / (‖z‖ * ‖w‖) by field_simp, abs_div,
          abs_of_pos (mul_pos hz' hw')]
        field_simp
      rw [hrew]
      gcongr
      rw [abs_sub_comm]
      exact abs_norm_sub_norm_le z w
  calc ‖‖z‖⁻¹ • z - ‖w‖⁻¹ • w‖
      ≤ ‖‖z‖⁻¹ • z - ‖z‖⁻¹ • w‖ + ‖‖z‖⁻¹ • w - ‖w‖⁻¹ • w‖ := h1
    _ ≤ ‖z - w‖ / ‖z‖ + ‖z - w‖ / ‖z‖ := add_le_add h2.le h3
    _ = 2 * ‖z - w‖ / ‖z‖ := by ring

end Direction


section GaussianMeasure

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

/-- The unnormalised Gaussian density `e^{−‖x‖²/2}`. -/
noncomputable def gaussDensity (x : E) : ℝ≥0∞ := ENNReal.ofReal (Real.exp (-(‖x‖ ^ 2) / 2))

theorem measurable_gaussDensity : Measurable (gaussDensity : E → ℝ≥0∞) := by
  unfold gaussDensity; fun_prop

/-- The unnormalised Gaussian measure `e^{−‖x‖²/2} dx`. -/
noncomputable def gaussRaw (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [MeasurableSpace E] [BorelSpace E] [FiniteDimensional ℝ E] : Measure E :=
  volume.withDensity gaussDensity

/-- The direction map `x ↦ x/‖x‖` (sending `0` to `0`). -/
noncomputable def dir (x : E) : E := ‖x‖⁻¹ • x

theorem measurable_dir : Measurable (dir : E → E) := by unfold dir; fun_prop

/-- The radial integral in `lintegral` form. -/
theorem lintegral_radial (n : ℕ) :
    ∫⁻ r in Set.Ioi (0 : ℝ), ENNReal.ofReal (r ^ n) * ENNReal.ofReal (Real.exp (-(r ^ 2) / 2))
      = ENNReal.ofReal (radGauss n) := by
  rw [radGauss, ofReal_integral_eq_lintegral_ofReal (integrableOn_radGauss n)
    ((ae_restrict_mem measurableSet_Ioi).mono fun r hr =>
      mul_nonneg (pow_nonneg hr.le n) (Real.exp_pos _).le)]
  refine setLIntegral_congr_fun measurableSet_Ioi fun r hr => ?_
  rw [ENNReal.ofReal_mul (pow_nonneg hr.le n)]

/-- **Polar form of Gaussian integrals**: a function of the direction times a function of the
radius integrates to a product. -/
theorem lintegral_gaussRaw_polar {ψ : E → ℝ≥0∞} (hψ : Measurable ψ) {φ : ℝ → ℝ≥0∞}
    (hφ : Measurable φ) :
    ∫⁻ x, ψ (dir x) * φ ‖x‖ ∂(gaussRaw E)
      = (∫⁻ u : sphere (0 : E) 1, ψ u ∂volume.toSphere) *
          ∫⁻ r in Set.Ioi (0 : ℝ), ENNReal.ofReal (r ^ (Module.finrank ℝ E - 1)) *
            (φ r * ENNReal.ofReal (Real.exp (-(r ^ 2) / 2))) := by
  have hF : Measurable fun x : E => gaussDensity x * (ψ (dir x) * φ ‖x‖) :=
    measurable_gaussDensity.mul ((hψ.comp measurable_dir).mul (hφ.comp measurable_norm))
  rw [gaussRaw, lintegral_withDensity_eq_lintegral_mul _ measurable_gaussDensity
    (g := fun x : E => ψ (dir x) * φ ‖x‖) (by exact (hψ.comp measurable_dir).mul (hφ.comp measurable_norm))]
  simp only [Pi.mul_apply]
  rw [lintegral_eq_polar _ hF, ← lintegral_mul_const _ (by fun_prop)]
  refine lintegral_congr fun u => ?_
  rw [← lintegral_const_mul _ (by fun_prop)]
  refine setLIntegral_congr_fun measurableSet_Ioi fun r hr => ?_
  have hu : ‖(u : E)‖ = 1 := mem_sphere_zero_iff_norm.mp u.2
  have hn : ‖r • (u : E)‖ = r := by
    rw [norm_smul, hu, mul_one, Real.norm_eq_abs, abs_of_pos hr]
  rw [gaussDensity, dir, hn, inv_smul_smul₀ hr.ne']
  ring

/-- The total mass of the unnormalised Gaussian: `σ(S) · R_{d−1}`. -/
theorem gaussRaw_univ :
    gaussRaw E Set.univ = volume.toSphere (Set.univ : Set (sphere (0 : E) 1)) *
      ENNReal.ofReal (radGauss (Module.finrank ℝ E - 1)) := by
  have h := lintegral_gaussRaw_polar (E := E) (ψ := fun _ => 1) measurable_const
    (φ := fun _ => 1) measurable_const
  simp only [one_mul, mul_one] at h
  rw [lintegral_one, lintegral_one] at h
  rw [h, lintegral_radial]

theorem gaussRaw_univ_ne_zero : gaussRaw E Set.univ ≠ 0 := by
  rw [gaussRaw_univ]
  exact mul_ne_zero (toSphere_univ_ne_zero E) (by simp [radGauss_pos])

theorem gaussRaw_univ_ne_top : gaussRaw E Set.univ ≠ ⊤ := by
  rw [gaussRaw_univ]
  exact ENNReal.mul_ne_top (measure_ne_top _ _) ENNReal.ofReal_ne_top

/-- The standard Gaussian probability measure on `E`. -/
noncomputable def gaussianE (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [MeasurableSpace E] [BorelSpace E] [FiniteDimensional ℝ E] : Measure E :=
  (gaussRaw E Set.univ)⁻¹ • gaussRaw E

instance : IsProbabilityMeasure (gaussianE E) := by
  constructor
  rw [gaussianE, Measure.smul_apply, smul_eq_mul,
    ENNReal.inv_mul_cancel gaussRaw_univ_ne_zero gaussRaw_univ_ne_top]

/-- **The direction of a Gaussian vector is uniform on the sphere.** -/
theorem gaussianE_map_dir : (gaussianE E).map dir = sphereUniformAmbient E := by
  ext s hs
  have hψ : Measurable (s.indicator (1 : E → ℝ≥0∞)) := measurable_const.indicator hs
  have hL : gaussRaw E (dir ⁻¹' s)
      = ∫⁻ x, s.indicator (1 : E → ℝ≥0∞) (dir x) * (fun _ : ℝ => (1 : ℝ≥0∞)) ‖x‖
          ∂(gaussRaw E) := by
    rw [← lintegral_indicator_one (measurable_dir hs)]
    refine lintegral_congr fun x => ?_
    by_cases h : dir x ∈ s
    · simp [Set.indicator_apply, Set.mem_preimage, h]
    · simp [Set.indicator_apply, Set.mem_preimage, h]
  have hR : (sphereUniformAmbient E) s
      = (volume.toSphere (Set.univ : Set (sphere (0 : E) 1)))⁻¹ *
          ∫⁻ u : sphere (0 : E) 1, s.indicator (1 : E → ℝ≥0∞) u ∂volume.toSphere := by
    have hind : ∫⁻ u : sphere (0 : E) 1, (Subtype.val ⁻¹' s).indicator (1 : sphere (0 : E) 1 → ℝ≥0∞) u
        ∂volume.toSphere
        = ∫⁻ u : sphere (0 : E) 1, s.indicator (1 : E → ℝ≥0∞) u ∂volume.toSphere := by
      refine lintegral_congr fun u => ?_
      by_cases h : (u : E) ∈ s
      · simp [Set.indicator_apply, Set.mem_preimage, h]
      · simp [Set.indicator_apply, Set.mem_preimage, h]
    rw [sphereUniformAmbient, Measure.map_apply measurable_subtype_coe hs, sphereUniform,
      Measure.smul_apply, smul_eq_mul, ← lintegral_indicator_one (measurable_subtype_coe hs), hind]
  rw [Measure.map_apply measurable_dir hs, gaussianE, Measure.smul_apply, smul_eq_mul, hL,
    lintegral_gaussRaw_polar hψ measurable_const, hR, gaussRaw_univ]
  simp only [one_mul]
  rw [lintegral_radial]
  set A := volume.toSphere (Set.univ : Set (sphere (0 : E) 1))
  set B := ENNReal.ofReal (radGauss (Module.finrank ℝ E - 1))
  set I := ∫⁻ u : sphere (0 : E) 1, s.indicator (1 : E → ℝ≥0∞) u ∂volume.toSphere
  have hB0 : B ≠ 0 := by simp [B, radGauss_pos]
  have hBt : B ≠ ⊤ := ENNReal.ofReal_ne_top
  have hA0 : A ≠ 0 := toSphere_univ_ne_zero E
  have hAt : A ≠ ⊤ := measure_ne_top _ _
  rw [ENNReal.mul_inv (Or.inl hA0) (Or.inl hAt)]
  calc A⁻¹ * B⁻¹ * (I * B) = A⁻¹ * I * (B⁻¹ * B) := by ring
    _ = A⁻¹ * I := by rw [ENNReal.inv_mul_cancel hB0 hBt, mul_one]

theorem measurePreserving_dir : MeasurePreserving (dir : E → E) (gaussianE E) (sphereUniformAmbient E) :=
  ⟨measurable_dir, gaussianE_map_dir⟩

/-- **`E[ψ(Z/‖Z‖) / ‖Z‖²] = E_σ[ψ] / (d − 2)`** for a Gaussian `Z` in dimension `d ≥ 3`. -/
theorem lintegral_gaussianE_dir_div_normSq (hd : 3 ≤ Module.finrank ℝ E) {ψ : E → ℝ≥0∞}
    (hψ : Measurable ψ) :
    ∫⁻ x, ψ (dir x) * ENNReal.ofReal ((‖x‖ ^ 2)⁻¹) ∂(gaussianE E)
      = (∫⁻ u, ψ u ∂(sphereUniformAmbient E)) *
          ENNReal.ofReal (1 / ((Module.finrank ℝ E : ℝ) - 2)) := by
  set d := Module.finrank ℝ E with hd_def
  have hφ : Measurable fun r : ℝ => ENNReal.ofReal ((r ^ 2)⁻¹) := by fun_prop
  have hrad : ∫⁻ r in Set.Ioi (0 : ℝ), ENNReal.ofReal (r ^ (d - 1)) *
      (ENNReal.ofReal ((r ^ 2)⁻¹) * ENNReal.ofReal (Real.exp (-(r ^ 2) / 2)))
      = ENNReal.ofReal (radGauss (d - 3)) := by
    rw [← lintegral_radial]
    refine setLIntegral_congr_fun measurableSet_Ioi fun r hr => ?_
    rw [← mul_assoc, ← ENNReal.ofReal_mul (pow_nonneg hr.le _)]
    congr 2
    have : d - 1 = (d - 3) + 2 := by omega
    rw [this, pow_add, mul_assoc, mul_inv_cancel₀ (pow_ne_zero 2 hr.ne'), mul_one]
  have hrec : radGauss (d - 1) = ((d : ℝ) - 2) * radGauss (d - 3) := by
    have h := radGauss_succ_succ (d - 3)
    rw [show d - 3 + 2 = d - 1 by omega] at h
    rw [h]
    congr 1
    rw [Nat.cast_sub (by omega)]
    push_cast
    ring
  have hL : ∫⁻ x, ψ (dir x) * ENNReal.ofReal ((‖x‖ ^ 2)⁻¹) ∂(gaussianE E)
      = (gaussRaw E Set.univ)⁻¹ *
          ((∫⁻ u : sphere (0 : E) 1, ψ u ∂volume.toSphere) * ENNReal.ofReal (radGauss (d - 3))) := by
    rw [gaussianE, lintegral_smul_measure, smul_eq_mul, lintegral_gaussRaw_polar hψ hφ, hrad]
  have hR : ∫⁻ u, ψ u ∂(sphereUniformAmbient E)
      = (volume.toSphere (Set.univ : Set (sphere (0 : E) 1)))⁻¹ *
          ∫⁻ u : sphere (0 : E) 1, ψ u ∂volume.toSphere := by
    rw [sphereUniformAmbient, lintegral_map hψ measurable_subtype_coe, sphereUniform,
      lintegral_smul_measure, smul_eq_mul]
  rw [hL, hR, gaussRaw_univ, hrec]
  set A := volume.toSphere (Set.univ : Set (sphere (0 : E) 1))
  set I := ∫⁻ u : sphere (0 : E) 1, ψ u ∂volume.toSphere
  set R := radGauss (d - 3)
  have hd2 : (0 : ℝ) < (d : ℝ) - 2 := by
    have : (3 : ℝ) ≤ d := by exact_mod_cast hd
    linarith
  have hR0 : 0 < R := radGauss_pos _
  have hA0 : A ≠ 0 := toSphere_univ_ne_zero E
  have hAt : A ≠ ⊤ := measure_ne_top _ _
  have hB : ENNReal.ofReal (((d : ℝ) - 2) * R) = ENNReal.ofReal ((d : ℝ) - 2) * ENNReal.ofReal R :=
    ENNReal.ofReal_mul hd2.le
  have hB0 : ENNReal.ofReal (((d : ℝ) - 2) * R) ≠ 0 := by
    simp [mul_pos hd2 hR0]
  have hBt : ENNReal.ofReal (((d : ℝ) - 2) * R) ≠ ⊤ := ENNReal.ofReal_ne_top
  have hinv : ENNReal.ofReal (1 / ((d : ℝ) - 2)) = (ENNReal.ofReal ((d : ℝ) - 2))⁻¹ := by
    rw [one_div, ENNReal.ofReal_inv_of_pos hd2]
  rw [ENNReal.mul_inv (Or.inl hA0) (Or.inl hAt), hinv, hB,
    ENNReal.mul_inv (Or.inl (ENNReal.ofReal_pos.mpr hd2).ne') (Or.inl ENNReal.ofReal_ne_top)]
  have hR0' : ENNReal.ofReal R ≠ 0 := by simp [hR0]
  calc A⁻¹ * ((ENNReal.ofReal ((d : ℝ) - 2))⁻¹ * (ENNReal.ofReal R)⁻¹) * (I * ENNReal.ofReal R)
      = A⁻¹ * I * (ENNReal.ofReal ((d : ℝ) - 2))⁻¹ * ((ENNReal.ofReal R)⁻¹ * ENNReal.ofReal R) := by
        ring
    _ = A⁻¹ * I * (ENNReal.ofReal ((d : ℝ) - 2))⁻¹ := by
        rw [ENNReal.inv_mul_cancel hR0' ENNReal.ofReal_ne_top, mul_one]

end GaussianMeasure

section GaussianCoordinates

open Orthogonal

/-- **A coordinate of the direction of a Gaussian vector has the spherical coordinate law.**
Composes `gaussianE_map_dir`, that the direction `dir Z` of a Gaussian vector `Z` is uniform on
the sphere, with `sphereUniformAmbient_map_coord`, that a coordinate of the uniform direction has
law `sphericalCoordLaw d` (§22): the pushforward of `gaussianE (Ed d)` along `x ↦ (dir x).ofLp i`
is `sphericalCoordLaw d`, for every coordinate `i` and every `d ≥ 2`.  This says nothing about the
radius `‖Z‖`; it is used only to divide by it. -/
theorem gaussianE_map_dir_coord {d : ℕ} (hd : 2 ≤ d) (i : Fin d) :
    (gaussianE (Ed d)).map (fun x => (dir x).ofLp i) = sphericalCoordLaw d := by
  haveI : Nontrivial (Ed d) := Module.nontrivial_of_finrank_pos (R := ℝ) (by
    have : (0 : ℕ) < d := by omega
    simpa [Ed] using this)
  have hmeas : Measurable (fun v : Ed d => v.ofLp i) :=
    (measurable_pi_apply i).comp (WithLp.measurable_ofLp 2 _)
  have h1 : (fun x : Ed d => (dir x).ofLp i) = (fun v : Ed d => v.ofLp i) ∘ dir := rfl
  rw [h1, ← Measure.map_map hmeas measurable_dir, gaussianE_map_dir]
  exact sphereUniformAmbient_map_coord hd i

end GaussianCoordinates

section GaussianPoincare

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E]

/-- **The Gaussian Poincaré inequality**, in the two-point Lipschitz form and with the origin
removed: for `f` with `|f x − f y| ≤ ‖x − y‖ (G x + G y)` off the origin and `G` continuous off
the origin (so that the pointwise Lipschitz constant of `f` is at most `2G` almost everywhere),
`Var_γ f ≤ ∫ (2G)² dγ`.  This is the classical inequality with constant `1` for the standard
Gaussian measure; the dimension restriction `d ≥ 2` is needed because a point has positive
capacity in dimension one. -/
structure GaussPoincare (γ : Measure E) : Prop where
  bound : 2 ≤ Module.finrank ℝ E → ∀ (f G : E → ℝ), ContinuousOn G {x | x ≠ 0} →
    (∀ x y, x ≠ 0 → y ≠ 0 → |f x - f y| ≤ ‖x - y‖ * (G x + G y)) →
    MemLp f 2 γ → Integrable (fun x => G x ^ 2) γ →
    variance f γ ≤ ∫ x, (2 * G x) ^ 2 ∂γ

theorem continuousOn_dir : ContinuousOn (dir : E → E) {x | x ≠ 0} := by
  unfold dir
  exact (continuous_norm.continuousOn.inv₀ fun x hx => norm_ne_zero_iff.mpr hx).smul
    continuousOn_id

/-- **Sphere Poincaré from Gaussian Poincaré.**  If the standard Gaussian on `E` satisfies the
Poincaré inequality, the uniform law on the sphere satisfies it with constant `4/(d − 2)`: a
function of the direction is a `0`-homogeneous function of the Gaussian vector, its slope is the
sphere slope divided by the radius, and `E[1/‖Z‖²] = 1/(d − 2)`. -/
theorem spherePoincare_of_gaussPoincare (hd : 3 ≤ Module.finrank ℝ E)
    (hG : GaussPoincare (gaussianE E)) :
    SpherePoincare (sphereUniformAmbient E) (4 / ((Module.finrank ℝ E : ℝ) - 2)) := by
  haveI : Nontrivial E := Module.nontrivial_of_finrank_pos (R := ℝ) (by omega)
  constructor
  intro F g hg hFg hF hg2
  set d := Module.finrank ℝ E with hd_def
  have hd2 : (0 : ℝ) < (d : ℝ) - 2 := by
    have : (3 : ℝ) ≤ d := by exact_mod_cast hd
    linarith
  -- pass to `|g|`
  set g' : E → ℝ := fun x => |g x| with hg'
  have hg'c : Continuous g' := hg.abs
  have hFg' : ∀ x y, |F x - F y| ≤ ‖x - y‖ * (g' x + g' y) := fun x y =>
    (hFg x y).trans (mul_le_mul_of_nonneg_left (add_le_add (le_abs_self _) (le_abs_self _))
      (norm_nonneg _))
  have hg2' : Integrable (fun x => g' x ^ 2) (sphereUniformAmbient E) := by
    simpa [g', sq_abs] using hg2
  have hsq : ∀ x, (2 * g x) ^ 2 = (2 * g' x) ^ 2 := fun x => by simp [g', mul_pow, sq_abs]
  -- the Gaussian lift
  set f : E → ℝ := F ∘ dir with hf
  set G : E → ℝ := fun z => 2 * g' (dir z) / ‖z‖ with hGdef
  have hdir := measurePreserving_dir (E := E)
  have htwo : ∀ z w : E, z ≠ 0 → w ≠ 0 → |f z - f w| ≤ ‖z - w‖ * (G z + G w) := by
    intro z w hz hw
    have hz' : 0 < ‖z‖ := norm_pos_iff.mpr hz
    have hw' : 0 < ‖w‖ := norm_pos_iff.mpr hw
    have h1 := hFg' (dir z) (dir w)
    have hzw : ‖dir z - dir w‖ ≤ 2 * ‖z - w‖ / ‖z‖ := norm_dir_sub_dir_le hz
    have hwz : ‖dir z - dir w‖ ≤ 2 * ‖z - w‖ / ‖w‖ :=
      calc ‖dir z - dir w‖ = ‖dir w - dir z‖ := norm_sub_rev _ _
        _ ≤ 2 * ‖w - z‖ / ‖w‖ := norm_dir_sub_dir_le hw
        _ = 2 * ‖z - w‖ / ‖w‖ := by rw [norm_sub_rev]
    have hg'z : 0 ≤ g' (dir z) := abs_nonneg _
    have hg'w : 0 ≤ g' (dir w) := abs_nonneg _
    calc |f z - f w| = |F (dir z) - F (dir w)| := rfl
      _ ≤ ‖dir z - dir w‖ * (g' (dir z) + g' (dir w)) := h1
      _ = ‖dir z - dir w‖ * g' (dir z) + ‖dir z - dir w‖ * g' (dir w) := by ring
      _ ≤ (2 * ‖z - w‖ / ‖z‖) * g' (dir z) + (2 * ‖z - w‖ / ‖w‖) * g' (dir w) :=
          add_le_add (mul_le_mul_of_nonneg_right hzw hg'z) (mul_le_mul_of_nonneg_right hwz hg'w)
      _ = ‖z - w‖ * (G z + G w) := by
          simp only [G]; field_simp
  have hGcont : ContinuousOn G {x | x ≠ 0} := by
    refine ContinuousOn.div (continuousOn_const.mul (hg'c.comp_continuousOn continuousOn_dir))
      continuous_norm.continuousOn fun x hx => norm_ne_zero_iff.mpr hx
  have hfmem : MemLp f 2 (gaussianE E) := hF.comp_measurePreserving hdir
  -- the Gaussian integral of `G²`, via the polar formula
  have hψ : Measurable fun x : E => ENNReal.ofReal (4 * g' x ^ 2) := by
    exact ENNReal.measurable_ofReal.comp (by fun_prop)
  have hG2 : ∀ z : E, ENNReal.ofReal (G z ^ 2)
      = ENNReal.ofReal (4 * g' (dir z) ^ 2) * ENNReal.ofReal ((‖z‖ ^ 2)⁻¹) := by
    intro z
    rw [← ENNReal.ofReal_mul (by positivity)]
    congr 1
    simp only [G]
    rw [div_pow, mul_pow, div_eq_mul_inv]
    ring
  have hlint : ∫⁻ z, ENNReal.ofReal (G z ^ 2) ∂(gaussianE E)
      = ENNReal.ofReal (∫ x, 4 * g' x ^ 2 ∂(sphereUniformAmbient E)) *
          ENNReal.ofReal (1 / ((d : ℝ) - 2)) := by
    simp_rw [hG2]
    rw [lintegral_gaussianE_dir_div_normSq hd hψ,
      ← ofReal_integral_eq_lintegral_ofReal (hg2'.const_mul 4)
        (Filter.Eventually.of_forall fun x => by positivity)]
  have hGmeas : Measurable G := by
    simp only [G]
    exact ((measurable_const.mul (hg'c.measurable.comp measurable_dir)).div measurable_norm)
  have hG2int : Integrable (fun z => G z ^ 2) (gaussianE E) := by
    refine ⟨(hGmeas.pow_const 2).aestronglyMeasurable, ?_⟩
    rw [hasFiniteIntegral_iff_ofReal (Filter.Eventually.of_forall fun z => sq_nonneg _), hlint]
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top ENNReal.ofReal_lt_top
  have hint : ∫ z, (2 * G z) ^ 2 ∂(gaussianE E)
      = 4 / ((d : ℝ) - 2) * ∫ x, (2 * g' x) ^ 2 ∂(sphereUniformAmbient E) := by
    have h1 : ∫ z, (2 * G z) ^ 2 ∂(gaussianE E) = 4 * ∫ z, G z ^ 2 ∂(gaussianE E) := by
      rw [← integral_const_mul]
      exact integral_congr_ae (Filter.Eventually.of_forall fun z => by ring)
    have h2 : ∫ z, G z ^ 2 ∂(gaussianE E)
        = (∫ x, 4 * g' x ^ 2 ∂(sphereUniformAmbient E)) * (1 / ((d : ℝ) - 2)) := by
      rw [integral_eq_lintegral_of_nonneg_ae (Filter.Eventually.of_forall fun z => sq_nonneg _)
        (hGmeas.pow_const 2).aestronglyMeasurable, hlint, ← ENNReal.ofReal_mul
        (integral_nonneg fun x => by positivity), ENNReal.toReal_ofReal
        (mul_nonneg (integral_nonneg fun x => by positivity) (by positivity))]
    have h3 : ∫ x, (2 * g' x) ^ 2 ∂(sphereUniformAmbient E)
        = ∫ x, 4 * g' x ^ 2 ∂(sphereUniformAmbient E) :=
      integral_congr_ae (Filter.Eventually.of_forall fun x => by ring)
    rw [h1, h2, h3]; ring
  have hvar : variance F (sphereUniformAmbient E) = variance f (gaussianE E) := by
    rw [← hdir.map_eq, variance_map (by rw [hdir.map_eq]; exact hF.aestronglyMeasurable.aemeasurable)
      measurable_dir.aemeasurable]
  have key := hG.bound (by omega) f G hGcont htwo hfmem hG2int
  rw [hvar]
  simp_rw [hsq]
  rw [← hint]
  exact key

end GaussianPoincare

section GaussianConcentration

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E] [FiniteDimensional ℝ E]
variable {G : Type*} [Group G] [MeasurableSpace G] [MulAction G E] [MeasurableSMul₂ G E]
  [MeasurableInv G] [MeasurableMul G]
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
variable {ι : G → (E ≃ₗᵢ[ℝ] E)} {q : E → E} {W : Ω → E} {R : Ω → ℕ → G} {κ : Measure G}
  [κ.IsMulRightInvariant] {x₀ : E}

/-- **Concentration of the decay law under the Gaussian Poincaré inequality.**  The `P`-pass
squared error lies within the compounded band `(1 ± ε)^P ρ^{2P}‖w‖²` except with probability at
most `16 P / ((d − 2) ε² ρ²)`. -/
theorem meas_not_decayWithin_le_gauss (hd : 3 ≤ Module.finrank ℝ E)
    (hG : GaussPoincare (gaussianE E)) (h : RotationStream ι q W R κ x₀ μ) (hx₀ : ‖x₀‖ = 1)
    {C : Set E} (hq : IsNearest C q) (hC : Bornology.IsBounded C) {ε : ℝ} (hε0 : 0 < ε)
    (hε1 : ε ≤ 1) (hρ : 0 < stageDistortion q (sphereUniformAmbient E)) (P : ℕ) :
    μ {ω | ¬ DecayWithin (rotScheme ι q (R ω)) (W ω)
        (Real.sqrt (stageDistortion q (sphereUniformAmbient E))) ε P}
      ≤ P * ENNReal.ofReal (16 / (((Module.finrank ℝ E : ℝ) - 2) * ε ^ 2 *
          stageDistortion q (sphereUniformAmbient E))) := by
  have key := meas_not_decayWithin_le_poincare h hx₀ (spherePoincare_of_gaussPoincare hd hG)
    hq hC hε0 hε1 hρ P
  have hd2 : ((Module.finrank ℝ E : ℝ) - 2) ≠ 0 := by
    have : (3 : ℝ) ≤ Module.finrank ℝ E := by exact_mod_cast hd
    linarith
  have hD : stageDistortion q (sphereUniformAmbient E) ≠ 0 := hρ.ne'
  have hε : ε ≠ 0 := hε0.ne'
  have heq : 4 * (4 / ((Module.finrank ℝ E : ℝ) - 2)) /
      (ε ^ 2 * stageDistortion q (sphereUniformAmbient E))
      = 16 / (((Module.finrank ℝ E : ℝ) - 2) * ε ^ 2 * stageDistortion q (sphereUniformAmbient E)) := by
    field_simp; ring
  rw [← heq]; exact key

end GaussianConcentration
/-! ## §27  Gaussian invariance, moments, and the variance identity

Groundwork for proving the Poincaré inequality of §26 outright, for the one function the paper
needs.  The Gaussian measure is invariant under linear isometries (`gaussianE_map_isometry`),
its second moments are `E‖Z‖² = d` and `E⟨Z, v⟩² = ‖v‖²` (`lintegral_normSq_gaussianE`,
`lintegral_inner_sq_gaussianE`), and the product of two copies is the Gaussian measure of the
`ℓ²` product (`gaussianE_prod_map_ofLp`), so the rotation
`(x, y) ↦ (cos θ·x + sin θ·y, −sin θ·x + cos θ·y)` preserves `γ ⊗ γ` (`rotMap`, `inner_rotMap`).
The variance identity `Var f = ½ E(f(X) − f(Y))²` for independent copies
(`variance_eq_half_integral_prod`) and the pointwise derivative bound from a two-point Lipschitz
inequality (`norm_fderiv_le_of_twoPoint`) complete the toolkit. -/

open Metric
open scoped InnerProductSpace

section GaussianInvariance

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

theorem gaussDensity_isometry (L : E ≃ₗᵢ[ℝ] E) (x : E) : gaussDensity (L x) = gaussDensity x := by
  simp [gaussDensity, L.norm_map]

/-- The unnormalised Gaussian is invariant under linear isometries. -/
theorem gaussRaw_map_isometry (L : E ≃ₗᵢ[ℝ] E) : (gaussRaw E).map L = gaussRaw E := by
  ext s hs
  rw [Measure.map_apply L.continuous.measurable hs, gaussRaw,
    withDensity_apply _ (L.continuous.measurable hs), withDensity_apply _ hs,
    ← L.measurePreserving.setLIntegral_comp_preimage_emb L.toHomeomorph.measurableEmbedding
      gaussDensity s]
  exact setLIntegral_congr_fun (L.continuous.measurable hs) fun x _ =>
    (gaussDensity_isometry L x).symm

/-- **The Gaussian measure is invariant under linear isometries.** -/
theorem gaussianE_map_isometry (L : E ≃ₗᵢ[ℝ] E) : (gaussianE E).map L = gaussianE E := by
  rw [gaussianE, Measure.map_smul, gaussRaw_map_isometry]

theorem measurePreserving_isometry_gaussianE (L : E ≃ₗᵢ[ℝ] E) :
    MeasurePreserving L (gaussianE E) (gaussianE E) :=
  ⟨L.continuous.measurable, gaussianE_map_isometry L⟩

end GaussianInvariance

section GaussianMoments

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

/-- `E‖Z‖² = d` for the standard Gaussian, from the radial recursion. -/
theorem lintegral_normSq_gaussianE :
    ∫⁻ x, ENNReal.ofReal (‖x‖ ^ 2) ∂(gaussianE E) = (Module.finrank ℝ E : ℝ≥0∞) := by
  set d := Module.finrank ℝ E with hd_def
  have hd : 1 ≤ d := Module.finrank_pos
  have hφ : Measurable fun r : ℝ => ENNReal.ofReal (r ^ 2) := by fun_prop
  have h := lintegral_gaussRaw_polar (E := E) (ψ := fun _ => 1) measurable_const hφ
  simp only [one_mul] at h
  rw [lintegral_one] at h
  have hrad : ∫⁻ r in Set.Ioi (0 : ℝ), ENNReal.ofReal (r ^ (d - 1)) *
      (ENNReal.ofReal (r ^ 2) * ENNReal.ofReal (Real.exp (-(r ^ 2) / 2)))
      = ENNReal.ofReal (radGauss (d + 1)) := by
    rw [← lintegral_radial]
    refine setLIntegral_congr_fun measurableSet_Ioi fun r hr => ?_
    rw [← mul_assoc, ← ENNReal.ofReal_mul (pow_nonneg hr.le _), ← pow_add]
    congr 3
    omega
  have hrec : radGauss (d + 1) = (d : ℝ) * radGauss (d - 1) := by
    have h2 := radGauss_succ_succ (d - 1)
    rw [show d - 1 + 2 = d + 1 by omega] at h2
    rw [h2, Nat.cast_sub hd, Nat.cast_one]
    ring
  rw [gaussianE, lintegral_smul_measure, smul_eq_mul, h, hrad, hrec, gaussRaw_univ,
    ENNReal.ofReal_mul (Nat.cast_nonneg d), ENNReal.ofReal_natCast]
  set A := volume.toSphere (Set.univ : Set (sphere (0 : E) 1))
  set B := ENNReal.ofReal (radGauss (d - 1))
  have hA0 : A ≠ 0 := toSphere_univ_ne_zero E
  have hAt : A ≠ ⊤ := measure_ne_top _ _
  have hB0 : B ≠ 0 := by simp [B, radGauss_pos]
  have hBt : B ≠ ⊤ := ENNReal.ofReal_ne_top
  rw [ENNReal.mul_inv (Or.inl hA0) (Or.inl hAt)]
  calc A⁻¹ * B⁻¹ * (A * ((d : ℝ≥0∞) * B)) = (d : ℝ≥0∞) * ((A⁻¹ * A) * (B⁻¹ * B)) := by ring
    _ = (d : ℝ≥0∞) := by
      rw [ENNReal.inv_mul_cancel hA0 hAt, ENNReal.inv_mul_cancel hB0 hBt, mul_one, mul_one]

end GaussianMoments


section GaussianMoments2

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

theorem integrable_sq_sphericalCoordLaw {d : ℕ} (hd : 2 ≤ d) :
    Integrable (fun t : ℝ => t ^ 2) (sphericalCoordLaw d) := by
  haveI := isProbabilityMeasure_sphericalCoordLaw hd
  have hsupp : ∀ᵐ t ∂(sphericalCoordLaw d), t ∈ Set.Icc (-1 : ℝ) 1 :=
    (withDensity_absolutelyContinuous _ _).ae_le (ae_restrict_mem measurableSet_Icc)
  refine (MemLp.of_bound (by fun_prop : Measurable fun t : ℝ => t ^ 2).aestronglyMeasurable 1
    (hsupp.mono fun t ht => ?_)).integrable le_rfl
  rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg t)]
  nlinarith [ht.1, ht.2]

/-- `E⟨v, u⟩² = ‖v‖²/d` for `u` uniform on the sphere. -/
theorem lintegral_inner_sq_sphereUniform (hd : 2 ≤ Module.finrank ℝ E) (v : E) :
    ∫⁻ u, ENNReal.ofReal (⟪v, u⟫_ℝ ^ 2) ∂(sphereUniformAmbient E)
      = ENNReal.ofReal (‖v‖ ^ 2 / Module.finrank ℝ E) := by
  rcases eq_or_ne v 0 with rfl | hv
  · simp
  have hv' : 0 < ‖v‖ := norm_pos_iff.mpr hv
  set e : E := ‖v‖⁻¹ • v with he
  have hen : ‖e‖ = 1 := by
    rw [he, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hv'.ne']
  have hinner : ∀ u : E, ⟪v, u⟫_ℝ = ‖v‖ * ⟪e, u⟫_ℝ := by
    intro u
    rw [he, real_inner_smul_left, ← mul_assoc, mul_inv_cancel₀ hv'.ne', one_mul]
  have hlaw := sphereUniformAmbient_map_inner hd hen
  have hmeas : Measurable fun x : E => ⟪e, x⟫_ℝ := (continuous_const.inner continuous_id).measurable
  have h1 : ∫⁻ u, ENNReal.ofReal (⟪e, u⟫_ℝ ^ 2) ∂(sphereUniformAmbient E)
      = ENNReal.ofReal (1 / Module.finrank ℝ E) := by
    rw [← lintegral_map (f := fun t : ℝ => ENNReal.ofReal (t ^ 2)) (by fun_prop) hmeas, hlaw,
      ← ofReal_integral_eq_lintegral_ofReal (integrable_sq_sphericalCoordLaw hd)
        (Filter.Eventually.of_forall fun t => sq_nonneg t), integral_sq_sphericalCoordLaw hd]
  simp_rw [hinner, mul_pow, ENNReal.ofReal_mul (sq_nonneg _)]
  rw [lintegral_const_mul _ (by fun_prop), h1, ← ENNReal.ofReal_mul (sq_nonneg _)]
  congr 1; ring

/-- **`E⟨v, Z⟩² = ‖v‖²`** for the standard Gaussian. -/
theorem lintegral_inner_sq_gaussianE (hd : 2 ≤ Module.finrank ℝ E) (v : E) :
    ∫⁻ x, ENNReal.ofReal (⟪v, x⟫_ℝ ^ 2) ∂(gaussianE E) = ENNReal.ofReal (‖v‖ ^ 2) := by
  set d := Module.finrank ℝ E with hd_def
  have hφ : Measurable fun r : ℝ => ENNReal.ofReal (r ^ 2) := by fun_prop
  have hψ : Measurable fun u : E => ENNReal.ofReal (⟪v, u⟫_ℝ ^ 2) := by fun_prop
  have hpt : ∀ x : E, ENNReal.ofReal (⟪v, x⟫_ℝ ^ 2)
      = ENNReal.ofReal (⟪v, dir x⟫_ℝ ^ 2) * ENNReal.ofReal (‖x‖ ^ 2) := by
    intro x
    rcases eq_or_ne x 0 with rfl | hx
    · simp
    have hn : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr hx
    rw [← ENNReal.ofReal_mul (sq_nonneg _)]
    congr 1
    rw [dir, real_inner_smul_right, mul_pow, inv_pow]
    field_simp
  rw [lintegral_congr hpt]
  have h := lintegral_gaussRaw_polar (E := E) hψ hφ
  have hrad : ∫⁻ r in Set.Ioi (0 : ℝ), ENNReal.ofReal (r ^ (d - 1)) *
      (ENNReal.ofReal (r ^ 2) * ENNReal.ofReal (Real.exp (-(r ^ 2) / 2)))
      = ENNReal.ofReal (radGauss (d + 1)) := by
    rw [← lintegral_radial]
    refine setLIntegral_congr_fun measurableSet_Ioi fun r hr => ?_
    rw [← mul_assoc, ← ENNReal.ofReal_mul (pow_nonneg hr.le _), ← pow_add]
    congr 3
    have : 1 ≤ d := Module.finrank_pos
    omega
  have hrec : radGauss (d + 1) = (d : ℝ) * radGauss (d - 1) := by
    have hd1 : 1 ≤ d := Module.finrank_pos
    have h2 := radGauss_succ_succ (d - 1)
    rw [show d - 1 + 2 = d + 1 by omega] at h2
    rw [h2, Nat.cast_sub hd1, Nat.cast_one]
    ring
  have hsph := lintegral_inner_sq_sphereUniform hd v
  rw [sphereUniformAmbient, lintegral_map hψ measurable_subtype_coe, sphereUniform,
    lintegral_smul_measure, smul_eq_mul] at hsph
  rw [gaussianE, lintegral_smul_measure, smul_eq_mul, h, hrad, hrec, gaussRaw_univ,
    ENNReal.ofReal_mul (Nat.cast_nonneg d), ENNReal.ofReal_natCast]
  set A := volume.toSphere (Set.univ : Set (sphere (0 : E) 1))
  set B := ENNReal.ofReal (radGauss (d - 1))
  set I := ∫⁻ u : sphere (0 : E) 1, ENNReal.ofReal (⟪v, (u : E)⟫_ℝ ^ 2) ∂volume.toSphere
  have hA0 : A ≠ 0 := toSphere_univ_ne_zero E
  have hAt : A ≠ ⊤ := measure_ne_top _ _
  have hB0 : B ≠ 0 := by simp [B, radGauss_pos]
  have hBt : B ≠ ⊤ := ENNReal.ofReal_ne_top
  have hdpos : (0 : ℝ) < d := by exact_mod_cast (show 0 < d by omega)
  rw [ENNReal.mul_inv (Or.inl hA0) (Or.inl hAt)]
  calc A⁻¹ * B⁻¹ * (I * ((d : ℝ≥0∞) * B)) = (A⁻¹ * I) * (d : ℝ≥0∞) * (B⁻¹ * B) := by ring
    _ = ENNReal.ofReal (‖v‖ ^ 2 / d) * (d : ℝ≥0∞) := by
        rw [ENNReal.inv_mul_cancel hB0 hBt, mul_one, hsph]
    _ = ENNReal.ofReal (‖v‖ ^ 2) := by
        rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (by positivity)]
        congr 1
        field_simp

end GaussianMoments2

section GaussianProd

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

instance : IsFiniteMeasure (gaussRaw E) := ⟨lt_top_iff_ne_top.mpr gaussRaw_univ_ne_top⟩

theorem gaussDensity_toLp (x y : E) :
    gaussDensity (WithLp.toLp 2 (x, y) : WithLp 2 (E × E)) = gaussDensity x * gaussDensity y := by
  simp only [gaussDensity]
  rw [← ENNReal.ofReal_mul (Real.exp_pos _).le, ← Real.exp_add, WithLp.prod_norm_sq_eq_of_L2]
  congr 2
  simp only [WithLp.fst, WithLp.snd]
  ring

/-- The unnormalised Gaussian on `E × E` is the product of the unnormalised Gaussians. -/
theorem gaussRaw_prod_map_ofLp :
    (gaussRaw (WithLp 2 (E × E))).map WithLp.ofLp = (gaussRaw E).prod (gaussRaw E) := by
  refine (Measure.prod_eq fun s t hs ht => ?_).symm
  rw [Measure.map_apply (WithLp.measurable_ofLp 2 _) (hs.prod ht), gaussRaw,
    withDensity_apply _ ((WithLp.measurable_ofLp 2 _) (hs.prod ht))]
  have hemb : MeasurableEmbedding (WithLp.ofLp : WithLp 2 (E × E) → E × E) :=
    (MeasurableEquiv.toLp 2 (E × E)).symm.measurableEmbedding
  have hpt : ∀ z : WithLp 2 (E × E), gaussDensity z
      = (fun p : E × E => gaussDensity p.1 * gaussDensity p.2) (WithLp.ofLp z) := by
    intro z
    have := gaussDensity_toLp (WithLp.ofLp z).1 (WithLp.ofLp z).2
    rwa [Prod.mk.eta, WithLp.toLp_ofLp] at this
  have hkey := (WithLp.volume_preserving_ofLp E E).setLIntegral_comp_preimage_emb hemb
    (fun p : E × E => gaussDensity p.1 * gaussDensity p.2) (s ×ˢ t)
  rw [setLIntegral_congr_fun ((WithLp.measurable_ofLp 2 _) (hs.prod ht)) (fun z _ => hpt z), hkey,
    volume_eq_prod, ← Measure.prod_restrict, lintegral_prod_mul measurable_gaussDensity.aemeasurable
      measurable_gaussDensity.aemeasurable, gaussRaw, withDensity_apply _ hs,
    withDensity_apply _ ht]

theorem gaussRaw_prod_univ :
    gaussRaw (WithLp 2 (E × E)) Set.univ = gaussRaw E Set.univ * gaussRaw E Set.univ := by
  have h : (gaussRaw (WithLp 2 (E × E))).map WithLp.ofLp Set.univ
      = (gaussRaw E).prod (gaussRaw E) Set.univ := by rw [gaussRaw_prod_map_ofLp]
  rw [Measure.map_apply (WithLp.measurable_ofLp 2 _) MeasurableSet.univ, Set.preimage_univ,
    ← Set.univ_prod_univ, Measure.prod_prod] at h
  exact h

/-- **The Gaussian pair is a product.** -/
theorem gaussianE_prod_map_ofLp :
    (gaussianE (WithLp 2 (E × E))).map WithLp.ofLp = (gaussianE E).prod (gaussianE E) := by
  rw [gaussianE, gaussianE, Measure.map_smul, gaussRaw_prod_map_ofLp, gaussRaw_prod_univ,
    Measure.prod_smul_left, Measure.prod_smul_right, smul_smul,
    ENNReal.mul_inv (Or.inl gaussRaw_univ_ne_zero) (Or.inl gaussRaw_univ_ne_top)]

end GaussianProd

section VarianceIdentity

variable {X : Type*} [MeasurableSpace X]

/-- `Var f = ½ ∬ (f x − f y)² dμ dμ` for a probability measure `μ`. -/
theorem variance_eq_half_integral_prod {μ : Measure X} [IsProbabilityMeasure μ] {f : X → ℝ}
    (hf : MemLp f 2 μ) :
    variance f μ = (1 / 2) * ∫ p : X × X, (f p.1 - f p.2) ^ 2 ∂(μ.prod μ) := by
  have hf1 : Integrable f μ := hf.integrable one_le_two
  have hf2 : Integrable (fun x => f x ^ 2) μ := hf.integrable_sq
  have h1 : ∫ p : X × X, (f p.1 - f p.2) ^ 2 ∂(μ.prod μ)
      = ∫ p : X × X, (f p.1 ^ 2 * (1 : ℝ) + (1 : ℝ) * f p.2 ^ 2 - 2 * (f p.1 * f p.2))
          ∂(μ.prod μ) :=
    integral_congr_ae (Filter.Eventually.of_forall fun p => by ring)
  have hA : ∫ a : X × X, f a.1 ^ 2 * (1 : ℝ) ∂(μ.prod μ)
      = (∫ x, f x ^ 2 ∂μ) * ∫ _y, (1 : ℝ) ∂μ := integral_prod_mul (fun x => f x ^ 2) (fun _ => (1 : ℝ))
  have hB : ∫ a : X × X, (1 : ℝ) * f a.2 ^ 2 ∂(μ.prod μ)
      = (∫ _x, (1 : ℝ) ∂μ) * ∫ y, f y ^ 2 ∂μ := integral_prod_mul (fun _ => (1 : ℝ)) (fun y => f y ^ 2)
  have hC : ∫ a : X × X, f a.1 * f a.2 ∂(μ.prod μ) = (∫ x, f x ∂μ) * ∫ y, f y ∂μ :=
    integral_prod_mul f f
  rw [h1, integral_sub, integral_add, hA, hB, integral_const_mul, hC, variance_eq_sub hf]
  · simp; ring
  · exact hf2.mul_prod (integrable_const (μ := μ) (1 : ℝ))
  · exact (integrable_const (μ := μ) (1 : ℝ)).mul_prod hf2
  · exact (hf2.mul_prod (integrable_const (μ := μ) (1 : ℝ))).add ((integrable_const (μ := μ) (1 : ℝ)).mul_prod hf2)
  · exact (hf1.mul_prod hf1).const_mul 2

end VarianceIdentity

section RotationPair

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]

/-- The rotation of a pair by angle `θ`, as a linear map on `E × E` with the `ℓ²` norm:
`(x, y) ↦ (cos θ · x + sin θ · y, −sin θ · x + cos θ · y)`. -/
noncomputable def rotMap (θ : ℝ) : WithLp 2 (E × E) →ₗ[ℝ] WithLp 2 (E × E) :=
  (WithLp.linearEquiv 2 ℝ (E × E)).symm.toLinearMap ∘ₗ
    (LinearMap.prod (Real.cos θ • LinearMap.fst ℝ E E + Real.sin θ • LinearMap.snd ℝ E E)
      (-Real.sin θ • LinearMap.fst ℝ E E + Real.cos θ • LinearMap.snd ℝ E E)) ∘ₗ
    (WithLp.linearEquiv 2 ℝ (E × E)).toLinearMap

theorem rotMap_apply (θ : ℝ) (p : WithLp 2 (E × E)) :
    rotMap θ p = WithLp.toLp 2 (Real.cos θ • p.fst + Real.sin θ • p.snd,
      -Real.sin θ • p.fst + Real.cos θ • p.snd) := rfl

theorem inner_rotMap (θ : ℝ) (p q : WithLp 2 (E × E)) : ⟪rotMap θ p, rotMap θ q⟫_ℝ = ⟪p, q⟫_ℝ := by
  rw [rotMap_apply, rotMap_apply, WithLp.prod_inner_apply, WithLp.prod_inner_apply]
  simp only [WithLp.fst, WithLp.snd, WithLp.ofLp_toLp, inner_add_left, inner_add_right,
    real_inner_smul_left, real_inner_smul_right, neg_smul, inner_neg_left, inner_neg_right]
  linear_combination (⟪p.ofLp.1, q.ofLp.1⟫_ℝ + ⟪p.ofLp.2, q.ofLp.2⟫_ℝ) * Real.cos_sq_add_sin_sq θ

/-- The pair rotation as a linear isometry equivalence. -/
noncomputable def rotPair (θ : ℝ) : WithLp 2 (E × E) ≃ₗᵢ[ℝ] WithLp 2 (E × E) :=
  LinearIsometry.toLinearIsometryEquiv
    ⟨rotMap θ, fun p => by rw [norm_eq_sqrt_real_inner, norm_eq_sqrt_real_inner, inner_rotMap]⟩ rfl

theorem rotPair_apply (θ : ℝ) (p : WithLp 2 (E × E)) : rotPair θ p = rotMap θ p := by
  rw [rotPair, LinearIsometry.coe_toLinearIsometryEquiv]; rfl

end RotationPair

section DerivBound

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- A two-point Lipschitz bound with continuous slope function `G` bounds the derivative:
`‖f'(x)‖ ≤ 2 G x`. -/
theorem norm_fderiv_le_of_twoPoint {f G : E → ℝ} {x : E} (hx : x ≠ 0) (hG : ContinuousAt G x)
    (hGnn : 0 ≤ G x)
    (htwo : ∀ z w, z ≠ 0 → w ≠ 0 → |f z - f w| ≤ ‖z - w‖ * (G z + G w))
    {f' : E →L[ℝ] ℝ} (hf : HasFDerivAt f f' x) : ‖f'‖ ≤ 2 * G x := by
  refine le_of_forall_pos_le_add fun ε hε => ?_
  have hG' : ∀ᶠ z in 𝓝 x, G z < G x + ε / 2 := hG (Iio_mem_nhds (by linarith))
  have hne : ∀ᶠ z in 𝓝 x, z ≠ 0 := isOpen_ne.mem_nhds hx
  obtain ⟨s, hs, hsG⟩ := (hG'.and hne).exists_mem
  have hK : 0 ≤ 2 * G x + ε := by linarith
  have hlip : LipschitzOnWith ⟨2 * G x + ε, hK⟩ f s := by
    refine LipschitzOnWith.of_dist_le_mul fun z hz w hw => ?_
    rw [Real.dist_eq, dist_eq_norm]
    calc |f z - f w| ≤ ‖z - w‖ * (G z + G w) := htwo z w (hsG z hz).2 (hsG w hw).2
      _ ≤ ‖z - w‖ * (2 * G x + ε) := by
          have h1 := (hsG z hz).1; have h2 := (hsG w hw).1
          exact mul_le_mul_of_nonneg_left (by linarith) (norm_nonneg _)
      _ = ((⟨2 * G x + ε, hK⟩ : NNReal) : ℝ) * ‖z - w‖ := by simp [mul_comm]
  have := hf.le_of_lipschitzOn hs hlip
  calc ‖f'‖ ≤ ((⟨2 * G x + ε, hK⟩ : NNReal) : ℝ) := this
    _ = 2 * G x + ε := rfl

end DerivBound
/-! ## §28  Right derivatives of finite minima

The squared distance to a finite codebook is a minimum of finitely many smooth functions, so it
is not differentiable but has a right derivative everywhere, equal to the derivative of an
active branch (`exists_hasDerivWithinAt_finset_inf'`).  The fundamental theorem of calculus for
right derivatives (`intervalIntegral.integral_eq_sub_of_hasDeriv_right_of_le`) then gives the
path formula `g(b) − g(a) = ∫ₐᵇ g'₊` (`finset_inf'_sub_eq_integral`). -/

section MinDeriv

/-- The right derivative of a minimum of two right-differentiable functions at a tie point is
the minimum of the derivatives. -/
theorem hasDerivWithinAt_min_Ioi_of_eq {g₁ g₂ : ℝ → ℝ} {θ d₁ d₂ : ℝ}
    (h₁ : HasDerivWithinAt g₁ d₁ (Ioi θ) θ) (h₂ : HasDerivWithinAt g₂ d₂ (Ioi θ) θ)
    (htie : g₁ θ = g₂ θ) :
    HasDerivWithinAt (fun t => min (g₁ t) (g₂ t)) (min d₁ d₂) (Ioi θ) θ := by
  rw [hasDerivWithinAt_iff_tendsto_slope] at h₁ h₂ ⊢
  refine (h₁.min h₂).congr' ?_
  filter_upwards [self_mem_nhdsWithin] with t ht
  have hpos : 0 < t - θ := by
    have : t ∈ Ioi θ := ht.1
    exact sub_pos.mpr this
  simp only [slope_def_field]
  rw [min_def (g₁ θ) (g₂ θ), if_pos htie.le, min_div_div_right hpos.le, ← htie, min_sub_sub_right]

/-- If `g₁ θ < g₂ θ` and both are continuous from the right, the minimum agrees with `g₁` near
`θ` on the right. -/
theorem hasDerivWithinAt_min_Ioi_of_lt {g₁ g₂ : ℝ → ℝ} {θ d₁ d₂ : ℝ}
    (h₁ : HasDerivWithinAt g₁ d₁ (Ioi θ) θ) (h₂ : HasDerivWithinAt g₂ d₂ (Ioi θ) θ)
    (hlt : g₁ θ < g₂ θ) :
    HasDerivWithinAt (fun t => min (g₁ t) (g₂ t)) d₁ (Ioi θ) θ := by
  have hc : ∀ᶠ t in 𝓝[Ioi θ] θ, g₁ t < g₂ t :=
    (h₁.continuousWithinAt.eventually_lt h₂.continuousWithinAt hlt)
  refine h₁.congr_of_eventuallyEq ?_ (by simp [min_eq_left hlt.le])
  filter_upwards [hc] with t ht
  simp [min_eq_left ht.le]

/-- **Right derivative of a finite minimum.**  If each `φ i` has right derivative `φ' i` at `θ`,
the minimum over a nonempty finite set has a right derivative, equal to `φ' i` for some active
index `i` (one attaining the minimum at `θ`). -/
theorem exists_hasDerivWithinAt_finset_inf' {ι : Type*} {s : Finset ι}
    (hs : s.Nonempty) {φ : ι → ℝ → ℝ} {φ' : ι → ℝ} {θ : ℝ}
    (h : ∀ i ∈ s, HasDerivWithinAt (φ i) (φ' i) (Ioi θ) θ) :
    ∃ i ∈ s, φ i θ = s.inf' hs (fun j => φ j θ) ∧
      HasDerivWithinAt (fun t => s.inf' hs (fun j => φ j t)) (φ' i) (Ioi θ) θ := by
  revert h
  induction hs using Finset.Nonempty.cons_induction with
  | singleton a =>
      intro h
      refine ⟨a, Finset.mem_singleton_self a, by simp, ?_⟩
      simpa using h a (Finset.mem_singleton_self a)
  | cons a s ha hs' ih =>
      intro h
      obtain ⟨j, hj, hjeq, hjder⟩ := ih fun i hi => h i (Finset.mem_cons_of_mem hi)
      have hfun : (fun t => (Finset.cons a s ha).inf' ⟨a, Finset.mem_cons_self a s⟩ (fun k => φ k t))
          = fun t => min (φ a t) (s.inf' hs' (fun k => φ k t)) := by
        funext t; rw [Finset.inf'_cons hs']
      have ha' := h a (Finset.mem_cons_self a s)
      rw [hfun]
      rcases lt_trichotomy (φ a θ) (s.inf' hs' (fun k => φ k θ)) with hlt | heq | hgt
      · refine ⟨a, Finset.mem_cons_self a s, ?_, hasDerivWithinAt_min_Ioi_of_lt ha' hjder hlt⟩
        rw [Finset.inf'_cons hs', min_eq_left hlt.le]
      · -- tie: derivative is `min (φ' a) (φ' j)`, which is `φ' a` or `φ' j`
        have hmin := hasDerivWithinAt_min_Ioi_of_eq ha' hjder heq
        rcases le_total (φ' a) (φ' j) with hle | hle
        · refine ⟨a, Finset.mem_cons_self a s, ?_, by rwa [min_eq_left hle] at hmin⟩
          rw [Finset.inf'_cons hs', min_eq_left heq.le]
        · refine ⟨j, Finset.mem_cons_of_mem hj, ?_, by rwa [min_eq_right hle] at hmin⟩
          rw [Finset.inf'_cons hs', min_eq_right heq.ge, hjeq]
      · refine ⟨j, Finset.mem_cons_of_mem hj, ?_, ?_⟩
        · rw [Finset.inf'_cons hs', min_eq_right hgt.le, hjeq]
        · have := hasDerivWithinAt_min_Ioi_of_lt hjder ha' hgt
          exact this.congr_of_eventuallyEq (Filter.Eventually.of_forall fun t => min_comm _ _)
            (min_comm _ _)

/-- A finite minimum of continuous functions is continuous. -/
theorem continuous_finset_inf'_fun {ι : Type*} {s : Finset ι} (hs : s.Nonempty) {φ : ι → ℝ → ℝ}
    (h : ∀ i ∈ s, Continuous (φ i)) : Continuous fun t => s.inf' hs (fun i => φ i t) := by
  revert h
  induction hs using Finset.Nonempty.cons_induction with
  | singleton a => intro h; simpa using h a (Finset.mem_singleton_self a)
  | cons a s ha hs' ih =>
      intro h
      have hfun : (fun t => (Finset.cons a s ha).inf' ⟨a, Finset.mem_cons_self a s⟩ (fun k => φ k t))
          = fun t => min (φ a t) (s.inf' hs' (fun k => φ k t)) := by
        funext t; rw [Finset.inf'_cons hs']
      rw [hfun]
      exact (h a (Finset.mem_cons_self a s)).min (ih fun i hi => h i (Finset.mem_cons_of_mem hi))

/-- The right derivative of a finite minimum of differentiable functions, as a function:
`derivWithin g (Ioi t) t` equals `φ' i t` for some index `i` active at `t`. -/
theorem exists_derivWithin_Ioi_finset_inf' {ι : Type*} {s : Finset ι}
    (hs : s.Nonempty) {φ : ι → ℝ → ℝ} {φ' : ι → ℝ → ℝ}
    (hφ : ∀ i ∈ s, ∀ t, HasDerivAt (φ i) (φ' i t) t) (t : ℝ) :
    ∃ i ∈ s, φ i t = s.inf' hs (fun j => φ j t) ∧
      derivWithin (fun u => s.inf' hs (fun j => φ j u)) (Ioi t) t = φ' i t ∧
      HasDerivWithinAt (fun u => s.inf' hs (fun j => φ j u))
        (derivWithin (fun u => s.inf' hs (fun j => φ j u)) (Ioi t) t) (Ioi t) t := by
  obtain ⟨i, hi, heq, hder⟩ := exists_hasDerivWithinAt_finset_inf' hs
    (φ' := fun j => φ' j t) (θ := t) fun j hj => (hφ j hj t).hasDerivWithinAt
  have hd := hder.derivWithin (uniqueDiffWithinAt_Ioi t)
  exact ⟨i, hi, heq, hd, hd ▸ hder⟩

/-- **The path formula for a finite minimum of `C¹` functions**: `g b − g a = ∫ₐᵇ D` with `D`
the right derivative of `g`, and `|D t| ≤ ∑ᵢ |φ' i t|` pointwise. -/
theorem finset_inf'_sub_eq_integral {ι : Type*} {s : Finset ι} (hs : s.Nonempty)
    {φ : ι → ℝ → ℝ} {φ' : ι → ℝ → ℝ} {a b : ℝ} (hab : a ≤ b)
    (hφ : ∀ i ∈ s, ∀ t, HasDerivAt (φ i) (φ' i t) t) (hφ' : ∀ i ∈ s, Continuous (φ' i)) :
    s.inf' hs (fun j => φ j b) - s.inf' hs (fun j => φ j a)
      = ∫ t in a..b, derivWithin (fun u => s.inf' hs (fun j => φ j u)) (Ioi t) t := by
  have hcont : Continuous fun u => s.inf' hs (fun j => φ j u) :=
    continuous_finset_inf'_fun hs fun i hi =>
      continuous_iff_continuousAt.mpr fun t => (hφ i hi t).continuousAt
  have hbound : ∀ t, |derivWithin (fun u => s.inf' hs (fun j => φ j u)) (Ioi t) t|
      ≤ ∑ i ∈ s, |φ' i t| := by
    intro t
    obtain ⟨i, hi, -, hd, -⟩ := exists_derivWithin_Ioi_finset_inf' hs hφ t
    rw [hd]
    exact Finset.single_le_sum (f := fun i => |φ' i t|) (fun i _ => abs_nonneg _) hi
  have hmeas : Measurable fun t => derivWithin (fun u => s.inf' hs (fun j => φ j u)) (Ioi t) t :=
    measurable_derivWithin_Ioi _
  have hint : IntervalIntegrable
      (fun t => derivWithin (fun u => s.inf' hs (fun j => φ j u)) (Ioi t) t) volume a b := by
    have hg : IntervalIntegrable (fun t => ∑ i ∈ s, |φ' i t|) volume a b :=
      (continuous_finsetSum s fun i hi => (hφ' i hi).abs).intervalIntegrable a b
    refine hg.mono_fun hmeas.aestronglyMeasurable (Filter.Eventually.of_forall fun t => ?_)
    show ‖derivWithin (fun u => s.inf' hs (fun j => φ j u)) (Ioi t) t‖ ≤ ‖∑ i ∈ s, |φ' i t|‖
    rw [Real.norm_eq_abs, Real.norm_eq_abs,
      abs_of_nonneg (Finset.sum_nonneg fun i _ => abs_nonneg (φ' i t))]
    exact hbound t
  symm
  exact intervalIntegral.integral_eq_sub_of_hasDeriv_right_of_le hab hcont.continuousOn
    (fun t _ => (exists_derivWithin_Ioi_finset_inf' hs hφ t).choose_spec.2.2.2) hint

end MinDeriv
/-! ## §29  The path inequality for a finite codebook

Fix a finite codebook `C` and let `f_C(z) = min_c ‖z/‖z‖ − c‖²`, the squared distance from the
direction of `z` to `C`.  Along the Maurey–Pisier path `X_θ = cos θ·x + sin θ·y` from `x` to
`y`, with `Y_θ = −sin θ·x + cos θ·y` its derivative, the path formula of §28 gives
`f_C(y) − f_C(x) = ∫₀^{π/2} f_C'₊(X_θ)[Y_θ] dθ`, so by Cauchy–Schwarz on the interval
`(f_C(y) − f_C(x))² ≤ (π/2) ∫₀^{π/2} S_C(X_θ, Y_θ) dθ`, with `S_C(u, v)` the sum over the
active codewords at `u` of `(h_c'(u)[v])²` (`sq_sub_fC_le`).  The path avoids the origin for
`γ ⊗ γ`-almost every pair (`ae_good`), two codewords tie on a `γ`-null set
(`gaussianE_tie_null`), and `E_y (L y)² = ‖L‖²` for a linear form `L` and Gaussian `y`
(`lintegral_clm_sq_gaussianE`). -/

section CodewordFunction

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]

/-- `h_c(z) = ‖z/‖z‖ − c‖²`, the squared distance from the direction of `z` to the codeword `c`. -/
noncomputable def hc (c z : E) : ℝ := ‖dir z - c‖ ^ 2

theorem contDiffAt_dir {z : E} (hz : z ≠ 0) : ContDiffAt ℝ 1 (dir : E → E) z := by
  show ContDiffAt ℝ 1 (fun x : E => ‖x‖⁻¹ • x) z
  exact (((contDiffAt_id (𝕜 := ℝ)).norm ℝ hz).inv (norm_ne_zero_iff.mpr hz)).smul contDiffAt_id

theorem contDiffAt_hc (c : E) {z : E} (hz : z ≠ 0) : ContDiffAt ℝ 1 (hc c) z :=
  ((contDiffAt_dir hz).sub contDiffAt_const).norm_sq ℝ

theorem differentiableAt_hc (c : E) {z : E} (hz : z ≠ 0) : DifferentiableAt ℝ (hc c) z :=
  (contDiffAt_hc c hz).differentiableAt one_ne_zero

/-- The two-point Lipschitz bound for `h_c`, with slope function `2‖dir z − c‖/‖z‖`. -/
theorem abs_hc_sub_le (c : E) {z w : E} (hz : z ≠ 0) (hw : w ≠ 0) :
    |hc c z - hc c w| ≤ ‖z - w‖ * (2 * ‖dir z - c‖ / ‖z‖ + 2 * ‖dir w - c‖ / ‖w‖) := by
  have hz' : 0 < ‖z‖ := norm_pos_iff.mpr hz
  have hw' : 0 < ‖w‖ := norm_pos_iff.mpr hw
  have h1 : |hc c z - hc c w| ≤ ‖dir z - dir w‖ * (‖dir z - c‖ + ‖dir w - c‖) := by
    unfold hc
    rw [sq_sub_sq, abs_mul, abs_of_nonneg (add_nonneg (norm_nonneg _) (norm_nonneg _)), mul_comm,
      add_comm]
    refine mul_le_mul_of_nonneg_right ?_ (add_nonneg (norm_nonneg _) (norm_nonneg _))
    have := abs_norm_sub_norm_le (dir z - c) (dir w - c)
    rwa [sub_sub_sub_cancel_right] at this
  have hzw : ‖dir z - dir w‖ ≤ 2 * ‖z - w‖ / ‖z‖ := norm_dir_sub_dir_le hz
  have hwz : ‖dir z - dir w‖ ≤ 2 * ‖z - w‖ / ‖w‖ :=
    calc ‖dir z - dir w‖ = ‖dir w - dir z‖ := norm_sub_rev _ _
      _ ≤ 2 * ‖w - z‖ / ‖w‖ := norm_dir_sub_dir_le hw
      _ = 2 * ‖z - w‖ / ‖w‖ := by rw [norm_sub_rev]
  calc |hc c z - hc c w| ≤ ‖dir z - dir w‖ * (‖dir z - c‖ + ‖dir w - c‖) := h1
    _ = ‖dir z - dir w‖ * ‖dir z - c‖ + ‖dir z - dir w‖ * ‖dir w - c‖ := by ring
    _ ≤ (2 * ‖z - w‖ / ‖z‖) * ‖dir z - c‖ + (2 * ‖z - w‖ / ‖w‖) * ‖dir w - c‖ :=
        add_le_add (mul_le_mul_of_nonneg_right hzw (norm_nonneg _))
          (mul_le_mul_of_nonneg_right hwz (norm_nonneg _))
    _ = ‖z - w‖ * (2 * ‖dir z - c‖ / ‖z‖ + 2 * ‖dir w - c‖ / ‖w‖) := by
        field_simp

/-- The derivative of `h_c` is bounded by twice the distance to the codeword over the radius. -/
theorem norm_fderiv_hc_le (c : E) {z : E} (hz : z ≠ 0) :
    ‖fderiv ℝ (hc c) z‖ ≤ 2 * (2 * ‖dir z - c‖ / ‖z‖) := by
  have hcont : ContinuousAt (fun w : E => 2 * ‖dir w - c‖ / ‖w‖) z := by
    have hd : ContinuousAt (dir : E → E) z := (contDiffAt_dir hz).continuousAt
    exact (continuousAt_const.mul (hd.sub continuousAt_const).norm).div continuous_norm.continuousAt
      (norm_ne_zero_iff.mpr hz)
  exact norm_fderiv_le_of_twoPoint hz hcont (by positivity) (fun z w hz hw => abs_hc_sub_le c hz hw)
    (differentiableAt_hc c hz).hasFDerivAt

/-! ### The rotation path -/

/-- The point at angle `θ` on the great circle through `x` (at `θ = 0`) and `y` (at `θ = π/2`). -/
noncomputable def pathX (x y : E) (θ : ℝ) : E := Real.cos θ • x + Real.sin θ • y

/-- Its velocity, which is the rotated second point. -/
noncomputable def pathY (x y : E) (θ : ℝ) : E := -Real.sin θ • x + Real.cos θ • y

theorem hasDerivAt_pathX (x y : E) (θ : ℝ) : HasDerivAt (pathX x y) (pathY x y θ) θ := by
  unfold pathX pathY
  have h1 := (Real.hasDerivAt_cos θ).smul_const x
  have h2 := (Real.hasDerivAt_sin θ).smul_const y
  exact h1.add h2

theorem contDiff_pathX (x y : E) : ContDiff ℝ 1 (pathX x y) := by
  unfold pathX
  exact (Real.contDiff_cos.smul contDiff_const).add (Real.contDiff_sin.smul contDiff_const)

theorem pathX_zero (x y : E) : pathX x y 0 = x := by simp [pathX]

theorem pathX_pi_div_two (x y : E) : pathX x y (Real.pi / 2) = y := by simp [pathX]

/-- `Good x y`: the great circle through `x` and `y` avoids the origin. -/
def Good (x y : E) : Prop := ∀ θ, pathX x y θ ≠ 0

/-- Along a good path, `h_c` composed with the path is `C¹` with the chain-rule derivative. -/
theorem hasDerivAt_hc_pathX (c : E) {x y : E} (hg : Good x y) (θ : ℝ) :
    HasDerivAt (fun t => hc c (pathX x y t)) (fderiv ℝ (hc c) (pathX x y θ) (pathY x y θ)) θ :=
  (differentiableAt_hc c (hg θ)).hasFDerivAt.comp_hasDerivAt θ (hasDerivAt_pathX x y θ)

theorem contDiff_hc_pathX (c : E) {x y : E} (hg : Good x y) :
    ContDiff ℝ 1 (fun t => hc c (pathX x y t)) :=
  contDiff_iff_contDiffAt.mpr fun θ =>
    (contDiffAt_hc c (hg θ)).comp θ (contDiff_pathX x y).contDiffAt

theorem continuous_hc_pathX_deriv (c : E) {x y : E} (hg : Good x y) :
    Continuous fun θ => fderiv ℝ (hc c) (pathX x y θ) (pathY x y θ) := by
  have h := (contDiff_hc_pathX c hg).continuous_deriv le_rfl
  refine h.congr fun θ => ?_
  exact (hasDerivAt_hc_pathX c hg θ).deriv

end CodewordFunction

section GoodSet

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

/-- A bad pair satisfies the Cauchy–Schwarz equality. -/
theorem abs_inner_eq_of_not_good {x y : E} (h : ¬ Good x y) : |⟪x, y⟫_ℝ| = ‖x‖ * ‖y‖ := by
  unfold Good at h
  push Not at h
  obtain ⟨θ, hθ⟩ := h
  unfold pathX at hθ
  rcases eq_or_ne (Real.sin θ) 0 with hs | hs
  · have hc : Real.cos θ ≠ 0 := by
      intro hc; have := Real.cos_sq_add_sin_sq θ; rw [hc, hs] at this; norm_num at this
    have hx : x = 0 := by
      rw [hs, zero_smul, add_zero] at hθ
      exact (smul_eq_zero.mp hθ).resolve_left hc
    simp [hx]
  · have hy : y = -(Real.cos θ / Real.sin θ) • x := by
      have : Real.sin θ • y = -(Real.cos θ • x) := by rw [← sub_eq_zero, sub_neg_eq_add, add_comm]; exact hθ
      rw [neg_smul, div_eq_inv_mul, mul_smul, ← smul_neg, ← this, smul_smul, inv_mul_cancel₀ hs,
        one_smul]
    rw [hy, real_inner_smul_right, real_inner_self_eq_norm_sq, abs_mul, abs_of_nonneg (sq_nonneg ‖x‖),
      norm_smul, Real.norm_eq_abs]
    ring

/-- The set of bad pairs is contained in a closed set. -/
theorem measurableSet_bad :
    MeasurableSet {p : E × E | |⟪p.1, p.2⟫_ℝ| = ‖p.1‖ * ‖p.2‖} :=
  measurableSet_eq_fun (by fun_prop) (by fun_prop)

theorem gaussianE_absolutelyContinuous : gaussianE E ≪ (volume : Measure E) :=
  (withDensity_absolutelyContinuous _ _).smul_left _

/-- For `x ≠ 0` and `d ≥ 2`, the line through `x` is Gaussian-null. -/
theorem gaussianE_span_singleton (hd : 2 ≤ Module.finrank ℝ E) (x : E) :
    gaussianE E (Submodule.span ℝ {x} : Set E) = 0 := by
  refine gaussianE_absolutelyContinuous (Measure.addHaar_submodule _ _ ?_)
  intro htop
  have h1 := finrank_span_le_card (R := ℝ) ({x} : Set E)
  rw [htop, finrank_top] at h1
  simp at h1
  omega

end GoodSet

section BadNull

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

theorem gaussianE_ae_ne_zero : ∀ᵐ x ∂(gaussianE E), x ≠ 0 := by
  rw [ae_iff]
  have : {x : E | ¬ x ≠ 0} = {0} := by ext x; simp
  rw [this]
  exact gaussianE_absolutelyContinuous (measure_singleton 0)

/-- **Almost every pair is good**: the great circle through two independent Gaussian vectors
avoids the origin. -/
theorem ae_good (hd : 2 ≤ Module.finrank ℝ E) :
    ∀ᵐ p ∂((gaussianE E).prod (gaussianE E)), Good p.1 p.2 := by
  rw [ae_iff]
  refine measure_mono_null (t := {p : E × E | |⟪p.1, p.2⟫_ℝ| = ‖p.1‖ * ‖p.2‖})
    (fun p hp => abs_inner_eq_of_not_good hp) ?_
  rw [Measure.prod_apply measurableSet_bad]
  refine (lintegral_congr_ae ?_).trans lintegral_zero
  filter_upwards [gaussianE_ae_ne_zero (E := E)] with x hx
  refine measure_mono_null (fun y hy => ?_) (gaussianE_span_singleton hd x)
  simp only [Set.mem_preimage, Set.mem_setOf_eq] at hy
  rcases eq_or_ne y 0 with rfl | hy0
  · exact Submodule.zero_mem _
  · have := (norm_inner_eq_norm_iff (𝕜 := ℝ) hx hy0).mp (by rw [Real.norm_eq_abs]; exact hy)
    obtain ⟨r, -, rfl⟩ := this
    exact Submodule.smul_mem _ r (Submodule.mem_span_singleton_self x)

/-- **Ties are null**: two distinct codewords are equidistant from the direction of a Gaussian
vector with probability zero. -/
theorem gaussianE_tie_null (hd : 2 ≤ Module.finrank ℝ E) {c c' : E} (hne : c ≠ c') :
    gaussianE E {z | hc c z = hc c' z} = 0 := by
  have hpos : 0 < ‖c' - c‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hne.symm)
  set e : E := ‖c' - c‖⁻¹ • (c' - c) with he
  have hen : ‖e‖ = 1 := by
    rw [he, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hpos.ne']
  set t : ℝ := (‖c'‖ ^ 2 - ‖c‖ ^ 2) / (2 * ‖c' - c‖) with ht
  have hiff : ∀ u : E, ‖u - c‖ ^ 2 = ‖u - c'‖ ^ 2 ↔ ⟪e, u⟫_ℝ = t := by
    intro u
    rw [norm_sub_sq_real, norm_sub_sq_real, he, real_inner_smul_left, inner_sub_left, ht,
      real_inner_comm u c, real_inner_comm u c']
    constructor
    · intro h; field_simp; linarith
    · intro h; field_simp at h; linarith
  have hset : {z : E | hc c z = hc c' z} = dir ⁻¹' {u : E | ⟪e, u⟫_ℝ = t} := by
    ext z; simp only [Set.mem_setOf_eq, Set.mem_preimage, hc]; exact hiff (dir z)
  have hA : MeasurableSet {u : E | ⟪e, u⟫_ℝ = t} :=
    measurableSet_eq_fun (continuous_const.inner continuous_id).measurable measurable_const
  rw [hset, ← Measure.map_apply measurable_dir hA, gaussianE_map_dir]
  have hmeas : Measurable fun u : E => ⟪e, u⟫_ℝ := (continuous_const.inner continuous_id).measurable
  have : {u : E | ⟪e, u⟫_ℝ = t} = (fun u : E => ⟪e, u⟫_ℝ) ⁻¹' {t} := by ext u; simp
  rw [this, ← Measure.map_apply hmeas (measurableSet_singleton t), sphereUniformAmbient_map_inner hd hen,
    sphericalCoordLaw]
  have h0 : (volume.restrict (Set.Icc (-1 : ℝ) 1)) {t} = 0 :=
    le_antisymm ((Measure.le_iff'.1 Measure.restrict_le_self {t}).trans_eq (measure_singleton t))
      zero_le
  exact withDensity_absolutelyContinuous _ _ h0

end BadNull

section DerivInner

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

/-- **`E_y (f' y)² = ‖f'‖²`** for a continuous linear functional and a Gaussian `y`. -/
theorem lintegral_clm_sq_gaussianE (hd : 2 ≤ Module.finrank ℝ E) (f' : E →L[ℝ] ℝ) :
    ∫⁻ y, ENNReal.ofReal (f' y ^ 2) ∂(gaussianE E) = ENNReal.ofReal (‖f'‖ ^ 2) := by
  set g : E := (InnerProductSpace.toDual ℝ E).symm f' with hg
  have h1 : ∀ y, f' y = ⟪g, y⟫_ℝ := fun y => (InnerProductSpace.toDual_symm_apply).symm
  have h2 : ‖f'‖ = ‖g‖ := by
    rw [hg, LinearIsometryEquiv.norm_map]
  simp_rw [h1, h2]
  exact lintegral_inner_sq_gaussianE hd g

end DerivInner

section RotProd

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

theorem measurable_rotProd (θ : ℝ) :
    Measurable fun p : E × E => (pathX p.1 p.2 θ, pathY p.1 p.2 θ) := by
  unfold pathX pathY; fun_prop

/-- **Rotation invariance of the Gaussian pair.** -/
theorem measurePreserving_rotProd (θ : ℝ) :
    MeasurePreserving (fun p : E × E => (pathX p.1 p.2 θ, pathY p.1 p.2 θ))
      ((gaussianE E).prod (gaussianE E)) ((gaussianE E).prod (gaussianE E)) := by
  refine ⟨measurable_rotProd θ, ?_⟩
  have hcomp : (fun p : E × E => (pathX p.1 p.2 θ, pathY p.1 p.2 θ)) ∘ (WithLp.ofLp : WithLp 2 (E × E) → E × E)
      = WithLp.ofLp ∘ rotPair θ := by
    funext z
    simp only [Function.comp, rotPair_apply, rotMap_apply, WithLp.ofLp_toLp, pathX, pathY]
    rfl
  rw [← gaussianE_prod_map_ofLp, Measure.map_map (measurable_rotProd θ) (WithLp.measurable_ofLp 2 _),
    hcomp, ← Measure.map_map (WithLp.measurable_ofLp 2 _) (rotPair θ).continuous.measurable,
    gaussianE_map_isometry]

end RotProd

section CauchySchwarzInterval

/-- `(∫ₐᵇ D)² ≤ (b − a) ∫ₐᵇ D²`, from the nonnegativity of a variance. -/
theorem sq_intervalIntegral_le {a b : ℝ} (hab : a < b) {D : ℝ → ℝ}
    (hD : MemLp D 2 (volume.restrict (Set.Ioc a b))) :
    (∫ t in a..b, D t) ^ 2 ≤ (b - a) * ∫ t in a..b, D t ^ 2 := by
  set ν : Measure ℝ := (ENNReal.ofReal (b - a))⁻¹ • volume.restrict (Set.Ioc a b) with hν
  have hba : 0 < b - a := sub_pos.mpr hab
  haveI : IsProbabilityMeasure ν := by
    constructor
    rw [hν, Measure.smul_apply, smul_eq_mul, Measure.restrict_apply MeasurableSet.univ,
      Set.univ_inter, Real.volume_Ioc, ENNReal.inv_mul_cancel (by simp [hab]) ENNReal.ofReal_ne_top]
  have hDν : MemLp D 2 ν := hD.smul_measure (by simp [hab])
  have hvar := ProbabilityTheory.variance_nonneg D ν
  rw [ProbabilityTheory.variance_eq_sub hDν] at hvar
  have hsm : ∀ f : ℝ → ℝ, ∫ t, f t ∂ν = (b - a)⁻¹ * ∫ t in a..b, f t := by
    intro f
    rw [hν, integral_smul_measure, intervalIntegral.integral_of_le hab.le, smul_eq_mul,
      ENNReal.toReal_inv, ENNReal.toReal_ofReal hba.le]
  rw [hsm, hsm] at hvar
  have hc : 0 < (b - a)⁻¹ := inv_pos.mpr hba
  have := sub_nonneg.mp hvar
  simp only [Pi.pow_apply, mul_pow] at this
  have hne : (b - a) ≠ 0 := hba.ne'
  calc (∫ t in a..b, D t) ^ 2
      = (b - a) ^ 2 * ((b - a)⁻¹ ^ 2 * (∫ t in a..b, D t) ^ 2) := by field_simp
    _ ≤ (b - a) ^ 2 * ((b - a)⁻¹ * ∫ t in a..b, D t ^ 2) := by gcongr
    _ = (b - a) * ∫ t in a..b, D t ^ 2 := by field_simp

end CauchySchwarzInterval

section PathIneq

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

theorem measurable_finset_inf'_fun {ι : Type*} {s : Finset ι} (hs : s.Nonempty) {φ : ι → E → ℝ}
    (h : ∀ i ∈ s, Measurable (φ i)) : Measurable fun z => s.inf' hs (fun i => φ i z) := by
  revert h
  induction hs using Finset.Nonempty.cons_induction with
  | singleton a => intro h; simpa using h a (Finset.mem_singleton_self a)
  | cons a s ha hs' ih =>
      intro h
      have hfun : (fun z => (Finset.cons a s ha).inf' ⟨a, Finset.mem_cons_self a s⟩ (fun k => φ k z))
          = fun z => min (φ a z) (s.inf' hs' (fun k => φ k z)) := by
        funext z; rw [Finset.inf'_cons hs']
      rw [hfun]
      exact (h a (Finset.mem_cons_self a s)).min (ih fun i hi => h i (Finset.mem_cons_of_mem hi))

/-- The codebook function on `E`: `f z = min_c h_c z = dist(z/‖z‖, C)²`. -/
noncomputable def fC (C : Finset E) (hC : C.Nonempty) (z : E) : ℝ := C.inf' hC (fun c => hc c z)

/-- The set of pairs `(u, v)` at which the codeword `c` is active at `u`. -/
def active (C : Finset E) (hC : C.Nonempty) (c : E) : Set (E × E) :=
  {p | hc c p.1 = fC C hC p.1}

/-- The active-codeword derivative sum `S(u, v) = ∑_c 1[c active at u] (h_c'(u) v)²`. -/
noncomputable def SC (C : Finset E) (hC : C.Nonempty) (u v : E) : ℝ :=
  ∑ c ∈ C, (active C hC c).indicator (fun p => fderiv ℝ (hc c) p.1 p.2 ^ 2) (u, v)

theorem fC_nonneg (C : Finset E) (hC : C.Nonempty) (z : E) : 0 ≤ fC C hC z :=
  Finset.le_inf' hC _ fun _ _ => sq_nonneg _

theorem SC_nonneg (C : Finset E) (hC : C.Nonempty) (u v : E) : 0 ≤ SC C hC u v :=
  Finset.sum_nonneg fun c _ => Set.indicator_nonneg (fun _ _ => sq_nonneg _) _

theorem measurable_hc (c : E) : Measurable (hc c) := by
  unfold hc
  exact ((measurable_dir).sub measurable_const).norm.pow_const 2

theorem measurable_fC (C : Finset E) (hC : C.Nonempty) : Measurable (fC C hC) := by
  unfold fC
  exact measurable_finset_inf'_fun hC fun c _ => measurable_hc c

theorem measurableSet_active (C : Finset E) (hC : C.Nonempty) (c : E) :
    MeasurableSet (active C hC c) :=
  measurableSet_eq_fun ((measurable_hc c).comp measurable_fst) ((measurable_fC C hC).comp measurable_fst)

theorem measurable_fderiv_hc_apply (c : E) :
    Measurable fun p : E × E => fderiv ℝ (hc c) p.1 p.2 ^ 2 := by
  have heval : Measurable fun q : (E →L[ℝ] ℝ) × E => q.1 q.2 :=
    (isBoundedBilinearMap_apply (𝕜 := ℝ) (E := E) (F := ℝ)).continuous.measurable
  exact (heval.comp (((measurable_fderiv ℝ (hc c)).comp measurable_fst).prodMk measurable_snd)).pow_const 2

theorem measurable_SC (C : Finset E) (hC : C.Nonempty) :
    Measurable fun p : E × E => SC C hC p.1 p.2 := by
  unfold SC
  exact Finset.measurable_sum _ fun c _ =>
    (measurable_fderiv_hc_apply c).indicator (measurableSet_active C hC c)

theorem measurable_pathPair (x y : E) : Measurable fun t : ℝ => (pathX x y t, pathY x y t) := by
  unfold pathX pathY; fun_prop

theorem measurable_SC_path (C : Finset E) (hC : C.Nonempty) (x y : E) :
    Measurable fun t : ℝ => SC C hC (pathX x y t) (pathY x y t) := by
  have h := Measurable.comp (g := fun p : E × E => SC C hC p.1 p.2)
    (f := fun t : ℝ => (pathX x y t, pathY x y t)) (measurable_SC C hC) (measurable_pathPair x y)
  exact h

set_option maxHeartbeats 1000000 in
/-- **The pointwise path inequality** for a good pair**, together with the integrability of the
active-derivative sum along the path. -/
theorem sq_sub_fC_le (C : Finset E) (hC : C.Nonempty) {x y : E} (hg : Good x y) :
    IntervalIntegrable (fun θ => SC C hC (pathX x y θ) (pathY x y θ)) volume 0 (Real.pi / 2) ∧
    (fC C hC y - fC C hC x) ^ 2
      ≤ (Real.pi / 2) * ∫ θ in (0 : ℝ)..(Real.pi / 2), SC C hC (pathX x y θ) (pathY x y θ) := by
  have hφ : ∀ c ∈ C, ∀ t, HasDerivAt (fun θ => hc c (pathX x y θ))
      ((fun c t => fderiv ℝ (hc c) (pathX x y t) (pathY x y t)) c t) t :=
    fun c _ t => hasDerivAt_hc_pathX c hg t
  have hφ' : ∀ c ∈ C, Continuous ((fun c t => fderiv ℝ (hc c) (pathX x y t) (pathY x y t)) c) :=
    fun c _ => continuous_hc_pathX_deriv c hg
  have hpi : (0 : ℝ) < Real.pi / 2 := by positivity
  have hpath := finset_inf'_sub_eq_integral (φ := fun c θ => hc c (pathX x y θ)) hC hpi.le hφ hφ'
  have hg0 : C.inf' hC (fun j => hc j (pathX x y 0)) = fC C hC x := by rw [pathX_zero]; rfl
  have hg1 : C.inf' hC (fun j => hc j (pathX x y (Real.pi / 2))) = fC C hC y := by
    rw [pathX_pi_div_two]; rfl
  have hD : ∀ t, derivWithin (fun u => C.inf' hC (fun j => hc j (pathX x y u))) (Ioi t) t ^ 2
      ≤ SC C hC (pathX x y t) (pathY x y t) := by
    intro t
    obtain ⟨c, hc', heq, hd, -⟩ := exists_derivWithin_Ioi_finset_inf' hC hφ t
    rw [hd]
    unfold SC
    have hterm : (active C hC c).indicator (fun p : E × E => fderiv ℝ (hc c) p.1 p.2 ^ 2)
        (pathX x y t, pathY x y t) = fderiv ℝ (hc c) (pathX x y t) (pathY x y t) ^ 2 :=
      Set.indicator_of_mem (show (pathX x y t, pathY x y t) ∈ active C hC c from heq) _
    rw [← hterm]
    exact Finset.single_le_sum (f := fun c => (active C hC c).indicator
      (fun p : E × E => fderiv ℝ (hc c) p.1 p.2 ^ 2) (pathX x y t, pathY x y t))
      (fun c _ => Set.indicator_nonneg (fun _ _ => sq_nonneg _) _) hc'
  have hbound : ∀ t, |derivWithin (fun u => C.inf' hC (fun j => hc j (pathX x y u))) (Ioi t) t|
      ≤ ∑ c ∈ C, |fderiv ℝ (hc c) (pathX x y t) (pathY x y t)| := by
    intro t
    obtain ⟨c, hc', -, hd, -⟩ := exists_derivWithin_Ioi_finset_inf' hC hφ t
    rw [hd]
    exact Finset.single_le_sum (f := fun c => |fderiv ℝ (hc c) (pathX x y t) (pathY x y t)|)
      (fun c _ => abs_nonneg _) hc'
  have hcontsum : Continuous fun t => ∑ c ∈ C, |fderiv ℝ (hc c) (pathX x y t) (pathY x y t)| :=
    continuous_finsetSum C fun c hc' => (hφ' c hc').abs
  obtain ⟨M, hM⟩ := (isCompact_Icc (a := (0 : ℝ)) (b := Real.pi / 2)).exists_bound_of_continuousOn
    hcontsum.continuousOn
  have hDmeas : Measurable fun t =>
      derivWithin (fun u => C.inf' hC (fun j => hc j (pathX x y u))) (Ioi t) t :=
    measurable_derivWithin_Ioi _
  have hDmem : MemLp (fun t => derivWithin (fun u => C.inf' hC (fun j => hc j (pathX x y u))) (Ioi t) t)
      2 (volume.restrict (Set.Ioc 0 (Real.pi / 2))) := by
    refine MemLp.of_bound hDmeas.aestronglyMeasurable M ?_
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    rw [Real.norm_eq_abs]
    refine (hbound t).trans ((le_abs_self _).trans ?_)
    have := hM t (Set.Ioc_subset_Icc_self ht)
    rwa [Real.norm_eq_abs] at this
  have hSCmeas : Measurable fun t => SC C hC (pathX x y t) (pathY x y t) :=
    measurable_SC_path C hC x y
  have hSCbound : ∀ t, SC C hC (pathX x y t) (pathY x y t)
      ≤ ∑ c ∈ C, fderiv ℝ (hc c) (pathX x y t) (pathY x y t) ^ 2 := by
    intro t
    unfold SC
    exact Finset.sum_le_sum fun c _ => Set.indicator_le_self' (fun _ _ => sq_nonneg _) _
  have hSCint : IntervalIntegrable (fun t => SC C hC (pathX x y t) (pathY x y t)) volume 0
      (Real.pi / 2) := by
    have hg : IntervalIntegrable (fun t => ∑ c ∈ C, fderiv ℝ (hc c) (pathX x y t) (pathY x y t) ^ 2)
        volume 0 (Real.pi / 2) :=
      (continuous_finsetSum C fun c hc' => (hφ' c hc').pow 2).intervalIntegrable _ _
    refine hg.mono_fun hSCmeas.aestronglyMeasurable (Filter.Eventually.of_forall fun t => ?_)
    show ‖SC C hC (pathX x y t) (pathY x y t)‖
      ≤ ‖∑ c ∈ C, fderiv ℝ (hc c) (pathX x y t) (pathY x y t) ^ 2‖
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (SC_nonneg _ _ _ _),
      abs_of_nonneg (Finset.sum_nonneg fun c _ => sq_nonneg _)]
    exact hSCbound t
  have hD2int : IntervalIntegrable (fun t =>
      derivWithin (fun u => C.inf' hC (fun j => hc j (pathX x y u))) (Ioi t) t ^ 2) volume 0
      (Real.pi / 2) := by
    refine hSCint.mono_fun (hDmeas.pow_const 2).aestronglyMeasurable
      (Filter.Eventually.of_forall fun t => ?_)
    show ‖derivWithin (fun u => C.inf' hC (fun j => hc j (pathX x y u))) (Ioi t) t ^ 2‖
      ≤ ‖SC C hC (pathX x y t) (pathY x y t)‖
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _),
      abs_of_nonneg (SC_nonneg _ _ _ _)]
    exact hD t
  refine ⟨hSCint, ?_⟩
  calc (fC C hC y - fC C hC x) ^ 2
      = (∫ t in (0 : ℝ)..(Real.pi / 2),
          derivWithin (fun u => C.inf' hC (fun j => hc j (pathX x y u))) (Ioi t) t) ^ 2 := by
        rw [← hg0, ← hg1, hpath]
    _ ≤ (Real.pi / 2 - 0) * ∫ t in (0 : ℝ)..(Real.pi / 2),
          derivWithin (fun u => C.inf' hC (fun j => hc j (pathX x y u))) (Ioi t) t ^ 2 :=
        sq_intervalIntegral_le hpi hDmem
    _ ≤ (Real.pi / 2) * ∫ θ in (0 : ℝ)..(Real.pi / 2), SC C hC (pathX x y θ) (pathY x y θ) := by
        rw [sub_zero]
        exact mul_le_mul_of_nonneg_left
          (intervalIntegral.integral_mono_on hpi.le hD2int hSCint fun t _ => hD t) hpi.le

end PathIneq
/-! ## §30  The Poincaré inequality for a finite codebook, proved

Integrating the path inequality of §29 over `γ ⊗ γ`, exchanging the order of integration, and
using that the rotation preserves `γ ⊗ γ` for every `θ` (§27) gives
`E(f_C(X) − f_C(Y))² ≤ (π/2)² E S_C(X, Y)`.  Almost surely one codeword is active, and its
derivative is bounded by `4 · dist(Z/‖Z‖, C)/‖Z‖` (`norm_fderiv_hc_le`), so
`E S_C ≤ 16 E[f_C(Z)/‖Z‖²] = 16 E_σ f_C/(d − 2)` by §26.  Hence
`Var_γ f_C ≤ 2π²/(d − 2) · E f_C` (`variance_fC_le`), and, transporting along the direction
map, `Var_σ ‖u − q u‖² ≤ 2π²/(d − 2) · ρ²` for any nearest-codeword stage with a finite
codebook (`variance_stageErr_le_finite`).  This replaces the hypothesis `GaussPoincare` of §26:
`meas_not_decayWithin_le_finite` is the concentration remark for scalar, `E8`, and trellis
codebooks, at rate `2π² P/((d − 2) ε² ρ²)`, with **no unproved hypothesis**. -/

section Assembly

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

/-- The path inequality in `lintegral` form. -/
theorem ofReal_sq_sub_fC_le (C : Finset E) (hC : C.Nonempty) {x y : E} (hg : Good x y) :
    ENNReal.ofReal ((fC C hC y - fC C hC x) ^ 2)
      ≤ ENNReal.ofReal (Real.pi / 2) * ∫⁻ θ in Set.Ioc (0 : ℝ) (Real.pi / 2),
          ENNReal.ofReal (SC C hC (pathX x y θ) (pathY x y θ)) := by
  obtain ⟨hint, h⟩ := sq_sub_fC_le C hC hg
  have hpi : (0 : ℝ) ≤ Real.pi / 2 := by positivity
  calc ENNReal.ofReal ((fC C hC y - fC C hC x) ^ 2)
      ≤ ENNReal.ofReal ((Real.pi / 2) *
          ∫ θ in (0 : ℝ)..(Real.pi / 2), SC C hC (pathX x y θ) (pathY x y θ)) :=
        ENNReal.ofReal_le_ofReal h
    _ = ENNReal.ofReal (Real.pi / 2) * ENNReal.ofReal
          (∫ θ in (0 : ℝ)..(Real.pi / 2), SC C hC (pathX x y θ) (pathY x y θ)) :=
        ENNReal.ofReal_mul hpi
    _ = _ := by
        rw [intervalIntegral.integral_of_le hpi, ofReal_integral_eq_lintegral_ofReal
          ((intervalIntegrable_iff_integrableOn_Ioc_of_le hpi).mp hint)
          (Filter.Eventually.of_forall fun θ => SC_nonneg _ _ _ _)]

theorem dir_dir (x : E) : dir (dir x) = dir x := by
  rcases eq_or_ne x 0 with rfl | hx
  · simp [dir]
  have h : ‖dir x‖ = 1 := by
    rw [dir, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (norm_ne_zero_iff.mpr hx)]
  show ‖dir x‖⁻¹ • dir x = dir x
  rw [h, inv_one, one_smul]

theorem fC_dir (C : Finset E) (hC : C.Nonempty) (x : E) : fC C hC (dir x) = fC C hC x := by
  unfold fC hc; rw [dir_dir]

/-- Almost surely at most one codeword is active. -/
theorem ae_unique_active (hd : 2 ≤ Module.finrank ℝ E) (C : Finset E) (hC : C.Nonempty) :
    ∀ᵐ z ∂(gaussianE E), ∀ c ∈ (C : Set E), ∀ c' ∈ (C : Set E),
      hc c z = fC C hC z → hc c' z = fC C hC z → c = c' := by
  rw [ae_ball_iff C.countable_toSet]
  intro c _
  rw [ae_ball_iff C.countable_toSet]
  intro c' _
  by_cases h : c = c'
  · exact Filter.Eventually.of_forall fun _ _ _ => h
  · have hnull := gaussianE_tie_null hd h
    rw [ae_iff]
    refine measure_mono_null (fun z hz => ?_) hnull
    simp only [Set.mem_setOf_eq, _root_.not_imp] at hz
    simp only [Set.mem_setOf_eq]
    rw [hz.1, hz.2.1]

/-- The sum of the active indicators is at most one, almost surely. -/
theorem ae_sum_active_le_one (hd : 2 ≤ Module.finrank ℝ E) (C : Finset E) (hC : C.Nonempty) :
    ∀ᵐ z ∂(gaussianE E),
      (∑ c ∈ C, ({x : E | hc c x = fC C hC x}).indicator (fun _ => (1 : ℝ≥0∞)) z) ≤ 1 := by
  filter_upwards [ae_unique_active hd C hC] with z hz
  classical
  have : ∀ c ∈ C, ({x : E | hc c x = fC C hC x}).indicator (fun _ => (1 : ℝ≥0∞)) z
      = if hc c z = fC C hC z then 1 else 0 := fun c _ => by
    by_cases h : hc c z = fC C hC z <;> simp [Set.indicator_apply, h]
  rw [Finset.sum_congr rfl this, Finset.sum_boole]
  have hcard : (C.filter fun c => hc c z = fC C hC z).card ≤ 1 := by
    refine Finset.card_le_one.mpr fun a ha b hb => ?_
    rw [Finset.mem_filter] at ha hb
    exact hz a ha.1 b hb.1 ha.2 hb.2
  exact_mod_cast hcard

/-- **The Gaussian integral of the active-derivative sum** is bounded by
`16 E[f(Z)/‖Z‖²]`. -/
theorem lintegral_SC_le (hd : 2 ≤ Module.finrank ℝ E) (C : Finset E) (hC : C.Nonempty) :
    ∫⁻ p, ENNReal.ofReal (SC C hC p.1 p.2) ∂((gaussianE E).prod (gaussianE E))
      ≤ 16 * ∫⁻ x, ENNReal.ofReal (fC C hC x) * ENNReal.ofReal ((‖x‖ ^ 2)⁻¹) ∂(gaussianE E) := by
  set A : E → Set E := fun c => {x : E | hc c x = fC C hC x} with hA
  have hAmeas : ∀ c, MeasurableSet (A c) := fun c =>
    measurableSet_eq_fun (measurable_hc c) (measurable_fC C hC)
  -- pointwise: `ofReal (SC p) = ∑_c 1_{A c}(p.1) · ofReal ((h_c'(p.1) p.2)²)`
  have hpt : ∀ p : E × E, ENNReal.ofReal (SC C hC p.1 p.2)
      = ∑ c ∈ C, (A c).indicator (fun _ => (1 : ℝ≥0∞)) p.1 *
          ENNReal.ofReal (fderiv ℝ (hc c) p.1 p.2 ^ 2) := by
    intro p
    unfold SC
    rw [ENNReal.ofReal_sum_of_nonneg fun c _ => Set.indicator_nonneg (fun _ _ => sq_nonneg _) _]
    refine Finset.sum_congr rfl fun c _ => ?_
    by_cases h : p.1 ∈ A c
    · have h' : (p.1, p.2) ∈ active C hC c := h
      rw [Set.indicator_of_mem h, Set.indicator_of_mem h', one_mul]
    · have h' : (p.1, p.2) ∉ active C hC c := h
      rw [Set.indicator_of_notMem h, Set.indicator_of_notMem h', zero_mul, ENNReal.ofReal_zero]
  have hmeasc : ∀ c, Measurable fun p : E × E =>
      (A c).indicator (fun _ => (1 : ℝ≥0∞)) p.1 * ENNReal.ofReal (fderiv ℝ (hc c) p.1 p.2 ^ 2) :=
    fun c => ((measurable_const.indicator (hAmeas c)).comp measurable_fst).mul
      (ENNReal.measurable_ofReal.comp (measurable_fderiv_hc_apply c))
  simp_rw [hpt]
  rw [lintegral_finsetSum _ fun c _ => hmeasc c]
  -- each term: integrate out `y`
  have hterm : ∀ c ∈ C, ∫⁻ p, (A c).indicator (fun _ => (1 : ℝ≥0∞)) p.1 *
        ENNReal.ofReal (fderiv ℝ (hc c) p.1 p.2 ^ 2) ∂((gaussianE E).prod (gaussianE E))
      = ∫⁻ x, (A c).indicator (fun _ => (1 : ℝ≥0∞)) x *
          ENNReal.ofReal (‖fderiv ℝ (hc c) x‖ ^ 2) ∂(gaussianE E) := by
    intro c _
    rw [lintegral_prod _ (hmeasc c).aemeasurable]
    refine lintegral_congr fun x => ?_
    show ∫⁻ y, (A c).indicator (fun _ => (1 : ℝ≥0∞)) x *
        ENNReal.ofReal (fderiv ℝ (hc c) x y ^ 2) ∂(gaussianE E) = _
    rw [lintegral_const_mul _ (((fderiv ℝ (hc c) x).continuous.measurable.pow_const 2).ennreal_ofReal),
      lintegral_clm_sq_gaussianE hd]
  rw [Finset.sum_congr rfl hterm]
  -- bound each term on the active set, using `x ≠ 0` a.e.
  have hbound : ∀ c ∈ C, ∫⁻ x, (A c).indicator (fun _ => (1 : ℝ≥0∞)) x *
        ENNReal.ofReal (‖fderiv ℝ (hc c) x‖ ^ 2) ∂(gaussianE E)
      ≤ ∫⁻ x, (A c).indicator (fun _ => (1 : ℝ≥0∞)) x *
          (16 * (ENNReal.ofReal (fC C hC x) * ENNReal.ofReal ((‖x‖ ^ 2)⁻¹))) ∂(gaussianE E) := by
    intro c _
    refine lintegral_mono_ae ?_
    filter_upwards [gaussianE_ae_ne_zero (E := E)] with x hx
    by_cases hxA : x ∈ A c
    · rw [Set.indicator_of_mem hxA, one_mul, one_mul]
      have h1 := norm_fderiv_hc_le c hx
      have hxA' : hc c x = fC C hC x := hxA
      have hn : 0 < ‖x‖ := norm_pos_iff.mpr hx
      have h2 : ‖fderiv ℝ (hc c) x‖ ^ 2 ≤ 16 * (fC C hC x * (‖x‖ ^ 2)⁻¹) := by
        have h3 : ‖fderiv ℝ (hc c) x‖ ^ 2 ≤ (2 * (2 * ‖dir x - c‖ / ‖x‖)) ^ 2 :=
          pow_le_pow_left₀ (norm_nonneg _) h1 2
        refine h3.trans (le_of_eq ?_)
        rw [← hxA', hc]
        field_simp
        ring
      calc ENNReal.ofReal (‖fderiv ℝ (hc c) x‖ ^ 2)
          ≤ ENNReal.ofReal (16 * (fC C hC x * (‖x‖ ^ 2)⁻¹)) := ENNReal.ofReal_le_ofReal h2
        _ = 16 * (ENNReal.ofReal (fC C hC x) * ENNReal.ofReal ((‖x‖ ^ 2)⁻¹)) := by
            rw [ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_mul (fC_nonneg C hC x)]
            norm_num
    · rw [Set.indicator_of_notMem hxA, zero_mul, zero_mul]
  refine (Finset.sum_le_sum hbound).trans ?_
  have hm16 : Measurable fun x : E =>
      16 * (ENNReal.ofReal (fC C hC x) * ENNReal.ofReal ((‖x‖ ^ 2)⁻¹)) :=
    measurable_const.mul ((measurable_fC C hC).ennreal_ofReal.mul
      ((measurable_norm.pow_const 2).inv.ennreal_ofReal))
  have hsum : ∫⁻ x, ∑ c ∈ C, (A c).indicator (fun _ => (1 : ℝ≥0∞)) x *
        (16 * (ENNReal.ofReal (fC C hC x) * ENNReal.ofReal ((‖x‖ ^ 2)⁻¹))) ∂(gaussianE E)
      = ∑ c ∈ C, ∫⁻ x, (A c).indicator (fun _ => (1 : ℝ≥0∞)) x *
          (16 * (ENNReal.ofReal (fC C hC x) * ENNReal.ofReal ((‖x‖ ^ 2)⁻¹))) ∂(gaussianE E) :=
    lintegral_finsetSum _ fun c _ => (measurable_const.indicator (hAmeas c)).mul hm16
  have hconst : ∫⁻ x, 16 * (ENNReal.ofReal (fC C hC x) * ENNReal.ofReal ((‖x‖ ^ 2)⁻¹))
        ∂(gaussianE E)
      = 16 * ∫⁻ x, ENNReal.ofReal (fC C hC x) * ENNReal.ofReal ((‖x‖ ^ 2)⁻¹) ∂(gaussianE E) :=
    lintegral_const_mul _ ((measurable_fC C hC).ennreal_ofReal.mul
      ((measurable_norm.pow_const 2).inv.ennreal_ofReal))
  rw [← hsum, ← hconst]
  refine lintegral_mono_ae ?_
  filter_upwards [ae_sum_active_le_one hd C hC] with x hx
  rw [← Finset.sum_mul]
  calc (∑ c ∈ C, (A c).indicator (fun _ => (1 : ℝ≥0∞)) x) *
        (16 * (ENNReal.ofReal (fC C hC x) * ENNReal.ofReal ((‖x‖ ^ 2)⁻¹)))
      ≤ 1 * (16 * (ENNReal.ofReal (fC C hC x) * ENNReal.ofReal ((‖x‖ ^ 2)⁻¹))) :=
        mul_le_mul' hx le_rfl
    _ = _ := by rw [one_mul]

theorem measurable_pathMap :
    Measurable fun q : (E × E) × ℝ => (pathX q.1.1 q.1.2 q.2, pathY q.1.1 q.1.2 q.2) := by
  unfold pathX pathY; fun_prop

theorem measurable_SC_pathMap (C : Finset E) (hC : C.Nonempty) :
    Measurable fun q : (E × E) × ℝ =>
      ENNReal.ofReal (SC C hC (pathX q.1.1 q.1.2 q.2) (pathY q.1.1 q.1.2 q.2)) := by
  have h := Measurable.comp (g := fun p : E × E => SC C hC p.1 p.2)
    (f := fun q : (E × E) × ℝ => (pathX q.1.1 q.1.2 q.2, pathY q.1.1 q.1.2 q.2))
    (measurable_SC C hC) measurable_pathMap
  exact h.ennreal_ofReal

/-- **The Gaussian path bound**: `E (f(X) − f(Y))² ≤ (π/2)² · 16 · E[f(Z)] / (d − 2)` for
`f = fC`, by the Maurey–Pisier rotation, Tonelli, and the `1/‖Z‖²` moment. -/
theorem lintegral_sq_sub_fC_le (hd : 3 ≤ Module.finrank ℝ E) (C : Finset E) (hC : C.Nonempty) :
    ∫⁻ p, ENNReal.ofReal ((fC C hC p.1 - fC C hC p.2) ^ 2) ∂((gaussianE E).prod (gaussianE E))
      ≤ ENNReal.ofReal (Real.pi / 2) * ENNReal.ofReal (Real.pi / 2) *
          (16 * ((∫⁻ x, ENNReal.ofReal (fC C hC x) ∂(gaussianE E)) *
            ENNReal.ofReal (1 / ((Module.finrank ℝ E : ℝ) - 2)))) := by
  have hd2 : 2 ≤ Module.finrank ℝ E := by omega
  have h1 : ∫⁻ p, ENNReal.ofReal ((fC C hC p.1 - fC C hC p.2) ^ 2)
        ∂((gaussianE E).prod (gaussianE E))
      ≤ ENNReal.ofReal (Real.pi / 2) * ∫⁻ p, (∫⁻ θ in Set.Ioc (0 : ℝ) (Real.pi / 2),
          ENNReal.ofReal (SC C hC (pathX p.1 p.2 θ) (pathY p.1 p.2 θ)))
          ∂((gaussianE E).prod (gaussianE E)) := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_mono_ae ?_
    filter_upwards [ae_good hd2] with p hp
    have := ofReal_sq_sub_fC_le C hC hp
    rwa [show (fC C hC p.2 - fC C hC p.1) ^ 2 = (fC C hC p.1 - fC C hC p.2) ^ 2 by ring] at this
  have h2 : ∫⁻ p, (∫⁻ θ in Set.Ioc (0 : ℝ) (Real.pi / 2),
        ENNReal.ofReal (SC C hC (pathX p.1 p.2 θ) (pathY p.1 p.2 θ)))
        ∂((gaussianE E).prod (gaussianE E))
      = ∫⁻ θ in Set.Ioc (0 : ℝ) (Real.pi / 2), (∫⁻ p,
          ENNReal.ofReal (SC C hC (pathX p.1 p.2 θ) (pathY p.1 p.2 θ))
          ∂((gaussianE E).prod (gaussianE E))) :=
    lintegral_lintegral_swap (measurable_SC_pathMap C hC).aemeasurable
  have h3 : ∀ θ : ℝ, ∫⁻ p, ENNReal.ofReal (SC C hC (pathX p.1 p.2 θ) (pathY p.1 p.2 θ))
        ∂((gaussianE E).prod (gaussianE E))
      = ∫⁻ p, ENNReal.ofReal (SC C hC p.1 p.2) ∂((gaussianE E).prod (gaussianE E)) := fun θ =>
    (measurePreserving_rotProd θ).lintegral_comp
      (f := fun p : E × E => ENNReal.ofReal (SC C hC p.1 p.2)) (measurable_SC C hC).ennreal_ofReal
  have h4 : ∫⁻ _ in Set.Ioc (0 : ℝ) (Real.pi / 2),
        (∫⁻ p, ENNReal.ofReal (SC C hC p.1 p.2) ∂((gaussianE E).prod (gaussianE E)))
      = ENNReal.ofReal (Real.pi / 2) *
          ∫⁻ p, ENNReal.ofReal (SC C hC p.1 p.2) ∂((gaussianE E).prod (gaussianE E)) := by
    rw [lintegral_const, Measure.restrict_apply_univ, Real.volume_Ioc, sub_zero, mul_comm]
  have h6 : ∫⁻ x, ENNReal.ofReal (fC C hC x) * ENNReal.ofReal ((‖x‖ ^ 2)⁻¹) ∂(gaussianE E)
      = (∫⁻ x, ENNReal.ofReal (fC C hC x) ∂(gaussianE E)) *
          ENNReal.ofReal (1 / ((Module.finrank ℝ E : ℝ) - 2)) := by
    have := lintegral_gaussianE_dir_div_normSq hd (ψ := fun u => ENNReal.ofReal (fC C hC u))
      (measurable_fC C hC).ennreal_ofReal
    simp only [fC_dir] at this
    rw [this, ← measurePreserving_dir.lintegral_comp (f := fun u => ENNReal.ofReal (fC C hC u))
      (measurable_fC C hC).ennreal_ofReal]
    simp only [fC_dir]
  calc _ ≤ _ := h1
    _ = ENNReal.ofReal (Real.pi / 2) * (ENNReal.ofReal (Real.pi / 2) *
          ∫⁻ p, ENNReal.ofReal (SC C hC p.1 p.2) ∂((gaussianE E).prod (gaussianE E))) := by
        rw [h2]; simp_rw [h3]; rw [h4]
    _ ≤ ENNReal.ofReal (Real.pi / 2) * (ENNReal.ofReal (Real.pi / 2) *
          (16 * ((∫⁻ x, ENNReal.ofReal (fC C hC x) ∂(gaussianE E)) *
            ENNReal.ofReal (1 / ((Module.finrank ℝ E : ℝ) - 2))))) := by
        refine mul_le_mul' le_rfl (mul_le_mul' le_rfl ?_)
        rw [← h6]; exact lintegral_SC_le hd2 C hC
    _ = _ := by ring

theorem norm_dir_le_one (z : E) : ‖dir z‖ ≤ 1 := by
  rcases eq_or_ne z 0 with rfl | hz
  · simp [dir]
  · rw [dir, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (norm_ne_zero_iff.mpr hz)]

theorem fC_le (C : Finset E) (hC : C.Nonempty) (z : E) :
    fC C hC z ≤ (1 + C.sup' hC (fun c => ‖c‖)) ^ 2 := by
  have hmem := hC.choose_spec
  calc fC C hC z ≤ hc hC.choose z := Finset.inf'_le _ hmem
    _ = ‖dir z - hC.choose‖ ^ 2 := rfl
    _ ≤ (‖dir z‖ + ‖hC.choose‖) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) (norm_sub_le _ _) 2
    _ ≤ (1 + C.sup' hC (fun c => ‖c‖)) ^ 2 := by
        gcongr
        · exact norm_dir_le_one z
        · exact Finset.le_sup' (fun c => ‖c‖) hmem

theorem memLp_fC (C : Finset E) (hC : C.Nonempty) : MemLp (fC C hC) 2 (gaussianE E) :=
  MemLp.of_bound (measurable_fC C hC).aestronglyMeasurable _
    (Filter.Eventually.of_forall fun z => by
      rw [Real.norm_eq_abs, abs_of_nonneg (fC_nonneg C hC z)]; exact fC_le C hC z)

theorem lintegral_fC_ne_top (C : Finset E) (hC : C.Nonempty) :
    ∫⁻ x, ENNReal.ofReal (fC C hC x) ∂(gaussianE E) ≠ ⊤ := by
  refine ne_top_of_le_ne_top (b := ENNReal.ofReal ((1 + C.sup' hC (fun c => ‖c‖)) ^ 2) *
    gaussianE E Set.univ) (ENNReal.mul_ne_top ENNReal.ofReal_ne_top (measure_ne_top _ _)) ?_
  rw [← lintegral_const]
  exact lintegral_mono fun z => ENNReal.ofReal_le_ofReal (fC_le C hC z)

/-- **The Gaussian Poincaré inequality for the squared distance to a finite codebook**, with
the explicit constant `2π²/(d − 2)`: `Var_γ fC ≤ 2π²/(d − 2) · E_γ fC`. -/
theorem variance_fC_le (hd : 3 ≤ Module.finrank ℝ E) (C : Finset E) (hC : C.Nonempty) :
    variance (fC C hC) (gaussianE E)
      ≤ 2 * Real.pi ^ 2 / ((Module.finrank ℝ E : ℝ) - 2) * ∫ x, fC C hC x ∂(gaussianE E) := by
  have hd' : (0 : ℝ) < (Module.finrank ℝ E : ℝ) - 2 := by
    have : (3 : ℝ) ≤ Module.finrank ℝ E := by exact_mod_cast hd
    linarith
  have hdne := hd'.ne'
  rw [variance_eq_half_integral_prod (memLp_fC C hC)]
  have hnn : 0 ≤ᵐ[(gaussianE E).prod (gaussianE E)]
      fun p : E × E => (fC C hC p.1 - fC C hC p.2) ^ 2 :=
    Filter.Eventually.of_forall fun p => sq_nonneg _
  have hmeas : AEStronglyMeasurable (fun p : E × E => (fC C hC p.1 - fC C hC p.2) ^ 2)
      ((gaussianE E).prod (gaussianE E)) :=
    ((((measurable_fC C hC).comp measurable_fst).sub
      ((measurable_fC C hC).comp measurable_snd)).pow_const 2).aestronglyMeasurable
  rw [integral_eq_lintegral_of_nonneg_ae hnn hmeas]
  have hI : ∫ x, fC C hC x ∂(gaussianE E)
      = (∫⁻ x, ENNReal.ofReal (fC C hC x) ∂(gaussianE E)).toReal :=
    integral_eq_lintegral_of_nonneg_ae (Filter.Eventually.of_forall (fC_nonneg C hC))
      (measurable_fC C hC).aestronglyMeasurable
  have hRne : ENNReal.ofReal (Real.pi / 2) * ENNReal.ofReal (Real.pi / 2) *
      (16 * ((∫⁻ x, ENNReal.ofReal (fC C hC x) ∂(gaussianE E)) *
        ENNReal.ofReal (1 / ((Module.finrank ℝ E : ℝ) - 2)))) ≠ ⊤ :=
    ENNReal.mul_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top)
      (ENNReal.mul_ne_top (by simp)
        (ENNReal.mul_ne_top (lintegral_fC_ne_top C hC) ENNReal.ofReal_ne_top))
  have hle := ENNReal.toReal_mono hRne (lintegral_sq_sub_fC_le hd C hC)
  simp only [ENNReal.toReal_mul, ENNReal.toReal_ofNat] at hle
  rw [ENNReal.toReal_ofReal (by positivity), ENNReal.toReal_ofReal (one_div_nonneg.mpr hd'.le),
    ← hI] at hle
  calc (1 / 2 : ℝ) * _ ≤ (1 / 2) * (Real.pi / 2 * (Real.pi / 2) *
        (16 * ((∫ x, fC C hC x ∂(gaussianE E)) * (1 / ((Module.finrank ℝ E : ℝ) - 2))))) :=
        mul_le_mul_of_nonneg_left hle (by norm_num)
    _ = _ := by field_simp; ring

theorem fC_eq_of_isNearest {q : E → E} (C : Finset E) (hC : C.Nonempty)
    (hq : IsNearest (C : Set E) q) (z : E) : fC C hC z = ‖dir z - q (dir z)‖ ^ 2 := by
  obtain ⟨hmem, hmin⟩ := hq (dir z)
  refine le_antisymm (Finset.inf'_le _ (Finset.mem_coe.mp hmem))
    (Finset.le_inf' hC _ fun c hc' => ?_)
  exact pow_le_pow_left₀ (norm_nonneg _) (hmin c (Finset.mem_coe.mpr hc')) 2

/-- **The variance bound for a finite codebook on the sphere**, with the explicit constant
`2π²/(d − 2)`: `Var_σ ‖u − q u‖² ≤ 2π²/(d − 2) · ρ²`, `ρ² = stageDistortion q σ`. -/
theorem variance_stageErr_le_finite (hd : 3 ≤ Module.finrank ℝ E) {q : E → E} (C : Finset E)
    (hC : C.Nonempty) (hq : IsNearest (C : Set E) q) (hmeas : Measurable q) :
    variance (fun u => ‖u - q u‖ ^ 2) (sphereUniformAmbient E)
      ≤ 2 * Real.pi ^ 2 / ((Module.finrank ℝ E : ℝ) - 2) *
          stageDistortion q (sphereUniformAmbient E) := by
  have hF : Measurable fun x : E => ‖x - q x‖ ^ 2 := (measurable_id.sub hmeas).norm.pow_const 2
  have hcomp : (fun x : E => ‖x - q x‖ ^ 2) ∘ dir = fC C hC := by
    funext z; simp only [Function.comp]; rw [fC_eq_of_isNearest C hC hq]
  have hint : ∫ x, ‖dir x - q (dir x)‖ ^ 2 ∂(gaussianE E) = ∫ x, fC C hC x ∂(gaussianE E) :=
    integral_congr_ae (Filter.Eventually.of_forall fun z => (fC_eq_of_isNearest C hC hq z).symm)
  rw [← gaussianE_map_dir, variance_map (by rw [gaussianE_map_dir]; exact hF.aemeasurable)
    measurable_dir.aemeasurable, hcomp, stageDistortion, integral_map measurable_dir.aemeasurable
    (by rw [gaussianE_map_dir]; exact hF.aestronglyMeasurable), hint]
  exact variance_fC_le hd C hC

end Assembly

section StreamFinite

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E] [FiniteDimensional ℝ E]
variable {G : Type*} [Group G] [MeasurableSpace G] [MulAction G E] [MeasurableSMul₂ G E]
  [MeasurableInv G] [MeasurableMul G]
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
variable {ι : G → (E ≃ₗᵢ[ℝ] E)} {q : E → E} {W : Ω → E} {R : Ω → ℕ → G} {κ : Measure G}
  [κ.IsMulRightInvariant] {x₀ : E}

/-- **The per-pass variance bound on the stream for a finite codebook**, with constant
`2π²/(d − 2)` and no Poincaré hypothesis. -/
theorem variance_stageErrSq_le_finite (hd : 3 ≤ Module.finrank ℝ E)
    (h : RotationStream ι q W R κ x₀ μ) (hx₀ : ‖x₀‖ = 1) (C : Finset E) (hC : C.Nonempty)
    (hq : IsNearest (C : Set E) q) (p : ℕ) :
    variance (fun ω => stageErrSq (rotScheme ι q (R ω)) (W ω) p) μ
      ≤ 2 * Real.pi ^ 2 / ((Module.finrank ℝ E : ℝ) - 2) *
          stageDistortion q (sphereUniformAmbient E) := by
  haveI : Nontrivial E := ⟨⟨x₀, 0, by rintro rfl; simp at hx₀⟩⟩
  have hmp := measurePreserving_unitVec_stream h hx₀ p
  have hF : Measurable fun x : E => ‖x - q x‖ ^ 2 := (measurable_id.sub h.meas_q).norm.pow_const 2
  have heq : (fun ω => stageErrSq (rotScheme ι q (R ω)) (W ω) p)
      = (fun x : E => ‖x - q x‖ ^ 2) ∘ (fun ω => unitVec (rotScheme ι q (R ω)) (W ω) p) := rfl
  rw [heq, ← variance_map (by rw [hmp.map_eq]; exact hF.aemeasurable) hmp.measurable.aemeasurable,
    hmp.map_eq]
  exact variance_stageErr_le_finite hd C hC hq h.meas_q

/-- **Concentration of the decay law for a finite codebook, with no unproved hypothesis.**
For a nearest-codeword stage with a finite codebook in dimension `d ≥ 3` and `P` passes of a
rotation stream, the `P`-pass squared error lies within the compounded band
`(1 ± ε)^P ρ^{2P}‖w‖²` except on an event of probability at most `P · 2π² / ((d − 2) ε² ρ²)`.
This is the paper's Remark (Concentration) with its rate `P/(d ε² ρ²)` made explicit, for
scalar, `E8`, and trellis codebooks alike, and it is proved outright. -/
theorem meas_not_decayWithin_le_finite (hd : 3 ≤ Module.finrank ℝ E)
    (h : RotationStream ι q W R κ x₀ μ) (hx₀ : ‖x₀‖ = 1) (C : Finset E) (hC : C.Nonempty)
    (hq : IsNearest (C : Set E) q) {ε : ℝ} (hε0 : 0 < ε) (hε1 : ε ≤ 1)
    (hρ : 0 < stageDistortion q (sphereUniformAmbient E)) (P : ℕ) :
    μ {ω | ¬ DecayWithin (rotScheme ι q (R ω)) (W ω)
        (Real.sqrt (stageDistortion q (sphereUniformAmbient E))) ε P}
      ≤ P * ENNReal.ofReal (2 * Real.pi ^ 2 / (((Module.finrank ℝ E : ℝ) - 2) * ε ^ 2 *
          stageDistortion q (sphereUniformAmbient E))) := by
  haveI : Nontrivial E := ⟨⟨x₀, 0, by rintro rfl; simp at hx₀⟩⟩
  have hCb : Bornology.IsBounded (C : Set E) := C.finite_toSet.isBounded
  set D := stageDistortion q (sphereUniformAmbient E) with hD
  have hρ2 : Real.sqrt D ^ 2 = D := Real.sq_sqrt hρ.le
  have hmem : ∀ p < P, MemLp (fun ω => stageErrSq (rotScheme ι q (R ω)) (W ω) p) 2 μ := fun p _ =>
    (memLp_stageErr_of_bounded hq hCb h.meas_q).comp_measurePreserving
      (measurePreserving_unitVec_stream h hx₀ p)
  have hmean : ∀ p < P, ∫ ω, stageErrSq (rotScheme ι q (R ω)) (W ω) p ∂μ = Real.sqrt D ^ 2 := by
    intro p _
    rw [hρ2, hD, ← h.orbitLaw_eq hx₀]
    exact integral_stageErr_eq_stageDistortion h p
  have hvar : ∀ p < P, variance (fun ω => stageErrSq (rotScheme ι q (R ω)) (W ω) p) μ
      ≤ 2 * Real.pi ^ 2 / ((Module.finrank ℝ E : ℝ) - 2) * D := fun p _ =>
    variance_stageErrSq_le_finite hd h hx₀ C hC hq p
  have hρne : Real.sqrt D ≠ 0 := (Real.sqrt_pos.mpr hρ).ne'
  have key := meas_not_decayWithin_le_of_variance hε0 hε1 hρne hmem hmean hvar
  have hD0 : D ≠ 0 := hρ.ne'
  have hε : ε ≠ 0 := hε0.ne'
  have hd' : ((Module.finrank ℝ E : ℝ) - 2) ≠ 0 := by
    have : (3 : ℝ) ≤ Module.finrank ℝ E := by exact_mod_cast hd
    linarith
  have hconst : 2 * Real.pi ^ 2 / ((Module.finrank ℝ E : ℝ) - 2) * D / (ε * Real.sqrt D ^ 2) ^ 2
      = 2 * Real.pi ^ 2 / (((Module.finrank ℝ E : ℝ) - 2) * ε ^ 2 * D) := by
    rw [hρ2]; field_simp
  rw [← hconst]; exact key

end StreamFinite
/-! ## §31  The Dunkl–Williams inequality and the sharp slope of `h_c`

§29 bounded the derivative of `h_c(z) = ‖z/‖z‖ − c‖²` by `4‖z/‖z‖ − c‖/‖z‖`, twice the true
value, because it went through a two-point Lipschitz estimate with a symmetric slope.  This
section proves the sharp bound `2‖z/‖z‖ − c‖/‖z‖` (`norm_fderiv_hc_le_sharp`) from the
Dunkl–Williams inequality in an inner product space, `‖z/‖z‖ − w/‖w‖‖ ≤ 2‖z − w‖/(‖z‖ + ‖w‖)`
(`norm_dir_sub_dir_le_dunkl`), whose right side has the exact slope `1/‖z‖` at `w = z`. -/

section DunklWilliams

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

theorem norm_dir_of_ne_zero {z : E} (hz : z ≠ 0) : ‖dir z‖ = 1 := by
  rw [dir, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (norm_ne_zero_iff.mpr hz)]

theorem inner_dir_dir (z w : E) : ⟪dir z, dir w⟫_ℝ = ‖z‖⁻¹ * ‖w‖⁻¹ * ⟪z, w⟫_ℝ := by
  simp only [dir, real_inner_smul_left, real_inner_smul_right]; ring

/-- **The Dunkl–Williams inequality** in an inner product space:
`‖z/‖z‖ − w/‖w‖‖ ≤ 2‖z − w‖/(‖z‖ + ‖w‖)`. -/
theorem norm_dir_sub_dir_le_dunkl {z w : E} (hz : z ≠ 0) (hw : w ≠ 0) :
    ‖dir z - dir w‖ ≤ 2 * ‖z - w‖ / (‖z‖ + ‖w‖) := by
  have ha : 0 < ‖z‖ := norm_pos_iff.mpr hz
  have hb : 0 < ‖w‖ := norm_pos_iff.mpr hw
  set c := ⟪dir z, dir w⟫_ℝ with hc
  have hc1 : |c| ≤ 1 := by
    have := abs_real_inner_le_norm (dir z) (dir w)
    rwa [norm_dir_of_ne_zero hz, norm_dir_of_ne_zero hw, one_mul] at this
  have hl : ‖dir z - dir w‖ ^ 2 = 2 - 2 * c := by
    rw [norm_sub_sq_real, norm_dir_of_ne_zero hz, norm_dir_of_ne_zero hw]; ring
  have hr : ‖z - w‖ ^ 2 = ‖z‖ ^ 2 + ‖w‖ ^ 2 - 2 * (‖z‖ * ‖w‖ * c) := by
    rw [norm_sub_sq_real, hc, inner_dir_dir]; field_simp; ring
  have hsq : ‖dir z - dir w‖ ^ 2 ≤ (2 * ‖z - w‖ / (‖z‖ + ‖w‖)) ^ 2 := by
    rw [div_pow, mul_pow, hr, hl, le_div_iff₀ (by positivity)]
    have hc' := (abs_le.mp hc1).1
    nlinarith [mul_nonneg (by linarith : (0 : ℝ) ≤ 1 + c) (sq_nonneg (‖z‖ - ‖w‖))]
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).mp hsq

/-- `‖p‖² − ‖q‖² = ⟪p − q, p + q⟫`. -/
theorem norm_sq_sub_norm_sq (p q : E) : ‖p‖ ^ 2 - ‖q‖ ^ 2 = ⟪p - q, p + q⟫_ℝ := by
  rw [← real_inner_self_eq_norm_sq, ← real_inner_self_eq_norm_sq, inner_sub_left, inner_add_right,
    inner_add_right, real_inner_comm p q]; ring

/-- **The sharp two-point bound** for `h_c`: the slope between `z` and `w` is at most
`2(‖dir z − c‖ + ‖dir w − c‖)/(‖z‖ + ‖w‖)`. -/
theorem abs_hc_sub_le_sharp (c : E) {z w : E} (hz : z ≠ 0) (hw : w ≠ 0) :
    |hc c z - hc c w| ≤ ‖z - w‖ * (2 * (‖dir z - c‖ + ‖dir w - c‖) / (‖z‖ + ‖w‖)) := by
  have h1 : hc c z - hc c w = ⟪dir z - dir w, (dir z - c) + (dir w - c)⟫_ℝ := by
    unfold hc
    rw [norm_sq_sub_norm_sq]; congr 1; abel
  rw [h1]
  calc |⟪dir z - dir w, (dir z - c) + (dir w - c)⟫_ℝ|
      ≤ ‖dir z - dir w‖ * ‖(dir z - c) + (dir w - c)‖ := abs_real_inner_le_norm _ _
    _ ≤ (2 * ‖z - w‖ / (‖z‖ + ‖w‖)) * (‖dir z - c‖ + ‖dir w - c‖) :=
        mul_le_mul (norm_dir_sub_dir_le_dunkl hz hw) (norm_add_le _ _) (norm_nonneg _)
          (by positivity)
    _ = _ := by ring

/-- **The sharp derivative bound** `‖h_c'(z)‖ ≤ 2‖dir z − c‖/‖z‖`. -/
theorem norm_fderiv_hc_le_sharp [FiniteDimensional ℝ E] (c : E) {z : E} (hz : z ≠ 0) :
    ‖fderiv ℝ (hc c) z‖ ≤ 2 * ‖dir z - c‖ / ‖z‖ := by
  have hz' : 0 < ‖z‖ := norm_pos_iff.mpr hz
  refine le_of_forall_pos_le_add fun ε hε => ?_
  have hK : ContinuousAt (fun w : E => 2 * (‖dir w - c‖ + ‖dir z - c‖) / (‖w‖ + ‖z‖)) z := by
    have hd : ContinuousAt (dir : E → E) z := (contDiffAt_dir hz).continuousAt
    exact (continuousAt_const.mul ((hd.sub continuousAt_const).norm.add continuousAt_const)).div
      (continuous_norm.continuousAt.add continuousAt_const) (by positivity)
  have hKz : (fun w : E => 2 * (‖dir w - c‖ + ‖dir z - c‖) / (‖w‖ + ‖z‖)) z
      = 2 * ‖dir z - c‖ / ‖z‖ := by
    simp only; field_simp
  have hev : ∀ᶠ w in 𝓝 z, ‖hc c w - hc c z‖ ≤ (2 * ‖dir z - c‖ / ‖z‖ + ε) * ‖w - z‖ := by
    have hlt : ∀ᶠ w in 𝓝 z,
        2 * (‖dir w - c‖ + ‖dir z - c‖) / (‖w‖ + ‖z‖) < 2 * ‖dir z - c‖ / ‖z‖ + ε :=
      hK (Iio_mem_nhds (by rw [hKz]; linarith))
    filter_upwards [hlt, isOpen_ne.mem_nhds hz] with w hw hw0
    rw [Real.norm_eq_abs]
    calc |hc c w - hc c z| ≤ ‖w - z‖ * (2 * (‖dir w - c‖ + ‖dir z - c‖) / (‖w‖ + ‖z‖)) :=
          abs_hc_sub_le_sharp c hw0 hz
      _ ≤ ‖w - z‖ * (2 * ‖dir z - c‖ / ‖z‖ + ε) :=
          mul_le_mul_of_nonneg_left hw.le (norm_nonneg _)
      _ = _ := mul_comm _ _
  exact (differentiableAt_hc c hz).hasFDerivAt.le_of_lip' (by positivity) hev

end DunklWilliams
/-! ## §32  The Gaussian Poincaré inequality with constant one

For a bounded `C¹` function `g` with bounded derivative, `Var_γ g ≤ E‖g'‖²`
(`variance_le_integral_norm_fderiv_sq`), with the sharp constant `1`.  The proof is the
covariance identity of the Ornstein–Uhlenbeck semigroup, done pathwise:
`−Var g = ∫₀^{π/2} E[g(X) g'(X_θ)[Y_θ]] dθ` for independent Gaussian `X, Y` and the rotation
`X_θ = cos θ·X + sin θ·Y` (Steps A and B), and for each `θ` an integration by parts in the
Gaussian variable turns `g(X) g'(X_θ)[Y_θ]` into `−sin θ · ⟨g'(X), g'(X_θ)⟩` (Step C).  The
integration by parts itself is proved by rotating an auxiliary Gaussian `W` against `Y_θ`
and differentiating along the rotation: no Gaussian integration by parts is taken from
Mathlib, only the invariance of `γ ⊗ γ` under rotations (§27).  Cauchy–Schwarz in the form
`ab ≤ (a² + b²)/2` and `∫₀^{π/2} sin θ dθ = 1` finish (Step D).  All integrability is by
polynomial bounds in the Gaussian variables. -/

section ProdHelpers

variable {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]

/-- Integrability on a product from a uniform bound on the slice `lintegral`s. -/
theorem integrable_prod_of_slice {μ : Measure α} {ν : Measure β} [SFinite μ] [IsFiniteMeasure ν]
    {F : α × β → ℝ} (hF : AEStronglyMeasurable F (μ.prod ν)) {B : ℝ≥0∞} (hB : B ≠ ⊤)
    (h : ∀ y, ∫⁻ x, ‖F (x, y)‖ₑ ∂μ ≤ B) : Integrable F (μ.prod ν) := by
  refine ⟨hF, ?_⟩
  rw [hasFiniteIntegral_iff_enorm, lintegral_prod_symm _ hF.enorm]
  calc ∫⁻ y, ∫⁻ x, ‖F (x, y)‖ₑ ∂μ ∂ν ≤ ∫⁻ _, B ∂ν := lintegral_mono fun y => h y
    _ = B * ν Set.univ := lintegral_const _
    _ < ⊤ := ENNReal.mul_lt_top hB.lt_top (measure_lt_top _ _)

theorem lintegral_fst_prod {μ : Measure α} {ν : Measure β} [IsProbabilityMeasure ν] [SFinite μ]
    {F : α → ℝ≥0∞} (hF : Measurable F) : ∫⁻ p, F p.1 ∂(μ.prod ν) = ∫⁻ x, F x ∂μ := by
  rw [← lintegral_map hF measurable_fst, Measure.map_fst_prod, measure_univ, one_smul]

theorem lintegral_snd_prod {μ : Measure α} {ν : Measure β} [IsProbabilityMeasure μ] [SFinite ν]
    {F : β → ℝ≥0∞} (hF : Measurable F) : ∫⁻ p, F p.2 ∂(μ.prod ν) = ∫⁻ y, F y ∂ν := by
  rw [← lintegral_map hF measurable_snd, Measure.map_snd_prod, measure_univ, one_smul]

theorem integral_fst_prod {μ : Measure α} {ν : Measure β} [IsProbabilityMeasure ν] [SFinite μ]
    {F : α → ℝ} (hF : AEStronglyMeasurable F μ) : ∫ p, F p.1 ∂(μ.prod ν) = ∫ x, F x ∂μ := by
  have := integral_map (μ := μ.prod ν) (φ := Prod.fst) measurable_fst.aemeasurable (f := F)
    (by rw [Measure.map_fst_prod, measure_univ, one_smul]; exact hF)
  rw [Measure.map_fst_prod, measure_univ, one_smul] at this
  exact this.symm

theorem integral_snd_prod {μ : Measure α} {ν : Measure β} [IsProbabilityMeasure μ] [SFinite ν]
    {F : β → ℝ} (hF : AEStronglyMeasurable F ν) : ∫ p, F p.2 ∂(μ.prod ν) = ∫ y, F y ∂ν := by
  have := integral_map (μ := μ.prod ν) (φ := Prod.snd) measurable_snd.aemeasurable (f := F)
    (by rw [Measure.map_snd_prod, measure_univ, one_smul]; exact hF)
  rw [Measure.map_snd_prod, measure_univ, one_smul] at this
  exact this.symm

end ProdHelpers

section PathMore

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]

theorem norm_pathX_le (x y : E) (θ : ℝ) : ‖pathX x y θ‖ ≤ ‖x‖ + ‖y‖ := by
  unfold pathX
  calc ‖Real.cos θ • x + Real.sin θ • y‖ ≤ ‖Real.cos θ • x‖ + ‖Real.sin θ • y‖ := norm_add_le _ _
    _ ≤ ‖x‖ + ‖y‖ := by
        rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs]
        gcongr
        · exact mul_le_of_le_one_left (norm_nonneg _) (Real.abs_cos_le_one θ)
        · exact mul_le_of_le_one_left (norm_nonneg _) (Real.abs_sin_le_one θ)

theorem norm_pathY_le (x y : E) (θ : ℝ) : ‖pathY x y θ‖ ≤ ‖x‖ + ‖y‖ := by
  unfold pathY
  calc ‖-Real.sin θ • x + Real.cos θ • y‖ ≤ ‖-Real.sin θ • x‖ + ‖Real.cos θ • y‖ := norm_add_le _ _
    _ ≤ ‖x‖ + ‖y‖ := by
        rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs, abs_neg]
        gcongr
        · exact mul_le_of_le_one_left (norm_nonneg _) (Real.abs_sin_le_one θ)
        · exact mul_le_of_le_one_left (norm_nonneg _) (Real.abs_cos_le_one θ)

theorem hasDerivAt_pathY (x y : E) (θ : ℝ) : HasDerivAt (pathY x y) (-pathX x y θ) θ := by
  have h : HasDerivAt (fun t => -(Real.sin t • x) + Real.cos t • y)
      (-(Real.cos θ • x) + -Real.sin θ • y) θ :=
    ((Real.hasDerivAt_sin θ).smul_const x).neg.add ((Real.hasDerivAt_cos θ).smul_const y)
  have e1 : (fun t => -(Real.sin t • x) + Real.cos t • y) = pathY x y := by
    funext t; rw [pathY, neg_smul]
  have e2 : -(Real.cos θ • x) + -Real.sin θ • y = -pathX x y θ := by
    rw [pathX, neg_smul, neg_add]
  rw [e1, e2] at h; exact h

theorem pathY_zero (x y : E) : pathY x y 0 = y := by simp [pathY]

theorem pathY_pi_div_two (x y : E) : pathY x y (Real.pi / 2) = -x := by simp [pathY]

theorem contDiff_pathY (x y : E) : ContDiff ℝ 1 (pathY x y) := by
  unfold pathY
  exact ((Real.contDiff_sin.neg).smul contDiff_const).add (Real.contDiff_cos.smul contDiff_const)

/-- Rotating back by `−θ` recovers the first point. -/
theorem pathX_rot_neg (x y : E) (θ : ℝ) : pathX (pathX x y θ) (pathY x y θ) (-θ) = x := by
  unfold pathX pathY
  simp only [Real.cos_neg, Real.sin_neg, smul_add, smul_smul, neg_smul, smul_neg, neg_neg]
  linear_combination (norm := module) (Real.cos_sq_add_sin_sq θ) • x

end PathMore

section C1Poincare

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E] [SecondCountableTopology E]

theorem measurable_fderiv_apply₂ {g : E → ℝ} {X : Type*} [MeasurableSpace X] {a b : X → E}
    (ha : Measurable a) (hb : Measurable b) : Measurable fun t => fderiv ℝ g (a t) (b t) :=
  Continuous.measurable2 (c := fun (L : E →L[ℝ] ℝ) (v : E) => L v)
    isBoundedBilinearMap_apply.continuous ((measurable_fderiv ℝ g).comp ha) hb

theorem measurable_pathX_apply {X : Type*} [MeasurableSpace X] {a b : X → E} (ha : Measurable a)
    (hb : Measurable b) (θ : ℝ) : Measurable fun t => pathX (a t) (b t) θ := by
  unfold pathX; fun_prop

theorem measurable_pathY_apply {X : Type*} [MeasurableSpace X] {a b : X → E} (ha : Measurable a)
    (hb : Measurable b) (θ : ℝ) : Measurable fun t => pathY (a t) (b t) θ := by
  unfold pathY; fun_prop

variable {g : E → ℝ} {M K : ℝ}

theorem abs_fderiv_path_le (hK : ∀ z, ‖fderiv ℝ g z‖ ≤ K) (x y : E) (θ : ℝ) :
    |fderiv ℝ g (pathX x y θ) (pathY x y θ)| ≤ K * (‖x‖ + ‖y‖) := by
  rw [← Real.norm_eq_abs]
  calc ‖fderiv ℝ g (pathX x y θ) (pathY x y θ)‖
      ≤ ‖fderiv ℝ g (pathX x y θ)‖ * ‖pathY x y θ‖ := ContinuousLinearMap.le_opNorm _ _
    _ ≤ K * (‖x‖ + ‖y‖) := mul_le_mul (hK _) (norm_pathY_le x y θ) (norm_nonneg _)
        ((norm_nonneg _).trans (hK 0))

/-- **Step A: the path formula** `g(y) − g(x) = ∫₀^{π/2} g'(X_θ)[Y_θ] dθ`. -/
theorem sub_eq_integral_path (hg : Differentiable ℝ g) (hK : ∀ z, ‖fderiv ℝ g z‖ ≤ K) (x y : E) :
    g y - g x = ∫ θ in (0 : ℝ)..(Real.pi / 2), fderiv ℝ g (pathX x y θ) (pathY x y θ) := by
  have hpi : (0 : ℝ) ≤ Real.pi / 2 := by positivity
  have hder : ∀ θ ∈ Set.uIcc (0 : ℝ) (Real.pi / 2), HasDerivAt (fun θ => g (pathX x y θ))
      (fderiv ℝ g (pathX x y θ) (pathY x y θ)) θ := fun θ _ =>
    (hg (pathX x y θ)).hasFDerivAt.comp_hasDerivAt θ (hasDerivAt_pathX x y θ)
  have hint : IntervalIntegrable (fun θ => fderiv ℝ g (pathX x y θ) (pathY x y θ)) volume 0
      (Real.pi / 2) := by
    rw [intervalIntegrable_iff_integrableOn_Ioc_of_le hpi]
    refine Measure.integrableOn_of_bounded (M := K * (‖x‖ + ‖y‖)) measure_Ioc_lt_top.ne
      (measurable_fderiv_apply₂ (contDiff_pathX x y).continuous.measurable
        (contDiff_pathY x y).continuous.measurable).aestronglyMeasurable
      (Filter.Eventually.of_forall fun θ => ?_)
    rw [Real.norm_eq_abs]; exact abs_fderiv_path_le hK x y θ
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hder hint, pathX_pi_div_two, pathX_zero]


theorem integrable_of_bound_gauss {X : Type*} [MeasurableSpace X]
    {μ : Measure X} [IsFiniteMeasure μ] {F : X → ℝ} (hF : AEStronglyMeasurable F μ) (C : ℝ)
    (h : ∀ x, |F x| ≤ C) : Integrable F μ :=
  Integrable.of_bound hF C (Filter.Eventually.of_forall fun x => by rw [Real.norm_eq_abs]; exact h x)

/-- `−Var g = E[g(X)(g(Y) − g(X))]` for independent copies. -/
theorem neg_variance_eq_integral_prod (hg : Differentiable ℝ g) (hM : ∀ z, |g z| ≤ M) :
    -variance g (gaussianE E)
      = ∫ p, g p.1 * (g p.2 - g p.1) ∂((gaussianE E).prod (gaussianE E)) := by
  have hgm : Measurable g := hg.continuous.measurable
  have hmem : MemLp g 2 (gaussianE E) :=
    MemLp.of_bound hgm.aestronglyMeasurable M (Filter.Eventually.of_forall fun z => by
      rw [Real.norm_eq_abs]; exact hM z)
  rw [variance_eq_half_integral_prod hmem]
  have hb : ∀ p : E × E, (g p.1 - g p.2) ^ 2
      = g p.1 * (g p.1 - g p.2) + g p.2 * (g p.2 - g p.1) := fun p => by ring
  simp_rw [hb]
  have h1 : Integrable (fun p : E × E => g p.1 * (g p.1 - g p.2)) ((gaussianE E).prod (gaussianE E)) :=
    integrable_of_bound_gauss (((hgm.comp measurable_fst).mul
      ((hgm.comp measurable_fst).sub (hgm.comp measurable_snd))).aestronglyMeasurable) (M * (2 * M))
      fun p => by
        rw [abs_mul]
        exact mul_le_mul (hM _) ((abs_sub _ _).trans (by linarith [hM p.1, hM p.2])) (abs_nonneg _)
          ((abs_nonneg _).trans (hM 0))
  have h2 : Integrable (fun p : E × E => g p.2 * (g p.2 - g p.1)) ((gaussianE E).prod (gaussianE E)) :=
    integrable_of_bound_gauss (((hgm.comp measurable_snd).mul
      ((hgm.comp measurable_snd).sub (hgm.comp measurable_fst))).aestronglyMeasurable) (M * (2 * M))
      fun p => by
        rw [abs_mul]
        exact mul_le_mul (hM _) ((abs_sub _ _).trans (by linarith [hM p.1, hM p.2])) (abs_nonneg _)
          ((abs_nonneg _).trans (hM 0))
  rw [integral_add h1 h2]
  have hswap : ∫ p, g p.2 * (g p.2 - g p.1) ∂((gaussianE E).prod (gaussianE E))
      = ∫ p, g p.1 * (g p.1 - g p.2) ∂((gaussianE E).prod (gaussianE E)) := by
    rw [← integral_prod_swap]; rfl
  rw [hswap]
  have : ∫ p, g p.1 * (g p.2 - g p.1) ∂((gaussianE E).prod (gaussianE E))
      = -∫ p, g p.1 * (g p.1 - g p.2) ∂((gaussianE E).prod (gaussianE E)) := by
    rw [← integral_neg]; congr 1; funext p; ring
  rw [this]; ring

theorem lintegral_norm_gaussianE_le :
    ∫⁻ x, ENNReal.ofReal ‖x‖ ∂(gaussianE E) ≤ (Module.finrank ℝ E : ℝ≥0∞) + 1 := by
  calc ∫⁻ x, ENNReal.ofReal ‖x‖ ∂(gaussianE E)
      ≤ ∫⁻ x, ENNReal.ofReal (‖x‖ ^ 2) + 1 ∂(gaussianE E) := by
        refine lintegral_mono fun x => ?_
        rw [← ENNReal.ofReal_one, ← ENNReal.ofReal_add (sq_nonneg _) zero_le_one]
        exact ENNReal.ofReal_le_ofReal (by nlinarith [sq_nonneg (‖x‖ - 1)])
    _ = (Module.finrank ℝ E : ℝ≥0∞) + 1 := by
        rw [lintegral_add_right _ measurable_const, lintegral_normSq_gaussianE, lintegral_const,
          measure_univ, mul_one]

/-- The path integrand is integrable on `γ ⊗ γ ⊗ dθ`. -/
theorem integrable_path_integrand (hg : Differentiable ℝ g) (hM : ∀ z, |g z| ≤ M)
    (hK : ∀ z, ‖fderiv ℝ g z‖ ≤ K) :
    Integrable (fun q : (E × E) × ℝ => g q.1.1 * fderiv ℝ g (pathX q.1.1 q.1.2 q.2) (pathY q.1.1 q.1.2 q.2))
      (((gaussianE E).prod (gaussianE E)).prod (volume.restrict (Set.Ioc (0 : ℝ) (Real.pi / 2)))) := by
  have hgm : Measurable g := hg.continuous.measurable
  have hmeas : Measurable fun q : (E × E) × ℝ =>
      g q.1.1 * fderiv ℝ g (pathX q.1.1 q.1.2 q.2) (pathY q.1.1 q.1.2 q.2) :=
    (hgm.comp (measurable_fst.comp measurable_fst)).mul (measurable_fderiv_apply₂
      (by unfold pathX; fun_prop) (by unfold pathY; fun_prop))
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  have hK0 : 0 ≤ K := (norm_nonneg _).trans (hK 0)
  refine integrable_prod_of_slice hmeas.aestronglyMeasurable
    (B := ENNReal.ofReal (M * K) * (2 * ((Module.finrank ℝ E : ℝ≥0∞) + 1)))
    (ENNReal.mul_ne_top ENNReal.ofReal_ne_top (ENNReal.mul_ne_top (by simp)
      (ENNReal.add_ne_top.mpr ⟨ENNReal.natCast_ne_top _, ENNReal.one_ne_top⟩))) fun θ => ?_
  have hnorm := lintegral_norm_gaussianE_le (E := E)
  calc ∫⁻ p, ‖g p.1 * fderiv ℝ g (pathX p.1 p.2 θ) (pathY p.1 p.2 θ)‖ₑ ∂((gaussianE E).prod (gaussianE E))
      ≤ ∫⁻ p, ENNReal.ofReal (M * K) * (ENNReal.ofReal ‖p.1‖ + ENNReal.ofReal ‖p.2‖)
          ∂((gaussianE E).prod (gaussianE E)) := by
        refine lintegral_mono fun p => ?_
        rw [← ofReal_norm, ← ENNReal.ofReal_add (norm_nonneg _) (norm_nonneg _),
          ← ENNReal.ofReal_mul (by positivity)]
        refine ENNReal.ofReal_le_ofReal ?_
        rw [Real.norm_eq_abs, abs_mul]
        calc |g p.1| * |fderiv ℝ g (pathX p.1 p.2 θ) (pathY p.1 p.2 θ)|
            ≤ M * (K * (‖p.1‖ + ‖p.2‖)) :=
              mul_le_mul (hM _) (abs_fderiv_path_le hK _ _ _) (abs_nonneg _) hM0
          _ = M * K * (‖p.1‖ + ‖p.2‖) := by ring
    _ = ENNReal.ofReal (M * K) * (∫⁻ x, ENNReal.ofReal ‖x‖ ∂(gaussianE E) +
          ∫⁻ x, ENNReal.ofReal ‖x‖ ∂(gaussianE E)) := by
        have hm1 : Measurable fun p : E × E => ENNReal.ofReal ‖p.1‖ + ENNReal.ofReal ‖p.2‖ := by
          fun_prop
        have hm2 : Measurable fun p : E × E => ENNReal.ofReal ‖p.1‖ := by fun_prop
        rw [lintegral_const_mul _ hm1, lintegral_add_left hm2,
          lintegral_fst_prod measurable_norm.ennreal_ofReal,
          lintegral_snd_prod measurable_norm.ennreal_ofReal]
    _ ≤ ENNReal.ofReal (M * K) * (2 * ((Module.finrank ℝ E : ℝ≥0∞) + 1)) := by
        rw [two_mul]; exact mul_le_mul' le_rfl (add_le_add hnorm hnorm)

/-- **Step A': the variance as a path integral.** -/
theorem neg_variance_eq_integral_path (hg : Differentiable ℝ g) (hM : ∀ z, |g z| ≤ M)
    (hK : ∀ z, ‖fderiv ℝ g z‖ ≤ K) :
    -variance g (gaussianE E) = ∫ θ in (0 : ℝ)..(Real.pi / 2), ∫ p,
      g p.1 * fderiv ℝ g (pathX p.1 p.2 θ) (pathY p.1 p.2 θ) ∂((gaussianE E).prod (gaussianE E)) := by
  have hpi : (0 : ℝ) ≤ Real.pi / 2 := by positivity
  rw [neg_variance_eq_integral_prod hg hM]
  have h1 : ∀ p : E × E, g p.1 * (g p.2 - g p.1)
      = ∫ θ in Set.Ioc (0 : ℝ) (Real.pi / 2), g p.1 * fderiv ℝ g (pathX p.1 p.2 θ) (pathY p.1 p.2 θ) := by
    intro p
    rw [sub_eq_integral_path hg hK, intervalIntegral.integral_of_le hpi, ← integral_const_mul]
  simp_rw [h1]
  rw [intervalIntegral.integral_of_le hpi]
  exact integral_integral_swap (integrable_path_integrand hg hM hK)

/-- **Step B: rotation.**  For each `θ`, `E[g(X) g'(X_θ)[Y_θ]] = E[g(X_{−θ}(U,V)) g'(U)[V]]`. -/
theorem integral_path_eq_rot (hg : Differentiable ℝ g) (θ : ℝ) :
    ∫ p, g p.1 * fderiv ℝ g (pathX p.1 p.2 θ) (pathY p.1 p.2 θ) ∂((gaussianE E).prod (gaussianE E))
      = ∫ q, g (pathX q.1 q.2 (-θ)) * fderiv ℝ g q.1 q.2 ∂((gaussianE E).prod (gaussianE E)) := by
  have hgm : Measurable g := hg.continuous.measurable
  have hF : AEStronglyMeasurable (fun q : E × E => g (pathX q.1 q.2 (-θ)) * fderiv ℝ g q.1 q.2)
      ((gaussianE E).prod (gaussianE E)) :=
    ((hgm.comp (by unfold pathX; fun_prop)).mul (measurable_fderiv_apply₂ measurable_fst measurable_snd))
      |>.aestronglyMeasurable
  have hmp := measurePreserving_rotProd (E := E) θ
  have := integral_map hmp.measurable.aemeasurable (f := fun q : E × E =>
    g (pathX q.1 q.2 (-θ)) * fderiv ℝ g q.1 q.2) (by rw [hmp.map_eq]; exact hF)
  rw [hmp.map_eq] at this
  rw [this]
  refine integral_congr_ae (Filter.Eventually.of_forall fun p => ?_)
  simp only [pathX_rot_neg]


/-! ### Step C: integration by parts by rotating an auxiliary Gaussian -/

theorem measurePreserving_neg_gaussianE :
    MeasurePreserving (fun x : E => -x) (gaussianE E) (gaussianE E) := by
  have h := measurePreserving_isometry_gaussianE (E := E) (LinearIsometryEquiv.neg ℝ)
  convert h using 1
  ext x; simp

/-- The rotation of the last two coordinates of a triple. -/
noncomputable def rot3 (φ : ℝ) (t : E × (E × E)) : E × (E × E) :=
  (t.1, (pathX t.2.1 t.2.2 φ, pathY t.2.1 t.2.2 φ))

theorem measurable_rot3 (φ : ℝ) : Measurable (rot3 (E := E) φ) := by
  unfold rot3 pathX pathY; fun_prop

theorem measurable_rot3_uncurry :
    Measurable fun q : (E × (E × E)) × ℝ => rot3 q.2 q.1 := by
  unfold rot3 pathX pathY; fun_prop

theorem measurePreserving_rot3 (φ : ℝ) :
    MeasurePreserving (rot3 (E := E) φ) ((gaussianE E).prod ((gaussianE E).prod (gaussianE E)))
      ((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) :=
  (MeasurePreserving.id _).prod (measurePreserving_rotProd φ)

/-- The derivative in `φ` of `g(cos θ·u − sin θ·X_φ) · g'(u)[Y_φ]` at `φ = 0`, as a function of
the triple `(u, v, w)`. -/
noncomputable def ibpInt (g : E → ℝ) (θ : ℝ) (t : E × (E × E)) : ℝ :=
  fderiv ℝ g (pathX t.1 t.2.1 (-θ)) (Real.sin (-θ) • t.2.2) * fderiv ℝ g t.1 t.2.2
    + g (pathX t.1 t.2.1 (-θ)) * fderiv ℝ g t.1 (-t.2.1)

theorem measurable_ibpInt (hg : Differentiable ℝ g) (θ : ℝ) : Measurable (ibpInt g θ) := by
  have hgm : Measurable g := hg.continuous.measurable
  unfold ibpInt
  refine ((measurable_fderiv_apply₂ (by unfold pathX; fun_prop) (by fun_prop)).mul
    (measurable_fderiv_apply₂ measurable_fst (measurable_snd.comp measurable_snd))).add
    ((hgm.comp (by unfold pathX; fun_prop)).mul
      (measurable_fderiv_apply₂ measurable_fst (measurable_fst.comp measurable_snd).neg))

theorem abs_ibpInt_le (hM : ∀ z, |g z| ≤ M) (hK : ∀ z, ‖fderiv ℝ g z‖ ≤ K) (θ : ℝ)
    (t : E × (E × E)) : |ibpInt g θ t| ≤ K ^ 2 * ‖t.2.2‖ ^ 2 + M * K * ‖t.2.1‖ := by
  have hK0 : 0 ≤ K := (norm_nonneg _).trans (hK 0)
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  unfold ibpInt
  refine (abs_add_le _ _).trans (add_le_add ?_ ?_)
  · rw [abs_mul, ← Real.norm_eq_abs, ← Real.norm_eq_abs]
    calc ‖fderiv ℝ g (pathX t.1 t.2.1 (-θ)) (Real.sin (-θ) • t.2.2)‖ * ‖fderiv ℝ g t.1 t.2.2‖
        ≤ (K * ‖Real.sin (-θ) • t.2.2‖) * (K * ‖t.2.2‖) :=
          mul_le_mul ((ContinuousLinearMap.le_opNorm _ _).trans
              (mul_le_mul_of_nonneg_right (hK _) (norm_nonneg _)))
            ((ContinuousLinearMap.le_opNorm _ _).trans
              (mul_le_mul_of_nonneg_right (hK _) (norm_nonneg _))) (norm_nonneg _) (by positivity)
      _ ≤ (K * ‖t.2.2‖) * (K * ‖t.2.2‖) := by
          gcongr
          rw [norm_smul, Real.norm_eq_abs]
          exact mul_le_of_le_one_left (norm_nonneg _) (Real.abs_sin_le_one _)
      _ = K ^ 2 * ‖t.2.2‖ ^ 2 := by ring
  · rw [abs_mul, ← Real.norm_eq_abs (fderiv ℝ g t.1 (-t.2.1))]
    calc |g (pathX t.1 t.2.1 (-θ))| * ‖fderiv ℝ g t.1 (-t.2.1)‖
        ≤ M * (K * ‖-t.2.1‖) := mul_le_mul (hM _) ((ContinuousLinearMap.le_opNorm _ _).trans
            (mul_le_mul_of_nonneg_right (hK _) (norm_nonneg _))) (norm_nonneg _) hM0
      _ = M * K * ‖t.2.1‖ := by rw [norm_neg]; ring

theorem hasDerivAt_pathX_pathX (u v w : E) (θ φ : ℝ) :
    HasDerivAt (fun φ => pathX u (pathX v w φ) (-θ)) (Real.sin (-θ) • pathY v w φ) φ := by
  have h : HasDerivAt (fun φ => Real.cos (-θ) • u + Real.sin (-θ) • pathX v w φ)
      (0 + Real.sin (-θ) • pathY v w φ) φ :=
    (hasDerivAt_const φ _).add ((hasDerivAt_pathX v w φ).const_smul (Real.sin (-θ)))
  rw [zero_add] at h
  exact h

theorem hasDerivAt_ibp_path (hg : Differentiable ℝ g) (t : E × (E × E)) (θ φ : ℝ) :
    HasDerivAt (fun φ => g (pathX t.1 (pathX t.2.1 t.2.2 φ) (-θ)) *
      fderiv ℝ g t.1 (pathY t.2.1 t.2.2 φ)) (ibpInt g θ (rot3 φ t)) φ := by
  have h1 : HasDerivAt (fun φ => g (pathX t.1 (pathX t.2.1 t.2.2 φ) (-θ)))
      (fderiv ℝ g (pathX t.1 (pathX t.2.1 t.2.2 φ) (-θ)) (Real.sin (-θ) • pathY t.2.1 t.2.2 φ)) φ :=
    (hg _).hasFDerivAt.comp_hasDerivAt φ (hasDerivAt_pathX_pathX t.1 t.2.1 t.2.2 θ φ)
  have h2 : HasDerivAt (fun φ => fderiv ℝ g t.1 (pathY t.2.1 t.2.2 φ))
      (fderiv ℝ g t.1 (-pathX t.2.1 t.2.2 φ)) φ :=
    (fderiv ℝ g t.1).hasFDerivAt.comp_hasDerivAt φ (hasDerivAt_pathY t.2.1 t.2.2 φ)
  exact h1.mul h2

theorem abs_ibpInt_rot3_le (hM : ∀ z, |g z| ≤ M) (hK : ∀ z, ‖fderiv ℝ g z‖ ≤ K) (θ φ : ℝ)
    (t : E × (E × E)) :
    |ibpInt g θ (rot3 φ t)| ≤ K ^ 2 * (‖t.2.1‖ + ‖t.2.2‖) ^ 2 + M * K * (‖t.2.1‖ + ‖t.2.2‖) := by
  have hK0 : 0 ≤ K := (norm_nonneg _).trans (hK 0)
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  have h1 : ‖(rot3 φ t).2.2‖ ≤ ‖t.2.1‖ + ‖t.2.2‖ := norm_pathY_le _ _ _
  have h2 : ‖(rot3 φ t).2.1‖ ≤ ‖t.2.1‖ + ‖t.2.2‖ := norm_pathX_le _ _ _
  refine (abs_ibpInt_le hM hK θ _).trans (add_le_add ?_ ?_)
  · exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) h1 2) (by positivity)
  · exact mul_le_mul_of_nonneg_left h2 (by positivity)

/-- **The pathwise identity** behind the integration by parts. -/
theorem ibp_path_sub_eq_integral (hg : Differentiable ℝ g) (hM : ∀ z, |g z| ≤ M)
    (hK : ∀ z, ‖fderiv ℝ g z‖ ≤ K) (θ : ℝ) (t : E × (E × E)) :
    g (pathX t.1 t.2.2 (-θ)) * fderiv ℝ g t.1 (-t.2.1)
        - g (pathX t.1 t.2.1 (-θ)) * fderiv ℝ g t.1 t.2.2
      = ∫ φ in (0 : ℝ)..(Real.pi / 2), ibpInt g θ (rot3 φ t) := by
  have hpi : (0 : ℝ) ≤ Real.pi / 2 := by positivity
  have hint : IntervalIntegrable (fun φ => ibpInt g θ (rot3 φ t)) volume 0 (Real.pi / 2) := by
    rw [intervalIntegrable_iff_integrableOn_Ioc_of_le hpi]
    refine Measure.integrableOn_of_bounded
      (M := K ^ 2 * (‖t.2.1‖ + ‖t.2.2‖) ^ 2 + M * K * (‖t.2.1‖ + ‖t.2.2‖)) measure_Ioc_lt_top.ne
      ((measurable_ibpInt hg θ).comp (by unfold rot3 pathX pathY; fun_prop)).aestronglyMeasurable
      (Filter.Eventually.of_forall fun φ => ?_)
    rw [Real.norm_eq_abs]; exact abs_ibpInt_rot3_le hM hK θ φ t
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun φ _ => hasDerivAt_ibp_path hg t θ φ) hint,
    pathX_pi_div_two, pathY_pi_div_two, pathX_zero, pathY_zero]

theorem integrable_of_enorm_le {X : Type*} [MeasurableSpace X] {μ : Measure X} {F : X → ℝ}
    {G : X → ℝ≥0∞} (hF : AEStronglyMeasurable F μ) (hG : ∫⁻ x, G x ∂μ < ⊤)
    (h : ∀ x, ‖F x‖ₑ ≤ G x) : Integrable F μ :=
  ⟨hF, by rw [hasFiniteIntegral_iff_enorm]; exact (lintegral_mono h).trans_lt hG⟩

/-- `∫⁻ ‖w‖² ` and `∫⁻ ‖v‖` over the triple. -/
theorem lintegral_triple_normSq_snd_snd :
    ∫⁻ t : E × (E × E), ENNReal.ofReal (‖t.2.2‖ ^ 2)
        ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E)))
      = (Module.finrank ℝ E : ℝ≥0∞) := by
  rw [lintegral_snd_prod (F := fun p : E × E => ENNReal.ofReal (‖p.2‖ ^ 2)) (by fun_prop),
    lintegral_snd_prod (F := fun x : E => ENNReal.ofReal (‖x‖ ^ 2)) (by fun_prop),
    lintegral_normSq_gaussianE]

theorem lintegral_triple_norm_snd_fst_le :
    ∫⁻ t : E × (E × E), ENNReal.ofReal ‖t.2.1‖
        ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E)))
      ≤ (Module.finrank ℝ E : ℝ≥0∞) + 1 := by
  rw [lintegral_snd_prod (F := fun p : E × E => ENNReal.ofReal ‖p.1‖) (by fun_prop),
    lintegral_fst_prod (F := fun x : E => ENNReal.ofReal ‖x‖) (by fun_prop)]
  exact lintegral_norm_gaussianE_le

theorem lintegral_triple_norm_snd_snd_le :
    ∫⁻ t : E × (E × E), ENNReal.ofReal ‖t.2.2‖
        ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E)))
      ≤ (Module.finrank ℝ E : ℝ≥0∞) + 1 := by
  rw [lintegral_snd_prod (F := fun p : E × E => ENNReal.ofReal ‖p.2‖) (by fun_prop),
    lintegral_snd_prod (F := fun x : E => ENNReal.ofReal ‖x‖) (by fun_prop)]
  exact lintegral_norm_gaussianE_le

/-- The bound `K²‖w‖² + MK‖v‖ + MK‖w‖` has finite integral over the triple. -/
theorem lintegral_ibp_bound_lt_top (hM0 : 0 ≤ M) (hK0 : 0 ≤ K) :
    ∫⁻ t : E × (E × E), ENNReal.ofReal (K ^ 2 * ‖t.2.2‖ ^ 2 + M * K * ‖t.2.1‖ + M * K * ‖t.2.2‖)
        ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) < ⊤ := by
  have hd1 : (Module.finrank ℝ E : ℝ≥0∞) + 1 < ⊤ :=
    ENNReal.add_lt_top.mpr ⟨ENNReal.natCast_lt_top _, ENNReal.one_lt_top⟩
  calc ∫⁻ t : E × (E × E), ENNReal.ofReal (K ^ 2 * ‖t.2.2‖ ^ 2 + M * K * ‖t.2.1‖ + M * K * ‖t.2.2‖)
        ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E)))
      = ∫⁻ t : E × (E × E), ENNReal.ofReal (K ^ 2) * ENNReal.ofReal (‖t.2.2‖ ^ 2)
          + ENNReal.ofReal M * ENNReal.ofReal K * ENNReal.ofReal ‖t.2.1‖
          + ENNReal.ofReal M * ENNReal.ofReal K * ENNReal.ofReal ‖t.2.2‖
          ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) := by
        refine lintegral_congr fun t => ?_
        rw [ENNReal.ofReal_add (by positivity) (by positivity),
          ENNReal.ofReal_add (by positivity) (by positivity)]
        simp only [ENNReal.ofReal_mul (sq_nonneg K), ENNReal.ofReal_mul (mul_nonneg hM0 hK0),
          ENNReal.ofReal_mul hM0]
    _ = ENNReal.ofReal (K ^ 2) * (Module.finrank ℝ E : ℝ≥0∞)
          + ENNReal.ofReal M * ENNReal.ofReal K * ∫⁻ t : E × (E × E), ENNReal.ofReal ‖t.2.1‖
            ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E)))
          + ENNReal.ofReal M * ENNReal.ofReal K * ∫⁻ t : E × (E × E), ENNReal.ofReal ‖t.2.2‖
            ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) := by
        rw [lintegral_add_left (by fun_prop), lintegral_add_left (by fun_prop),
          lintegral_const_mul _ (by fun_prop), lintegral_const_mul _ (by fun_prop),
          lintegral_const_mul _ (by fun_prop), lintegral_triple_normSq_snd_snd]
    _ < ⊤ := by
        have hMK : ENNReal.ofReal M * ENNReal.ofReal K < ⊤ :=
          ENNReal.mul_lt_top ENNReal.ofReal_lt_top ENNReal.ofReal_lt_top
        refine ENNReal.add_lt_top.mpr ⟨ENNReal.add_lt_top.mpr
          ⟨ENNReal.mul_lt_top ENNReal.ofReal_lt_top (by simp),
           ENNReal.mul_lt_top hMK (lintegral_triple_norm_snd_fst_le.trans_lt hd1)⟩,
          ENNReal.mul_lt_top hMK (lintegral_triple_norm_snd_snd_le.trans_lt hd1)⟩

theorem integrable_ibpInt (hg : Differentiable ℝ g) (hM : ∀ z, |g z| ≤ M)
    (hK : ∀ z, ‖fderiv ℝ g z‖ ≤ K) (θ : ℝ) :
    Integrable (ibpInt g θ) ((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) :=
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  have hK0 : 0 ≤ K := (norm_nonneg _).trans (hK 0)
  integrable_of_enorm_le (measurable_ibpInt hg θ).aestronglyMeasurable
    (lintegral_ibp_bound_lt_top hM0 hK0)
    fun t => by
      rw [Real.enorm_eq_ofReal_abs]
      exact ENNReal.ofReal_le_ofReal ((abs_ibpInt_le hM hK θ t).trans (by
        nlinarith [mul_nonneg hM0 (mul_nonneg hK0 (norm_nonneg t.2.2))]))

theorem integral_ibpInt_rot3 (hg : Differentiable ℝ g) (θ φ : ℝ) :
    ∫ t, ibpInt g θ (rot3 φ t) ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E)))
      = ∫ t, ibpInt g θ t ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) := by
  have hmp := measurePreserving_rot3 (E := E) φ
  have := integral_map hmp.measurable.aemeasurable (f := ibpInt g θ)
    (by rw [hmp.map_eq]; exact (measurable_ibpInt hg θ).aestronglyMeasurable)
  rw [hmp.map_eq] at this
  exact this.symm

theorem integrable_ibpInt_rot3_prod (hg : Differentiable ℝ g) (hM : ∀ z, |g z| ≤ M)
    (hK : ∀ z, ‖fderiv ℝ g z‖ ≤ K) (θ : ℝ) :
    Integrable (fun q : (E × (E × E)) × ℝ => ibpInt g θ (rot3 q.2 q.1))
      (((gaussianE E).prod ((gaussianE E).prod (gaussianE E))).prod
        (volume.restrict (Set.Ioc (0 : ℝ) (Real.pi / 2)))) := by
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  have hK0 : 0 ≤ K := (norm_nonneg _).trans (hK 0)
  have hFm : Measurable fun q : (E × (E × E)) × ℝ => ibpInt g θ (rot3 q.2 q.1) :=
    (measurable_ibpInt hg θ).comp measurable_rot3_uncurry
  refine integrable_prod_of_slice hFm.aestronglyMeasurable (B := ∫⁻ t : E × (E × E),
      ENNReal.ofReal (K ^ 2 * ‖t.2.2‖ ^ 2 + M * K * ‖t.2.1‖ + M * K * ‖t.2.2‖)
        ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E))))
    (lintegral_ibp_bound_lt_top hM0 hK0).ne fun φ => ?_
  have hmp := measurePreserving_rot3 (E := E) φ
  rw [hmp.lintegral_comp (f := fun t => ‖ibpInt g θ t‖ₑ) (measurable_ibpInt hg θ).enorm]
  refine lintegral_mono fun t => ?_
  rw [Real.enorm_eq_ofReal_abs]
  exact ENNReal.ofReal_le_ofReal ((abs_ibpInt_le hM hK θ t).trans (by
    nlinarith [mul_nonneg hM0 (mul_nonneg hK0 (norm_nonneg t.2.2))]))

/-- The two boundary terms vanish by the symmetry `w ↦ −w`, resp. `v ↦ −v`. -/
theorem integral_ibp_boundary_zero₀ (hg : Differentiable ℝ g) (θ : ℝ) :
    ∫ t, g (pathX t.1 t.2.1 (-θ)) * fderiv ℝ g t.1 t.2.2
      ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) = 0 := by
  have hgm : Measurable g := hg.continuous.measurable
  have hmp : MeasurePreserving (fun t : E × (E × E) => (t.1, (t.2.1, -t.2.2)))
      ((gaussianE E).prod ((gaussianE E).prod (gaussianE E)))
      ((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) :=
    (MeasurePreserving.id _).prod ((MeasurePreserving.id _).prod measurePreserving_neg_gaussianE)
  have hFm : Measurable fun t : E × (E × E) => g (pathX t.1 t.2.1 (-θ)) * fderiv ℝ g t.1 t.2.2 :=
    (hgm.comp (measurable_pathX_apply measurable_fst (measurable_fst.comp measurable_snd) _)).mul
      (measurable_fderiv_apply₂ measurable_fst (measurable_snd.comp measurable_snd))
  have h := integral_map hmp.measurable.aemeasurable
    (f := fun t : E × (E × E) => g (pathX t.1 t.2.1 (-θ)) * fderiv ℝ g t.1 t.2.2)
    (by rw [hmp.map_eq]; exact hFm.aestronglyMeasurable)
  rw [hmp.map_eq] at h
  simp only [map_neg, mul_neg, integral_neg] at h
  linarith

theorem integral_ibp_boundary_zero₁ (hg : Differentiable ℝ g) (θ : ℝ) :
    ∫ t, g (pathX t.1 t.2.2 (-θ)) * fderiv ℝ g t.1 (-t.2.1)
      ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) = 0 := by
  have hgm : Measurable g := hg.continuous.measurable
  have hmp : MeasurePreserving (fun t : E × (E × E) => (t.1, (-t.2.1, t.2.2)))
      ((gaussianE E).prod ((gaussianE E).prod (gaussianE E)))
      ((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) :=
    (MeasurePreserving.id _).prod (measurePreserving_neg_gaussianE.prod (MeasurePreserving.id _))
  have hFm : Measurable fun t : E × (E × E) => g (pathX t.1 t.2.2 (-θ)) * fderiv ℝ g t.1 (-t.2.1) :=
    (hgm.comp (measurable_pathX_apply measurable_fst (measurable_snd.comp measurable_snd) _)).mul
      (measurable_fderiv_apply₂ measurable_fst (measurable_fst.comp measurable_snd).neg)
  have h := integral_map hmp.measurable.aemeasurable
    (f := fun t : E × (E × E) => g (pathX t.1 t.2.2 (-θ)) * fderiv ℝ g t.1 (-t.2.1))
    (by rw [hmp.map_eq]; exact hFm.aestronglyMeasurable)
  rw [hmp.map_eq] at h
  simp only [neg_neg, map_neg, mul_neg, integral_neg] at h ⊢
  linarith

theorem abs_mul_fderiv_le (hM : ∀ z, |g z| ≤ M) (hK : ∀ z, ‖fderiv ℝ g z‖ ≤ K) (a z v : E) :
    |g a * fderiv ℝ g z v| ≤ M * K * ‖v‖ := by
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  rw [abs_mul, ← Real.norm_eq_abs (fderiv ℝ g z v)]
  calc |g a| * ‖fderiv ℝ g z v‖ ≤ M * (K * ‖v‖) :=
        mul_le_mul (hM _) ((ContinuousLinearMap.le_opNorm _ _).trans
          (mul_le_mul_of_nonneg_right (hK _) (norm_nonneg _))) (norm_nonneg _) hM0
    _ = M * K * ‖v‖ := by ring

theorem abs_fderiv_mul_fderiv_le (hK : ∀ z, ‖fderiv ℝ g z‖ ≤ K) (z z' v : E) :
    |fderiv ℝ g z v * fderiv ℝ g z' v| ≤ K ^ 2 * ‖v‖ ^ 2 := by
  have hK0 : 0 ≤ K := (norm_nonneg _).trans (hK 0)
  rw [abs_mul, ← Real.norm_eq_abs, ← Real.norm_eq_abs]
  calc ‖fderiv ℝ g z v‖ * ‖fderiv ℝ g z' v‖ ≤ (K * ‖v‖) * (K * ‖v‖) :=
        mul_le_mul ((ContinuousLinearMap.le_opNorm _ _).trans
            (mul_le_mul_of_nonneg_right (hK _) (norm_nonneg _)))
          ((ContinuousLinearMap.le_opNorm _ _).trans
            (mul_le_mul_of_nonneg_right (hK _) (norm_nonneg _))) (norm_nonneg _) (by positivity)
    _ = K ^ 2 * ‖v‖ ^ 2 := by ring

/-- Integrability over the triple of anything bounded by `K²‖w‖² + MK‖v‖ + MK‖w‖`. -/
theorem integrable_triple_of_bound (hM0 : 0 ≤ M) (hK0 : 0 ≤ K) {F : E × (E × E) → ℝ}
    (hF : Measurable F)
    (h : ∀ t, |F t| ≤ K ^ 2 * ‖t.2.2‖ ^ 2 + M * K * ‖t.2.1‖ + M * K * ‖t.2.2‖) :
    Integrable F ((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) :=
  integrable_of_enorm_le hF.aestronglyMeasurable (lintegral_ibp_bound_lt_top hM0 hK0) fun t => by
    rw [Real.enorm_eq_ofReal_abs]; exact ENNReal.ofReal_le_ofReal (h t)

/-- **The integrated derivative vanishes**: `∫ ibpInt = 0`. -/
theorem integral_ibpInt_eq_zero (hg : Differentiable ℝ g) (hM : ∀ z, |g z| ≤ M)
    (hK : ∀ z, ‖fderiv ℝ g z‖ ≤ K) (θ : ℝ) :
    ∫ t, ibpInt g θ t ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) = 0 := by
  have hpi : (0 : ℝ) ≤ Real.pi / 2 := by positivity
  have hpi' : (0 : ℝ) < Real.pi / 2 := by positivity
  have hgm : Measurable g := hg.continuous.measurable
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  have hK0 : 0 ≤ K := (norm_nonneg _).trans (hK 0)
  have hpath := ibp_path_sub_eq_integral hg hM hK θ
  have hsum : ∫ t, (g (pathX t.1 t.2.2 (-θ)) * fderiv ℝ g t.1 (-t.2.1)
        - g (pathX t.1 t.2.1 (-θ)) * fderiv ℝ g t.1 t.2.2)
        ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) = 0 := by
    have h1 : Integrable (fun t : E × (E × E) => g (pathX t.1 t.2.2 (-θ)) * fderiv ℝ g t.1 (-t.2.1))
        ((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) := by
      refine integrable_triple_of_bound hM0 hK0
        ((hgm.comp (measurable_pathX_apply measurable_fst (measurable_snd.comp measurable_snd) _)).mul
          (measurable_fderiv_apply₂ measurable_fst (measurable_fst.comp measurable_snd).neg))
        fun t => ?_
      have := abs_mul_fderiv_le hM hK (pathX t.1 t.2.2 (-θ)) t.1 (-t.2.1)
      rw [norm_neg] at this
      nlinarith [sq_nonneg (K * ‖t.2.2‖), mul_nonneg hM0 (mul_nonneg hK0 (norm_nonneg t.2.2))]
    have h2 : Integrable (fun t : E × (E × E) => g (pathX t.1 t.2.1 (-θ)) * fderiv ℝ g t.1 t.2.2)
        ((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) := by
      refine integrable_triple_of_bound hM0 hK0
        ((hgm.comp (measurable_pathX_apply measurable_fst (measurable_fst.comp measurable_snd) _)).mul
          (measurable_fderiv_apply₂ measurable_fst (measurable_snd.comp measurable_snd)))
        fun t => ?_
      have := abs_mul_fderiv_le hM hK (pathX t.1 t.2.1 (-θ)) t.1 t.2.2
      nlinarith [sq_nonneg (K * ‖t.2.2‖), mul_nonneg hM0 (mul_nonneg hK0 (norm_nonneg t.2.1))]
    rw [integral_sub h1 h2, integral_ibp_boundary_zero₀ hg θ, integral_ibp_boundary_zero₁ hg θ,
      sub_zero]
  simp_rw [hpath, intervalIntegral.integral_of_le hpi] at hsum
  rw [integral_integral_swap (integrable_ibpInt_rot3_prod hg hM hK θ)] at hsum
  simp_rw [integral_ibpInt_rot3 hg θ] at hsum
  simp only [setIntegral_const, smul_eq_mul, measureReal_def, Real.volume_Ioc, sub_zero,
    ENNReal.toReal_ofReal hpi] at hsum
  exact (mul_eq_zero.mp hsum).resolve_left hpi'.ne'

/-- **Step C: integration by parts.** -/
theorem integral_rot_ibp (hg : Differentiable ℝ g) (hM : ∀ z, |g z| ≤ M)
    (hK : ∀ z, ‖fderiv ℝ g z‖ ≤ K) (θ : ℝ) :
    ∫ q, g (pathX q.1 q.2 (-θ)) * fderiv ℝ g q.1 q.2 ∂((gaussianE E).prod (gaussianE E))
      = -Real.sin θ * ∫ t, fderiv ℝ g (pathX t.1 t.2.1 (-θ)) t.2.2 * fderiv ℝ g t.1 t.2.2
          ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) := by
  have hgm : Measurable g := hg.continuous.measurable
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  have hK0 : 0 ≤ K := (norm_nonneg _).trans (hK 0)
  have h0 := integral_ibpInt_eq_zero hg hM hK θ
  have hA : Integrable (fun t : E × (E × E) =>
      fderiv ℝ g (pathX t.1 t.2.1 (-θ)) t.2.2 * fderiv ℝ g t.1 t.2.2)
      ((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) := by
    refine integrable_triple_of_bound hM0 hK0
      ((measurable_fderiv_apply₂ (measurable_pathX_apply measurable_fst (measurable_fst.comp measurable_snd) _)
        (measurable_snd.comp measurable_snd)).mul
        (measurable_fderiv_apply₂ measurable_fst (measurable_snd.comp measurable_snd))) fun t => ?_
    have := abs_fderiv_mul_fderiv_le hK (pathX t.1 t.2.1 (-θ)) t.1 t.2.2
    nlinarith [mul_nonneg hM0 (mul_nonneg hK0 (norm_nonneg t.2.1)),
      mul_nonneg hM0 (mul_nonneg hK0 (norm_nonneg t.2.2))]
  have hB : Integrable (fun t : E × (E × E) => g (pathX t.1 t.2.1 (-θ)) * fderiv ℝ g t.1 t.2.1)
      ((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) := by
    refine integrable_triple_of_bound hM0 hK0
      ((hgm.comp (measurable_pathX_apply measurable_fst (measurable_fst.comp measurable_snd) _)).mul
        (measurable_fderiv_apply₂ measurable_fst (measurable_fst.comp measurable_snd))) fun t => ?_
    have := abs_mul_fderiv_le hM hK (pathX t.1 t.2.1 (-θ)) t.1 t.2.1
    nlinarith [sq_nonneg (K * ‖t.2.2‖), mul_nonneg hM0 (mul_nonneg hK0 (norm_nonneg t.2.2))]
  have hsplit : ibpInt g θ = fun t => Real.sin (-θ) *
      (fderiv ℝ g (pathX t.1 t.2.1 (-θ)) t.2.2 * fderiv ℝ g t.1 t.2.2)
      - g (pathX t.1 t.2.1 (-θ)) * fderiv ℝ g t.1 t.2.1 := by
    funext t; unfold ibpInt; rw [map_smul, map_neg, smul_eq_mul]; ring
  rw [hsplit, integral_sub (hA.const_mul _) hB, integral_const_mul, sub_eq_zero] at h0
  have hmp : MeasurePreserving (fun t : E × (E × E) => (t.1, t.2.1))
      ((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) ((gaussianE E).prod (gaussianE E)) :=
    (MeasurePreserving.id _).prod measurePreserving_fst
  have hFm : Measurable fun q : E × E => g (pathX q.1 q.2 (-θ)) * fderiv ℝ g q.1 q.2 :=
    (hgm.comp (measurable_pathX_apply measurable_fst measurable_snd _)).mul
      (measurable_fderiv_apply₂ measurable_fst measurable_snd)
  have hmarg := integral_map hmp.measurable.aemeasurable
    (f := fun q : E × E => g (pathX q.1 q.2 (-θ)) * fderiv ℝ g q.1 q.2)
    (by rw [hmp.map_eq]; exact hFm.aestronglyMeasurable)
  rw [hmp.map_eq] at hmarg
  rw [hmarg, ← h0, Real.sin_neg]


/-! ### Step D: Cauchy–Schwarz and the conclusion -/

theorem integral_clm_sq_gaussianE (hd : 2 ≤ Module.finrank ℝ E) (ℓ : E →L[ℝ] ℝ) :
    ∫ w, ℓ w ^ 2 ∂(gaussianE E) = ‖ℓ‖ ^ 2 := by
  rw [integral_eq_lintegral_of_nonneg_ae (Filter.Eventually.of_forall fun w => sq_nonneg _)
    (ℓ.continuous.measurable.pow_const 2).aestronglyMeasurable, lintegral_clm_sq_gaussianE hd,
    ENNReal.toReal_ofReal (sq_nonneg _)]

theorem integrable_norm_fderiv_sq (hK : ∀ z, ‖fderiv ℝ g z‖ ≤ K) {X : Type*} [MeasurableSpace X]
    {μ : Measure X} [IsFiniteMeasure μ] {a : X → E} (ha : Measurable a) :
    Integrable (fun x => ‖fderiv ℝ g (a x)‖ ^ 2) μ :=
  integrable_of_bound_gauss (((measurable_fderiv ℝ g).comp ha).norm.pow_const 2).aestronglyMeasurable
    (K ^ 2) fun x => by
      rw [abs_of_nonneg (by positivity)]
      exact pow_le_pow_left₀ (norm_nonneg _) (hK _) 2

theorem integral_triple_fderiv_sq_u (hd : 2 ≤ Module.finrank ℝ E) (hM : ∀ z, |g z| ≤ M)
    (hK : ∀ z, ‖fderiv ℝ g z‖ ≤ K) :
    ∫ t, fderiv ℝ g t.1 t.2.2 ^ 2 ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E)))
      = ∫ z, ‖fderiv ℝ g z‖ ^ 2 ∂(gaussianE E) := by
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  have hK0 : 0 ≤ K := (norm_nonneg _).trans (hK 0)
  have hint : Integrable (fun t : E × (E × E) => fderiv ℝ g t.1 t.2.2 ^ 2)
      ((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) := by
    refine integrable_triple_of_bound hM0 hK0
      ((measurable_fderiv_apply₂ measurable_fst (measurable_snd.comp measurable_snd)).pow_const 2)
      fun t => ?_
    have := abs_fderiv_mul_fderiv_le hK t.1 t.1 t.2.2
    rw [← sq] at this
    nlinarith [mul_nonneg hM0 (mul_nonneg hK0 (norm_nonneg t.2.1)),
      mul_nonneg hM0 (mul_nonneg hK0 (norm_nonneg t.2.2))]
  rw [integral_prod _ hint]
  refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
  simp only
  rw [integral_snd_prod (F := fun w => fderiv ℝ g u w ^ 2)
    ((fderiv ℝ g u).continuous.measurable.pow_const 2).aestronglyMeasurable,
    integral_clm_sq_gaussianE hd]

theorem integral_triple_fderiv_sq_x (hd : 2 ≤ Module.finrank ℝ E) (hM : ∀ z, |g z| ≤ M)
    (hK : ∀ z, ‖fderiv ℝ g z‖ ≤ K) (θ : ℝ) :
    ∫ t, fderiv ℝ g (pathX t.1 t.2.1 (-θ)) t.2.2 ^ 2
        ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E)))
      = ∫ z, ‖fderiv ℝ g z‖ ^ 2 ∂(gaussianE E) := by
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  have hK0 : 0 ≤ K := (norm_nonneg _).trans (hK 0)
  have hint : Integrable (fun t : E × (E × E) => fderiv ℝ g (pathX t.1 t.2.1 (-θ)) t.2.2 ^ 2)
      ((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) := by
    refine integrable_triple_of_bound hM0 hK0
      ((measurable_fderiv_apply₂ (measurable_pathX_apply measurable_fst (measurable_fst.comp measurable_snd) _)
        (measurable_snd.comp measurable_snd)).pow_const 2) fun t => ?_
    have := abs_fderiv_mul_fderiv_le hK (pathX t.1 t.2.1 (-θ)) (pathX t.1 t.2.1 (-θ)) t.2.2
    rw [← sq] at this
    nlinarith [mul_nonneg hM0 (mul_nonneg hK0 (norm_nonneg t.2.1)),
      mul_nonneg hM0 (mul_nonneg hK0 (norm_nonneg t.2.2))]
  rw [integral_prod _ hint]
  have hinner : ∀ u : E, ∫ p : E × E, fderiv ℝ g (pathX u p.1 (-θ)) p.2 ^ 2
      ∂((gaussianE E).prod (gaussianE E)) = ∫ v, ‖fderiv ℝ g (pathX u v (-θ))‖ ^ 2 ∂(gaussianE E) := by
    intro u
    have hint2 : Integrable (fun p : E × E => fderiv ℝ g (pathX u p.1 (-θ)) p.2 ^ 2)
        ((gaussianE E).prod (gaussianE E)) := by
      have hm : Measurable fun p : E × E => fderiv ℝ g (pathX u p.1 (-θ)) p.2 ^ 2 :=
        (measurable_fderiv_apply₂ (measurable_pathX_apply measurable_const measurable_fst _)
          measurable_snd).pow_const 2
      refine integrable_of_enorm_le hm.aestronglyMeasurable
        (G := fun p => ENNReal.ofReal (K ^ 2 * ‖p.2‖ ^ 2)) ?_ fun p => ?_
      · rw [lintegral_snd_prod (F := fun w : E => ENNReal.ofReal (K ^ 2 * ‖w‖ ^ 2)) (by fun_prop)]
        simp_rw [ENNReal.ofReal_mul (sq_nonneg K)]
        rw [lintegral_const_mul _ (by fun_prop), lintegral_normSq_gaussianE]
        exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top (by simp)
      · rw [Real.enorm_eq_ofReal_abs]
        refine ENNReal.ofReal_le_ofReal ?_
        have := abs_fderiv_mul_fderiv_le hK (pathX u p.1 (-θ)) (pathX u p.1 (-θ)) p.2
        rwa [← sq] at this
    rw [integral_prod _ hint2]
    refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
    simp only
    exact integral_clm_sq_gaussianE hd _
  simp_rw [hinner]
  have hint3 : Integrable (fun q : E × E => ‖fderiv ℝ g (pathX q.1 q.2 (-θ))‖ ^ 2)
      ((gaussianE E).prod (gaussianE E)) :=
    integrable_norm_fderiv_sq hK (measurable_pathX_apply measurable_fst measurable_snd _)
  rw [← integral_prod _ hint3]
  have hmp := measurePreserving_rotProd (E := E) (-θ)
  have := integral_map hmp.measurable.aemeasurable (f := fun q : E × E => ‖fderiv ℝ g q.1‖ ^ 2)
    (by rw [hmp.map_eq]
        exact (((measurable_fderiv ℝ g).comp measurable_fst).norm.pow_const 2).aestronglyMeasurable)
  rw [hmp.map_eq] at this
  simp only at this
  rw [← this, integral_fst_prod (F := fun z => ‖fderiv ℝ g z‖ ^ 2)
    ((measurable_fderiv ℝ g).norm.pow_const 2).aestronglyMeasurable]

/-- **Step D.**  For `θ ∈ [0, π/2]`, `E[g(X) g'(X_θ)[Y_θ]] ≥ −sin θ · E‖g'‖²`. -/
theorem integral_rot_ibp_ge (hd : 2 ≤ Module.finrank ℝ E) (hg : Differentiable ℝ g)
    (hM : ∀ z, |g z| ≤ M) (hK : ∀ z, ‖fderiv ℝ g z‖ ≤ K) {θ : ℝ} (hθ : 0 ≤ Real.sin θ) :
    -Real.sin θ * ∫ z, ‖fderiv ℝ g z‖ ^ 2 ∂(gaussianE E)
      ≤ ∫ q, g (pathX q.1 q.2 (-θ)) * fderiv ℝ g q.1 q.2 ∂((gaussianE E).prod (gaussianE E)) := by
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  have hK0 : 0 ≤ K := (norm_nonneg _).trans (hK 0)
  rw [integral_rot_ibp hg hM hK θ]
  refine mul_le_mul_of_nonpos_left ?_ (by linarith)
  have hA : Integrable (fun t : E × (E × E) =>
      fderiv ℝ g (pathX t.1 t.2.1 (-θ)) t.2.2 * fderiv ℝ g t.1 t.2.2)
      ((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) := by
    refine integrable_triple_of_bound hM0 hK0
      ((measurable_fderiv_apply₂ (measurable_pathX_apply measurable_fst (measurable_fst.comp measurable_snd) _)
        (measurable_snd.comp measurable_snd)).mul
        (measurable_fderiv_apply₂ measurable_fst (measurable_snd.comp measurable_snd))) fun t => ?_
    have := abs_fderiv_mul_fderiv_le hK (pathX t.1 t.2.1 (-θ)) t.1 t.2.2
    nlinarith [mul_nonneg hM0 (mul_nonneg hK0 (norm_nonneg t.2.1)),
      mul_nonneg hM0 (mul_nonneg hK0 (norm_nonneg t.2.2))]
  have hx : Integrable (fun t : E × (E × E) => fderiv ℝ g (pathX t.1 t.2.1 (-θ)) t.2.2 ^ 2)
      ((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) := by
    refine integrable_triple_of_bound hM0 hK0
      ((measurable_fderiv_apply₂ (measurable_pathX_apply measurable_fst (measurable_fst.comp measurable_snd) _)
        (measurable_snd.comp measurable_snd)).pow_const 2) fun t => ?_
    have := abs_fderiv_mul_fderiv_le hK (pathX t.1 t.2.1 (-θ)) (pathX t.1 t.2.1 (-θ)) t.2.2
    rw [← sq] at this
    nlinarith [mul_nonneg hM0 (mul_nonneg hK0 (norm_nonneg t.2.1)),
      mul_nonneg hM0 (mul_nonneg hK0 (norm_nonneg t.2.2))]
  have hu : Integrable (fun t : E × (E × E) => fderiv ℝ g t.1 t.2.2 ^ 2)
      ((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) := by
    refine integrable_triple_of_bound hM0 hK0
      ((measurable_fderiv_apply₂ measurable_fst (measurable_snd.comp measurable_snd)).pow_const 2)
      fun t => ?_
    have := abs_fderiv_mul_fderiv_le hK t.1 t.1 t.2.2
    rw [← sq] at this
    nlinarith [mul_nonneg hM0 (mul_nonneg hK0 (norm_nonneg t.2.1)),
      mul_nonneg hM0 (mul_nonneg hK0 (norm_nonneg t.2.2))]
  calc ∫ t, fderiv ℝ g (pathX t.1 t.2.1 (-θ)) t.2.2 * fderiv ℝ g t.1 t.2.2
        ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E)))
      ≤ ∫ t, (1 / 2 : ℝ) * (fderiv ℝ g (pathX t.1 t.2.1 (-θ)) t.2.2 ^ 2 + fderiv ℝ g t.1 t.2.2 ^ 2)
          ∂((gaussianE E).prod ((gaussianE E).prod (gaussianE E))) := by
        refine integral_mono hA ((hx.add hu).const_mul _) fun t => ?_
        simp only
        nlinarith [sq_nonneg (fderiv ℝ g (pathX t.1 t.2.1 (-θ)) t.2.2 - fderiv ℝ g t.1 t.2.2)]
    _ = ∫ z, ‖fderiv ℝ g z‖ ^ 2 ∂(gaussianE E) := by
        rw [integral_const_mul, integral_add hx hu, integral_triple_fderiv_sq_x hd hM hK,
          integral_triple_fderiv_sq_u hd hM hK]
        ring

/-- **The Gaussian Poincaré inequality for bounded `C¹` functions with bounded derivative**,
with the sharp constant `1`: `Var_γ g ≤ E‖g'‖²`. -/
theorem variance_le_integral_norm_fderiv_sq (hd : 2 ≤ Module.finrank ℝ E)
    (hg : Differentiable ℝ g) (hM : ∀ z, |g z| ≤ M) (hK : ∀ z, ‖fderiv ℝ g z‖ ≤ K) :
    variance g (gaussianE E) ≤ ∫ z, ‖fderiv ℝ g z‖ ^ 2 ∂(gaussianE E) := by
  have hpi : (0 : ℝ) ≤ Real.pi / 2 := by positivity
  have h := neg_variance_eq_integral_path hg hM hK
  have hΦint : IntervalIntegrable (fun θ => ∫ p, g p.1 * fderiv ℝ g (pathX p.1 p.2 θ)
      (pathY p.1 p.2 θ) ∂((gaussianE E).prod (gaussianE E))) volume 0 (Real.pi / 2) := by
    rw [intervalIntegrable_iff_integrableOn_Ioc_of_le hpi]
    exact (integrable_path_integrand hg hM hK).integral_prod_right
  have hsin : IntervalIntegrable (fun θ => -Real.sin θ * ∫ z, ‖fderiv ℝ g z‖ ^ 2 ∂(gaussianE E))
      volume 0 (Real.pi / 2) := (Continuous.intervalIntegrable (by fun_prop) _ _)
  have hmono : ∀ θ ∈ Set.Icc (0 : ℝ) (Real.pi / 2),
      -Real.sin θ * ∫ z, ‖fderiv ℝ g z‖ ^ 2 ∂(gaussianE E)
        ≤ ∫ p, g p.1 * fderiv ℝ g (pathX p.1 p.2 θ) (pathY p.1 p.2 θ)
          ∂((gaussianE E).prod (gaussianE E)) := fun θ hθ => by
    rw [integral_path_eq_rot hg θ]
    exact integral_rot_ibp_ge hd hg hM hK
      (Real.sin_nonneg_of_nonneg_of_le_pi hθ.1 (by linarith [hθ.2, Real.pi_pos]))
  have hle := intervalIntegral.integral_mono_on hpi hsin hΦint hmono
  rw [← h, intervalIntegral.integral_mul_const, intervalIntegral.integral_neg, integral_sin,
    Real.cos_zero, Real.cos_pi_div_two, sub_zero] at hle
  linarith

end C1Poincare
/-! ## §33  A smooth cutoff and the smooth minimum

Two approximations that reduce `f_C = dist(·/‖·‖, C)²` to the setting of §32.  The cutoff
`χ_δ(z) = τ(‖z‖²/δ² − 1)`, with `τ` Mathlib's smooth transition, vanishes on the ball of
radius `δ`, equals `1` outside radius `√2 δ`, and has derivative at most `C/δ`
(`exists_bound_fderiv_cutoff`).  The smooth minimum `f_ε = −ε log ∑_c exp(−h_c/ε)` is within
`ε log |C|` of `f_C` (`abs_smoothMin_sub_fC_le`), is `C¹` off the origin with derivative the
softmax combination of the branch derivatives (`hasFDerivAt_smoothMin`), and satisfies the
sharp gradient bound `‖f_ε'(z)‖² ≤ 4 (f_C(z) + |C| ε)/‖z‖²` (`norm_fderiv_smoothMin_sq_le`),
by Cauchy–Schwarz for the convex combination and the estimate `w_c (h_c − f_C) ≤ ε` on the
softmax weights. -/



section Cutoff

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- A smooth cutoff vanishing on the ball of radius `δ` and equal to `1` outside radius `√2 δ`. -/
noncomputable def cutoff (δ : ℝ) (z : E) : ℝ := Real.smoothTransition (‖z‖ ^ 2 / δ ^ 2 - 1)

theorem cutoff_nonneg (δ : ℝ) (z : E) : 0 ≤ cutoff δ z := Real.smoothTransition.nonneg _

theorem cutoff_le_one (δ : ℝ) (z : E) : cutoff δ z ≤ 1 := Real.smoothTransition.le_one _

theorem cutoff_eq_zero {δ : ℝ} (hδ : 0 < δ) {z : E} (hz : ‖z‖ ≤ δ) : cutoff δ z = 0 := by
  unfold cutoff
  apply Real.smoothTransition.zero_of_nonpos
  rw [sub_nonpos, div_le_one (by positivity)]
  exact pow_le_pow_left₀ (norm_nonneg _) hz 2

theorem cutoff_eq_one {δ : ℝ} (hδ : 0 < δ) {z : E} (hz : 2 * δ ^ 2 ≤ ‖z‖ ^ 2) : cutoff δ z = 1 := by
  unfold cutoff
  apply Real.smoothTransition.one_of_one_le
  rw [le_sub_iff_add_le, le_div_iff₀ (by positivity)]
  linarith

theorem contDiff_cutoff {δ : ℝ} (hδ : 0 < δ) : ContDiff ℝ 1 (cutoff (E := E) δ) := by
  unfold cutoff
  exact Real.smoothTransition.contDiff.comp ((contDiff_norm_sq ℝ).div_const _ |>.sub contDiff_const)

/-- The derivative of the transition function is bounded. -/
theorem exists_bound_deriv_smoothTransition :
    ∃ C₀ : ℝ, 0 ≤ C₀ ∧ ∀ s, |deriv Real.smoothTransition s| ≤ C₀ := by
  have hcont : Continuous (deriv Real.smoothTransition) :=
    (Real.smoothTransition.contDiff (n := 1)).continuous_deriv le_rfl
  obtain ⟨C₀, hC₀⟩ := (isCompact_Icc (a := (0 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    hcont.continuousOn
  refine ⟨max C₀ 0, le_max_right _ _, fun s => ?_⟩
  rcases le_or_gt s 0 with hs | hs
  · rcases eq_or_lt_of_le hs with rfl | hs'
    · exact (Real.norm_eq_abs _ ▸ hC₀ 0 ⟨le_rfl, zero_le_one⟩).trans (le_max_left _ _)
    · have : deriv Real.smoothTransition s = 0 := by
        have hev : Real.smoothTransition =ᶠ[𝓝 s] fun _ => 0 := by
          filter_upwards [Iio_mem_nhds hs'] with t ht
          exact Real.smoothTransition.zero_of_nonpos (le_of_lt ht)
        rw [hev.deriv_eq, deriv_const]
      rw [this, abs_zero]; exact le_max_right _ _
  · rcases le_or_gt s 1 with hs1 | hs1
    · exact (Real.norm_eq_abs _ ▸ hC₀ s ⟨hs.le, hs1⟩).trans (le_max_left _ _)
    · have : deriv Real.smoothTransition s = 0 := by
        have hev : Real.smoothTransition =ᶠ[𝓝 s] fun _ => 1 := by
          filter_upwards [Ioi_mem_nhds hs1] with t ht
          exact Real.smoothTransition.one_of_one_le (le_of_lt ht)
        rw [hev.deriv_eq, deriv_const]
      rw [this, abs_zero]; exact le_max_right _ _

theorem hasFDerivAt_cutoff {δ : ℝ} (hδ : 0 < δ) (z : E) :
    HasFDerivAt (cutoff δ) (deriv Real.smoothTransition (‖z‖ ^ 2 / δ ^ 2 - 1) •
      (δ ^ 2)⁻¹ • (2 : ℕ) • innerSL ℝ z) z := by
  have h1' := ((hasStrictFDerivAt_norm_sq z).hasFDerivAt.const_smul (δ ^ 2)⁻¹).sub_const 1
  have h1 : HasFDerivAt (fun z : E => ‖z‖ ^ 2 / δ ^ 2 - 1) ((δ ^ 2)⁻¹ • (2 : ℕ) • innerSL ℝ z) z :=
    h1'.congr_of_eventuallyEq (Filter.Eventually.of_forall fun z => by
      simp only [Pi.smul_apply, smul_eq_mul, div_eq_inv_mul])
  have h2 : HasDerivAt Real.smoothTransition (deriv Real.smoothTransition (‖z‖ ^ 2 / δ ^ 2 - 1))
      (‖z‖ ^ 2 / δ ^ 2 - 1) :=
    ((Real.smoothTransition.contDiff (n := 1)).differentiable one_ne_zero _).hasDerivAt
  exact h2.comp_hasFDerivAt z h1

theorem norm_fderiv_cutoff_le {δ : ℝ} (hδ : 0 < δ) (z : E) :
    ‖fderiv ℝ (cutoff δ) z‖
      ≤ |deriv Real.smoothTransition (‖z‖ ^ 2 / δ ^ 2 - 1)| * (2 * ‖z‖ / δ ^ 2) := by
  rw [(hasFDerivAt_cutoff hδ z).fderiv, norm_smul, Real.norm_eq_abs]
  refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (by positivity : (0 : ℝ) < (δ ^ 2)⁻¹)]
  calc (δ ^ 2)⁻¹ * ‖(2 : ℕ) • innerSL ℝ z‖ ≤ (δ ^ 2)⁻¹ * ((2 : ℕ) * ‖innerSL ℝ z‖) :=
        mul_le_mul_of_nonneg_left norm_nsmul_le (by positivity)
    _ = 2 * ‖z‖ / δ ^ 2 := by rw [innerSL_apply_norm]; push_cast; ring

theorem fderiv_cutoff_eq_zero {δ : ℝ} (hδ : 0 < δ) {z : E} (hz : 2 * δ ^ 2 < ‖z‖ ^ 2) :
    fderiv ℝ (cutoff δ) z = 0 := by
  have hs : 1 < ‖z‖ ^ 2 / δ ^ 2 - 1 := by
    rw [lt_sub_iff_add_lt, lt_div_iff₀ (by positivity)]; linarith
  have hev : Real.smoothTransition =ᶠ[𝓝 (‖z‖ ^ 2 / δ ^ 2 - 1)] fun _ => 1 := by
    filter_upwards [Ioi_mem_nhds hs] with t ht
    exact Real.smoothTransition.one_of_one_le (le_of_lt ht)
  rw [(hasFDerivAt_cutoff hδ z).fderiv, hev.deriv_eq, deriv_const, zero_smul]

/-- `‖(cutoff δ)'(z)‖ ≤ C/δ` uniformly, and it vanishes outside the ball of radius `√2 δ`. -/
theorem exists_bound_fderiv_cutoff :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ δ : ℝ, 0 < δ → ∀ z : E, ‖fderiv ℝ (cutoff δ) z‖ ≤ C / δ := by
  obtain ⟨C₀, hC₀0, hC₀⟩ := exists_bound_deriv_smoothTransition
  refine ⟨2 * Real.sqrt 2 * C₀, by positivity, fun δ hδ z => ?_⟩
  rcases le_or_gt (‖z‖ ^ 2) (2 * δ ^ 2) with hz | hz
  · have hnz : ‖z‖ ≤ Real.sqrt 2 * δ := by
      rw [← Real.sqrt_sq (norm_nonneg z), ← Real.sqrt_sq hδ.le, ← Real.sqrt_mul zero_le_two]
      exact Real.sqrt_le_sqrt hz
    calc ‖fderiv ℝ (cutoff δ) z‖
        ≤ |deriv Real.smoothTransition (‖z‖ ^ 2 / δ ^ 2 - 1)| * (2 * ‖z‖ / δ ^ 2) :=
          norm_fderiv_cutoff_le hδ z
      _ ≤ C₀ * (2 * (Real.sqrt 2 * δ) / δ ^ 2) := by gcongr; exact hC₀ _
      _ = 2 * Real.sqrt 2 * C₀ / δ := by first | (field_simp; ring) | field_simp
  · rw [fderiv_cutoff_eq_zero hδ hz, norm_zero]
    positivity

end Cutoff

section SmoothMin

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]

/-- The smooth minimum `f_ε(z) = −ε log ∑_c exp(−h_c(z)/ε)`. -/
noncomputable def smoothMin (C : Finset E) (ε : ℝ) (z : E) : ℝ :=
  -ε * Real.log (∑ c ∈ C, Real.exp (-hc c z / ε))

/-- The softmax weights. -/
noncomputable def softWeight (C : Finset E) (ε : ℝ) (c z : E) : ℝ :=
  Real.exp (-hc c z / ε) / ∑ c' ∈ C, Real.exp (-hc c' z / ε)

theorem sum_exp_pos (C : Finset E) (hC : C.Nonempty) (ε : ℝ) (z : E) :
    0 < ∑ c ∈ C, Real.exp (-hc c z / ε) :=
  Finset.sum_pos (fun c _ => Real.exp_pos _) hC

theorem softWeight_nonneg (C : Finset E) (ε : ℝ) (c z : E) : 0 ≤ softWeight C ε c z :=
  div_nonneg (Real.exp_pos _).le (Finset.sum_nonneg fun c _ => (Real.exp_pos _).le)

theorem sum_softWeight (C : Finset E) (hC : C.Nonempty) (ε : ℝ) (z : E) :
    ∑ c ∈ C, softWeight C ε c z = 1 := by
  unfold softWeight
  rw [← Finset.sum_div, div_self (sum_exp_pos C hC ε z).ne']

/-- `f_C − ε log |C| ≤ f_ε ≤ f_C`. -/
theorem smoothMin_le_fC (C : Finset E) (hC : C.Nonempty) {ε : ℝ} (hε : 0 < ε) (z : E) :
    smoothMin C ε z ≤ fC C hC z := by
  unfold smoothMin
  obtain ⟨c₀, hc₀, hmin⟩ := Finset.exists_mem_eq_inf' hC (fun c => hc c z)
  have hfC : fC C hC z = hc c₀ z := hmin
  rw [hfC]
  have h1 : Real.exp (-hc c₀ z / ε) ≤ ∑ c ∈ C, Real.exp (-hc c z / ε) :=
    Finset.single_le_sum (f := fun c => Real.exp (-hc c z / ε)) (fun c _ => (Real.exp_pos _).le) hc₀
  have h2 : -hc c₀ z / ε ≤ Real.log (∑ c ∈ C, Real.exp (-hc c z / ε)) := by
    rw [← Real.log_exp (-hc c₀ z / ε)]
    exact Real.log_le_log (Real.exp_pos _) h1
  have h3 : -ε * Real.log (∑ c ∈ C, Real.exp (-hc c z / ε)) ≤ -ε * (-hc c₀ z / ε) :=
    mul_le_mul_of_nonpos_left h2 (by linarith)
  have h4 : -ε * (-hc c₀ z / ε) = hc c₀ z := by field_simp
  linarith

theorem fC_le_smoothMin_add (C : Finset E) (hC : C.Nonempty) {ε : ℝ} (hε : 0 < ε) (z : E) :
    fC C hC z ≤ smoothMin C ε z + ε * Real.log C.card := by
  unfold smoothMin
  have hcard : (0 : ℝ) < C.card := by exact_mod_cast hC.card_pos
  have h1 : ∑ c ∈ C, Real.exp (-hc c z / ε) ≤ C.card * Real.exp (-fC C hC z / ε) := by
    calc ∑ c ∈ C, Real.exp (-hc c z / ε) ≤ ∑ _c ∈ C, Real.exp (-fC C hC z / ε) := by
          refine Finset.sum_le_sum fun c hc' => Real.exp_le_exp.mpr ?_
          have : fC C hC z ≤ hc c z := Finset.inf'_le _ hc'
          exact div_le_div_of_nonneg_right (by linarith) hε.le
      _ = C.card * Real.exp (-fC C hC z / ε) := by rw [Finset.sum_const, nsmul_eq_mul]
  have h2 : Real.log (∑ c ∈ C, Real.exp (-hc c z / ε)) ≤ Real.log C.card + -fC C hC z / ε := by
    rw [← Real.log_exp (-fC C hC z / ε), ← Real.log_mul hcard.ne' (Real.exp_pos _).ne']
    exact Real.log_le_log (sum_exp_pos C hC ε z) h1
  have h3 : -ε * (Real.log C.card + -fC C hC z / ε)
      ≤ -ε * Real.log (∑ c ∈ C, Real.exp (-hc c z / ε)) :=
    mul_le_mul_of_nonpos_left h2 (by linarith)
  have h4 : -ε * (Real.log C.card + -fC C hC z / ε) = -ε * Real.log C.card + fC C hC z := by
    field_simp; ring
  linarith

theorem abs_smoothMin_sub_fC_le (C : Finset E) (hC : C.Nonempty) {ε : ℝ} (hε : 0 < ε) (z : E) :
    |smoothMin C ε z - fC C hC z| ≤ ε * Real.log C.card := by
  have hlog : 0 ≤ Real.log C.card := Real.log_nonneg (by exact_mod_cast hC.card_pos)
  rw [abs_le]
  constructor
  · linarith [fC_le_smoothMin_add C hC hε z]
  · linarith [smoothMin_le_fC C hC hε z, mul_nonneg hε.le hlog]

/-- The derivative of the smooth minimum off the origin: the softmax combination of the
branch derivatives. -/
theorem hasFDerivAt_smoothMin (C : Finset E) (hC : C.Nonempty) {ε : ℝ} (hε : 0 < ε) {z : E}
    (hz : z ≠ 0) :
    HasFDerivAt (smoothMin C ε) (∑ c ∈ C, softWeight C ε c z • fderiv ℝ (hc c) z) z := by
  have hsum : HasFDerivAt (fun z => ∑ c ∈ C, Real.exp (-hc c z / ε))
      (∑ c ∈ C, (Real.exp (-hc c z / ε) * (-1 / ε)) • fderiv ℝ (hc c) z) z := by
    have hsum0 := HasFDerivAt.sum (x := z) (u := C) (A := fun c z => Real.exp (-hc c z / ε))
      (A' := fun c => (Real.exp (-hc c z / ε) * (-1 / ε)) • fderiv ℝ (hc c) z) ?_
    · exact hsum0.congr_of_eventuallyEq (Filter.Eventually.of_forall fun z =>
        (Finset.sum_apply z C (fun c z => Real.exp (-hc c z / ε))).symm)
    intro c _
    have h0 : HasFDerivAt (fun z => -hc c z / ε) ((-1 / ε) • fderiv ℝ (hc c) z) z := by
      have h := ((differentiableAt_hc c hz).hasFDerivAt.neg).const_smul ε⁻¹
      have h' : HasFDerivAt (fun z => -hc c z / ε) (ε⁻¹ • -fderiv ℝ (hc c) z) z :=
        h.congr_of_eventuallyEq (Filter.Eventually.of_forall fun z => by
          simp only [Pi.smul_apply, Pi.neg_apply, smul_eq_mul, div_eq_inv_mul])
      exact h'.congr_fderiv (by rw [smul_neg, neg_div, one_div, neg_smul])
    exact h0.exp.congr_fderiv (smul_smul _ _ _)
  have hlog := hsum.log (sum_exp_pos C hC ε z).ne'
  have h := hlog.const_smul (-ε)
  have e : (-ε) • (∑ c ∈ C, Real.exp (-hc c z / ε))⁻¹ •
      ∑ c ∈ C, (Real.exp (-hc c z / ε) * (-1 / ε)) • fderiv ℝ (hc c) z
      = ∑ c ∈ C, softWeight C ε c z • fderiv ℝ (hc c) z := by
    rw [Finset.smul_sum, Finset.smul_sum]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [smul_smul, smul_smul]
    unfold softWeight
    congr 1
    field_simp
  rw [e] at h
  exact h

theorem norm_fderiv_smoothMin_le (C : Finset E) (hC : C.Nonempty) {ε : ℝ} (hε : 0 < ε) {z : E}
    (hz : z ≠ 0) :
    ‖fderiv ℝ (smoothMin C ε) z‖ ≤ ∑ c ∈ C, softWeight C ε c z * (2 * ‖dir z - c‖ / ‖z‖) := by
  rw [(hasFDerivAt_smoothMin C hC hε hz).fderiv]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun c _ => ?_)
  rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (softWeight_nonneg C ε c z)]
  exact mul_le_mul_of_nonneg_left (norm_fderiv_hc_le_sharp c hz) (softWeight_nonneg C ε c z)

/-- A softmax weight times the excess of its branch over the minimum is at most `ε`. -/
theorem softWeight_mul_sub_le (C : Finset E) (hC : C.Nonempty) {ε : ℝ} (hε : 0 < ε) (c z : E)
    (hc' : c ∈ C) : softWeight C ε c z * (hc c z - fC C hC z) ≤ ε := by
  set t := (hc c z - fC C hC z) / ε with ht
  have ht0 : 0 ≤ t := div_nonneg (sub_nonneg.mpr (Finset.inf'_le _ hc')) hε.le
  have hw : softWeight C ε c z ≤ Real.exp (-t) := by
    unfold softWeight
    obtain ⟨c₀, hc₀, hmin⟩ := Finset.exists_mem_eq_inf' hC (fun c => hc c z)
    have hfC : fC C hC z = hc c₀ z := hmin
    have h1 : Real.exp (-hc c₀ z / ε) ≤ ∑ c ∈ C, Real.exp (-hc c z / ε) :=
      Finset.single_le_sum (f := fun c => Real.exp (-hc c z / ε)) (fun c _ => (Real.exp_pos _).le)
        hc₀
    rw [div_le_iff₀ (sum_exp_pos C hC ε z)]
    calc Real.exp (-hc c z / ε) = Real.exp (-t) * Real.exp (-hc c₀ z / ε) := by
          rw [← Real.exp_add, ht, hfC]; congr 1; field_simp; ring
      _ ≤ Real.exp (-t) * ∑ c ∈ C, Real.exp (-hc c z / ε) :=
          mul_le_mul_of_nonneg_left h1 (Real.exp_pos _).le
  have hte : t * Real.exp (-t) ≤ 1 := by
    have := Real.add_one_le_exp t
    rw [Real.exp_neg]
    rw [mul_inv_le_iff₀ (Real.exp_pos t), one_mul]
    linarith
  have hsub : hc c z - fC C hC z = t * ε := by rw [ht]; field_simp
  rw [hsub]
  calc softWeight C ε c z * (t * ε) ≤ Real.exp (-t) * (t * ε) :=
        mul_le_mul_of_nonneg_right hw (by positivity)
    _ = (t * Real.exp (-t)) * ε := by ring
    _ ≤ 1 * ε := mul_le_mul_of_nonneg_right hte hε.le
    _ = ε := one_mul ε

/-- **The gradient bound for the smooth minimum**:
`‖f_ε'(z)‖² ≤ 4 (f_C(z) + |C| ε)/‖z‖²`. -/
theorem norm_fderiv_smoothMin_sq_le (C : Finset E) (hC : C.Nonempty) {ε : ℝ} (hε : 0 < ε) {z : E}
    (hz : z ≠ 0) :
    ‖fderiv ℝ (smoothMin C ε) z‖ ^ 2 ≤ 4 * (fC C hC z + C.card * ε) / ‖z‖ ^ 2 := by
  have hz' : 0 < ‖z‖ := norm_pos_iff.mpr hz
  have h1 := norm_fderiv_smoothMin_le C hC hε hz
  have hw0 := softWeight_nonneg C ε
  -- Cauchy–Schwarz for the convex combination
  have h2 : (∑ c ∈ C, softWeight C ε c z * (2 * ‖dir z - c‖ / ‖z‖)) ^ 2
      ≤ ∑ c ∈ C, softWeight C ε c z * (2 * ‖dir z - c‖ / ‖z‖) ^ 2 := by
    have hcs := Finset.sum_mul_sq_le_sq_mul_sq C (fun c => Real.sqrt (softWeight C ε c z))
      (fun c => Real.sqrt (softWeight C ε c z) * (2 * ‖dir z - c‖ / ‖z‖))
    have e1 : ∀ c ∈ C, Real.sqrt (softWeight C ε c z) *
        (Real.sqrt (softWeight C ε c z) * (2 * ‖dir z - c‖ / ‖z‖))
        = softWeight C ε c z * (2 * ‖dir z - c‖ / ‖z‖) := fun c _ => by
      rw [← mul_assoc, Real.mul_self_sqrt (hw0 c z)]
    have e2 : ∀ c ∈ C, Real.sqrt (softWeight C ε c z) ^ 2 = softWeight C ε c z := fun c _ =>
      Real.sq_sqrt (hw0 c z)
    have e3 : ∀ c ∈ C, (Real.sqrt (softWeight C ε c z) * (2 * ‖dir z - c‖ / ‖z‖)) ^ 2
        = softWeight C ε c z * (2 * ‖dir z - c‖ / ‖z‖) ^ 2 := fun c _ => by
      rw [mul_pow, Real.sq_sqrt (hw0 c z)]
    rw [Finset.sum_congr rfl e1, Finset.sum_congr rfl e2, Finset.sum_congr rfl e3,
      sum_softWeight C hC, one_mul] at hcs
    exact hcs
  -- each squared slope is `4 h_c(z)/‖z‖²`
  have h3 : ∑ c ∈ C, softWeight C ε c z * (2 * ‖dir z - c‖ / ‖z‖) ^ 2
      = (4 / ‖z‖ ^ 2) * ∑ c ∈ C, softWeight C ε c z * hc c z := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun c _ => ?_
    unfold hc
    field_simp
    ring
  have h4 : ∑ c ∈ C, softWeight C ε c z * hc c z ≤ fC C hC z + C.card * ε := by
    have : ∀ c ∈ C, softWeight C ε c z * hc c z ≤ softWeight C ε c z * fC C hC z + ε := fun c hc' =>
      by linarith [softWeight_mul_sub_le C hC hε c z hc']
    calc ∑ c ∈ C, softWeight C ε c z * hc c z
        ≤ ∑ c ∈ C, (softWeight C ε c z * fC C hC z + ε) := Finset.sum_le_sum this
      _ = fC C hC z + C.card * ε := by
          rw [Finset.sum_add_distrib, ← Finset.sum_mul, sum_softWeight C hC, one_mul,
            Finset.sum_const, nsmul_eq_mul]
  calc ‖fderiv ℝ (smoothMin C ε) z‖ ^ 2
      ≤ (∑ c ∈ C, softWeight C ε c z * (2 * ‖dir z - c‖ / ‖z‖)) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) h1 2
    _ ≤ (4 / ‖z‖ ^ 2) * ∑ c ∈ C, softWeight C ε c z * hc c z := h2.trans (le_of_eq h3)
    _ ≤ (4 / ‖z‖ ^ 2) * (fC C hC z + C.card * ε) :=
        mul_le_mul_of_nonneg_left h4 (by positivity)
    _ = 4 * (fC C hC z + C.card * ε) / ‖z‖ ^ 2 := by ring

end SmoothMin
/-! ## §34  The sharp constant `4/(d − 2)` for finite codebooks

Applying §32 to `g = χ_δ f_ε` and letting `δ = ε → 0` gives the Gaussian Poincaré inequality
for `f_C` with the sharp constant, `Var_γ f_C ≤ 4/(d − 2) · E_γ f_C` (`variance_fC_le_sharp`),
replacing the `2π²/(d − 2)` of §30.  The error terms are the cutoff's contribution to the
derivative, `O(γ(B(0, 2δ))/δ²) = O(δ^{d−2})` since the Gaussian density is at most `1/Z`
(`gaussianE_ball_le`), and the `L²` distance from `f_C` to `χ_δ f_ε`, `O(ε² + δ^d)`; the
comparison `Var f ≤ (1 + η) Var g + (1 + 1/η) E(f − g)²` (`variance_le_of_close`) and two
limits close the argument.  Transported to the sphere, `Var_σ ‖u − q u‖² ≤ 4ρ²/(d − 2)` for
every nearest-codeword stage with a finite codebook (`variance_stageErr_le_finite_sharp`), and
`meas_not_decayWithin_le_finite_sharp` is the concentration remark at rate
`4P/((d − 2) ε² ρ²)`, the paper's `P/(d ε² ρ²)` with the constant made explicit, for scalar,
`E8` and trellis codebooks, with no unproved hypothesis. -/

section BallBound

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

theorem gaussDensity_le_one (x : E) : gaussDensity x ≤ 1 := by
  unfold gaussDensity
  rw [← ENNReal.ofReal_one]
  exact ENNReal.ofReal_le_ofReal (Real.exp_le_one_iff.mpr (by
    have := sq_nonneg ‖x‖; linarith))

/-- The Gaussian measure of a set is at most `Z⁻¹` times its volume. -/
theorem gaussianE_apply_le {s : Set E} (hs : MeasurableSet s) :
    gaussianE E s ≤ (gaussRaw E Set.univ)⁻¹ * volume s := by
  unfold gaussianE
  rw [Measure.smul_apply, smul_eq_mul]
  refine mul_le_mul' le_rfl ?_
  unfold gaussRaw
  rw [withDensity_apply _ hs]
  calc ∫⁻ x in s, gaussDensity x ∂volume ≤ ∫⁻ _ in s, (1 : ℝ≥0∞) ∂volume :=
        lintegral_mono fun x => gaussDensity_le_one x
    _ = volume s := setLIntegral_one s

/-- The normalising constant of the ball bound, as a real number. -/
noncomputable def ballConst (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [MeasurableSpace E] [BorelSpace E] [FiniteDimensional ℝ E] : ℝ :=
  ((gaussRaw E Set.univ)⁻¹ * volume (Metric.ball (0 : E) 1)).toReal

theorem ballConst_nonneg : 0 ≤ ballConst E := ENNReal.toReal_nonneg

/-- `γ(B(0, r)) ≤ ballConst · r^d`. -/
theorem gaussianE_ball_le {r : ℝ} (hr : 0 ≤ r) :
    (gaussianE E (Metric.ball 0 r)).toReal ≤ ballConst E * r ^ Module.finrank ℝ E := by
  have h1 := gaussianE_apply_le (E := E) (measurableSet_ball (x := (0 : E)) (ε := r))
  rw [Measure.addHaar_ball (volume : Measure E) (0 : E) hr] at h1
  have hfin : (gaussRaw E Set.univ)⁻¹ * volume (Metric.ball (0 : E) 1) ≠ ⊤ :=
    ENNReal.mul_ne_top (ENNReal.inv_ne_top.mpr gaussRaw_univ_ne_zero) measure_ball_lt_top.ne
  calc (gaussianE E (Metric.ball 0 r)).toReal
      ≤ ((gaussRaw E Set.univ)⁻¹ * (ENNReal.ofReal (r ^ Module.finrank ℝ E) *
          volume (Metric.ball (0 : E) 1))).toReal :=
        ENNReal.toReal_mono (ENNReal.mul_ne_top (ENNReal.inv_ne_top.mpr gaussRaw_univ_ne_zero)
          (ENNReal.mul_ne_top ENNReal.ofReal_ne_top measure_ball_lt_top.ne)) h1
    _ = ballConst E * r ^ Module.finrank ℝ E := by
        unfold ballConst
        rw [mul_left_comm, ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity), mul_comm]

end BallBound

section VarianceCompare

variable {X : Type*} [MeasurableSpace X] {μ : Measure X} [IsProbabilityMeasure μ]

/-- `Var f ≤ (1 + η) Var g + (1 + 1/η) E(f − g)²` for bounded `f, g`. -/
theorem variance_le_of_close {f g : X → ℝ} (hf : Measurable f) (hg : Measurable g) {Mf Mg : ℝ}
    (hfb : ∀ x, |f x| ≤ Mf) (hgb : ∀ x, |g x| ≤ Mg) {η : ℝ} (hη : 0 < η) :
    variance f μ ≤ (1 + η) * variance g μ + (1 + 1 / η) * ∫ x, (f x - g x) ^ 2 ∂μ := by
  have hfmem : MemLp f 2 μ := MemLp.of_bound hf.aestronglyMeasurable Mf
    (Filter.Eventually.of_forall fun x => by rw [Real.norm_eq_abs]; exact hfb x)
  have hgmem : MemLp g 2 μ := MemLp.of_bound hg.aestronglyMeasurable Mg
    (Filter.Eventually.of_forall fun x => by rw [Real.norm_eq_abs]; exact hgb x)
  have hbound : ∀ x, (f x - ∫ y, g y ∂μ) ^ 2
      ≤ (1 + η) * (g x - ∫ y, g y ∂μ) ^ 2 + (1 + 1 / η) * (f x - g x) ^ 2 := by
    intro x
    have key : ∀ a b : ℝ, (a + b) ^ 2 ≤ (1 + η) * a ^ 2 + (1 + 1 / η) * b ^ 2 := by
      intro a b
      have h0 : 0 ≤ (η * a - b) ^ 2 / η := div_nonneg (sq_nonneg _) hη.le
      have e : (η * a - b) ^ 2 / η = η * a ^ 2 - 2 * a * b + b ^ 2 / η := by
        field_simp; ring
      rw [e] at h0
      have e2 : (1 + 1 / η) * b ^ 2 = b ^ 2 + b ^ 2 / η := by ring
      rw [e2]
      nlinarith [h0]
    have := key (g x - ∫ y, g y ∂μ) (f x - g x)
    rwa [show g x - ∫ y, g y ∂μ + (f x - g x) = f x - ∫ y, g y ∂μ by ring] at this
  -- `Var f ≤ E(f − a)²` for every `a`
  have hvar : variance f μ ≤ ∫ x, (f x - ∫ y, g y ∂μ) ^ 2 ∂μ := by
    set a := ∫ y, g y ∂μ
    have hfi : Integrable f μ := hfmem.integrable one_le_two
    have hf2 : Integrable (fun x => f x ^ 2) μ := hfmem.integrable_sq
    rw [variance_eq_sub hfmem]
    have h1 : ∫ x, (f x - a) ^ 2 ∂μ = ∫ x, f x ^ 2 ∂μ - 2 * a * ∫ x, f x ∂μ + a ^ 2 := by
      have : (fun x => (f x - a) ^ 2) = fun x => f x ^ 2 - 2 * a * f x + a ^ 2 := by
        funext x; ring
      have hB : Integrable (fun x => 2 * a * f x) μ := hfi.const_mul _
      have hA : Integrable (fun x => f x ^ 2 - 2 * a * f x) μ := hf2.sub hB
      rw [this, integral_add hA (integrable_const _), integral_sub hf2 hB, integral_const_mul,
        integral_const, measureReal_def, measure_univ, ENNReal.toReal_one, one_smul]
    rw [h1]
    have : ∫ x, (f ^ 2) x ∂μ = ∫ x, f x ^ 2 ∂μ := rfl
    rw [this]
    nlinarith [sq_nonneg ((∫ x, f x ∂μ) - a)]
  refine hvar.trans ?_
  have hgi : Integrable (fun x => (g x - ∫ y, g y ∂μ) ^ 2) μ :=
    (hgmem.sub (memLp_const _)).integrable_sq
  have hfgi : Integrable (fun x => (f x - g x) ^ 2) μ := (hfmem.sub hgmem).integrable_sq
  calc ∫ x, (f x - ∫ y, g y ∂μ) ^ 2 ∂μ
      ≤ ∫ x, ((1 + η) * (g x - ∫ y, g y ∂μ) ^ 2 + (1 + 1 / η) * (f x - g x) ^ 2) ∂μ :=
        integral_mono ((hfmem.sub (memLp_const _)).integrable_sq)
          ((hgi.const_mul _).add (hfgi.const_mul _)) hbound
    _ = (1 + η) * variance g μ + (1 + 1 / η) * ∫ x, (f x - g x) ^ 2 ∂μ := by
        rw [integral_add (hgi.const_mul _) (hfgi.const_mul _), integral_const_mul,
          integral_const_mul, variance_eq_integral hg.aemeasurable]

end VarianceCompare

section WeightedIntegrals

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

/-- `E[1/‖Z‖²] = 1/(d − 2)` as a real integral. -/
theorem integral_inv_normSq_gaussianE (hd : 3 ≤ Module.finrank ℝ E) :
    ∫ x, (‖x‖ ^ 2)⁻¹ ∂(gaussianE E) = 1 / ((Module.finrank ℝ E : ℝ) - 2) := by
  have h := lintegral_gaussianE_dir_div_normSq hd (ψ := fun _ => (1 : ℝ≥0∞)) measurable_const
  simp only [one_mul, lintegral_const, measure_univ] at h
  have hm : Measurable fun x : E => (‖x‖ ^ 2)⁻¹ := (measurable_norm.pow_const 2).inv
  rw [integral_eq_lintegral_of_nonneg_ae (Filter.Eventually.of_forall fun x => by positivity)
    hm.aestronglyMeasurable, h, ENNReal.toReal_ofReal]
  have : (3 : ℝ) ≤ Module.finrank ℝ E := by exact_mod_cast hd
  exact div_nonneg zero_le_one (by linarith)

theorem integrable_inv_normSq_gaussianE (hd : 3 ≤ Module.finrank ℝ E) :
    Integrable (fun x : E => (‖x‖ ^ 2)⁻¹) (gaussianE E) := by
  have hm : Measurable fun x : E => (‖x‖ ^ 2)⁻¹ := (measurable_norm.pow_const 2).inv
  refine ⟨hm.aestronglyMeasurable, ?_⟩
  rw [hasFiniteIntegral_iff_ofReal (Filter.Eventually.of_forall fun x => by positivity)]
  have h := lintegral_gaussianE_dir_div_normSq hd (ψ := fun _ => (1 : ℝ≥0∞)) measurable_const
  simp only [one_mul, lintegral_const, measure_univ] at h
  rw [h]; exact ENNReal.ofReal_lt_top

/-- `E[f_C(Z)/‖Z‖²] = E[f_C]/(d − 2)`. -/
theorem integral_fC_div_normSq (hd : 3 ≤ Module.finrank ℝ E) (C : Finset E) (hC : C.Nonempty) :
    ∫ x, fC C hC x * (‖x‖ ^ 2)⁻¹ ∂(gaussianE E)
      = (∫ x, fC C hC x ∂(gaussianE E)) / ((Module.finrank ℝ E : ℝ) - 2) := by
  have hd' : (0 : ℝ) < (Module.finrank ℝ E : ℝ) - 2 := by
    have : (3 : ℝ) ≤ Module.finrank ℝ E := by exact_mod_cast hd
    linarith
  have h := lintegral_gaussianE_dir_div_normSq hd (ψ := fun u => ENNReal.ofReal (fC C hC u))
    (measurable_fC C hC).ennreal_ofReal
  simp only [fC_dir] at h
  rw [← measurePreserving_dir.lintegral_comp (f := fun u => ENNReal.ofReal (fC C hC u))
    (measurable_fC C hC).ennreal_ofReal] at h
  simp only [fC_dir] at h
  have hm2 : Measurable fun x : E => fC C hC x * (‖x‖ ^ 2)⁻¹ :=
    (measurable_fC C hC).mul (measurable_norm.pow_const 2).inv
  rw [integral_eq_lintegral_of_nonneg_ae (Filter.Eventually.of_forall fun x =>
      mul_nonneg (fC_nonneg C hC x) (by positivity)) hm2.aestronglyMeasurable]
  simp_rw [ENNReal.ofReal_mul (fC_nonneg C hC _)]
  rw [h, ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity),
    integral_eq_lintegral_of_nonneg_ae (Filter.Eventually.of_forall (fC_nonneg C hC))
      (measurable_fC C hC).aestronglyMeasurable]
  ring

theorem integrable_fC_div_normSq (hd : 3 ≤ Module.finrank ℝ E) (C : Finset E) (hC : C.Nonempty) :
    Integrable (fun x : E => fC C hC x * (‖x‖ ^ 2)⁻¹) (gaussianE E) := by
  have hm2 : Measurable fun x : E => fC C hC x * (‖x‖ ^ 2)⁻¹ :=
    (measurable_fC C hC).mul (measurable_norm.pow_const 2).inv
  refine ⟨hm2.aestronglyMeasurable, ?_⟩
  rw [hasFiniteIntegral_iff_ofReal (Filter.Eventually.of_forall fun x =>
    mul_nonneg (fC_nonneg C hC x) (by positivity))]
  have h := lintegral_gaussianE_dir_div_normSq hd (ψ := fun u => ENNReal.ofReal (fC C hC u))
    (measurable_fC C hC).ennreal_ofReal
  simp only [fC_dir] at h
  simp_rw [ENNReal.ofReal_mul (fC_nonneg C hC _)]
  rw [h]
  exact ENNReal.mul_lt_top (lt_of_le_of_ne le_top (by
    rw [← measurePreserving_dir.lintegral_comp (f := fun u => ENNReal.ofReal (fC C hC u))
      (measurable_fC C hC).ennreal_ofReal]
    simp only [fC_dir]
    exact lintegral_fC_ne_top C hC)) ENNReal.ofReal_lt_top

end WeightedIntegrals

section SharpAssembly

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E] [SecondCountableTopology E]

/-- The cut-off smooth minimum `χ_δ · f_ε`. -/
noncomputable def gApprox (C : Finset E) (ε δ : ℝ) (z : E) : ℝ := cutoff δ z * smoothMin C ε z

/-- The bound on the codebook: `M₀ = (1 + max ‖c‖)²`. -/
noncomputable def codeBound (C : Finset E) (hC : C.Nonempty) : ℝ := (1 + C.sup' hC (fun c => ‖c‖)) ^ 2

theorem codeBound_nonneg (C : Finset E) (hC : C.Nonempty) : 0 ≤ codeBound C hC := sq_nonneg _

theorem sup_norm_nonneg (C : Finset E) (hC : C.Nonempty) : 0 ≤ C.sup' hC (fun c => ‖c‖) := by
  obtain ⟨c, hc⟩ := hC
  exact (norm_nonneg c).trans (Finset.le_sup' (fun c => ‖c‖) hc)

theorem abs_smoothMin_le (C : Finset E) (hC : C.Nonempty) {ε : ℝ} (hε : 0 < ε) (hε1 : ε ≤ 1)
    (z : E) : |smoothMin C ε z| ≤ codeBound C hC + Real.log C.card := by
  have hlog : 0 ≤ Real.log C.card := Real.log_nonneg (by exact_mod_cast hC.card_pos)
  have h1 := abs_smoothMin_sub_fC_le C hC hε z
  have h2 := fC_le C hC z
  have h3 := fC_nonneg C hC z
  have h4 : ε * Real.log C.card ≤ Real.log C.card := by nlinarith
  unfold codeBound
  rw [abs_le] at h1 ⊢
  constructor <;> linarith

theorem abs_gApprox_le (C : Finset E) (hC : C.Nonempty) {ε : ℝ} (hε : 0 < ε) (hε1 : ε ≤ 1)
    (δ : ℝ) (z : E) : |gApprox C ε δ z| ≤ codeBound C hC + Real.log C.card := by
  unfold gApprox
  rw [abs_mul, abs_of_nonneg (cutoff_nonneg δ z)]
  calc cutoff δ z * |smoothMin C ε z| ≤ 1 * |smoothMin C ε z| :=
        mul_le_mul_of_nonneg_right (cutoff_le_one δ z) (abs_nonneg _)
    _ ≤ _ := by rw [one_mul]; exact abs_smoothMin_le C hC hε hε1 z

theorem hasFDerivAt_gApprox_of_lt (C : Finset E) {ε δ : ℝ} (hδ : 0 < δ) {z : E} (hz : ‖z‖ < δ) :
    HasFDerivAt (gApprox C ε δ) (0 : E →L[ℝ] ℝ) z := by
  refine (hasFDerivAt_const (0 : ℝ) z).congr_of_eventuallyEq ?_
  have hopen : {w : E | ‖w‖ < δ} ∈ 𝓝 z := (isOpen_lt continuous_norm continuous_const).mem_nhds hz
  filter_upwards [hopen] with w hw
  unfold gApprox
  rw [cutoff_eq_zero hδ (le_of_lt hw), zero_mul]

theorem hasFDerivAt_gApprox_of_ne (C : Finset E) (hC : C.Nonempty) {ε δ : ℝ} (hε : 0 < ε)
    (hδ : 0 < δ) {z : E} (hz : z ≠ 0) :
    HasFDerivAt (gApprox C ε δ)
      (cutoff δ z • fderiv ℝ (smoothMin C ε) z + smoothMin C ε z • fderiv ℝ (cutoff δ) z) z := by
  have h1 := hasFDerivAt_cutoff hδ z
  have h2 := hasFDerivAt_smoothMin C hC hε hz
  have h := h1.mul h2
  rw [h1.fderiv, h2.fderiv]
  exact h

theorem differentiable_gApprox (C : Finset E) (hC : C.Nonempty) {ε δ : ℝ} (hε : 0 < ε)
    (hδ : 0 < δ) : Differentiable ℝ (gApprox C ε δ) := by
  intro z
  rcases lt_or_ge ‖z‖ δ with hz | hz
  · exact (hasFDerivAt_gApprox_of_lt C hδ hz).differentiableAt
  · have hz0 : z ≠ 0 := by
      intro h; rw [h, norm_zero] at hz; linarith
    exact (hasFDerivAt_gApprox_of_ne C hC hε hδ hz0).differentiableAt

theorem norm_fderiv_smoothMin_le' (C : Finset E) (hC : C.Nonempty) {ε : ℝ} (hε : 0 < ε) {z : E}
    (hz : z ≠ 0) : ‖fderiv ℝ (smoothMin C ε) z‖ ≤ 2 * (1 + C.sup' hC (fun c => ‖c‖)) / ‖z‖ := by
  have hz' : 0 < ‖z‖ := norm_pos_iff.mpr hz
  refine (norm_fderiv_smoothMin_le C hC hε hz).trans ?_
  have hb : ∀ c ∈ C, 2 * ‖dir z - c‖ / ‖z‖ ≤ 2 * (1 + C.sup' hC (fun c => ‖c‖)) / ‖z‖ := by
    intro c hc'
    refine div_le_div_of_nonneg_right ?_ hz'.le
    have := norm_dir_le_one z
    have := Finset.le_sup' (fun c => ‖c‖) hc'
    have := norm_sub_le (dir z) c
    linarith
  calc ∑ c ∈ C, softWeight C ε c z * (2 * ‖dir z - c‖ / ‖z‖)
      ≤ ∑ c ∈ C, softWeight C ε c z * (2 * (1 + C.sup' hC (fun c => ‖c‖)) / ‖z‖) :=
        Finset.sum_le_sum fun c hc' =>
          mul_le_mul_of_nonneg_left (hb c hc') (softWeight_nonneg C ε c z)
    _ = 2 * (1 + C.sup' hC (fun c => ‖c‖)) / ‖z‖ := by
        rw [← Finset.sum_mul, sum_softWeight C hC, one_mul]

/-- The derivative of the cut-off smooth minimum is bounded, by `K/δ`. -/
theorem norm_fderiv_gApprox_le (C : Finset E) (hC : C.Nonempty) {Cc : ℝ}
    (hCc : ∀ δ : ℝ, 0 < δ → ∀ z : E, ‖fderiv ℝ (cutoff δ) z‖ ≤ Cc / δ) {ε δ : ℝ} (hε : 0 < ε)
    (hε1 : ε ≤ 1) (hδ : 0 < δ) (z : E) :
    ‖fderiv ℝ (gApprox C ε δ) z‖ ≤ (2 * (1 + C.sup' hC (fun c => ‖c‖)) +
      (codeBound C hC + Real.log C.card) * Cc) / δ := by
  have hs := sup_norm_nonneg C hC
  have hM := codeBound_nonneg C hC
  have hlog : 0 ≤ Real.log C.card := Real.log_nonneg (by exact_mod_cast hC.card_pos)
  have hCc0 : 0 ≤ Cc := by
    have := (norm_nonneg _).trans (hCc 1 one_pos 0); simpa using this
  rcases lt_or_ge ‖z‖ δ with hz | hz
  · rw [(hasFDerivAt_gApprox_of_lt C hδ hz).fderiv, norm_zero]; positivity
  · have hz0 : z ≠ 0 := by intro h; rw [h, norm_zero] at hz; linarith
    rw [(hasFDerivAt_gApprox_of_ne C hC hε hδ hz0).fderiv]
    refine (norm_add_le _ _).trans ?_
    rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (cutoff_nonneg δ z)]
    have h1 : cutoff δ z * ‖fderiv ℝ (smoothMin C ε) z‖ ≤ 2 * (1 + C.sup' hC (fun c => ‖c‖)) / δ := by
      calc cutoff δ z * ‖fderiv ℝ (smoothMin C ε) z‖ ≤ 1 * (2 * (1 + C.sup' hC (fun c => ‖c‖)) / ‖z‖) :=
            mul_le_mul (cutoff_le_one δ z) (norm_fderiv_smoothMin_le' C hC hε hz0) (norm_nonneg _)
              zero_le_one
        _ ≤ 2 * (1 + C.sup' hC (fun c => ‖c‖)) / δ := by
            rw [one_mul]; exact div_le_div_of_nonneg_left (by positivity) hδ hz
    have h2 : |smoothMin C ε z| * ‖fderiv ℝ (cutoff δ) z‖
        ≤ (codeBound C hC + Real.log C.card) * (Cc / δ) :=
      mul_le_mul (abs_smoothMin_le C hC hε hε1 z) (hCc δ hδ z) (norm_nonneg _) (by positivity)
    rw [add_div]
    calc _ ≤ 2 * (1 + C.sup' hC (fun c => ‖c‖)) / δ + (codeBound C hC + Real.log C.card) * (Cc / δ) :=
          add_le_add h1 h2
      _ = _ := by ring

/-- The pointwise bound on the squared derivative:
`‖g'(z)‖² ≤ 4 (f_C(z) + |C| ε)/‖z‖² + (A/δ²) 1_{B(0, 2δ)}(z)`. -/
theorem norm_fderiv_gApprox_sq_le (C : Finset E) (hC : C.Nonempty) {Cc : ℝ}
    (hCc : ∀ δ : ℝ, 0 < δ → ∀ z : E, ‖fderiv ℝ (cutoff δ) z‖ ≤ Cc / δ) {ε δ : ℝ} (hε : 0 < ε)
    (hε1 : ε ≤ 1) (hδ : 0 < δ) (z : E) :
    ‖fderiv ℝ (gApprox C ε δ) z‖ ^ 2
      ≤ 4 * (fC C hC z + C.card * ε) * (‖z‖ ^ 2)⁻¹
        + (Metric.ball (0 : E) (2 * δ)).indicator (fun _ =>
            (4 * (1 + C.sup' hC (fun c => ‖c‖)) * ((codeBound C hC + Real.log C.card) * Cc)
              + ((codeBound C hC + Real.log C.card) * Cc) ^ 2) / δ ^ 2) z := by
  have hs := sup_norm_nonneg C hC
  have hM := codeBound_nonneg C hC
  have hlog : 0 ≤ Real.log C.card := Real.log_nonneg (by exact_mod_cast hC.card_pos)
  have hCc0 : 0 ≤ Cc := by
    have := (norm_nonneg _).trans (hCc 1 one_pos 0); simpa using this
  have hf := fC_nonneg C hC z
  have hcard : (0 : ℝ) ≤ C.card := by positivity
  have hind : 0 ≤ (Metric.ball (0 : E) (2 * δ)).indicator (fun _ =>
      (4 * (1 + C.sup' hC (fun c => ‖c‖)) * ((codeBound C hC + Real.log C.card) * Cc)
        + ((codeBound C hC + Real.log C.card) * Cc) ^ 2) / δ ^ 2) z :=
    Set.indicator_nonneg (fun _ _ => by positivity) _
  have hmain : 0 ≤ 4 * (fC C hC z + C.card * ε) * (‖z‖ ^ 2)⁻¹ := by positivity
  rcases lt_or_ge ‖z‖ δ with hz | hz
  · rw [(hasFDerivAt_gApprox_of_lt C hδ hz).fderiv, norm_zero]; simp only [zero_pow two_ne_zero]
    linarith
  · have hz0 : z ≠ 0 := by intro h; rw [h, norm_zero] at hz; linarith
    have hz' : 0 < ‖z‖ := norm_pos_iff.mpr hz0
    rw [(hasFDerivAt_gApprox_of_ne C hC hε hδ hz0).fderiv]
    set a := ‖fderiv ℝ (smoothMin C ε) z‖ with ha
    set b := |smoothMin C ε z| * ‖fderiv ℝ (cutoff δ) z‖ with hb
    have hab : ‖cutoff δ z • fderiv ℝ (smoothMin C ε) z + smoothMin C ε z • fderiv ℝ (cutoff δ) z‖
        ≤ a + b := by
      refine (norm_add_le _ _).trans ?_
      rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs,
        abs_of_nonneg (cutoff_nonneg δ z)]
      exact add_le_add (mul_le_of_le_one_left (norm_nonneg _) (cutoff_le_one δ z)) le_rfl
    have ha2 : a ^ 2 ≤ 4 * (fC C hC z + C.card * ε) * (‖z‖ ^ 2)⁻¹ := by
      rw [ha, ← div_eq_mul_inv]; exact norm_fderiv_smoothMin_sq_le C hC hε hz0
    have hb0 : 0 ≤ b := by positivity
    have ha0 : 0 ≤ a := norm_nonneg _
    rcases lt_or_ge (2 * δ ^ 2) (‖z‖ ^ 2) with hz2 | hz2
    · -- outside the support of the cutoff derivative
      have : b = 0 := by rw [hb, fderiv_cutoff_eq_zero hδ hz2, norm_zero, mul_zero]
      rw [this, add_zero] at hab
      calc _ ≤ a ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hab 2
        _ ≤ _ := by linarith
    · have hball : z ∈ Metric.ball (0 : E) (2 * δ) := by
        rw [Metric.mem_ball, dist_zero_right]
        nlinarith [sq_nonneg (‖z‖ - 2 * δ), hz']
      rw [Set.indicator_of_mem hball]
      have ha' : a ≤ 2 * (1 + C.sup' hC (fun c => ‖c‖)) / δ :=
        (norm_fderiv_smoothMin_le' C hC hε hz0).trans
          (div_le_div_of_nonneg_left (by positivity) hδ hz)
      have hb' : b ≤ (codeBound C hC + Real.log C.card) * Cc / δ := by
        rw [hb, mul_div_assoc]
        exact mul_le_mul (abs_smoothMin_le C hC hε hε1 z) (hCc δ hδ z) (norm_nonneg _)
          (by positivity)
      calc _ ≤ (a + b) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hab 2
        _ = a ^ 2 + (2 * a * b + b ^ 2) := by ring
        _ ≤ 4 * (fC C hC z + C.card * ε) * (‖z‖ ^ 2)⁻¹ +
            (4 * (1 + C.sup' hC (fun c => ‖c‖)) * ((codeBound C hC + Real.log C.card) * Cc)
              + ((codeBound C hC + Real.log C.card) * Cc) ^ 2) / δ ^ 2 := by
            refine add_le_add ha2 ?_
            have e : (4 * (1 + C.sup' hC (fun c => ‖c‖)) * ((codeBound C hC + Real.log C.card) * Cc)
                + ((codeBound C hC + Real.log C.card) * Cc) ^ 2) / δ ^ 2
                = 2 * (2 * (1 + C.sup' hC (fun c => ‖c‖)) / δ) *
                    ((codeBound C hC + Real.log C.card) * Cc / δ)
                  + ((codeBound C hC + Real.log C.card) * Cc / δ) ^ 2 := by
              field_simp; ring
            rw [e]
            have := mul_le_mul ha' hb' hb0 (by positivity)
            nlinarith [pow_le_pow_left₀ hb0 hb' 2]


/-- The constant in the error term of the derivative bound. -/
noncomputable def errA (C : Finset E) (hC : C.Nonempty) (Cc : ℝ) : ℝ :=
  4 * (1 + C.sup' hC (fun c => ‖c‖)) * ((codeBound C hC + Real.log C.card) * Cc)
    + ((codeBound C hC + Real.log C.card) * Cc) ^ 2

theorem errA_nonneg (C : Finset E) (hC : C.Nonempty) {Cc : ℝ} (hCc : 0 ≤ Cc) : 0 ≤ errA C hC Cc := by
  have := sup_norm_nonneg C hC
  have := codeBound_nonneg C hC
  have : 0 ≤ Real.log C.card := Real.log_nonneg (by exact_mod_cast hC.card_pos)
  unfold errA; positivity

/-- **The variance of the cut-off smooth minimum**:
`Var g ≤ 4 (E f_C + |C| ε)/(d − 2) + (A/δ²) γ(B(0, 2δ))`. -/
theorem variance_gApprox_le (hd : 3 ≤ Module.finrank ℝ E) (C : Finset E) (hC : C.Nonempty)
    {Cc : ℝ} (hCc : ∀ δ : ℝ, 0 < δ → ∀ z : E, ‖fderiv ℝ (cutoff δ) z‖ ≤ Cc / δ) {ε δ : ℝ}
    (hε : 0 < ε) (hε1 : ε ≤ 1) (hδ : 0 < δ) :
    variance (gApprox C ε δ) (gaussianE E)
      ≤ 4 * ((∫ x, fC C hC x ∂(gaussianE E)) + C.card * ε) / ((Module.finrank ℝ E : ℝ) - 2)
        + errA C hC Cc / δ ^ 2 * (gaussianE E (Metric.ball (0 : E) (2 * δ))).toReal := by
  have hd2 : 2 ≤ Module.finrank ℝ E := by omega
  have hd' : (0 : ℝ) < (Module.finrank ℝ E : ℝ) - 2 := by
    have : (3 : ℝ) ≤ Module.finrank ℝ E := by exact_mod_cast hd
    linarith
  have hg := differentiable_gApprox C hC hε hδ
  have hcard : (0 : ℝ) ≤ C.card := by positivity
  refine (variance_le_integral_norm_fderiv_sq hd2 hg (abs_gApprox_le C hC hε hε1 δ)
    (norm_fderiv_gApprox_le C hC hCc hε hε1 hδ)).trans ?_
  have hint1 : Integrable (fun z : E => 4 * (fC C hC z + C.card * ε) * (‖z‖ ^ 2)⁻¹) (gaussianE E) := by
    have : (fun z : E => 4 * (fC C hC z + C.card * ε) * (‖z‖ ^ 2)⁻¹)
        = fun z => 4 * (fC C hC z * (‖z‖ ^ 2)⁻¹) + (4 * (C.card * ε)) * (‖z‖ ^ 2)⁻¹ := by
      funext z; ring
    rw [this]
    exact ((integrable_fC_div_normSq hd C hC).const_mul _).add
      ((integrable_inv_normSq_gaussianE hd).const_mul _)
  have hint2 : Integrable ((Metric.ball (0 : E) (2 * δ)).indicator fun _ => errA C hC Cc / δ ^ 2)
      (gaussianE E) := (integrable_const _).indicator measurableSet_ball
  calc ∫ z, ‖fderiv ℝ (gApprox C ε δ) z‖ ^ 2 ∂(gaussianE E)
      ≤ ∫ z, (4 * (fC C hC z + C.card * ε) * (‖z‖ ^ 2)⁻¹
          + (Metric.ball (0 : E) (2 * δ)).indicator (fun _ => errA C hC Cc / δ ^ 2) z) ∂(gaussianE E) := by
        refine integral_mono (integrable_norm_fderiv_sq (norm_fderiv_gApprox_le C hC hCc hε hε1 hδ)
          measurable_id) (hint1.add hint2) fun z => ?_
        exact norm_fderiv_gApprox_sq_le C hC hCc hε hε1 hδ z
    _ = _ := by
        rw [integral_add hint1 hint2, integral_indicator measurableSet_ball, setIntegral_const,
          smul_eq_mul, measureReal_def, mul_comm (errA C hC Cc / δ ^ 2)]
        congr 1
        have : (fun z : E => 4 * (fC C hC z + C.card * ε) * (‖z‖ ^ 2)⁻¹)
            = fun z => 4 * (fC C hC z * (‖z‖ ^ 2)⁻¹) + (4 * (C.card * ε)) * (‖z‖ ^ 2)⁻¹ := by
          funext z; ring
        rw [this, integral_add ((integrable_fC_div_normSq hd C hC).const_mul _)
          ((integrable_inv_normSq_gaussianE hd).const_mul _), integral_const_mul, integral_const_mul,
          integral_fC_div_normSq hd C hC, integral_inv_normSq_gaussianE hd]
        first | (field_simp; ring) | field_simp

/-- The `L²` distance from `f_C` to the cut-off smooth minimum. -/
theorem integral_sq_sub_gApprox_le (C : Finset E) (hC : C.Nonempty) {ε δ : ℝ} (hε : 0 < ε)
    (hε1 : ε ≤ 1) (hδ : 0 < δ) :
    ∫ z, (fC C hC z - gApprox C ε δ z) ^ 2 ∂(gaussianE E)
      ≤ 2 * (ε * Real.log C.card) ^ 2
        + 2 * (codeBound C hC + Real.log C.card) ^ 2 *
            (gaussianE E (Metric.ball (0 : E) (2 * δ))).toReal := by
  have hlog : 0 ≤ Real.log C.card := Real.log_nonneg (by exact_mod_cast hC.card_pos)
  have hM := codeBound_nonneg C hC
  set M₁ := codeBound C hC + Real.log C.card with hM₁
  have hpt : ∀ z, (fC C hC z - gApprox C ε δ z) ^ 2
      ≤ 2 * (ε * Real.log C.card) ^ 2
        + (Metric.ball (0 : E) (2 * δ)).indicator (fun _ => 2 * M₁ ^ 2) z := by
    intro z
    have h1 := abs_smoothMin_sub_fC_le C hC hε z
    have h2 := abs_smoothMin_le C hC hε hε1 z
    have hsplit : fC C hC z - gApprox C ε δ z
        = (fC C hC z - smoothMin C ε z) + (1 - cutoff δ z) * smoothMin C ε z := by
      unfold gApprox; ring
    rw [hsplit]
    have hc0 := cutoff_nonneg δ z
    have hc1 := cutoff_le_one δ z
    have key : ∀ a b : ℝ, (a + b) ^ 2 ≤ 2 * a ^ 2 + 2 * b ^ 2 := fun a b => by
      nlinarith [sq_nonneg (a - b)]
    refine (key _ _).trans (add_le_add ?_ ?_)
    · have : (fC C hC z - smoothMin C ε z) ^ 2 ≤ (ε * Real.log C.card) ^ 2 := by
        rw [← sq_abs, abs_sub_comm]
        exact pow_le_pow_left₀ (abs_nonneg _) h1 2
      linarith
    · rcases lt_or_ge ‖z‖ (2 * δ) with hz | hz
      · rw [Set.indicator_of_mem (by rw [Metric.mem_ball, dist_zero_right]; exact hz)]
        have : ((1 - cutoff δ z) * smoothMin C ε z) ^ 2 ≤ M₁ ^ 2 := by
          rw [← sq_abs, abs_mul, abs_of_nonneg (by linarith)]
          refine pow_le_pow_left₀ (by positivity) ?_ 2
          calc (1 - cutoff δ z) * |smoothMin C ε z| ≤ 1 * M₁ :=
                mul_le_mul (by linarith) h2 (abs_nonneg _) zero_le_one
            _ = M₁ := one_mul _
        nlinarith [sq_nonneg M₁]
      · rw [Set.indicator_of_notMem (by rw [Metric.mem_ball, dist_zero_right]; exact not_lt.mpr hz)]
        have hone : cutoff δ z = 1 := cutoff_eq_one hδ (by nlinarith)
        rw [hone, sub_self, zero_mul]; simp
  have hint : Integrable (fun z : E => 2 * (ε * Real.log C.card) ^ 2
      + (Metric.ball (0 : E) (2 * δ)).indicator (fun _ => 2 * M₁ ^ 2) z) (gaussianE E) :=
    (integrable_const _).add ((integrable_const _).indicator measurableSet_ball)
  have hmeas : Measurable fun z : E => (fC C hC z - gApprox C ε δ z) ^ 2 :=
    ((measurable_fC C hC).sub (differentiable_gApprox C hC hε hδ).continuous.measurable).pow_const 2
  calc ∫ z, (fC C hC z - gApprox C ε δ z) ^ 2 ∂(gaussianE E)
      ≤ ∫ z, (2 * (ε * Real.log C.card) ^ 2
          + (Metric.ball (0 : E) (2 * δ)).indicator (fun _ => 2 * M₁ ^ 2) z) ∂(gaussianE E) := by
        refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun z => sq_nonneg _) hint
          (Filter.Eventually.of_forall hpt)
    _ = _ := by
        rw [integral_add (integrable_const _) ((integrable_const _).indicator measurableSet_ball),
          integral_const, integral_indicator measurableSet_ball, setIntegral_const, smul_eq_mul,
          smul_eq_mul, measureReal_def, measureReal_def, measure_univ, ENNReal.toReal_one, one_mul]
        ring

/-- **The sharp Gaussian Poincaré inequality for the squared distance to a finite codebook**:
`Var_γ f_C ≤ 4/(d − 2) · E_γ f_C`. -/
theorem variance_fC_le_sharp (hd : 3 ≤ Module.finrank ℝ E) (C : Finset E) (hC : C.Nonempty) :
    variance (fC C hC) (gaussianE E)
      ≤ 4 / ((Module.finrank ℝ E : ℝ) - 2) * ∫ x, fC C hC x ∂(gaussianE E) := by
  obtain ⟨Cc, hCc0, hCc⟩ := exists_bound_fderiv_cutoff (E := E)
  have hd' : (0 : ℝ) < (Module.finrank ℝ E : ℝ) - 2 := by
    have : (3 : ℝ) ≤ Module.finrank ℝ E := by exact_mod_cast hd
    linarith
  set I := ∫ x, fC C hC x ∂(gaussianE E) with hI
  set d := Module.finrank ℝ E with hd_def
  set L := Real.log C.card with hL
  set M₁ := codeBound C hC + L with hM₁
  set A := errA C hC Cc with hA
  set B := ballConst E with hB
  have hB0 : 0 ≤ B := ballConst_nonneg
  have hA0 : 0 ≤ A := errA_nonneg C hC hCc0
  have hlog : 0 ≤ L := Real.log_nonneg (by exact_mod_cast hC.card_pos)
  have hM1 : 0 ≤ M₁ := by have := codeBound_nonneg C hC; linarith
  have hcard : (0 : ℝ) ≤ C.card := by positivity
  -- the bound for `ε = δ ∈ (0, 1]` and any `η > 0`
  have hbound : ∀ η : ℝ, 0 < η → ∀ ε : ℝ, 0 < ε → ε ≤ 1 →
      variance (fC C hC) (gaussianE E)
        ≤ (1 + η) * (4 * (I + C.card * ε) / ((d : ℝ) - 2) + A * B * 2 ^ d * ε ^ (d - 2))
          + (1 + 1 / η) * (2 * (ε * L) ^ 2 + 2 * M₁ ^ 2 * (B * 2 ^ d * ε ^ d)) := by
    intro η hη ε hε hε1
    have hball : (gaussianE E (Metric.ball (0 : E) (2 * ε))).toReal ≤ B * 2 ^ d * ε ^ d := by
      have := gaussianE_ball_le (E := E) (r := 2 * ε) (by positivity)
      rw [mul_pow] at this
      linarith [this]
    have hball0 : 0 ≤ (gaussianE E (Metric.ball (0 : E) (2 * ε))).toReal := ENNReal.toReal_nonneg
    have h1 := variance_gApprox_le hd C hC hCc hε hε1 hε
    have h2 := integral_sq_sub_gApprox_le C hC hε hε1 hε
    have h3 := variance_le_of_close (μ := gaussianE E) (measurable_fC C hC)
      (differentiable_gApprox C hC hε hε).continuous.measurable
      (fun z => by rw [abs_of_nonneg (fC_nonneg C hC z)]; exact fC_le C hC z)
      (abs_gApprox_le C hC hε hε1 ε) hη
    have hε2 : A / ε ^ 2 * (B * 2 ^ d * ε ^ d) = A * B * 2 ^ d * ε ^ (d - 2) := by
      have hd3 : d = (d - 2) + 2 := by omega
      rw [hd3, pow_add, Nat.add_sub_cancel]
      field_simp
      ring
    have hvarg : variance (gApprox C ε ε) (gaussianE E)
        ≤ 4 * (I + C.card * ε) / ((d : ℝ) - 2) + A * B * 2 ^ d * ε ^ (d - 2) := by
      refine h1.trans (add_le_add le_rfl ?_)
      rw [← hε2]
      exact mul_le_mul_of_nonneg_left hball (by positivity)
    have hL2 : ∫ z, (fC C hC z - gApprox C ε ε z) ^ 2 ∂(gaussianE E)
        ≤ 2 * (ε * L) ^ 2 + 2 * M₁ ^ 2 * (B * 2 ^ d * ε ^ d) := by
      refine h2.trans (add_le_add le_rfl ?_)
      exact mul_le_mul_of_nonneg_left hball (by positivity)
    have hvar0 := variance_nonneg (gApprox C ε ε) (gaussianE E)
    calc variance (fC C hC) (gaussianE E) ≤ _ := h3
      _ ≤ _ := add_le_add (mul_le_mul_of_nonneg_left hvarg (by linarith))
          (mul_le_mul_of_nonneg_left hL2 (by positivity))
  -- let `ε → 0⁺`
  have hlim : ∀ η : ℝ, 0 < η →
      variance (fC C hC) (gaussianE E) ≤ (1 + η) * (4 * I / ((d : ℝ) - 2)) := by
    intro η hη
    have hd2 : 1 ≤ d - 2 := by omega
    have hcont : Continuous fun ε : ℝ =>
        (1 + η) * (4 * (I + C.card * ε) / ((d : ℝ) - 2) + A * B * 2 ^ d * ε ^ (d - 2))
          + (1 + 1 / η) * (2 * (ε * L) ^ 2 + 2 * M₁ ^ 2 * (B * 2 ^ d * ε ^ d)) := by fun_prop
    have htend := hcont.tendsto 0
    have hval : (1 + η) * (4 * (I + C.card * 0) / ((d : ℝ) - 2) + A * B * 2 ^ d * 0 ^ (d - 2))
          + (1 + 1 / η) * (2 * (0 * L) ^ 2 + 2 * M₁ ^ 2 * (B * 2 ^ d * 0 ^ d))
        = (1 + η) * (4 * I / ((d : ℝ) - 2)) := by
      rw [zero_pow (by omega), zero_pow (by omega)]; ring
    rw [hval] at htend
    refine ge_of_tendsto (tendsto_nhdsWithin_of_tendsto_nhds (s := Set.Ioi 0) htend) ?_
    filter_upwards [Ioc_mem_nhdsGT (zero_lt_one' ℝ)] with ε hε
    exact hbound η hη ε hε.1 hε.2
  -- let `η → 0⁺`
  rw [show (4 : ℝ) / ((d : ℝ) - 2) * I = 4 * I / ((d : ℝ) - 2) by ring]
  have hcont2 : Continuous fun η : ℝ => (1 + η) * (4 * I / ((d : ℝ) - 2)) := by fun_prop
  have htend2 := hcont2.tendsto 0
  simp only [add_zero, one_mul] at htend2
  refine ge_of_tendsto (tendsto_nhdsWithin_of_tendsto_nhds (s := Set.Ioi 0) htend2) ?_
  filter_upwards [self_mem_nhdsWithin] with η hη
  exact hlim η hη

/-- **The sharp variance bound for a finite codebook on the sphere**:
`Var_σ ‖u − q u‖² ≤ 4 ρ²/(d − 2)`. -/
theorem variance_stageErr_le_finite_sharp (hd : 3 ≤ Module.finrank ℝ E) {q : E → E} (C : Finset E)
    (hC : C.Nonempty) (hq : IsNearest (C : Set E) q) (hmeas : Measurable q) :
    variance (fun u => ‖u - q u‖ ^ 2) (sphereUniformAmbient E)
      ≤ 4 / ((Module.finrank ℝ E : ℝ) - 2) * stageDistortion q (sphereUniformAmbient E) := by
  have hF : Measurable fun x : E => ‖x - q x‖ ^ 2 := (measurable_id.sub hmeas).norm.pow_const 2
  have hcomp : (fun x : E => ‖x - q x‖ ^ 2) ∘ dir = fC C hC := by
    funext z; simp only [Function.comp]; rw [fC_eq_of_isNearest C hC hq]
  have hint : ∫ x, ‖dir x - q (dir x)‖ ^ 2 ∂(gaussianE E) = ∫ x, fC C hC x ∂(gaussianE E) :=
    integral_congr_ae (Filter.Eventually.of_forall fun z => (fC_eq_of_isNearest C hC hq z).symm)
  rw [← gaussianE_map_dir, variance_map (by rw [gaussianE_map_dir]; exact hF.aemeasurable)
    measurable_dir.aemeasurable, hcomp, stageDistortion, integral_map measurable_dir.aemeasurable
    (by rw [gaussianE_map_dir]; exact hF.aestronglyMeasurable), hint]
  exact variance_fC_le_sharp hd C hC

end SharpAssembly

section StreamFiniteSharp

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E] [FiniteDimensional ℝ E]
variable {G : Type*} [Group G] [MeasurableSpace G] [MulAction G E] [MeasurableSMul₂ G E]
  [MeasurableInv G] [MeasurableMul G]
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
variable {ι : G → (E ≃ₗᵢ[ℝ] E)} {q : E → E} {W : Ω → E} {R : Ω → ℕ → G} {κ : Measure G}
  [κ.IsMulRightInvariant] {x₀ : E}

theorem variance_stageErrSq_le_finite_sharp (hd : 3 ≤ Module.finrank ℝ E)
    (h : RotationStream ι q W R κ x₀ μ) (hx₀ : ‖x₀‖ = 1) (C : Finset E) (hC : C.Nonempty)
    (hq : IsNearest (C : Set E) q) (p : ℕ) :
    variance (fun ω => stageErrSq (rotScheme ι q (R ω)) (W ω) p) μ
      ≤ 4 / ((Module.finrank ℝ E : ℝ) - 2) * stageDistortion q (sphereUniformAmbient E) := by
  haveI : Nontrivial E := ⟨⟨x₀, 0, by rintro rfl; simp at hx₀⟩⟩
  have hmp := measurePreserving_unitVec_stream h hx₀ p
  have hF : Measurable fun x : E => ‖x - q x‖ ^ 2 := (measurable_id.sub h.meas_q).norm.pow_const 2
  have heq : (fun ω => stageErrSq (rotScheme ι q (R ω)) (W ω) p)
      = (fun x : E => ‖x - q x‖ ^ 2) ∘ (fun ω => unitVec (rotScheme ι q (R ω)) (W ω) p) := rfl
  rw [heq, ← variance_map (by rw [hmp.map_eq]; exact hF.aemeasurable) hmp.measurable.aemeasurable,
    hmp.map_eq]
  exact variance_stageErr_le_finite_sharp hd C hC hq h.meas_q

/-- **Concentration of the decay law for a finite codebook, with the sharp constant.**
The `P`-pass squared error lies within the compounded band `(1 ± ε)^P ρ^{2P}‖w‖²` except on an
event of probability at most `4P/((d − 2) ε² ρ²)`. -/
theorem meas_not_decayWithin_le_finite_sharp (hd : 3 ≤ Module.finrank ℝ E)
    (h : RotationStream ι q W R κ x₀ μ) (hx₀ : ‖x₀‖ = 1) (C : Finset E) (hC : C.Nonempty)
    (hq : IsNearest (C : Set E) q) {ε : ℝ} (hε0 : 0 < ε) (hε1 : ε ≤ 1)
    (hρ : 0 < stageDistortion q (sphereUniformAmbient E)) (P : ℕ) :
    μ {ω | ¬ DecayWithin (rotScheme ι q (R ω)) (W ω)
        (Real.sqrt (stageDistortion q (sphereUniformAmbient E))) ε P}
      ≤ P * ENNReal.ofReal (4 / (((Module.finrank ℝ E : ℝ) - 2) * ε ^ 2 *
          stageDistortion q (sphereUniformAmbient E))) := by
  haveI : Nontrivial E := ⟨⟨x₀, 0, by rintro rfl; simp at hx₀⟩⟩
  have hCb : Bornology.IsBounded (C : Set E) := C.finite_toSet.isBounded
  set D := stageDistortion q (sphereUniformAmbient E) with hD
  have hρ2 : Real.sqrt D ^ 2 = D := Real.sq_sqrt hρ.le
  have hmem : ∀ p < P, MemLp (fun ω => stageErrSq (rotScheme ι q (R ω)) (W ω) p) 2 μ := fun p _ =>
    (memLp_stageErr_of_bounded hq hCb h.meas_q).comp_measurePreserving
      (measurePreserving_unitVec_stream h hx₀ p)
  have hmean : ∀ p < P, ∫ ω, stageErrSq (rotScheme ι q (R ω)) (W ω) p ∂μ = Real.sqrt D ^ 2 := by
    intro p _
    rw [hρ2, hD, ← h.orbitLaw_eq hx₀]
    exact integral_stageErr_eq_stageDistortion h p
  have hvar : ∀ p < P, variance (fun ω => stageErrSq (rotScheme ι q (R ω)) (W ω) p) μ
      ≤ 4 / ((Module.finrank ℝ E : ℝ) - 2) * D := fun p _ =>
    variance_stageErrSq_le_finite_sharp hd h hx₀ C hC hq p
  have hρne : Real.sqrt D ≠ 0 := (Real.sqrt_pos.mpr hρ).ne'
  have key := meas_not_decayWithin_le_of_variance hε0 hε1 hρne hmem hmean hvar
  have hD0 : D ≠ 0 := hρ.ne'
  have hε : ε ≠ 0 := hε0.ne'
  have hd' : ((Module.finrank ℝ E : ℝ) - 2) ≠ 0 := by
    have : (3 : ℝ) ≤ Module.finrank ℝ E := by exact_mod_cast hd
    linarith
  have hconst : 4 / ((Module.finrank ℝ E : ℝ) - 2) * D / (ε * Real.sqrt D ^ 2) ^ 2
      = 4 / (((Module.finrank ℝ E : ℝ) - 2) * ε ^ 2 * D) := by
    rw [hρ2]; field_simp
  rw [← hconst]; exact key

end StreamFiniteSharp
/-! ## §35  Bounded codebooks: the Gaussian Poincaré hypothesis discharged

§34 proved the sharp variance bound for finite codebooks.  A bounded codebook `C`, finite or
not, contains a finite `η`-net `C₀` (`exists_finite_net`), and then
`dist(u, C) ≤ dist(u, C₀) ≤ dist(u, C) + η`, so the squared distances to `C` and to `C₀` are
uniformly close on the sphere.  The comparison `Var f ≤ (1 + κ) Var g + (1 + 1/κ) E(f − g)²`
of §34 and the bound for `C₀` give, as `η → 0` and then `κ → 0`,
`Var_γ dist(Z/‖Z‖, C)² ≤ 4/(d − 2) · E dist(Z/‖Z‖, C)²` (`variance_infDist_sq_le_bounded`),
hence `Var_σ ‖u − q u‖² ≤ 4ρ²/(d − 2)` for every nearest-codeword stage with a bounded codebook
(`variance_stageErr_le_bounded`), and `meas_not_decayWithin_le_bounded` is the concentration
remark at rate `4P/((d − 2) ε² ρ²)` for every bounded codebook, with no unproved hypothesis.
This supersedes `meas_not_decayWithin_le_gauss` (§26): the hypothesis `GaussPoincare` is no
longer needed for any statement of the paper.  It remains unproved in its general two-point
form, and §25 and §26 keep it only as a record of the route the development took. -/

section InfiniteCodebook

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

/-- `f_{C}` for a finite `C` is the squared distance from the direction to `C`. -/
theorem fC_eq_infDist (C : Finset E) (hC : C.Nonempty) (z : E) :
    fC C hC z = Metric.infDist (dir z) (C : Set E) ^ 2 := by
  obtain ⟨c₀, hc₀, hmin⟩ := Finset.exists_mem_eq_inf' hC (fun c => hc c z)
  have hfC : fC C hC z = hc c₀ z := hmin
  rw [hfC]
  unfold hc
  congr 1
  refine le_antisymm ?_ ?_
  · rw [Metric.infDist_eq_iInf]
    haveI : Nonempty (C : Set E) := ⟨⟨c₀, hc₀⟩⟩
    refine le_ciInf fun c => ?_
    rw [dist_eq_norm]
    have h : hc c₀ z ≤ hc (c : E) z := by
      rw [← hfC]; exact Finset.inf'_le _ (Finset.mem_coe.mp c.2)
    exact (pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).mp h
  · have := Metric.infDist_le_dist_of_mem (x := dir z) (Finset.mem_coe.mpr hc₀ : c₀ ∈ (C : Set E))
    rwa [dist_eq_norm] at this

theorem variance_infDist_sq_le_finite (hd : 3 ≤ Module.finrank ℝ E) (C : Finset E)
    (hC : C.Nonempty) :
    variance (fun z => Metric.infDist (dir z) (C : Set E) ^ 2) (gaussianE E)
      ≤ 4 / ((Module.finrank ℝ E : ℝ) - 2) *
          ∫ z, Metric.infDist (dir z) (C : Set E) ^ 2 ∂(gaussianE E) := by
  have e : (fun z => Metric.infDist (dir z) (C : Set E) ^ 2) = fC C hC :=
    funext fun z => (fC_eq_infDist C hC z).symm
  rw [e]; exact variance_fC_le_sharp hd C hC

/-- **A finite `η`-net inside a bounded set**, with the distance functions `η`-close. -/
theorem exists_finite_net {C : Set E} (hC : Bornology.IsBounded C) (hne : C.Nonempty) {η : ℝ}
    (hη : 0 < η) :
    ∃ C₀ : Finset E, C₀.Nonempty ∧ (C₀ : Set E) ⊆ C ∧
      ∀ x, Metric.infDist x (C₀ : Set E) ≤ Metric.infDist x C + η := by
  have htb : TotallyBounded C :=
    hC.isCompact_closure.totallyBounded.subset subset_closure
  obtain ⟨t, htC, htfin, hcov⟩ := htb.exists_subset (Metric.dist_mem_uniformity hη)
  refine ⟨htfin.toFinset, ?_, by simpa using htC, fun x => ?_⟩
  · obtain ⟨c, hc⟩ := hne
    have := hcov hc
    simp only [Set.mem_iUnion, Set.mem_setOf_eq] at this
    obtain ⟨y, hy, -⟩ := this
    exact ⟨y, htfin.mem_toFinset.mpr hy⟩
  · rw [Metric.infDist_eq_iInf (s := C)]
    haveI : Nonempty C := ⟨⟨_, hne.some_mem⟩⟩
    rw [← _root_.sub_le_iff_le_add]
    refine le_ciInf fun c => ?_
    have := hcov c.2
    simp only [Set.mem_iUnion, Set.mem_setOf_eq] at this
    obtain ⟨y, hy, hdy⟩ := this
    have h1 : Metric.infDist x (htfin.toFinset : Set E) ≤ dist x y :=
      Metric.infDist_le_dist_of_mem (by simpa using hy)
    have h2 : dist x y ≤ dist x c + dist (c : E) y := dist_triangle _ _ _
    linarith

theorem measurable_infDist_dir (C : Set E) : Measurable fun z : E => Metric.infDist (dir z) C :=
  (Metric.continuous_infDist_pt C).measurable.comp measurable_dir

theorem infDist_dir_le {C : Set E} {R : ℝ} (hR : ∀ c ∈ C, ‖c‖ ≤ R) {c₀ : E} (hc₀ : c₀ ∈ C) (z : E) :
    Metric.infDist (dir z) C ≤ 1 + R := by
  calc Metric.infDist (dir z) C ≤ dist (dir z) c₀ := Metric.infDist_le_dist_of_mem hc₀
    _ ≤ ‖dir z‖ + ‖c₀‖ := by rw [dist_eq_norm]; exact norm_sub_le _ _
    _ ≤ 1 + R := add_le_add (norm_dir_le_one z) (hR c₀ hc₀)

/-- **The sharp variance bound for a bounded codebook**, by finite nets:
`Var_γ dist(Z/‖Z‖, C)² ≤ 4/(d − 2) · E dist(Z/‖Z‖, C)²`. -/
theorem variance_infDist_sq_le_bounded (hd : 3 ≤ Module.finrank ℝ E) {C : Set E}
    (hC : Bornology.IsBounded C) (hne : C.Nonempty) :
    variance (fun z => Metric.infDist (dir z) C ^ 2) (gaussianE E)
      ≤ 4 / ((Module.finrank ℝ E : ℝ) - 2) *
          ∫ z, Metric.infDist (dir z) C ^ 2 ∂(gaussianE E) := by
  obtain ⟨R₀, hR₀⟩ := hC.exists_norm_le
  set R := max R₀ 0 with hRdef
  have hR : ∀ c ∈ C, ‖c‖ ≤ R := fun c hc => (hR₀ c hc).trans (le_max_left _ _)
  have hR0 : 0 ≤ R := le_max_right _ _
  have hd' : (0 : ℝ) < (Module.finrank ℝ E : ℝ) - 2 := by
    have : (3 : ℝ) ≤ Module.finrank ℝ E := by exact_mod_cast hd
    linarith
  set d := Module.finrank ℝ E with hd_def
  set f : E → ℝ := fun z => Metric.infDist (dir z) C ^ 2 with hf
  set I := ∫ z, f z ∂(gaussianE E) with hI
  have hfm : Measurable f := (measurable_infDist_dir C).pow_const 2
  have hfb : ∀ z, |f z| ≤ (1 + R) ^ 2 := fun z => by
    rw [hf, abs_of_nonneg (sq_nonneg _)]
    exact pow_le_pow_left₀ Metric.infDist_nonneg (infDist_dir_le hR hne.some_mem z) 2
  -- the bound with a net at scale `η ∈ (0, 1]` and comparison parameter `κ > 0`
  have hbound : ∀ κ : ℝ, 0 < κ → ∀ η : ℝ, 0 < η → η ≤ 1 →
      variance f (gaussianE E)
        ≤ (1 + κ) * (4 / ((d : ℝ) - 2) * (I + η * (2 * R + 3)))
          + (1 + 1 / κ) * (η * (2 * R + 3)) ^ 2 := by
    intro κ hκ η hη hη1
    obtain ⟨C₀, hC₀, hsub, hnet⟩ := exists_finite_net hC hne hη
    set f₀ : E → ℝ := fun z => Metric.infDist (dir z) (C₀ : Set E) ^ 2 with hf₀
    have hf₀m : Measurable f₀ := (measurable_infDist_dir _).pow_const 2
    have hR' : ∀ c ∈ (C₀ : Set E), ‖c‖ ≤ R := fun c hc => hR c (hsub hc)
    obtain ⟨c₀, hc₀⟩ := hC₀
    have hf₀b : ∀ z, |f₀ z| ≤ (1 + R) ^ 2 := fun z => by
      rw [hf₀, abs_of_nonneg (sq_nonneg _)]
      exact pow_le_pow_left₀ Metric.infDist_nonneg
        (infDist_dir_le hR' (Finset.mem_coe.mpr hc₀) z) 2
    -- pointwise closeness
    have hclose : ∀ z, |f z - f₀ z| ≤ η * (2 * R + 3) := fun z => by
      have ha := Metric.infDist_nonneg (x := dir z) (s := C)
      have hab : Metric.infDist (dir z) C ≤ Metric.infDist (dir z) (C₀ : Set E) :=
        Metric.infDist_le_infDist_of_subset hsub ⟨c₀, Finset.mem_coe.mpr hc₀⟩
      have hba := hnet (dir z)
      have hbnd := infDist_dir_le hR' (Finset.mem_coe.mpr hc₀) z
      rw [hf, hf₀]
      simp only
      rw [abs_le]
      constructor <;> nlinarith
    have hmean : ∫ z, f₀ z ∂(gaussianE E) ≤ I + η * (2 * R + 3) := by
      have hfi : Integrable f (gaussianE E) := integrable_of_bound_gauss hfm.aestronglyMeasurable _ hfb
      have hf₀i : Integrable f₀ (gaussianE E) :=
        integrable_of_bound_gauss hf₀m.aestronglyMeasurable _ hf₀b
      have : ∫ z, f₀ z ∂(gaussianE E) ≤ ∫ z, (f z + η * (2 * R + 3)) ∂(gaussianE E) :=
        integral_mono hf₀i (hfi.add (integrable_const _)) fun z => by
          have := (abs_le.mp (hclose z)).1; linarith
      rwa [integral_add hfi (integrable_const _), integral_const, measureReal_def, measure_univ,
        ENNReal.toReal_one, one_smul] at this
    have hvar₀ := variance_infDist_sq_le_finite hd C₀ ⟨c₀, hc₀⟩
    have hsq : ∫ z, (f z - f₀ z) ^ 2 ∂(gaussianE E) ≤ (η * (2 * R + 3)) ^ 2 := by
      have hi : Integrable (fun z => (f z - f₀ z) ^ 2) (gaussianE E) :=
        integrable_of_bound_gauss ((hfm.sub hf₀m).pow_const 2).aestronglyMeasurable
          ((η * (2 * R + 3)) ^ 2) fun z => by
            rw [abs_of_nonneg (sq_nonneg _), ← sq_abs]
            exact pow_le_pow_left₀ (abs_nonneg _) (hclose z) 2
      have := integral_mono hi (integrable_const _) fun z => by
        show (f z - f₀ z) ^ 2 ≤ (η * (2 * R + 3)) ^ 2
        rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) (hclose z) 2
      rwa [integral_const, measureReal_def, measure_univ, ENNReal.toReal_one, one_smul] at this
    have h3 := variance_le_of_close (μ := gaussianE E) hfm hf₀m hfb hf₀b hκ
    have hvar₀' : variance f₀ (gaussianE E) ≤ 4 / ((d : ℝ) - 2) * (I + η * (2 * R + 3)) :=
      hvar₀.trans (mul_le_mul_of_nonneg_left hmean (by positivity))
    calc variance f (gaussianE E) ≤ _ := h3
      _ ≤ _ := add_le_add (mul_le_mul_of_nonneg_left hvar₀' (by linarith))
          (mul_le_mul_of_nonneg_left hsq (by positivity))
  -- `η → 0⁺`
  have hlim : ∀ κ : ℝ, 0 < κ → variance f (gaussianE E) ≤ (1 + κ) * (4 / ((d : ℝ) - 2) * I) := by
    intro κ hκ
    have hcont : Continuous fun η : ℝ => (1 + κ) * (4 / ((d : ℝ) - 2) * (I + η * (2 * R + 3)))
        + (1 + 1 / κ) * (η * (2 * R + 3)) ^ 2 := by fun_prop
    have htend := hcont.tendsto 0
    simp only [zero_mul, add_zero, zero_pow two_ne_zero, mul_zero] at htend
    refine ge_of_tendsto (tendsto_nhdsWithin_of_tendsto_nhds (s := Set.Ioi 0) htend) ?_
    filter_upwards [Ioc_mem_nhdsGT (zero_lt_one' ℝ)] with η hη
    exact hbound κ hκ η hη.1 hη.2
  -- `κ → 0⁺`
  have hcont2 : Continuous fun κ : ℝ => (1 + κ) * (4 / ((d : ℝ) - 2) * I) := by fun_prop
  have htend2 := hcont2.tendsto 0
  simp only [add_zero, one_mul] at htend2
  refine ge_of_tendsto (tendsto_nhdsWithin_of_tendsto_nhds (s := Set.Ioi 0) htend2) ?_
  filter_upwards [self_mem_nhdsWithin] with κ hκ
  exact hlim κ hκ

/-- **The sharp variance bound on the sphere for any bounded codebook.** -/
theorem variance_stageErr_le_bounded (hd : 3 ≤ Module.finrank ℝ E) {q : E → E} {C : Set E}
    (hC : Bornology.IsBounded C) (hq : IsNearest C q) (hmeas : Measurable q) :
    variance (fun u => ‖u - q u‖ ^ 2) (sphereUniformAmbient E)
      ≤ 4 / ((Module.finrank ℝ E : ℝ) - 2) * stageDistortion q (sphereUniformAmbient E) := by
  have hne : C.Nonempty := ⟨q 0, (hq 0).1⟩
  have hF : Measurable fun x : E => ‖x - q x‖ ^ 2 := (measurable_id.sub hmeas).norm.pow_const 2
  have hcomp : (fun x : E => ‖x - q x‖ ^ 2) ∘ dir = fun z => Metric.infDist (dir z) C ^ 2 := by
    funext z
    show ‖dir z - q (dir z)‖ ^ 2 = Metric.infDist (dir z) C ^ 2
    rw [norm_sub_eq_infDist hq]
  have hint : ∫ x, ‖dir x - q (dir x)‖ ^ 2 ∂(gaussianE E)
      = ∫ z, Metric.infDist (dir z) C ^ 2 ∂(gaussianE E) :=
    integral_congr_ae (Filter.Eventually.of_forall fun z => by
      show ‖dir z - q (dir z)‖ ^ 2 = Metric.infDist (dir z) C ^ 2
      rw [norm_sub_eq_infDist hq])
  rw [← gaussianE_map_dir, variance_map (by rw [gaussianE_map_dir]; exact hF.aemeasurable)
    measurable_dir.aemeasurable, hcomp, stageDistortion, integral_map measurable_dir.aemeasurable
    (by rw [gaussianE_map_dir]; exact hF.aestronglyMeasurable), hint]
  exact variance_infDist_sq_le_bounded hd hC hne

end InfiniteCodebook

section StreamBounded

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E] [FiniteDimensional ℝ E]
variable {G : Type*} [Group G] [MeasurableSpace G] [MulAction G E] [MeasurableSMul₂ G E]
  [MeasurableInv G] [MeasurableMul G]
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
variable {ι : G → (E ≃ₗᵢ[ℝ] E)} {q : E → E} {W : Ω → E} {R : Ω → ℕ → G} {κ : Measure G}
  [κ.IsMulRightInvariant] {x₀ : E}

theorem variance_stageErrSq_le_bounded (hd : 3 ≤ Module.finrank ℝ E)
    (h : RotationStream ι q W R κ x₀ μ) (hx₀ : ‖x₀‖ = 1) {C : Set E} (hC : Bornology.IsBounded C)
    (hq : IsNearest C q) (p : ℕ) :
    variance (fun ω => stageErrSq (rotScheme ι q (R ω)) (W ω) p) μ
      ≤ 4 / ((Module.finrank ℝ E : ℝ) - 2) * stageDistortion q (sphereUniformAmbient E) := by
  haveI : Nontrivial E := ⟨⟨x₀, 0, by rintro rfl; simp at hx₀⟩⟩
  have hmp := measurePreserving_unitVec_stream h hx₀ p
  have hF : Measurable fun x : E => ‖x - q x‖ ^ 2 := (measurable_id.sub h.meas_q).norm.pow_const 2
  have heq : (fun ω => stageErrSq (rotScheme ι q (R ω)) (W ω) p)
      = (fun x : E => ‖x - q x‖ ^ 2) ∘ (fun ω => unitVec (rotScheme ι q (R ω)) (W ω) p) := rfl
  rw [heq, ← variance_map (by rw [hmp.map_eq]; exact hF.aemeasurable) hmp.measurable.aemeasurable,
    hmp.map_eq]
  exact variance_stageErr_le_bounded hd hC hq h.meas_q

/-- **Concentration of the decay law for any bounded codebook, with the sharp constant and no
unproved hypothesis.**  This is `meas_not_decayWithin_le_gauss` with the Gaussian Poincaré
hypothesis discharged, at the better rate `4P/((d − 2) ε² ρ²)`. -/
theorem meas_not_decayWithin_le_bounded (hd : 3 ≤ Module.finrank ℝ E)
    (h : RotationStream ι q W R κ x₀ μ) (hx₀ : ‖x₀‖ = 1) {C : Set E} (hC : Bornology.IsBounded C)
    (hq : IsNearest C q) {ε : ℝ} (hε0 : 0 < ε) (hε1 : ε ≤ 1)
    (hρ : 0 < stageDistortion q (sphereUniformAmbient E)) (P : ℕ) :
    μ {ω | ¬ DecayWithin (rotScheme ι q (R ω)) (W ω)
        (Real.sqrt (stageDistortion q (sphereUniformAmbient E))) ε P}
      ≤ P * ENNReal.ofReal (4 / (((Module.finrank ℝ E : ℝ) - 2) * ε ^ 2 *
          stageDistortion q (sphereUniformAmbient E))) := by
  haveI : Nontrivial E := ⟨⟨x₀, 0, by rintro rfl; simp at hx₀⟩⟩
  set D := stageDistortion q (sphereUniformAmbient E) with hD
  have hρ2 : Real.sqrt D ^ 2 = D := Real.sq_sqrt hρ.le
  have hmem : ∀ p < P, MemLp (fun ω => stageErrSq (rotScheme ι q (R ω)) (W ω) p) 2 μ := fun p _ =>
    (memLp_stageErr_of_bounded hq hC h.meas_q).comp_measurePreserving
      (measurePreserving_unitVec_stream h hx₀ p)
  have hmean : ∀ p < P, ∫ ω, stageErrSq (rotScheme ι q (R ω)) (W ω) p ∂μ = Real.sqrt D ^ 2 := by
    intro p _
    rw [hρ2, hD, ← h.orbitLaw_eq hx₀]
    exact integral_stageErr_eq_stageDistortion h p
  have hvar : ∀ p < P, variance (fun ω => stageErrSq (rotScheme ι q (R ω)) (W ω) p) μ
      ≤ 4 / ((Module.finrank ℝ E : ℝ) - 2) * D := fun p _ =>
    variance_stageErrSq_le_bounded hd h hx₀ hC hq p
  have hρne : Real.sqrt D ≠ 0 := (Real.sqrt_pos.mpr hρ).ne'
  have key := meas_not_decayWithin_le_of_variance hε0 hε1 hρne hmem hmean hvar
  have hD0 : D ≠ 0 := hρ.ne'
  have hε : ε ≠ 0 := hε0.ne'
  have hd' : ((Module.finrank ℝ E : ℝ) - 2) ≠ 0 := by
    have : (3 : ℝ) ≤ Module.finrank ℝ E := by exact_mod_cast hd
    linarith
  have hconst : 4 / ((Module.finrank ℝ E : ℝ) - 2) * D / (ε * Real.sqrt D ^ 2) ^ 2
      = 4 / (((Module.finrank ℝ E : ℝ) - 2) * ε ^ 2 * D) := by
    rw [hρ2]; field_simp
  rw [← hconst]; exact key

end StreamBounded
/-! ## §36  The deployed rotation: what Proposition 2 becomes under `H D_ε`

The paper deploys `R = H D_ε`, a fixed flat orthogonal matrix (every entry `±1/√d`, the
Walsh–Hadamard matrix in practice, constructed in §38) times a uniformly random diagonal sign matrix, with fresh
signs at every pass.  This is a finite family inside `O(d)`, Theorem 1 is false for it, and
nothing here certifies the paper's empirical defence.  This section proves what is true.

Rademacher moments are finite sums: `E(∑ aⱼεⱼ)² = ∑ aⱼ²` and
`E(∑ aⱼεⱼ)⁴ = 3(∑ aⱼ²)² − 2∑ aⱼ⁴` (`sum_radSum_sq`, `sum_radSum_pow_four`), so every
coordinate of `H D_ε x` has second moment `‖x‖²/d`, the value of `f_d`, and fourth moment
`(3‖x‖⁴ − 2∑ xⱼ⁴)/d²` (`signAvg_coord_sq`, `signAvg_coord_pow_four`); against the sphere's
`3/(d(d+2))`, proved in §37, the gap is governed by the spikiness `∑ xⱼ⁴` of the input
direction.  In the stream with fresh uniform sign patterns, freezing the fresh pattern
gives the exact per-pass identity `E‖r_{p+1}‖² = E[‖r_p‖² · ρ_H²(r̂_p)]`
(`integral_norm_resid_sq_succ_had`) with `ρ_H²(v)` the sign-averaged pass distortion of the
direction `v` (`hadRate`), hence geometric decay with a rate sandwiched between the extreme
values of `ρ_H²` on the sphere (`integral_norm_resid_sq_le_had`, `le_integral_norm_resid_sq_had`).
For a coordinatewise codebook `ρ_H²` is the quadrature of the scalar distortion against the
Hadamard coordinate laws (`hadRate_blockStage`).  All of it lives in the same scheme model as
§1 and §12; only the law of the rotation differs. -/

namespace Hadamard

open Orthogonal


/-! ### Sign vectors and Rademacher moments -/

/-- A sign pattern: one bit per coordinate. -/
abbrev Signs (d : ℕ) := Fin d → Bool

/-- `±1` from a bit. -/
def sgn (b : Bool) : ℝ := if b then 1 else -1

theorem sgn_true : sgn true = 1 := rfl

theorem sgn_false : sgn false = -1 := rfl

theorem sgn_mul_self (b : Bool) : sgn b * sgn b = 1 := by cases b <;> simp [sgn]

theorem sgn_sq (b : Bool) : sgn b ^ 2 = 1 := by rw [sq, sgn_mul_self]

theorem card_signs (d : ℕ) : Fintype.card (Signs d) = 2 ^ d := by
  simp [Fintype.card_fun]

/-- The average over the `2^d` sign patterns. -/
noncomputable def signAvg {d : ℕ} (f : Signs d → ℝ) : ℝ := (∑ s, f s) / 2 ^ d

theorem signAvg_add {d : ℕ} (f g : Signs d → ℝ) :
    signAvg (fun s => f s + g s) = signAvg f + signAvg g := by
  unfold signAvg; rw [Finset.sum_add_distrib, add_div]

theorem signAvg_const_mul {d : ℕ} (c : ℝ) (f : Signs d → ℝ) :
    signAvg (fun s => c * f s) = c * signAvg f := by
  unfold signAvg; rw [← Finset.mul_sum, mul_div_assoc]

theorem signAvg_sum {d : ℕ} {ι : Type*} (t : Finset ι) (f : ι → Signs d → ℝ) :
    signAvg (fun s => ∑ i ∈ t, f i s) = ∑ i ∈ t, signAvg (f i) := by
  unfold signAvg; rw [Finset.sum_comm, Finset.sum_div]

theorem signAvg_mono {d : ℕ} {f g : Signs d → ℝ} (h : ∀ s, f s ≤ g s) : signAvg f ≤ signAvg g :=
  div_le_div_of_nonneg_right (Finset.sum_le_sum fun s _ => h s) (by positivity)

theorem signAvg_const {d : ℕ} (c : ℝ) : signAvg (fun _ : Signs d => c) = c := by
  unfold signAvg
  rw [Finset.sum_const, Finset.card_univ, card_signs, nsmul_eq_mul]
  field_simp
  try (push_cast; ring)

/-- The Rademacher sum `∑ⱼ aⱼ εⱼ`. -/
def radSum {n : ℕ} (a : Fin n → ℝ) (s : Signs n) : ℝ := ∑ j, a j * sgn (s j)

theorem radSum_cons {n : ℕ} (a : Fin (n + 1) → ℝ) (b : Bool) (s : Signs n) :
    radSum a (Fin.cons b s) = a 0 * sgn b + radSum (Fin.tail a) s := by
  unfold radSum
  rw [Fin.sum_univ_succ]
  simp [Fin.tail]

/-- Splitting a sum over `Signs (n+1)` along the first bit. -/
theorem sum_signs_succ {n : ℕ} (F : Signs (n + 1) → ℝ) :
    ∑ s, F s = ∑ b : Bool, ∑ s : Signs n, F (Fin.cons b s) := by
  rw [← Fintype.sum_prod_type']
  exact (Fintype.sum_equiv (Fin.consEquiv fun _ => Bool) (fun p => F (Fin.cons p.1 p.2)) F
    fun p => rfl).symm

/-- `E (∑ aⱼ εⱼ)² = ∑ aⱼ²`, as a finite sum. -/
theorem sum_radSum_sq {n : ℕ} (a : Fin n → ℝ) :
    ∑ s : Signs n, radSum a s ^ 2 = 2 ^ n * ∑ j, a j ^ 2 := by
  induction n with
  | zero => simp [radSum]
  | succ n ih =>
      rw [sum_signs_succ, Fin.sum_univ_succ]
      simp only [radSum_cons]
      rw [Fintype.sum_bool]
      simp only [sgn_true, sgn_false]
      have : ∑ s : Signs n, ((a 0 * 1 + radSum (Fin.tail a) s) ^ 2
          + (a 0 * -1 + radSum (Fin.tail a) s) ^ 2)
          = ∑ s : Signs n, (2 * radSum (Fin.tail a) s ^ 2 + 2 * a 0 ^ 2) := by
        refine Finset.sum_congr rfl fun s _ => ?_; ring
      rw [← Finset.sum_add_distrib, this, Finset.sum_add_distrib, ← Finset.mul_sum, ih,
        Finset.sum_const, Finset.card_univ, card_signs, nsmul_eq_mul]
      simp only [Fin.tail]
      push_cast
      ring

/-- `E (∑ aⱼ εⱼ)⁴ = 3 (∑ aⱼ²)² − 2 ∑ aⱼ⁴`, as a finite sum. -/
theorem sum_radSum_pow_four {n : ℕ} (a : Fin n → ℝ) :
    ∑ s : Signs n, radSum a s ^ 4
      = 2 ^ n * (3 * (∑ j, a j ^ 2) ^ 2 - 2 * ∑ j, a j ^ 4) := by
  induction n with
  | zero => simp [radSum]
  | succ n ih =>
      rw [sum_signs_succ, Fin.sum_univ_succ, Fin.sum_univ_succ]
      simp only [radSum_cons]
      rw [Fintype.sum_bool]
      simp only [sgn_true, sgn_false]
      have : ∑ s : Signs n, ((a 0 * 1 + radSum (Fin.tail a) s) ^ 4
          + (a 0 * -1 + radSum (Fin.tail a) s) ^ 4)
          = ∑ s : Signs n, (2 * radSum (Fin.tail a) s ^ 4
              + 12 * a 0 ^ 2 * radSum (Fin.tail a) s ^ 2 + 2 * a 0 ^ 4) := by
        refine Finset.sum_congr rfl fun s _ => ?_; ring
      rw [← Finset.sum_add_distrib, this, Finset.sum_add_distrib, Finset.sum_add_distrib,
        ← Finset.mul_sum, ← Finset.mul_sum, ih, sum_radSum_sq, Finset.sum_const, Finset.card_univ,
        card_signs, nsmul_eq_mul]
      simp only [Fin.tail]
      push_cast
      ring

/-! ### The randomised flat rotation `H D_ε` -/

variable {d : ℕ}

/-- `H` is flat: every entry has magnitude `1/√d`.  The Walsh–Hadamard matrix is the example. -/
def IsFlat (H : Od d) : Prop := ∀ i j, ((H : Matrix (Fin d) (Fin d) ℝ) i j) ^ 2 = 1 / d

/-- The diagonal sign matrix `D_ε`. -/
noncomputable def signMat (s : Signs d) : Matrix (Fin d) (Fin d) ℝ :=
  Matrix.diagonal fun j => sgn (s j)

theorem signMat_mem (s : Signs d) : signMat s ∈ Matrix.orthogonalGroup (Fin d) ℝ := by
  rw [Matrix.mem_orthogonalGroup_iff, signMat, Matrix.diagonal_transpose,
    Matrix.diagonal_mul_diagonal]
  rw [show (fun i => sgn (s i) * sgn (s i)) = fun _ => (1 : ℝ) from funext fun i => sgn_mul_self _,
    Matrix.diagonal_one]

/-- `D_ε` as an element of `O(d)`. -/
noncomputable def signRot (s : Signs d) : Od d := ⟨signMat s, signMat_mem s⟩

/-- The deployed rotation at sign pattern `ε`: `H D_ε`. -/
noncomputable def hadRot (H : Od d) (s : Signs d) : Od d := H * signRot s

theorem hadRot_apply (H : Od d) (s : Signs d) (x : Ed d) (i : Fin d) :
    (hadRot H s • x) i = ∑ j, (H : Matrix (Fin d) (Fin d) ℝ) i j * (sgn (s j) * x j) := by
  rw [smul_def, Matrix.toEuclideanLin_apply]
  change (Matrix.mulVec ((H : Matrix _ _ ℝ) * signMat s) (WithLp.ofLp x)) i = _
  rw [← Matrix.mulVec_mulVec]
  show ∑ j, (H : Matrix (Fin d) (Fin d) ℝ) i j * (Matrix.mulVec (signMat s) (WithLp.ofLp x)) j = _
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [signMat, Matrix.mulVec_diagonal]
  try rfl

theorem hadRot_apply_eq_radSum (H : Od d) (s : Signs d) (x : Ed d) (i : Fin d) :
    (hadRot H s • x) i = radSum (fun j => (H : Matrix (Fin d) (Fin d) ℝ) i j * x j) s := by
  rw [hadRot_apply, radSum]
  refine Finset.sum_congr rfl fun j _ => ?_; ring

theorem norm_sq_eq_sum_sq (x : Ed d) : ‖x‖ ^ 2 = ∑ j, x j ^ 2 := by
  rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg fun j _ => sq_nonneg _)]
  simp [Real.norm_eq_abs, sq_abs]

/-- **Second moment of a coordinate**: `E (H D_ε x)ᵢ² = ‖x‖²/d`, the value of `f_d`. -/
theorem signAvg_coord_sq {H : Od d} (hH : IsFlat H) (x : Ed d) (i : Fin d) :
    signAvg (fun s => (hadRot H s • x) i ^ 2) = ‖x‖ ^ 2 / d := by
  simp_rw [hadRot_apply_eq_radSum]
  unfold signAvg
  rw [sum_radSum_sq, norm_sq_eq_sum_sq]
  simp_rw [mul_pow, hH i]
  rw [← Finset.mul_sum]
  try field_simp

/-- **Fourth moment of a coordinate**: `E (H D_ε x)ᵢ⁴ = (3 ‖x‖⁴ − 2 ∑ⱼ xⱼ⁴)/d²`.  On the sphere
the fourth moment of `f_d` is `3/(d(d+2))` (§37), so the gap is governed by `∑ⱼ xⱼ⁴`, the
spikiness of the input direction: it vanishes at order `1/d³` for spread inputs and is of
order `1/d²` for a coordinate vector. -/
theorem signAvg_coord_pow_four {H : Od d} (hH : IsFlat H) (x : Ed d) (i : Fin d) :
    signAvg (fun s => (hadRot H s • x) i ^ 4)
      = (3 * ‖x‖ ^ 4 - 2 * ∑ j, x j ^ 4) / (d : ℝ) ^ 2 := by
  simp_rw [hadRot_apply_eq_radSum]
  unfold signAvg
  rw [sum_radSum_pow_four]
  have h2 : ∑ j, ((H : Matrix (Fin d) (Fin d) ℝ) i j * x j) ^ 2 = ‖x‖ ^ 2 / d := by
    rw [norm_sq_eq_sum_sq]; simp_rw [mul_pow, hH i]; rw [← Finset.mul_sum]; try ring
  have h4 : ∑ j, ((H : Matrix (Fin d) (Fin d) ℝ) i j * x j) ^ 4 = (∑ j, x j ^ 4) / (d : ℝ) ^ 2 := by
    have : ∀ j, ((H : Matrix (Fin d) (Fin d) ℝ) i j * x j) ^ 4
        = (1 / (d : ℝ)) ^ 2 * x j ^ 4 := fun j => by
      rw [mul_pow, show (4 : ℕ) = 2 * 2 from rfl, pow_mul, hH i]
      try ring
    simp_rw [this]; rw [← Finset.mul_sum]; try ring
  rw [h2, h4]
  rcases Nat.eq_zero_or_pos d with hd | hd
  · subst hd; simp
  · have : (d : ℝ) ≠ 0 := by exact_mod_cast hd.ne'
    field_simp
    try ring

/-! ### The Hadamard stream: what Proposition 2 becomes -/

/-- One pass with a fixed isometry `L`: `r ↦ r − ‖r‖ L⁻¹ q(L r/‖r‖)`. -/
noncomputable def hadStep (L : Ed d ≃ₗᵢ[ℝ] Ed d) (q : Ed d → Ed d) (r : Ed d) : Ed d :=
  r - ‖r‖ • L.symm (q (‖r‖⁻¹ • L r))

theorem measurable_hadStep (L : Ed d ≃ₗᵢ[ℝ] Ed d) {q : Ed d → Ed d} (hq : Measurable q) :
    Measurable (hadStep L q) := by
  unfold hadStep
  exact measurable_id.sub (measurable_norm.smul (L.symm.continuous.measurable.comp
    (hq.comp (measurable_norm.inv.smul (L.continuous.measurable.comp measurable_id)))))

/-- The Hadamard scheme: pass `p` rotates by `H D_{s p}`. -/
noncomputable def hadScheme (H : Od d) (q : Ed d → Ed d) (s : ℕ → Signs d) : Scheme (Ed d) where
  rot p := iso d (hadRot H (s p))
  q := q

/-- **The Hadamard pass distortion** of a direction `v`: the squared quantisation error of
`H D_ε v`, averaged over the sign pattern.  Under Haar this would be the constant `ρ²`; under
Hadamard it depends on `v`. -/
noncomputable def hadRate (H : Od d) (q : Ed d → Ed d) (v : Ed d) : ℝ :=
  signAvg fun s => ‖hadRot H s • v - q (hadRot H s • v)‖ ^ 2

/-- `r_p` as a function of the past `(w, s_0, …, s_{p−1})`. -/
noncomputable def hadPast (H : Od d) (q : Ed d → Ed d) : ∀ p : ℕ, Ed d × (Fin p → Signs d) → Ed d
  | 0, x => x.1
  | p + 1, x => hadStep (iso d (hadRot H (x.2 (Fin.last p)))) q
      (hadPast H q p (x.1, fun i => x.2 i.castSucc))

theorem resid_hadScheme_eq_hadPast (H : Od d) (q : Ed d → Ed d) (w : Ed d) (s : ℕ → Signs d)
    (p : ℕ) : resid (hadScheme H q s) w p = hadPast H q p (w, fun i : Fin p => s i) := by
  induction p with
  | zero => rfl
  | succ p ih =>
      have hcast : (fun i : Fin p => (fun j : Fin (p + 1) => s j) i.castSucc)
          = fun i : Fin p => s i := by funext i; simp
      rw [resid_succ, unitVec, ih, hadPast]
      simp only [hcast, Fin.val_last]
      rfl

theorem measurable_hadPast_left (H : Od d) {q : Ed d → Ed d} (hq : Measurable q) :
    ∀ (p : ℕ) (t : Fin p → Signs d), Measurable fun w => hadPast H q p (w, t)
  | 0, _ => measurable_id
  | p + 1, t => by
      show Measurable fun w => hadStep (iso d (hadRot H (t (Fin.last p)))) q
        (hadPast H q p (w, fun i => t i.castSucc))
      exact (measurable_hadStep _ hq).comp (measurable_hadPast_left H hq p _)

theorem measurable_hadPast (H : Od d) {q : Ed d → Ed d} (hq : Measurable q) (p : ℕ) :
    Measurable (hadPast H q p) :=
  measurable_from_prod_countable_left (measurable_hadPast_left H hq p)

/-- The unit direction at pass `p` is the fresh rotation applied to `dir r_p`. -/
theorem unitVec_hadScheme (H : Od d) (q : Ed d → Ed d) (w : Ed d) (s : ℕ → Signs d) (p : ℕ) :
    unitVec (hadScheme H q s) w p = hadRot H (s p) • dir (resid (hadScheme H q s) w p) := by
  rw [unitVec, dir, show (hadScheme H q s).rot p = iso d (hadRot H (s p)) from rfl, iso_apply,
    ← smul_comm_real (G := Od d) (ι := iso d) (iso_apply d)]

theorem norm_resid_succ_sq_had (H : Od d) (q : Ed d → Ed d) (w : Ed d) (s : ℕ → Signs d)
    (p : ℕ) :
    ‖resid (hadScheme H q s) w (p + 1)‖ ^ 2
      = ‖resid (hadScheme H q s) w p‖ ^ 2 *
          ‖hadRot H (s p) • dir (resid (hadScheme H q s) w p)
            - q (hadRot H (s p) • dir (resid (hadScheme H q s) w p))‖ ^ 2 := by
  rw [norm_resid_succ_sq, unitVec_hadScheme]; rfl

/-- The quantisation error of a direction is bounded by `1 + R` for a codebook in `B(0, R)`. -/
theorem norm_sub_q_le {q : Ed d → Ed d} {C : Set (Ed d)} (hq : IsNearest C q) {R : ℝ}
    (hR : ∀ c ∈ C, ‖c‖ ≤ R) {v : Ed d} (hv : ‖v‖ ≤ 1) : ‖v - q v‖ ≤ 1 + R := by
  obtain ⟨hmem, -⟩ := hq v
  calc ‖v - q v‖ ≤ ‖v‖ + ‖q v‖ := norm_sub_le _ _
    _ ≤ 1 + R := add_le_add hv (hR _ hmem)

theorem hadRate_le {H : Od d} {q : Ed d → Ed d} {C : Set (Ed d)} (hq : IsNearest C q) {R : ℝ}
    (hR : ∀ c ∈ C, ‖c‖ ≤ R) (hR0 : 0 ≤ R) {v : Ed d} (hv : ‖v‖ ≤ 1) :
    hadRate H q v ≤ (1 + R) ^ 2 := by
  unfold hadRate
  calc signAvg (fun s => ‖hadRot H s • v - q (hadRot H s • v)‖ ^ 2)
      ≤ signAvg (fun _ : Signs d => (1 + R) ^ 2) := signAvg_mono fun s => by
        refine pow_le_pow_left₀ (norm_nonneg _) (norm_sub_q_le hq hR ?_) 2
        rw [norm_smul']; exact hv
    _ = (1 + R) ^ 2 := signAvg_const _

theorem hadRate_nonneg (H : Od d) (q : Ed d → Ed d) (v : Ed d) : 0 ≤ hadRate H q v :=
  div_nonneg (Finset.sum_nonneg fun s _ => sq_nonneg _) (by positivity)

section Stream

variable [NeZero d]
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
variable {H : Od d} {q : Ed d → Ed d} {W : Ω → Ed d} {s : Ω → ℕ → Signs d}

instance : Nontrivial (Ed d) :=
  ⟨⟨EuclideanSpace.single (0 : Fin d) (1 : ℝ), 0, by
    intro h
    have := congrArg (fun v : Ed d => v 0) h
    simp at this⟩⟩

theorem measurable_hadRot_smul (H : Od d) (t : Signs d) :
    Measurable fun v : Ed d => hadRot H t • v := by
  rw [show (fun v : Ed d => hadRot H t • v) = ⇑(iso d (hadRot H t)) from
    funext fun v => (iso_apply _ _ _).symm]
  exact (iso d _).continuous.measurable

/-- The past at pass `p`, as a random variable. -/
def hadY (W : Ω → Ed d) (s : Ω → ℕ → Signs d) (p : ℕ) (ω : Ω) : Ed d × (Fin p → Signs d) :=
  (W ω, fun i : Fin p => s ω i)

theorem measurable_hadY (hW : Measurable W) (hs : ∀ p, Measurable fun ω => s ω p) (p : ℕ) :
    Measurable (hadY W s p) :=
  hW.prodMk (measurable_pi_lambda _ fun i => hs i)

theorem resid_eq_hadPast_hadY (H : Od d) (q : Ed d → Ed d) (W : Ω → Ed d) (s : Ω → ℕ → Signs d)
    (p : ℕ) (ω : Ω) :
    resid (hadScheme H q (s ω)) (W ω) p = hadPast H q p (hadY W s p ω) :=
  resid_hadScheme_eq_hadPast H q (W ω) (s ω) p

theorem measurable_resid_sq_had (hq : Measurable q) (hW : Measurable W)
    (hs : ∀ p, Measurable fun ω => s ω p) (p : ℕ) :
    Measurable fun ω => ‖resid (hadScheme H q (s ω)) (W ω) p‖ ^ 2 := by
  simp_rw [resid_eq_hadPast_hadY]
  exact (((measurable_hadPast H hq p).comp (measurable_hadY hW hs p)).norm).pow_const 2

/-- Integrability of `‖r_p‖²` for a bounded codebook, from that of `‖w‖²`. -/
theorem integrable_resid_sq_had (hq : Measurable q) {C : Set (Ed d)} (hqC : IsNearest C q)
    {R : ℝ} (hR : ∀ c ∈ C, ‖c‖ ≤ R) (hW : Measurable W) (hs : ∀ p, Measurable fun ω => s ω p)
    (hW2 : Integrable (fun ω => ‖W ω‖ ^ 2) μ) :
    ∀ p, Integrable (fun ω => ‖resid (hadScheme H q (s ω)) (W ω) p‖ ^ 2) μ
  | 0 => hW2
  | p + 1 => by
      have ih := integrable_resid_sq_had hq hqC hR hW hs hW2 p
      have hm := measurable_resid_sq_had (H := H) hq hW hs (p + 1)
      refine (ih.const_mul ((1 + R) ^ 2)).mono' hm.aestronglyMeasurable
        (Filter.Eventually.of_forall fun ω => ?_)
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _), norm_resid_succ_sq_had]
      have hv : ‖hadRot H (s ω p) • dir (resid (hadScheme H q (s ω)) (W ω) p)‖ ≤ 1 := by
        rw [norm_smul']; exact norm_dir_le_one _
      calc _ ≤ ‖resid (hadScheme H q (s ω)) (W ω) p‖ ^ 2 * (1 + R) ^ 2 :=
            mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _)
              (norm_sub_q_le hqC hR hv) 2) (sq_nonneg _)
        _ = _ := mul_comm _ _

/-- **Proposition 2 for the Hadamard stream: the conditional form.**  With fresh, uniformly
random sign patterns, `E‖r_{p+1}‖² = E[‖r_p‖² · hadRate(r̂_p)]`.  This is the exact identity
that replaces `E‖r_{p+1}‖² = ρ² E‖r_p‖²`: the rate is the Hadamard pass distortion of the
current residual direction, not a constant. -/
theorem integral_norm_resid_sq_succ_had (hq : Measurable q) {C : Set (Ed d)}
    (hqC : IsNearest C q) {R : ℝ} (hR : ∀ c ∈ C, ‖c‖ ≤ R) (hW : Measurable W)
    (hs : ∀ p, Measurable fun ω => s ω p)
    (hlaw : ∀ p (t : Signs d), μ.real {ω | s ω p = t} = 1 / 2 ^ d)
    (hfresh : ∀ p, IndepFun (fun ω => s ω p) (hadY W s p) μ)
    (hW2 : Integrable (fun ω => ‖W ω‖ ^ 2) μ) (p : ℕ) :
    ∫ ω, ‖resid (hadScheme H q (s ω)) (W ω) (p + 1)‖ ^ 2 ∂μ
      = ∫ ω, ‖resid (hadScheme H q (s ω)) (W ω) p‖ ^ 2 *
          hadRate H q (dir (resid (hadScheme H q (s ω)) (W ω) p)) ∂μ := by
  classical
  have hR0 : 0 ≤ R := by
    obtain ⟨hmem, -⟩ := hqC 0
    exact (norm_nonneg _).trans (hR _ hmem)
  -- the integrand as `G (s_p) (Y)`
  set G : Signs d → Ed d × (Fin p → Signs d) → ℝ := fun t y =>
    ‖hadPast H q p y‖ ^ 2 *
      ‖hadRot H t • dir (hadPast H q p y) - q (hadRot H t • dir (hadPast H q p y))‖ ^ 2 with hG
  have hGmeas : ∀ t, Measurable (G t) := fun t => by
    have h1 := measurable_hadPast H hq p
    have hd : Measurable (dir : Ed d → Ed d) := measurable_dir
    have hrot := measurable_hadRot_smul H t
    exact (h1.norm.pow_const 2).mul
      ((((hrot.comp (hd.comp h1)).sub (hq.comp (hrot.comp (hd.comp h1)))).norm).pow_const 2)
  have hGbound : ∀ t y, |G t y| ≤ (1 + R) ^ 2 * ‖hadPast H q p y‖ ^ 2 := fun t y => by
    rw [hG]; simp only
    rw [abs_of_nonneg (by positivity), mul_comm]
    refine mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (norm_nonneg _)
      (norm_sub_q_le hqC hR ?_) 2) (sq_nonneg _)
    rw [norm_smul']; exact norm_dir_le_one _
  have hrp : Integrable (fun ω => ‖hadPast H q p (hadY W s p ω)‖ ^ 2) μ := by
    have := integrable_resid_sq_had (H := H) hq hqC hR hW hs hW2 p
    simpa only [resid_eq_hadPast_hadY] using this
  have hGint : ∀ t, Integrable (fun ω => G t (hadY W s p ω)) μ := fun t =>
    (hrp.const_mul ((1 + R) ^ 2)).mono'
      ((hGmeas t).comp (measurable_hadY hW hs p)).aestronglyMeasurable
      (Filter.Eventually.of_forall fun ω => by
        rw [Real.norm_eq_abs]; exact hGbound t _)
  set φ : Signs d → Signs d → ℝ := fun t u => if u = t then 1 else 0 with hφ
  have hpt : ∀ ω, ‖resid (hadScheme H q (s ω)) (W ω) (p + 1)‖ ^ 2
      = ∑ t : Signs d, φ t (s ω p) * G t (hadY W s p ω) := by
    intro ω
    rw [norm_resid_succ_sq_had, resid_eq_hadPast_hadY]
    have : ∀ t : Signs d, φ t (s ω p) * G t (hadY W s p ω)
        = if s ω p = t then G t (hadY W s p ω) else 0 := fun t => by
      rw [hφ]; simp only
      by_cases h : s ω p = t
      · rw [if_pos h, one_mul, if_pos h]
      · rw [if_neg h, zero_mul, if_neg h]
    simp_rw [this]
    rw [Finset.sum_ite_eq]
    simp [hG]
  have hφmeas : ∀ t, Measurable fun ω => φ t (s ω p) := fun t =>
    (measurable_of_countable (φ t)).comp (hs p)
  have hφint : ∀ t, ∫ ω, φ t (s ω p) ∂μ = 1 / 2 ^ d := by
    intro t
    have hmeasset : MeasurableSet {ω | s ω p = t} := (hs p) (measurableSet_singleton t)
    have : (fun ω => φ t (s ω p)) = {ω | s ω p = t}.indicator (1 : Ω → ℝ) := by
      funext ω; rw [hφ]; simp only
      by_cases h : s ω p = t
      · rw [if_pos h, Set.indicator_of_mem (by exact h)]; rfl
      · rw [if_neg h, Set.indicator_of_notMem (by exact h)]
    rw [this, integral_indicator_one hmeasset, hlaw]
  have hφG : ∀ t, Integrable (fun ω => φ t (s ω p) * G t (hadY W s p ω)) μ := fun t => by
    have hm : Measurable fun ω => φ t (s ω p) * G t (hadY W s p ω) :=
      (hφmeas t).mul ((hGmeas t).comp (measurable_hadY hW hs p))
    refine (hGint t).mono' hm.aestronglyMeasurable (Filter.Eventually.of_forall fun ω => ?_)
    have hG0 : 0 ≤ G t (hadY W s p ω) := by rw [hG]; simp only; positivity
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hG0]
    refine mul_le_of_le_one_left hG0 ?_
    rw [hφ]; simp only
    split_ifs <;> simp
  simp_rw [hpt]
  rw [integral_finsetSum _ fun t _ => hφG t]
  have hterm : ∀ t : Signs d, ∫ ω, φ t (s ω p) * G t (hadY W s p ω) ∂μ
      = (1 / 2 ^ d) * ∫ ω, G t (hadY W s p ω) ∂μ := by
    intro t
    have hind : IndepFun (fun ω => φ t (s ω p)) (fun ω => G t (hadY W s p ω)) μ :=
      (hfresh p).comp (measurable_of_countable (φ t)) (hGmeas t)
    have hmul : ∫ ω, (fun ω => φ t (s ω p)) ω * (fun ω => G t (hadY W s p ω)) ω ∂μ
        = (∫ ω, φ t (s ω p) ∂μ) * ∫ ω, G t (hadY W s p ω) ∂μ :=
      hind.integral_mul_eq_mul_integral (hφmeas t).aestronglyMeasurable
        (hGint t).aestronglyMeasurable
    simp only at hmul
    rw [hmul, hφint]
  simp_rw [hterm]
  rw [← Finset.mul_sum, ← integral_finsetSum _ fun t _ => hGint t, ← integral_const_mul]
  refine integral_congr_ae (Filter.Eventually.of_forall fun ω => ?_)
  simp only [hG, hadRate, signAvg, resid_eq_hadPast_hadY]
  rw [Finset.sum_div, Finset.mul_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun t _ => ?_
  ring


theorem measurable_hadRate (H : Od d) {q : Ed d → Ed d} (hq : Measurable q) :
    Measurable (hadRate H q) := by
  unfold hadRate signAvg
  refine Measurable.div_const (Finset.measurable_sum _ fun t _ => ?_) _
  have hrot := measurable_hadRot_smul H t
  exact ((hrot.sub (hq.comp hrot)).norm).pow_const 2

theorem integrable_resid_sq_mul_hadRate (hq : Measurable q) {C : Set (Ed d)}
    (hqC : IsNearest C q) {R : ℝ} (hR : ∀ c ∈ C, ‖c‖ ≤ R) (hW : Measurable W)
    (hs : ∀ p, Measurable fun ω => s ω p) (hW2 : Integrable (fun ω => ‖W ω‖ ^ 2) μ) (p : ℕ) :
    Integrable (fun ω => ‖resid (hadScheme H q (s ω)) (W ω) p‖ ^ 2 *
      hadRate H q (dir (resid (hadScheme H q (s ω)) (W ω) p))) μ := by
  have hR0 : 0 ≤ R := by
    obtain ⟨hmem, -⟩ := hqC 0
    exact (norm_nonneg _).trans (hR _ hmem)
  have hm1 := measurable_resid_sq_had (H := H) hq hW hs p
  have hm2 : Measurable fun ω => hadRate H q (dir (resid (hadScheme H q (s ω)) (W ω) p)) := by
    simp_rw [resid_eq_hadPast_hadY]
    exact (measurable_hadRate H hq).comp (measurable_dir.comp
      ((measurable_hadPast H hq p).comp (measurable_hadY hW hs p)))
  refine ((integrable_resid_sq_had (H := H) hq hqC hR hW hs hW2 p).const_mul ((1 + R) ^ 2)).mono'
    (hm1.mul hm2).aestronglyMeasurable (Filter.Eventually.of_forall fun ω => ?_)
  rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (sq_nonneg _) (hadRate_nonneg _ _ _)), mul_comm]
  exact mul_le_mul_of_nonneg_right (hadRate_le hqC hR hR0 (norm_dir_le_one _)) (sq_nonneg _)

/-- **The sandwich.**  If the Hadamard pass distortion of every unit direction lies in
`[ρmin, ρmax]`, then `ρmin^P E‖w‖² ≤ E‖r_P‖² ≤ ρmax^P E‖w‖²`: geometric decay with an input-dependent
rate, which is what survives of Proposition 2 for the deployed rotation. -/
theorem integral_norm_resid_sq_le_had (hq : Measurable q) {C : Set (Ed d)}
    (hqC : IsNearest C q) {R : ℝ} (hR : ∀ c ∈ C, ‖c‖ ≤ R) (hW : Measurable W)
    (hs : ∀ p, Measurable fun ω => s ω p)
    (hlaw : ∀ p (t : Signs d), μ.real {ω | s ω p = t} = 1 / 2 ^ d)
    (hfresh : ∀ p, IndepFun (fun ω => s ω p) (hadY W s p) μ)
    (hW2 : Integrable (fun ω => ‖W ω‖ ^ 2) μ) {ρmax : ℝ} (hρ0 : 0 ≤ ρmax)
    (hρ : ∀ v : Ed d, ‖v‖ = 1 → hadRate H q v ≤ ρmax) :
    ∀ P, ∫ ω, ‖resid (hadScheme H q (s ω)) (W ω) P‖ ^ 2 ∂μ ≤ ρmax ^ P * ∫ ω, ‖W ω‖ ^ 2 ∂μ
  | 0 => by simp [resid]
  | P + 1 => by
      have ih := integral_norm_resid_sq_le_had hq hqC hR hW hs hlaw hfresh hW2 hρ0 hρ P
      rw [integral_norm_resid_sq_succ_had hq hqC hR hW hs hlaw hfresh hW2 P]
      have hpt : ∀ ω, ‖resid (hadScheme H q (s ω)) (W ω) P‖ ^ 2 *
          hadRate H q (dir (resid (hadScheme H q (s ω)) (W ω) P))
          ≤ ρmax * ‖resid (hadScheme H q (s ω)) (W ω) P‖ ^ 2 := fun ω => by
        rcases eq_or_ne (resid (hadScheme H q (s ω)) (W ω) P) 0 with h | h
        · rw [h]; simp
        · rw [mul_comm]
          exact mul_le_mul_of_nonneg_right (hρ _ (norm_dir_of_ne_zero h)) (sq_nonneg _)
      calc ∫ ω, ‖resid (hadScheme H q (s ω)) (W ω) P‖ ^ 2 *
            hadRate H q (dir (resid (hadScheme H q (s ω)) (W ω) P)) ∂μ
          ≤ ∫ ω, ρmax * ‖resid (hadScheme H q (s ω)) (W ω) P‖ ^ 2 ∂μ :=
            integral_mono (integrable_resid_sq_mul_hadRate hq hqC hR hW hs hW2 P)
              ((integrable_resid_sq_had hq hqC hR hW hs hW2 P).const_mul _) hpt
        _ = ρmax * ∫ ω, ‖resid (hadScheme H q (s ω)) (W ω) P‖ ^ 2 ∂μ := integral_const_mul _ _
        _ ≤ ρmax * (ρmax ^ P * ∫ ω, ‖W ω‖ ^ 2 ∂μ) := mul_le_mul_of_nonneg_left ih hρ0
        _ = ρmax ^ (P + 1) * ∫ ω, ‖W ω‖ ^ 2 ∂μ := by ring

theorem le_integral_norm_resid_sq_had (hq : Measurable q) {C : Set (Ed d)}
    (hqC : IsNearest C q) {R : ℝ} (hR : ∀ c ∈ C, ‖c‖ ≤ R) (hW : Measurable W)
    (hs : ∀ p, Measurable fun ω => s ω p)
    (hlaw : ∀ p (t : Signs d), μ.real {ω | s ω p = t} = 1 / 2 ^ d)
    (hfresh : ∀ p, IndepFun (fun ω => s ω p) (hadY W s p) μ)
    (hW2 : Integrable (fun ω => ‖W ω‖ ^ 2) μ) {ρmin : ℝ} (hρ0 : 0 ≤ ρmin)
    (hρ : ∀ v : Ed d, ‖v‖ = 1 → ρmin ≤ hadRate H q v) :
    ∀ P, ρmin ^ P * ∫ ω, ‖W ω‖ ^ 2 ∂μ ≤ ∫ ω, ‖resid (hadScheme H q (s ω)) (W ω) P‖ ^ 2 ∂μ
  | 0 => by simp [resid]
  | P + 1 => by
      have ih := le_integral_norm_resid_sq_had hq hqC hR hW hs hlaw hfresh hW2 hρ0 hρ P
      rw [integral_norm_resid_sq_succ_had hq hqC hR hW hs hlaw hfresh hW2 P]
      have hpt : ∀ ω, ρmin * ‖resid (hadScheme H q (s ω)) (W ω) P‖ ^ 2
          ≤ ‖resid (hadScheme H q (s ω)) (W ω) P‖ ^ 2 *
            hadRate H q (dir (resid (hadScheme H q (s ω)) (W ω) P)) := fun ω => by
        rcases eq_or_ne (resid (hadScheme H q (s ω)) (W ω) P) 0 with h | h
        · rw [h]; simp
        · rw [mul_comm]
          exact mul_le_mul_of_nonneg_left (hρ _ (norm_dir_of_ne_zero h)) (sq_nonneg _)
      calc ρmin ^ (P + 1) * ∫ ω, ‖W ω‖ ^ 2 ∂μ
          = ρmin * (ρmin ^ P * ∫ ω, ‖W ω‖ ^ 2 ∂μ) := by ring
        _ ≤ ρmin * ∫ ω, ‖resid (hadScheme H q (s ω)) (W ω) P‖ ^ 2 ∂μ :=
            mul_le_mul_of_nonneg_left ih hρ0
        _ = ∫ ω, ρmin * ‖resid (hadScheme H q (s ω)) (W ω) P‖ ^ 2 ∂μ := (integral_const_mul _ _).symm
        _ ≤ _ := integral_mono ((integrable_resid_sq_had hq hqC hR hW hs hW2 P).const_mul _)
            (integrable_resid_sq_mul_hadRate hq hqC hR hW hs hW2 P) hpt

end Stream

/-- **The coordinatewise codebook**: the Hadamard pass distortion is the quadrature of the
scalar distortion `(t − cb t)²` against the Hadamard coordinate laws, one per coordinate. -/
theorem hadRate_blockStage (H : Od d) (cb : ℝ → ℝ) (v : Ed d) :
    hadRate H (blockStage (m := d) (F := ℝ) cb) v
      = ∑ i, signAvg fun s => ((hadRot H s • v) i - cb ((hadRot H s • v) i)) ^ 2 := by
  unfold hadRate
  rw [← signAvg_sum]
  congr 1; funext s
  rw [norm_sq_eq_sum_sq]
  rfl

end Hadamard
/-! ## §37  The fourth moment of `f_d`, and the exact Hadamard gap

§5 computed the second moment of the coordinate law `f_d`; the same Beta integrals give the
fourth, `E_{f_d} t⁴ = 3/(d(d+2))` (`integral_pow_four_sphericalCoordLaw`), from
`t⁴(1 − t²)^a = (1 − t²)^a − 2(1 − t²)^{a+1} + (1 − t²)^{a+2}` and three Gamma recurrences.
With §36 this makes the fourth-moment comparison between the deployed rotation and the Haar
theory exact: for a unit direction `v`,
`E (H D_ε v)ᵢ⁴ − E_{f_d} t⁴ = (6/(d+2) − 2 ∑ⱼ vⱼ⁴)/d²` (`Hadamard.signAvg_coord_pow_four_sub_sphere`),
which lies between `−2/d²` and `4/d³` because `1/d ≤ ∑ⱼ vⱼ⁴ ≤ 1` on the sphere
(`Hadamard.abs_signAvg_coord_pow_four_sub_sphere`).  The quoted value of §36 is now a theorem. -/

variable {d : ℕ}

/-! ### The fourth moment of `f_d` -/

private theorem aux_J4 (a : ℝ) (ha : -1 < a) :
    ∫ t in (-1:ℝ)..1, t ^ 4 * (1 - t ^ 2) ^ a
      = Real.sqrt π * Real.Gamma (a + 1) / Real.Gamma (a + 3/2)
        - 2 * (Real.sqrt π * Real.Gamma (a + 2) / Real.Gamma (a + 5/2))
        + Real.sqrt π * Real.Gamma (a + 3) / Real.Gamma (a + 7/2) := by
  have hcongr : ∫ t in (-1:ℝ)..1, t ^ 4 * (1 - t ^ 2) ^ a
      = ∫ t in (-1:ℝ)..1, ((1 - t ^ 2) ^ a - 2 * (1 - t ^ 2) ^ (a + 1) + (1 - t ^ 2) ^ (a + 2)) := by
    refine intervalIntegral.integral_congr fun t ht => ?_
    rw [Set.uIcc_of_le (by norm_num : (-1:ℝ) ≤ 1)] at ht
    have hs : (0:ℝ) ≤ 1 - t ^ 2 := by nlinarith [ht.1, ht.2]
    rcases eq_or_lt_of_le hs with h | h
    · have ht2 : t ^ 2 = 1 := by linarith
      have ht4 : t ^ 4 = 1 := by rw [show (4 : ℕ) = 2 * 2 from rfl, pow_mul, ht2]; norm_num
      rw [← h, Real.zero_rpow (by linarith : a + 1 ≠ 0), Real.zero_rpow (by linarith : a + 2 ≠ 0),
        ht4]
      ring
    · rw [Real.rpow_add h a 1, Real.rpow_add h a 2, Real.rpow_one, Real.rpow_two]
      ring
  have hI1 := aux_I (a + 1) (by linarith)
  have hI2 := aux_I (a + 2) (by linarith)
  rw [show a + 1 + 1 = a + 2 by ring, show a + 1 + 3/2 = a + 5/2 by ring] at hI1
  rw [show a + 2 + 1 = a + 3 by ring, show a + 2 + 3/2 = a + 7/2 by ring] at hI2
  rw [hcongr, intervalIntegral.integral_add ((aux_ii a ha).sub ((aux_ii (a+1) (by linarith)).const_mul 2))
    (aux_ii (a+2) (by linarith)), intervalIntegral.integral_sub (aux_ii a ha)
    ((aux_ii (a+1) (by linarith)).const_mul 2), intervalIntegral.integral_const_mul, aux_I a ha,
    hI1, hI2]

/-- `f_d` has fourth moment `3/(d(d+2))`. -/
theorem sphericalPdf_fourth_moment (hd : 2 ≤ d) :
    ∫ t in (-1 : ℝ)..1, t ^ 4 * sphericalPdf d t = 3 / ((d : ℝ) * ((d : ℝ) + 2)) := by
  have hdR : (2:ℝ) ≤ (d:ℝ) := by exact_mod_cast hd
  have ha : (-1:ℝ) < ((d:ℝ) - 3) / 2 := by linarith
  have h1 : 0 < Real.Gamma ((d:ℝ)/2) := Real.Gamma_pos_of_pos (by linarith)
  have h2 : 0 < Real.Gamma (((d:ℝ)-1)/2) := Real.Gamma_pos_of_pos (by linarith)
  have h3 : 0 < Real.sqrt π := Real.sqrt_pos.mpr Real.pi_pos
  have e1 : Real.Gamma (((d:ℝ)+1)/2) = (((d:ℝ)-1)/2) * Real.Gamma (((d:ℝ)-1)/2) := by
    have := Real.Gamma_add_one (s := ((d:ℝ)-1)/2) (by intro h; linarith [h])
    rw [show ((d:ℝ)-1)/2 + 1 = ((d:ℝ)+1)/2 by ring] at this
    exact this
  have e2 : Real.Gamma (((d:ℝ)+2)/2) = ((d:ℝ)/2) * Real.Gamma ((d:ℝ)/2) := by
    have := Real.Gamma_add_one (s := (d:ℝ)/2) (by intro h; linarith [h])
    rw [show (d:ℝ)/2 + 1 = ((d:ℝ)+2)/2 by ring] at this
    exact this
  have e3 : Real.Gamma (((d:ℝ)+3)/2) = (((d:ℝ)+1)/2) * Real.Gamma (((d:ℝ)+1)/2) := by
    have := Real.Gamma_add_one (s := ((d:ℝ)+1)/2) (by intro h; linarith [h])
    rw [show ((d:ℝ)+1)/2 + 1 = ((d:ℝ)+3)/2 by ring] at this
    exact this
  have e4 : Real.Gamma (((d:ℝ)+4)/2) = (((d:ℝ)+2)/2) * Real.Gamma (((d:ℝ)+2)/2) := by
    have := Real.Gamma_add_one (s := ((d:ℝ)+2)/2) (by intro h; linarith [h])
    rw [show ((d:ℝ)+2)/2 + 1 = ((d:ℝ)+4)/2 by ring] at this
    exact this
  have hJ := aux_J4 (((d:ℝ) - 3) / 2) ha
  rw [show ((d:ℝ) - 3) / 2 + 1 = ((d:ℝ) - 1) / 2 by ring,
    show ((d:ℝ) - 3) / 2 + 3/2 = (d:ℝ) / 2 by ring,
    show ((d:ℝ) - 3) / 2 + 2 = ((d:ℝ) + 1) / 2 by ring,
    show ((d:ℝ) - 3) / 2 + 5/2 = ((d:ℝ) + 2) / 2 by ring,
    show ((d:ℝ) - 3) / 2 + 3 = ((d:ℝ) + 3) / 2 by ring,
    show ((d:ℝ) - 3) / 2 + 7/2 = ((d:ℝ) + 4) / 2 by ring] at hJ
  have hmul : ∀ t : ℝ, t ^ 4 * sphericalPdf d t
      = (Real.Gamma ((d : ℝ) / 2) / (Real.sqrt π * Real.Gamma (((d : ℝ) - 1) / 2)))
        * (t ^ 4 * (1 - t ^ 2) ^ (((d : ℝ) - 3) / 2)) := by
    intro t; simp only [sphericalPdf]; ring
  simp only [hmul]
  rw [intervalIntegral.integral_const_mul, hJ, e4, e3, e2, e1]
  have hdne : (d:ℝ) ≠ 0 := by linarith
  have hd2 : (d:ℝ) + 2 ≠ 0 := by linarith
  field_simp
  ring

private theorem aux_integral_pow_four_pdf (hd : 2 ≤ d) :
    ∫ t, t ^ 4 * sphericalPdf d t ∂(volume.restrict (Set.Icc (-1:ℝ) 1))
      = 3 / ((d : ℝ) * ((d : ℝ) + 2)) := by
  rw [aux_restrict_Icc_eq, ← intervalIntegral.integral_of_le (by norm_num : (-1:ℝ) ≤ 1)]
  exact sphericalPdf_fourth_moment hd

/-- **The fourth moment of the coordinate law is `3/(d(d+2))`.** -/
theorem integral_pow_four_sphericalCoordLaw (hd : 2 ≤ d) :
    ∫ t, t ^ 4 ∂(sphericalCoordLaw d) = 3 / ((d : ℝ) * ((d : ℝ) + 2)) := by
  rw [sphericalCoordLaw,
    integral_withDensity_eq_integral_toReal_smul
      (f := fun t => ENNReal.ofReal (sphericalPdf d t))
      (ENNReal.measurable_ofReal.comp (aux_meas_pdf d))
      (Filter.Eventually.of_forall fun t => ENNReal.ofReal_lt_top)]
  rw [show (∫ t, (ENNReal.ofReal (sphericalPdf d t)).toReal • t ^ 4
        ∂(volume.restrict (Set.Icc (-1:ℝ) 1)))
      = ∫ t, t ^ 4 * sphericalPdf d t ∂(volume.restrict (Set.Icc (-1:ℝ) 1)) from
    setIntegral_congr_fun measurableSet_Icc fun t ht => by
      rw [ENNReal.toReal_ofReal (sphericalPdf_nonneg ht hd), smul_eq_mul, mul_comm]]
  exact aux_integral_pow_four_pdf hd

namespace Hadamard

open Orthogonal

/-- **The fourth-moment gap between the Hadamard and the spherical coordinate law**, exactly:
for a unit direction `v`, `E (H D_ε v)ᵢ⁴ − E_{f_d} t⁴ = (6/(d+2) − 2 ∑ⱼ vⱼ⁴)/d²`. -/
theorem signAvg_coord_pow_four_sub_sphere {d : ℕ} (hd : 2 ≤ d) {H : Od d} (hH : IsFlat H)
    {v : Ed d} (hv : ‖v‖ = 1) (i : Fin d) :
    signAvg (fun s => (hadRot H s • v) i ^ 4) - ∫ t, t ^ 4 ∂(sphericalCoordLaw d)
      = (6 / ((d : ℝ) + 2) - 2 * ∑ j, v j ^ 4) / (d : ℝ) ^ 2 := by
  rw [signAvg_coord_pow_four hH, integral_pow_four_sphericalCoordLaw hd, hv]
  have hdR : (2:ℝ) ≤ (d:ℝ) := by exact_mod_cast hd
  have hdne : (d:ℝ) ≠ 0 := by linarith
  have hd2 : (d:ℝ) + 2 ≠ 0 := by linarith
  field_simp
  ring

/-- For a unit vector, `1/d ≤ ∑ⱼ vⱼ⁴ ≤ 1`. -/
theorem sum_pow_four_bounds {d : ℕ} (hd : 0 < d) {v : Ed d} (hv : ‖v‖ = 1) :
    1 / (d : ℝ) ≤ ∑ j, v j ^ 4 ∧ ∑ j, v j ^ 4 ≤ 1 := by
  have h2 : ∑ j, v j ^ 2 = 1 := by rw [← norm_sq_eq_sum_sq, hv, one_pow]
  have hdR : (0:ℝ) < d := by exact_mod_cast hd
  constructor
  · have hcs := sq_sum_le_card_mul_sum_sq (s := Finset.univ) (f := fun j => v j ^ 2)
    simp only [Finset.card_univ, Fintype.card_fin] at hcs
    rw [h2, one_pow] at hcs
    have : ∀ j, (v j ^ 2) ^ 2 = v j ^ 4 := fun j => by ring
    simp only [this] at hcs
    rw [div_le_iff₀ hdR]; linarith
  · calc ∑ j, v j ^ 4 = ∑ j, v j ^ 2 * v j ^ 2 := by
          refine Finset.sum_congr rfl fun j _ => by ring
      _ ≤ ∑ j, v j ^ 2 * 1 := Finset.sum_le_sum fun j _ =>
          mul_le_mul_of_nonneg_left (by
            rw [← h2]
            exact Finset.single_le_sum (f := fun k => v k ^ 2) (fun k _ => sq_nonneg _)
              (Finset.mem_univ j)) (sq_nonneg _)
      _ = 1 := by simp [h2]

/-- **The gap is at most `4/d³` above and `2/d²` below**: for a spread direction the Hadamard
coordinate law matches `f_d` to fourth order, for a spiky one it falls short at order `1/d²`. -/
theorem abs_signAvg_coord_pow_four_sub_sphere {d : ℕ} (hd : 2 ≤ d) {H : Od d} (hH : IsFlat H)
    {v : Ed d} (hv : ‖v‖ = 1) (i : Fin d) :
    signAvg (fun s => (hadRot H s • v) i ^ 4) - ∫ t, t ^ 4 ∂(sphericalCoordLaw d) ≤ 4 / (d : ℝ) ^ 3
    ∧ -(2 / (d : ℝ) ^ 2) ≤ signAvg (fun s => (hadRot H s • v) i ^ 4) - ∫ t, t ^ 4 ∂(sphericalCoordLaw d) := by
  rw [signAvg_coord_pow_four_sub_sphere hd hH hv i]
  obtain ⟨hlo, hhi⟩ := sum_pow_four_bounds (by omega) hv
  have hdR : (2:ℝ) ≤ (d:ℝ) := by exact_mod_cast hd
  have hdpos : (0:ℝ) < d := by linarith
  constructor
  · rw [div_le_div_iff₀ (by positivity) (by positivity)]
    have h6 : 6 / ((d:ℝ) + 2) ≤ 3 := by rw [div_le_iff₀ (by linarith)]; linarith
    have hl : 2 / (d:ℝ) ≤ 2 * ∑ j, v j ^ 4 := by
      have := mul_le_mul_of_nonneg_left hlo (by norm_num : (0:ℝ) ≤ 2)
      rw [show 2 * (1 / (d:ℝ)) = 2 / d by ring] at this; exact this
    have h6' : 6 / ((d:ℝ) + 2) - 2 / d ≤ 4 / d := by
      rw [div_sub_div _ _ (by linarith) hdpos.ne', div_le_div_iff₀ (by positivity) hdpos]
      nlinarith
    calc (6 / ((d:ℝ) + 2) - 2 * ∑ j, v j ^ 4) * (d:ℝ) ^ 3
        ≤ (6 / ((d:ℝ) + 2) - 2 / d) * (d:ℝ) ^ 3 := by gcongr
      _ ≤ 4 / d * (d:ℝ) ^ 3 := by gcongr
      _ = 4 * (d:ℝ) ^ 2 := by field_simp; try ring
  · rw [show -(2 / (d:ℝ) ^ 2) = (-2) / (d:ℝ) ^ 2 by ring,
      div_le_div_iff_of_pos_right (by positivity)]
    have : 0 ≤ 6 / ((d:ℝ) + 2) := by positivity
    linarith

end Hadamard
/-! ## §38  The Sylvester construction: flat orthogonal matrices exist in every dimension `2^n`

§36 assumed a flat orthogonal matrix `H` (every entry `±1/√d`).  This section constructs one:
the Walsh–Hadamard matrix on the hypercube `{0,1}^n`, `H(a, b) = (−1)^{⟨a, b⟩}/√(2^n)`
(`walsh`), is orthogonal because its character sum factorises over the coordinates,
`∑_b ∏_j (−1)^{(a_j + a'_j) b_j} = ∏_j ∑_β (−1)^{(a_j + a'_j) β} = 2^n [a = a']`
(`walsh_mul_transpose`), and every entry squares to `1/2^n` (`walsh_apply_sq`).  Reindexing the
hypercube by `Fin (2^n)` gives `exists_isFlat : ∃ H : Od (2^n), IsFlat H`, so the hypothesis of
§36 is satisfiable exactly in the dimensions the deployed pipeline uses. -/

namespace Hadamard

open Orthogonal


/-! ### The Sylvester–Walsh matrix on the hypercube -/

/-- `(−1)^{αβ}` for bits `α, β`. -/
def sgnAnd (α β : Bool) : ℝ := if α && β then -1 else 1

theorem sgnAnd_sq (α β : Bool) : sgnAnd α β ^ 2 = 1 := by
  cases α <;> cases β <;> simp [sgnAnd]

theorem sgnAnd_false_right (α : Bool) : sgnAnd α false = 1 := by cases α <;> simp [sgnAnd]

/-- `∑_β (−1)^{αβ} (−1)^{α'β} = 2 [α = α']`. -/
theorem sum_sgnAnd_mul (α α' : Bool) :
    ∑ β : Bool, sgnAnd α β * sgnAnd α' β = if α = α' then 2 else 0 := by
  cases α <;> cases α' <;> norm_num [sgnAnd]

/-- The Walsh–Hadamard matrix on `{0,1}^n`, with entries `±1/√(2^n)`. -/
noncomputable def walsh (n : ℕ) : Matrix (Fin n → Bool) (Fin n → Bool) ℝ :=
  fun a b => (∏ j, sgnAnd (a j) (b j)) / Real.sqrt (2 ^ n)

theorem walsh_apply_sq (n : ℕ) (a b : Fin n → Bool) : walsh n a b ^ 2 = 1 / 2 ^ n := by
  unfold walsh
  rw [div_pow, Real.sq_sqrt (by positivity), ← Finset.prod_pow]
  simp [sgnAnd_sq]

/-- **Orthogonality of the Walsh matrix**: the character sum factorises over coordinates. -/
theorem walsh_mul_transpose (n : ℕ) : walsh n * Matrix.transpose (walsh n) = 1 := by
  ext a a'
  simp only [Matrix.mul_apply, Matrix.transpose_apply, walsh, Matrix.one_apply]
  have h2 : (0 : ℝ) < Real.sqrt (2 ^ n) := Real.sqrt_pos.mpr (by positivity)
  have hprod : ∀ b : Fin n → Bool,
      (∏ j, sgnAnd (a j) (b j)) / Real.sqrt (2 ^ n) * ((∏ j, sgnAnd (a' j) (b j)) / Real.sqrt (2 ^ n))
        = (1 / 2 ^ n) * ∏ j, (sgnAnd (a j) (b j) * sgnAnd (a' j) (b j)) := by
    intro b
    rw [div_mul_div_comm, Real.mul_self_sqrt (by positivity), ← Finset.prod_mul_distrib,
      div_eq_inv_mul, one_div]
  simp_rw [hprod]
  rw [← Finset.mul_sum]
  have hfac := Fintype.prod_sum (fun j (β : Bool) => sgnAnd (a j) β * sgnAnd (a' j) β)
  beta_reduce at hfac
  rw [← hfac]
  simp_rw [sum_sgnAnd_mul]
  by_cases h : a = a'
  · subst h
    simp only [if_true, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    field_simp
  · rw [if_neg h]
    obtain ⟨j, hj⟩ : ∃ j, a j ≠ a' j := by
      by_contra hcon
      push_neg at hcon
      exact h (funext hcon)
    rw [Finset.prod_eq_zero (Finset.mem_univ j) (by rw [if_neg hj]), mul_zero]

/-- The reindexing `{0,1}^n ≃ Fin (2^n)`. -/
noncomputable def cubeEquiv (n : ℕ) : (Fin n → Bool) ≃ Fin (2 ^ n) :=
  (Fintype.equivFin _).trans (finCongr (by simp))

/-- The Walsh–Hadamard matrix on `Fin (2^n)`. -/
noncomputable def walshFin (n : ℕ) : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℝ :=
  Matrix.reindex (cubeEquiv n) (cubeEquiv n) (walsh n)

theorem walshFin_mem (n : ℕ) : walshFin n ∈ Matrix.orthogonalGroup (Fin (2 ^ n)) ℝ := by
  rw [Matrix.mem_orthogonalGroup_iff, walshFin, Matrix.reindex_apply, Matrix.transpose_submatrix,
    Matrix.submatrix_mul_equiv, walsh_mul_transpose, Matrix.submatrix_one_equiv]

theorem walshFin_apply_sq (n : ℕ) (i j : Fin (2 ^ n)) : walshFin n i j ^ 2 = 1 / 2 ^ n := by
  rw [walshFin, Matrix.reindex_apply, Matrix.submatrix_apply, walsh_apply_sq]

/-- **The Sylvester construction**: in every dimension `2^n` there is a flat orthogonal matrix,
so the hypothesis `IsFlat` of §36 is satisfiable exactly where the deployed pipeline needs it. -/
theorem exists_isFlat (n : ℕ) : ∃ H : Od (2 ^ n), IsFlat H := by
  refine ⟨⟨walshFin n, walshFin_mem n⟩, fun i j => ?_⟩
  show walshFin n i j ^ 2 = 1 / ((2 ^ n : ℕ) : ℝ)
  rw [walshFin_apply_sq]; push_cast; rfl

end Hadamard
/-! ## §39  The general two-point Gaussian Poincaré inequality, proved

§26 stated `GaussPoincare γ`: for every `f ∈ L²(γ)` with `|f x − f y| ≤ ‖x − y‖ (G x + G y)` off
the origin, `G` continuous off the origin and square-integrable, `Var_γ f ≤ ∫ (2G)²`.  This
section proves it, by reduction to the `C¹` inequality of §32 through three approximations.
Mollification: for `g` bounded, compactly supported and continuous off the origin, the
convolution `φ_ε ⋆ g` with a normalised bump is smooth, satisfies the same two-point bound with
the mollified slope `φ_ε ⋆ G` everywhere (`abs_moll_sub_le`; the origin is a null set for the
convolution integral and needs no cutoff), so `‖(φ_ε ⋆ g)'‖ ≤ 2 φ_ε ⋆ G` (`norm_fderiv_moll_le`)
and §32 gives `Var (φ_ε ⋆ g) ≤ 4 ∫ (φ_ε ⋆ G)²` on a ball around the support
(`variance_moll_le`); Jensen and the comparison `ρ(y + t) ≤ e^{‖y‖‖t‖} ρ(y)` of the Gaussian
density bound this by `4 e^{O(ε)} ∫ G²` (`integral_indicator_moll_sq_le`), and dominated
convergence closes the mollification (`variance_le_of_twoPoint_compact`).  A smooth cutoff at
radius `R` costs `Cc M/(2R)` in the slope and `M² d/R²` in `L²` (`variance_clampF_le`), and
truncation at level `M` costs nothing in the slope and vanishes in `L²` as `M → ∞`
(`variance_le_of_twoPoint`).  Hence `gaussPoincare_gaussianE : GaussPoincare (gaussianE E)`,
`spherePoincare_sphereUniformAmbient`, and `meas_not_decayWithin_le_general`, the concentration
remark of §26 for an arbitrary codebook with its hypothesis discharged.  Nothing in the
development is now taken as a hypothesis beyond the rotation-stream model. -/

section MollifyPrelim

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

/-- `∫⁻ h dγ = Z⁻¹ ∫⁻ h ρ dx`. -/
theorem lintegral_gaussianE_eq {h : E → ℝ≥0∞} (hh : Measurable h) :
    ∫⁻ x, h x ∂(gaussianE E) = (gaussRaw E Set.univ)⁻¹ * ∫⁻ x, h x * gaussDensity x := by
  unfold gaussianE
  rw [lintegral_smul_measure, gaussRaw, lintegral_withDensity_eq_lintegral_mul _
    measurable_gaussDensity hh]
  congr 1
  refine lintegral_congr fun x => ?_
  simp [mul_comm]

theorem gaussDensity_ge_of_norm_le {r : ℝ} {x : E} (hx : ‖x‖ ≤ r) :
    ENNReal.ofReal (Real.exp (-(r ^ 2) / 2)) ≤ gaussDensity x := by
  unfold gaussDensity
  refine ENNReal.ofReal_le_ofReal (Real.exp_le_exp.mpr ?_)
  have := norm_nonneg x
  nlinarith

/-- A function whose square is `γ`-integrable has locally integrable square for Lebesgue
measure. -/
theorem integrableOn_sq_of_gauss {G : E → ℝ} (hG : Measurable G)
    (hint : Integrable (fun x => G x ^ 2) (gaussianE E)) {k : Set E} (hk : IsCompact k) :
    IntegrableOn (fun x => G x ^ 2) k volume := by
  obtain ⟨r, hr⟩ := hk.isBounded.subset_closedBall (0 : E)
  set c : ℝ≥0∞ := ENNReal.ofReal (Real.exp (-(r ^ 2) / 2)) with hc
  have hc0 : c ≠ 0 := by rw [hc]; exact (ENNReal.ofReal_pos.mpr (Real.exp_pos _)).ne'
  have hcT : c ≠ ⊤ := ENNReal.ofReal_ne_top
  refine ⟨(hG.pow_const 2).aestronglyMeasurable.restrict, ?_⟩
  rw [hasFiniteIntegral_iff_ofReal (Filter.Eventually.of_forall fun x => sq_nonneg _)]
  have hfin : ∫⁻ x, ENNReal.ofReal (G x ^ 2) ∂(gaussianE E) < ⊤ := by
    have := hint.hasFiniteIntegral
    rwa [hasFiniteIntegral_iff_ofReal (Filter.Eventually.of_forall fun x => sq_nonneg _)] at this
  rw [lintegral_gaussianE_eq (hG.pow_const 2).ennreal_ofReal] at hfin
  have hZ : (gaussRaw E Set.univ)⁻¹ ≠ 0 := ENNReal.inv_ne_zero.mpr gaussRaw_univ_ne_top
  have hfin2 : ∫⁻ x, ENNReal.ofReal (G x ^ 2) * gaussDensity x < ⊤ := by
    by_contra h
    rw [not_lt, top_le_iff] at h
    rw [h, ENNReal.mul_top hZ] at hfin
    exact absurd hfin (lt_irrefl _)
  calc ∫⁻ x in k, ENNReal.ofReal (G x ^ 2) ∂volume
      ≤ ∫⁻ x in k, c⁻¹ * (ENNReal.ofReal (G x ^ 2) * gaussDensity x) ∂volume := by
        refine lintegral_mono_ae ?_
        rw [ae_restrict_iff' hk.measurableSet]
        refine Filter.Eventually.of_forall fun x hx => ?_
        have hx' : ‖x‖ ≤ r := by
          have := hr hx; rwa [Metric.mem_closedBall, dist_zero_right] at this
        have h1 : c ≤ gaussDensity x := gaussDensity_ge_of_norm_le hx'
        calc ENNReal.ofReal (G x ^ 2) = c⁻¹ * (ENNReal.ofReal (G x ^ 2) * c) := by
              rw [mul_comm, mul_assoc, ENNReal.mul_inv_cancel hc0 hcT, mul_one]
          _ ≤ c⁻¹ * (ENNReal.ofReal (G x ^ 2) * gaussDensity x) :=
              mul_le_mul' le_rfl (mul_le_mul' le_rfl h1)
    _ = c⁻¹ * ∫⁻ x in k, ENNReal.ofReal (G x ^ 2) * gaussDensity x ∂volume :=
        lintegral_const_mul _ ((hG.pow_const 2).ennreal_ofReal.mul measurable_gaussDensity)
    _ ≤ c⁻¹ * ∫⁻ x, ENNReal.ofReal (G x ^ 2) * gaussDensity x ∂volume :=
        mul_le_mul' le_rfl (setLIntegral_le_lintegral _ _)
    _ < ⊤ := ENNReal.mul_lt_top (ENNReal.inv_lt_top.mpr (pos_iff_ne_zero.mpr hc0)) hfin2

theorem locallyIntegrable_sq_of_gauss {G : E → ℝ} (hG : Measurable G)
    (hint : Integrable (fun x => G x ^ 2) (gaussianE E)) :
    LocallyIntegrable (fun x => G x ^ 2) volume :=
  locallyIntegrable_iff.mpr fun k hk => integrableOn_sq_of_gauss hG hint hk

theorem locallyIntegrable_of_gauss {G : E → ℝ} (hG : Measurable G)
    (hint : Integrable (fun x => G x ^ 2) (gaussianE E)) : LocallyIntegrable G volume := by
  refine locallyIntegrable_iff.mpr fun k hk => ?_
  have h2 := integrableOn_sq_of_gauss hG hint hk
  have h1 : IntegrableOn (fun _ : E => (1 : ℝ)) k volume :=
    integrableOn_const hk.measure_lt_top.ne
  refine (h1.add h2).mono' hG.aestronglyMeasurable.restrict
    (Filter.Eventually.of_forall fun x => ?_)
  show ‖G x‖ ≤ 1 + G x ^ 2
  rw [Real.norm_eq_abs]
  nlinarith [abs_nonneg (G x), sq_abs (G x), sq_nonneg (|G x| - 1)]

end MollifyPrelim

section Mollify

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

/-- The mollification of `g` by the normalised bump `φ`. -/
noncomputable def moll (φ : ContDiffBump (0 : E)) (g : E → ℝ) : E → ℝ :=
  convolution (φ.normed volume) g (ContinuousLinearMap.lsmul ℝ ℝ) volume

theorem moll_apply (φ : ContDiffBump (0 : E)) (g : E → ℝ) (x : E) :
    moll φ g x = ∫ t, φ.normed volume t * g (x - t) := by
  simp only [moll, convolution_def, ContinuousLinearMap.lsmul_apply, smul_eq_mul]

theorem continuous_normed (φ : ContDiffBump (0 : E)) : Continuous (φ.normed volume) :=
  (φ.contDiff_normed (n := 0)).continuous

theorem hasCompactSupport_normed' (φ : ContDiffBump (0 : E)) :
    HasCompactSupport (φ.normed volume) := φ.hasCompactSupport_normed

theorem normed_eq_zero_of_le {φ : ContDiffBump (0 : E)} {t : E} (ht : φ.rOut ≤ ‖t‖) :
    φ.normed volume t = 0 := by
  by_contra h
  have : t ∈ Function.support (φ.normed volume) := h
  rw [φ.support_normed_eq, Metric.mem_ball, dist_zero_right] at this
  linarith

/-- The convolution integrand is integrable for locally integrable `g`. -/
theorem integrable_moll_integrand (φ : ContDiffBump (0 : E)) {g : E → ℝ}
    (hg : LocallyIntegrable g volume) (x : E) :
    Integrable (fun t => φ.normed volume t * g (x - t)) volume :=
  (hasCompactSupport_normed' φ).convolutionExists_left (ContinuousLinearMap.lsmul ℝ ℝ)
    (continuous_normed φ) hg x

theorem moll_nonneg (φ : ContDiffBump (0 : E)) {G : E → ℝ} (hG0 : ∀ x, 0 ≤ G x) (x : E) :
    0 ≤ moll φ G x := by
  rw [moll_apply]
  exact integral_nonneg fun t => mul_nonneg (φ.nonneg_normed (μ := volume) t) (hG0 _)

theorem abs_moll_le (φ : ContDiffBump (0 : E)) {g : E → ℝ} (hg : LocallyIntegrable g volume)
    {M : ℝ} (hM : ∀ x, |g x| ≤ M) (x : E) : |moll φ g x| ≤ M := by
  rw [moll_apply]
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  calc |∫ t, φ.normed volume t * g (x - t)| ≤ ∫ t, |φ.normed volume t * g (x - t)| :=
        abs_integral_le_integral_abs
    _ ≤ ∫ t, φ.normed volume t * M := by
        refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun t => abs_nonneg _)
          ((φ.integrable_normed).mul_const M) (Filter.Eventually.of_forall fun t => ?_)
        show |φ.normed volume t * g (x - t)| ≤ φ.normed volume t * M
        rw [abs_mul, abs_of_nonneg (φ.nonneg_normed (μ := volume) t)]
        exact mul_le_mul_of_nonneg_left (hM _) (φ.nonneg_normed (μ := volume) t)
    _ = M := by rw [integral_mul_const, φ.integral_normed, one_mul]

/-- The mollification vanishes at distance `rOut` from the support. -/
theorem moll_eq_zero_of_norm_ge (φ : ContDiffBump (0 : E)) {g : E → ℝ} {R : ℝ}
    (hg : ∀ x, R < ‖x‖ → g x = 0) {x : E} (hx : R + φ.rOut ≤ ‖x‖) : moll φ g x = 0 := by
  rw [moll_apply]
  refine integral_eq_zero_of_ae (Filter.Eventually.of_forall fun t => ?_)
  show φ.normed volume t * g (x - t) = 0
  by_cases ht : φ.rOut ≤ ‖t‖
  · rw [normed_eq_zero_of_le ht, zero_mul]
  · push_neg at ht
    rw [hg (x - t) (by
      have := norm_sub_norm_le x t
      linarith), mul_zero]

/-- **The two-point bound passes to the mollification**, with slope `moll φ G`. -/
theorem abs_moll_sub_le (φ : ContDiffBump (0 : E)) {g G : E → ℝ}
    (hg : LocallyIntegrable g volume) (hG : LocallyIntegrable G volume)
    (h : ∀ x y, x ≠ 0 → y ≠ 0 → |g x - g y| ≤ ‖x - y‖ * (G x + G y)) (x y : E) :
    |moll φ g x - moll φ g y| ≤ ‖x - y‖ * (moll φ G x + moll φ G y) := by
  have hix := integrable_moll_integrand φ hg x
  have hiy := integrable_moll_integrand φ hg y
  have hGx := integrable_moll_integrand φ hG x
  have hGy := integrable_moll_integrand φ hG y
  simp only [moll_apply]
  rw [← integral_sub hix hiy, ← integral_add hGx hGy, ← integral_const_mul]
  have hae : ∀ᵐ t ∂(volume : Measure E), x - t ≠ 0 ∧ y - t ≠ 0 := by
    have h1 : ∀ᵐ t ∂(volume : Measure E), t ≠ x := by
      rw [ae_iff]; simp only [not_not]
      exact measure_singleton x
    have h2 : ∀ᵐ t ∂(volume : Measure E), t ≠ y := by
      rw [ae_iff]; simp only [not_not]
      exact measure_singleton y
    filter_upwards [h1, h2] with t ht1 ht2
    exact ⟨sub_ne_zero.mpr (Ne.symm ht1), sub_ne_zero.mpr (Ne.symm ht2)⟩
  refine abs_integral_le_integral_abs.trans (integral_mono_of_nonneg
    (Filter.Eventually.of_forall fun t => abs_nonneg _) ((hGx.add hGy).const_mul _) ?_)
  filter_upwards [hae] with t ⟨ht1, ht2⟩
  have hφ := φ.nonneg_normed (μ := volume) t
  show |φ.normed volume t * g (x - t) - φ.normed volume t * g (y - t)|
    ≤ ‖x - y‖ * (φ.normed volume t * G (x - t) + φ.normed volume t * G (y - t))
  rw [← mul_sub, abs_mul, abs_of_nonneg hφ]
  have hxy : ‖x - t - (y - t)‖ = ‖x - y‖ := by rw [sub_sub_sub_cancel_right]
  calc φ.normed volume t * |g (x - t) - g (y - t)|
      ≤ φ.normed volume t * (‖x - t - (y - t)‖ * (G (x - t) + G (y - t))) :=
        mul_le_mul_of_nonneg_left (h _ _ ht1 ht2) hφ
    _ = ‖x - y‖ * (φ.normed volume t * G (x - t) + φ.normed volume t * G (y - t)) := by
        rw [hxy]; ring

theorem contDiff_moll (φ : ContDiffBump (0 : E)) {g : E → ℝ} (hg : LocallyIntegrable g volume) :
    ContDiff ℝ 1 (moll φ g) :=
  (hasCompactSupport_normed' φ).contDiff_convolution_left _ (φ.contDiff_normed) hg

theorem continuous_moll (φ : ContDiffBump (0 : E)) {g : E → ℝ} (hg : LocallyIntegrable g volume) :
    Continuous (moll φ g) :=
  (hasCompactSupport_normed' φ).continuous_convolution_left _ (continuous_normed φ) hg

/-- **The gradient of the mollification is bounded by twice the mollified slope.** -/
theorem norm_fderiv_moll_le (φ : ContDiffBump (0 : E)) {g G : E → ℝ}
    (hg : LocallyIntegrable g volume) (hG : LocallyIntegrable G volume) (hG0 : ∀ x, 0 ≤ G x)
    (h : ∀ x y, x ≠ 0 → y ≠ 0 → |g x - g y| ≤ ‖x - y‖ * (G x + G y)) {x : E} (hx : x ≠ 0) :
    ‖fderiv ℝ (moll φ g) x‖ ≤ 2 * moll φ G x :=
  norm_fderiv_le_of_twoPoint hx (continuous_moll φ hG).continuousAt (moll_nonneg φ hG0 x)
    (fun z w hz hw => abs_moll_sub_le φ hg hG h z w)
    (((contDiff_moll φ hg).differentiable one_ne_zero) x).hasFDerivAt


theorem hasCompactSupport_of_vanish {g : E → ℝ} {R : ℝ} (hR : ∀ x, R < ‖x‖ → g x = 0) :
    HasCompactSupport g :=
  HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall (0 : E) R) fun x hx => by
    rw [Metric.mem_closedBall, dist_zero_right]
    by_contra h; push_neg at h
    exact hx (hR x h)

/-- **Step L4: the variance of the mollification** is controlled by the mollified slope on a
ball around the support. -/
theorem variance_moll_le (hd : 2 ≤ Module.finrank ℝ E) (φ : ContDiffBump (0 : E)) {g G : E → ℝ}
    (hg : LocallyIntegrable g volume) {M : ℝ} (hM : ∀ x, |g x| ≤ M) {R : ℝ}
    (hR : ∀ x, R < ‖x‖ → g x = 0) (hG : LocallyIntegrable G volume) (hG0 : ∀ x, 0 ≤ G x)
    (h : ∀ x y, x ≠ 0 → y ≠ 0 → |g x - g y| ≤ ‖x - y‖ * (G x + G y)) :
    variance (moll φ g) (gaussianE E)
      ≤ 4 * ∫ x, (Metric.ball (0 : E) (R + φ.rOut + 1)).indicator (fun x => moll φ G x ^ 2) x
          ∂(gaussianE E) := by
  have hdiff : Differentiable ℝ (moll φ g) := (contDiff_moll φ hg).differentiable one_ne_zero
  have hbM : ∀ z, |moll φ g z| ≤ M := abs_moll_le φ hg hM
  have hsupp : HasCompactSupport (moll φ g) :=
    (hasCompactSupport_normed' φ).convolution _ (hasCompactSupport_of_vanish hR)
  obtain ⟨K, hK⟩ := ((contDiff_moll φ hg).continuous_fderiv one_ne_zero).bounded_above_of_compact_support
    (hsupp.fderiv ℝ)
  refine (variance_le_integral_norm_fderiv_sq hd hdiff hbM hK).trans ?_
  have hcont : Continuous (moll φ G) := continuous_moll φ hG
  have hint : Integrable ((Metric.ball (0 : E) (R + φ.rOut + 1)).indicator
      (fun x => moll φ G x ^ 2)) (gaussianE E) := by
    rw [integrable_indicator_iff measurableSet_ball]
    exact ((hcont.pow 2).continuousOn.integrableOn_compact (isCompact_closedBall _ _)).mono_set
      Metric.ball_subset_closedBall
  rw [← integral_const_mul]
  refine integral_mono_ae (integrable_norm_fderiv_sq hK measurable_id) (hint.const_mul _) ?_
  filter_upwards [gaussianE_ae_ne_zero (E := E)] with x hx
  by_cases hxb : x ∈ Metric.ball (0 : E) (R + φ.rOut + 1)
  · rw [Set.indicator_of_mem hxb]
    have := norm_fderiv_moll_le φ hg hG hG0 h hx
    have h0 := moll_nonneg φ hG0 x
    nlinarith [norm_nonneg (fderiv ℝ (moll φ g) x)]
  · rw [Set.indicator_of_notMem hxb, mul_zero]
    rw [Metric.mem_ball, dist_zero_right, not_lt] at hxb
    have hev : moll φ g =ᶠ[𝓝 x] fun _ => 0 := by
      have hopen : {z : E | R + φ.rOut < ‖z‖} ∈ 𝓝 x :=
        (isOpen_lt continuous_const continuous_norm).mem_nhds (by
          show R + φ.rOut < ‖x‖; linarith)
      filter_upwards [hopen] with z hz
      exact moll_eq_zero_of_norm_ge φ hR (le_of_lt hz)
    rw [hev.fderiv_eq, fderiv_const_apply]
    simp

/-- The Gaussian density moves by at most `e^{‖y‖‖t‖}` under a shift by `t`. -/
theorem gaussDensity_add_le (y t : E) :
    gaussDensity (y + t) ≤ ENNReal.ofReal (Real.exp (‖y‖ * ‖t‖)) * gaussDensity y := by
  unfold gaussDensity
  rw [← ENNReal.ofReal_mul (Real.exp_pos _).le, ← Real.exp_add]
  refine ENNReal.ofReal_le_ofReal (Real.exp_le_exp.mpr ?_)
  have h1 : |‖y‖ - ‖t‖| ≤ ‖y + t‖ := by
    have := abs_norm_sub_norm_le y (-t)
    rwa [norm_neg, sub_neg_eq_add] at this
  have h5 : (‖y‖ - ‖t‖) ^ 2 ≤ ‖y + t‖ ^ 2 := by
    rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) h1 2
  have h3 := norm_nonneg t
  nlinarith [sq_nonneg ‖t‖]

/-- Jensen: `(moll φ G x)² ≤ moll φ (G²) x`. -/
theorem sq_moll_le_moll_sq (φ : ContDiffBump (0 : E)) {G : E → ℝ} (hGm : Measurable G)
    (hG2 : LocallyIntegrable (fun x => G x ^ 2) volume) (x : E) :
    moll φ G x ^ 2 ≤ moll φ (fun t => G t ^ 2) x := by
  set ν : Measure E := volume.withDensity fun t => ENNReal.ofReal (φ.normed volume t) with hν
  have hφm : Measurable (φ.normed volume) := (continuous_normed φ).measurable
  haveI : IsProbabilityMeasure ν := by
    constructor
    rw [hν, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ,
      ← ofReal_integral_eq_lintegral_ofReal φ.integrable_normed
        (Filter.Eventually.of_forall (φ.nonneg_normed (μ := volume))), φ.integral_normed,
      ENNReal.ofReal_one]
  have hfin : ∀ᵐ t ∂(volume : Measure E), ENNReal.ofReal (φ.normed volume t) < ⊤ :=
    Filter.Eventually.of_forall fun _ => ENNReal.ofReal_lt_top
  have hconv : ∀ k : E → ℝ, ∫ t, k t ∂ν = ∫ t, φ.normed volume t * k t := by
    intro k
    rw [hν, integral_withDensity_eq_integral_toReal_smul hφm.ennreal_ofReal hfin]
    refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
    show (ENNReal.ofReal (φ.normed volume t)).toReal • k t = φ.normed volume t * k t
    rw [ENNReal.toReal_ofReal (φ.nonneg_normed (μ := volume) t), smul_eq_mul]
  have hint2 : Integrable (fun t => (G (x - t)) ^ 2) ν := by
    rw [hν, integrable_withDensity_iff hφm.ennreal_ofReal hfin]
    have := integrable_moll_integrand φ hG2 x
    refine this.congr (Filter.Eventually.of_forall fun t => ?_)
    simp only
    rw [ENNReal.toReal_ofReal (φ.nonneg_normed (μ := volume) t), mul_comm]
  have hmem : MemLp (fun t => G (x - t)) 2 ν := by
    refine (memLp_two_iff_integrable_sq ?_).mpr hint2
    exact (hGm.comp (measurable_const.sub measurable_id)).aestronglyMeasurable
  have hvar := variance_nonneg (fun t => G (x - t)) ν
  rw [variance_eq_sub hmem] at hvar
  have e1 : ∫ t, ((fun t => G (x - t)) ^ 2) t ∂ν = moll φ (fun t => G t ^ 2) x := by
    rw [moll_apply, ← hconv]; rfl
  have e2 : ∫ t, G (x - t) ∂ν = moll φ G x := by rw [moll_apply, ← hconv]
  rw [e1, e2] at hvar
  linarith

/-- **Step L5: the mollified slope, squared and cut to a ball, against `γ`.** -/
theorem integral_indicator_moll_sq_le (φ : ContDiffBump (0 : E)) {G : E → ℝ} (hGm : Measurable G)
    (hG0 : ∀ x, 0 ≤ G x) (hint : Integrable (fun x => G x ^ 2) (gaussianE E)) {S : ℝ}
    (hS : 0 ≤ S) :
    ∫ x, (Metric.ball (0 : E) S).indicator (fun x => moll φ G x ^ 2) x ∂(gaussianE E)
      ≤ Real.exp ((S + φ.rOut) * φ.rOut) * ∫ x, G x ^ 2 ∂(gaussianE E) := by
  have hG2 : LocallyIntegrable (fun x => G x ^ 2) volume := locallyIntegrable_sq_of_gauss hGm hint
  have hG : LocallyIntegrable G volume := locallyIntegrable_of_gauss hGm hint
  have hφm : Measurable (φ.normed volume) := (continuous_normed φ).measurable
  have hcont : Continuous (moll φ G) := continuous_moll φ hG
  set c : ℝ := (S + φ.rOut) * φ.rOut with hc
  have hc0 : 0 ≤ c := mul_nonneg (add_nonneg hS φ.rOut_pos.le) φ.rOut_pos.le
  -- the target in `lintegral` form
  have hR : ∫ x, G x ^ 2 ∂(gaussianE E)
      = (∫⁻ x, ENNReal.ofReal (G x ^ 2) ∂(gaussianE E)).toReal :=
    integral_eq_lintegral_of_nonneg_ae (Filter.Eventually.of_forall fun x => sq_nonneg _)
      (hGm.pow_const 2).aestronglyMeasurable
  have hRfin : ∫⁻ x, ENNReal.ofReal (G x ^ 2) ∂(gaussianE E) ≠ ⊤ := by
    have := hint.hasFiniteIntegral
    rw [hasFiniteIntegral_iff_ofReal (Filter.Eventually.of_forall fun x => sq_nonneg _)] at this
    exact this.ne
  have hL : ∫ x, (Metric.ball (0 : E) S).indicator (fun x => moll φ G x ^ 2) x ∂(gaussianE E)
      = (∫⁻ x, ENNReal.ofReal ((Metric.ball (0 : E) S).indicator (fun x => moll φ G x ^ 2) x)
          ∂(gaussianE E)).toReal :=
    integral_eq_lintegral_of_nonneg_ae
      (Filter.Eventually.of_forall fun x => Set.indicator_nonneg (fun _ _ => sq_nonneg _) _)
      (((hcont.pow 2).measurable).indicator measurableSet_ball).aestronglyMeasurable
  rw [hL, hR, ← ENNReal.toReal_ofReal (Real.exp_pos c).le, ← ENNReal.toReal_mul]
  refine ENNReal.toReal_mono (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hRfin) ?_
  -- Jensen pointwise, then the density comparison
  have hJ : ∀ x, ENNReal.ofReal ((Metric.ball (0 : E) S).indicator (fun x => moll φ G x ^ 2) x)
      ≤ (Metric.ball (0 : E) S).indicator (fun _ => (1 : ℝ≥0∞)) x *
          ∫⁻ t, ENNReal.ofReal (φ.normed volume t) * ENNReal.ofReal (G (x - t) ^ 2) := by
    intro x
    by_cases hx : x ∈ Metric.ball (0 : E) S
    · rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx, one_mul]
      refine (ENNReal.ofReal_le_ofReal (sq_moll_le_moll_sq φ hGm hG2 x)).trans (le_of_eq ?_)
      rw [moll_apply, ofReal_integral_eq_lintegral_ofReal (integrable_moll_integrand φ hG2 x)
        (Filter.Eventually.of_forall fun t =>
          mul_nonneg (φ.nonneg_normed (μ := volume) t) (sq_nonneg _))]
      refine lintegral_congr fun t => ?_
      rw [ENNReal.ofReal_mul (φ.nonneg_normed (μ := volume) t)]
    · rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx, zero_mul, ENNReal.ofReal_zero]
  refine (lintegral_mono hJ).trans ?_
  have hmeasG : Measurable fun p : E × E => ENNReal.ofReal (G (p.1 - p.2) ^ 2) :=
    ((hGm.comp (measurable_fst.sub measurable_snd)).pow_const 2).ennreal_ofReal
  -- write the left side with the Gaussian density and swap the integrals
  have hmeas2 : Measurable fun x : E =>
      ∫⁻ t, ENNReal.ofReal (φ.normed volume t) * ENNReal.ofReal (G (x - t) ^ 2) :=
    Measurable.lintegral_prod_right' (f := fun p : E × E =>
      ENNReal.ofReal (φ.normed volume p.2) * ENNReal.ofReal (G (p.1 - p.2) ^ 2))
      ((hφm.ennreal_ofReal.comp measurable_snd).mul hmeasG)
  have hmeas1 : Measurable fun x : E => (Metric.ball (0 : E) S).indicator (fun _ => (1 : ℝ≥0∞)) x *
      ∫⁻ t, ENNReal.ofReal (φ.normed volume t) * ENNReal.ofReal (G (x - t) ^ 2) :=
    (measurable_const.indicator measurableSet_ball).mul hmeas2
  rw [lintegral_gaussianE_eq hmeas1]
  have hmA : ∀ x : E, Measurable fun t : E =>
      ENNReal.ofReal (φ.normed volume t) * ENNReal.ofReal (G (x - t) ^ 2) := fun x =>
    (hφm.ennreal_ofReal).mul ((hGm.comp (measurable_const.sub measurable_id)).pow_const 2).ennreal_ofReal
  have hmB : ∀ t : E, Measurable fun x : E =>
      (Metric.ball (0 : E) S).indicator (fun _ => (1 : ℝ≥0∞)) x * gaussDensity x *
        ENNReal.ofReal (G (x - t) ^ 2) := fun t =>
    ((measurable_const.indicator measurableSet_ball).mul measurable_gaussDensity).mul
      ((hGm.comp (measurable_id.sub measurable_const)).pow_const 2).ennreal_ofReal
  have hswap : ∫⁻ x, ((Metric.ball (0 : E) S).indicator (fun _ => (1 : ℝ≥0∞)) x *
        ∫⁻ t, ENNReal.ofReal (φ.normed volume t) * ENNReal.ofReal (G (x - t) ^ 2)) * gaussDensity x
      = ∫⁻ t, ENNReal.ofReal (φ.normed volume t) *
          ∫⁻ x, (Metric.ball (0 : E) S).indicator (fun _ => (1 : ℝ≥0∞)) x * gaussDensity x *
            ENNReal.ofReal (G (x - t) ^ 2) := by
    have e : ∀ x, ((Metric.ball (0 : E) S).indicator (fun _ => (1 : ℝ≥0∞)) x *
        ∫⁻ t, ENNReal.ofReal (φ.normed volume t) * ENNReal.ofReal (G (x - t) ^ 2)) * gaussDensity x
        = ∫⁻ t, ENNReal.ofReal (φ.normed volume t) *
            ((Metric.ball (0 : E) S).indicator (fun _ => (1 : ℝ≥0∞)) x * gaussDensity x *
              ENNReal.ofReal (G (x - t) ^ 2)) := by
      intro x
      rw [mul_comm _ (gaussDensity x), ← mul_assoc, ← lintegral_const_mul _ (hmA x)]
      refine lintegral_congr fun t => ?_
      ring
    simp_rw [e]
    rw [lintegral_lintegral_swap]
    · refine lintegral_congr fun t => ?_
      rw [lintegral_const_mul _ (hmB t)]
    · exact ((hφm.ennreal_ofReal.comp measurable_snd).mul
        (((measurable_const.indicator measurableSet_ball).comp measurable_fst |>.mul
          (measurable_gaussDensity.comp measurable_fst)).mul hmeasG)).aemeasurable
  rw [hswap]
  -- shift `x = y + t`, then compare densities
  have hshift : ∀ t : E, ∫⁻ x, (Metric.ball (0 : E) S).indicator (fun _ => (1 : ℝ≥0∞)) x *
        gaussDensity x * ENNReal.ofReal (G (x - t) ^ 2)
      = ∫⁻ y, (Metric.ball (0 : E) S).indicator (fun _ => (1 : ℝ≥0∞)) (y + t) *
          gaussDensity (y + t) * ENNReal.ofReal (G y ^ 2) := by
    intro t
    rw [← lintegral_add_right_eq_self (fun x => (Metric.ball (0 : E) S).indicator
      (fun _ => (1 : ℝ≥0∞)) x * gaussDensity x * ENNReal.ofReal (G (x - t) ^ 2)) t]
    simp only [add_sub_cancel_right]
  simp_rw [hshift]
  have hbound : ∀ t y : E, ENNReal.ofReal (φ.normed volume t) *
        ((Metric.ball (0 : E) S).indicator (fun _ => (1 : ℝ≥0∞)) (y + t) * gaussDensity (y + t) *
          ENNReal.ofReal (G y ^ 2))
      ≤ ENNReal.ofReal (φ.normed volume t) *
          (ENNReal.ofReal (Real.exp c) * gaussDensity y * ENNReal.ofReal (G y ^ 2)) := by
    intro t y
    by_cases ht : φ.rOut ≤ ‖t‖
    · rw [normed_eq_zero_of_le ht, ENNReal.ofReal_zero, zero_mul, zero_mul]
    · push_neg at ht
      refine mul_le_mul' le_rfl (mul_le_mul' ?_ le_rfl)
      by_cases hy : y + t ∈ Metric.ball (0 : E) S
      · rw [Set.indicator_of_mem hy, one_mul]
        rw [Metric.mem_ball, dist_zero_right] at hy
        have hy' : ‖y‖ < S + φ.rOut := by
          have := norm_sub_le (y + t) t; rw [add_sub_cancel_right] at this; linarith
        refine (gaussDensity_add_le y t).trans (mul_le_mul' (ENNReal.ofReal_le_ofReal
          (Real.exp_le_exp.mpr ?_)) le_rfl)
        rw [hc]
        have := norm_nonneg y
        have := norm_nonneg t
        nlinarith
      · rw [Set.indicator_of_notMem hy, zero_mul]; exact (zero_le : (0 : ℝ≥0∞) ≤ _)
  calc ((gaussRaw E) Set.univ)⁻¹ * ∫⁻ t, ENNReal.ofReal (φ.normed volume t) *
        ∫⁻ y, (Metric.ball (0 : E) S).indicator (fun _ => (1 : ℝ≥0∞)) (y + t) *
          gaussDensity (y + t) * ENNReal.ofReal (G y ^ 2)
      ≤ ((gaussRaw E) Set.univ)⁻¹ * ∫⁻ t, ENNReal.ofReal (φ.normed volume t) *
          ∫⁻ y, ENNReal.ofReal (Real.exp c) * gaussDensity y * ENNReal.ofReal (G y ^ 2) := by
        refine mul_le_mul' le_rfl (lintegral_mono fun t => ?_)
        have hmC : Measurable fun y : E =>
            (Metric.ball (0 : E) S).indicator (fun _ => (1 : ℝ≥0∞)) (y + t) * gaussDensity (y + t) *
              ENNReal.ofReal (G y ^ 2) :=
          (((measurable_const.indicator measurableSet_ball).comp (measurable_id.add_const t)).mul
            (measurable_gaussDensity.comp (measurable_id.add_const t))).mul
            (hGm.pow_const 2).ennreal_ofReal
        have hmD : Measurable fun y : E =>
            ENNReal.ofReal (Real.exp c) * gaussDensity y * ENNReal.ofReal (G y ^ 2) :=
          (measurable_const.mul measurable_gaussDensity).mul (hGm.pow_const 2).ennreal_ofReal
        rw [← lintegral_const_mul _ hmC, ← lintegral_const_mul _ hmD]
        exact lintegral_mono fun y => hbound t y
    _ = ENNReal.ofReal (Real.exp c) * ∫⁻ x, ENNReal.ofReal (G x ^ 2) ∂(gaussianE E) := by
        have hmE : Measurable fun y : E => gaussDensity y * ENNReal.ofReal (G y ^ 2) :=
          measurable_gaussDensity.mul (hGm.pow_const 2).ennreal_ofReal
        have e1 : ∫⁻ y, ENNReal.ofReal (Real.exp c) * gaussDensity y * ENNReal.ofReal (G y ^ 2)
            = ENNReal.ofReal (Real.exp c) * ∫⁻ y, gaussDensity y * ENNReal.ofReal (G y ^ 2) := by
          rw [← lintegral_const_mul _ hmE]
          refine lintegral_congr fun y => ?_; ring
        rw [e1, lintegral_mul_const _ hφm.ennreal_ofReal, ← ofReal_integral_eq_lintegral_ofReal
            φ.integrable_normed (Filter.Eventually.of_forall (φ.nonneg_normed (μ := volume))),
          φ.integral_normed, ENNReal.ofReal_one, one_mul,
          lintegral_gaussianE_eq (hGm.pow_const 2).ennreal_ofReal]
        have : ∀ x, gaussDensity x * ENNReal.ofReal (G x ^ 2)
            = ENNReal.ofReal (G x ^ 2) * gaussDensity x := fun x => mul_comm _ _
        simp_rw [this]
        ring

/-- The bump of outer radius `ε`. -/
noncomputable def bump (ε : ℝ) (hε : 0 < ε) : ContDiffBump (0 : E) :=
  ⟨ε / 2, ε, by positivity, by linarith⟩

theorem bump_rOut {ε : ℝ} (hε : 0 < ε) : (bump (E := E) ε hε).rOut = ε := rfl

theorem locallyIntegrable_of_bounded {g : E → ℝ} (hgm : Measurable g) {M : ℝ}
    (hM : ∀ x, |g x| ≤ M) : LocallyIntegrable g volume :=
  locallyIntegrable_iff.mpr fun k hk => Measure.integrableOn_of_bounded hk.measure_lt_top.ne
    hgm.aestronglyMeasurable (Filter.Eventually.of_forall fun x => by
      rw [Real.norm_eq_abs]; exact hM x)

/-- **Stage 1: Poincaré for a bounded, compactly supported function with a two-point bound off
the origin**, `Var g ≤ 4 ∫ G²`, by mollification. -/
theorem variance_le_of_twoPoint_compact (hd : 2 ≤ Module.finrank ℝ E) {g G : E → ℝ}
    (hgm : Measurable g) (hgc : ContinuousOn g {x | x ≠ 0}) {M : ℝ} (hM : ∀ x, |g x| ≤ M)
    {R : ℝ} (hR0 : 0 ≤ R) (hR : ∀ x, R < ‖x‖ → g x = 0) (hGm : Measurable G) (hG0 : ∀ x, 0 ≤ G x)
    (hint : Integrable (fun x => G x ^ 2) (gaussianE E))
    (h : ∀ x y, x ≠ 0 → y ≠ 0 → |g x - g y| ≤ ‖x - y‖ * (G x + G y)) :
    variance g (gaussianE E) ≤ 4 * ∫ x, G x ^ 2 ∂(gaussianE E) := by
  have hg : LocallyIntegrable g volume := locallyIntegrable_of_bounded hgm hM
  have hG : LocallyIntegrable G volume := locallyIntegrable_of_gauss hGm hint
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  set I := ∫ x, G x ^ 2 ∂(gaussianE E) with hI
  have hI0 : 0 ≤ I := integral_nonneg fun x => sq_nonneg _
  -- the mollified variance bound, for `ε ∈ (0, 1]`
  have hvar : ∀ ε : ℝ, ∀ hε : 0 < ε, ε ≤ 1 →
      variance (moll (bump ε hε) g) (gaussianE E)
        ≤ 4 * (Real.exp ((R + 2 + ε) * ε) * I) := by
    intro ε hε hε1
    refine (variance_moll_le hd (bump ε hε) hg hM hR hG hG0 h).trans ?_
    refine mul_le_mul_of_nonneg_left ?_ (by norm_num)
    have hcont : Continuous (moll (bump ε hε) G) := continuous_moll _ hG
    have hmono : ∫ x, (Metric.ball (0 : E) (R + (bump (E := E) ε hε).rOut + 1)).indicator
          (fun x => moll (bump ε hε) G x ^ 2) x ∂(gaussianE E)
        ≤ ∫ x, (Metric.ball (0 : E) (R + 2)).indicator
          (fun x => moll (bump ε hε) G x ^ 2) x ∂(gaussianE E) := by
      have hint2 : Integrable ((Metric.ball (0 : E) (R + 2)).indicator
          (fun x => moll (bump ε hε) G x ^ 2)) (gaussianE E) := by
        rw [integrable_indicator_iff measurableSet_ball]
        exact ((hcont.pow 2).continuousOn.integrableOn_compact (isCompact_closedBall _ _)).mono_set
          Metric.ball_subset_closedBall
      refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun x =>
        Set.indicator_nonneg (fun _ _ => sq_nonneg _) _) hint2
        (Filter.Eventually.of_forall fun x => ?_)
      have hsub : Metric.ball (0 : E) (R + (bump ε hε).rOut + 1) ⊆ Metric.ball (0 : E) (R + 2) :=
        Metric.ball_subset_ball (by rw [bump_rOut (E := E)]; linarith)
      by_cases hx : x ∈ Metric.ball (0 : E) (R + (bump (E := E) ε hε).rOut + 1)
      · rw [Set.indicator_of_mem hx, Set.indicator_of_mem (hsub hx)]
      · rw [Set.indicator_of_notMem hx]
        exact Set.indicator_nonneg (fun _ _ => sq_nonneg _) _
    refine hmono.trans ?_
    have := integral_indicator_moll_sq_le (bump ε hε) hGm hG0 hint (S := R + 2) (by linarith)
    rw [bump_rOut (E := E)] at this
    exact this
  -- closeness in `L²`: `∫ (g − moll g)² → 0`
  have hclose : Tendsto (fun ε : ℝ => if hε : 0 < ε then
      ∫ x, (g x - moll (bump ε hε) g x) ^ 2 ∂(gaussianE E) else 0) (𝓝[>] 0) (𝓝 0) := by
    have key : Tendsto (fun ε : ℝ => ∫ x, (if hε : 0 < ε then
        (g x - moll (bump ε hε) g x) ^ 2 else 0) ∂(gaussianE E)) (𝓝[>] 0) (𝓝 (∫ _, (0 : ℝ) ∂(gaussianE E))) := by
      refine tendsto_integral_filter_of_dominated_convergence (fun _ => (2 * M) ^ 2) ?_ ?_
        (integrable_const _) ?_
      · refine Filter.Eventually.of_forall fun ε => ?_
        by_cases hε : 0 < ε
        · simp only [hε, dite_true]
          exact Measurable.aestronglyMeasurable
            ((hgm.sub (continuous_moll (bump ε hε) hg).measurable).pow_const 2)
        · simp only [hε, dite_false]; exact aestronglyMeasurable_const
      · refine Filter.Eventually.of_forall fun ε => Filter.Eventually.of_forall fun x => ?_
        by_cases hε : 0 < ε
        · simp only [hε, dite_true]
          rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
          have h1 := hM x
          have h2 := abs_moll_le (bump ε hε) hg hM x
          have : |g x - moll (bump ε hε) g x| ≤ 2 * M := by
            calc |g x - moll (bump ε hε) g x| ≤ |g x| + |moll (bump ε hε) g x| := abs_sub _ _
              _ ≤ 2 * M := by linarith
          calc (g x - moll (bump ε hε) g x) ^ 2 = |g x - moll (bump ε hε) g x| ^ 2 := (sq_abs _).symm
            _ ≤ (2 * M) ^ 2 := pow_le_pow_left₀ (abs_nonneg _) this 2
        · simp only [hε, dite_false]; rw [norm_zero]; positivity
      · filter_upwards [gaussianE_ae_ne_zero (E := E)] with x hx
        have hten : Tendsto (fun ε : ℝ => if hε : 0 < ε then moll (bump ε hε) g x else g x)
            (𝓝[>] 0) (𝓝 (g x)) := by
          -- on `𝓝[>] 0` the branch is the mollification, which converges by continuity at `x`
          have hcv := ContDiffBump.convolution_tendsto_right (μ := (volume : Measure E))
            (φ := fun ε : ℝ => if hε : 0 < ε then bump ε hε else bump 1 one_pos)
            (g := fun _ => g) (k := fun _ => x) (x₀ := x) (z₀ := g x) (l := 𝓝[>] 0) ?_ ?_ ?_ tendsto_const_nhds
          · refine hcv.congr' ?_
            filter_upwards [self_mem_nhdsWithin] with ε (hε : 0 < ε)
            simp only [hε, dite_true]; rfl
          · have : Tendsto (fun ε : ℝ => ε) (𝓝[>] 0) (𝓝 0) :=
              tendsto_nhdsWithin_of_tendsto_nhds tendsto_id
            refine this.congr' ?_
            filter_upwards [self_mem_nhdsWithin] with ε (hε : 0 < ε)
            simp only [hε, dite_true]; rfl
          · exact Filter.Eventually.of_forall fun _ => hgm.aestronglyMeasurable
          · have hc : ContinuousAt g x := hgc.continuousAt (isOpen_ne.mem_nhds hx)
            exact hc.tendsto.comp tendsto_snd
        have := (tendsto_const_nhds (x := g x)).sub hten
        rw [sub_self] at this
        have := this.pow 2
        rw [zero_pow two_ne_zero] at this
        refine this.congr' ?_
        filter_upwards [self_mem_nhdsWithin] with ε (hε : 0 < ε)
        simp only [hε, dite_true]
    rw [integral_zero] at key
    refine key.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with ε (hε : 0 < ε)
    simp only [hε, dite_true]
  -- the comparison, then `ε → 0`, then `η → 0`
  have hlim : ∀ η : ℝ, 0 < η → variance g (gaussianE E) ≤ (1 + η) * (4 * I) := by
    intro η hη
    have hF : Tendsto (fun ε : ℝ => (1 + η) * (4 * (Real.exp ((R + 2 + ε) * ε) * I))
        + (1 + 1 / η) * (if hε : 0 < ε then
            ∫ x, (g x - moll (bump ε hε) g x) ^ 2 ∂(gaussianE E) else 0)) (𝓝[>] 0)
        (𝓝 ((1 + η) * (4 * (Real.exp ((R + 2 + 0) * 0) * I)) + (1 + 1 / η) * 0)) := by
      refine Tendsto.add (tendsto_const_nhds.mul ((Continuous.tendsto (by fun_prop) 0 |>.mono_left
        nhdsWithin_le_nhds).const_mul 4)) (hclose.const_mul _)
    simp only [mul_zero, Real.exp_zero, one_mul, add_zero] at hF
    refine ge_of_tendsto hF ?_
    filter_upwards [Ioc_mem_nhdsGT (zero_lt_one' ℝ)] with ε hε
    simp only [hε.1, dite_true]
    have h3 := variance_le_of_close (μ := gaussianE E) hgm (continuous_moll (bump ε hε.1) hg).measurable
      hM (abs_moll_le (bump ε hε.1) hg hM) hη
    have h4 := hvar ε hε.1 hε.2
    calc variance g (gaussianE E) ≤ _ := h3
      _ ≤ _ := add_le_add (mul_le_mul_of_nonneg_left h4 (by linarith)) le_rfl
  have hcont2 : Continuous fun η : ℝ => (1 + η) * (4 * I) := by fun_prop
  have htend2 := hcont2.tendsto 0
  simp only [add_zero, one_mul] at htend2
  refine ge_of_tendsto (tendsto_nhdsWithin_of_tendsto_nhds (s := Set.Ioi 0) htend2) ?_
  filter_upwards [self_mem_nhdsWithin] with η hη
  exact hlim η hη

end Mollify

section VarianceCompareLp

variable {X : Type*} [MeasurableSpace X] {μ : Measure X} [IsProbabilityMeasure μ]

/-- `Var f ≤ (1 + η) Var g + (1 + 1/η) E(f − g)²` for `f, g ∈ L²`. -/
theorem variance_le_of_close' {f g : X → ℝ} (hfmem : MemLp f 2 μ) (hgmem : MemLp g 2 μ) {η : ℝ}
    (hη : 0 < η) :
    variance f μ ≤ (1 + η) * variance g μ + (1 + 1 / η) * ∫ x, (f x - g x) ^ 2 ∂μ := by
  have hbound : ∀ x, (f x - ∫ y, g y ∂μ) ^ 2
      ≤ (1 + η) * (g x - ∫ y, g y ∂μ) ^ 2 + (1 + 1 / η) * (f x - g x) ^ 2 := by
    intro x
    have key : ∀ a b : ℝ, (a + b) ^ 2 ≤ (1 + η) * a ^ 2 + (1 + 1 / η) * b ^ 2 := by
      intro a b
      have h0 : 0 ≤ (η * a - b) ^ 2 / η := div_nonneg (sq_nonneg _) hη.le
      have e : (η * a - b) ^ 2 / η = η * a ^ 2 - 2 * a * b + b ^ 2 / η := by
        field_simp; ring
      rw [e] at h0
      have e2 : (1 + 1 / η) * b ^ 2 = b ^ 2 + b ^ 2 / η := by ring
      rw [e2]
      nlinarith [h0]
    have := key (g x - ∫ y, g y ∂μ) (f x - g x)
    rwa [show g x - ∫ y, g y ∂μ + (f x - g x) = f x - ∫ y, g y ∂μ by ring] at this
  -- `Var f ≤ E(f − a)²` for every `a`
  have hvar : variance f μ ≤ ∫ x, (f x - ∫ y, g y ∂μ) ^ 2 ∂μ := by
    set a := ∫ y, g y ∂μ
    have hfi : Integrable f μ := hfmem.integrable one_le_two
    have hf2 : Integrable (fun x => f x ^ 2) μ := hfmem.integrable_sq
    rw [variance_eq_sub hfmem]
    have h1 : ∫ x, (f x - a) ^ 2 ∂μ = ∫ x, f x ^ 2 ∂μ - 2 * a * ∫ x, f x ∂μ + a ^ 2 := by
      have : (fun x => (f x - a) ^ 2) = fun x => f x ^ 2 - 2 * a * f x + a ^ 2 := by
        funext x; ring
      have hB : Integrable (fun x => 2 * a * f x) μ := hfi.const_mul _
      have hA : Integrable (fun x => f x ^ 2 - 2 * a * f x) μ := hf2.sub hB
      rw [this, integral_add hA (integrable_const _), integral_sub hf2 hB, integral_const_mul,
        integral_const, measureReal_def, measure_univ, ENNReal.toReal_one, one_smul]
    rw [h1]
    have : ∫ x, (f ^ 2) x ∂μ = ∫ x, f x ^ 2 ∂μ := rfl
    rw [this]
    nlinarith [sq_nonneg ((∫ x, f x ∂μ) - a)]
  refine hvar.trans ?_
  have hgi : Integrable (fun x => (g x - ∫ y, g y ∂μ) ^ 2) μ :=
    (hgmem.sub (memLp_const _)).integrable_sq
  have hfgi : Integrable (fun x => (f x - g x) ^ 2) μ := (hfmem.sub hgmem).integrable_sq
  calc ∫ x, (f x - ∫ y, g y ∂μ) ^ 2 ∂μ
      ≤ ∫ x, ((1 + η) * (g x - ∫ y, g y ∂μ) ^ 2 + (1 + 1 / η) * (f x - g x) ^ 2) ∂μ :=
        integral_mono ((hfmem.sub (memLp_const _)).integrable_sq)
          ((hgi.const_mul _).add (hfgi.const_mul _)) hbound
    _ = (1 + η) * variance g μ + (1 + 1 / η) * ∫ x, (f x - g x) ^ 2 ∂μ := by
        rw [integral_add (hgi.const_mul _) (hfgi.const_mul _), integral_const_mul,
          integral_const_mul, variance_eq_integral hgmem.aestronglyMeasurable.aemeasurable]

end VarianceCompareLp

section GaussPoincareGeneral

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

/-- A two-point bound with a slope continuous off the origin makes `f` continuous off the
origin. -/
theorem continuousOn_of_twoPoint {f G : E → ℝ} (hG : ContinuousOn G {x | x ≠ 0})
    (h : ∀ x y, x ≠ 0 → y ≠ 0 → |f x - f y| ≤ ‖x - y‖ * (G x + G y)) :
    ContinuousOn f {x | x ≠ 0} := by
  intro x hx
  have hx' : x ≠ 0 := hx
  have hGx : ContinuousAt G x := hG.continuousAt (isOpen_ne.mem_nhds hx')
  have hev : ∀ᶠ y in 𝓝 x, G y < G x + 1 := hGx (Iio_mem_nhds (by linarith))
  obtain ⟨r, hr, hball⟩ := Metric.eventually_nhds_iff.mp (hev.and (isOpen_ne.mem_nhds hx'))
  refine (continuousAt_of_locally_lipschitz (K := 2 * G x + 1) hr fun y hy => ?_).continuousWithinAt
  obtain ⟨h1, h2⟩ := hball hy
  rw [Real.dist_eq, dist_eq_norm]
  calc |f y - f x| ≤ ‖y - x‖ * (G y + G x) := h y x h2 hx'
    _ ≤ (2 * G x + 1) * ‖y - x‖ := by
        rw [mul_comm]; exact mul_le_mul_of_nonneg_right (by linarith) (norm_nonneg _)

theorem measurable_of_twoPoint {f G : E → ℝ} (hG : ContinuousOn G {x | x ≠ 0})
    (h : ∀ x y, x ≠ 0 → y ≠ 0 → |f x - f y| ≤ ‖x - y‖ * (G x + G y)) : Measurable f :=
  measurable_of_continuousOn_compl_singleton 0 (continuousOn_of_twoPoint hG h)

/-- Truncation at level `M`. -/
noncomputable def clampF (M : ℝ) (f : E → ℝ) (x : E) : ℝ := max (-M) (min (f x) M)

theorem abs_clampF_le {M : ℝ} (hM : 0 ≤ M) (f : E → ℝ) (x : E) : |clampF M f x| ≤ M := by
  unfold clampF
  rw [abs_le]
  constructor
  · exact le_max_left _ _
  · exact max_le (by linarith) (min_le_right _ _)

theorem abs_clampF_le_abs {M : ℝ} (hM : 0 ≤ M) (f : E → ℝ) (x : E) :
    |clampF M f x| ≤ |f x| := by
  unfold clampF
  rcases le_or_gt (f x) (-M) with h1 | h1
  · rw [min_eq_left (by linarith), max_eq_left (by linarith)]
    rw [abs_of_nonpos (by linarith), abs_of_nonpos (by linarith)]; linarith
  · rcases le_or_gt M (f x) with h2 | h2
    · rw [min_eq_right h2, max_eq_right (by linarith), abs_of_nonneg hM, abs_of_nonneg (by linarith)]
      exact h2
    · rw [min_eq_left h2.le, max_eq_right h1.le]

theorem clampF_eq_of_abs_le {M : ℝ} (f : E → ℝ) (x : E) (h : |f x| ≤ M) : clampF M f x = f x := by
  unfold clampF
  rw [abs_le] at h
  rw [min_eq_left h.2, max_eq_right h.1]

theorem abs_clampF_sub_le (M : ℝ) (f : E → ℝ) (x y : E) :
    |clampF M f x - clampF M f y| ≤ |f x - f y| := by
  have hlip : LipschitzWith 1 (fun s : ℝ => max (-M) (min s M)) :=
    (LipschitzWith.id.min_const M).const_max (-M)
  have := hlip.dist_le_mul (f x) (f y)
  simpa [Real.dist_eq, clampF] using this

theorem continuousOn_clampF {M : ℝ} {f : E → ℝ} {s : Set E} (hf : ContinuousOn f s) :
    ContinuousOn (clampF M f) s :=
  ContinuousOn.sup continuousOn_const (hf.inf continuousOn_const)

theorem measurable_clampF {M : ℝ} {f : E → ℝ} (hf : Measurable f) : Measurable (clampF M f) :=
  measurable_const.max (hf.min measurable_const)

/-- The truncated function cut off at infinity: `(1 − χ_R) · f_M`. -/
noncomputable def cutF (R M : ℝ) (f : E → ℝ) (x : E) : ℝ := (1 - cutoff R x) * clampF M f x

theorem abs_cutF_le {R M : ℝ} (hM : 0 ≤ M) (f : E → ℝ) (x : E) : |cutF R M f x| ≤ M := by
  unfold cutF
  rw [abs_mul, abs_of_nonneg (by linarith [cutoff_le_one R x])]
  calc (1 - cutoff R x) * |clampF M f x| ≤ 1 * M :=
        mul_le_mul (by linarith [cutoff_nonneg R x]) (abs_clampF_le hM f x) (abs_nonneg _) zero_le_one
    _ = M := one_mul _

theorem cutF_eq_zero {R M : ℝ} (hR : 0 < R) (f : E → ℝ) {x : E} (hx : Real.sqrt 2 * R < ‖x‖) :
    cutF R M f x = 0 := by
  unfold cutF
  rw [cutoff_eq_one hR (by
    have h2 : (Real.sqrt 2 * R) ^ 2 = 2 * R ^ 2 := by
      rw [mul_pow, Real.sq_sqrt zero_le_two]
    have := pow_le_pow_left₀ (mul_nonneg (Real.sqrt_nonneg 2) hR.le) hx.le 2
    linarith), sub_self, zero_mul]

theorem measurable_cutF {R M : ℝ} (hR : 0 < R) {f : E → ℝ} (hf : Measurable f) :
    Measurable (cutF R M f) :=
  (measurable_const.sub (contDiff_cutoff hR).continuous.measurable).mul (measurable_clampF hf)

theorem continuousOn_cutF {R M : ℝ} (hR : 0 < R) {f : E → ℝ} (hf : ContinuousOn f {x | x ≠ 0}) :
    ContinuousOn (cutF R M f) {x | x ≠ 0} :=
  (continuousOn_const.sub (contDiff_cutoff hR).continuous.continuousOn).mul (continuousOn_clampF hf)

/-- The two-point bound for the truncated, cut-off function: the slope grows by `Cc M/(2R)`. -/
theorem abs_cutF_sub_le {R M : ℝ} (hR : 0 < R) (hM : 0 ≤ M) {Cc : ℝ}
    (hCc : ∀ δ : ℝ, 0 < δ → ∀ z : E, ‖fderiv ℝ (cutoff δ) z‖ ≤ Cc / δ) {f G : E → ℝ}
    (h : ∀ x y, x ≠ 0 → y ≠ 0 → |f x - f y| ≤ ‖x - y‖ * (G x + G y)) {x y : E} (hx : x ≠ 0)
    (hy : y ≠ 0) :
    |cutF R M f x - cutF R M f y|
      ≤ ‖x - y‖ * ((G x + Cc * M / (2 * R)) + (G y + Cc * M / (2 * R))) := by
  have hCc0 : 0 ≤ Cc := by
    have := (norm_nonneg _).trans (hCc 1 one_pos 0); simpa using this
  have hlip : LipschitzWith (Real.toNNReal (Cc / R)) (cutoff (E := E) R) :=
    lipschitzWith_of_nnnorm_fderiv_le (fun z => (contDiff_cutoff hR).differentiable one_ne_zero z)
      fun z => by
        rw [← NNReal.coe_le_coe, coe_nnnorm, Real.coe_toNNReal _ (div_nonneg hCc0 hR.le)]
        exact hCc R hR z
  have hdist := hlip.dist_le_mul x y
  rw [Real.dist_eq, dist_eq_norm, Real.coe_toNNReal _ (div_nonneg hCc0 hR.le)] at hdist
  have hc0 := cutoff_nonneg R x
  have hc1 := cutoff_le_one R x
  have hb := abs_clampF_le hM f y
  have hab := (abs_clampF_sub_le M f x y).trans (h x y hx hy)
  have hsplit : cutF R M f x - cutF R M f y
      = (1 - cutoff R x) * (clampF M f x - clampF M f y)
        + (cutoff R y - cutoff R x) * clampF M f y := by
    unfold cutF; ring
  rw [hsplit]
  calc |(1 - cutoff R x) * (clampF M f x - clampF M f y)
        + (cutoff R y - cutoff R x) * clampF M f y|
      ≤ |(1 - cutoff R x) * (clampF M f x - clampF M f y)|
        + |(cutoff R y - cutoff R x) * clampF M f y| := abs_add_le _ _
    _ ≤ 1 * (‖x - y‖ * (G x + G y)) + (Cc / R * ‖x - y‖) * M := by
        rw [abs_mul, abs_mul, abs_of_nonneg (by linarith), abs_sub_comm (cutoff R y)]
        exact add_le_add (mul_le_mul (by linarith) hab (abs_nonneg _) zero_le_one)
          (mul_le_mul hdist hb (abs_nonneg _) (mul_nonneg (div_nonneg hCc0 hR.le) (norm_nonneg _)))
    _ = ‖x - y‖ * ((G x + Cc * M / (2 * R)) + (G y + Cc * M / (2 * R))) := by
        field_simp; ring

theorem integral_normSq_gaussianE :
    ∫ x, ‖x‖ ^ 2 ∂(gaussianE E) = (Module.finrank ℝ E : ℝ) := by
  rw [integral_eq_lintegral_of_nonneg_ae (Filter.Eventually.of_forall fun x => sq_nonneg _)
    (measurable_norm.pow_const 2).aestronglyMeasurable, lintegral_normSq_gaussianE,
    ENNReal.toReal_natCast]

theorem integrable_normSq_gaussianE : Integrable (fun x : E => ‖x‖ ^ 2) (gaussianE E) := by
  refine ⟨(measurable_norm.pow_const 2).aestronglyMeasurable, ?_⟩
  rw [hasFiniteIntegral_iff_ofReal (Filter.Eventually.of_forall fun x => sq_nonneg _),
    lintegral_normSq_gaussianE]
  exact ENNReal.natCast_lt_top _

theorem cutoff_sq_le {R : ℝ} (hR : 0 < R) (x : E) : cutoff R x ^ 2 ≤ ‖x‖ ^ 2 / R ^ 2 := by
  rcases le_or_gt ‖x‖ R with hx | hx
  · rw [cutoff_eq_zero hR hx, zero_pow two_ne_zero]; positivity
  · have h1 := cutoff_le_one R x
    have h0 := cutoff_nonneg R x
    calc cutoff R x ^ 2 ≤ 1 := by nlinarith
      _ ≤ ‖x‖ ^ 2 / R ^ 2 := by
          rw [le_div_iff₀ (by positivity)]; nlinarith

/-- **Stage 2: Poincaré for the truncation of a function with a two-point bound off the
origin.**  The cutoff at infinity costs `Cc M/(2R)` in the slope and `M² d/R²` in `L²`, both
vanishing as `R → ∞`. -/
theorem variance_clampF_le (hd : 2 ≤ Module.finrank ℝ E) {f G : E → ℝ}
    (hG : ContinuousOn G {x | x ≠ 0}) (hG0 : ∀ x, 0 ≤ G x)
    (hint : Integrable (fun x => G x ^ 2) (gaussianE E))
    (h : ∀ x y, x ≠ 0 → y ≠ 0 → |f x - f y| ≤ ‖x - y‖ * (G x + G y)) {M : ℝ} (hM : 0 ≤ M) :
    variance (clampF M f) (gaussianE E) ≤ 4 * ∫ x, G x ^ 2 ∂(gaussianE E) := by
  obtain ⟨Cc, hCc0, hCc⟩ := exists_bound_fderiv_cutoff (E := E)
  have hfc := continuousOn_of_twoPoint hG h
  have hfm := measurable_of_twoPoint hG h
  have hGm : Measurable G := measurable_of_continuousOn_compl_singleton 0 hG
  set I := ∫ x, G x ^ 2 ∂(gaussianE E) with hI
  have hI0 : 0 ≤ I := integral_nonneg fun x => sq_nonneg _
  have hGint : Integrable G (gaussianE E) :=
    ((memLp_two_iff_integrable_sq hGm.aestronglyMeasurable).mpr hint).integrable one_le_two
  set J := ∫ x, G x ∂(gaussianE E) with hJ
  set d : ℝ := (Module.finrank ℝ E : ℝ) with hd_def
  have hdint := integral_normSq_gaussianE (E := E)
  have hbound : ∀ η : ℝ, 0 < η → ∀ R : ℝ, 1 ≤ R →
      variance (clampF M f) (gaussianE E)
        ≤ (1 + η) * (4 * (I + 2 * (Cc * M / (2 * R)) * J + (Cc * M / (2 * R)) ^ 2))
          + (1 + 1 / η) * (M ^ 2 * d / R ^ 2) := by
    intro η hη R hR1
    have hR : 0 < R := by linarith
    set c := Cc * M / (2 * R) with hc
    have hc0 : 0 ≤ c := by positivity
    have hGc : Integrable (fun x => (G x + c) ^ 2) (gaussianE E) := by
      have : (fun x => (G x + c) ^ 2) = fun x => G x ^ 2 + (2 * c) * G x + c ^ 2 := by
        funext x; ring
      rw [this]
      exact (hint.add (hGint.const_mul _)).add (integrable_const _)
    have hGcI : ∫ x, (G x + c) ^ 2 ∂(gaussianE E) = I + 2 * c * J + c ^ 2 := by
      have : (fun x => (G x + c) ^ 2) = fun x => G x ^ 2 + (2 * c) * G x + c ^ 2 := by
        funext x; ring
      have hA : Integrable (fun x => G x ^ 2 + 2 * c * G x) (gaussianE E) :=
        hint.add (hGint.const_mul _)
      have hB : Integrable (fun x => 2 * c * G x) (gaussianE E) := hGint.const_mul _
      rw [this, integral_add hA (integrable_const _), integral_add hint hB, integral_const_mul,
        integral_const, measureReal_def, measure_univ, ENNReal.toReal_one, one_smul]
    have h1 := variance_le_of_twoPoint_compact hd (g := cutF R M f) (G := fun x => G x + c)
      (measurable_cutF hR hfm) (continuousOn_cutF hR hfc) (abs_cutF_le hM f)
      (R := Real.sqrt 2 * R) (mul_nonneg (Real.sqrt_nonneg 2) hR.le)
      (fun x hx => cutF_eq_zero hR f hx)
      (hGm.add_const c) (fun x => add_nonneg (hG0 x) hc0) hGc
      (fun x y hx hy => abs_cutF_sub_le hR hM hCc h hx hy)
    rw [hGcI] at h1
    have h2 : ∫ x, (clampF M f x - cutF R M f x) ^ 2 ∂(gaussianE E) ≤ M ^ 2 * d / R ^ 2 := by
      have hpt : ∀ x, (clampF M f x - cutF R M f x) ^ 2 ≤ M ^ 2 / R ^ 2 * ‖x‖ ^ 2 := by
        intro x
        have e : clampF M f x - cutF R M f x = cutoff R x * clampF M f x := by
          unfold cutF; ring
        rw [e, mul_pow]
        have hb : clampF M f x ^ 2 ≤ M ^ 2 := by
          rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) (abs_clampF_le hM f x) 2
        calc cutoff R x ^ 2 * clampF M f x ^ 2 ≤ (‖x‖ ^ 2 / R ^ 2) * M ^ 2 :=
              mul_le_mul (cutoff_sq_le hR x) hb (sq_nonneg _) (by positivity)
          _ = M ^ 2 / R ^ 2 * ‖x‖ ^ 2 := by ring
      calc ∫ x, (clampF M f x - cutF R M f x) ^ 2 ∂(gaussianE E)
          ≤ ∫ x, M ^ 2 / R ^ 2 * ‖x‖ ^ 2 ∂(gaussianE E) :=
            integral_mono_of_nonneg (Filter.Eventually.of_forall fun x => sq_nonneg _)
              (integrable_normSq_gaussianE.const_mul _) (Filter.Eventually.of_forall hpt)
        _ = M ^ 2 * d / R ^ 2 := by rw [integral_const_mul, hdint]; ring
    have h3 := variance_le_of_close (μ := gaussianE E) (measurable_clampF hfm)
      (measurable_cutF hR hfm) (abs_clampF_le hM f) (abs_cutF_le hM f) hη
    calc variance (clampF M f) (gaussianE E) ≤ _ := h3
      _ ≤ _ := add_le_add (mul_le_mul_of_nonneg_left h1 (by linarith))
          (mul_le_mul_of_nonneg_left h2 (by positivity))
  have hlim : ∀ η : ℝ, 0 < η → variance (clampF M f) (gaussianE E) ≤ (1 + η) * (4 * I) := by
    intro η hη
    have hc : Tendsto (fun R : ℝ => Cc * M / (2 * R)) atTop (𝓝 0) := by
      have : (fun R : ℝ => Cc * M / (2 * R)) = fun R => (Cc * M / 2) / R := by
        funext R; ring
      rw [this]
      exact tendsto_const_nhds.div_atTop tendsto_id
    have hr : Tendsto (fun R : ℝ => M ^ 2 * d / R ^ 2) atTop (𝓝 0) :=
      tendsto_const_nhds.div_atTop (tendsto_pow_atTop two_ne_zero)
    have hF : Tendsto (fun R : ℝ => (1 + η) * (4 * (I + 2 * (Cc * M / (2 * R)) * J
        + (Cc * M / (2 * R)) ^ 2)) + (1 + 1 / η) * (M ^ 2 * d / R ^ 2)) atTop
        (𝓝 ((1 + η) * (4 * (I + 2 * 0 * J + 0 ^ 2)) + (1 + 1 / η) * 0)) :=
      (tendsto_const_nhds.mul ((tendsto_const_nhds.add ((tendsto_const_nhds.mul hc).mul
        tendsto_const_nhds)).add (hc.pow 2) |>.const_mul 4)).add (hr.const_mul _)
    simp only [mul_zero, zero_mul, add_zero, zero_pow two_ne_zero] at hF
    refine ge_of_tendsto hF ?_
    filter_upwards [Filter.eventually_ge_atTop (1 : ℝ)] with R hR
    exact hbound η hη R hR
  have hcont2 : Continuous fun η : ℝ => (1 + η) * (4 * I) := by fun_prop
  have htend2 := hcont2.tendsto 0
  simp only [add_zero, one_mul] at htend2
  refine ge_of_tendsto (tendsto_nhdsWithin_of_tendsto_nhds (s := Set.Ioi 0) htend2) ?_
  filter_upwards [self_mem_nhdsWithin] with η hη
  exact hlim η hη

/-- **The general two-point Gaussian Poincaré inequality**: `Var f ≤ 4 ∫ G²` for every `f ∈ L²`
with `|f x − f y| ≤ ‖x − y‖ (G x + G y)` off the origin, `G` continuous off the origin and
square-integrable. -/
theorem variance_le_of_twoPoint (hd : 2 ≤ Module.finrank ℝ E) {f G : E → ℝ}
    (hG : ContinuousOn G {x | x ≠ 0})
    (h : ∀ x y, x ≠ 0 → y ≠ 0 → |f x - f y| ≤ ‖x - y‖ * (G x + G y))
    (hf : MemLp f 2 (gaussianE E)) (hint : Integrable (fun x => G x ^ 2) (gaussianE E)) :
    variance f (gaussianE E) ≤ 4 * ∫ x, G x ^ 2 ∂(gaussianE E) := by
  -- replace `G` by `|G|`
  have hG' : ContinuousOn (fun x => |G x|) {x | x ≠ 0} := hG.abs
  have h' : ∀ x y, x ≠ 0 → y ≠ 0 → |f x - f y| ≤ ‖x - y‖ * (|G x| + |G y|) := fun x y hx hy =>
    (h x y hx hy).trans (mul_le_mul_of_nonneg_left (add_le_add (le_abs_self _) (le_abs_self _))
      (norm_nonneg _))
  have hint' : Integrable (fun x => |G x| ^ 2) (gaussianE E) := by simpa [sq_abs] using hint
  have hI : ∫ x, |G x| ^ 2 ∂(gaussianE E) = ∫ x, G x ^ 2 ∂(gaussianE E) := by simp [sq_abs]
  rw [← hI]
  set I := ∫ x, |G x| ^ 2 ∂(gaussianE E) with hIdef
  have hfm := measurable_of_twoPoint hG h
  have hf2 : Integrable (fun x => f x ^ 2) (gaussianE E) := hf.integrable_sq
  -- `L²` closeness of the truncations
  have hclose : Tendsto (fun n : ℕ => ∫ x, (f x - clampF n f x) ^ 2 ∂(gaussianE E)) atTop
      (𝓝 0) := by
    have := tendsto_integral_of_dominated_convergence (μ := gaussianE E)
      (F := fun n : ℕ => fun x => (f x - clampF n f x) ^ 2) (f := fun _ => (0 : ℝ))
      (bound := fun x => 4 * f x ^ 2)
      (fun n => ((hfm.sub (measurable_clampF hfm)).pow_const 2).aestronglyMeasurable)
      (hf2.const_mul 4) (fun n => Filter.Eventually.of_forall fun x => by
        rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
        have hb := abs_clampF_le_abs (Nat.cast_nonneg n) f x
        have : |f x - clampF n f x| ≤ 2 * |f x| := by
          calc |f x - clampF n f x| ≤ |f x| + |clampF n f x| := abs_sub _ _
            _ ≤ 2 * |f x| := by linarith
        calc (f x - clampF n f x) ^ 2 = |f x - clampF n f x| ^ 2 := (sq_abs _).symm
          _ ≤ (2 * |f x|) ^ 2 := pow_le_pow_left₀ (abs_nonneg _) this 2
          _ = 4 * f x ^ 2 := by rw [mul_pow, sq_abs]; ring)
      (Filter.Eventually.of_forall fun x => by
        refine tendsto_const_nhds.congr' ?_
        filter_upwards [Filter.eventually_ge_atTop ⌈|f x|⌉₊] with n hn
        rw [clampF_eq_of_abs_le _ _ ((Nat.le_ceil _).trans (by exact_mod_cast hn)), sub_self,
          zero_pow two_ne_zero])
    simpa using this
  have hlim : ∀ η : ℝ, 0 < η → variance f (gaussianE E) ≤ (1 + η) * (4 * I) := by
    intro η hη
    have hF : Tendsto (fun n : ℕ => (1 + η) * (4 * I)
        + (1 + 1 / η) * ∫ x, (f x - clampF n f x) ^ 2 ∂(gaussianE E)) atTop
        (𝓝 ((1 + η) * (4 * I) + (1 + 1 / η) * 0)) :=
      tendsto_const_nhds.add (hclose.const_mul _)
    rw [mul_zero, add_zero] at hF
    refine ge_of_tendsto hF (Filter.Eventually.of_forall fun n => ?_)
    have hmem : MemLp (clampF n f) 2 (gaussianE E) :=
      MemLp.of_bound (measurable_clampF hfm).aestronglyMeasurable n
        (Filter.Eventually.of_forall fun x => by
          rw [Real.norm_eq_abs]; exact abs_clampF_le (Nat.cast_nonneg n) f x)
    have h3 := variance_le_of_close' hf hmem hη
    have h4 := variance_clampF_le hd hG' (fun x => abs_nonneg _) hint' h' (M := n)
      (Nat.cast_nonneg n)
    calc variance f (gaussianE E) ≤ _ := h3
      _ ≤ _ := add_le_add (mul_le_mul_of_nonneg_left h4 (by linarith)) le_rfl
  have hcont2 : Continuous fun η : ℝ => (1 + η) * (4 * I) := by fun_prop
  have htend2 := hcont2.tendsto 0
  simp only [add_zero, one_mul] at htend2
  refine ge_of_tendsto (tendsto_nhdsWithin_of_tendsto_nhds (s := Set.Ioi 0) htend2) ?_
  filter_upwards [self_mem_nhdsWithin] with η hη
  exact hlim η hη

/-- **The Gaussian Poincaré inequality in the two-point form of §26, proved.** -/
theorem gaussPoincare_gaussianE : GaussPoincare (gaussianE E) := by
  refine ⟨fun hd f G hG h hf hint => ?_⟩
  refine (variance_le_of_twoPoint hd hG h hf hint).trans (le_of_eq ?_)
  rw [← integral_const_mul]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  ring

/-- The sphere Poincaré inequality of §25, now a theorem: constant `4/(d − 2)`. -/
theorem spherePoincare_sphereUniformAmbient (hd : 3 ≤ Module.finrank ℝ E) :
    SpherePoincare (sphereUniformAmbient E) (4 / ((Module.finrank ℝ E : ℝ) - 2)) :=
  spherePoincare_of_gaussPoincare hd gaussPoincare_gaussianE

end GaussPoincareGeneral

section StreamGeneral

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E] [FiniteDimensional ℝ E]
variable {G : Type*} [Group G] [MeasurableSpace G] [MulAction G E] [MeasurableSMul₂ G E]
  [MeasurableInv G] [MeasurableMul G]
variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
variable {ι : G → (E ≃ₗᵢ[ℝ] E)} {q : E → E} {W : Ω → E} {R : Ω → ℕ → G} {κ : Measure G}
  [κ.IsMulRightInvariant] {x₀ : E}

/-- **The concentration remark for an arbitrary bounded codebook, with no hypothesis**: §26's
`meas_not_decayWithin_le_gauss` with `GaussPoincare` discharged by §39. -/
theorem meas_not_decayWithin_le_general (hd : 3 ≤ Module.finrank ℝ E)
    (h : RotationStream ι q W R κ x₀ μ) (hx₀ : ‖x₀‖ = 1) {C : Set E} (hq : IsNearest C q)
    (hC : Bornology.IsBounded C) {ε : ℝ} (hε0 : 0 < ε) (hε1 : ε ≤ 1)
    (hρ : 0 < stageDistortion q (sphereUniformAmbient E)) (P : ℕ) :
    μ {ω | ¬ DecayWithin (rotScheme ι q (R ω)) (W ω)
        (Real.sqrt (stageDistortion q (sphereUniformAmbient E))) ε P}
      ≤ P * ENNReal.ofReal (16 / (((Module.finrank ℝ E : ℝ) - 2) * ε ^ 2 *
          stageDistortion q (sphereUniformAmbient E))) := by
  haveI : Nontrivial E := ⟨⟨x₀, 0, by rintro rfl; simp at hx₀⟩⟩
  exact meas_not_decayWithin_le_gauss hd gaussPoincare_gaussianE h hx₀ hq hC hε0 hε1 hρ P

end StreamGeneral
/-! ## §40  Theorem 1 for the deployed rotation, at the level of characteristic functions

Theorem 1 is false for `H D_ε`: the law of the direction is supported on `2^d` points.  What
survives is a quantitative Gaussian approximation of each coordinate, exact in its dependence
on the input.  The coordinate `(H D_ε v)ᵢ = ∑ⱼ aⱼ εⱼ` with `aⱼ = Hᵢⱼ vⱼ` is a Rademacher sum: its
odd moments vanish (`signAvg_radSum_odd_pow`) and its characteristic function factorises,
`E cos(t ∑ aⱼ εⱼ) = ∏ⱼ cos(t aⱼ)` (`signAvg_cos_radSum`).  Since `|cos x − e^{−x²/2}| ≤ x⁴/3`
for `|x| ≤ 1` (`abs_cos_sub_exp_le`) and products of numbers in `[−1, 1]` telescope
(`abs_prod_sub_prod_le`), the characteristic function of a coordinate of `H D_ε v` is within
`t⁴ ∑ⱼ vⱼ⁴/(3d²)` of the Gaussian `e^{−t²‖v‖²/(2d)}` for `|t| ≤ √d`
(`abs_signAvg_cos_coord_sub_exp_le`).  This is the same spikiness `∑ⱼ vⱼ⁴` that governs the
fourth-moment gap of §37: for a spread direction it is `O(1/d)` and the coordinate law is
Gaussian to order `t⁴/d³`; for a coordinate vector it is `1` and the bound is `t⁴/(3d²)`.
Passing from characteristic functions to Kolmogorov distance is Esseen's smoothing inequality,
which is not formalised here; and `f_d` itself is compared to the Gaussian only through its
moments (§5, §37).  The spikiness of real residual directions is measured in
`experiments/hadamard_spikiness.py`. -/

namespace Hadamard

open Orthogonal


/-! ### Symmetry: odd moments vanish -/

/-- Flipping every sign. -/
def flipAll {n : ℕ} : Signs n ≃ Signs n :=
  Function.Involutive.toPerm (fun s : Signs n => fun j => !s j) fun s => by
    funext j; simp

theorem radSum_flipAll {n : ℕ} (a : Fin n → ℝ) (s : Signs n) :
    radSum a (flipAll s) = -radSum a s := by
  unfold radSum
  rw [← Finset.sum_neg_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  show a j * sgn (!s j) = -(a j * sgn (s j))
  cases s j <;> simp [sgn]

theorem signAvg_odd {n : ℕ} (a : Fin n → ℝ) {F : ℝ → ℝ} (hF : ∀ x, F (-x) = -F x) :
    signAvg (fun s => F (radSum a s)) = 0 := by
  have h : ∑ s : Signs n, F (radSum a s) = -∑ s : Signs n, F (radSum a s) := by
    conv_lhs => rw [← Fintype.sum_equiv flipAll (fun s => F (radSum a (flipAll s)))
      (fun s => F (radSum a s)) (fun s => rfl)]
    rw [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun s _ => ?_
    rw [radSum_flipAll, hF]
  unfold signAvg
  have : ∑ s : Signs n, F (radSum a s) = 0 := by linarith
  rw [this, zero_div]

/-- **Odd moments of a Rademacher sum vanish.** -/
theorem signAvg_radSum_odd_pow {n : ℕ} (a : Fin n → ℝ) (k : ℕ) :
    signAvg (fun s => radSum a s ^ (2 * k + 1)) = 0 :=
  signAvg_odd a (F := fun x => x ^ (2 * k + 1)) fun x => by
    show (-x) ^ (2 * k + 1) = -x ^ (2 * k + 1)
    exact Odd.neg_pow ⟨k, rfl⟩ x

/-! ### The characteristic function factorises -/

/-- **The characteristic function of a Rademacher sum**: `E cos(t ∑ aⱼ εⱼ) = ∏ⱼ cos(t aⱼ)`. -/
theorem signAvg_cos_radSum {n : ℕ} (a : Fin n → ℝ) (t : ℝ) :
    signAvg (fun s => Real.cos (t * radSum a s)) = ∏ j, Real.cos (t * a j) := by
  induction n with
  | zero => simp [signAvg, radSum]
  | succ n ih =>
      unfold signAvg at ih ⊢
      rw [sum_signs_succ, Fin.prod_univ_succ]
      simp only [radSum_cons]
      rw [Fintype.sum_bool]
      simp only [sgn_true, sgn_false]
      have hcos : ∀ S : ℝ, Real.cos (t * (a 0 * 1 + S)) + Real.cos (t * (a 0 * -1 + S))
          = 2 * Real.cos (t * a 0) * Real.cos (t * S) := by
        intro S
        rw [show t * (a 0 * 1 + S) = t * a 0 + t * S by ring,
          show t * (a 0 * -1 + S) = t * S - t * a 0 by ring, Real.cos_add, Real.cos_sub]
        ring
      rw [← Finset.sum_add_distrib]
      simp_rw [hcos]
      have hprod : ∏ i : Fin n, Real.cos (t * a i.succ) = ∏ j, Real.cos (t * Fin.tail a j) := rfl
      rw [← Finset.mul_sum, hprod, ← ih (Fin.tail a), pow_succ]
      field_simp
      try ring

/-! ### Comparison with the Gaussian characteristic function -/

/-- `|cos x − e^{−x²/2}| ≤ x⁴/3` for `|x| ≤ 1`. -/
theorem abs_cos_sub_exp_le {x : ℝ} (hx : |x| ≤ 1) :
    |Real.cos x - Real.exp (-(x ^ 2) / 2)| ≤ x ^ 4 / 3 := by
  have h1 := Real.cos_bound hx
  have h2 : |Real.exp (-(x ^ 2) / 2) - 1 - (-(x ^ 2) / 2)| ≤ (-(x ^ 2) / 2) ^ 2 := by
    refine Real.abs_exp_sub_one_sub_id_le ?_
    rw [abs_le]
    have := sq_nonneg x
    have hx2 : x ^ 2 ≤ 1 := by
      have := abs_le.mp hx; nlinarith [abs_nonneg x, sq_abs x]
    constructor <;> nlinarith
  have hx4 : |x| ^ 4 = x ^ 4 := by
    rw [show (4 : ℕ) = 2 * 2 from rfl, pow_mul, pow_mul, sq_abs]
  rw [hx4] at h1
  calc |Real.cos x - Real.exp (-(x ^ 2) / 2)|
      = |(Real.cos x - (1 - x ^ 2 / 2)) - (Real.exp (-(x ^ 2) / 2) - 1 - (-(x ^ 2) / 2))| := by
        congr 1; ring
    _ ≤ |Real.cos x - (1 - x ^ 2 / 2)| + |Real.exp (-(x ^ 2) / 2) - 1 - (-(x ^ 2) / 2)| :=
        abs_sub _ _
    _ ≤ x ^ 4 * (5 / 96) + (-(x ^ 2) / 2) ^ 2 := add_le_add h1 h2
    _ ≤ x ^ 4 / 3 := by nlinarith [pow_nonneg (sq_nonneg x) 2]

/-- A telescoping bound: products of numbers in `[−1, 1]` differ by at most the sum of the
factor differences. -/
theorem abs_prod_sub_prod_le {ι : Type*} (s : Finset ι) (p q : ι → ℝ) (hp : ∀ i ∈ s, |p i| ≤ 1)
    (hq : ∀ i ∈ s, |q i| ≤ 1) :
    |∏ i ∈ s, p i - ∏ i ∈ s, q i| ≤ ∑ i ∈ s, |p i - q i| := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
      rw [Finset.prod_insert ha, Finset.prod_insert ha, Finset.sum_insert ha]
      have hp' := fun i hi => hp i (Finset.mem_insert_of_mem hi)
      have hq' := fun i hi => hq i (Finset.mem_insert_of_mem hi)
      have hP : |∏ i ∈ s, p i| ≤ 1 := by
        rw [Finset.abs_prod]
        exact Finset.prod_le_one (fun i _ => abs_nonneg _) fun i hi => hp' i hi
      have hqa : |q a| ≤ 1 := hq a (Finset.mem_insert_self a s)
      calc |p a * ∏ i ∈ s, p i - q a * ∏ i ∈ s, q i|
          = |(p a - q a) * ∏ i ∈ s, p i + q a * (∏ i ∈ s, p i - ∏ i ∈ s, q i)| := by
            congr 1; ring
        _ ≤ |(p a - q a) * ∏ i ∈ s, p i| + |q a * (∏ i ∈ s, p i - ∏ i ∈ s, q i)| :=
            abs_add_le _ _
        _ = |p a - q a| * |∏ i ∈ s, p i| + |q a| * |∏ i ∈ s, p i - ∏ i ∈ s, q i| := by
            rw [abs_mul, abs_mul]
        _ ≤ |p a - q a| * 1 + 1 * ∑ i ∈ s, |p i - q i| :=
            add_le_add (mul_le_mul_of_nonneg_left hP (abs_nonneg _))
              (mul_le_mul hqa (ih hp' hq') (abs_nonneg _) zero_le_one)
        _ = |p a - q a| + ∑ i ∈ s, |p i - q i| := by ring

/-- **The characteristic function of a Rademacher sum is close to the Gaussian one**: for
`|t aⱼ| ≤ 1`, `|∏ cos(t aⱼ) − e^{−t² ∑ aⱼ²/2}| ≤ t⁴ ∑ aⱼ⁴ / 3`. -/
theorem abs_prod_cos_sub_exp_le {n : ℕ} (a : Fin n → ℝ) {t : ℝ} (ht : ∀ j, |t * a j| ≤ 1) :
    |∏ j, Real.cos (t * a j) - Real.exp (-(t ^ 2 * ∑ j, a j ^ 2) / 2)|
      ≤ t ^ 4 * (∑ j, a j ^ 4) / 3 := by
  have he : Real.exp (-(t ^ 2 * ∑ j, a j ^ 2) / 2) = ∏ j, Real.exp (-((t * a j) ^ 2) / 2) := by
    rw [← Real.exp_sum]
    congr 1
    rw [Finset.mul_sum, ← Finset.sum_neg_distrib, Finset.sum_div]
    refine Finset.sum_congr rfl fun j _ => ?_; ring
  rw [he]
  refine (abs_prod_sub_prod_le Finset.univ _ _ (fun j _ => Real.abs_cos_le_one _)
    (fun j _ => by
      rw [abs_of_pos (Real.exp_pos _)]
      exact Real.exp_le_one_iff.mpr (by nlinarith [sq_nonneg (t * a j)]))).trans ?_
  calc ∑ j, |Real.cos (t * a j) - Real.exp (-((t * a j) ^ 2) / 2)|
      ≤ ∑ j, (t * a j) ^ 4 / 3 := Finset.sum_le_sum fun j _ => abs_cos_sub_exp_le (ht j)
    _ = t ^ 4 * (∑ j, a j ^ 4) / 3 := by
        rw [Finset.mul_sum, Finset.sum_div]
        refine Finset.sum_congr rfl fun j _ => ?_; ring

/-! ### Application to the deployed rotation -/

variable {d : ℕ}

theorem abs_entry_of_isFlat {H : Od d} (hH : IsFlat H) (i j : Fin d) :
    |(H : Matrix (Fin d) (Fin d) ℝ) i j| = 1 / Real.sqrt d := by
  have h := hH i j
  have hd : (0 : ℝ) < d := by
    rcases Nat.eq_zero_or_pos d with h0 | h0
    · subst h0; exact Fin.elim0 i
    · exact_mod_cast h0
  rw [← sq_abs] at h
  have : |(H : Matrix (Fin d) (Fin d) ℝ) i j| = Real.sqrt (1 / d) := by
    rw [← Real.sqrt_sq (abs_nonneg _), h]
  rw [this, Real.sqrt_div' _ hd.le, Real.sqrt_one]

/-- **Theorem 1 for the deployed rotation, at the level of characteristic functions.**  For a
direction `v` with `‖v‖ ≤ 1` and `|t| ≤ √d`, the characteristic function of a coordinate of
`H D_ε v` is within `t⁴ ∑ⱼ vⱼ⁴/(3d²)` of the Gaussian characteristic function
`e^{−t²‖v‖²/(2d)}`: the coordinate law is Gaussian to the extent that the direction is spread,
and the deviation is governed by the same spikiness `∑ⱼ vⱼ⁴` as the fourth-moment gap. -/
theorem abs_signAvg_cos_coord_sub_exp_le {H : Od d} (hH : IsFlat H) {v : Ed d} (hv : ‖v‖ ≤ 1)
    (i : Fin d) {t : ℝ} (ht : |t| ≤ Real.sqrt d) :
    |signAvg (fun s => Real.cos (t * (hadRot H s • v) i))
        - Real.exp (-(t ^ 2 * ‖v‖ ^ 2 / d) / 2)|
      ≤ t ^ 4 * (∑ j, v j ^ 4) / (3 * (d : ℝ) ^ 2) := by
  have hd : (0 : ℝ) < d := by
    rcases Nat.eq_zero_or_pos d with h0 | h0
    · subst h0; exact Fin.elim0 i
    · exact_mod_cast h0
  set a : Fin d → ℝ := fun j => (H : Matrix (Fin d) (Fin d) ℝ) i j * v j with ha
  have hcoord : ∀ s, (hadRot H s • v) i = radSum a s := fun s => hadRot_apply_eq_radSum H s v i
  simp_rw [hcoord, signAvg_cos_radSum]
  have h2 : ∑ j, a j ^ 2 = ‖v‖ ^ 2 / d := by
    rw [norm_sq_eq_sum_sq]; simp_rw [ha, mul_pow, hH i]; rw [← Finset.mul_sum]; try ring
  have h4 : ∑ j, a j ^ 4 = (∑ j, v j ^ 4) / (d : ℝ) ^ 2 := by
    have : ∀ j, a j ^ 4 = (1 / (d : ℝ)) ^ 2 * v j ^ 4 := fun j => by
      rw [ha]; simp only
      rw [mul_pow, show (4 : ℕ) = 2 * 2 from rfl, pow_mul, hH i]
      try ring
    simp_rw [this]; rw [← Finset.mul_sum]; try ring
  have hta : ∀ j, |t * a j| ≤ 1 := by
    intro j
    rw [abs_mul, ha]; simp only
    rw [abs_mul, abs_entry_of_isFlat hH]
    have hvj : |v j| ≤ ‖v‖ := by
      have := norm_sq_eq_sum_sq v
      have h1 : v j ^ 2 ≤ ‖v‖ ^ 2 := by
        rw [this]
        exact Finset.single_le_sum (f := fun k => v k ^ 2) (fun k _ => sq_nonneg _)
          (Finset.mem_univ j)
      exact abs_le_of_sq_le_sq' h1 (norm_nonneg _) |>.2 |> fun h => (abs_le.mpr
        ⟨(abs_le_of_sq_le_sq' h1 (norm_nonneg _)).1, h⟩)
    have hs : 0 < Real.sqrt d := Real.sqrt_pos.mpr hd
    calc |t| * (1 / Real.sqrt d * |v j|) ≤ Real.sqrt d * (1 / Real.sqrt d * 1) :=
          mul_le_mul ht (mul_le_mul_of_nonneg_left (hvj.trans hv) (by positivity))
            (by positivity) hs.le
      _ = 1 := by field_simp
  have := abs_prod_cos_sub_exp_le a hta
  rw [h2, h4] at this
  have e : -(t ^ 2 * (‖v‖ ^ 2 / d)) / 2 = -(t ^ 2 * ‖v‖ ^ 2 / d) / 2 := by ring
  rw [e] at this
  refine this.trans (le_of_eq ?_)
  try ring

end Hadamard
/-! ## §41  Esseen's smoothing inequality, first half: test functions with integrable Fourier
transform

The passage from the characteristic-function bound of §40 to a statement about distributions
is Esseen's smoothing argument.  Its first half is Fourier inversion: for `g` continuous and
integrable with integrable Fourier transform, and any probability measure `μ` on `ℝ`,
`∫ g dμ = ∫ 𝓕g(ξ) φ_μ(2πξ) dξ` (`integral_eq_integral_fourier_mul_charFun`, from Mathlib's
`Continuous.fourierInv_fourier_eq` and Fubini), so two laws differ on `g` by at most
`∫ |𝓕g(ξ)| |φ_μ − φ_ν|(2πξ) dξ` (`norm_integral_sub_integral_le_fourier`).  The coordinate law
of `H D_ε v` is made a measure (`coordLaw`, the image of the uniform law on sign patterns,
`uniformSigns`), its characteristic function is the real product `∏ⱼ cos(t aⱼ)` of §40
(`charFun_coordLaw`), and the bound of §40 becomes a bound on its distance from the Gaussian
`N(0, ‖v‖²/d)` in characteristic function (`norm_charFun_coordLaw_sub_gaussian_le`).  Hence, for
every test function `g` band-limited to `|2πξ| ≤ √d`,
`|E g((H D_ε v)ᵢ) − E g(Z)| ≤ ∑ⱼ vⱼ⁴/(3d²) · ∫ |𝓕g(ξ)| (2πξ)⁴ dξ`
(`norm_integral_coordLaw_sub_gaussian_le`).  The second half of Esseen's argument, from such
test functions to indicators of half-lines with the Gaussian density bound, is not formalised;
that is the remaining step to a Kolmogorov-distance statement. -/

open scoped FourierTransform

section FourierSmoothing

/-- **Fourier representation of an expectation**: for `g` continuous, integrable, with
integrable Fourier transform, `∫ g dμ = ∫ 𝓕g(ξ) · φ_μ(2πξ) dξ`. -/
theorem integral_eq_integral_fourier_mul_charFun {g : ℝ → ℂ} (hg : Continuous g)
    (hgi : Integrable g) (hgf : Integrable (𝓕 g)) (μ : Measure ℝ) [IsProbabilityMeasure μ] :
    ∫ x, g x ∂μ = ∫ ξ, 𝓕 g ξ * charFun μ (2 * π * ξ) := by
  have hinv : ∀ x, g x = ∫ ξ, Complex.exp (↑(2 * π * ξ * x) * Complex.I) * 𝓕 g ξ := by
    intro x
    conv_lhs => rw [← hg.fourierInv_fourier_eq hgi hgf]
    rw [Real.fourierInv_eq']
    refine integral_congr_ae (Filter.Eventually.of_forall fun ξ => ?_)
    simp only [smul_eq_mul]
    congr 2
    simp only [RCLike.inner_apply, conj_trivial]
    push_cast
    ring
  have hmeas : AEStronglyMeasurable (fun p : ℝ × ℝ =>
      Complex.exp (↑(2 * π * p.2 * p.1) * Complex.I) * 𝓕 g p.2) (μ.prod volume) := by
    refine (Continuous.aestronglyMeasurable (by fun_prop)).mul ?_
    exact hgf.aestronglyMeasurable.comp_snd
  have hint : Integrable (Function.uncurry fun (x ξ : ℝ) =>
      Complex.exp (↑(2 * π * ξ * x) * Complex.I) * 𝓕 g ξ) (μ.prod volume) := by
    refine (hgf.norm.comp_snd (μ := μ)).mono' hmeas (Filter.Eventually.of_forall fun p => ?_)
    show ‖Complex.exp (↑(2 * π * p.2 * p.1) * Complex.I) * 𝓕 g p.2‖ ≤ ‖𝓕 g p.2‖
    rw [norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
  calc ∫ x, g x ∂μ
      = ∫ x, (∫ ξ, Complex.exp (↑(2 * π * ξ * x) * Complex.I) * 𝓕 g ξ) ∂μ :=
        integral_congr_ae (μ := μ) (Filter.Eventually.of_forall fun x => hinv x)
    _ = ∫ ξ, (∫ x, Complex.exp (↑(2 * π * ξ * x) * Complex.I) * 𝓕 g ξ ∂μ) :=
        integral_integral_swap (f := fun (x ξ : ℝ) =>
          Complex.exp (↑(2 * π * ξ * x) * Complex.I) * 𝓕 g ξ) hint
    _ = ∫ ξ, 𝓕 g ξ * charFun μ (2 * π * ξ) := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun ξ => ?_)
        show ∫ x, Complex.exp (↑(2 * π * ξ * x) * Complex.I) * 𝓕 g ξ ∂μ
          = 𝓕 g ξ * charFun μ (2 * π * ξ)
        rw [integral_mul_const, charFun_apply_real, mul_comm]
        congr 1
        refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
        push_cast
        ring_nf

/-- **The smoothing bound for test functions**: the difference of two expectations is bounded
by the characteristic-function gap weighted by `|𝓕 g|`. -/
theorem norm_integral_sub_integral_le_fourier {g : ℝ → ℂ} (hg : Continuous g)
    (hgi : Integrable g) (hgf : Integrable (𝓕 g)) (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] :
    ‖∫ x, g x ∂μ - ∫ x, g x ∂ν‖
      ≤ ∫ ξ, ‖𝓕 g ξ‖ * ‖charFun μ (2 * π * ξ) - charFun ν (2 * π * ξ)‖ := by
  rw [integral_eq_integral_fourier_mul_charFun hg hgi hgf μ,
    integral_eq_integral_fourier_mul_charFun hg hgi hgf ν]
  have hcf : ∀ (ρ : Measure ℝ) [IsProbabilityMeasure ρ],
      Integrable (fun ξ => 𝓕 g ξ * charFun ρ (2 * π * ξ)) volume := by
    intro ρ _
    have hm : AEStronglyMeasurable (fun ξ => 𝓕 g ξ * charFun ρ (2 * π * ξ)) volume :=
      hgf.aestronglyMeasurable.mul
        ((continuous_charFun.comp (by fun_prop : Continuous fun ξ : ℝ => 2 * π * ξ))
          |>.aestronglyMeasurable)
    refine hgf.norm.mono' hm (Filter.Eventually.of_forall fun ξ => ?_)
    show ‖𝓕 g ξ * charFun ρ (2 * π * ξ)‖ ≤ ‖𝓕 g ξ‖
    rw [norm_mul]
    exact mul_le_of_le_one_right (norm_nonneg _) (norm_charFun_le_one _)
  have h1 := hcf μ
  have h2 := hcf ν
  rw [← integral_sub h1 h2]
  refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
  refine integral_congr_ae (Filter.Eventually.of_forall fun ξ => ?_)
  show ‖𝓕 g ξ * charFun μ (2 * π * ξ) - 𝓕 g ξ * charFun ν (2 * π * ξ)‖
    = ‖𝓕 g ξ‖ * ‖charFun μ (2 * π * ξ) - charFun ν (2 * π * ξ)‖
  rw [← mul_sub, norm_mul]

end FourierSmoothing

namespace Hadamard

open Orthogonal


variable {d : ℕ}

/-- The uniform law on sign patterns. -/
noncomputable def uniformSigns (d : ℕ) : Measure (Signs d) :=
  ((2 : ℝ≥0∞) ^ d)⁻¹ • Measure.count

theorem card_signs_ennreal (d : ℕ) : ((ENat.card (Signs d) : ℕ∞) : ℝ≥0∞) = (2 : ℝ≥0∞) ^ d := by
  rw [ENat.card_eq_coe_fintype_card, card_signs]
  simp

instance : IsProbabilityMeasure (uniformSigns d) := by
  constructor
  rw [uniformSigns, Measure.smul_apply, Measure.count_univ, card_signs_ennreal, smul_eq_mul,
    ENNReal.inv_mul_cancel (by positivity) (by simp)]

theorem integral_uniformSigns (f : Signs d → ℝ) : ∫ s, f s ∂(uniformSigns d) = signAvg f := by
  rw [integral_fintype Integrable.of_finite, signAvg, Finset.sum_div]
  refine Finset.sum_congr rfl fun s _ => ?_
  rw [uniformSigns, measureReal_def, Measure.smul_apply, Measure.count_singleton]
  simp only [smul_eq_mul, mul_one]
  rw [ENNReal.toReal_inv, ENNReal.toReal_pow, ENNReal.toReal_ofNat]
  ring

/-- The law of the coordinate `(H D_ε v)ᵢ` under uniform signs. -/
noncomputable def coordLaw (H : Od d) (v : Ed d) (i : Fin d) : Measure ℝ :=
  (uniformSigns d).map fun s => (hadRot H s • v) i

instance (H : Od d) (v : Ed d) (i : Fin d) : IsProbabilityMeasure (coordLaw H v i) := by
  constructor
  rw [coordLaw, Measure.map_apply (measurable_of_countable _) MeasurableSet.univ,
    Set.preimage_univ, measure_univ]

theorem integral_coordLaw (H : Od d) (v : Ed d) (i : Fin d) {g : ℝ → ℝ} (hg : Measurable g) :
    ∫ x, g x ∂(coordLaw H v i) = signAvg fun s => g ((hadRot H s • v) i) := by
  rw [coordLaw, integral_map (measurable_of_countable _).aemeasurable hg.aestronglyMeasurable,
    integral_uniformSigns]

/-- The characteristic function of the coordinate law is real: `∏ⱼ cos(t aⱼ)`. -/
theorem charFun_coordLaw (H : Od d) (v : Ed d) (i : Fin d) (t : ℝ) :
    charFun (coordLaw H v i) t
      = ((∏ j, Real.cos (t * ((H : Matrix (Fin d) (Fin d) ℝ) i j * v j)) : ℝ) : ℂ) := by
  rw [charFun_apply_real, coordLaw, integral_map (measurable_of_countable _).aemeasurable
    (Continuous.aestronglyMeasurable (by fun_prop))]
  have hcoord : ∀ s, (hadRot H s • v) i = radSum (fun j => (H : Matrix (Fin d) (Fin d) ℝ) i j * v j) s :=
    fun s => hadRot_apply_eq_radSum H s v i
  simp_rw [hcoord]
  have hexp : ∀ s, Complex.exp (↑t * ↑(radSum (fun j => (H : Matrix (Fin d) (Fin d) ℝ) i j * v j) s)
      * Complex.I) = ((Real.cos (t * radSum (fun j => (H : Matrix (Fin d) (Fin d) ℝ) i j * v j) s) : ℝ) : ℂ)
        + ((Real.sin (t * radSum (fun j => (H : Matrix (Fin d) (Fin d) ℝ) i j * v j) s) : ℝ) : ℂ)
          * Complex.I := by
    intro s
    rw [← Complex.ofReal_mul, Complex.exp_mul_I, Complex.ofReal_cos, Complex.ofReal_sin]
  simp_rw [hexp]
  rw [integral_add, integral_mul_const, integral_complex_ofReal, integral_complex_ofReal,
    integral_uniformSigns, integral_uniformSigns, signAvg_cos_radSum,
    signAvg_odd _ (F := fun x => Real.sin (t * x)) (fun x => by rw [mul_neg, Real.sin_neg])]
  · simp
  · exact Integrable.of_finite
  · exact Integrable.of_finite

/-- The characteristic-function gap between the coordinate law and the Gaussian
`N(0, ‖v‖²/d)`, for `|t| ≤ √d`. -/
theorem norm_charFun_coordLaw_sub_gaussian_le {H : Od d} (hH : IsFlat H) {v : Ed d}
    (hv : ‖v‖ ≤ 1) (i : Fin d) {t : ℝ} (ht : |t| ≤ Real.sqrt d) :
    ‖charFun (coordLaw H v i) t - charFun (gaussianReal 0 (Real.toNNReal (‖v‖ ^ 2 / d))) t‖
      ≤ t ^ 4 * (∑ j, v j ^ 4) / (3 * (d : ℝ) ^ 2) := by
  rw [charFun_coordLaw, charFun_gaussianReal]
  have h := abs_signAvg_cos_coord_sub_exp_le hH hv i ht
  have hcoord : ∀ s, (hadRot H s • v) i = radSum (fun j => (H : Matrix (Fin d) (Fin d) ℝ) i j * v j) s :=
    fun s => hadRot_apply_eq_radSum H s v i
  simp_rw [hcoord, signAvg_cos_radSum] at h
  have hnn : (0 : ℝ) ≤ ‖v‖ ^ 2 / d := by positivity
  have hg : Complex.exp (↑t * ↑(0 : ℝ) * Complex.I - ↑↑(Real.toNNReal (‖v‖ ^ 2 / d)) * ↑t ^ 2 / 2)
      = ((Real.exp (-(t ^ 2 * ‖v‖ ^ 2 / d) / 2) : ℝ) : ℂ) := by
    rw [Complex.ofReal_exp]
    congr 1
    rw [Real.coe_toNNReal _ hnn]
    push_cast
    ring
  rw [hg, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
  exact h

/-- **Esseen's smoothing bound, first half, for the deployed rotation**: for any band-limited
test function `g` (with `𝓕 g` vanishing beyond `|2πξ| ≤ √d`), the expectation of `g` under the
coordinate law of `H D_ε v` differs from its Gaussian expectation by at most
`∑ⱼ vⱼ⁴/(3d²) · ∫ |𝓕g(ξ)| (2πξ)⁴ dξ`. -/
theorem norm_integral_coordLaw_sub_gaussian_le {H : Od d} (hH : IsFlat H) {v : Ed d}
    (hv : ‖v‖ ≤ 1) (i : Fin d) {g : ℝ → ℂ} (hg : Continuous g) (hgi : Integrable g)
    (hgf : Integrable (𝓕 g)) (hband : ∀ ξ : ℝ, Real.sqrt d < |2 * π * ξ| → 𝓕 g ξ = 0) :
    ‖∫ x, g x ∂(coordLaw H v i) - ∫ x, g x ∂(gaussianReal 0 (Real.toNNReal (‖v‖ ^ 2 / d)))‖
      ≤ (∑ j, v j ^ 4) / (3 * (d : ℝ) ^ 2) * ∫ ξ, ‖𝓕 g ξ‖ * (2 * π * ξ) ^ 4 := by
  refine (norm_integral_sub_integral_le_fourier hg hgi hgf _ _).trans ?_
  have hpt : ∀ ξ : ℝ, ‖𝓕 g ξ‖ * ‖charFun (coordLaw H v i) (2 * π * ξ)
        - charFun (gaussianReal 0 (Real.toNNReal (‖v‖ ^ 2 / d))) (2 * π * ξ)‖
      ≤ (∑ j, v j ^ 4) / (3 * (d : ℝ) ^ 2) * (‖𝓕 g ξ‖ * (2 * π * ξ) ^ 4) := by
    intro ξ
    rcases le_or_gt |2 * π * ξ| (Real.sqrt d) with hξ | hξ
    · have := norm_charFun_coordLaw_sub_gaussian_le hH hv i hξ
      calc ‖𝓕 g ξ‖ * ‖charFun (coordLaw H v i) (2 * π * ξ)
            - charFun (gaussianReal 0 (Real.toNNReal (‖v‖ ^ 2 / d))) (2 * π * ξ)‖
          ≤ ‖𝓕 g ξ‖ * ((2 * π * ξ) ^ 4 * (∑ j, v j ^ 4) / (3 * (d : ℝ) ^ 2)) :=
            mul_le_mul_of_nonneg_left this (norm_nonneg _)
        _ = _ := by ring
    · rw [hband ξ hξ, norm_zero, zero_mul, zero_mul, mul_zero]
  have hint : Integrable (fun ξ : ℝ => ‖𝓕 g ξ‖ * (2 * π * ξ) ^ 4) volume := by
    refine (hgf.norm.const_mul ((d : ℝ) ^ 2)).mono'
      (hgf.norm.aestronglyMeasurable.mul (by fun_prop))
      (Filter.Eventually.of_forall fun ξ => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity), mul_comm]
    rcases le_or_gt |2 * π * ξ| (Real.sqrt d) with hξ | hξ
    · refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
      have h1 : (2 * π * ξ) ^ 4 = (|2 * π * ξ| ^ 2) ^ 2 := by rw [sq_abs]; ring
      have h2 : |2 * π * ξ| ^ 2 ≤ (d : ℝ) := by
        calc |2 * π * ξ| ^ 2 ≤ Real.sqrt d ^ 2 := pow_le_pow_left₀ (abs_nonneg _) hξ 2
          _ = d := Real.sq_sqrt (Nat.cast_nonneg _)
      rw [h1]
      exact pow_le_pow_left₀ (sq_nonneg _) h2 2
    · rw [hband ξ hξ, norm_zero]; simp
  calc ∫ ξ, ‖𝓕 g ξ‖ * ‖charFun (coordLaw H v i) (2 * π * ξ)
        - charFun (gaussianReal 0 (Real.toNNReal (‖v‖ ^ 2 / d))) (2 * π * ξ)‖
      ≤ ∫ ξ, (∑ j, v j ^ 4) / (3 * (d : ℝ) ^ 2) * (‖𝓕 g ξ‖ * (2 * π * ξ) ^ 4) :=
        integral_mono_of_nonneg (Filter.Eventually.of_forall fun ξ => by positivity)
          (hint.const_mul _) (Filter.Eventually.of_forall hpt)
    _ = _ := integral_const_mul _ _

end Hadamard
/-!
# §42  Esseen's smoothing inequality, second half: from test functions to half-lines

The first half (§41) bounds `|∫ g dμ − ∫ g dν|` for a test function `g` by the
`|𝓕g|`-weighted characteristic-function gap.  This section closes the argument.

* `esseen_lemma`: for probability measures `μ, ν, K` on `ℝ` with `F_ν` `m`-Lipschitz and `K`
  putting mass at most `ε` outside `[−a, a]`, the distribution-function gap at `x₀` is
  controlled by the `K`-smoothed gap `D(x) = ∫ (F_μ − F_ν)(x − y) dK(y)` at `x₀ ± a`:
  `|F_μ(x₀) − F_ν(x₀)| (1 − ε) ≤ |D(x₀ + a)| + |D(x₀ − a)| + 2ma + ε`.
* `smoothStep K x L u = K((x − L − u, x − u])` is the `K`-smoothed indicator of `(x − L, x]`; it
  is continuous when `K` is atomless, integrable with mass `L`, and its Fourier transform is
  `e^{−2πiξx}(e^{2πiξL} − 1)/(2πiξ) · φ_K(2πξ)`, of norm at most `|φ_K(2πξ)|/(π|ξ|)`.
* `smoothDiff_sub_smoothDiff`: `D(x) − D(x − L)` is the gap of expectations of the smooth step,
  so §41 bounds it by `∫ |φ_K(2πξ)|/(π|ξ|) · |φ_μ − φ_ν|(2πξ) dξ`, uniformly in `L`; letting
  `L → ∞` (`tendsto_smoothDiff_atTop`) bounds `|D(x)|` itself (`abs_smoothDiff_le`).
* `esseen_inequality`: the assembled kernel-form inequality
  `|F_μ(x₀) − F_ν(x₀)| (1 − ε) ≤ 2 ∫ |φ_K(2πξ)|/(π|ξ|) · |φ_μ(2πξ) − φ_ν(2πξ)| dξ + 2ma + ε`.
* `esseen_inequality_gaussian`: the same with the Gaussian kernel `N(0, v)`, whose hypotheses
  (atomless, Chebyshev tail `v/a²`, integrable weight) are all discharged.

What this does **not** yet give is a Kolmogorov–Smirnov rate for the coordinate law of
`H D_ε v`: the coordinate law is a lattice law, its characteristic function is periodic, and the
§40 bound only covers `|t| ≤ √d`, so a decaying rate needs a kernel whose characteristic function
vanishes beyond `|t| ~ √d` (Fejér), whose Fourier transform is not computed here.  With the
Gaussian kernel the region `|t| > √d` contributes a term that does not decay in `d`.
-/

open Filter
open scoped Topology FourierTransform


section Esseen

/-- The distribution function of a measure on `ℝ`, as a real number. -/
noncomputable def cdfR (μ : Measure ℝ) (x : ℝ) : ℝ := μ.real (Set.Iic x)

theorem cdfR_mono (μ : Measure ℝ) [IsFiniteMeasure μ] : Monotone (cdfR μ) := fun x y hxy =>
  measureReal_mono (Set.Iic_subset_Iic.mpr hxy)

theorem cdfR_nonneg (μ : Measure ℝ) (x : ℝ) : 0 ≤ cdfR μ x := ENNReal.toReal_nonneg

theorem cdfR_le_one (μ : Measure ℝ) [IsProbabilityMeasure μ] (x : ℝ) : cdfR μ x ≤ 1 := by
  unfold cdfR
  calc μ.real (Set.Iic x) ≤ μ.real Set.univ := measureReal_mono (Set.subset_univ _)
    _ = 1 := by simp

theorem measurable_cdfR (μ : Measure ℝ) [IsFiniteMeasure μ] : Measurable (cdfR μ) :=
  (cdfR_mono μ).measurable

/-- The kernel-smoothed difference of two distribution functions,
`∫ (F_μ − F_ν)(x − y) dK(y)`. -/
noncomputable def smoothDiff (μ ν K : Measure ℝ) (x : ℝ) : ℝ :=
  ∫ y, (cdfR μ (x - y) - cdfR ν (x - y)) ∂K

/-- **Esseen's lemma**: a distribution function is controlled by its kernel-smoothed version.
If `F_ν` is `m`-Lipschitz (`ν` has density at most `m`) and the kernel puts mass at most `ε`
outside `[−a, a]`, then `|F_μ(x₀) − F_ν(x₀)| (1 − ε) ≤ |D(x₀ + a)| + |D(x₀ − a)| + 2ma + ε`
with `D` the smoothed difference. -/
theorem esseen_lemma (μ ν K : Measure ℝ) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    [IsProbabilityMeasure K] {m : ℝ} (hm : 0 ≤ m)
    (hG : ∀ x y, x ≤ y → cdfR ν y - cdfR ν x ≤ m * (y - x)) {a ε : ℝ} (ha : 0 ≤ a)
    (hε : K.real {y | a < ‖y‖} ≤ ε) (x₀ : ℝ) :
    |cdfR μ x₀ - cdfR ν x₀| * (1 - ε)
      ≤ |smoothDiff μ ν K (x₀ + a)| + |smoothDiff μ ν K (x₀ - a)| + 2 * m * a + ε := by
  set Δ : ℝ → ℝ := fun z => cdfR μ z - cdfR ν z with hΔ
  have hΔm : Measurable Δ := (measurable_cdfR μ).sub (measurable_cdfR ν)
  have hΔb : ∀ z, |Δ z| ≤ 1 := fun z => by
    rw [hΔ]; simp only
    rw [abs_le]
    have := cdfR_nonneg μ z; have := cdfR_le_one μ z
    have := cdfR_nonneg ν z; have := cdfR_le_one ν z
    constructor <;> linarith
  have hε0 : 0 ≤ K.real {y | a < ‖y‖} := measureReal_nonneg
  have hset : MeasurableSet {y : ℝ | a < ‖y‖} := measurableSet_lt measurable_const measurable_norm
  set ε' := K.real {y | a < ‖y‖} with hε'
  have hcompl : K.real {y : ℝ | ‖y‖ ≤ a} = 1 - ε' := by
    have : {y : ℝ | ‖y‖ ≤ a} = {y : ℝ | a < ‖y‖}ᶜ := by
      ext y; simp [not_lt]
    rw [this, measureReal_compl hset, measureReal_def, measure_univ, ENNReal.toReal_one]
  have hε1 : ε' ≤ 1 := by
    have := measureReal_nonneg (μ := K) (s := {y : ℝ | ‖y‖ ≤ a}); linarith
  -- the two directional lower/upper bounds on `Δ` near `x₀`
  have hup : ∀ s, 0 ≤ s → s ≤ 2 * a → Δ x₀ - 2 * m * a ≤ Δ (x₀ + s) := by
    intro s hs hs2
    have h1 : cdfR μ x₀ ≤ cdfR μ (x₀ + s) := cdfR_mono μ (by linarith)
    have h2 := hG x₀ (x₀ + s) (by linarith)
    rw [hΔ]; simp only
    have : m * (x₀ + s - x₀) ≤ 2 * m * a := by
      rw [show x₀ + s - x₀ = s by ring]; nlinarith
    linarith
  have hdown : ∀ s, 0 ≤ s → s ≤ 2 * a → Δ (x₀ - s) ≤ Δ x₀ + 2 * m * a := by
    intro s hs hs2
    have h1 : cdfR μ (x₀ - s) ≤ cdfR μ x₀ := cdfR_mono μ (by linarith)
    have h2 := hG (x₀ - s) x₀ (by linarith)
    rw [hΔ]; simp only
    have : m * (x₀ - (x₀ - s)) ≤ 2 * m * a := by
      rw [show x₀ - (x₀ - s) = s by ring]; nlinarith
    linarith
  -- integrability of the shifted differences and of the two-valued comparison functions
  have hint : ∀ x, Integrable (fun y => Δ (x - y)) K := fun x =>
    Integrable.of_bound (hΔm.comp (measurable_const.sub measurable_id)).aestronglyMeasurable 1
      (Filter.Eventually.of_forall fun y => by rw [Real.norm_eq_abs]; exact hΔb _)
  have hstep : ∀ c : ℝ, Integrable (fun y : ℝ => {y : ℝ | ‖y‖ ≤ a}.indicator (fun _ => c) y
      + {y : ℝ | a < ‖y‖}.indicator (fun _ => (-1 : ℝ)) y) K :=
    fun c => ((integrable_const c).indicator (measurableSet_le measurable_norm measurable_const)).add
      ((integrable_const _).indicator hset)
  have hstep_int : ∀ c : ℝ, ∫ y, ({y : ℝ | ‖y‖ ≤ a}.indicator (fun _ => c) y
      + {y : ℝ | a < ‖y‖}.indicator (fun _ => (-1 : ℝ)) y) ∂K = c * (1 - ε') - ε' := by
    intro c
    rw [integral_add ((integrable_const c).indicator (measurableSet_le measurable_norm measurable_const))
      ((integrable_const _).indicator hset), integral_indicator_const _
      (measurableSet_le measurable_norm measurable_const), integral_indicator_const _ hset, hcompl]
    simp only [smul_eq_mul]
    ring
  rcases le_or_gt 1 ε with hε1' | hε1'
  · -- trivial: the left side is nonpositive
    have : |Δ x₀| * (1 - ε) ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (abs_nonneg _) (by linarith)
    have h0 : 0 ≤ |smoothDiff μ ν K (x₀ + a)| + |smoothDiff μ ν K (x₀ - a)| + 2 * m * a + ε := by
      positivity
    linarith
  rcases le_or_gt 0 (Δ x₀) with hD | hD
  · -- `Δ x₀ ≥ 0`: look to the right
    have hpt : ∀ y, {y : ℝ | ‖y‖ ≤ a}.indicator (fun _ => Δ x₀ - 2 * m * a) y
        + {y : ℝ | a < ‖y‖}.indicator (fun _ => (-1 : ℝ)) y ≤ Δ (x₀ + a - y) := by
      intro y
      by_cases hy : ‖y‖ ≤ a
      · rw [Set.indicator_of_mem (by exact hy), Set.indicator_of_notMem (by
          show ¬ a < ‖y‖; exact not_lt.mpr hy), add_zero]
        rw [Real.norm_eq_abs, abs_le] at hy
        rw [show x₀ + a - y = x₀ + (a - y) by ring]
        exact hup (a - y) (by linarith) (by linarith)
      · rw [Set.indicator_of_notMem (by exact hy), Set.indicator_of_mem (by
          show a < ‖y‖; exact not_le.mp hy), zero_add]
        exact (abs_le.mp (hΔb _)).1
    have hle : Δ x₀ * (1 - ε') - 2 * m * a * (1 - ε') - ε' ≤ smoothDiff μ ν K (x₀ + a) := by
      have := integral_mono (hstep _) (hint (x₀ + a)) hpt
      rw [hstep_int] at this
      unfold smoothDiff
      linarith
    have habs : smoothDiff μ ν K (x₀ + a) ≤ |smoothDiff μ ν K (x₀ + a)| := le_abs_self _
    have h1 : |Δ x₀| = Δ x₀ := abs_of_nonneg hD
    rw [h1]
    have h2 : Δ x₀ * (1 - ε) ≤ Δ x₀ * (1 - ε') := mul_le_mul_of_nonneg_left (by linarith) hD
    have h3 : 0 ≤ |smoothDiff μ ν K (x₀ - a)| := abs_nonneg _
    nlinarith [mul_nonneg hm ha, mul_nonneg (mul_nonneg hm ha) hε0]
  · -- `Δ x₀ < 0`: look to the left
    have hpt : ∀ y, Δ (x₀ - a - y) ≤ {y : ℝ | ‖y‖ ≤ a}.indicator (fun _ => Δ x₀ + 2 * m * a) y
        + {y : ℝ | a < ‖y‖}.indicator (fun _ => (1 : ℝ)) y := by
      intro y
      by_cases hy : ‖y‖ ≤ a
      · rw [Set.indicator_of_mem (by exact hy), Set.indicator_of_notMem (by
          show ¬ a < ‖y‖; exact not_lt.mpr hy), add_zero]
        rw [Real.norm_eq_abs, abs_le] at hy
        rw [show x₀ - a - y = x₀ - (a + y) by ring]
        exact hdown (a + y) (by linarith) (by linarith)
      · rw [Set.indicator_of_notMem (by exact hy), Set.indicator_of_mem (by
          show a < ‖y‖; exact not_le.mp hy), zero_add]
        exact (abs_le.mp (hΔb _)).2
    have hstep' : Integrable (fun y : ℝ => {y : ℝ | ‖y‖ ≤ a}.indicator (fun _ => Δ x₀ + 2 * m * a) y
        + {y : ℝ | a < ‖y‖}.indicator (fun _ => (1 : ℝ)) y) K :=
      ((integrable_const _).indicator (measurableSet_le measurable_norm measurable_const)).add
        ((integrable_const _).indicator hset)
    have hle : smoothDiff μ ν K (x₀ - a) ≤ (Δ x₀ + 2 * m * a) * (1 - ε') + ε' := by
      have := integral_mono (hint (x₀ - a)) hstep' hpt
      rw [integral_add ((integrable_const _).indicator (measurableSet_le measurable_norm measurable_const))
        ((integrable_const _).indicator hset), integral_indicator_const _
        (measurableSet_le measurable_norm measurable_const), integral_indicator_const _ hset,
        hcompl] at this
      simp only [smul_eq_mul, mul_one] at this
      unfold smoothDiff
      linarith
    have habs : -|smoothDiff μ ν K (x₀ - a)| ≤ smoothDiff μ ν K (x₀ - a) := neg_abs_le _
    have h1 : |Δ x₀| = -Δ x₀ := abs_of_neg hD
    rw [h1]
    have h2 : -Δ x₀ * (1 - ε) ≤ -Δ x₀ * (1 - ε') :=
      mul_le_mul_of_nonneg_left (by linarith) (by linarith)
    have h3 : 0 ≤ |smoothDiff μ ν K (x₀ + a)| := abs_nonneg _
    nlinarith [mul_nonneg hm ha, mul_nonneg (mul_nonneg hm ha) hε0]

end Esseen


section EsseenFourier

/-- The indicator `1_{(x − L − p₁, x − p₁]}(p₂)` on the plane. -/
noncomputable def stepInd (x L : ℝ) (p : ℝ × ℝ) : ℝ :=
  (Set.Ioc (x - L - p.1) (x - p.1)).indicator (fun _ => (1 : ℝ)) p.2

theorem stepInd_nonneg (x L : ℝ) (p : ℝ × ℝ) : 0 ≤ stepInd x L p :=
  Set.indicator_nonneg (fun _ _ => zero_le_one) _

theorem stepInd_le_one (x L : ℝ) (p : ℝ × ℝ) : stepInd x L p ≤ 1 :=
  Set.indicator_le_self' (fun _ _ => zero_le_one) _

theorem norm_stepInd_le_one (x L : ℝ) (p : ℝ × ℝ) : ‖stepInd x L p‖ ≤ 1 := by
  rw [Real.norm_of_nonneg (stepInd_nonneg x L p)]
  exact stepInd_le_one x L p

/-- The membership condition in the step indicator is symmetric in the two coordinates. -/
theorem mem_Ioc_swap {x L u y : ℝ} :
    y ∈ Set.Ioc (x - L - u) (x - u) ↔ u ∈ Set.Ioc (x - L - y) (x - y) := by
  simp only [Set.mem_Ioc]
  constructor <;> rintro ⟨h1, h2⟩ <;> constructor <;> linarith

theorem stepInd_swap (x L u y : ℝ) : stepInd x L (u, y) = stepInd x L (y, u) := by
  unfold stepInd
  by_cases h : y ∈ Set.Ioc (x - L - u) (x - u)
  · rw [Set.indicator_of_mem h, Set.indicator_of_mem (mem_Ioc_swap.mp h)]
  · rw [Set.indicator_of_notMem h, Set.indicator_of_notMem (fun h' => h (mem_Ioc_swap.mpr h'))]

theorem measurable_stepInd (x L : ℝ) : Measurable (stepInd x L) := by
  have : stepInd x L
      = {p : ℝ × ℝ | x - L - p.1 < p.2 ∧ p.2 ≤ x - p.1}.indicator (fun _ => (1 : ℝ)) := by
    funext p; simp [stepInd, Set.indicator, Set.mem_Ioc]
  rw [this]
  exact measurable_const.indicator ((measurableSet_lt (by fun_prop) measurable_snd).inter
    (measurableSet_le measurable_snd (by fun_prop)))

theorem integrable_stepInd_prod (μ K : Measure ℝ) [IsProbabilityMeasure μ] [IsProbabilityMeasure K]
    (x L : ℝ) : Integrable (stepInd x L) (μ.prod K) :=
  Integrable.of_bound (measurable_stepInd x L).aestronglyMeasurable 1
    (Filter.Eventually.of_forall (norm_stepInd_le_one x L))

/-- `∫ 1_{(x−L−y, x−y]}(u) du = L`: the step indicator has total mass `L` in its second slot. -/
theorem integral_stepInd_volume (x : ℝ) {L : ℝ} (hL : 0 ≤ L) (y : ℝ) :
    ∫ u, stepInd x L (u, y) = L := by
  have : (fun u => stepInd x L (u, y))
      = (Set.Ioc (x - L - y) (x - y)).indicator (fun _ => (1 : ℝ)) :=
    funext fun u => by rw [stepInd_swap]; rfl
  rw [this, integral_indicator_const _ measurableSet_Ioc, smul_eq_mul, mul_one, measureReal_def,
    Real.volume_Ioc, ENNReal.toReal_ofReal (by linarith)]
  ring

theorem integrable_stepInd_volume_prod (K : Measure ℝ) [IsProbabilityMeasure K] (x L : ℝ) :
    Integrable (stepInd x L) (volume.prod K) := by
  refine ⟨(measurable_stepInd x L).aestronglyMeasurable, ?_⟩
  rw [hasFiniteIntegral_iff_ofReal (Filter.Eventually.of_forall (stepInd_nonneg x L))]
  rw [lintegral_prod_symm _ ((measurable_stepInd x L).ennreal_ofReal).aemeasurable]
  have hinner : ∀ y : ℝ, ∫⁻ u, ENNReal.ofReal (stepInd x L (u, y)) = ENNReal.ofReal L := by
    intro y
    have : ∀ u : ℝ, ENNReal.ofReal (stepInd x L (u, y))
        = (Set.Ioc (x - L - y) (x - y)).indicator (fun _ => (1 : ℝ≥0∞)) u := by
      intro u
      rw [stepInd_swap]
      show ENNReal.ofReal ((Set.Ioc (x - L - y) (x - y)).indicator (fun _ => (1 : ℝ)) u) = _
      by_cases h : u ∈ Set.Ioc (x - L - y) (x - y)
      · rw [Set.indicator_of_mem h, Set.indicator_of_mem h, ENNReal.ofReal_one]
      · rw [Set.indicator_of_notMem h, Set.indicator_of_notMem h, ENNReal.ofReal_zero]
    simp_rw [this]
    rw [lintegral_indicator_const measurableSet_Ioc, Real.volume_Ioc, one_mul]
    congr 1; ring
  simp_rw [hinner]
  rw [lintegral_const, measure_univ, mul_one]
  exact ENNReal.ofReal_lt_top

/-- The kernel-smoothed indicator of the interval `(x − L, x]`:
`g(u) = K((x − L − u, x − u])`. -/
noncomputable def smoothStep (K : Measure ℝ) (x L u : ℝ) : ℝ :=
  K.real (Set.Ioc (x - L - u) (x - u))

theorem smoothStep_nonneg (K : Measure ℝ) (x L u : ℝ) : 0 ≤ smoothStep K x L u :=
  measureReal_nonneg

/-- The smooth step as an integral of the step indicator. -/
theorem smoothStep_eq_integral (K : Measure ℝ) [IsFiniteMeasure K] (x L u : ℝ) :
    smoothStep K x L u = ∫ y, stepInd x L (u, y) ∂K := by
  simp only [smoothStep, stepInd]
  rw [integral_indicator_const _ measurableSet_Ioc, smul_eq_mul, mul_one]

theorem Ioc_eq_Iic_diff (a b : ℝ) : Set.Ioc a b = Set.Iic b \ Set.Iic a := by
  ext z
  simp only [Set.mem_Ioc, Set.mem_sdiff, Set.mem_Iic, not_le]
  constructor <;> rintro ⟨h1, h2⟩ <;> exact ⟨h2, h1⟩

theorem smoothStep_eq_sub (K : Measure ℝ) [IsFiniteMeasure K] (x : ℝ) {L : ℝ} (hL : 0 ≤ L)
    (u : ℝ) : smoothStep K x L u = cdfR K (x - u) - cdfR K (x - L - u) := by
  unfold smoothStep cdfR
  rw [Ioc_eq_Iic_diff, measureReal_sdiff (Set.Iic_subset_Iic.mpr (by linarith)) measurableSet_Iic]

theorem smoothStep_eq_fun (K : Measure ℝ) [IsFiniteMeasure K] (x : ℝ) {L : ℝ} (hL : 0 ≤ L) :
    smoothStep K x L = fun u => cdfR K (x - u) - cdfR K (x - L - u) :=
  funext fun u => smoothStep_eq_sub K x hL u

theorem measurable_smoothStep (K : Measure ℝ) [IsFiniteMeasure K] (x : ℝ) {L : ℝ} (hL : 0 ≤ L) :
    Measurable (smoothStep K x L) := by
  rw [smoothStep_eq_fun K x hL]
  have hm : Measurable (cdfR K) := measurable_cdfR K
  exact (hm.comp (measurable_const.sub measurable_id)).sub
    (hm.comp (measurable_const.sub measurable_id))

theorem integrable_smoothStep (K : Measure ℝ) [IsProbabilityMeasure K] (x : ℝ) {L : ℝ}
    (hL : 0 ≤ L) : Integrable (smoothStep K x L) := by
  have h := (integrable_stepInd_volume_prod K x L).integral_prod_left
  have : smoothStep K x L = fun u => ∫ y, stepInd x L (u, y) ∂K :=
    funext (smoothStep_eq_integral K x L)
  rw [this]
  exact h

/-- `∫ g(u) du = L`: the smooth step has total mass `L`. -/
theorem integral_smoothStep (K : Measure ℝ) [IsProbabilityMeasure K] (x : ℝ) {L : ℝ} (hL : 0 ≤ L) :
    ∫ u, smoothStep K x L u = L := by
  simp_rw [smoothStep_eq_integral]
  rw [← integral_prod (stepInd x L) (integrable_stepInd_volume_prod K x L),
    integral_prod_symm _ (integrable_stepInd_volume_prod K x L)]
  simp_rw [integral_stepInd_volume x hL]
  rw [integral_const, measureReal_def, measure_univ, ENNReal.toReal_one, one_smul]

/-- The distribution function of an atomless measure is continuous. -/
theorem continuous_cdfR (K : Measure ℝ) [IsProbabilityMeasure K] [NullSingletonClass K] :
    Continuous (cdfR K) := by
  have hK : cdfR K = cdf K := funext fun z => (cdf_eq_real K z).symm
  rw [hK, continuous_iff_continuousAt]
  intro x
  rw [(cdf K).mono.continuousAt_iff_leftLim_eq_rightLim, (cdf K).rightLim_eq]
  have h := (cdf K).measure_singleton x
  rw [measure_cdf, measure_singleton, eq_comm, ENNReal.ofReal_eq_zero] at h
  exact le_antisymm ((cdf K).mono.leftLim_le le_rfl) (by linarith)

theorem continuous_smoothStep (K : Measure ℝ) [IsProbabilityMeasure K] [NullSingletonClass K]
    (x : ℝ) {L : ℝ} (hL : 0 ≤ L) : Continuous (smoothStep K x L) := by
  rw [smoothStep_eq_fun K x hL]
  have hc := continuous_cdfR K
  exact (hc.comp (continuous_const.sub continuous_id)).sub
    (hc.comp (continuous_const.sub continuous_id))

/-- The expectation of the smooth step under `μ` is the `K`-average of `F_μ(x−y) − F_μ(x−L−y)`. -/
theorem integral_smoothStep_eq (μ K : Measure ℝ) [IsProbabilityMeasure μ] [IsProbabilityMeasure K]
    (x : ℝ) {L : ℝ} (hL : 0 ≤ L) :
    ∫ u, smoothStep K x L u ∂μ = ∫ y, (cdfR μ (x - y) - cdfR μ (x - L - y)) ∂K := by
  simp_rw [smoothStep_eq_integral]
  rw [integral_integral_swap (f := fun u y => stepInd x L (u, y)) (integrable_stepInd_prod μ K x L)]
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  show ∫ u, stepInd x L (u, y) ∂μ = _
  simp_rw [stepInd_swap x L _ y]
  rw [← smoothStep_eq_integral μ x L y, smoothStep_eq_sub μ x hL y]

theorem integrable_cdfR_shift (ρ K : Measure ℝ) [IsProbabilityMeasure ρ] [IsProbabilityMeasure K]
    (z : ℝ) : Integrable (fun y => cdfR ρ (z - y)) K :=
  Integrable.of_bound ((measurable_cdfR ρ).comp (measurable_const.sub measurable_id)).aestronglyMeasurable
    1 (Filter.Eventually.of_forall fun y => by
      rw [Real.norm_of_nonneg (cdfR_nonneg _ _)]; exact cdfR_le_one _ _)

/-- The smoothed difference at `x` minus the one at `x − L` is the gap of expectations of the
smooth step. -/
theorem smoothDiff_sub_smoothDiff (μ ν K : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] [IsProbabilityMeasure K] (x : ℝ) {L : ℝ} (hL : 0 ≤ L) :
    smoothDiff μ ν K x - smoothDiff μ ν K (x - L)
      = ∫ u, smoothStep K x L u ∂μ - ∫ u, smoothStep K x L u ∂ν := by
  rw [integral_smoothStep_eq μ K x hL, integral_smoothStep_eq ν K x hL, smoothDiff, smoothDiff,
    integral_sub (integrable_cdfR_shift μ K x) (integrable_cdfR_shift ν K x),
    integral_sub (integrable_cdfR_shift μ K (x - L)) (integrable_cdfR_shift ν K (x - L)),
    integral_sub (integrable_cdfR_shift μ K x) (integrable_cdfR_shift μ K (x - L)),
    integral_sub (integrable_cdfR_shift ν K x) (integrable_cdfR_shift ν K (x - L))]
  ring

/-- The smoothed difference vanishes at `−∞`. -/
theorem tendsto_smoothDiff_atTop (μ ν K : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] [IsProbabilityMeasure K] (x : ℝ) :
    Tendsto (fun L => smoothDiff μ ν K (x - L)) atTop (𝓝 0) := by
  have hcdf : ∀ (ρ : Measure ℝ) [IsProbabilityMeasure ρ] (y : ℝ),
      Tendsto (fun L => cdfR ρ (x - L - y)) atTop (𝓝 0) := by
    intro ρ _ y
    have h1 : Tendsto (fun L : ℝ => x - L - y) atTop atBot := by
      have := tendsto_atBot_add_const_left atTop (x - y) (tendsto_neg_atTop_atBot (G := ℝ))
      exact this.congr fun L => by show x - y + -L = x - L - y; ring
    have hρ : cdfR ρ = cdf ρ := funext fun z => (cdf_eq_real ρ z).symm
    rw [hρ]
    exact (tendsto_cdf_atBot (μ := ρ)).comp h1
  have hmeas : ∀ L : ℝ, AEStronglyMeasurable (fun y => cdfR μ (x - L - y) - cdfR ν (x - L - y)) K :=
    fun L => ((integrable_cdfR_shift μ K (x - L)).sub (integrable_cdfR_shift ν K (x - L))).1
  have h := tendsto_integral_filter_of_dominated_convergence (μ := K)
    (F := fun L y => cdfR μ (x - L - y) - cdfR ν (x - L - y)) (f := fun _ => (0 : ℝ)) (fun _ => 2)
    (Filter.Eventually.of_forall hmeas)
    (Filter.Eventually.of_forall fun L => Filter.Eventually.of_forall fun y => by
      rw [Real.norm_eq_abs, abs_le]
      have := cdfR_nonneg μ (x - L - y); have := cdfR_le_one μ (x - L - y)
      have := cdfR_nonneg ν (x - L - y); have := cdfR_le_one ν (x - L - y)
      constructor <;> linarith)
    (integrable_const 2)
    (Filter.Eventually.of_forall fun y => by simpa using (hcdf μ y).sub (hcdf ν y))
  simpa [smoothDiff] using h

theorem norm_exp_mul_I_mul (a u : ℝ) : ‖Complex.exp (↑a * Complex.I * ↑u)‖ = 1 := by
  rw [show (↑a * Complex.I * ↑u : ℂ) = ↑(a * u) * Complex.I by push_cast; ring,
    Complex.norm_exp_ofReal_mul_I]

/-- **Fourier transform of the smooth step**, for `ξ ≠ 0`:
`𝓕g(ξ) = e^{−2πiξx} (e^{2πiξL} − 1)/(2πiξ) · φ_K(2πξ)`. -/
theorem fourier_smoothStep (K : Measure ℝ) [IsProbabilityMeasure K] (x : ℝ) {L : ℝ} (hL : 0 ≤ L)
    {ξ : ℝ} (hξ : ξ ≠ 0) :
    𝓕 (fun u => (smoothStep K x L u : ℂ)) ξ
      = Complex.exp (↑(-(2 * π * ξ * x)) * Complex.I)
        * (Complex.exp (↑(2 * π * ξ * L) * Complex.I) - 1) / (↑(2 * π * ξ) * Complex.I)
        * charFun K (2 * π * ξ) := by
  set c : ℂ := ↑(-(2 * π * ξ)) * Complex.I with hc
  have h2πξ : (2 * π * ξ : ℝ) ≠ 0 := by positivity
  have hc0 : c ≠ 0 := by
    rw [hc]
    refine mul_ne_zero ?_ Complex.I_ne_zero
    exact_mod_cast neg_ne_zero.mpr h2πξ
  have hd0 : (↑(2 * π * ξ) * Complex.I : ℂ) ≠ 0 :=
    mul_ne_zero (by exact_mod_cast h2πξ) Complex.I_ne_zero
  have hexp : ∀ u : ℝ, Complex.exp (↑(-2 * π * inner ℝ u ξ) * Complex.I) = Complex.exp (c * (u : ℂ)) := by
    intro u
    congr 1
    simp only [RCLike.inner_apply, conj_trivial, hc]
    push_cast
    ring
  have hmeas : AEStronglyMeasurable (fun p : ℝ × ℝ => Complex.exp (c * (p.1 : ℂ)) * (stepInd x L p : ℂ))
      (volume.prod K) := by
    refine (Continuous.aestronglyMeasurable (by fun_prop)).mul ?_
    exact (Complex.measurable_ofReal.comp (measurable_stepInd x L)).aestronglyMeasurable
  have hint : Integrable (Function.uncurry fun (u y : ℝ) => Complex.exp (c * (u : ℂ)) * (stepInd x L (u, y) : ℂ))
      (volume.prod K) := by
    refine (integrable_stepInd_volume_prod K x L).mono' hmeas
      (Filter.Eventually.of_forall fun p => ?_)
    show ‖Complex.exp (c * (p.1 : ℂ)) * (stepInd x L p : ℂ)‖ ≤ stepInd x L p
    rw [norm_mul, hc, norm_exp_mul_I_mul, one_mul, Complex.norm_real]
    exact le_of_eq (Real.norm_of_nonneg (stepInd_nonneg x L p))
  have hinner : ∀ y : ℝ, ∫ u : ℝ, Complex.exp (c * (u : ℂ)) * (stepInd x L (u, y) : ℂ)
      = Complex.exp (↑(-(2 * π * ξ * x)) * Complex.I)
        * (Complex.exp (↑(2 * π * ξ * L) * Complex.I) - 1) / (↑(2 * π * ξ) * Complex.I)
        * Complex.exp (↑(2 * π * ξ) * ↑y * Complex.I) := by
    intro y
    have hpt : ∀ u : ℝ, Complex.exp (c * (u : ℂ)) * (stepInd x L (u, y) : ℂ)
        = (Set.Ioc (x - L - y) (x - y)).indicator (fun u : ℝ => Complex.exp (c * (u : ℂ))) u := by
      intro u
      rw [stepInd_swap]
      show Complex.exp (c * (u : ℂ))
        * (((Set.Ioc (x - L - y) (x - y)).indicator (fun _ => (1 : ℝ)) u : ℝ) : ℂ) = _
      by_cases h : u ∈ Set.Ioc (x - L - y) (x - y)
      · rw [Set.indicator_of_mem h, Set.indicator_of_mem h]; push_cast; ring
      · rw [Set.indicator_of_notMem h, Set.indicator_of_notMem h]; push_cast; ring
    simp_rw [hpt]
    rw [integral_indicator measurableSet_Ioc, ← intervalIntegral.integral_of_le (by linarith),
      integral_exp_mul_complex hc0]
    have e1 : Complex.exp (c * ↑(x - y)) = Complex.exp (↑(-(2 * π * ξ * x)) * Complex.I)
        * Complex.exp (↑(2 * π * ξ) * ↑y * Complex.I) := by
      rw [← Complex.exp_add]; congr 1; rw [hc]; push_cast; ring
    have e2 : Complex.exp (c * ↑(x - L - y)) = Complex.exp (↑(-(2 * π * ξ * x)) * Complex.I)
        * Complex.exp (↑(2 * π * ξ * L) * Complex.I)
        * Complex.exp (↑(2 * π * ξ) * ↑y * Complex.I) := by
      rw [← Complex.exp_add, ← Complex.exp_add]; congr 1; rw [hc]; push_cast; ring
    rw [e1, e2, hc]
    push_cast
    field_simp
    ring
  calc 𝓕 (fun u => (smoothStep K x L u : ℂ)) ξ
      = ∫ u : ℝ, Complex.exp (c * (u : ℂ)) * ∫ y, (stepInd x L (u, y) : ℂ) ∂K := by
        rw [Real.fourier_eq']
        refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
        simp only [smul_eq_mul, hexp]
        rw [smoothStep_eq_integral, integral_complex_ofReal]
    _ = ∫ u : ℝ, ∫ y, Complex.exp (c * (u : ℂ)) * (stepInd x L (u, y) : ℂ) ∂K := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
        show Complex.exp (c * (u : ℂ)) * ∫ y, (stepInd x L (u, y) : ℂ) ∂K
          = ∫ y, Complex.exp (c * (u : ℂ)) * (stepInd x L (u, y) : ℂ) ∂K
        rw [integral_const_mul]
    _ = ∫ y, (∫ u : ℝ, Complex.exp (c * (u : ℂ)) * (stepInd x L (u, y) : ℂ)) ∂K :=
        integral_integral_swap (f := fun (u y : ℝ) => Complex.exp (c * (u : ℂ)) * (stepInd x L (u, y) : ℂ))
          hint
    _ = _ := by
        simp_rw [hinner]
        rw [integral_const_mul, charFun_apply_real]

/-- The Fourier transform of the smooth step decays like `|φ_K(2πξ)|/(π|ξ|)`. -/
theorem norm_fourier_smoothStep_le (K : Measure ℝ) [IsProbabilityMeasure K] (x : ℝ) {L : ℝ}
    (hL : 0 ≤ L) {ξ : ℝ} (hξ : ξ ≠ 0) :
    ‖𝓕 (fun u => (smoothStep K x L u : ℂ)) ξ‖ ≤ ‖charFun K (2 * π * ξ)‖ / (π * |ξ|) := by
  rw [fourier_smoothStep K x hL hξ, norm_mul, norm_div, norm_mul, Complex.norm_exp_ofReal_mul_I,
    one_mul, norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs, abs_mul,
    abs_of_pos (by positivity : (0 : ℝ) < 2 * π)]
  have hpos : 0 < π * |ξ| := mul_pos Real.pi_pos (abs_pos.mpr hξ)
  have h2 : ‖Complex.exp (↑(2 * π * ξ * L) * Complex.I) - 1‖ ≤ 2 := by
    refine (norm_sub_le _ _).trans ?_
    rw [Complex.norm_exp_ofReal_mul_I, norm_one]; try norm_num
  calc ‖Complex.exp (↑(2 * π * ξ * L) * Complex.I) - 1‖ / (2 * π * |ξ|) * ‖charFun K (2 * π * ξ)‖
      ≤ 2 / (2 * π * |ξ|) * ‖charFun K (2 * π * ξ)‖ := by gcongr
    _ = ‖charFun K (2 * π * ξ)‖ / (π * |ξ|) := by field_simp; try ring

/-- The Fourier transform of the smooth step is bounded by its mass `L`. -/
theorem norm_fourier_smoothStep_le_mass (K : Measure ℝ) [IsProbabilityMeasure K] (x : ℝ) {L : ℝ}
    (hL : 0 ≤ L) (ξ : ℝ) : ‖𝓕 (fun u => (smoothStep K x L u : ℂ)) ξ‖ ≤ L := by
  refine (VectorFourier.norm_fourierIntegral_le_integral_norm _ _ _ _ _).trans (le_of_eq ?_)
  simp_rw [Complex.norm_real, Real.norm_of_nonneg (smoothStep_nonneg K x L _)]
  exact integral_smoothStep K x hL

theorem integrable_fourier_smoothStep (K : Measure ℝ) [IsProbabilityMeasure K] (x : ℝ) {L : ℝ}
    (hL : 0 ≤ L) (hKf : Integrable (fun ξ : ℝ => min 1 (‖charFun K (2 * π * ξ)‖ / |ξ|))) :
    Integrable (𝓕 (fun u => (smoothStep K x L u : ℂ))) := by
  have hgi : Integrable (fun u => (smoothStep K x L u : ℂ)) := (integrable_smoothStep K x hL).ofReal
  have hcont : Continuous (𝓕 (fun u => (smoothStep K x L u : ℂ))) :=
    VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar (innerSL ℝ).continuous₂ hgi
  refine (hKf.const_mul (max L 1)).mono' hcont.aestronglyMeasurable ?_
  filter_upwards [Measure.ae_ne volume (0 : ℝ)] with ξ hξ
  have h1 := norm_fourier_smoothStep_le_mass K x hL ξ
  have h2 := norm_fourier_smoothStep_le K x hL hξ
  have h3 : ‖charFun K (2 * π * ξ)‖ / (π * |ξ|) ≤ ‖charFun K (2 * π * ξ)‖ / |ξ| := by
    apply div_le_div_of_nonneg_left (norm_nonneg _) (abs_pos.mpr hξ)
    exact le_mul_of_one_le_left (abs_nonneg _) (by linarith [Real.pi_gt_three])
  have hh : 0 ≤ ‖charFun K (2 * π * ξ)‖ / |ξ| := by positivity
  rcases le_or_gt (‖charFun K (2 * π * ξ)‖ / |ξ|) 1 with hh1 | hh1
  · rw [min_eq_right hh1]
    exact (h2.trans h3).trans (le_mul_of_one_le_left hh (le_max_right _ _))
  · rw [min_eq_left hh1.le, mul_one]
    exact h1.trans (le_max_left _ _)

/-- **The smoothed difference is bounded by the weighted characteristic-function gap.** -/
theorem abs_smoothDiff_le (μ ν K : Measure ℝ) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    [IsProbabilityMeasure K] [NullSingletonClass K]
    (hKf : Integrable (fun ξ : ℝ => min 1 (‖charFun K (2 * π * ξ)‖ / |ξ|)))
    (hI : Integrable (fun ξ : ℝ => ‖charFun K (2 * π * ξ)‖ / (π * |ξ|)
      * ‖charFun μ (2 * π * ξ) - charFun ν (2 * π * ξ)‖)) (x : ℝ) :
    |smoothDiff μ ν K x| ≤ ∫ ξ, ‖charFun K (2 * π * ξ)‖ / (π * |ξ|)
      * ‖charFun μ (2 * π * ξ) - charFun ν (2 * π * ξ)‖ := by
  set I := ∫ ξ, ‖charFun K (2 * π * ξ)‖ / (π * |ξ|)
    * ‖charFun μ (2 * π * ξ) - charFun ν (2 * π * ξ)‖ with hI_def
  have hΔc : Continuous fun ξ : ℝ => ‖charFun μ (2 * π * ξ) - charFun ν (2 * π * ξ)‖ := by
    have h2 : Continuous fun ξ : ℝ => 2 * π * ξ := by fun_prop
    exact ((continuous_charFun.comp h2).sub (continuous_charFun.comp h2)).norm
  have hΔb : ∀ ξ : ℝ, ‖charFun μ (2 * π * ξ) - charFun ν (2 * π * ξ)‖ ≤ 2 := by
    intro ξ
    have hμ : ‖charFun μ (2 * π * ξ)‖ ≤ 1 := norm_charFun_le_one _
    have hν : ‖charFun ν (2 * π * ξ)‖ ≤ 1 := norm_charFun_le_one _
    exact (norm_sub_le _ _).trans (by linarith)
  have key : ∀ L, 0 ≤ L → |smoothDiff μ ν K x| ≤ I + |smoothDiff μ ν K (x - L)| := by
    intro L hL
    have hg : Continuous (fun u => (smoothStep K x L u : ℂ)) :=
      Complex.continuous_ofReal.comp (continuous_smoothStep K x hL)
    have hgi : Integrable (fun u => (smoothStep K x L u : ℂ)) :=
      (integrable_smoothStep K x hL).ofReal
    have hgf : Integrable (𝓕 (fun u => (smoothStep K x L u : ℂ))) :=
      integrable_fourier_smoothStep K x hL hKf
    have h1 := norm_integral_sub_integral_le_fourier hg hgi hgf μ ν
    rw [integral_complex_ofReal, integral_complex_ofReal, ← Complex.ofReal_sub, Complex.norm_real,
      Real.norm_eq_abs, ← smoothDiff_sub_smoothDiff μ ν K x hL] at h1
    have h2 : ∫ ξ, ‖𝓕 (fun u => (smoothStep K x L u : ℂ)) ξ‖
        * ‖charFun μ (2 * π * ξ) - charFun ν (2 * π * ξ)‖ ≤ I := by
      refine integral_mono_ae ?_ hI ?_
      · refine (hgf.norm.mul_const 2).mono' (hgf.norm.aestronglyMeasurable.mul
          hΔc.aestronglyMeasurable) (Filter.Eventually.of_forall fun ξ => ?_)
        rw [norm_mul, norm_norm, norm_norm]
        exact mul_le_mul_of_nonneg_left (hΔb ξ) (norm_nonneg _)
      · filter_upwards [Measure.ae_ne volume (0 : ℝ)] with ξ hξ
        exact mul_le_mul_of_nonneg_right (norm_fourier_smoothStep_le K x hL hξ) (norm_nonneg _)
    calc |smoothDiff μ ν K x|
        = |(smoothDiff μ ν K x - smoothDiff μ ν K (x - L)) + smoothDiff μ ν K (x - L)| := by
          ring_nf
      _ ≤ |smoothDiff μ ν K x - smoothDiff μ ν K (x - L)| + |smoothDiff μ ν K (x - L)| :=
          abs_add_le _ _
      _ ≤ I + |smoothDiff μ ν K (x - L)| := by gcongr; exact h1.trans h2
  have hlim : Tendsto (fun L => I + |smoothDiff μ ν K (x - L)|) atTop (𝓝 (I + |0|)) :=
    tendsto_const_nhds.add (tendsto_smoothDiff_atTop μ ν K x).abs
  rw [abs_zero, add_zero] at hlim
  exact ge_of_tendsto hlim (Filter.eventually_atTop.mpr ⟨0, fun L hL => key L hL⟩)

/-- **Esseen's smoothing inequality** (kernel form): for probability measures `μ, ν, K` on `ℝ`
with `K` atomless, `F_ν` `m`-Lipschitz and `K` putting mass at most `ε` outside `[−a, a]`,
`|F_μ(x₀) − F_ν(x₀)| (1 − ε) ≤ 2 ∫ |φ_K(2πξ)|/(π|ξ|) · |φ_μ(2πξ) − φ_ν(2πξ)| dξ + 2ma + ε`. -/
theorem esseen_inequality (μ ν K : Measure ℝ) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    [IsProbabilityMeasure K] [NullSingletonClass K] {m : ℝ} (hm : 0 ≤ m)
    (hG : ∀ x y, x ≤ y → cdfR ν y - cdfR ν x ≤ m * (y - x)) {a ε : ℝ} (ha : 0 ≤ a)
    (hε : K.real {y | a < ‖y‖} ≤ ε)
    (hKf : Integrable (fun ξ : ℝ => min 1 (‖charFun K (2 * π * ξ)‖ / |ξ|)))
    (hI : Integrable (fun ξ : ℝ => ‖charFun K (2 * π * ξ)‖ / (π * |ξ|)
      * ‖charFun μ (2 * π * ξ) - charFun ν (2 * π * ξ)‖)) (x₀ : ℝ) :
    |cdfR μ x₀ - cdfR ν x₀| * (1 - ε)
      ≤ 2 * (∫ ξ, ‖charFun K (2 * π * ξ)‖ / (π * |ξ|)
          * ‖charFun μ (2 * π * ξ) - charFun ν (2 * π * ξ)‖) + 2 * m * a + ε := by
  have h := esseen_lemma μ ν K hm hG ha hε x₀
  have h1 := abs_smoothDiff_le μ ν K hKf hI (x₀ + a)
  have h2 := abs_smoothDiff_le μ ν K hKf hI (x₀ - a)
  linarith

end EsseenFourier

section EsseenGaussian

theorem norm_charFun_gaussianReal (v : NNReal) (t : ℝ) :
    ‖charFun (gaussianReal 0 v) t‖ = Real.exp (-(v * t ^ 2 / 2)) := by
  rw [charFun_gaussianReal, Complex.norm_exp]
  congr 1
  rw [show (↑t * ↑(0 : ℝ) * Complex.I - ↑↑v * ↑t ^ 2 / 2 : ℂ)
      = ((-((v : ℝ) * t ^ 2 / 2) : ℝ) : ℂ) by push_cast; ring, Complex.ofReal_re]

/-- The Gaussian kernel is atomless. -/
theorem nullSingletonClass_gaussianReal {v : NNReal} (hv : v ≠ 0) :
    NullSingletonClass (gaussianReal 0 v) := by
  rw [gaussianReal_of_var_ne_zero _ hv]; infer_instance

/-- Chebyshev tail of the Gaussian kernel: `K{|y| > a} ≤ v/a²`. -/
theorem gaussianReal_real_tail_le (v : NNReal) {a : ℝ} (ha : 0 < a) :
    (gaussianReal 0 v).real {y | a < ‖y‖} ≤ (v : ℝ) / a ^ 2 := by
  have h := meas_ge_le_variance_div_sq (μ := gaussianReal 0 v) (memLp_id_gaussianReal 2) ha
  rw [variance_id_gaussianReal] at h
  simp only [id_eq, integral_id_gaussianReal, sub_zero] at h
  have hsub : {y : ℝ | a < ‖y‖} ⊆ {y : ℝ | a ≤ |y|} := fun y hy => by
    simp only [Set.mem_setOf_eq, Real.norm_eq_abs] at hy ⊢; exact hy.le
  rw [measureReal_def]
  refine ENNReal.toReal_le_of_le_ofReal (by positivity) ?_
  exact (measure_mono hsub).trans h

/-- The smoothing weight `min(1, |φ_K(2πξ)|/|ξ|)` is integrable for the Gaussian kernel. -/
theorem integrable_gaussian_weight {v : NNReal} (hv : v ≠ 0) :
    Integrable (fun ξ : ℝ => min 1 (‖charFun (gaussianReal 0 v) (2 * π * ξ)‖ / |ξ|)) := by
  have hv0 : (0 : ℝ) < v := NNReal.coe_pos.mpr (pos_iff_ne_zero.mpr hv)
  have hb : (0 : ℝ) < 2 * π ^ 2 * v := by positivity
  have hmeas : Measurable fun ξ : ℝ => min 1 (‖charFun (gaussianReal 0 v) (2 * π * ξ)‖ / |ξ|) := by
    refine measurable_const.min ?_
    have h2 : Continuous fun ξ : ℝ => 2 * π * ξ := by fun_prop
    exact (continuous_charFun.comp h2).norm.measurable.div continuous_abs.measurable
  have hdom : Integrable (fun ξ : ℝ => (Set.Icc (-1 : ℝ) 1).indicator (fun _ => (1 : ℝ)) ξ
      + Real.exp (-(2 * π ^ 2 * v) * ξ ^ 2)) :=
    ((integrableOn_const (by rw [Real.volume_Icc]; exact ENNReal.ofReal_ne_top)).integrable_indicator
      measurableSet_Icc).add (integrable_exp_neg_mul_sq hb)
  refine hdom.mono' hmeas.aestronglyMeasurable (Filter.Eventually.of_forall fun ξ => ?_)
  have hh : 0 ≤ ‖charFun (gaussianReal 0 v) (2 * π * ξ)‖ / |ξ| := by positivity
  rw [Real.norm_of_nonneg (le_min zero_le_one hh)]
  have hexp : ‖charFun (gaussianReal 0 v) (2 * π * ξ)‖ = Real.exp (-(2 * π ^ 2 * v) * ξ ^ 2) := by
    rw [norm_charFun_gaussianReal]; congr 1; ring
  rcases le_or_gt |ξ| 1 with hξ | hξ
  · have hmem : ξ ∈ Set.Icc (-1 : ℝ) 1 := abs_le.mp hξ
    rw [Set.indicator_of_mem hmem]
    exact (min_le_left _ _).trans (le_add_of_nonneg_right (Real.exp_nonneg _))
  · have hmem : ξ ∉ Set.Icc (-1 : ℝ) 1 := fun h => absurd (abs_le.mpr h) (not_le.mpr hξ)
    rw [Set.indicator_of_notMem hmem, zero_add, ← hexp]
    exact (min_le_right _ _).trans (div_le_self (norm_nonneg _) hξ.le)

/-- **Esseen's inequality with a Gaussian kernel** `N(0, v)`: for probability measures `μ, ν`
on `ℝ` with `F_ν` `m`-Lipschitz, every `a > 0` and `v ≠ 0`,
`|F_μ(x₀) − F_ν(x₀)| (1 − v/a²) ≤ 2 ∫ e^{−v(2πξ)²/2}/(π|ξ|) · |φ_μ(2πξ) − φ_ν(2πξ)| dξ + 2ma + v/a²`.
-/
theorem esseen_inequality_gaussian (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] {m : ℝ} (hm : 0 ≤ m)
    (hG : ∀ x y, x ≤ y → cdfR ν y - cdfR ν x ≤ m * (y - x)) {v : NNReal} (hv : v ≠ 0)
    {a : ℝ} (ha : 0 < a)
    (hI : Integrable (fun ξ : ℝ => Real.exp (-(v * (2 * π * ξ) ^ 2 / 2)) / (π * |ξ|)
      * ‖charFun μ (2 * π * ξ) - charFun ν (2 * π * ξ)‖)) (x₀ : ℝ) :
    |cdfR μ x₀ - cdfR ν x₀| * (1 - v / a ^ 2)
      ≤ 2 * (∫ ξ, Real.exp (-(v * (2 * π * ξ) ^ 2 / 2)) / (π * |ξ|)
          * ‖charFun μ (2 * π * ξ) - charFun ν (2 * π * ξ)‖) + 2 * m * a + v / a ^ 2 := by
  haveI := nullSingletonClass_gaussianReal hv
  have h := esseen_inequality μ ν (gaussianReal 0 v) hm hG ha.le (gaussianReal_real_tail_le v ha)
    (integrable_gaussian_weight hv) (by simpa only [norm_charFun_gaussianReal] using hI) x₀
  simpa only [norm_charFun_gaussianReal] using h

end EsseenGaussian

/-!
# §43  The Fejér kernel: Esseen's inequality band-limited to `|t| < 2πT`

§42 proves Esseen's inequality for an arbitrary atomless kernel `K`.  A rate for a lattice law
such as the coordinate law of `H D_ε v` needs a kernel whose characteristic function vanishes
beyond a cutoff, so that only the range where the §40 bound holds enters.  This section builds
that kernel and sharpens the lemma so that the tail term scales with the gap itself.

* `esseen_lemma'`, `esseen_sup`: Esseen's lemma with the tail term `η ε`, `η` a bound on the
  distribution-function gap, and its supremum form
  `|F_μ(x₀) − F_ν(x₀)| (1 − 2ε) ≤ 2I + 2ma` with `I` a bound on the smoothed gap.  The
  supremum `⨆ x, |F_μ x − F_ν x|` replaces the crude bound `1` used in §42.
* `tri T ξ = (1 − |ξ|/T)₊` is the triangle; its Fourier transform is computed exactly by the
  fundamental theorem of calculus with the antiderivative `(α + βξ) e^{cξ}`:
  `𝓕 tri_T (y) = (1 − cos(2πTy))/(2π²Ty²)` for `y ≠ 0` (`fourier_triC`).
* `fejerDensity T y = ‖𝓕 tri_T(y)‖` is nonnegative, continuous, at most `2T`, at most
  `1/(π²Ty²)`, integrable, and integrates to `1` by Fourier inversion at the origin.
* `fejer T` is the probability measure with that density: atomless, with characteristic
  function the triangle `tri T (t/(2π))` (Fourier inversion, `charFun_fejer`), tail
  `K_T{|y| > a} ≤ 2/(π²Ta)` (`fejer_real_tail_le`), and integrable smoothing weight.
* `esseen_inequality_fejer`: the assembled inequality
  `|F_μ(x₀) − F_ν(x₀)| (1 − 4/(π²Ta)) ≤ 2 ∫ (1 − |ξ|/T)₊/(π|ξ|) · |φ_μ(2πξ) − φ_ν(2πξ)| dξ + 2ma`,
  in which only `|2πξ| < 2πT` enters.

What this does **not** yet give is the Kolmogorov–Smirnov rate for the coordinate law of
`H D_ε v`.  Feeding the §40 bound `t⁴ ∑ⱼ vⱼ⁴/(3d²)` into the integral with `2πT = √d` gives a
constant, not a rate: the §40 bound has no Gaussian damping and its range `|t| ≤ √d` is the
range `|t·max_j |vⱼ|| ≤ 1` only for the worst direction.  A rate needs the damped form
`|φ(t) − e^{−σ²t²/2}| ≤ C t⁴ ∑ⱼ aⱼ⁴ e^{−σ²t²/4}` on `|t aⱼ| ≤ 1`, which is not proved here.
-/

open Filter
open scoped Topology FourierTransform

section EsseenSup

theorem esseen_lemma' (μ ν K : Measure ℝ) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    [IsProbabilityMeasure K] {m : ℝ} (hm : 0 ≤ m)
    (hG : ∀ x y, x ≤ y → cdfR ν y - cdfR ν x ≤ m * (y - x)) {a ε : ℝ} (ha : 0 ≤ a)
    (hε : K.real {y | a < ‖y‖} ≤ ε) {η : ℝ} (hη : ∀ z, |cdfR μ z - cdfR ν z| ≤ η) (x₀ : ℝ) :
    |cdfR μ x₀ - cdfR ν x₀| * (1 - ε)
      ≤ |smoothDiff μ ν K (x₀ + a)| + |smoothDiff μ ν K (x₀ - a)| + 2 * m * a + η * ε := by
  set Δ : ℝ → ℝ := fun z => cdfR μ z - cdfR ν z with hΔ
  have hΔm : Measurable Δ := (measurable_cdfR μ).sub (measurable_cdfR ν)
  have hΔb : ∀ z, |Δ z| ≤ η := hη
  have hη0 : 0 ≤ η := (abs_nonneg _).trans (hη 0)
  have hε0 : 0 ≤ K.real {y | a < ‖y‖} := measureReal_nonneg
  have hset : MeasurableSet {y : ℝ | a < ‖y‖} := measurableSet_lt measurable_const measurable_norm
  set ε' := K.real {y | a < ‖y‖} with hε'
  have hcompl : K.real {y : ℝ | ‖y‖ ≤ a} = 1 - ε' := by
    have : {y : ℝ | ‖y‖ ≤ a} = {y : ℝ | a < ‖y‖}ᶜ := by
      ext y; simp [not_lt]
    rw [this, measureReal_compl hset, measureReal_def, measure_univ, ENNReal.toReal_one]
  have hε1 : ε' ≤ 1 := by
    have := measureReal_nonneg (μ := K) (s := {y : ℝ | ‖y‖ ≤ a}); linarith
  -- the two directional lower/upper bounds on `Δ` near `x₀`
  have hup : ∀ s, 0 ≤ s → s ≤ 2 * a → Δ x₀ - 2 * m * a ≤ Δ (x₀ + s) := by
    intro s hs hs2
    have h1 : cdfR μ x₀ ≤ cdfR μ (x₀ + s) := cdfR_mono μ (by linarith)
    have h2 := hG x₀ (x₀ + s) (by linarith)
    rw [hΔ]; simp only
    have : m * (x₀ + s - x₀) ≤ 2 * m * a := by
      rw [show x₀ + s - x₀ = s by ring]; nlinarith
    linarith
  have hdown : ∀ s, 0 ≤ s → s ≤ 2 * a → Δ (x₀ - s) ≤ Δ x₀ + 2 * m * a := by
    intro s hs hs2
    have h1 : cdfR μ (x₀ - s) ≤ cdfR μ x₀ := cdfR_mono μ (by linarith)
    have h2 := hG (x₀ - s) x₀ (by linarith)
    rw [hΔ]; simp only
    have : m * (x₀ - (x₀ - s)) ≤ 2 * m * a := by
      rw [show x₀ - (x₀ - s) = s by ring]; nlinarith
    linarith
  -- integrability of the shifted differences and of the two-valued comparison functions
  have hint : ∀ x, Integrable (fun y => Δ (x - y)) K := fun x =>
    Integrable.of_bound (hΔm.comp (measurable_const.sub measurable_id)).aestronglyMeasurable η
      (Filter.Eventually.of_forall fun y => by rw [Real.norm_eq_abs]; exact hΔb _)
  have hstep : ∀ c : ℝ, Integrable (fun y : ℝ => {y : ℝ | ‖y‖ ≤ a}.indicator (fun _ => c) y
      + {y : ℝ | a < ‖y‖}.indicator (fun _ => -η) y) K :=
    fun c => ((integrable_const c).indicator (measurableSet_le measurable_norm measurable_const)).add
      ((integrable_const _).indicator hset)
  have hstep_int : ∀ c : ℝ, ∫ y, ({y : ℝ | ‖y‖ ≤ a}.indicator (fun _ => c) y
      + {y : ℝ | a < ‖y‖}.indicator (fun _ => -η) y) ∂K = c * (1 - ε') - η * ε' := by
    intro c
    rw [integral_add ((integrable_const c).indicator (measurableSet_le measurable_norm measurable_const))
      ((integrable_const _).indicator hset), integral_indicator_const _
      (measurableSet_le measurable_norm measurable_const), integral_indicator_const _ hset, hcompl]
    simp only [smul_eq_mul]
    ring
  rcases le_or_gt 1 ε with hε1' | hε1'
  · -- trivial: the left side is nonpositive
    have : |Δ x₀| * (1 - ε) ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (abs_nonneg _) (by linarith)
    have h0 : 0 ≤ |smoothDiff μ ν K (x₀ + a)| + |smoothDiff μ ν K (x₀ - a)| + 2 * m * a + η * ε := by
      have := abs_nonneg (smoothDiff μ ν K (x₀ + a)); have := abs_nonneg (smoothDiff μ ν K (x₀ - a))
      have := mul_nonneg hm ha; have := mul_nonneg hη0 (hε0.trans hε); nlinarith
    linarith
  rcases le_or_gt 0 (Δ x₀) with hD | hD
  · -- `Δ x₀ ≥ 0`: look to the right
    have hpt : ∀ y, {y : ℝ | ‖y‖ ≤ a}.indicator (fun _ => Δ x₀ - 2 * m * a) y
        + {y : ℝ | a < ‖y‖}.indicator (fun _ => -η) y ≤ Δ (x₀ + a - y) := by
      intro y
      by_cases hy : ‖y‖ ≤ a
      · rw [Set.indicator_of_mem (by exact hy), Set.indicator_of_notMem (by
          show ¬ a < ‖y‖; exact not_lt.mpr hy), add_zero]
        rw [Real.norm_eq_abs, abs_le] at hy
        rw [show x₀ + a - y = x₀ + (a - y) by ring]
        exact hup (a - y) (by linarith) (by linarith)
      · rw [Set.indicator_of_notMem (by exact hy), Set.indicator_of_mem (by
          show a < ‖y‖; exact not_le.mp hy), zero_add]
        exact (abs_le.mp (hΔb _)).1
    have hle : Δ x₀ * (1 - ε') - 2 * m * a * (1 - ε') - η * ε' ≤ smoothDiff μ ν K (x₀ + a) := by
      have := integral_mono (hstep _) (hint (x₀ + a)) hpt
      rw [hstep_int] at this
      unfold smoothDiff
      linarith
    have habs : smoothDiff μ ν K (x₀ + a) ≤ |smoothDiff μ ν K (x₀ + a)| := le_abs_self _
    have h1 : |Δ x₀| = Δ x₀ := abs_of_nonneg hD
    rw [h1]
    have h2 : Δ x₀ * (1 - ε) ≤ Δ x₀ * (1 - ε') := mul_le_mul_of_nonneg_left (by linarith) hD
    have h3 : 0 ≤ |smoothDiff μ ν K (x₀ - a)| := abs_nonneg _
    nlinarith [mul_nonneg hm ha, mul_nonneg (mul_nonneg hm ha) hε0, mul_le_mul_of_nonneg_left hε hη0]
  · -- `Δ x₀ < 0`: look to the left
    have hpt : ∀ y, Δ (x₀ - a - y) ≤ {y : ℝ | ‖y‖ ≤ a}.indicator (fun _ => Δ x₀ + 2 * m * a) y
        + {y : ℝ | a < ‖y‖}.indicator (fun _ => η) y := by
      intro y
      by_cases hy : ‖y‖ ≤ a
      · rw [Set.indicator_of_mem (by exact hy), Set.indicator_of_notMem (by
          show ¬ a < ‖y‖; exact not_lt.mpr hy), add_zero]
        rw [Real.norm_eq_abs, abs_le] at hy
        rw [show x₀ - a - y = x₀ - (a + y) by ring]
        exact hdown (a + y) (by linarith) (by linarith)
      · rw [Set.indicator_of_notMem (by exact hy), Set.indicator_of_mem (by
          show a < ‖y‖; exact not_le.mp hy), zero_add]
        exact (abs_le.mp (hΔb _)).2
    have hstep' : Integrable (fun y : ℝ => {y : ℝ | ‖y‖ ≤ a}.indicator (fun _ => Δ x₀ + 2 * m * a) y
        + {y : ℝ | a < ‖y‖}.indicator (fun _ => η) y) K :=
      ((integrable_const _).indicator (measurableSet_le measurable_norm measurable_const)).add
        ((integrable_const _).indicator hset)
    have hle : smoothDiff μ ν K (x₀ - a) ≤ (Δ x₀ + 2 * m * a) * (1 - ε') + η * ε' := by
      have := integral_mono (hint (x₀ - a)) hstep' hpt
      rw [integral_add ((integrable_const _).indicator (measurableSet_le measurable_norm measurable_const))
        ((integrable_const _).indicator hset), integral_indicator_const _
        (measurableSet_le measurable_norm measurable_const), integral_indicator_const _ hset,
        hcompl] at this
      simp only [smul_eq_mul] at this
      unfold smoothDiff
      linarith
    have habs : -|smoothDiff μ ν K (x₀ - a)| ≤ smoothDiff μ ν K (x₀ - a) := neg_abs_le _
    have h1 : |Δ x₀| = -Δ x₀ := abs_of_neg hD
    rw [h1]
    have h2 : -Δ x₀ * (1 - ε) ≤ -Δ x₀ * (1 - ε') :=
      mul_le_mul_of_nonneg_left (by linarith) (by linarith)
    have h3 : 0 ≤ |smoothDiff μ ν K (x₀ + a)| := abs_nonneg _
    nlinarith [mul_nonneg hm ha, mul_nonneg (mul_nonneg hm ha) hε0, mul_le_mul_of_nonneg_left hε hη0]


/-- **Esseen's lemma, supremum form**: with `I` a bound on the smoothed gap and `ε` the kernel tail,
`|F_μ(x₀) − F_ν(x₀)| (1 − 2ε) ≤ 2I + 2ma` for every `x₀`. -/
theorem esseen_sup (μ ν K : Measure ℝ) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    [IsProbabilityMeasure K] {m : ℝ} (hm : 0 ≤ m)
    (hG : ∀ x y, x ≤ y → cdfR ν y - cdfR ν x ≤ m * (y - x)) {a ε : ℝ} (ha : 0 ≤ a)
    (hε : K.real {y | a < ‖y‖} ≤ ε) {I : ℝ} (hD : ∀ x, |smoothDiff μ ν K x| ≤ I) (x₀ : ℝ) :
    |cdfR μ x₀ - cdfR ν x₀| * (1 - 2 * ε) ≤ 2 * I + 2 * m * a := by
  have hI : 0 ≤ I := (abs_nonneg _).trans (hD 0)
  have hma : 0 ≤ m * a := mul_nonneg hm ha
  rcases le_or_gt (1 - 2 * ε) 0 with hneg | hpos
  · have : |cdfR μ x₀ - cdfR ν x₀| * (1 - 2 * ε) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos (abs_nonneg _) hneg
    linarith
  have hε1 : 0 < 1 - ε := by linarith
  set Δ : ℝ → ℝ := fun z => |cdfR μ z - cdfR ν z| with hΔ
  have hΔb : ∀ z, Δ z ≤ 1 := fun z => by
    rw [hΔ]; simp only
    rw [abs_le]
    have := cdfR_nonneg μ z; have := cdfR_le_one μ z
    have := cdfR_nonneg ν z; have := cdfR_le_one ν z
    constructor <;> linarith
  have hbdd : BddAbove (Set.range Δ) := ⟨1, by rintro _ ⟨z, rfl⟩; exact hΔb z⟩
  set η := ⨆ z, Δ z with hη
  have hle : ∀ z, Δ z ≤ η := fun z => le_ciSup hbdd z
  have hpt : ∀ x, Δ x ≤ (2 * I + 2 * m * a + η * ε) / (1 - ε) := by
    intro x
    rw [le_div_iff₀ hε1]
    have h := esseen_lemma' μ ν K hm hG ha hε hle x
    have h1 := hD (x + a); have h2 := hD (x - a)
    linarith
  have hsup : η ≤ (2 * I + 2 * m * a + η * ε) / (1 - ε) := ciSup_le hpt
  rw [le_div_iff₀ hε1] at hsup
  have hη' : η * (1 - 2 * ε) ≤ 2 * I + 2 * m * a := by linarith
  calc |cdfR μ x₀ - cdfR ν x₀| * (1 - 2 * ε) ≤ η * (1 - 2 * ε) :=
        mul_le_mul_of_nonneg_right (hle x₀) hpos.le
    _ ≤ 2 * I + 2 * m * a := hη'

end EsseenSup


section Fejer

/-- The triangle function of half-width `T`: `(1 − |ξ|/T)₊`. -/
noncomputable def tri (T ξ : ℝ) : ℝ := max 0 (1 - |ξ| / T)

theorem tri_nonneg (T ξ : ℝ) : 0 ≤ tri T ξ := le_max_left _ _

theorem tri_le_one {T : ℝ} (hT : 0 < T) (ξ : ℝ) : tri T ξ ≤ 1 :=
  max_le zero_le_one (by have := div_nonneg (abs_nonneg ξ) hT.le; linarith)

theorem tri_eq_zero {T : ℝ} (hT : 0 < T) {ξ : ℝ} (h : T ≤ |ξ|) : tri T ξ = 0 :=
  max_eq_left (by rw [sub_nonpos, le_div_iff₀ hT, one_mul]; exact h)

theorem tri_of_abs_le {T : ℝ} (hT : 0 < T) {ξ : ℝ} (h : |ξ| ≤ T) : tri T ξ = 1 - |ξ| / T :=
  max_eq_right (by rw [sub_nonneg, div_le_one hT]; exact h)

theorem tri_zero {T : ℝ} (hT : 0 < T) : tri T 0 = 1 := by
  rw [tri_of_abs_le hT (by rw [abs_zero]; exact hT.le), abs_zero, zero_div, sub_zero]

theorem continuous_tri (T : ℝ) : Continuous (tri T) :=
  continuous_const.max (continuous_const.sub (continuous_abs.div_const T))

theorem support_tri_subset {T : ℝ} (hT : 0 < T) :
    Function.support (tri T) ⊆ Set.Icc (-T) T := fun ξ hξ => by
  rw [Function.mem_support] at hξ
  by_contra h
  rw [Set.mem_Icc, ← abs_le, not_le] at h
  exact hξ (tri_eq_zero hT h.le)

theorem hasCompactSupport_tri {T : ℝ} (hT : 0 < T) : HasCompactSupport (tri T) :=
  HasCompactSupport.of_support_subset_isCompact isCompact_Icc (support_tri_subset hT)

/-- The triangle as a complex-valued function. -/
noncomputable def triC (T ξ : ℝ) : ℂ := (tri T ξ : ℂ)

theorem continuous_triC (T : ℝ) : Continuous (triC T) :=
  Complex.continuous_ofReal.comp (continuous_tri T)

theorem hasCompactSupport_triC {T : ℝ} (hT : 0 < T) : HasCompactSupport (triC T) :=
  (hasCompactSupport_tri hT).comp_left Complex.ofReal_zero

theorem integrable_triC {T : ℝ} (hT : 0 < T) : Integrable (triC T) :=
  (continuous_triC T).integrable_of_hasCompactSupport (hasCompactSupport_triC hT)

theorem norm_triC_le {T : ℝ} (hT : 0 < T) (ξ : ℝ) :
    ‖triC T ξ‖ ≤ (Set.Icc (-T) T).indicator (fun _ => (1 : ℝ)) ξ := by
  rw [triC, Complex.norm_real, Real.norm_of_nonneg (tri_nonneg T ξ)]
  by_cases h : ξ ∈ Set.Icc (-T) T
  · rw [Set.indicator_of_mem h]; exact tri_le_one hT ξ
  · rw [Set.indicator_of_notMem h]
    rw [Set.mem_Icc, ← abs_le, not_le] at h
    rw [tri_eq_zero hT h.le]

/-- Derivative of `(α + βξ) e^{cξ}` along the real line. -/
theorem hasDerivAt_affine_mul_exp (α β c : ℂ) (ξ : ℝ) :
    HasDerivAt (fun ξ : ℝ => (α + β * ξ) * Complex.exp (c * ξ))
      ((β + (α + β * ξ) * c) * Complex.exp (c * ξ)) ξ := by
  have h1 : HasDerivAt (fun ξ : ℝ => α + β * (ξ : ℂ)) β ξ := by
    have := ((hasDerivAt_id ξ).ofReal_comp.const_mul β).const_add α
    simpa using this
  have h2 : HasDerivAt (fun ξ : ℝ => Complex.exp (c * ξ)) (Complex.exp (c * ξ) * c) ξ := by
    have := ((Complex.hasDerivAt_exp (c * ↑ξ)).comp (↑ξ : ℂ)
      ((hasDerivAt_id (↑ξ : ℂ)).const_mul c)).comp_ofReal
    simpa [Function.comp] using this
  exact (h1.mul h2).congr_deriv (by ring)

/-- **Fourier transform of the triangle**, `y ≠ 0`:
`𝓕 tri_T (y) = (1 − cos(2πTy)) / (2π²Ty²)`. -/
theorem fourier_triC {T : ℝ} (hT : 0 < T) {y : ℝ} (hy : y ≠ 0) :
    𝓕 (triC T) y = (((1 - Real.cos (2 * π * T * y)) / (2 * π ^ 2 * T * y ^ 2) : ℝ) : ℂ) := by
  set c : ℂ := ↑(-(2 * π * y)) * Complex.I with hc
  have h2πy : (2 * π * y : ℝ) ≠ 0 := by positivity
  have hc0 : c ≠ 0 := by
    rw [hc]
    refine mul_ne_zero ?_ Complex.I_ne_zero
    exact_mod_cast neg_ne_zero.mpr h2πy
  have hT0 : (T : ℂ) ≠ 0 := by exact_mod_cast hT.ne'
  have hexp : ∀ ξ : ℝ, Complex.exp (↑(-2 * π * inner ℝ ξ y) * Complex.I) = Complex.exp (c * ξ) := by
    intro ξ
    congr 1
    simp only [RCLike.inner_apply, conj_trivial, hc]
    push_cast
    ring
  have hF : Continuous fun ξ : ℝ => Complex.exp (c * ξ) * triC T ξ :=
    (by fun_prop : Continuous fun ξ : ℝ => Complex.exp (c * ξ)).mul (continuous_triC T)
  -- the two halves, by the fundamental theorem of calculus
  have hright : ∫ ξ in (0 : ℝ)..T, Complex.exp (c * ξ) * triC T ξ
      = Complex.exp (c * T) / (T * c ^ 2) - (1 / c + 1 / (T * c ^ 2)) := by
    have hcongr : Set.EqOn (fun ξ : ℝ => Complex.exp (c * ξ) * triC T ξ)
        (fun ξ : ℝ => ((1 / c + 1 / (T * c ^ 2)) + (-1 / (T * c)) * ξ) * Complex.exp (c * ξ)
          * (0 : ℂ) + (1 + (-1 / T) * ξ) * Complex.exp (c * ξ)) (Set.uIcc 0 T) := by
      intro ξ hξ
      rw [Set.uIcc_of_le hT.le, Set.mem_Icc] at hξ
      simp only [triC]
      rw [tri_of_abs_le hT (by rw [abs_of_nonneg hξ.1]; exact hξ.2), abs_of_nonneg hξ.1]
      push_cast
      ring
    rw [intervalIntegral.integral_congr hcongr]
    have hder : ∀ ξ ∈ Set.uIcc (0 : ℝ) T,
        HasDerivAt (fun ξ : ℝ => ((1 / c + 1 / (T * c ^ 2)) + (-1 / (T * c)) * ξ) * Complex.exp (c * ξ))
          (((1 / c + 1 / (T * c ^ 2)) + (-1 / (T * c)) * ξ) * Complex.exp (c * ξ) * (0 : ℂ)
            + (1 + (-1 / T) * ξ) * Complex.exp (c * ξ)) ξ := by
      intro ξ _
      refine (hasDerivAt_affine_mul_exp _ _ c ξ).congr_deriv ?_
      field_simp
      ring
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hder (by
      refine Continuous.intervalIntegrable ?_ _ _
      fun_prop)]
    push_cast
    simp only [mul_zero, Complex.exp_zero]
    field_simp
    ring
  have hleft : ∫ ξ in (-T : ℝ)..0, Complex.exp (c * ξ) * triC T ξ
      = (1 / c - 1 / (T * c ^ 2)) - (1 / c - 1 / (T * c ^ 2) - 1 / c) * Complex.exp (c * (-T : ℝ)) := by
    have hcongr : Set.EqOn (fun ξ : ℝ => Complex.exp (c * ξ) * triC T ξ)
        (fun ξ : ℝ => ((1 / c - 1 / (T * c ^ 2)) + (1 / (T * c)) * ξ) * Complex.exp (c * ξ)
          * (0 : ℂ) + (1 + (1 / T) * ξ) * Complex.exp (c * ξ)) (Set.uIcc (-T) 0) := by
      intro ξ hξ
      rw [Set.uIcc_of_le (by linarith), Set.mem_Icc] at hξ
      simp only [triC]
      rw [tri_of_abs_le hT (by rw [abs_of_nonpos hξ.2]; linarith), abs_of_nonpos hξ.2]
      push_cast
      ring
    rw [intervalIntegral.integral_congr hcongr]
    have hder : ∀ ξ ∈ Set.uIcc (-T : ℝ) 0,
        HasDerivAt (fun ξ : ℝ => ((1 / c - 1 / (T * c ^ 2)) + (1 / (T * c)) * ξ) * Complex.exp (c * ξ))
          (((1 / c - 1 / (T * c ^ 2)) + (1 / (T * c)) * ξ) * Complex.exp (c * ξ) * (0 : ℂ)
            + (1 + (1 / T) * ξ) * Complex.exp (c * ξ)) ξ := by
      intro ξ _
      refine (hasDerivAt_affine_mul_exp _ _ c ξ).congr_deriv ?_
      field_simp
      ring
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hder (by
      refine Continuous.intervalIntegrable ?_ _ _
      fun_prop)]
    push_cast
    simp only [mul_zero, Complex.exp_zero]
    field_simp
    ring
  have hsplit : 𝓕 (triC T) y = ∫ ξ in (-T : ℝ)..T, Complex.exp (c * ξ) * triC T ξ := by
    rw [Real.fourier_eq']
    simp_rw [hexp, smul_eq_mul]
    rw [← setIntegral_eq_integral_of_forall_compl_eq_zero (s := Set.Icc (-T) T) (fun ξ hξ => by
      have : tri T ξ = 0 := by
        rw [Set.mem_Icc, ← abs_le, not_le] at hξ
        exact tri_eq_zero hT hξ.le
      simp [triC, this]), integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le (by linarith)]
  rw [hsplit, ← intervalIntegral.integral_add_adjacent_intervals (hF.intervalIntegrable _ _)
    (hF.intervalIntegrable _ _), hleft, hright]
  -- `e^{cT} + e^{−cT} = 2 cos(2πTy)`
  have hcos : Complex.exp (c * T) + Complex.exp (c * (-T : ℝ)) = 2 * Complex.cos (↑(2 * π * T * y)) := by
    rw [Complex.two_cos]
    have e1 : c * (T : ℂ) = -↑(2 * π * T * y) * Complex.I := by rw [hc]; push_cast; ring
    have e2 : c * ((-T : ℝ) : ℂ) = ↑(2 * π * T * y) * Complex.I := by rw [hc]; push_cast; ring
    rw [e1, e2, add_comm]
  have hc2 : c ^ 2 = -((4 * π ^ 2 * y ^ 2 : ℝ) : ℂ) := by
    rw [hc]; push_cast; ring_nf; rw [Complex.I_sq]; ring
  have hy2 : (4 * π ^ 2 * y ^ 2 : ℂ) ≠ 0 := by
    have : (4 * π ^ 2 * y ^ 2 : ℝ) ≠ 0 := by positivity
    exact_mod_cast this
  have hden : (2 * π ^ 2 * T * y ^ 2 : ℂ) ≠ 0 := by
    have : (2 * π ^ 2 * T * y ^ 2 : ℝ) ≠ 0 := by positivity
    exact_mod_cast this
  have key : (1 / c - 1 / (T * c ^ 2)) - (1 / c - 1 / (T * c ^ 2) - 1 / c) * Complex.exp (c * (-T : ℝ))
      + (Complex.exp (c * T) / (T * c ^ 2) - (1 / c + 1 / (T * c ^ 2)))
      = (Complex.exp (c * T) + Complex.exp (c * (-T : ℝ)) - 2) / (T * c ^ 2) := by
    field_simp
    ring
  rw [key, hcos, hc2]
  push_cast
  field_simp
  ring

/-- The Fejér density, `‖𝓕 tri_T(y)‖`. -/
noncomputable def fejerDensity (T y : ℝ) : ℝ := ‖𝓕 (triC T) y‖

theorem fejerDensity_nonneg (T y : ℝ) : 0 ≤ fejerDensity T y := norm_nonneg _

theorem continuous_fejerDensity {T : ℝ} (hT : 0 < T) : Continuous (fejerDensity T) :=
  (VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar (innerSL ℝ).continuous₂
    (integrable_triC hT)).norm

theorem fejerDensity_eq {T : ℝ} (hT : 0 < T) {y : ℝ} (hy : y ≠ 0) :
    fejerDensity T y = (1 - Real.cos (2 * π * T * y)) / (2 * π ^ 2 * T * y ^ 2) := by
  rw [fejerDensity, fourier_triC hT hy, Complex.norm_real, Real.norm_of_nonneg]
  exact div_nonneg (by linarith [Real.cos_le_one (2 * π * T * y)]) (by positivity)

theorem ofReal_fejerDensity {T : ℝ} (hT : 0 < T) {y : ℝ} (hy : y ≠ 0) :
    ((fejerDensity T y : ℝ) : ℂ) = 𝓕 (triC T) y := by
  rw [fejerDensity_eq hT hy, fourier_triC hT hy]

/-- The Fejér density decays like `1/(π²T y²)`. -/
theorem fejerDensity_le_inv {T : ℝ} (hT : 0 < T) {y : ℝ} (hy : y ≠ 0) :
    fejerDensity T y ≤ 1 / (π ^ 2 * T) * (y ^ 2)⁻¹ := by
  rw [fejerDensity_eq hT hy]
  have h1 : 1 - Real.cos (2 * π * T * y) ≤ 2 := by linarith [Real.neg_one_le_cos (2 * π * T * y)]
  have hp : 0 < 2 * π ^ 2 * T * y ^ 2 := by positivity
  calc (1 - Real.cos (2 * π * T * y)) / (2 * π ^ 2 * T * y ^ 2) ≤ 2 / (2 * π ^ 2 * T * y ^ 2) :=
        div_le_div_of_nonneg_right h1 hp.le
    _ = 1 / (π ^ 2 * T) * (y ^ 2)⁻¹ := by field_simp

theorem fejerDensity_le_two_mul {T : ℝ} (hT : 0 < T) (y : ℝ) : fejerDensity T y ≤ 2 * T := by
  refine (VectorFourier.norm_fourierIntegral_le_integral_norm _ _ _ _ _).trans ?_
  calc ∫ ξ, ‖triC T ξ‖ ≤ ∫ ξ, (Set.Icc (-T) T).indicator (fun _ => (1 : ℝ)) ξ :=
        integral_mono (integrable_triC hT).norm ((integrableOn_const (by
          rw [Real.volume_Icc]; exact ENNReal.ofReal_ne_top)).integrable_indicator measurableSet_Icc)
          (norm_triC_le hT)
    _ = 2 * T := by
        rw [integral_indicator_const _ measurableSet_Icc, smul_eq_mul, mul_one, measureReal_def,
          Real.volume_Icc, ENNReal.toReal_ofReal (by linarith)]
        ring

theorem integrable_fejerDensity {T : ℝ} (hT : 0 < T) : Integrable (fejerDensity T) := by
  set C := max (4 * T) (2 / (π ^ 2 * T)) with hC
  refine (integrable_inv_one_add_sq.const_mul C).mono'
    (continuous_fejerDensity hT).aestronglyMeasurable (Filter.Eventually.of_forall fun y => ?_)
  rw [Real.norm_of_nonneg (fejerDensity_nonneg T y)]
  have h1y : 0 < 1 + y ^ 2 := by positivity
  rcases le_or_gt |y| 1 with hy | hy
  · have hy2 : y ^ 2 ≤ 1 := by rw [← sq_abs]; nlinarith [abs_nonneg y]
    calc fejerDensity T y ≤ 2 * T := fejerDensity_le_two_mul hT y
      _ ≤ 4 * T * (1 + y ^ 2)⁻¹ := by rw [le_mul_inv_iff₀ h1y]; nlinarith
      _ ≤ C * (1 + y ^ 2)⁻¹ := by gcongr; exact le_max_left _ _
  · have hy0 : y ≠ 0 := by intro h; rw [h, abs_zero] at hy; linarith
    have hy2 : 1 ≤ y ^ 2 := by rw [← sq_abs]; nlinarith
    have hπT : 0 < π ^ 2 * T := by positivity
    calc fejerDensity T y ≤ 1 / (π ^ 2 * T) * (y ^ 2)⁻¹ := fejerDensity_le_inv hT hy0
      _ ≤ 2 / (π ^ 2 * T) * (1 + y ^ 2)⁻¹ := by
          rw [show 1 / (π ^ 2 * T) * (y ^ 2)⁻¹ = 1 / (π ^ 2 * T * y ^ 2) by field_simp,
            show 2 / (π ^ 2 * T) * (1 + y ^ 2)⁻¹ = 2 / (π ^ 2 * T * (1 + y ^ 2)) by field_simp,
            div_le_div_iff₀ (by positivity) (by positivity)]
          nlinarith
      _ ≤ C * (1 + y ^ 2)⁻¹ := by gcongr; exact le_max_right _ _

theorem integrable_fourier_triC {T : ℝ} (hT : 0 < T) : Integrable (𝓕 (triC T)) := by
  refine (integrable_fejerDensity hT).ofReal.congr ?_
  filter_upwards [Measure.ae_ne volume (0 : ℝ)] with y hy
  exact ofReal_fejerDensity hT hy

/-- Fourier inversion for the triangle. -/
theorem fourierInv_fourier_triC {T : ℝ} (hT : 0 < T) : 𝓕⁻ (𝓕 (triC T)) = triC T :=
  (continuous_triC T).fourierInv_fourier_eq (integrable_triC hT) (integrable_fourier_triC hT)

/-- The Fejér density integrates to `1` (Fourier inversion at the origin). -/
theorem integral_fejerDensity {T : ℝ} (hT : 0 < T) : ∫ y, fejerDensity T y = 1 := by
  have h := congrFun (fourierInv_fourier_triC hT) 0
  rw [Real.fourierInv_eq'] at h
  simp only [inner_zero_right, mul_zero, Complex.ofReal_zero, zero_mul, Complex.exp_zero,
    one_smul] at h
  have h2 : ∫ v, 𝓕 (triC T) v = ((∫ y, fejerDensity T y : ℝ) : ℂ) := by
    rw [← integral_complex_ofReal]
    refine integral_congr_ae ?_
    filter_upwards [Measure.ae_ne volume (0 : ℝ)] with y hy
    exact (ofReal_fejerDensity hT hy).symm
  rw [h2, triC, tri_zero hT] at h
  exact_mod_cast h

/-- **The Fejér kernel** of half-width `T`: the probability measure with density
`(1 − cos(2πTy))/(2π²Ty²)`, whose characteristic function is the triangle `(1 − |t|/(2πT))₊`. -/
noncomputable def fejer (T : ℝ) : Measure ℝ :=
  volume.withDensity fun y => ((fejerDensity T y).toNNReal : ℝ≥0∞)

instance (T : ℝ) : NullSingletonClass (fejer T) := by unfold fejer; infer_instance

theorem integral_fejer {T : ℝ} (hT : 0 < T) (g : ℝ → ℂ) :
    ∫ y, g y ∂(fejer T) = ∫ y, ((fejerDensity T y : ℝ) : ℂ) * g y := by
  rw [fejer, integral_withDensity_eq_integral_smul
    (continuous_fejerDensity hT).measurable.real_toNNReal]
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  show (fejerDensity T y).toNNReal • g y = _
  rw [NNReal.smul_def, Real.coe_toNNReal _ (fejerDensity_nonneg T y), Complex.real_smul]

theorem integral_fejer_eq_fourier {T : ℝ} (hT : 0 < T) (g : ℝ → ℂ) :
    ∫ y, g y ∂(fejer T) = ∫ y, 𝓕 (triC T) y * g y := by
  rw [integral_fejer hT]
  refine integral_congr_ae ?_
  filter_upwards [Measure.ae_ne volume (0 : ℝ)] with y hy
  rw [ofReal_fejerDensity hT hy]

/-- The characteristic function of the Fejér kernel is the triangle. -/
theorem charFun_fejer {T : ℝ} (hT : 0 < T) (t : ℝ) :
    charFun (fejer T) t = triC T (t / (2 * π)) := by
  have h := congrFun (fourierInv_fourier_triC hT) (t / (2 * π))
  rw [Real.fourierInv_eq'] at h
  rw [charFun_apply_real, integral_fejer_eq_fourier hT, ← h]
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  simp only [smul_eq_mul]
  rw [mul_comm]
  congr 2
  simp only [RCLike.inner_apply, conj_trivial]
  push_cast
  field_simp
  try ring

theorem norm_charFun_fejer {T : ℝ} (hT : 0 < T) (ξ : ℝ) :
    ‖charFun (fejer T) (2 * π * ξ)‖ = tri T ξ := by
  rw [charFun_fejer hT, triC, Complex.norm_real, Real.norm_of_nonneg (tri_nonneg _ _),
    show 2 * π * ξ / (2 * π) = ξ by field_simp]

theorem fejer_univ {T : ℝ} (hT : 0 < T) : fejer T Set.univ = 1 := by
  rw [fejer, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
  have : ∫⁻ y, ((fejerDensity T y).toNNReal : ℝ≥0∞) = ∫⁻ y, ENNReal.ofReal (fejerDensity T y) := rfl
  rw [this, ← ofReal_integral_eq_lintegral_ofReal (integrable_fejerDensity hT)
    (Filter.Eventually.of_forall (fejerDensity_nonneg T)), integral_fejerDensity hT,
    ENNReal.ofReal_one]

theorem isProbabilityMeasure_fejer {T : ℝ} (hT : 0 < T) : IsProbabilityMeasure (fejer T) :=
  ⟨fejer_univ hT⟩

theorem fejer_real_eq {T : ℝ} (hT : 0 < T) {s : Set ℝ} (hs : MeasurableSet s) :
    (fejer T).real s = ∫ y in s, fejerDensity T y := by
  rw [measureReal_def, fejer, withDensity_apply _ hs]
  have : ∫⁻ y in s, ((fejerDensity T y).toNNReal : ℝ≥0∞)
      = ∫⁻ y in s, ENNReal.ofReal (fejerDensity T y) := rfl
  rw [this, ← ofReal_integral_eq_lintegral_ofReal (integrable_fejerDensity hT).integrableOn
    (Filter.Eventually.of_forall (fejerDensity_nonneg T)),
    ENNReal.toReal_ofReal (setIntegral_nonneg hs fun y _ => fejerDensity_nonneg T y)]

theorem integral_Ioi_inv_sq {a : ℝ} (ha : 0 < a) : ∫ y in Set.Ioi a, (y ^ 2)⁻¹ = a⁻¹ := by
  have h := integral_Ioi_of_hasDerivAt_of_nonneg (g := fun y : ℝ => -y⁻¹) (g' := fun y => (y ^ 2)⁻¹)
    (a := a) (l := 0) (continuousAt_inv₀ ha.ne').neg.continuousWithinAt
    (fun y hy => by
      have hy0 : y ≠ 0 := by have : a < y := hy; linarith
      exact (hasDerivAt_inv hy0).neg.congr_deriv (by ring))
    (fun y _ => by positivity)
    (by simpa using (tendsto_inv_atTop_zero : Tendsto (fun r : ℝ => r⁻¹) atTop (𝓝 0)).neg)
  rw [h]; ring

theorem integrableOn_inv_sq_Iic {a : ℝ} (ha : 0 < a) :
    IntegrableOn (fun y : ℝ => (y ^ 2)⁻¹) (Set.Iic (-a)) := by
  refine (integrable_inv_one_add_sq.const_mul (1 + (a ^ 2)⁻¹)).integrableOn.mono' ?_ ?_
  · exact ((continuous_pow 2).continuousOn.inv₀ (fun y hy => by
      have : y ≤ -a := hy; exact pow_ne_zero 2 (by linarith))).aestronglyMeasurable measurableSet_Iic
  · rw [ae_restrict_iff' measurableSet_Iic]
    refine Filter.Eventually.of_forall fun y hy => ?_
    have hy : y ≤ -a := hy
    have hy2 : a ^ 2 ≤ y ^ 2 := by nlinarith
    have ha2 : 0 < a ^ 2 := by positivity
    have hy2' : 0 < y ^ 2 := by linarith
    rw [Real.norm_of_nonneg (by positivity)]
    rw [show (1 + (a ^ 2)⁻¹) * (1 + y ^ 2)⁻¹ = (1 + a ^ 2) / (a ^ 2 * (1 + y ^ 2)) by
      field_simp; try ring,
      inv_eq_one_div, div_le_div_iff₀ hy2' (by positivity)]
    nlinarith

theorem integral_Iic_inv_sq {a : ℝ} (ha : 0 < a) : ∫ y in Set.Iic (-a), (y ^ 2)⁻¹ = a⁻¹ := by
  have h := integral_Iic_of_hasDerivAt_of_tendsto (f := fun y : ℝ => -y⁻¹) (f' := fun y => (y ^ 2)⁻¹)
    (a := -a) (m := 0) (continuousAt_inv₀ (by linarith : (-a : ℝ) ≠ 0)).neg.continuousWithinAt
    (fun y hy => by
      have hy0 : y ≠ 0 := by have : y < -a := hy; linarith
      exact (hasDerivAt_inv hy0).neg.congr_deriv (by ring))
    (integrableOn_inv_sq_Iic ha)
    (by simpa using (tendsto_inv_atBot_zero : Tendsto (fun r : ℝ => r⁻¹) atBot (𝓝 0)).neg)
  rw [h]; simp

/-- **Tail of the Fejér kernel**: `K_T{|y| > a} ≤ 2/(π²Ta)`. -/
theorem fejer_real_tail_le {T : ℝ} (hT : 0 < T) {a : ℝ} (ha : 0 < a) :
    (fejer T).real {y | a < ‖y‖} ≤ 2 / (π ^ 2 * T * a) := by
  haveI := isProbabilityMeasure_fejer hT
  have hsub : {y : ℝ | a < ‖y‖} ⊆ Set.Iic (-a) ∪ Set.Ioi a := by
    intro y hy
    simp only [Set.mem_setOf_eq, Real.norm_eq_abs] at hy
    rcases lt_abs.mp hy with h | h
    · exact Or.inr h
    · exact Or.inl (by simp only [Set.mem_Iic]; linarith)
  have hbound : ∀ s : Set ℝ, MeasurableSet s → (∀ y ∈ s, y ≠ 0)
      → IntegrableOn (fun y : ℝ => (y ^ 2)⁻¹) s
      → (fejer T).real s ≤ 1 / (π ^ 2 * T) * ∫ y in s, (y ^ 2)⁻¹ := by
    intro s hs hs0 hint
    rw [fejer_real_eq hT hs, ← integral_const_mul]
    exact setIntegral_mono_on (integrable_fejerDensity hT).integrableOn (hint.const_mul _) hs
      fun y hy => fejerDensity_le_inv hT (hs0 y hy)
  have h1 := hbound (Set.Iic (-a)) measurableSet_Iic (fun y hy => by
    have : y ≤ -a := hy; intro h0; linarith) (integrableOn_inv_sq_Iic ha)
  have h2 := hbound (Set.Ioi a) measurableSet_Ioi (fun y hy => by
    have : a < y := hy; intro h0; linarith)
    (integrableOn_Ioi_deriv_of_nonneg (g := fun y : ℝ => -y⁻¹) (l := 0)
      (continuousAt_inv₀ ha.ne').neg.continuousWithinAt
      (fun y hy => by
        have hy0 : y ≠ 0 := by have : a < y := hy; linarith
        exact (hasDerivAt_inv hy0).neg.congr_deriv (by ring))
      (fun y _ => by positivity)
      (by simpa using (tendsto_inv_atTop_zero : Tendsto (fun r : ℝ => r⁻¹) atTop (𝓝 0)).neg))
  rw [integral_Iic_inv_sq ha] at h1
  rw [integral_Ioi_inv_sq ha] at h2
  calc (fejer T).real {y | a < ‖y‖} ≤ (fejer T).real (Set.Iic (-a) ∪ Set.Ioi a) :=
        measureReal_mono hsub
    _ ≤ (fejer T).real (Set.Iic (-a)) + (fejer T).real (Set.Ioi a) := measureReal_union_le _ _
    _ ≤ 1 / (π ^ 2 * T) * a⁻¹ + 1 / (π ^ 2 * T) * a⁻¹ := add_le_add h1 h2
    _ = 2 / (π ^ 2 * T * a) := by field_simp; ring

/-- The smoothing weight is integrable for the Fejér kernel: it vanishes beyond `|ξ| ≥ T`. -/
theorem integrable_fejer_weight {T : ℝ} (hT : 0 < T) :
    Integrable (fun ξ : ℝ => min 1 (‖charFun (fejer T) (2 * π * ξ)‖ / |ξ|)) := by
  simp_rw [norm_charFun_fejer hT]
  have hmeas : Measurable fun ξ : ℝ => min 1 (tri T ξ / |ξ|) :=
    measurable_const.min ((continuous_tri T).measurable.div continuous_abs.measurable)
  have hind : Integrable ((Set.Icc (-T) T).indicator fun _ => (1 : ℝ)) :=
    (integrableOn_const (C := (1 : ℝ)) (s := Set.Icc (-T) T) (μ := volume) (by
      rw [Real.volume_Icc]; exact ENNReal.ofReal_ne_top)).integrable_indicator measurableSet_Icc
  refine hind.mono' hmeas.aestronglyMeasurable (Filter.Eventually.of_forall fun ξ => ?_)
  rw [Real.norm_of_nonneg (le_min zero_le_one (div_nonneg (tri_nonneg _ _) (abs_nonneg _)))]
  by_cases h : ξ ∈ Set.Icc (-T) T
  · rw [Set.indicator_of_mem h]; exact min_le_left _ _
  · rw [Set.indicator_of_notMem h]
    rw [Set.mem_Icc, ← abs_le, not_le] at h
    rw [tri_eq_zero hT h.le, zero_div, min_eq_right zero_le_one]

/-- **Esseen's smoothing inequality with the Fejér kernel** of half-width `T`: for probability
measures `μ, ν` on `ℝ` with `F_ν` `m`-Lipschitz and every `a > 0`,
`|F_μ(x₀) − F_ν(x₀)| (1 − 4/(π²Ta)) ≤ 2 ∫_{|ξ|<T} (1 − |ξ|/T)/(π|ξ|) · |φ_μ(2πξ) − φ_ν(2πξ)| dξ + 2ma`.
Only the characteristic functions on `|t| < 2πT` enter. -/
theorem esseen_inequality_fejer (μ ν : Measure ℝ) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    {m : ℝ} (hm : 0 ≤ m) (hG : ∀ x y, x ≤ y → cdfR ν y - cdfR ν x ≤ m * (y - x)) {T : ℝ}
    (hT : 0 < T) {a : ℝ} (ha : 0 < a)
    (hI : Integrable (fun ξ : ℝ => tri T ξ / (π * |ξ|)
      * ‖charFun μ (2 * π * ξ) - charFun ν (2 * π * ξ)‖)) (x₀ : ℝ) :
    |cdfR μ x₀ - cdfR ν x₀| * (1 - 2 * (2 / (π ^ 2 * T * a)))
      ≤ 2 * (∫ ξ, tri T ξ / (π * |ξ|) * ‖charFun μ (2 * π * ξ) - charFun ν (2 * π * ξ)‖)
        + 2 * m * a := by
  haveI := isProbabilityMeasure_fejer hT
  have hI' : Integrable (fun ξ : ℝ => ‖charFun (fejer T) (2 * π * ξ)‖ / (π * |ξ|)
      * ‖charFun μ (2 * π * ξ) - charFun ν (2 * π * ξ)‖) := by
    simpa only [norm_charFun_fejer hT] using hI
  have hD : ∀ x, |smoothDiff μ ν (fejer T) x|
      ≤ ∫ ξ, tri T ξ / (π * |ξ|) * ‖charFun μ (2 * π * ξ) - charFun ν (2 * π * ξ)‖ := by
    intro x
    have := abs_smoothDiff_le μ ν (fejer T) (integrable_fejer_weight hT) hI' x
    simpa only [norm_charFun_fejer hT] using this
  exact esseen_sup μ ν (fejer T) hm hG ha.le (fejer_real_tail_le hT ha) hD x₀

end Fejer

/-!
# §44  The damped characteristic-function bound and the Kolmogorov–Smirnov rate

§40 bounds the characteristic-function gap of a coordinate of `H D_ε v` by `t⁴ ∑ⱼ vⱼ⁴/(3d²)`
for `|t| ≤ √d`; that bound has no Gaussian damping and, fed into the band-limited Esseen
inequality of §43, gives a constant.  This section proves the damped form and closes the
Kolmogorov–Smirnov corollary.

* `Hadamard.abs_cos_le_exp`: `|cos x| ≤ e^{−x²/4}` for `|x| ≤ 1`.
* `Hadamard.abs_prod_sub_prod_le_weighted`: the telescoping bound with weights,
  `|∏ pᵢ − ∏ qᵢ| ≤ (∏ wᵢ) ∑ᵢ |pᵢ − qᵢ|/wᵢ` when `|pᵢ|, |qᵢ| ≤ wᵢ`.
* `Hadamard.abs_prod_cos_sub_exp_le_damped`: for `|t aⱼ| ≤ 1`,
  `|∏ cos(t aⱼ) − e^{−t²∑aⱼ²/2}| ≤ (t⁴ ∑ aⱼ⁴/2) e^{−t²∑aⱼ²/4}`, using `e^{1/4} ≤ 3/2`.
* `Hadamard.norm_charFun_coordLaw_sub_gaussian_le_damped`: the same for the coordinate law of
  `H D_ε v` against `N(0, ‖v‖²/d)`, on the full range `|t vⱼ| ≤ √d`.
* The Gaussian distribution function `N(0, v)` is `(√(2πv))⁻¹`-Lipschitz
  (`cdfR_gaussianReal_lipschitz`); `∫ |ξ|³ e^{−bξ²} dξ = 1/b²` by the fundamental theorem of
  calculus on `(0, ∞)` and the reflection `∫ f|x| = 2∫_0^∞ f` (`integral_abs_pow_three_mul_exp`).
* `Hadamard.abs_cdfR_coordLaw_sub_gaussian_le`: **the Kolmogorov–Smirnov bound.**  For `H` flat,
  `v ≠ 0` with `|vⱼ| ≤ M`, every `a > 0` and every `x₀`,
  `|F(x₀) − Φ(x₀)| (1 − 8M/(π√d a)) ≤ 16 ∑ⱼ vⱼ⁴/(π‖v‖⁴) + 2a/√(2π‖v‖²/d)`.
  For a spread unit direction (`M = 1/√d`, `∑ vⱼ⁴ = 1/d`) and `a = 16/(πd)` the right side is
  `16/(πd) + 32/(π√(2π) √d)`, so the Kolmogorov–Smirnov distance is at most
  `8.2/√d + 10.2/d`.  The constants are explicit and crude; the rate is the classical one.
-/

open Filter
open scoped Topology FourierTransform
open Orthogonal
namespace Hadamard

/-- `|cos x| ≤ e^{−x²/4}` for `|x| ≤ 1`: the cosine is Gaussian-damped on the unit range. -/
theorem abs_cos_le_exp {x : ℝ} (hx : |x| ≤ 1) : |Real.cos x| ≤ Real.exp (-(x ^ 2) / 4) := by
  have h1 := Real.cos_bound hx
  have hx2 : x ^ 2 ≤ 1 := by
    rw [← sq_abs]; nlinarith [abs_nonneg x]
  have hx4 : |x| ^ 4 = x ^ 4 := by
    rw [show (4 : ℕ) = 2 * 2 from rfl, pow_mul, pow_mul, sq_abs]
  rw [hx4, abs_le] at h1
  have hexp := Real.add_one_le_exp (-(x ^ 2) / 4)
  have hpos : 0 ≤ Real.cos x := by nlinarith [pow_nonneg (sq_nonneg x) 2]
  rw [abs_of_nonneg hpos]
  nlinarith [pow_nonneg (sq_nonneg x) 2, sq_nonneg x]

/-- A weighted telescoping bound: if `|pᵢ|, |qᵢ| ≤ wᵢ` with `wᵢ > 0`, then
`|∏ pᵢ − ∏ qᵢ| ≤ (∏ wᵢ) ∑ᵢ |pᵢ − qᵢ|/wᵢ`. -/
theorem abs_prod_sub_prod_le_weighted {ι : Type*} (s : Finset ι) (p q w : ι → ℝ)
    (hw : ∀ i ∈ s, 0 < w i) (hp : ∀ i ∈ s, |p i| ≤ w i) (hq : ∀ i ∈ s, |q i| ≤ w i) :
    |∏ i ∈ s, p i - ∏ i ∈ s, q i| ≤ (∏ i ∈ s, w i) * ∑ i ∈ s, |p i - q i| / w i := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
      rw [Finset.prod_insert ha, Finset.prod_insert ha, Finset.prod_insert ha, Finset.sum_insert ha]
      have hw' := fun i hi => hw i (Finset.mem_insert_of_mem hi)
      have hp' := fun i hi => hp i (Finset.mem_insert_of_mem hi)
      have hq' := fun i hi => hq i (Finset.mem_insert_of_mem hi)
      have hwa : 0 < w a := hw a (Finset.mem_insert_self a s)
      have hqa : |q a| ≤ w a := hq a (Finset.mem_insert_self a s)
      have hW : 0 ≤ ∏ i ∈ s, w i := Finset.prod_nonneg fun i hi => (hw' i hi).le
      have hP : |∏ i ∈ s, p i| ≤ ∏ i ∈ s, w i := by
        rw [Finset.abs_prod]
        exact Finset.prod_le_prod (fun i _ => abs_nonneg _) fun i hi => hp' i hi
      have hS : 0 ≤ ∑ i ∈ s, |p i - q i| / w i :=
        Finset.sum_nonneg fun i hi => div_nonneg (abs_nonneg _) (hw' i hi).le
      calc |p a * ∏ i ∈ s, p i - q a * ∏ i ∈ s, q i|
          = |(p a - q a) * ∏ i ∈ s, p i + q a * (∏ i ∈ s, p i - ∏ i ∈ s, q i)| := by
            congr 1; ring
        _ ≤ |(p a - q a) * ∏ i ∈ s, p i| + |q a * (∏ i ∈ s, p i - ∏ i ∈ s, q i)| :=
            abs_add_le _ _
        _ = |p a - q a| * |∏ i ∈ s, p i| + |q a| * |∏ i ∈ s, p i - ∏ i ∈ s, q i| := by
            rw [abs_mul, abs_mul]
        _ ≤ |p a - q a| * ∏ i ∈ s, w i + w a * ((∏ i ∈ s, w i) * ∑ i ∈ s, |p i - q i| / w i) :=
            add_le_add (mul_le_mul_of_nonneg_left hP (abs_nonneg _))
              (mul_le_mul hqa (ih hw' hp' hq') (abs_nonneg _) hwa.le)
        _ = w a * (∏ i ∈ s, w i) * (|p a - q a| / w a + ∑ i ∈ s, |p i - q i| / w i) := by
            have hw0 : w a ≠ 0 := hwa.ne'
            field_simp
            try ring

theorem exp_quarter_le : Real.exp (1 / 4) ≤ 3 / 2 := by
  have h := Real.abs_exp_sub_one_sub_id_le (x := 1 / 4) (by rw [abs_le]; constructor <;> norm_num)
  rw [abs_le] at h
  nlinarith [h.2]

/-- **The Gaussian-damped characteristic-function bound**: for `|t aⱼ| ≤ 1`,
`|∏ cos(t aⱼ) − e^{−t² ∑ aⱼ²/2}| ≤ (t⁴ ∑ aⱼ⁴ / 2) e^{−t² ∑ aⱼ²/4}`. -/
theorem abs_prod_cos_sub_exp_le_damped {n : ℕ} (a : Fin n → ℝ) {t : ℝ}
    (ht : ∀ j, |t * a j| ≤ 1) :
    |∏ j, Real.cos (t * a j) - Real.exp (-(t ^ 2 * ∑ j, a j ^ 2) / 2)|
      ≤ t ^ 4 * (∑ j, a j ^ 4) / 2 * Real.exp (-(t ^ 2 * ∑ j, a j ^ 2) / 4) := by
  have he : ∀ c : ℝ, Real.exp (-(t ^ 2 * ∑ j, a j ^ 2) / c)
      = ∏ j, Real.exp (-((t * a j) ^ 2) / c) := by
    intro c
    rw [← Real.exp_sum]
    congr 1
    rw [Finset.mul_sum, ← Finset.sum_neg_distrib, Finset.sum_div]
    refine Finset.sum_congr rfl fun j _ => ?_; ring
  rw [he 2, he 4]
  have hx2 : ∀ j, (t * a j) ^ 2 ≤ 1 := fun j => by
    rw [← sq_abs]; nlinarith [abs_nonneg (t * a j), ht j]
  refine (abs_prod_sub_prod_le_weighted Finset.univ _ _ (fun j => Real.exp (-((t * a j) ^ 2) / 4))
    (fun j _ => Real.exp_pos _) (fun j _ => abs_cos_le_exp (ht j))
    (fun j _ => by
      rw [abs_of_pos (Real.exp_pos _)]
      exact Real.exp_le_exp.mpr (by nlinarith [sq_nonneg (t * a j)]))).trans ?_
  rw [mul_comm]
  refine mul_le_mul_of_nonneg_right ?_ (Finset.prod_nonneg fun j _ => (Real.exp_pos _).le)
  calc ∑ j, |Real.cos (t * a j) - Real.exp (-((t * a j) ^ 2) / 2)| / Real.exp (-((t * a j) ^ 2) / 4)
      ≤ ∑ j, (t * a j) ^ 4 / 3 * (3 / 2) := by
        refine Finset.sum_le_sum fun j _ => ?_
        have hinv : (Real.exp (-(t * a j) ^ 2 / 4))⁻¹ = Real.exp ((t * a j) ^ 2 / 4) := by
          rw [← Real.exp_neg]; congr 1; ring
        rw [div_eq_mul_inv, hinv]
        refine mul_le_mul (abs_cos_sub_exp_le (ht j)) ?_ (Real.exp_pos _).le
          (by positivity)
        exact (Real.exp_le_exp.mpr (by linarith [hx2 j])).trans exp_quarter_le
    _ = t ^ 4 * (∑ j, a j ^ 4) / 2 := by
        rw [Finset.mul_sum, Finset.sum_div]
        refine Finset.sum_congr rfl fun j _ => ?_; ring

variable {d : ℕ}

/-- **Theorem 1 for the deployed rotation, damped form.**  On the full range `|t vⱼ| ≤ √d`, the
characteristic function of a coordinate of `H D_ε v` is within
`(t⁴ ∑ⱼ vⱼ⁴/(2d²)) e^{−t²‖v‖²/(4d)}` of the Gaussian `e^{−t²‖v‖²/(2d)}`. -/
theorem abs_signAvg_cos_coord_sub_exp_le_damped {H : Od d} (hH : IsFlat H) (v : Ed d)
    (i : Fin d) {t : ℝ} (ht : ∀ j, |t * v j| ≤ Real.sqrt d) :
    |signAvg (fun s => Real.cos (t * (hadRot H s • v) i))
        - Real.exp (-(t ^ 2 * ‖v‖ ^ 2 / d) / 2)|
      ≤ t ^ 4 * (∑ j, v j ^ 4) / (2 * (d : ℝ) ^ 2) * Real.exp (-(t ^ 2 * ‖v‖ ^ 2 / d) / 4) := by
  have hd : (0 : ℝ) < d := by
    rcases Nat.eq_zero_or_pos d with h0 | h0
    · subst h0; exact Fin.elim0 i
    · exact_mod_cast h0
  set a : Fin d → ℝ := fun j => (H : Matrix (Fin d) (Fin d) ℝ) i j * v j with ha
  have hcoord : ∀ s, (hadRot H s • v) i = radSum a s := fun s => hadRot_apply_eq_radSum H s v i
  simp_rw [hcoord, signAvg_cos_radSum]
  have h2 : ∑ j, a j ^ 2 = ‖v‖ ^ 2 / d := by
    rw [norm_sq_eq_sum_sq]; simp_rw [ha, mul_pow, hH i]; rw [← Finset.mul_sum]; try ring
  have h4 : ∑ j, a j ^ 4 = (∑ j, v j ^ 4) / (d : ℝ) ^ 2 := by
    have : ∀ j, a j ^ 4 = (1 / (d : ℝ)) ^ 2 * v j ^ 4 := fun j => by
      rw [ha]; simp only
      rw [mul_pow, show (4 : ℕ) = 2 * 2 from rfl, pow_mul, hH i]
      try ring
    simp_rw [this]; rw [← Finset.mul_sum]; try ring
  have hta : ∀ j, |t * a j| ≤ 1 := by
    intro j
    have hs : 0 < Real.sqrt d := Real.sqrt_pos.mpr hd
    have : |t * a j| = |t * v j| / Real.sqrt d := by
      rw [ha]; simp only
      rw [show t * ((H : Matrix (Fin d) (Fin d) ℝ) i j * v j)
        = (H : Matrix (Fin d) (Fin d) ℝ) i j * (t * v j) by ring, abs_mul, abs_entry_of_isFlat hH]
      field_simp
    rw [this, div_le_one hs]
    exact ht j
  have := abs_prod_cos_sub_exp_le_damped a hta
  rw [h2, h4] at this
  have e2 : -(t ^ 2 * (‖v‖ ^ 2 / d)) / 2 = -(t ^ 2 * ‖v‖ ^ 2 / d) / 2 := by ring
  have e4 : -(t ^ 2 * (‖v‖ ^ 2 / d)) / 4 = -(t ^ 2 * ‖v‖ ^ 2 / d) / 4 := by ring
  rw [e2, e4] at this
  refine this.trans (le_of_eq ?_)
  ring

/-- The damped characteristic-function gap between the coordinate law and `N(0, ‖v‖²/d)`. -/
theorem norm_charFun_coordLaw_sub_gaussian_le_damped {H : Od d} (hH : IsFlat H) (v : Ed d)
    (i : Fin d) {t : ℝ} (ht : ∀ j, |t * v j| ≤ Real.sqrt d) :
    ‖charFun (coordLaw H v i) t - charFun (gaussianReal 0 (Real.toNNReal (‖v‖ ^ 2 / d))) t‖
      ≤ t ^ 4 * (∑ j, v j ^ 4) / (2 * (d : ℝ) ^ 2) * Real.exp (-(t ^ 2 * ‖v‖ ^ 2 / d) / 4) := by
  rw [charFun_coordLaw, charFun_gaussianReal]
  have h := abs_signAvg_cos_coord_sub_exp_le_damped hH v i ht
  have hcoord : ∀ s, (hadRot H s • v) i = radSum (fun j => (H : Matrix (Fin d) (Fin d) ℝ) i j * v j) s :=
    fun s => hadRot_apply_eq_radSum H s v i
  simp_rw [hcoord, signAvg_cos_radSum] at h
  have hnn : (0 : ℝ) ≤ ‖v‖ ^ 2 / d := by positivity
  have hg : Complex.exp (↑t * ↑(0 : ℝ) * Complex.I - ↑↑(Real.toNNReal (‖v‖ ^ 2 / d)) * ↑t ^ 2 / 2)
      = ((Real.exp (-(t ^ 2 * ‖v‖ ^ 2 / d) / 2) : ℝ) : ℂ) := by
    rw [Complex.ofReal_exp]
    congr 1
    rw [Real.coe_toNNReal _ hnn]
    push_cast
    ring
  rw [hg, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
  exact h

end Hadamard

/-- The Gaussian density `N(0, v)` is at most `(√(2πv))⁻¹`. -/
theorem gaussianPDFReal_le (v : NNReal) (x : ℝ) :
    gaussianPDFReal 0 v x ≤ (Real.sqrt (2 * π * v))⁻¹ := by
  rw [gaussianPDFReal_def]
  simp only
  refine mul_le_of_le_one_right (inv_nonneg.mpr (Real.sqrt_nonneg _)) ?_
  rw [Real.exp_le_one_iff]
  have : 0 ≤ (x - 0) ^ 2 / (2 * v) := by positivity
  rw [neg_div]
  linarith

/-- The Gaussian distribution function `N(0, v)`, `v ≠ 0`, is Lipschitz with constant
`(√(2πv))⁻¹`. -/
theorem cdfR_gaussianReal_lipschitz {v : NNReal} (hv : v ≠ 0) {x y : ℝ} (hxy : x ≤ y) :
    cdfR (gaussianReal 0 v) y - cdfR (gaussianReal 0 v) x ≤ (Real.sqrt (2 * π * v))⁻¹ * (y - x) := by
  have h : cdfR (gaussianReal 0 v) y - cdfR (gaussianReal 0 v) x
      = (gaussianReal 0 v).real (Set.Ioc x y) := by
    unfold cdfR
    rw [Ioc_eq_Iic_diff, measureReal_sdiff (Set.Iic_subset_Iic.mpr hxy) measurableSet_Iic]
  rw [h, measureReal_def, gaussianReal_apply_eq_integral _ hv,
    ENNReal.toReal_ofReal (setIntegral_nonneg measurableSet_Ioc fun z _ => gaussianPDFReal_nonneg _ _ _)]
  calc ∫ z in Set.Ioc x y, gaussianPDFReal 0 v z
      ≤ ∫ z in Set.Ioc x y, (Real.sqrt (2 * π * v))⁻¹ :=
        setIntegral_mono_on (integrable_gaussianPDFReal 0 v).integrableOn
          (integrableOn_const (by rw [Real.volume_Ioc]; exact ENNReal.ofReal_ne_top)) measurableSet_Ioc
          fun z _ => gaussianPDFReal_le v z
    _ = (Real.sqrt (2 * π * v))⁻¹ * (y - x) := by
        rw [setIntegral_const, smul_eq_mul, measureReal_def, Real.volume_Ioc,
          ENNReal.toReal_ofReal (by linarith)]
        ring

/-- `∫_0^∞ u³ e^{−bu²} du = 1/(2b²)`. -/
theorem integral_Ioi_pow_three_mul_exp {b : ℝ} (hb : 0 < b) :
    ∫ u in Set.Ioi (0 : ℝ), u ^ 3 * Real.exp (-b * u ^ 2) = 1 / (2 * b ^ 2) := by
  have hderiv : ∀ u ∈ Set.Ioi (0 : ℝ),
      HasDerivAt (fun u : ℝ => -(u ^ 2 / (2 * b) + 1 / (2 * b ^ 2)) * Real.exp (-b * u ^ 2))
        (u ^ 3 * Real.exp (-b * u ^ 2)) u := by
    intro u _
    have h1 : HasDerivAt (fun u : ℝ => -(u ^ 2 / (2 * b) + 1 / (2 * b ^ 2)))
        (-(((2 : ℕ) : ℝ) * u ^ (2 - 1) / (2 * b))) u :=
      (((hasDerivAt_pow 2 u).div_const (2 * b)).add_const (1 / (2 * b ^ 2))).neg
    have h2 : HasDerivAt (fun u : ℝ => Real.exp (-b * u ^ 2))
        (Real.exp (-b * u ^ 2) * (-b * (((2 : ℕ) : ℝ) * u ^ (2 - 1)))) u :=
      ((hasDerivAt_pow 2 u).const_mul (-b)).exp
    refine (h1.mul h2).congr_deriv ?_
    norm_num
    field_simp
    ring
  have hlim : Tendsto (fun u : ℝ => -(u ^ 2 / (2 * b) + 1 / (2 * b ^ 2)) * Real.exp (-b * u ^ 2))
      atTop (𝓝 0) := by
    have hA : Tendsto (fun u : ℝ => u ^ 2 * Real.exp (-b * u ^ 2)) atTop (𝓝 0) := by
      have hexp : Tendsto (fun x : ℝ => Real.exp (-(1 / 2) * x)) atTop (𝓝 0) := by
        have h1 : Tendsto (fun x : ℝ => -(1 / 2) * x) atTop atBot := by
          have := tendsto_neg_atTop_atBot.comp
            (tendsto_id.const_mul_atTop (by norm_num : (0 : ℝ) < 1 / 2))
          exact this.congr fun x => by show -(1 / 2 * id x) = -(1 / 2) * x; simp only [id]; ring
        exact Real.tendsto_exp_atBot.comp h1
      have := (rpow_mul_exp_neg_mul_sq_isLittleO_exp_neg hb 2).tendsto_zero_of_tendsto hexp
      simpa [Real.rpow_two] using this
    have hB : Tendsto (fun u : ℝ => Real.exp (-b * u ^ 2)) atTop (𝓝 0) := by
      have h1 : Tendsto (fun u : ℝ => -b * u ^ 2) atTop atBot := by
        have := tendsto_neg_atTop_atBot.comp ((tendsto_pow_atTop two_ne_zero).const_mul_atTop hb)
        exact this.congr fun u => by show -(b * u ^ 2) = -b * u ^ 2; ring
      exact Real.tendsto_exp_atBot.comp h1
    have h := (hA.const_mul (-(1 / (2 * b)))).add (hB.const_mul (-(1 / (2 * b ^ 2))))
    simp only [mul_zero, add_zero] at h
    refine h.congr fun u => ?_
    ring
  have h := integral_Ioi_of_hasDerivAt_of_nonneg
    (continuousAt_id.pow 2 |>.div_const _ |>.add_const _ |>.neg |>.mul
      (Real.continuous_exp.continuousAt.comp ((continuousAt_id.pow 2).const_mul (-b)))).continuousWithinAt
    hderiv (fun u hu => by have : (0 : ℝ) < u := hu; positivity) hlim
  rw [h]
  simp

/-- `∫ |ξ|³ e^{−bξ²} dξ = 1/b²`. -/
theorem integral_abs_pow_three_mul_exp {b : ℝ} (hb : 0 < b) :
    ∫ ξ : ℝ, |ξ| ^ 3 * Real.exp (-b * ξ ^ 2) = 1 / b ^ 2 := by
  have h := integral_comp_abs (f := fun u : ℝ => u ^ 3 * Real.exp (-b * u ^ 2))
  simp only [sq_abs] at h
  rw [h, integral_Ioi_pow_three_mul_exp hb]
  field_simp

theorem integrable_abs_pow_three_mul_exp {b : ℝ} (hb : 0 < b) :
    Integrable (fun ξ : ℝ => |ξ| ^ 3 * Real.exp (-b * ξ ^ 2)) := by
  have h := (integrable_rpow_mul_exp_neg_mul_sq hb (s := 3) (by norm_num)).norm
  refine h.congr (Filter.Eventually.of_forall fun ξ => ?_)
  simp only
  rw [Real.norm_eq_abs, abs_mul, abs_of_pos (Real.exp_pos _), show (3 : ℝ) = ((3 : ℕ) : ℝ) by norm_num,
    Real.rpow_natCast, abs_pow]

namespace Hadamard
variable {d : ℕ}

/-- **Kolmogorov–Smirnov bound for the coordinate law of `H D_ε v`.**  For `H` flat, `v ≠ 0` with
`|vⱼ| ≤ M`, every `a > 0` and every `x₀`,
`|F(x₀) − Φ(x₀)| (1 − 8M/(π√d a)) ≤ 16 ∑ⱼ vⱼ⁴/(π‖v‖⁴) + 2a/√(2π‖v‖²/d)`,
with `F` the distribution function of the coordinate law and `Φ` that of `N(0, ‖v‖²/d)`.
For a spread unit direction (`M = 1/√d`, `∑ vⱼ⁴ = 1/d`) and `a = 16/(πd)` this is a
Kolmogorov–Smirnov distance of order `1/√d`. -/
theorem abs_cdfR_coordLaw_sub_gaussian_le {H : Od d} (hH : IsFlat H) {v : Ed d} (hv0 : v ≠ 0)
    {M : ℝ} (hM : 0 < M) (hvM : ∀ j, |v j| ≤ M) (i : Fin d) {a : ℝ} (ha : 0 < a) (x₀ : ℝ) :
    |cdfR (coordLaw H v i) x₀ - cdfR (gaussianReal 0 (Real.toNNReal (‖v‖ ^ 2 / d))) x₀|
        * (1 - 8 * M / (π * Real.sqrt d * a))
      ≤ 16 * (∑ j, v j ^ 4) / (π * ‖v‖ ^ 4)
        + 2 * (Real.sqrt (2 * π * (‖v‖ ^ 2 / d)))⁻¹ * a := by
  have hd : (0 : ℝ) < d := by
    rcases Nat.eq_zero_or_pos d with h0 | h0
    · subst h0; exact Fin.elim0 i
    · exact_mod_cast h0
  have hsd : 0 < Real.sqrt d := Real.sqrt_pos.mpr hd
  have hvn : 0 < ‖v‖ := norm_pos_iff.mpr hv0
  set σ2 : ℝ := ‖v‖ ^ 2 / d with hσ2
  have hσ2pos : 0 < σ2 := by positivity
  have hcoe : ((Real.toNNReal σ2 : NNReal) : ℝ) = σ2 := Real.coe_toNNReal _ hσ2pos.le
  have hvne : Real.toNNReal σ2 ≠ 0 := (Real.toNNReal_pos.mpr hσ2pos).ne'
  set T : ℝ := Real.sqrt d / (2 * π * M) with hT_def
  have hT : 0 < T := by positivity
  set m : ℝ := (Real.sqrt (2 * π * σ2))⁻¹ with hm_def
  have hm : 0 ≤ m := by positivity
  have hG : ∀ x y, x ≤ y → cdfR (gaussianReal 0 (Real.toNNReal σ2)) y
      - cdfR (gaussianReal 0 (Real.toNNReal σ2)) x ≤ m * (y - x) := by
    intro x y hxy
    have := cdfR_gaussianReal_lipschitz hvne hxy
    rwa [hcoe] at this
  set S : ℝ := ∑ j, v j ^ 4 with hS
  have hS0 : 0 ≤ S := Finset.sum_nonneg fun j _ => by positivity
  set b : ℝ := π ^ 2 * σ2 with hb_def
  have hb : 0 < b := by positivity
  set C : ℝ := 8 * π ^ 3 * S / (d : ℝ) ^ 2 with hC
  have hC0 : 0 ≤ C := by positivity
  -- the pointwise bound on the integrand
  have hpt : ∀ ξ : ℝ, tri T ξ / (π * |ξ|)
      * ‖charFun (coordLaw H v i) (2 * π * ξ) - charFun (gaussianReal 0 (Real.toNNReal σ2)) (2 * π * ξ)‖
      ≤ C * (|ξ| ^ 3 * Real.exp (-b * ξ ^ 2)) := by
    intro ξ
    have hR : 0 ≤ C * (|ξ| ^ 3 * Real.exp (-b * ξ ^ 2)) := by positivity
    rcases le_or_gt T |ξ| with hξ | hξ
    · rw [tri_eq_zero hT hξ, zero_div, zero_mul]; exact hR
    rcases eq_or_ne ξ 0 with h0 | h0
    · subst h0; simp
    have hξpos : 0 < |ξ| := abs_pos.mpr h0
    have ht : ∀ j, |2 * π * ξ * v j| ≤ Real.sqrt d := by
      intro j
      rw [abs_mul, abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 2 * π)]
      calc 2 * π * |ξ| * |v j| ≤ 2 * π * T * M := by gcongr; exact hvM j
        _ = Real.sqrt d := by rw [hT_def]; field_simp
    have hΔ := norm_charFun_coordLaw_sub_gaussian_le_damped hH v i ht
    have htri : tri T ξ ≤ 1 := tri_le_one hT ξ
    have hw : 0 ≤ 1 / (π * |ξ|) := by positivity
    calc tri T ξ / (π * |ξ|)
          * ‖charFun (coordLaw H v i) (2 * π * ξ) - charFun (gaussianReal 0 (Real.toNNReal σ2)) (2 * π * ξ)‖
        ≤ 1 / (π * |ξ|) * ((2 * π * ξ) ^ 4 * S / (2 * (d : ℝ) ^ 2)
            * Real.exp (-((2 * π * ξ) ^ 2 * ‖v‖ ^ 2 / d) / 4)) := by
          gcongr
      _ = C * (|ξ| ^ 3 * Real.exp (-b * ξ ^ 2)) := by
          have e1 : Real.exp (-((2 * π * ξ) ^ 2 * ‖v‖ ^ 2 / d) / 4) = Real.exp (-b * ξ ^ 2) := by
            congr 1; rw [hb_def, hσ2]; ring
          have e2 : (2 * π * ξ) ^ 4 = 16 * π ^ 4 * (|ξ| ^ 3 * |ξ|) := by
            rw [← pow_succ, ← abs_pow, abs_of_nonneg (by positivity : (0 : ℝ) ≤ ξ ^ 4)]; ring
          rw [e1, e2, hC]
          field_simp
          ring
  have hdom : Integrable (fun ξ : ℝ => C * (|ξ| ^ 3 * Real.exp (-b * ξ ^ 2))) :=
    (integrable_abs_pow_three_mul_exp hb).const_mul C
  have hmeas : AEStronglyMeasurable (fun ξ : ℝ => tri T ξ / (π * |ξ|)
      * ‖charFun (coordLaw H v i) (2 * π * ξ) - charFun (gaussianReal 0 (Real.toNNReal σ2)) (2 * π * ξ)‖)
      volume := by
    have h2 : Continuous fun ξ : ℝ => 2 * π * ξ := by fun_prop
    have hc : Continuous fun ξ : ℝ => ‖charFun (coordLaw H v i) (2 * π * ξ)
        - charFun (gaussianReal 0 (Real.toNNReal σ2)) (2 * π * ξ)‖ :=
      ((continuous_charFun.comp h2).sub (continuous_charFun.comp h2)).norm
    exact (((continuous_tri T).measurable.div (measurable_const.mul continuous_abs.measurable)).mul
      hc.measurable).aestronglyMeasurable
  have hI : Integrable (fun ξ : ℝ => tri T ξ / (π * |ξ|)
      * ‖charFun (coordLaw H v i) (2 * π * ξ) - charFun (gaussianReal 0 (Real.toNNReal σ2)) (2 * π * ξ)‖) :=
    hdom.mono' hmeas (Filter.Eventually.of_forall fun ξ => by
      rw [Real.norm_of_nonneg (mul_nonneg (div_nonneg (tri_nonneg _ _) (by positivity)) (norm_nonneg _))]
      exact hpt ξ)
  have hint : ∫ ξ, tri T ξ / (π * |ξ|)
      * ‖charFun (coordLaw H v i) (2 * π * ξ) - charFun (gaussianReal 0 (Real.toNNReal σ2)) (2 * π * ξ)‖
      ≤ 8 * S / (π * ‖v‖ ^ 4) := by
    refine (integral_mono hI hdom hpt).trans (le_of_eq ?_)
    rw [integral_const_mul, integral_abs_pow_three_mul_exp hb, hC, hb_def, hσ2]
    field_simp
    try ring
  have h := esseen_inequality_fejer (coordLaw H v i) (gaussianReal 0 (Real.toNNReal σ2)) hm hG hT ha hI x₀
  have hε : 2 * (2 / (π ^ 2 * T * a)) = 8 * M / (π * Real.sqrt d * a) := by
    rw [hT_def]; field_simp; ring
  rw [hε] at h
  have hfin : 16 * S / (π * ‖v‖ ^ 4) = 2 * (8 * S / (π * ‖v‖ ^ 4)) := by ring
  rw [hfin]
  linarith

end Hadamard

/-!
# §45  Uniqueness of the rotation-invariant law on the sphere

Header items 1 and 2 said that the uniform law on the sphere is rotation-invariant (§21) and
that the orbit law of a Haar rotation is the uniform law (§22, §23), but that the uniform law
being the *only* rotation-invariant probability measure on the sphere was not proved.  It is
the same argument as §22 run in the other direction: if `μ` is a `G`-invariant probability
measure carried by the unit sphere, then `μ(s) = ∫ μ((g•·)⁻¹ s) dκ(g)` for a right-invariant
probability `κ` on `G`; swapping the integrals turns the right side into
`∫ (orbitLaw κ x)(s) dμ(x)`, and the orbit law of every point of the sphere is the uniform law.

* `eq_sphereUniformAmbient_of_invariant`: the abstract statement, for a group acting by
  isometries and transitively on the unit sphere with a right-invariant probability measure.
* `Orthogonal.eq_sphereUniformAmbient_of_invariant`: at `O(d)` with its Haar measure, every
  `O(d)`-invariant probability measure on `ℝ^d` carried by the unit sphere is the uniform law.
-/

open scoped InnerProductSpace

section Uniqueness

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E]
variable {G : Type*} [Group G] [MeasurableSpace G] [MulAction G E] [MeasurableSMul₂ G E]
  [MeasurableMul G]

/-- **Uniqueness of the invariant law on the sphere.**  If `G` acts on `E` by isometries and
transitively on the unit sphere, and carries a right-invariant probability measure `κ`, then
every `G`-invariant probability measure on `E` carried by the unit sphere is the uniform law:
average the invariance `μ = (g • ·)_* μ` over `g ∼ κ`, swap the integrals, and use that the
orbit law of every point of the sphere is the uniform law (§22). -/
theorem eq_sphereUniformAmbient_of_invariant [Nontrivial E] {ι : G → (E ≃ₗᵢ[ℝ] E)}
    (hι : ∀ (g : G) (x : E), ι g x = g • x)
    (κ : Measure G) [IsProbabilityMeasure κ] [κ.IsMulRightInvariant]
    (htrans : ∀ x y : E, ‖x‖ = 1 → ‖y‖ = 1 → y ∈ MulAction.orbit G x)
    (μ : Measure E) [IsProbabilityMeasure μ] (hμ : ∀ᵐ x ∂μ, ‖x‖ = 1)
    (hinv : ∀ g : G, μ.map (fun x => g • x) = μ) :
    μ = sphereUniformAmbient E := by
  ext s hs
  have hmeas : Measurable fun p : G × E => s.indicator (1 : E → ℝ≥0∞) (p.1 • p.2) :=
    (measurable_const.indicator hs).comp measurable_smul
  have h1 : μ s = ∫⁻ g, ∫⁻ x, s.indicator (1 : E → ℝ≥0∞) (g • x) ∂μ ∂κ := by
    have : ∀ g : G, ∫⁻ x, s.indicator (1 : E → ℝ≥0∞) (g • x) ∂μ = μ s := by
      intro g
      have hg : Measurable fun x : E => g • x := measurable_const_smul g
      calc ∫⁻ x, s.indicator (1 : E → ℝ≥0∞) (g • x) ∂μ
          = ∫⁻ x, ((fun x : E => g • x) ⁻¹' s).indicator (1 : E → ℝ≥0∞) x ∂μ := by
            refine lintegral_congr fun x => ?_
            by_cases hx : g • x ∈ s
            · rw [Set.indicator_of_mem hx, Set.indicator_of_mem (by exact hx)]; rfl
            · rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem (by exact hx)]
        _ = μ ((fun x : E => g • x) ⁻¹' s) := lintegral_indicator_one (hg hs)
        _ = (μ.map fun x : E => g • x) s := (Measure.map_apply hg hs).symm
        _ = μ s := by rw [hinv g]
    simp_rw [this]
    rw [lintegral_const, measure_univ, mul_one]
  have h2 : ∫⁻ g, ∫⁻ x, s.indicator (1 : E → ℝ≥0∞) (g • x) ∂μ ∂κ
      = ∫⁻ x, ∫⁻ g, s.indicator (1 : E → ℝ≥0∞) (g • x) ∂κ ∂μ :=
    lintegral_lintegral_swap (f := fun g x => s.indicator (1 : E → ℝ≥0∞) (g • x))
      hmeas.aemeasurable
  have h3 : ∀ x : E, ∫⁻ g, s.indicator (1 : E → ℝ≥0∞) (g • x) ∂κ = (orbitLaw κ x) s := by
    intro x
    have := lintegral_indicator_one (μ := orbitLaw κ x) hs
    rw [← this, lintegral_orbitLaw κ x (f := s.indicator 1) (measurable_const.indicator hs)]
  have h4 : ∫⁻ x, (orbitLaw κ x) s ∂μ = ∫⁻ x, (sphereUniformAmbient E) s ∂μ := by
    refine lintegral_congr_ae ?_
    filter_upwards [hμ] with x hx
    rw [orbitLaw_eq_sphereUniformAmbient hι κ (fun y hy => htrans x y hx hy)]
  rw [h1, h2]
  simp_rw [h3]
  rw [h4, lintegral_const, measure_univ, mul_one]

end Uniqueness

namespace Orthogonal
variable (d : ℕ)

/-- **Uniqueness at `O(d)`.**  Every `O(d)`-invariant probability measure on `ℝ^d` carried by
the unit sphere is the uniform law on the sphere.  With `orbitLaw_haar` this is Proposition 1
in the form the paper's proof invokes: the uniform law is *the* rotation-invariant law. -/
theorem eq_sphereUniformAmbient_of_invariant (μ : Measure (Ed d)) [IsProbabilityMeasure μ]
    (hμ : ∀ᵐ x ∂μ, ‖x‖ = 1) (hinv : ∀ g : Od d, μ.map (fun x => g • x) = μ) :
    μ = sphereUniformAmbient (Ed d) := by
  haveI : (ae μ).NeBot := ae_neBot.mpr (IsProbabilityMeasure.ne_zero μ)
  obtain ⟨x₀, h₀⟩ := hμ.exists
  haveI : Nontrivial (Ed d) := ⟨⟨x₀, 0, by rintro rfl; simp at h₀⟩⟩
  exact Progressive.eq_sphereUniformAmbient_of_invariant (ι := iso d) (fun g x => iso_apply d g x)
    (haarOd d) (fun x y hx hy => transitive d hx y hy) μ hμ hinv

end Orthogonal

/-!
# §46  The constant of the block law

§20 and §21 prove that a `B`-block of a uniform direction on the sphere of `ℝ^d` has density
proportional to `(1 − ‖x‖²)^{(d−B−2)/2}` on the unit ball, the constant being the inverse of the
total mass, and §21 identifies that constant with the paper's `f_d` for `B = 1`.  This section
computes it for every `B` without a radial integral: §20's unnormalised identity
`(σ_{U×V})_* fst = σ_V(univ) · blockMeasure U (dim V)` applied to the whole space reads
`(B+m) vol(ball_{B+m}) = m vol(ball_m) · mass`, and Mathlib's `vol(ball_n) = √π^n/Γ(n/2+1)`
with `Γ(x+1) = xΓ(x)` gives `mass = √π^B Γ(m/2)/Γ((B+m)/2)`.

* `blockMeasure_univ`: `∫_{ball} (1 − ‖x‖²)^{(m−2)/2} dx = √π^B Γ(m/2)/Γ((B+m)/2)`.
* `blockLaw_eq_withDensity`: the block law is
  `Γ((B+m)/2)/(√π^B Γ(m/2)) · (1 − ‖x‖²)^{(m−2)/2}` on the unit ball, Lemma 1 in block form
  with its constant, the law the `E8` and trellis stages of §17 integrate against.
-/

open Metric

section BlockConstant

variable (U : Type*) [NormedAddCommGroup U] [InnerProductSpace ℝ U] [MeasurableSpace U]
  [BorelSpace U] [FiniteDimensional ℝ U] [Nontrivial U]

/-- The closed-form normalising mass of the block density. -/
noncomputable def blockMass (B m : ℕ) : ℝ :=
  Real.sqrt π ^ B * Real.Gamma ((m : ℝ) / 2) / Real.Gamma (((B : ℝ) + m) / 2)

theorem blockMass_pos {B m : ℕ} (hm : 1 ≤ m) : 0 < blockMass B m := by
  unfold blockMass
  have hm' : (0 : ℝ) < m := by exact_mod_cast hm
  have h1 : 0 < Real.Gamma ((m : ℝ) / 2) := Real.Gamma_pos_of_pos (by positivity)
  have h2 : 0 < Real.Gamma (((B : ℝ) + m) / 2) := Real.Gamma_pos_of_pos (by positivity)
  positivity

/-- **The mass of the block density**: `∫_{ball} (1 − ‖x‖²)^{(m−2)/2} dx = √π^B Γ(m/2)/Γ((B+m)/2)`,
read off from the block marginal of the sphere measure (§20) applied to the whole space, with
the volumes of balls from Mathlib. -/
theorem blockMeasure_univ (m : ℕ) (hm : 1 ≤ m) :
    blockMeasure U m Set.univ = ENNReal.ofReal (blockMass (Module.finrank ℝ U) m) := by
  haveI : Nonempty (Fin m) := ⟨⟨0, by omega⟩⟩
  have hmV : Module.finrank ℝ (EuclideanSpace ℝ (Fin m)) = m := finrank_euclideanSpace_fin
  have h := congrArg (fun ν : Measure U => ν Set.univ)
    (toSphere_map_fst (U := U) (V := EuclideanSpace ℝ (Fin m)))
  rw [Measure.map_apply measurable_sphere_fst MeasurableSet.univ, Set.preimage_univ,
    Measure.smul_apply, smul_eq_mul, hmV, Measure.toSphere_apply_univ, Measure.toSphere_apply_univ,
    InnerProductSpace.volume_ball, InnerProductSpace.volume_ball, finrank_withLp_prod, hmV] at h
  set B := Module.finrank ℝ U with hB
  have hm' : (0 : ℝ) < m := by exact_mod_cast hm
  have hB' : (0 : ℝ) < B := by exact_mod_cast Module.finrank_pos
  have hΓm : 0 < Real.Gamma ((m : ℝ) / 2) := Real.Gamma_pos_of_pos (by positivity)
  have hΓBm : 0 < Real.Gamma (((B : ℝ) + m) / 2) := Real.Gamma_pos_of_pos (by positivity)
  have hΓm1 : 0 < Real.Gamma ((m : ℝ) / 2 + 1) := Real.Gamma_pos_of_pos (by positivity)
  have hΓBm1 : 0 < Real.Gamma (((B + m : ℕ) : ℝ) / 2 + 1) := Real.Gamma_pos_of_pos (by positivity)
  have hc : (m : ℝ≥0∞) * (ENNReal.ofReal 1 ^ m
      * ENNReal.ofReal (Real.sqrt π ^ m / Real.Gamma ((m : ℝ) / 2 + 1)))
      = ENNReal.ofReal (m * (Real.sqrt π ^ m / Real.Gamma ((m : ℝ) / 2 + 1))) := by
    rw [ENNReal.ofReal_one, one_pow, one_mul, ENNReal.ofReal_mul (by positivity),
      ENNReal.ofReal_natCast]
  have ha : ((B + m : ℕ) : ℝ≥0∞) * (ENNReal.ofReal 1 ^ (B + m)
      * ENNReal.ofReal (Real.sqrt π ^ (B + m) / Real.Gamma (((B + m : ℕ) : ℝ) / 2 + 1)))
      = ENNReal.ofReal ((B + m : ℕ) * (Real.sqrt π ^ (B + m)
          / Real.Gamma (((B + m : ℕ) : ℝ) / 2 + 1))) := by
    rw [ENNReal.ofReal_one, one_pow, one_mul, ENNReal.ofReal_mul (by positivity),
      ENNReal.ofReal_natCast]
  rw [ha, hc] at h
  have hc0 : ENNReal.ofReal (m * (Real.sqrt π ^ m / Real.Gamma ((m : ℝ) / 2 + 1))) ≠ 0 := by
    rw [ne_eq, ENNReal.ofReal_eq_zero, not_le]; positivity
  refine (ENNReal.mul_right_inj hc0 ENNReal.ofReal_ne_top).mp ?_
  rw [← h, ← ENNReal.ofReal_mul (by positivity)]
  congr 1
  unfold blockMass
  rw [Real.Gamma_add_one (by positivity : ((m : ℝ) / 2) ≠ 0),
    Real.Gamma_add_one (by positivity : (((B + m : ℕ) : ℝ) / 2) ≠ 0)]
  push_cast
  field_simp
  ring

/-- **Lemma 1, block form, with its constant**: the law of a `B`-block of a uniform direction on
the sphere of dimension `B + m` has density `Γ((B+m)/2)/(√π^B Γ(m/2)) · (1 − ‖x‖²)^{(m−2)/2}` on
the unit ball. -/
theorem blockLaw_eq_withDensity (m : ℕ) (hm : 1 ≤ m) :
    blockLaw U m = (volume.restrict (ball (0 : U) 1)).withDensity fun x =>
      ENNReal.ofReal ((blockMass (Module.finrank ℝ U) m)⁻¹ * (1 - ‖x‖ ^ 2) ^ (((m : ℝ) - 2) / 2)) := by
  rw [blockLaw, blockMeasure_univ U m hm, ← ENNReal.ofReal_inv_of_pos (blockMass_pos hm), blockMeasure,
    ← withDensity_smul _ (measurable_blockDensity m)]
  congr 1
  funext x
  rw [Pi.smul_apply, smul_eq_mul, blockDensity, ← ENNReal.ofReal_mul (inv_nonneg.mpr (blockMass_pos hm).le)]

end BlockConstant

/-!
# §47  The dimension restriction of Lemma 1 is necessary

Lemma 1 (`sphericalPdf_*`, §4) and the coordinate law it describes
(`sphereUniformAmbient_map_coord`, §22) both carry the hypothesis `2 ≤ d`.  The paper states
that this is necessary rather than cosmetic.  That claim is proved here rather than asserted.

At `d = 1` the unit sphere of `ℝ¹` is the two-point set `{-1, 1}`, so the law of the single
coordinate of a uniform direction puts all its mass on two points.  A measure carried by a
finite set is singular with respect to Lebesgue measure, so it admits no density: there is no
`f₁` for which Lemma 1 could hold, and weakening `2 ≤ d` to `1 ≤ d` would make the statement
false rather than merely unproved.  The corresponding restriction on §13's variance bound is of
a different kind, arithmetic rather than measure-theoretic, since that bound divides by `d - 2`.

* `norm_eq_abs_coord_one`: on `ℝ¹` the norm is the absolute value of the one coordinate.
* `coord_mem_pair_of_mem_sphere_one`: the unit sphere of `ℝ¹` lands in `{-1, 1}`.
* `coordLaw_one_pair`: that two-point set carries all of the coordinate law's mass.
* `not_absolutelyContinuous_coordLaw_one`: the law is therefore not absolutely continuous with
  respect to `volume`, hence has no density.
-/

open Metric

section DimensionNecessary

theorem norm_eq_abs_coord_one (x : EuclideanSpace ℝ (Fin 1)) : ‖x‖ = |x 0| := by
  rw [EuclideanSpace.norm_eq]
  simp [Real.sqrt_sq_eq_abs]

theorem coord_mem_pair_of_mem_sphere_one {x : EuclideanSpace ℝ (Fin 1)}
    (hx : x ∈ sphere (0 : EuclideanSpace ℝ (Fin 1)) 1) : x 0 ∈ ({-1, 1} : Set ℝ) := by
  have hx1 : ‖x‖ = 1 := by simpa using mem_sphere_iff_norm.mp hx
  have habs : |x 0| = 1 := by rw [← norm_eq_abs_coord_one]; exact hx1
  rcases (abs_eq (by norm_num : (0:ℝ) ≤ 1)).mp habs with h | h
  · simp [h]
  · simp [h]

theorem measurable_coord_one : Measurable (fun x : EuclideanSpace ℝ (Fin 1) => x 0) := by
  fun_prop

/-- At `d = 1` the whole coordinate law sits on `{-1, 1}`. -/
theorem coordLaw_one_pair :
    ((sphereUniformAmbient (EuclideanSpace ℝ (Fin 1))).map (fun x => x 0))
      ({-1, 1} : Set ℝ) = 1 := by
  have hpair : MeasurableSet ({-1, 1} : Set ℝ) :=
    (measurableSet_singleton _).union (measurableSet_singleton _)
  rw [Measure.map_apply measurable_coord_one hpair, sphereUniformAmbient,
    Measure.map_apply measurable_subtype_coe (measurable_coord_one hpair)]
  have huniv : (Subtype.val ⁻¹'
      ((fun x : EuclideanSpace ℝ (Fin 1) => x 0) ⁻¹' ({-1, 1} : Set ℝ)) :
      Set (sphere (0 : EuclideanSpace ℝ (Fin 1)) 1)) = Set.univ := by
    ext p
    simp only [Set.mem_preimage, Set.mem_univ, iff_true]
    exact coord_mem_pair_of_mem_sphere_one p.2
  rw [huniv, measure_univ]

/-- Lemma 1's `2 ≤ d` is necessary: at `d = 1` the coordinate law of a uniform direction is
carried by two points, so it is singular with respect to Lebesgue measure and has no density. -/
theorem not_absolutelyContinuous_coordLaw_one :
    ¬ ((sphereUniformAmbient (EuclideanSpace ℝ (Fin 1))).map (fun x => x 0)
        ≪ (volume : Measure ℝ)) := by
  intro hac
  have hfin : ({-1, 1} : Set ℝ).Finite := (Set.finite_singleton _).insert _
  have hzero := hac (hfin.measure_zero volume)
  rw [coordLaw_one_pair] at hzero
  exact one_ne_zero hzero

end DimensionNecessary

/-! ## §48  Every coordinate of the deployed rotation carries the same law

§36 records the second and fourth moments of a coordinate of `H D_ε x`.  That was enough to
reduce the discrepancy against the Haar rate to the spikiness `∑ⱼ xⱼ⁴`, but it says nothing
about the coordinate's *law*, and it leaves the per-pass rate of the deployed rotation bounded
only by its extreme values over the sphere.

This section closes that gap.  Writing `σᵢⱼ = √d Hᵢⱼ ∈ {±1}`, coordinate `i` is the Rademacher
sum `∑ⱼ σᵢⱼ xⱼ εⱼ / √d`, and the `εⱼ` are i.i.d. symmetric, so `σᵢⱼ εⱼ` has the law of `εⱼ`.
Every coordinate therefore carries the *same* law, that of `∑ⱼ xⱼ εⱼ / √d`, and it does not
depend on `i` or on which flat `H` was used.

The consequence for the paper is that `ρ_H²(x)`, the deployed per-pass rate, is not merely
sandwiched: for a stage that acts coordinatewise it is *exactly* the expectation of the stage's
error against one scalar law, which is what makes the fourth-moment comparison of §37 the whole
story rather than one term of it.

Nothing here is asymptotic and nothing is assumed about `x`. -/

namespace CoordLaw

open Hadamard

variable {n d : ℕ}

/-- Flipping a sign bit negates `sgn`. -/
theorem sgn_not (b : Bool) : sgn (!b) = -sgn b := by cases b <;> simp [sgn]

/-- Flipping a fixed set of bits is an involution of the sign cube. -/
def flipEquiv (τ : Fin n → Bool) : Signs n ≃ Signs n where
  toFun s := fun j => xor (τ j) (s j)
  invFun s := fun j => xor (τ j) (s j)
  left_inv s := by funext j; simp
  right_inv s := by funext j; simp

/-- **The law of a Rademacher sum depends only on `|aⱼ|`.**  Averaging any `f` over the sign
cube gives the same value for weight vectors that agree up to sign, because flipping the bits
where they disagree is a bijection of the cube. -/
theorem signAvg_radSum_congr_abs {a b : Fin n → ℝ} (hab : ∀ j, |a j| = |b j|) (f : ℝ → ℝ) :
    signAvg (fun s => f (radSum a s)) = signAvg (fun s => f (radSum b s)) := by
  set τ : Fin n → Bool := fun j => decide (a j ≠ b j) with hτ
  have key : ∀ s : Signs n, radSum b (flipEquiv τ s) = radSum a s := by
    intro s
    unfold radSum
    refine Finset.sum_congr rfl fun j _ => ?_
    show b j * sgn (xor (τ j) (s j)) = a j * sgn (s j)
    by_cases h : a j = b j
    · have hf : τ j = false := by simp [hτ, h]
      rw [hf, Bool.false_xor, h]
    · have ht : τ j = true := by simp [hτ, h]
      have hneg : a j = -b j := (abs_eq_abs.mp (hab j)).resolve_left h
      rw [ht, Bool.true_xor, sgn_not, hneg]
      ring
  unfold signAvg
  congr 1
  exact Fintype.sum_equiv (flipEquiv τ) (fun s => f (radSum a s)) (fun s => f (radSum b s))
    (fun s => (congrArg f (key s)).symm)

/-- **Every coordinate carries the same law**, namely that of `∑ⱼ xⱼ εⱼ / √d`.  The right-hand
side mentions neither `i` nor `H`. -/
theorem signAvg_coord_eq_signAvg_radSum {H : Od d} (hH : IsFlat H) (x : Ed d) (i : Fin d)
    (f : ℝ → ℝ) :
    signAvg (fun s => f ((hadRot H s • x) i))
      = signAvg (fun s => f (radSum (fun j => x j / Real.sqrt d) s)) := by
  simp_rw [hadRot_apply_eq_radSum]
  refine signAvg_radSum_congr_abs (fun j => ?_) f
  have hd : (0 : ℝ) ≤ (d : ℝ) := Nat.cast_nonneg d
  have habs : |(H : Matrix (Fin d) (Fin d) ℝ) i j| = 1 / Real.sqrt d := by
    have h := hH i j
    have h1 : |(H : Matrix (Fin d) (Fin d) ℝ) i j| = Real.sqrt (1 / (d : ℝ)) := by
      rw [← h, Real.sqrt_sq_eq_abs]
    rw [h1, one_div, Real.sqrt_inv, one_div]
  rw [abs_mul, habs, abs_div, abs_of_nonneg (Real.sqrt_nonneg ((d : ℝ)))]
  ring

/-- **The coordinate law is the same for every flat rotation.**  Two flat `H`, `H'` and any two
coordinates give the same average, so the deployed rate depends on the direction alone. -/
theorem signAvg_coord_indep {H H' : Od d} (hH : IsFlat H) (hH' : IsFlat H') (x : Ed d)
    (i i' : Fin d) (f : ℝ → ℝ) :
    signAvg (fun s => f ((hadRot H s • x) i)) = signAvg (fun s => f ((hadRot H' s • x) i')) := by
  rw [signAvg_coord_eq_signAvg_radSum hH x i f, signAvg_coord_eq_signAvg_radSum hH' x i' f]

end CoordLaw

/-! ## §48b  The coordinate law is one scalar law

§48 shows that every coordinate of `H D_ε v` gives the same *average* of every `f`.  That is an
identity between numbers, one for each `f`, and downstream arguments that want to name the
common object have to keep carrying `f` along.

This section upgrades it to an identity of measures.  `radLaw d v` is the law of the Rademacher
sum `∑ⱼ vⱼ εⱼ / √d` under the uniform law on the sign cube, so it is a law on `ℝ` carried by at
most `2 ^ d` points; `coordLaw_eq_radLaw` identifies the law of coordinate `i` of `H D_ε v` with
it for every flat `H` and every `i`, and `coordLaw_indep` is the resulting statement that the
coordinate law depends on `v` alone.

The route is a pushforward computation and nothing more: counting measure on the sign cube is
invariant under a relabelling of the cube (`map_count_equiv`), hence so is the uniform law
(`map_uniformSigns_equiv`), and the flip of the disagreeing bits is the relabelling that carries
one weight vector to another agreeing with it up to sign (`map_radSum_congr_abs`).  The averaged
form `signAvg_radSum_congr_abs` of §48 is the corresponding statement against a fixed test
function; it is proved on its own in §48 and is not rederived from the measure form here.

Nothing here is asymptotic, nothing is assumed about `v`, and no claim is made about how
`radLaw d v` relates to the spherical coordinate law `sphericalCoordLaw d`.  The only comparison
of those two anywhere in this development is §37's, between their fourth moments; §41 to §44
compare the coordinate law with a *Gaussian*, which is a different second law and does not
compose with §37 into a statement about `f_d`. -/

namespace CoordLaw

open Hadamard

variable {n d : ℕ}

/-- Counting measure on the sign cube is invariant under any relabelling of the cube. -/
theorem map_count_equiv (e : Signs n ≃ Signs n) :
    (Measure.count : Measure (Signs n)).map e = Measure.count := by
  refine Measure.ext fun s hs => ?_
  have himg : (e : Signs n → Signs n) ⁻¹' s = (e.symm : Signs n → Signs n) '' s := by
    rw [Equiv.image_eq_preimage_symm, Equiv.symm_symm]
  rw [Measure.map_apply (measurable_of_countable _) hs, himg,
    Measure.count_injective_image e.symm.injective]

/-- The uniform law on the sign cube is invariant under any relabelling of the cube. -/
theorem map_uniformSigns_equiv (e : Signs n ≃ Signs n) :
    (uniformSigns n).map e = uniformSigns n := by
  rw [uniformSigns, Measure.map_smul, map_count_equiv e]

/-- Two weight vectors agreeing up to sign are carried to one another by a relabelling of the
sign cube, namely the flip of the bits where they disagree.  This is the same pointwise identity
that `signAvg_radSum_congr_abs` establishes inline in §48, packaged here so that the flip itself
stays out of the statement. -/
theorem exists_equiv_radSum_comp {a b : Fin n → ℝ} (hab : ∀ j, |a j| = |b j|) :
    ∃ e : Signs n ≃ Signs n, ∀ s, radSum b (e s) = radSum a s := by
  refine ⟨flipEquiv (fun j => decide (a j ≠ b j)), fun s => ?_⟩
  unfold radSum
  refine Finset.sum_congr rfl fun j _ => ?_
  show b j * sgn (xor (decide (a j ≠ b j)) (s j)) = a j * sgn (s j)
  by_cases h : a j = b j
  · have hf : decide (a j ≠ b j) = false := by simp [h]
    rw [hf, Bool.false_xor, h]
  · have ht : decide (a j ≠ b j) = true := by simp [h]
    have hneg : a j = -b j := (abs_eq_abs.mp (hab j)).resolve_left h
    rw [ht, Bool.true_xor, sgn_not, hneg]
    ring

/-- **The law of a Rademacher sum depends only on `|aⱼ|`**, as an equality of measures and not
only under an average. -/
theorem map_radSum_congr_abs {a b : Fin n → ℝ} (hab : ∀ j, |a j| = |b j|) :
    (uniformSigns n).map (radSum a) = (uniformSigns n).map (radSum b) := by
  obtain ⟨e, he⟩ := exists_equiv_radSum_comp hab
  have hcomp : (radSum b) ∘ (e : Signs n → Signs n) = radSum a := funext he
  rw [← hcomp, ← Measure.map_map (measurable_of_countable _) (measurable_of_countable _),
    map_uniformSigns_equiv]

/-- The law of `∑ⱼ vⱼ εⱼ / √d` when `ε` is uniform on the sign cube: a law on `ℝ` carried by
the image of the cube, so by at most `2 ^ d` points. -/
noncomputable def radLaw (d : ℕ) (v : Ed d) : Measure ℝ :=
  (uniformSigns d).map (fun s => radSum (fun j => v j / Real.sqrt d) s)

/-- **Every coordinate of a flat randomised rotation carries the law of `∑ⱼ vⱼ εⱼ / √d`.**  The
right-hand side mentions neither `i` nor `H`.  This is `signAvg_coord_eq_signAvg_radSum` as an
equality of measures. -/
theorem coordLaw_eq_radLaw {H : Od d} (hH : IsFlat H) (v : Ed d) (i : Fin d) :
    coordLaw H v i = radLaw d v := by
  have habs : ∀ j, |(H : Matrix (Fin d) (Fin d) ℝ) i j * v j| = |v j / Real.sqrt d| := by
    intro j
    have h1 : |(H : Matrix (Fin d) (Fin d) ℝ) i j| = 1 / Real.sqrt d := by
      have h := hH i j
      have h2 : |(H : Matrix (Fin d) (Fin d) ℝ) i j| = Real.sqrt (1 / (d : ℝ)) := by
        rw [← h, Real.sqrt_sq_eq_abs]
      rw [h2, one_div, Real.sqrt_inv, one_div]
    rw [abs_mul, h1, abs_div, abs_of_nonneg (Real.sqrt_nonneg ((d : ℝ)))]
    ring
  have hcoord : (fun s => (hadRot H s • v) i)
      = radSum (fun j => (H : Matrix (Fin d) (Fin d) ℝ) i j * v j) :=
    funext fun s => hadRot_apply_eq_radSum H s v i
  rw [coordLaw, hcoord, radLaw]
  exact map_radSum_congr_abs habs

/-- **The coordinate law is the same for every flat rotation and every coordinate.**  Two flat
`H`, `H'` and any two coordinates give the same law, so the law depends on `v` alone. -/
theorem coordLaw_indep {H H' : Od d} (hH : IsFlat H) (hH' : IsFlat H') (v : Ed d)
    (i i' : Fin d) : coordLaw H v i = coordLaw H' v i' := by
  rw [coordLaw_eq_radLaw hH v i, coordLaw_eq_radLaw hH' v i']

instance (d : ℕ) (v : Ed d) : IsProbabilityMeasure (radLaw d v) := by
  constructor
  rw [radLaw, Measure.map_apply (measurable_of_countable _) MeasurableSet.univ,
    Set.preimage_univ, measure_univ]

/-- Integration against the Rademacher law is an average over the sign cube. -/
theorem integral_radLaw (d : ℕ) (v : Ed d) {g : ℝ → ℝ} (hg : Measurable g) :
    ∫ x, g x ∂(radLaw d v) = signAvg fun s => g (radSum (fun j => v j / Real.sqrt d) s) := by
  rw [radLaw, integral_map (measurable_of_countable _).aemeasurable hg.aestronglyMeasurable,
    integral_uniformSigns]

end CoordLaw

/-! ## §48c  The deployed rate of a coordinatewise stage is one scalar quadrature

§36 leaves the deployed per-pass rate `ρ_H²(v)` of a direction `v` sandwiched between the
extreme values of the rate over the sphere, and §36's `hadRate_blockStage` writes it as a sum of
`d` sign averages, one per coordinate.  §48b makes every one of those coordinates carry the same
law `radLaw d v`.  Putting the two together replaces the sandwich, *at a fixed direction*, with
an equality: `hadRate_blockStage_eq_distortion` says the rate **is** `d · D(cb, radLaw d v)`, the
scalar quadrature of `(t − cb t)²` against one law on `ℝ`, with no inequality and no reference to
`H` or to any coordinate.

`hadRate_sub_rhoSq` is the same identity rearranged: the gap between the deployed rate and the
paper's `ρ² = d · D(cb, sphericalCoordLaw d)` is `d` times the difference of the same scalar
functional against two scalar laws.  Whatever is still to be proved about the deployed rate is
therefore a comparison of `radLaw d v` with `sphericalCoordLaw d` under the single test function
`t ↦ (t − cb t)²`.  §37 is the one place that compares those two laws, and it does so under
`t ↦ t⁴`; §41 to §44 bound the distance from the coordinate law to a Gaussian, which is a
different comparison and is not composed with §37 anywhere here.

What is *not* proved here.  Neither statement says the deployed rate equals the Haar rate: the
right-hand side of `hadRate_sub_rhoSq` is not shown to vanish, and it does not vanish in general.
Both statements are restricted to a stage of the form `blockStage cb`, that is a single scalar
codebook applied to every coordinate, and to a flat `H`; for a general quantiser `q` the rate
does not split across coordinates at all.  And the sandwich is not discharged where §36 *uses*
it: `integral_norm_resid_sq_le_had` ranges over every unit direction, so feeding it still needs a
bound on `d · D(cb, radLaw d v)` uniform in `v`, which this section does not supply.  Nothing
here is asymptotic and nothing is assumed about `v`. -/

namespace ScalarGap

open Hadamard CoordLaw

variable {d : ℕ}

/-- The scalar error functional of a measurable codebook is measurable, which is all
`integral_radLaw` needs of it.  The exponent is the one in `distortion`. -/
theorem measurable_sub_cb_sq {cb : ℝ → ℝ} (hcb : Measurable cb) :
    Measurable fun t : ℝ => (t - cb t) ^ 2 :=
  (measurable_id.sub hcb).pow_const 2

/-- `ρ²` is `d` times the per-coordinate distortion, by definition of both. -/
theorem rhoSq_eq_mul_distortion (d : ℕ) (cb : ℝ → ℝ) (ν : Measure ℝ) :
    rhoSq d cb ν = (d : ℝ) * distortion cb ν := rfl

/-- **The deployed rate of a coordinatewise stage is a scalar quadrature.**  For a flat `H` and a
measurable scalar codebook `cb`, the sign-averaged pass distortion of the direction `v` is
exactly `d` times the distortion of `cb` against the single law `radLaw d v`.  The right-hand
side mentions neither `H` nor any coordinate. -/
theorem hadRate_blockStage_eq_distortion {H : Od d} (hH : IsFlat H) {cb : ℝ → ℝ}
    (hcb : Measurable cb) (v : Ed d) :
    hadRate H (blockStage (m := d) (F := ℝ) cb) v = (d : ℝ) * distortion cb (radLaw d v) := by
  have hterm : ∀ i : Fin d,
      (signAvg fun s => ((hadRot H s • v) i - cb ((hadRot H s • v) i)) ^ 2)
        = distortion cb (radLaw d v) := by
    intro i
    rw [distortion, ← coordLaw_eq_radLaw hH v i,
      integral_coordLaw H v i (measurable_sub_cb_sq hcb)]
  rw [hadRate_blockStage, Finset.sum_congr rfl fun i _ => hterm i, Finset.sum_const,
    Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]

/-- **The gap to the paper's rate is one scalar comparison.**  The difference between the
deployed rate of a coordinatewise stage and `ρ² = d · D(cb, sphericalCoordLaw d)` is `d` times
the difference of the same scalar distortion against the two scalar laws.  This is an identity,
not a bound, and it does not assert that the difference is zero. -/
theorem hadRate_sub_rhoSq {H : Od d} (hH : IsFlat H) {cb : ℝ → ℝ}
    (hcb : Measurable cb) (v : Ed d) :
    hadRate H (blockStage (m := d) (F := ℝ) cb) v - rhoSq d cb (sphericalCoordLaw d)
      = (d : ℝ) * (distortion cb (radLaw d v) - distortion cb (sphericalCoordLaw d)) := by
  rw [hadRate_blockStage_eq_distortion hH hcb v, rhoSq_eq_mul_distortion, mul_sub]

end ScalarGap

/-! ## §49  The scalar gap is an exact finite cell sum

A deployed scalar quantiser has finitely many codewords, so `cb` is a step function: its values
lie in a finite list `S ⊆ ℝ`, and the *cell* of a codeword `c`, the set `cell cb c = cb ⁻¹' {c}`
of scalars that `cb` rounds to `c`, is measurable as soon as `cb` is.  Measurability of one cell
needs no finiteness at all, since `ℝ` has measurable singletons; finiteness of the range is what
makes the family of cells a *finite* measurable partition of the line, and hence what turns an
integral into a finite sum.

That is the whole content of `integral_eq_sum_setIntegral_cell` and `integral_mul_comp_eq_sum`:
an integral against `ν` splits over the cells, and a factor depending on `t` only through `cb t`
is constant on each cell and comes out of that cell's integral.  Expanding the square in
`distortion` and applying both gives `distortion_eq_cells`, which writes the distortion of `cb`
against `ν` in the three families of numbers a cell decomposition exposes: the second moment of
`ν`, the first moment of `ν` on each cell, and the mass `ν` gives each cell.  Subtracting two
copies of that gives `distortion_sub_distortion_eq_cells`, the gap between the distortions of one
quantiser against two laws, term by term; and reading the same identity the other way gives
`distortion_congr_of_cells`, which says that two laws agreeing in those three families of numbers
give `cb` the same distortion, however else they differ.

**These are identities, not bounds.**  Nothing is dropped, nothing is estimated, and no term is
signed.  In particular none of them says the gap between two laws is small, or that it is
controlled by any single summary statistic of the two laws: the right-hand side of
`distortion_sub_distortion_eq_cells` is a sum of `2 · card S + 1` signed differences of real
numbers, with no sign and no bound attached to any of them, and a bound on the gap would have to
come from separate control of those differences.  What the identity does establish is that the
gap depends on the pair of laws *only* through the cell masses, the cell first moments, and the
second moments, which is the precise form of `distortion_congr_of_cells`.  Whether any coarser
statistic of the two laws determines those numbers is not addressed here, in either direction.

The hypotheses are that `cb` is measurable with values in `S`, that each law is a finite measure,
and that each has a finite second moment.  The last two are not removable: without them the
second moment need not be a real number and the cross term `∫ t · cb t` need not converge, and
`∫` would silently return its junk value.  They are also sufficient, which is why no separate
integrability hypothesis on `cb` appears: a finite range bounds `|cb|` by `codewordBound S`, so
`∫ (cb t)²` and `∫ t · cb t` are controlled by the mass of `ν` and by its second moment.  By
`integrable_sub_cb_sq_iff` the second-moment hypothesis is not an extra assumption on top of
"the distortion is finite": under the other hypotheses the two are equivalent.

Nothing here is specific to the spherical coordinate law or to any particular codebook, and no
threshold or order structure on the codewords is used or assumed. -/

namespace ScalarGap

variable {cb : ℝ → ℝ} {ν ν' : Measure ℝ} {S : Finset ℝ}

/-- The cell of the codeword `c`: the scalars that `cb` rounds to `c`. -/
def cell (cb : ℝ → ℝ) (c : ℝ) : Set ℝ := cb ⁻¹' {c}

/-- A cell is measurable as soon as `cb` is.  Finiteness of the range plays no part: `ℝ` has
measurable singletons, so a cell is the preimage of a measurable set. -/
theorem measurableSet_cell (hcb : Measurable cb) (c : ℝ) : MeasurableSet (cell cb c) :=
  hcb (measurableSet_singleton c)

/-- Cells of distinct codewords are disjoint.  This holds for any `cb` whatsoever. -/
theorem pairwiseDisjoint_cell (cb : ℝ → ℝ) (S : Finset ℝ) :
    Set.PairwiseDisjoint (↑S) (cell cb) :=
  Set.pairwiseDisjoint_fiber cb ↑S

/-- If every value of `cb` lies in `S`, the cells of `S` cover the line.  Together with
`measurableSet_cell` and `pairwiseDisjoint_cell` this is the finite measurable partition. -/
theorem iUnion_cell_eq_univ (hS : Set.range cb ⊆ ↑S) : ⋃ c ∈ S, cell cb c = Set.univ := by
  have h : ⋃ c ∈ S, cell cb c = cb ⁻¹' ↑S := Finset.set_biUnion_preimage_singleton cb S
  rw [h, Set.eq_univ_iff_forall]
  exact fun t => hS ⟨t, rfl⟩

/-- **The cell decomposition of an integral.**  An integral against `ν` is the sum of the
integrals over the cells of a codeword list for `cb`.  Integrability of `f` on the whole line is
what is assumed; integrability on each cell follows. -/
theorem integral_eq_sum_setIntegral_cell (hcb : Measurable cb) (hS : Set.range cb ⊆ ↑S)
    {f : ℝ → ℝ} (hf : Integrable f ν) :
    ∫ t, f t ∂ν = ∑ c ∈ S, ∫ t in cell cb c, f t ∂ν := by
  conv_lhs => rw [← setIntegral_univ]
  rw [← iUnion_cell_eq_univ hS]
  exact integral_biUnion_finset S (fun c _ => measurableSet_cell hcb c)
    (pairwiseDisjoint_cell cb S) fun c _ => hf.integrableOn

/-- **A factor depending on `t` only through `cb t` comes out cell by cell.**  On the cell of `c`
the composite `g ∘ cb` is the constant `g c`, so the integral of `f · (g ∘ cb)` is the sum over
codewords of `g c` times the integral of `f` over the cell of `c`.  No hypothesis on `g` is needed
beyond integrability of the product: `g` is not assumed measurable, because `g ∘ cb` is constant
on each cell of the partition. -/
theorem integral_mul_comp_eq_sum (hcb : Measurable cb) (hS : Set.range cb ⊆ ↑S)
    (f g : ℝ → ℝ) (hfg : Integrable (fun t => f t * g (cb t)) ν) :
    ∫ t, f t * g (cb t) ∂ν = ∑ c ∈ S, g c * ∫ t in cell cb c, f t ∂ν := by
  rw [integral_eq_sum_setIntegral_cell hcb hS hfg]
  refine Finset.sum_congr rfl fun c _ => ?_
  rw [← integral_const_mul]
  refine setIntegral_congr_fun (measurableSet_cell hcb c) fun t ht => ?_
  have hct : cb t = c := ht
  rw [hct]; ring

/-! ### Integrability from a finite codeword list

Everything below needs to know that the cross term and the codeword square are integrable.  Both
follow from a single crude bound, the sum of the absolute codewords, so no integrability
hypothesis on `cb` itself ever appears in a statement. -/

/-- The sum of the absolute values of the codewords.  It dominates `|cb t|` for every `t`, which
is the only use made of finiteness of the range in the integrability lemmas below. -/
noncomputable def codewordBound (S : Finset ℝ) : ℝ := ∑ c ∈ S, |c|

/-- Every value of a quantiser with codeword list `S` is bounded by `codewordBound S`. -/
theorem abs_cb_le_codewordBound (hS : Set.range cb ⊆ ↑S) (t : ℝ) :
    |cb t| ≤ codewordBound S :=
  Finset.single_le_sum (f := fun c => |c|) (fun c _ => abs_nonneg c)
    (Finset.mem_coe.mp (hS ⟨t, rfl⟩))

/-- On a finite measure a square-integrable function is absolutely integrable, by `|x| ≤ 1 + x²`.
This is the only place finiteness of `ν` is used to get a first moment from a second. -/
theorem integrable_abs_of_integrable_sq [IsFiniteMeasure ν] {f : ℝ → ℝ}
    (hf : AEStronglyMeasurable f ν) (h2 : Integrable (fun t => f t ^ 2) ν) :
    Integrable (fun t => |f t|) ν := by
  have hb : Integrable (fun t : ℝ => 1 + f t ^ 2) ν := (integrable_const (1 : ℝ)).add h2
  refine Integrable.mono' hb (continuous_abs.comp_aestronglyMeasurable hf)
    (Filter.Eventually.of_forall fun t => ?_)
  rw [Real.norm_eq_abs, abs_abs]
  nlinarith [sq_nonneg (|f t| - 1), sq_abs (f t), abs_nonneg (f t)]

/-- `(cb ·)²` is integrable against any finite measure: it is measurable and bounded by
`codewordBound S ^ 2`.  No moment hypothesis on `ν` is used. -/
theorem integrable_cb_sq [IsFiniteMeasure ν] (hcb : Measurable cb) (hS : Set.range cb ⊆ ↑S) :
    Integrable (fun t => cb t ^ 2) ν := by
  refine Integrable.mono' (integrable_const (codewordBound S ^ 2))
    (hcb.pow_const 2).aestronglyMeasurable (Filter.Eventually.of_forall fun t => ?_)
  rw [Real.norm_eq_abs, abs_pow]
  exact pow_le_pow_left₀ (abs_nonneg _) (abs_cb_le_codewordBound hS t) 2

/-- The cross term `t · cb t` is integrable: `|cb|` is bounded by `codewordBound S` and `ν` has a
finite second moment, hence a finite first absolute moment. -/
theorem integrable_mul_cb [IsFiniteMeasure ν] (hcb : Measurable cb) (hS : Set.range cb ⊆ ↑S)
    (h2 : Integrable (fun t : ℝ => t ^ 2) ν) : Integrable (fun t => t * cb t) ν := by
  refine Integrable.mono'
    ((integrable_abs_of_integrable_sq aestronglyMeasurable_id h2).const_mul (codewordBound S))
    (measurable_id.mul hcb).aestronglyMeasurable (Filter.Eventually.of_forall fun t => ?_)
  rw [Real.norm_eq_abs, abs_mul]
  calc |t| * |cb t| ≤ |t| * codewordBound S :=
        mul_le_mul_of_nonneg_left (abs_cb_le_codewordBound hS t) (abs_nonneg t)
    _ = codewordBound S * |t| := mul_comm _ _

/-- The same bound with a general square-integrable `f` in place of the identity: a bounded
quantiser multiplies a square-integrable function into an integrable one. -/
theorem integrable_mul_cb' [IsFiniteMeasure ν] (hcb : Measurable cb) (hS : Set.range cb ⊆ ↑S)
    {f : ℝ → ℝ} (hf : AEStronglyMeasurable f ν) (h2 : Integrable (fun t => f t ^ 2) ν) :
    Integrable (fun t => f t * cb t) ν := by
  refine Integrable.mono'
    ((integrable_abs_of_integrable_sq hf h2).const_mul (codewordBound S))
    (hf.mul hcb.aestronglyMeasurable) (Filter.Eventually.of_forall fun t => ?_)
  rw [Real.norm_eq_abs, abs_mul]
  calc |f t| * |cb t| ≤ |f t| * codewordBound S :=
        mul_le_mul_of_nonneg_left (abs_cb_le_codewordBound hS t) (abs_nonneg _)
    _ = codewordBound S * |f t| := mul_comm _ _

/-- **A finite distortion and a finite second moment are the same hypothesis** for a measurable
quantiser with finitely many codewords against a finite measure, because the two functions differ
by the bounded `cb`.  So `distortion_eq_cells` may be read as taking finiteness of its own
left-hand side as its moment hypothesis. -/
theorem integrable_sub_cb_sq_iff [IsFiniteMeasure ν] (hcb : Measurable cb)
    (hS : Set.range cb ⊆ ↑S) :
    Integrable (fun t : ℝ => (t - cb t) ^ 2) ν ↔ Integrable (fun t : ℝ => t ^ 2) ν := by
  have hsq := integrable_cb_sq (ν := ν) hcb hS
  constructor
  · intro h
    have hmix : Integrable (fun t : ℝ => 2 * ((t - cb t) * cb t)) ν :=
      (integrable_mul_cb' hcb hS (measurable_id.sub hcb).aestronglyMeasurable h).const_mul 2
    have hall : Integrable
        (fun t : ℝ => (t - cb t) ^ 2 + 2 * ((t - cb t) * cb t) + cb t ^ 2) ν :=
      (h.add hmix).add hsq
    exact hall.congr (Filter.Eventually.of_forall fun t => by ring)
  · intro h
    have hmix : Integrable (fun t : ℝ => 2 * (t * cb t)) ν :=
      (integrable_mul_cb hcb hS h).const_mul 2
    have hall : Integrable (fun t : ℝ => t ^ 2 - 2 * (t * cb t) + cb t ^ 2) ν :=
      (h.sub hmix).add hsq
    exact hall.congr (Filter.Eventually.of_forall fun t => by ring)

/-! ### The identity, the gap, and what the gap depends on -/

/-- **The distortion in cell form.**  For a measurable `cb` whose values all lie in the finite
list `S`, and a finite `ν` of finite second moment, the distortion is the second moment of `ν`,
less twice the codeword-weighted first moments of `ν` on the cells, plus the
codeword-squared-weighted cell masses.  This is an identity, and every term on the right is a real
number under those hypotheses. -/
theorem distortion_eq_cells [IsFiniteMeasure ν] (hcb : Measurable cb)
    (hS : Set.range cb ⊆ ↑S) (h2 : Integrable (fun t : ℝ => t ^ 2) ν) :
    distortion cb ν
      = (∫ t, t ^ 2 ∂ν)
        - 2 * ∑ c ∈ S, c * ∫ t in cell cb c, t ∂ν
        + ∑ c ∈ S, c ^ 2 * ν.real (cell cb c) := by
  have hmul := integrable_mul_cb hcb hS h2
  have hsq := integrable_cb_sq (ν := ν) hcb hS
  have hA : ∫ t, t * cb t ∂ν = ∑ c ∈ S, c * ∫ t in cell cb c, t ∂ν :=
    integral_mul_comp_eq_sum hcb hS (fun t => t) (fun t => t) hmul
  have hB : ∫ t, cb t ^ 2 ∂ν = ∑ c ∈ S, c ^ 2 * ν.real (cell cb c) := by
    have h := integral_mul_comp_eq_sum hcb hS (fun _ => (1 : ℝ)) (fun c => c ^ 2)
      (by simpa using hsq)
    simpa using h
  have hcross : Integrable (fun t : ℝ => 2 * (t * cb t)) ν := hmul.const_mul 2
  have hhead : Integrable (fun t : ℝ => t ^ 2 - 2 * (t * cb t)) ν := h2.sub hcross
  have hexp : ∀ t : ℝ, (t - cb t) ^ 2 = t ^ 2 - 2 * (t * cb t) + cb t ^ 2 := fun t => by ring
  unfold distortion
  simp_rw [hexp]
  rw [integral_add hhead hsq, integral_sub h2 hcross, integral_const_mul, hA, hB]

/-- **The exact gap in cell form.**  Two copies of `distortion_eq_cells` for the same quantiser
against two laws, subtracted: the gap between the distortions is the gap between the second
moments, less twice the codeword-weighted gaps between the cell first moments, plus the
codeword-squared-weighted gaps between the cell masses.  This is an identity and not a bound:
nothing is dropped, no term is signed, and it does not by itself say the gap is small. -/
theorem distortion_sub_distortion_eq_cells [IsFiniteMeasure ν] [IsFiniteMeasure ν']
    (hcb : Measurable cb) (hS : Set.range cb ⊆ ↑S)
    (h2 : Integrable (fun t : ℝ => t ^ 2) ν) (h2' : Integrable (fun t : ℝ => t ^ 2) ν') :
    distortion cb ν - distortion cb ν'
      = ((∫ t, t ^ 2 ∂ν) - ∫ t, t ^ 2 ∂ν')
        - 2 * ∑ c ∈ S, c * ((∫ t in cell cb c, t ∂ν) - ∫ t in cell cb c, t ∂ν')
        + ∑ c ∈ S, c ^ 2 * (ν.real (cell cb c) - ν'.real (cell cb c)) := by
  rw [distortion_eq_cells hcb hS h2, distortion_eq_cells hcb hS h2']
  simp only [mul_sub, Finset.sum_sub_distrib]
  ring

/-- **The distortion depends on the law only through the second moment, the cell masses and the
cell first moments.**  Two laws that agree in those numbers, on the cells of the codeword list `S`
alone, give `cb` the same distortion; they are otherwise unrelated, and no bound on any distance
between them is assumed or produced.  It is read off from two copies of `distortion_eq_cells`,
so like that identity it estimates nothing. -/
theorem distortion_congr_of_cells [IsFiniteMeasure ν] [IsFiniteMeasure ν']
    (hcb : Measurable cb) (hS : Set.range cb ⊆ ↑S)
    (h2 : Integrable (fun t : ℝ => t ^ 2) ν) (h2' : Integrable (fun t : ℝ => t ^ 2) ν')
    (hmom : ∫ t, t ^ 2 ∂ν = ∫ t, t ^ 2 ∂ν')
    (hmass : ∀ c ∈ S, ν.real (cell cb c) = ν'.real (cell cb c))
    (hmean : ∀ c ∈ S, (∫ t in cell cb c, t ∂ν) = ∫ t in cell cb c, t ∂ν') :
    distortion cb ν = distortion cb ν' := by
  have hX : ∑ c ∈ S, c * ∫ t in cell cb c, t ∂ν = ∑ c ∈ S, c * ∫ t in cell cb c, t ∂ν' :=
    Finset.sum_congr rfl fun c hc => by rw [hmean c hc]
  have hY : ∑ c ∈ S, c ^ 2 * ν.real (cell cb c) = ∑ c ∈ S, c ^ 2 * ν'.real (cell cb c) :=
    Finset.sum_congr rfl fun c hc => by rw [hmass c hc]
  rw [distortion_eq_cells hcb hS h2, distortion_eq_cells hcb hS h2', hmom, hX, hY]

/-! ### The same three statements from finiteness of the range alone

`Set.range cb ⊆ ↑S` is the convenient hypothesis, since a deployed codebook is given as a list and
the sums then range over the nominal codebook rather than over the realised range.  When only
`(Set.range cb).Finite` is on hand, `Set.Finite.toFinset` supplies the list. -/

/-- The cell decomposition with the codeword list taken to be the range itself. -/
theorem integral_eq_sum_setIntegral_cell_of_finite (hcb : Measurable cb)
    (hfin : (Set.range cb).Finite) {f : ℝ → ℝ} (hf : Integrable f ν) :
    ∫ t, f t ∂ν = ∑ c ∈ hfin.toFinset, ∫ t in cell cb c, f t ∂ν :=
  integral_eq_sum_setIntegral_cell hcb hfin.coe_toFinset.ge hf

/-- The distortion in cell form with the codeword list taken to be the range itself. -/
theorem distortion_eq_cells_of_finite [IsFiniteMeasure ν] (hcb : Measurable cb)
    (hfin : (Set.range cb).Finite) (h2 : Integrable (fun t : ℝ => t ^ 2) ν) :
    distortion cb ν
      = (∫ t, t ^ 2 ∂ν)
        - 2 * ∑ c ∈ hfin.toFinset, c * ∫ t in cell cb c, t ∂ν
        + ∑ c ∈ hfin.toFinset, c ^ 2 * ν.real (cell cb c) :=
  distortion_eq_cells hcb hfin.coe_toFinset.ge h2

/-- The exact gap with the codeword list taken to be the range itself.  Still an identity, still
not a bound. -/
theorem distortion_sub_distortion_eq_cells_of_finite [IsFiniteMeasure ν] [IsFiniteMeasure ν']
    (hcb : Measurable cb) (hfin : (Set.range cb).Finite)
    (h2 : Integrable (fun t : ℝ => t ^ 2) ν) (h2' : Integrable (fun t : ℝ => t ^ 2) ν') :
    distortion cb ν - distortion cb ν'
      = ((∫ t, t ^ 2 ∂ν) - ∫ t, t ^ 2 ∂ν')
        - 2 * ∑ c ∈ hfin.toFinset, c * ((∫ t in cell cb c, t ∂ν) - ∫ t in cell cb c, t ∂ν')
        + ∑ c ∈ hfin.toFinset, c ^ 2 * (ν.real (cell cb c) - ν'.real (cell cb c)) :=
  distortion_sub_distortion_eq_cells hcb hfin.coe_toFinset.ge h2 h2'

/-- Agreement of the second moments and of the cell masses and cell first moments at *every* real
`c` forces equal distortion.  Quantifying over all of `ℝ` assumes more than the proof uses: it is
restricted at once to the range of `cb`, which is the codeword list here. -/
theorem distortion_congr_of_cells_of_finite [IsFiniteMeasure ν] [IsFiniteMeasure ν']
    (hcb : Measurable cb) (hfin : (Set.range cb).Finite)
    (h2 : Integrable (fun t : ℝ => t ^ 2) ν) (h2' : Integrable (fun t : ℝ => t ^ 2) ν')
    (hmom : ∫ t, t ^ 2 ∂ν = ∫ t, t ^ 2 ∂ν')
    (hmass : ∀ c, ν.real (cell cb c) = ν'.real (cell cb c))
    (hmean : ∀ c, (∫ t in cell cb c, t ∂ν) = ∫ t in cell cb c, t ∂ν') :
    distortion cb ν = distortion cb ν' :=
  distortion_congr_of_cells hcb hfin.coe_toFinset.ge h2 h2' hmom
    (fun c _ => hmass c) fun c _ => hmean c

/-! ### Two probability laws of equal second moment

The pair the paper cares about is a deployed coordinate law against the Haar coordinate law of the
same dimension, and `integral_sq_sphericalCoordLaw` pins the second moment of the latter at `1/d`.
Whenever the two second moments agree, the first term of the gap drops out and the gap is carried
entirely by the cells. -/

/-- The gap between two laws of equal second moment is exactly the cell sum, with no second-moment
term.  This is `distortion_sub_distortion_eq_cells` with its first difference set to zero; it is
still an identity, and it still asserts nothing about the size of what remains. -/
theorem distortion_sub_distortion_eq_cells_of_moment_eq [IsFiniteMeasure ν] [IsFiniteMeasure ν']
    (hcb : Measurable cb) (hS : Set.range cb ⊆ ↑S)
    (h2 : Integrable (fun t : ℝ => t ^ 2) ν) (h2' : Integrable (fun t : ℝ => t ^ 2) ν')
    (hmom : ∫ t, t ^ 2 ∂ν = ∫ t, t ^ 2 ∂ν') :
    distortion cb ν - distortion cb ν'
      = -(2 * ∑ c ∈ S, c * ((∫ t in cell cb c, t ∂ν) - ∫ t in cell cb c, t ∂ν'))
        + ∑ c ∈ S, c ^ 2 * (ν.real (cell cb c) - ν'.real (cell cb c)) := by
  rw [distortion_sub_distortion_eq_cells hcb hS h2 h2', hmom]
  ring

/-! ### A two-level quantiser, to check the hypotheses are met by something

`signCb` is the one-bit quantiser with codewords `±1`.  It is measurable and its range is contained
in `signCodewords`, so `distortion_eq_cells` applies to it against any finite `ν` of finite second
moment.  This is a check on the shape of the hypotheses, not a result about the paper's
quantisers. -/

/-- The codeword list of the one-bit sign quantiser. -/
noncomputable def signCodewords : Finset ℝ := {-1, 1}

/-- The one-bit sign quantiser. -/
noncomputable def signCb (t : ℝ) : ℝ := if t < 0 then -1 else 1

/-- The one-bit sign quantiser is measurable, being a two-branch `if` on a measurable set. -/
theorem measurable_signCb : Measurable signCb :=
  Measurable.ite (measurableSet_lt measurable_id measurable_const)
    measurable_const measurable_const

/-- Every value of the one-bit sign quantiser is a codeword of `signCodewords`. -/
theorem range_signCb_subset : Set.range signCb ⊆ ↑signCodewords := by
  rintro x ⟨t, rfl⟩
  by_cases h : t < 0 <;> simp [signCb, signCodewords, h]

/-- The hypotheses of `distortion_eq_cells` are dischargeable: here they are, discharged, for the
one-bit sign quantiser against an arbitrary finite law of finite second moment. -/
theorem distortion_signCb_eq_cells [IsFiniteMeasure ν]
    (h2 : Integrable (fun t : ℝ => t ^ 2) ν) :
    distortion signCb ν
      = (∫ t, t ^ 2 ∂ν)
        - 2 * ∑ c ∈ signCodewords, c * ∫ t in cell signCb c, t ∂ν
        + ∑ c ∈ signCodewords, c ^ 2 * ν.real (cell signCb c) :=
  distortion_eq_cells measurable_signCb range_signCb_subset h2

end ScalarGap

/-! ## §50  Summation by parts over the cells of a scalar codebook

The sharp distortion-gap identity turns a sum over the cells of a scalar codebook into a sum over
its thresholds.  That last step is pure algebra: no measure, no quantiser and no monotonicity
enter it.  It is isolated here so that it can be checked on its own, and so that the stage that
consumes it does not have to reindex anything.

The indexing convention, fixed once and used by everything below.  A codebook with `K + 1`
codewords has `K + 1` cells, indexed by `Fin (K + 1)`, and `K + 2` cell boundaries, indexed by
`Fin (K + 2)`: the two outer boundaries and the `K` interior thresholds.  Cell `j` runs from
boundary `j.castSucc` to boundary `j.succ`, the outer boundaries are `0` and `Fin.last (K + 1)`,
and the `k`-th threshold, for `k : Fin K`, is boundary `k.succ.castSucc`.

* `sum_fin_by_parts` is Abel summation in the `Fin` indexing just described, in the
  shifted-difference form a cell sum produces.
* `sum_cell_gap_eq_boundary_sub_threshold` is the one place where the midpoint property of the
  thresholds is used, and it is used purely as the algebraic identity
  `c k.castSucc + c k.succ = 2 * x k.succ.castSucc`: that identity makes the codeword-squared and
  the first-moment contributions cancel at every interior threshold, leaving the once-integrated
  term alone.  Nothing is assumed about the boundaries, about monotonicity, or about where the
  three boundary-indexed functions come from.
* `sum_fin_telescope` and `abs_sum_fin_weighted_le` are the elementary facts about codeword
  increments that the bound stage needs.

None of these statements mentions a measure, a codebook structure or a quantiser, and none of them
is specific to the real line beyond using `ℝ` as the scalar field. -/

namespace Threshold

/-- **Abel summation in the cell indexing.**  `f` is the cell weight on `Fin (K + 1)`, `D` the
boundary function on `Fin (K + 2)`, and cell `j` contributes `D j.succ - D j.castSucc`.  The
result is the two outer boundary terms minus a sum over the `K` interior thresholds, the `k`-th
of which is boundary `k.succ.castSucc`.  No hypothesis whatever on `f` or `D`. -/
theorem sum_fin_by_parts {K : ℕ} (f : Fin (K + 1) → ℝ) (D : Fin (K + 2) → ℝ) :
    ∑ j : Fin (K + 1), f j * (D j.succ - D j.castSucc)
      = f (Fin.last K) * D (Fin.last (K + 1)) - f 0 * D 0
        - ∑ k : Fin K, (f k.succ - f k.castSucc) * D k.succ.castSucc := by
  induction K with
  | zero =>
      rw [Fin.sum_univ_one, Finset.univ_eq_empty, Finset.sum_empty]
      norm_num [Fin.last, Fin.succ, Fin.castSucc, Fin.castAdd, Fin.castLE]
      ring
  | succ K ih =>
      rw [Fin.sum_univ_castSucc (f := fun j : Fin (K + 2) => f j * (D j.succ - D j.castSucc)),
        Fin.sum_univ_castSucc
          (f := fun k : Fin (K + 1) => (f k.succ - f k.castSucc) * D k.succ.castSucc)]
      have hih := ih (fun j : Fin (K + 1) => f j.castSucc) (fun i : Fin (K + 2) => D i.castSucc)
      simp only [Fin.succ_castSucc, Fin.succ_last, Fin.castSucc_zero] at hih ⊢
      rw [hih]
      ring

/-- **The cell-to-threshold identity, with the midpoint cancellation.**  Take cell weights `c` on
`Fin (K + 1)`, and three functions on the `K + 2` boundaries: the boundary points `x`, a jump
function `F`, and an accumulated function `G`.  The summand is exactly what a distortion gap
produces on cell `j`: the codeword square against the mass increment `F j.succ - F j.castSucc`,
minus twice the codeword against the first-moment increment, itself written as a boundary term
`x * F` minus the increment of `G`.

If every interior boundary is the midpoint of the two codewords flanking it, then all the `F`
contributions at interior thresholds cancel and only `G` survives there.  This is the entire
content of "the thresholds are midpoints"; it is used nowhere else.  Monotonicity of `c` and any
relation between the `x` are irrelevant here and are not assumed. -/
theorem sum_cell_gap_eq_boundary_sub_threshold {K : ℕ} (c : Fin (K + 1) → ℝ)
    (x F G : Fin (K + 2) → ℝ)
    (hmid : ∀ k : Fin K, c k.castSucc + c k.succ = 2 * x k.succ.castSucc) :
    ∑ j : Fin (K + 1),
        (c j ^ 2 * (F j.succ - F j.castSucc)
          - 2 * c j * (x j.succ * F j.succ - x j.castSucc * F j.castSucc
            - (G j.succ - G j.castSucc)))
      = c (Fin.last K) ^ 2 * F (Fin.last (K + 1)) - c 0 ^ 2 * F 0
        - 2 * (c (Fin.last K) * (x (Fin.last (K + 1)) * F (Fin.last (K + 1))) - c 0 * (x 0 * F 0))
        + 2 * (c (Fin.last K) * G (Fin.last (K + 1)) - c 0 * G 0)
        - 2 * ∑ k : Fin K, (c k.succ - c k.castSucc) * G k.succ.castSucc := by
  have h1 := sum_fin_by_parts (fun j : Fin (K + 1) => c j ^ 2) F
  have h2 := sum_fin_by_parts c (fun i : Fin (K + 2) => x i * F i)
  have h3 := sum_fin_by_parts c G
  have hsplit : ∑ j : Fin (K + 1),
      (c j ^ 2 * (F j.succ - F j.castSucc)
        - 2 * c j * (x j.succ * F j.succ - x j.castSucc * F j.castSucc
          - (G j.succ - G j.castSucc)))
      = (∑ j : Fin (K + 1), c j ^ 2 * (F j.succ - F j.castSucc))
        - 2 * (∑ j : Fin (K + 1), c j * (x j.succ * F j.succ - x j.castSucc * F j.castSucc))
        + 2 * ∑ j : Fin (K + 1), c j * (G j.succ - G j.castSucc) := by
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun j _ => by ring
  have hcancel : (∑ k : Fin K, (c k.succ ^ 2 - c k.castSucc ^ 2) * F k.succ.castSucc)
      = 2 * ∑ k : Fin K,
          (c k.succ - c k.castSucc) * (x k.succ.castSucc * F k.succ.castSucc) := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    linear_combination (F k.succ.castSucc * (c k.succ - c k.castSucc)) * hmid k
  linear_combination hsplit + h1 - 2 * h2 + 2 * h3 - hcancel

/-- **The codeword increments telescope.**  A special case of `sum_fin_by_parts` at the constant
boundary function; the spread of the codebook is the sum of its increments. -/
theorem sum_fin_telescope {K : ℕ} (c : Fin (K + 1) → ℝ) :
    ∑ k : Fin K, (c k.succ - c k.castSucc) = c (Fin.last K) - c 0 := by
  have h := sum_fin_by_parts c (fun _ : Fin (K + 2) => (1 : ℝ))
  simp only [sub_self, mul_zero, Finset.sum_const_zero, mul_one] at h
  linarith

/-- Every increment of a monotone codeword sequence is nonnegative. -/
theorem sub_castSucc_nonneg {K : ℕ} {c : Fin (K + 1) → ℝ} (hc : Monotone c) (k : Fin K) :
    0 ≤ c k.succ - c k.castSucc := by
  have hle : k.castSucc ≤ k.succ := by
    rw [Fin.le_def, Fin.val_castSucc, Fin.val_succ]
    omega
  exact sub_nonneg.mpr (hc hle)

/-- **The bound the threshold form is for.**  A sum over thresholds weighted by the codeword
increments of a monotone sequence is bounded by the spread times any uniform bound on the
threshold values.  No sign or size hypothesis on `M` beyond `|G k| ≤ M` pointwise; at `K = 0` both
sides are zero. -/
theorem abs_sum_fin_weighted_le {K : ℕ} {c : Fin (K + 1) → ℝ} (hc : Monotone c)
    (G : Fin K → ℝ) {M : ℝ} (hG : ∀ k, |G k| ≤ M) :
    |∑ k : Fin K, (c k.succ - c k.castSucc) * G k| ≤ (c (Fin.last K) - c 0) * M := by
  calc |∑ k : Fin K, (c k.succ - c k.castSucc) * G k|
      ≤ ∑ k : Fin K, |(c k.succ - c k.castSucc) * G k| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ k : Fin K, (c k.succ - c k.castSucc) * M := by
        refine Finset.sum_le_sum fun k _ => ?_
        rw [abs_mul, abs_of_nonneg (sub_castSucc_nonneg hc k)]
        exact mul_le_mul_of_nonneg_left (hG k) (sub_castSucc_nonneg hc k)
    _ = (c (Fin.last K) - c 0) * M := by rw [← Finset.sum_mul, sum_fin_telescope]

end Threshold

/-! ## §52  Ordered scalar codebooks: compact support, bounded cells, integrability

The threshold form of the distortion gap is an identity between two *numbers*, so before any of
it can be stated every integral in it has to be a real number rather than `integral`'s junk
value.  That is what this section supplies, and nothing more: it proves no gap identity and no
bound on a gap.

The objects are fixed here once for the sections that follow.  A `Codebook K` is a strictly
increasing list of `K + 1` scalar codewords; `thr` is the midpoint of two consecutive codewords,
`cellIdx t` counts the thresholds lying strictly below `t`, and `stepQuant` rounds `t` to the
codeword of its cell.  `cellIdx` breaks a tie at a threshold downwards, assigning `t = thr k` the
lower codeword `c k`, but `sq_sub_eq_of_isNearest` makes that choice invisible: any two
nearest-codeword maps for the same codebook have the same squared error at *every* point, since
both errors are the distance to the codebook.  So every statement below proved for `stepQuant`
transports verbatim to an arbitrary nearest map, and no theorem here or later needs a tie
convention as a hypothesis.

The support hypothesis is the single measure-theoretic input: `μ (Icc a b)ᶜ = 0`.  Under it
`setIntegral_eq_of_supported` trims any integral to the interval, and `t`, `t²` and `(t − q t)²`
are all integrable, the last because a step quantiser takes finitely many values and is therefore
bounded, by `stepBound`, the larger of the two extreme codewords in absolute value.  `stepBound`
is not the spread `c_K − c_0`, and is not claimed to be sharp; it is the honest crude bound that
the integrability arguments actually use.

Both laws the paper compares satisfy the hypothesis: the deployed coordinate law lives in
`[−‖v‖, ‖v‖]` because a coordinate of a rotated vector is bounded by its norm, and the spherical
coordinate law lives in `[−1, 1]` because it is defined by a density against Lebesgue measure
restricted to that interval.  Neither statement needs `2 ≤ d`.

`cdfGapInt μ ν a x`, the once-integrated CDF difference over `(a, x]`, is defined here because it
is the object the threshold identity is phrased in.  Its integrand is bounded by one and
monotone in each summand, hence integrable on every bounded interval, so `cdfGapInt` is a real
number; and a sup-norm bound `η` on `cdf μ − cdf ν` bounds it by `η · (x − a)`.  That last
inequality is the only estimate in this section, and it is an estimate on `cdfGapInt` alone, not
on any distortion gap. -/

namespace Threshold

open Hadamard Orthogonal

/-! ### Ordered scalar codebooks -/

/-- An ordered scalar codebook: `K + 1` codewords listed in strictly increasing order. -/
structure Codebook (K : ℕ) where
  /-- The codewords. -/
  c : Fin (K + 1) → ℝ
  /-- They are listed in strictly increasing order, so in particular they are distinct. -/
  mono : StrictMono c

variable {K : ℕ}

/-- The `k`-th threshold: the **midpoint** of the two codewords it separates.  That it is the
midpoint, and not some other point of the cell boundary, is what makes the piecewise-linear part
of `(t − q t)²` continuous, and is used in `isNearest_stepQuant`. -/
noncomputable def thr (cbk : Codebook K) (k : Fin K) : ℝ :=
  (cbk.c k.castSucc + cbk.c k.succ) / 2

/-- The thresholds inherit the strict order of the codewords. -/
theorem thr_strictMono (cbk : Codebook K) : StrictMono (thr cbk) := by
  intro k l hkl
  have hk : cbk.c k.castSucc < cbk.c k.succ := cbk.mono Fin.castSucc_lt_succ
  have hl : cbk.c l.castSucc < cbk.c l.succ := cbk.mono Fin.castSucc_lt_succ
  have hmid : cbk.c k.succ ≤ cbk.c l.castSucc := by
    refine cbk.mono.monotone ?_
    rw [Fin.le_def, Fin.val_succ, Fin.val_castSucc]
    have h := Fin.lt_def.mp hkl
    omega
  unfold thr
  linarith

/-- The thresholds lying strictly below `t`. -/
noncomputable def belowThr (cbk : Codebook K) (t : ℝ) : Finset (Fin K) :=
  Finset.univ.filter fun k => thr cbk k < t

theorem mem_belowThr (cbk : Codebook K) (t : ℝ) (k : Fin K) :
    k ∈ belowThr cbk t ↔ thr cbk k < t := by
  simp [belowThr]

theorem card_belowThr_le (cbk : Codebook K) (t : ℝ) : (belowThr cbk t).card ≤ K := by
  have h := Finset.card_filter_le (Finset.univ : Finset (Fin K)) fun k : Fin K => thr cbk k < t
  simpa [belowThr, Finset.card_univ] using h

/-- The index of the cell containing `t`: the number of thresholds lying strictly below `t`.
There are `K` thresholds, so this is an index into the `K + 1` codewords. -/
noncomputable def cellIdx (cbk : Codebook K) (t : ℝ) : Fin (K + 1) :=
  ⟨(belowThr cbk t).card, Nat.lt_succ_of_le (card_belowThr_le cbk t)⟩

theorem cellIdx_val (cbk : Codebook K) (t : ℝ) :
    (cellIdx cbk t : ℕ) = (belowThr cbk t).card := rfl

/-- **The thresholds below `t` form an initial segment.**  Because the thresholds increase, the
`k`-th one lies below `t` exactly when `k` lies below the cell index.  This is the only place the
strict order of the codebook is converted into a statement about `cellIdx`. -/
theorem thr_lt_iff_lt_cellIdx (cbk : Codebook K) (t : ℝ) (k : Fin K) :
    thr cbk k < t ↔ (k : ℕ) < (cellIdx cbk t : ℕ) := by
  rw [cellIdx_val]
  constructor
  · intro hk
    have hsub : Finset.Iic k ⊆ belowThr cbk t := by
      intro j hj
      rw [mem_belowThr]
      exact lt_of_le_of_lt ((thr_strictMono cbk).monotone (Finset.mem_Iic.mp hj)) hk
    have hcard := Finset.card_le_card hsub
    rw [Fin.card_Iic] at hcard
    omega
  · intro hk
    by_contra hkt
    have hsub : belowThr cbk t ⊆ Finset.Iio k := by
      intro j hj
      rw [Finset.mem_Iio]
      by_contra hjk
      exact hkt (lt_of_le_of_lt ((thr_strictMono cbk).monotone (not_lt.mp hjk))
        ((mem_belowThr cbk t j).mp hj))
    have hcard := Finset.card_le_card hsub
    rw [Fin.card_Iio] at hcard
    omega

/-- The step quantiser attached to an ordered codebook: round `t` to the codeword of its cell. -/
noncomputable def stepQuant (cbk : Codebook K) (t : ℝ) : ℝ := cbk.c (cellIdx cbk t)

/-- The spread of the codebook: the distance from the smallest codeword to the largest. -/
noncomputable def spread (cbk : Codebook K) : ℝ := cbk.c (Fin.last K) - cbk.c 0

theorem spread_nonneg (cbk : Codebook K) : 0 ≤ spread cbk :=
  sub_nonneg.mpr (cbk.mono.monotone (Fin.zero_le _))

/-- The cell index is monotone: raising `t` can only add thresholds below it. -/
theorem monotone_cellIdx (cbk : Codebook K) : Monotone (cellIdx cbk) := by
  intro s t hst
  have hsub : belowThr cbk s ⊆ belowThr cbk t := by
    intro k hk
    rw [mem_belowThr] at hk ⊢
    exact lt_of_lt_of_le hk hst
  rw [Fin.le_def, cellIdx_val, cellIdx_val]
  exact Finset.card_le_card hsub

/-- Hence the step quantiser is monotone, and in particular measurable. -/
theorem monotone_stepQuant (cbk : Codebook K) : Monotone (stepQuant cbk) :=
  fun _ _ hst => cbk.mono.monotone (monotone_cellIdx cbk hst)

theorem measurable_stepQuant (cbk : Codebook K) : Measurable (stepQuant cbk) :=
  (monotone_stepQuant cbk).measurable

/-- A crude bound on the values of a step quantiser: the larger of the two extreme codewords in
absolute value.  This is **not** the spread `c_K − c_0`, and it is not claimed to be sharp; it is
what the integrability arguments below use. -/
noncomputable def stepBound (cbk : Codebook K) : ℝ := max |cbk.c 0| |cbk.c (Fin.last K)|

/-- Every value of a step quantiser is bounded by `stepBound`. -/
theorem abs_stepQuant_le (cbk : Codebook K) (t : ℝ) : |stepQuant cbk t| ≤ stepBound cbk := by
  have h0 : cbk.c 0 ≤ stepQuant cbk t := cbk.mono.monotone (Fin.zero_le _)
  have h1 : stepQuant cbk t ≤ cbk.c (Fin.last K) := cbk.mono.monotone (Fin.le_last _)
  have hl : -|cbk.c 0| ≤ cbk.c 0 := neg_abs_le _
  have hr : cbk.c (Fin.last K) ≤ |cbk.c (Fin.last K)| := le_abs_self _
  have hml : |cbk.c 0| ≤ stepBound cbk := le_max_left _ _
  have hmr : |cbk.c (Fin.last K)| ≤ stepBound cbk := le_max_right _ _
  rw [abs_le]
  exact ⟨by linarith, by linarith⟩

/-! ### The step quantiser rounds to a nearest codeword -/

/-- **`stepQuant` is a nearest-codeword map.**  The midpoint placement of the thresholds is
exactly what makes this true: on the cell of `c i` the point `t` satisfies
`c_{i−1} + c_i < 2t ≤ c_i + c_{i+1}` at whichever of the two ends exists, and the comparison
`(t − c_i)² ≤ (t − c_j)²` then factors as `(c_j − c_i)(2t − c_i − c_j) ≤ 0`.  At `t = thr k` both
codewords are nearest and `cellIdx` returns the lower one, `c k`; `sq_sub_eq_of_isNearest` makes
that choice immaterial. -/
theorem isNearest_stepQuant (cbk : Codebook K) :
    IsNearest (Set.range cbk.c) (stepQuant cbk) := by
  intro t
  refine ⟨⟨cellIdx cbk t, rfl⟩, ?_⟩
  rintro _ ⟨j, rfl⟩
  have hsq : (t - cbk.c (cellIdx cbk t)) ^ 2 ≤ (t - cbk.c j) ^ 2 := by
    rcases lt_trichotomy j (cellIdx cbk t) with hji | hji | hji
    · -- `j` is below the cell: the threshold just below `t` separates them
      have hpos : 0 < (cellIdx cbk t : ℕ) := lt_of_le_of_lt (Nat.zero_le _) (Fin.lt_def.mp hji)
      have hK : (cellIdx cbk t : ℕ) - 1 < K := by
        have := (cellIdx cbk t).isLt
        omega
      set m : Fin K := ⟨(cellIdx cbk t : ℕ) - 1, hK⟩ with hm
      have hmlt : (m : ℕ) < (cellIdx cbk t : ℕ) := by simp only [hm]; omega
      have hthr : thr cbk m < t := (thr_lt_iff_lt_cellIdx cbk t m).mpr hmlt
      have hsucc : cbk.c m.succ = cbk.c (cellIdx cbk t) := by
        refine congrArg cbk.c (Fin.val_injective ?_)
        simp only [hm, Fin.val_succ]
        omega
      have hj : cbk.c j ≤ cbk.c m.castSucc := by
        refine cbk.mono.monotone ?_
        rw [Fin.le_def, Fin.val_castSucc]
        simp only [hm]
        have := Fin.lt_def.mp hji
        omega
      have hlt : cbk.c j < cbk.c (cellIdx cbk t) := cbk.mono hji
      have hsum : cbk.c j + cbk.c (cellIdx cbk t) < 2 * t := by
        rw [← hsucc]
        unfold thr at hthr
        linarith
      nlinarith [hlt, hsum]
    · rw [hji]
    · -- `j` is above the cell: the threshold just above `t` separates them
      have hK : (cellIdx cbk t : ℕ) < K := by
        have := j.isLt
        have := Fin.lt_def.mp hji
        omega
      set m : Fin K := ⟨(cellIdx cbk t : ℕ), hK⟩ with hm
      have hmge : ¬ ((m : ℕ) < (cellIdx cbk t : ℕ)) := by simp [hm]
      have hthr : t ≤ thr cbk m := not_lt.mp fun h =>
        hmge ((thr_lt_iff_lt_cellIdx cbk t m).mp h)
      have hcast : cbk.c m.castSucc = cbk.c (cellIdx cbk t) := by
        refine congrArg cbk.c (Fin.val_injective ?_)
        simp [hm]
      have hj : cbk.c m.succ ≤ cbk.c j := by
        refine cbk.mono.monotone ?_
        rw [Fin.le_def, Fin.val_succ]
        simp only [hm]
        have := Fin.lt_def.mp hji
        omega
      have hlt : cbk.c (cellIdx cbk t) < cbk.c j := cbk.mono hji
      have hsum : 2 * t ≤ cbk.c (cellIdx cbk t) + cbk.c j := by
        rw [← hcast]
        unfold thr at hthr
        linarith
      nlinarith [hlt, hsum]
  show ‖t - stepQuant cbk t‖ ≤ ‖t - cbk.c j‖
  rw [Real.norm_eq_abs, Real.norm_eq_abs, ← Real.sqrt_sq_eq_abs, ← Real.sqrt_sq_eq_abs]
  exact Real.sqrt_le_sqrt hsq

/-- **Ties do not matter.**  Two nearest-codeword maps for the same codebook have the same squared
error at *every* point, because both errors equal the distance to the codebook.  Consequently
every statement about `stepQuant` below transports to an arbitrary nearest map, and no tie
convention is ever assumed. -/
theorem sq_sub_eq_of_isNearest {C : Set ℝ} {q q' : ℝ → ℝ} (hq : IsNearest C q)
    (hq' : IsNearest C q') (t : ℝ) : (t - q t) ^ 2 = (t - q' t) ^ 2 := by
  have h := (norm_sub_eq_infDist hq t).trans (norm_sub_eq_infDist hq' t).symm
  rw [Real.norm_eq_abs, Real.norm_eq_abs] at h
  rw [← sq_abs (t - q t), ← sq_abs (t - q' t), h]

/-- The distortion of a codebook against a law does not depend on which nearest map realises it.
No integrability hypothesis is needed: the two integrands are equal pointwise. -/
theorem distortion_congr_of_isNearest {C : Set ℝ} {q q' : ℝ → ℝ} (hq : IsNearest C q)
    (hq' : IsNearest C q') (μ : Measure ℝ) : distortion q μ = distortion q' μ :=
  integral_congr_ae (Filter.Eventually.of_forall fun t => sq_sub_eq_of_isNearest hq hq' t)

/-! ### Compact support, and trimming an integral to it -/

/-- A law giving the complement of `Icc a b` no mass is concentrated on `Icc a b`. -/
theorem ae_mem_Icc_of_supported {μ : Measure ℝ} {a b : ℝ} (hsupp : μ (Set.Icc a b)ᶜ = 0) :
    ∀ᵐ t ∂μ, t ∈ Set.Icc a b := ae_iff.mpr hsupp

/-- **Trimming an integral to the support.**  When `μ` gives the complement of `Icc a b` no mass,
an integral over any set is the integral over its intersection with `Icc a b`.  Neither
measurability of the set nor integrability of `f` is needed: the two restricted measures agree,
so the two integrals are the same term. -/
theorem setIntegral_eq_of_supported {μ : Measure ℝ} {a b : ℝ} (hsupp : μ (Set.Icc a b)ᶜ = 0)
    (f : ℝ → ℝ) (s : Set ℝ) :
    ∫ t in s, f t ∂μ = ∫ t in s ∩ Set.Icc a b, f t ∂μ := by
  have key : μ.restrict s = μ.restrict (s ∩ Set.Icc a b) := by
    refine Measure.restrict_congr_set ?_
    rw [Filter.eventuallyEq_set]
    filter_upwards [ae_mem_Icc_of_supported hsupp] with x hx
    simp [hx]
  rw [key]

/-- The whole-line integral of a compactly supported law is an integral over the interval. -/
theorem integral_eq_setIntegral_Icc_of_supported {μ : Measure ℝ} {a b : ℝ}
    (hsupp : μ (Set.Icc a b)ᶜ = 0) (f : ℝ → ℝ) :
    ∫ t, f t ∂μ = ∫ t in Set.Icc a b, f t ∂μ := by
  rw [← setIntegral_univ, setIntegral_eq_of_supported hsupp f Set.univ, Set.univ_inter]

/-! ### Integrability against a compactly supported law -/

/-- The crude bound on `|t|` for `t` in `Icc a b`. -/
noncomputable def intervalBound (a b : ℝ) : ℝ := max |a| |b|

theorem abs_le_intervalBound {a b t : ℝ} (ht : t ∈ Set.Icc a b) : |t| ≤ intervalBound a b := by
  have h1 : -|a| ≤ a := neg_abs_le a
  have h2 : b ≤ |b| := le_abs_self b
  have h3 : |a| ≤ intervalBound a b := le_max_left _ _
  have h4 : |b| ≤ intervalBound a b := le_max_right _ _
  rw [abs_le]
  exact ⟨by linarith [ht.1], by linarith [ht.2]⟩

/-- `t` is integrable against a finite law supported in a bounded interval. -/
theorem integrable_id_of_supported (μ : Measure ℝ) [IsFiniteMeasure μ] {a b : ℝ}
    (hsupp : μ (Set.Icc a b)ᶜ = 0) : Integrable (fun t : ℝ => t) μ := by
  refine (integrable_const (intervalBound a b)).mono' measurable_id.aestronglyMeasurable ?_
  filter_upwards [ae_mem_Icc_of_supported hsupp] with x hx
  rw [Real.norm_eq_abs]
  exact abs_le_intervalBound hx

/-- `t²` is integrable against a finite law supported in a bounded interval. -/
theorem integrable_sq_of_supported (μ : Measure ℝ) [IsFiniteMeasure μ] {a b : ℝ}
    (hsupp : μ (Set.Icc a b)ᶜ = 0) : Integrable (fun t : ℝ => t ^ 2) μ := by
  refine (integrable_const (intervalBound a b ^ 2)).mono'
    (measurable_id.pow_const 2).aestronglyMeasurable ?_
  filter_upwards [ae_mem_Icc_of_supported hsupp] with x hx
  rw [Real.norm_eq_abs, abs_pow]
  exact pow_le_pow_left₀ (abs_nonneg _) (abs_le_intervalBound hx) 2

/-- `(t − stepQuant t)²` is integrable against a finite law supported in a bounded interval: the
quantiser is bounded by `stepBound`, so the integrand is bounded outright. -/
theorem integrable_sub_stepQuant_sq_of_supported (cbk : Codebook K) (μ : Measure ℝ)
    [IsFiniteMeasure μ] {a b : ℝ} (hsupp : μ (Set.Icc a b)ᶜ = 0) :
    Integrable (fun t : ℝ => (t - stepQuant cbk t) ^ 2) μ := by
  refine (integrable_const ((intervalBound a b + stepBound cbk) ^ 2)).mono'
    (((measurable_id.sub (measurable_stepQuant cbk)).pow_const 2).aestronglyMeasurable) ?_
  filter_upwards [ae_mem_Icc_of_supported hsupp] with x hx
  have hA := abs_le.mp (abs_le_intervalBound hx)
  have hB := abs_le.mp (abs_stepQuant_le cbk x)
  have h1 : |x - stepQuant cbk x| ≤ intervalBound a b + stepBound cbk := by
    rw [abs_le]
    exact ⟨by linarith [hA.1, hB.2], by linarith [hA.2, hB.1]⟩
  rw [Real.norm_eq_abs, abs_pow]
  exact pow_le_pow_left₀ (abs_nonneg _) h1 2

/-- The same for an **arbitrary** nearest-codeword map, by `sq_sub_eq_of_isNearest`.  This is the
form the gap identity needs, since its quantiser is any nearest map and not a chosen one. -/
theorem integrable_sub_isNearest_sq_of_supported {cbk : Codebook K} {q : ℝ → ℝ}
    (hq : IsNearest (Set.range cbk.c) q) (μ : Measure ℝ) [IsFiniteMeasure μ] {a b : ℝ}
    (hsupp : μ (Set.Icc a b)ᶜ = 0) : Integrable (fun t : ℝ => (t - q t) ^ 2) μ :=
  (integrable_sub_stepQuant_sq_of_supported cbk μ hsupp).congr
    (Filter.Eventually.of_forall fun t => sq_sub_eq_of_isNearest (isNearest_stepQuant cbk) hq t)

/-! ### Interval masses, and the once-integrated CDF difference -/

/-- **A bounded interval's mass, as a difference of CDF values.**  Mathlib has no
`Set.Iic_diff_Iic`, so the set identity is done by hand. -/
theorem measureReal_Ioc_eq_cdf_sub (μ : Measure ℝ) [IsProbabilityMeasure μ] (u b : ℝ)
    (hub : u ≤ b) : μ.real (Set.Ioc u b) = cdf μ b - cdf μ u := by
  have hdiff : Set.Ioc u b = Set.Iic b \ Set.Iic u := by
    ext t
    simp only [Set.mem_Ioc, Set.mem_sdiff, Set.mem_Iic, not_le]
    exact ⟨fun h => ⟨h.2, h.1⟩, fun h => ⟨h.2, h.1⟩⟩
  rw [cdf_eq_real, cdf_eq_real, hdiff,
    measureReal_sdiff (Set.Iic_subset_Iic.mpr hub) measurableSet_Iic]

/-- The identity is integrable on a bounded interval against any finite measure. -/
theorem integrableOn_id_Ioc (μ : Measure ℝ) [IsFiniteMeasure μ] (a b : ℝ) :
    IntegrableOn (fun t : ℝ => t) (Set.Ioc a b) μ := by
  refine (integrable_const (intervalBound a b)).mono' measurable_id.aestronglyMeasurable ?_
  filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
  rw [Real.norm_eq_abs]
  exact abs_le_intervalBound ⟨ht.1.le, ht.2⟩

/-- A CDF is integrable on a bounded interval: it is monotone, hence measurable, and it is bounded
between zero and one. -/
theorem integrableOn_cdf_Ioc (μ : Measure ℝ) (a b : ℝ) :
    IntegrableOn (fun u : ℝ => (cdf μ) u) (Set.Ioc a b) volume := by
  haveI : IsFiniteMeasure ((volume : Measure ℝ).restrict (Set.Ioc a b)) := by
    constructor
    rw [Measure.restrict_apply_univ, Real.volume_Ioc]
    exact ENNReal.ofReal_lt_top
  refine (integrable_const (1 : ℝ)).mono' ((monotone_cdf μ).measurable).aestronglyMeasurable ?_
  filter_upwards with u
  rw [Real.norm_eq_abs, abs_of_nonneg (cdf_nonneg μ u)]
  exact cdf_le_one μ u

/-- **The once-integrated CDF difference** over `(a, x]`: the object the threshold form of the
distortion gap is phrased in. -/
noncomputable def cdfGapInt (μ ν : Measure ℝ) (a x : ℝ) : ℝ :=
  ∫ u in Set.Ioc a x, ((cdf μ) u - (cdf ν) u)

/-- The integrand of `cdfGapInt` is integrable on every bounded interval, so `cdfGapInt` is a real
number and not `integral`'s junk value. -/
theorem integrableOn_cdfGap_Ioc (μ ν : Measure ℝ) (a x : ℝ) :
    IntegrableOn (fun u : ℝ => (cdf μ) u - (cdf ν) u) (Set.Ioc a x) volume :=
  (integrableOn_cdf_Ioc μ a x).sub (integrableOn_cdf_Ioc ν a x)

/-- `cdfGapInt` splits as the difference of the two once-integrated CDFs. -/
theorem cdfGapInt_eq_sub (μ ν : Measure ℝ) (a x : ℝ) :
    cdfGapInt μ ν a x = (∫ u in Set.Ioc a x, (cdf μ) u) - ∫ u in Set.Ioc a x, (cdf ν) u :=
  integral_sub (integrableOn_cdf_Ioc μ a x) (integrableOn_cdf_Ioc ν a x)

/-- `cdfGapInt` of a law against itself is zero. -/
theorem cdfGapInt_self (μ : Measure ℝ) (a x : ℝ) : cdfGapInt μ μ a x = 0 := by
  rw [cdfGapInt_eq_sub, sub_self]

/-- **A sup-norm bound on the CDF difference bounds the once-integrated difference.**  If
`|cdf μ − cdf ν| ≤ η` everywhere, then `|cdfGapInt μ ν a x| ≤ η · (x − a)` for `a ≤ x`.  This is
the only estimate in this section, and it concerns `cdfGapInt` alone: no distortion gap is bounded
here. -/
theorem abs_cdfGapInt_le (μ ν : Measure ℝ) {a x η : ℝ} (hax : a ≤ x)
    (hks : ∀ u, |(cdf μ) u - (cdf ν) u| ≤ η) : |cdfGapInt μ ν a x| ≤ η * (x - a) := by
  have hvol : (volume : Measure ℝ) (Set.Ioc a x) < ⊤ := by
    rw [Real.volume_Ioc]
    exact ENNReal.ofReal_lt_top
  have h := norm_setIntegral_le_of_norm_le_const (μ := (volume : Measure ℝ))
    (s := Set.Ioc a x) (f := fun u : ℝ => (cdf μ) u - (cdf ν) u) (C := η) hvol
    (fun u _ => by rw [Real.norm_eq_abs]; exact hks u)
  rw [Real.norm_eq_abs, Real.volume_real_Ioc, max_eq_left (by linarith)] at h
  exact h

/-! ### The two laws the paper compares are compactly supported -/

/-- A coordinate of a Euclidean vector is bounded by its norm. -/
theorem abs_coord_le_norm {d : ℕ} (x : Ed d) (i : Fin d) : |x i| ≤ ‖x‖ := by
  have h2 : |x i| ^ 2 ≤ ‖x‖ ^ 2 := by
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (by positivity)]
    exact Finset.single_le_sum (f := fun j => ‖x j‖ ^ 2) (fun j _ => by positivity)
      (Finset.mem_univ i)
  nlinarith [abs_nonneg (x i), norm_nonneg x]

/-- **The deployed coordinate law is supported in `[−‖v‖, ‖v‖]`.**  A rotation preserves the norm
and a coordinate is bounded by the norm, so every value of the pushed-forward coordinate lies in
that interval.  No hypothesis on `d` is used. -/
theorem coordLaw_compl_Icc_eq_zero {d : ℕ} (H : Od d) (v : Ed d) (i : Fin d) :
    (coordLaw H v i) (Set.Icc (-‖v‖) ‖v‖)ᶜ = 0 := by
  have hmeas : Measurable fun s : Signs d => (hadRot H s • v) i := measurable_of_countable _
  have hpre : (fun s : Signs d => (hadRot H s • v) i) ⁻¹' (Set.Icc (-‖v‖) ‖v‖)ᶜ
      = (∅ : Set (Signs d)) := by
    ext s
    simp only [Set.mem_preimage, Set.mem_compl_iff, Set.mem_empty_iff_false, iff_false, not_not]
    have h1 : |(hadRot H s • v) i| ≤ ‖hadRot H s • v‖ := abs_coord_le_norm _ i
    rw [Orthogonal.norm_smul' d (hadRot H s) v] at h1
    exact Set.mem_Icc.mpr (abs_le.mp h1)
  rw [coordLaw, Measure.map_apply hmeas measurableSet_Icc.compl, hpre, measure_empty]

/-- **The spherical coordinate law is supported in `[−1, 1]`**, being a density against Lebesgue
measure restricted to that interval.  No hypothesis on `d` is used; in particular this does not
assume `2 ≤ d`, which is what makes it a probability measure. -/
theorem sphericalCoordLaw_compl_Icc_eq_zero (d : ℕ) :
    (sphericalCoordLaw d) (Set.Icc (-1 : ℝ) 1)ᶜ = 0 := by
  have hsupp : ∀ᵐ t ∂(sphericalCoordLaw d), t ∈ Set.Icc (-1 : ℝ) 1 :=
    (withDensity_absolutelyContinuous _ _).ae_le (ae_restrict_mem measurableSet_Icc)
  exact ae_iff.mp hsupp

/-! ### The hypotheses discharge for both laws

These are the instantiations the later sections use; each is one application of the general
statement above to the support proved for the law in question. -/

/-- `t` is integrable against the deployed coordinate law. -/
theorem integrable_id_coordLaw {d : ℕ} (H : Od d) (v : Ed d) (i : Fin d) :
    Integrable (fun t : ℝ => t) (coordLaw H v i) :=
  integrable_id_of_supported _ (coordLaw_compl_Icc_eq_zero H v i)

/-- `t²` is integrable against the deployed coordinate law. -/
theorem integrable_sq_coordLaw {d : ℕ} (H : Od d) (v : Ed d) (i : Fin d) :
    Integrable (fun t : ℝ => t ^ 2) (coordLaw H v i) :=
  integrable_sq_of_supported _ (coordLaw_compl_Icc_eq_zero H v i)

/-- `(t − q t)²` is integrable against the deployed coordinate law, for every nearest-codeword map
of an ordered codebook. -/
theorem integrable_sub_isNearest_sq_coordLaw {d : ℕ} (H : Od d) (v : Ed d) (i : Fin d)
    {cbk : Codebook K} {q : ℝ → ℝ} (hq : IsNearest (Set.range cbk.c) q) :
    Integrable (fun t : ℝ => (t - q t) ^ 2) (coordLaw H v i) :=
  integrable_sub_isNearest_sq_of_supported hq _ (coordLaw_compl_Icc_eq_zero H v i)

/-- `t` is integrable against the spherical coordinate law, for `2 ≤ d`, which is what makes it a
probability measure. -/
theorem integrable_id_sphericalCoordLaw {d : ℕ} (hd : 2 ≤ d) :
    Integrable (fun t : ℝ => t) (sphericalCoordLaw d) := by
  haveI := isProbabilityMeasure_sphericalCoordLaw hd
  exact integrable_id_of_supported _ (sphericalCoordLaw_compl_Icc_eq_zero d)

/-- `(t − q t)²` is integrable against the spherical coordinate law, for `2 ≤ d`. -/
theorem integrable_sub_isNearest_sq_sphericalCoordLaw {d : ℕ} (hd : 2 ≤ d)
    {cbk : Codebook K} {q : ℝ → ℝ} (hq : IsNearest (Set.range cbk.c) q) :
    Integrable (fun t : ℝ => (t - q t) ^ 2) (sphericalCoordLaw d) := by
  haveI := isProbabilityMeasure_sphericalCoordLaw hd
  exact integrable_sub_isNearest_sq_of_supported hq _ (sphericalCoordLaw_compl_Icc_eq_zero d)

end Threshold

/-! ## §53  The cells of a scalar codebook, and the distortion integral over them

The threshold form of the distortion gap is reached by splitting the distortion integral over the
`K + 1` cells of the codebook, one per codeword, and treating each cell separately.  This section
performs that split and nothing else: it proves no gap identity, compares no two laws, and
assumes nothing about matched moments.

The cell of a codeword index is the level set `cell cbk j = {t | cellIdx cbk t = j}`, so the cells
are pairwise disjoint and cover the line by construction.  `cell_eq_iInter` writes each of them as
a finite intersection of rays cut at the thresholds, which is where measurability comes from, and
`cell_castSucc_eq_Ioc`, `cell_zero_eq_Iic` and `cell_last_eq_Ioi` identify them concretely: the
interior cells are half-open to the right, and the two outer cells are unbounded.  That the outer
cells are unbounded is the reason the support hypothesis is carried everywhere below; a bounded
cell would not need it.

`integral_eq_sum_cell` is the spine, `MeasureTheory.integral_iUnion` in its countable `tsum` form
collapsed by `tsum_fintype`.  It needs the integrand to be integrable against the whole law, not
merely on each cell, which is what the support hypothesis supplies through §52.

Two consequences are recorded, in the two shapes a later stage wants.
`distortion_stepQuant_eq_sum` is the raw cell decomposition, with each cell trimmed to `Icc a b`;
`distortion_eq_sq_add_cross` is the split of the square, `(t - c)² = t² - 2ct + c²`, in which the
`t²` term is a single law-level integral that matched second moments will cancel, and everything
that depends on the codebook is carried by `cellMass` and `cellMoment`, the mass and the first
moment of a cell.  Both are then transported from `stepQuant` to an arbitrary nearest-codeword map
by §52's `distortion_congr_of_isNearest`, so no tie convention appears in any statement.

`cellMass` and `cellMoment` are defined against the untrimmed cell.  They are real numbers, not
junk values, because the law is finite and compactly supported; `cellMass_eq_inter` and
`cellMoment_eq_inter` say the trimming does not change them.  No claim is made here that any cell
carries positive mass, and nothing here expresses `cellMass` or `cellMoment` in terms of a CDF. -/

namespace Threshold

variable {K : ℕ}

/-! ### The cells of a codebook -/

/-- The cell of a codeword index: the scalars that `cellIdx` sends to `j`.  As a level set of
`cellIdx`, the cells are pairwise disjoint and cover the line by construction. -/
noncomputable def cell (cbk : Codebook K) (j : Fin (K + 1)) : Set ℝ :=
  {t : ℝ | cellIdx cbk t = j}

theorem mem_cell (cbk : Codebook K) (j : Fin (K + 1)) (t : ℝ) :
    t ∈ cell cbk j ↔ cellIdx cbk t = j := Iff.rfl

/-- `stepQuant` is constant on each cell, with the value that names the cell. -/
theorem stepQuant_eq_of_mem_cell (cbk : Codebook K) {j : Fin (K + 1)} {t : ℝ}
    (ht : t ∈ cell cbk j) : stepQuant cbk t = cbk.c j := by
  rw [stepQuant, (mem_cell cbk j t).mp ht]

/-- **Membership in a cell, threshold by threshold.**  `t` lies in cell `j` exactly when it is
strictly above every threshold of index below `j` and at or below every threshold of index at
least `j`.  This is the counting lemma `thr_lt_iff_lt_cellIdx` read twice. -/
theorem mem_cell_iff (cbk : Codebook K) (j : Fin (K + 1)) (t : ℝ) :
    t ∈ cell cbk j ↔ (∀ k : Fin K, (k : ℕ) < (j : ℕ) → thr cbk k < t)
      ∧ (∀ k : Fin K, (j : ℕ) ≤ (k : ℕ) → t ≤ thr cbk k) := by
  rw [mem_cell]
  constructor
  · rintro rfl
    refine ⟨fun k hk => (thr_lt_iff_lt_cellIdx cbk t k).mpr hk, fun k hk => ?_⟩
    by_contra hcon
    exact absurd ((thr_lt_iff_lt_cellIdx cbk t k).mp (not_le.mp hcon)) (not_lt.mpr hk)
  · rintro ⟨h1, h2⟩
    refine Fin.ext ?_
    rcases lt_trichotomy ((cellIdx cbk t : ℕ)) ((j : ℕ)) with h | h | h
    · exfalso
      have hK : (cellIdx cbk t : ℕ) < K := lt_of_lt_of_le h (Nat.lt_succ_iff.mp j.isLt)
      have hlt : thr cbk ⟨(cellIdx cbk t : ℕ), hK⟩ < t := h1 ⟨(cellIdx cbk t : ℕ), hK⟩ h
      have hcount := (thr_lt_iff_lt_cellIdx cbk t ⟨(cellIdx cbk t : ℕ), hK⟩).mp hlt
      simp only at hcount
      omega
    · exact h
    · exfalso
      have hK : (j : ℕ) < K := lt_of_lt_of_le h (Nat.lt_succ_iff.mp (cellIdx cbk t).isLt)
      have hle : t ≤ thr cbk ⟨(j : ℕ), hK⟩ := h2 ⟨(j : ℕ), hK⟩ (le_refl _)
      have hlt : thr cbk ⟨(j : ℕ), hK⟩ < t :=
        (thr_lt_iff_lt_cellIdx cbk t ⟨(j : ℕ), hK⟩).mpr h
      linarith

/-- **Each cell is a finite intersection of rays cut at the thresholds.**  This is the form
measurability is read off, and it is the only place the cells are described without reference to
`cellIdx`. -/
theorem cell_eq_iInter (cbk : Codebook K) (j : Fin (K + 1)) :
    cell cbk j = ⋂ k : Fin K,
      (if (k : ℕ) < (j : ℕ) then Set.Ioi (thr cbk k) else Set.Iic (thr cbk k)) := by
  ext t
  rw [mem_cell_iff, Set.mem_iInter]
  constructor
  · rintro ⟨h1, h2⟩ k
    by_cases hk : (k : ℕ) < (j : ℕ)
    · rw [if_pos hk]; exact h1 k hk
    · rw [if_neg hk]; exact h2 k (not_lt.mp hk)
  · intro h
    refine ⟨fun k hk => ?_, fun k hk => ?_⟩
    · have hmem := h k
      rw [if_pos hk] at hmem
      exact hmem
    · have hmem := h k
      rw [if_neg (not_lt.mpr hk)] at hmem
      exact hmem

/-- Every cell is measurable. -/
theorem measurableSet_cell (cbk : Codebook K) (j : Fin (K + 1)) :
    MeasurableSet (cell cbk j) := by
  rw [cell_eq_iInter]
  refine MeasurableSet.iInter fun k => ?_
  by_cases hk : (k : ℕ) < (j : ℕ)
  · rw [if_pos hk]; exact measurableSet_Ioi
  · rw [if_neg hk]; exact measurableSet_Iic

/-- The cells cover the line: every scalar lies in the cell of its own index. -/
theorem iUnion_cell (cbk : Codebook K) : (⋃ j : Fin (K + 1), cell cbk j) = Set.univ := by
  ext t
  simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
  exact ⟨cellIdx cbk t, rfl⟩

/-- The cells are pairwise disjoint, being distinct level sets of one function. -/
theorem pairwise_disjoint_cell (cbk : Codebook K) :
    Pairwise (Function.onFun Disjoint (cell cbk)) := by
  intro i j hij
  rw [Function.onFun, Set.disjoint_left]
  intro t hi hj
  exact hij (((mem_cell cbk i t).mp hi).symm.trans ((mem_cell cbk j t).mp hj))

/-! ### The cells, concretely -/

/-- **An interior cell is half-open to the right.**  For consecutive threshold indices `i` and
`j`, the cell of the codeword `c j.castSucc` is `(thr i, thr j]`. -/
theorem cell_castSucc_eq_Ioc (cbk : Codebook K) {i j : Fin K} (hij : (i : ℕ) + 1 = (j : ℕ)) :
    cell cbk j.castSucc = Set.Ioc (thr cbk i) (thr cbk j) := by
  ext t
  rw [mem_cell_iff, Set.mem_Ioc, Fin.val_castSucc]
  constructor
  · rintro ⟨h1, h2⟩
    exact ⟨h1 i (by omega), h2 j (by omega)⟩
  · rintro ⟨h1, h2⟩
    refine ⟨fun k hk => ?_, fun k hk => ?_⟩
    · have hle : thr cbk k ≤ thr cbk i :=
        (thr_strictMono cbk).monotone (Fin.le_def.mpr (by omega))
      linarith
    · have hle : thr cbk j ≤ thr cbk k :=
        (thr_strictMono cbk).monotone (Fin.le_def.mpr (by omega))
      linarith

/-- **The lowest cell is an unbounded left ray.**  When `i` is the first threshold index, the cell
of the smallest codeword is `(-∞, thr i]`. -/
theorem cell_zero_eq_Iic (cbk : Codebook K) {i : Fin K} (hi : (i : ℕ) = 0) :
    cell cbk 0 = Set.Iic (thr cbk i) := by
  ext t
  rw [mem_cell_iff, Set.mem_Iic]
  constructor
  · rintro ⟨_, h2⟩
    exact h2 i (by simp)
  · intro h
    refine ⟨fun k hk => by simp at hk, fun k _ => ?_⟩
    have hle : thr cbk i ≤ thr cbk k :=
      (thr_strictMono cbk).monotone (Fin.le_def.mpr (by omega))
    linarith

/-- **The highest cell is an unbounded right ray.**  When `i` is the last threshold index, the cell
of the largest codeword is `(thr i, ∞)`. -/
theorem cell_last_eq_Ioi (cbk : Codebook K) {i : Fin K} (hi : (i : ℕ) + 1 = K) :
    cell cbk (Fin.last K) = Set.Ioi (thr cbk i) := by
  ext t
  rw [mem_cell_iff, Set.mem_Ioi, Fin.val_last]
  constructor
  · rintro ⟨h1, _⟩
    exact h1 i (by omega)
  · intro h
    refine ⟨fun k _ => ?_, fun k hk => ?_⟩
    · have hle : thr cbk k ≤ thr cbk i :=
        (thr_strictMono cbk).monotone (Fin.le_def.mpr (by omega))
      linarith
    · exact absurd hk (by have := k.isLt; omega)

/-- With no thresholds at all there is a single cell, the whole line. -/
theorem cell_of_zero (cbk : Codebook 0) : cell cbk 0 = Set.univ := by
  ext t
  rw [mem_cell_iff]
  exact ⟨fun _ => trivial, fun _ => ⟨fun k => k.elim0, fun k => k.elim0⟩⟩

/-! ### Trimming a cell to the support -/

/-- **Trimming a mass to the support.**  When the law gives the complement of `Icc a b` no mass,
intersecting any set with `Icc a b` does not change its mass. -/
theorem measureReal_eq_of_supported {ρ : Measure ℝ} {a b : ℝ} (hsupp : ρ (Set.Icc a b)ᶜ = 0)
    (s : Set ℝ) : ρ.real s = ρ.real (s ∩ Set.Icc a b) := by
  have hnull : ρ (s \ Set.Icc a b) = 0 := measure_mono_null (fun _ hx => hx.2) hsupp
  have hadd := measure_inter_add_sdiff (μ := ρ) s (measurableSet_Icc (a := a) (b := b))
  rw [hnull, add_zero] at hadd
  rw [measureReal_def, measureReal_def, hadd]

/-! ### The mass and the first moment of a cell -/

/-- The mass a law puts on a cell.  A real number, not `ENNReal`; against a finite law it is
finite, and no positivity beyond nonnegativity is claimed. -/
noncomputable def cellMass (cbk : Codebook K) (ρ : Measure ℝ) (j : Fin (K + 1)) : ℝ :=
  ρ.real (cell cbk j)

/-- The first moment a law puts on a cell.  Against a finite law supported in a bounded interval
this is a real number, by §52's `integrable_id_of_supported`; with no support hypothesis it may be
`integral`'s junk value, and nothing here says otherwise. -/
noncomputable def cellMoment (cbk : Codebook K) (ρ : Measure ℝ) (j : Fin (K + 1)) : ℝ :=
  ∫ t in cell cbk j, t ∂ρ

theorem cellMass_nonneg (cbk : Codebook K) (ρ : Measure ℝ) (j : Fin (K + 1)) :
    0 ≤ cellMass cbk ρ j := measureReal_nonneg

/-- The mass of a cell is the mass of the part of it inside the support. -/
theorem cellMass_eq_inter (cbk : Codebook K) {ρ : Measure ℝ} {a b : ℝ}
    (hsupp : ρ (Set.Icc a b)ᶜ = 0) (j : Fin (K + 1)) :
    cellMass cbk ρ j = ρ.real (cell cbk j ∩ Set.Icc a b) :=
  measureReal_eq_of_supported hsupp _

/-- The first moment of a cell is the first moment of the part of it inside the support. -/
theorem cellMoment_eq_inter (cbk : Codebook K) {ρ : Measure ℝ} {a b : ℝ}
    (hsupp : ρ (Set.Icc a b)ᶜ = 0) (j : Fin (K + 1)) :
    cellMoment cbk ρ j = ∫ t in cell cbk j ∩ Set.Icc a b, t ∂ρ :=
  setIntegral_eq_of_supported hsupp _ _

/-! ### The spine: an integral is the sum of its integrals over the cells -/

/-- **The cell decomposition of an integral.**  For an integrable `f`, the integral against a law
is the finite sum of the integrals over the cells.  This is `MeasureTheory.integral_iUnion` in its
countable `tsum` form, collapsed by `tsum_fintype`; the cells being disjoint and measurable and
covering the line is all that is used.  Integrability against the whole law, not merely on each
cell, is genuinely needed and is what the support hypothesis buys elsewhere. -/
theorem integral_eq_sum_cell (cbk : Codebook K) (ρ : Measure ℝ) {f : ℝ → ℝ}
    (hf : Integrable f ρ) :
    ∫ t, f t ∂ρ = ∑ j : Fin (K + 1), ∫ t in cell cbk j, f t ∂ρ := by
  have hu : ∫ t, f t ∂ρ = ∫ t in (⋃ j : Fin (K + 1), cell cbk j), f t ∂ρ := by
    rw [iUnion_cell, setIntegral_univ]
  rw [hu, integral_iUnion (measurableSet_cell cbk) (pairwise_disjoint_cell cbk)
    (by rw [iUnion_cell]; exact hf.integrableOn), tsum_fintype]

/-! ### The distortion of the step quantiser, cell by cell -/

/-- **The cell decomposition of the distortion.**  Against a finite law supported in `Icc a b`,
the distortion of the step quantiser is the sum over cells of the squared error to that cell's
codeword, each cell trimmed to the support.  The trimming is what makes the two outer cells,
which are unbounded rays, contribute over a bounded set. -/
theorem distortion_stepQuant_eq_sum (cbk : Codebook K) (ρ : Measure ℝ) [IsFiniteMeasure ρ]
    {a b : ℝ} (hsupp : ρ (Set.Icc a b)ᶜ = 0) :
    distortion (stepQuant cbk) ρ
      = ∑ j : Fin (K + 1), ∫ t in cell cbk j ∩ Set.Icc a b, (t - cbk.c j) ^ 2 ∂ρ := by
  simp only [distortion]
  rw [integral_eq_sum_cell cbk ρ (integrable_sub_stepQuant_sq_of_supported cbk ρ hsupp)]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [← setIntegral_eq_of_supported hsupp (fun t : ℝ => (t - cbk.c j) ^ 2) (cell cbk j)]
  refine setIntegral_congr_fun (measurableSet_cell cbk j) fun t ht => ?_
  rw [stepQuant_eq_of_mem_cell cbk ht]

/-- The same decomposition with the cells left untrimmed.  Both sides are real numbers under the
support hypothesis; the trimmed form above is the one a bounded-interval argument wants. -/
theorem distortion_stepQuant_eq_sum_cell (cbk : Codebook K) (ρ : Measure ℝ) [IsFiniteMeasure ρ]
    {a b : ℝ} (hsupp : ρ (Set.Icc a b)ᶜ = 0) :
    distortion (stepQuant cbk) ρ
      = ∑ j : Fin (K + 1), ∫ t in cell cbk j, (t - cbk.c j) ^ 2 ∂ρ := by
  rw [distortion_stepQuant_eq_sum cbk ρ hsupp]
  exact Finset.sum_congr rfl fun j _ =>
    (setIntegral_eq_of_supported hsupp (fun t : ℝ => (t - cbk.c j) ^ 2) (cell cbk j)).symm

/-- **Completing the square, cell by cell.**  On one cell the squared error to the codeword is the
second moment of the cell plus a term built only from the cell's mass and first moment. -/
theorem setIntegral_cell_sub_sq (cbk : Codebook K) (ρ : Measure ℝ) [IsFiniteMeasure ρ]
    {a b : ℝ} (hsupp : ρ (Set.Icc a b)ᶜ = 0) (j : Fin (K + 1)) :
    ∫ t in cell cbk j, (t - cbk.c j) ^ 2 ∂ρ
      = (∫ t in cell cbk j, t ^ 2 ∂ρ)
        + cbk.c j * (cbk.c j * cellMass cbk ρ j - 2 * cellMoment cbk ρ j) := by
  have hid : IntegrableOn (fun t : ℝ => t) (cell cbk j) ρ :=
    (integrable_id_of_supported ρ hsupp).integrableOn
  have hsq : IntegrableOn (fun t : ℝ => t ^ 2) (cell cbk j) ρ :=
    (integrable_sq_of_supported ρ hsupp).integrableOn
  have hlin : IntegrableOn (fun t : ℝ => 2 * cbk.c j * t) (cell cbk j) ρ :=
    hid.const_mul (2 * cbk.c j)
  have hconst : IntegrableOn (fun _ : ℝ => cbk.c j ^ 2) (cell cbk j) ρ :=
    (integrable_const (cbk.c j ^ 2)).integrableOn
  have hsub : IntegrableOn (fun t : ℝ => t ^ 2 - 2 * cbk.c j * t) (cell cbk j) ρ := hsq.sub hlin
  have hmul : ∫ t in cell cbk j, 2 * cbk.c j * t ∂ρ = 2 * cbk.c j * cellMoment cbk ρ j := by
    simp only [cellMoment]
    rw [integral_const_mul]
  have hcst : ∫ _t in cell cbk j, cbk.c j ^ 2 ∂ρ = cbk.c j ^ 2 * cellMass cbk ρ j := by
    rw [setIntegral_const, smul_eq_mul]
    simp only [cellMass]
    ring
  have hstep : ∫ t in cell cbk j, (t - cbk.c j) ^ 2 ∂ρ
      = ∫ t in cell cbk j, (t ^ 2 - 2 * cbk.c j * t + cbk.c j ^ 2) ∂ρ :=
    setIntegral_congr_fun (measurableSet_cell cbk j) (fun t _ => by ring)
  rw [hstep, integral_add hsub hconst, integral_sub hsq hlin, hmul, hcst]
  ring

/-- **The split of the square.**  Against a finite law supported in `Icc a b`, the distortion of
the step quantiser is the law's second moment plus a sum over cells of a term built only from the
codewords and the cells' masses and first moments.  The second-moment term does not mention the
codebook at all, which is what lets matched second moments cancel it when two laws are compared;
no such comparison is made here. -/
theorem distortion_eq_sq_add_cross (cbk : Codebook K) (ρ : Measure ℝ) [IsFiniteMeasure ρ]
    {a b : ℝ} (hsupp : ρ (Set.Icc a b)ᶜ = 0) :
    distortion (stepQuant cbk) ρ
      = (∫ t, t ^ 2 ∂ρ)
        + ∑ j : Fin (K + 1),
            cbk.c j * (cbk.c j * cellMass cbk ρ j - 2 * cellMoment cbk ρ j) := by
  rw [distortion_stepQuant_eq_sum_cell cbk ρ hsupp,
    integral_eq_sum_cell cbk ρ (integrable_sq_of_supported ρ hsupp), ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun j _ => setIntegral_cell_sub_sq cbk ρ hsupp j

/-! ### Transport to an arbitrary nearest-codeword map

Every statement above is about the one explicit step function `stepQuant`.  §52's
`distortion_congr_of_isNearest` moves each of them to an arbitrary nearest-codeword map for the
same codebook, at no cost and with no tie convention: the two integrands agree at every point. -/

/-- The cell decomposition, for an arbitrary nearest-codeword map. -/
theorem distortion_isNearest_eq_sum {cbk : Codebook K} {q : ℝ → ℝ}
    (hq : IsNearest (Set.range cbk.c) q) (ρ : Measure ℝ) [IsFiniteMeasure ρ]
    {a b : ℝ} (hsupp : ρ (Set.Icc a b)ᶜ = 0) :
    distortion q ρ
      = ∑ j : Fin (K + 1), ∫ t in cell cbk j ∩ Set.Icc a b, (t - cbk.c j) ^ 2 ∂ρ := by
  rw [distortion_congr_of_isNearest hq (isNearest_stepQuant cbk) ρ]
  exact distortion_stepQuant_eq_sum cbk ρ hsupp

/-- **The split of the square, for an arbitrary nearest-codeword map.**  This is the form the gap
identity consumes: the quantiser is any nearest map of the codebook, and the only law-dependent
quantities on the right are the second moment, the cell masses and the cell first moments. -/
theorem distortion_isNearest_eq_sq_add_cross {cbk : Codebook K} {q : ℝ → ℝ}
    (hq : IsNearest (Set.range cbk.c) q) (ρ : Measure ℝ) [IsFiniteMeasure ρ]
    {a b : ℝ} (hsupp : ρ (Set.Icc a b)ᶜ = 0) :
    distortion q ρ
      = (∫ t, t ^ 2 ∂ρ)
        + ∑ j : Fin (K + 1),
            cbk.c j * (cbk.c j * cellMass cbk ρ j - 2 * cellMoment cbk ρ j) := by
  rw [distortion_congr_of_isNearest hq (isNearest_stepQuant cbk) ρ]
  exact distortion_eq_sq_add_cross cbk ρ hsupp

end Threshold

/-! ## §54  The per-cell distortion gap of two laws, in CDF terms

§53 splits the distortion of a nearest-codeword map into the second moment of the law plus a sum
over cells of a term built from the cell masses and the cell first moments.  This section
subtracts two such decompositions.  Matched **second** moments cancel the second-moment term by
plain algebra, and each surviving cell contributes a quantity built only from the CDF difference
`cdf μ − cdf ν` at the two ends of the cell and from its once-integrated form `cdfGapInt`.  That
is the whole content here: it is an identity between two real numbers, and it is already sharper
than the cell decomposition it comes from, because a sup-norm bound on `cdf μ − cdf ν` applies to
its right-hand side directly.

Matched **means** are *not* assumed and are *not* used.  They belong to the Abel summation that
turns the sum below into a sum over thresholds, where they are what makes the two outer boundary
terms vanish; nothing in this section needs them.

The boundaries are packaged once.  A codebook with `K + 1` codewords has `K + 1` cells and
`K + 2` boundaries: `bdry cbk a b` sends index `0` to `a`, index `Fin.last (K + 1)` to `b`, and
index `k.succ.castSucc` to the threshold `thr cbk k`.  The single geometric fact that makes the
whole section uniform is `cell_inter_Ioc`: intersected with `(a, b]`, the `j`-th cell is exactly
`(bdry j.castSucc, bdry j.succ]`, the two outer cells included.  So masses become CDF differences
by `measureReal_Ioc_eq_cdf_sub`, and first moments become boundary terms minus a once-integrated
CDF difference by `cell_first_moment_gap`, which is proved here from the layer cake since Mathlib
has no Lebesgue or Stieltjes integration by parts.

Two hypotheses deserve comment, since neither is cosmetic.

* The support hypothesis is `μ (Ioc a b)ᶜ = 0`, half-open on the left, not `μ (Icc a b)ᶜ = 0`.
  It implies the closed form, and it is what makes `cdf μ a = 0` and `cdf μ b = 1`, so that both
  outer boundary terms are honest CDF values rather than a convention.  Any law with compact
  support satisfies it after moving `a` strictly below the support, which costs nothing: the two
  laws the paper compares live in `[−‖v‖, ‖v‖]` and `[−1, 1]`.
* `hthr` places every threshold inside `[a, b]`.  It is used to identify the two outer cells with
  `(a, thr 0]` and `(thr (K−1), b]`, and it is carried by every statement below that mentions a
  cell.  Whether it can be dropped is not settled here, in either direction.

No bound is proved in this section.  `abs_bdryGapInt_le` is the one estimate, and it bounds a
single once-integrated CDF difference, not any distortion gap. -/

namespace Threshold

variable {K : ℕ}

/-! ### The layer-cake step, and the first-moment gap on a bounded cell

Mathlib has no Lebesgue or Stieltjes integration by parts, so the one analytic step of the whole
identity is rebuilt from `Integrable.integral_eq_integral_meas_lt`. -/

/-- **The layer-cake atom.**  On a bounded interval the first moment of `t − a` against a finite
law is the integral of the upper-tail mass.  This is the substitute for an integration by parts,
and it is the only genuinely analytic step below. -/
theorem tail_atom (μ : Measure ℝ) [IsFiniteMeasure μ] {a b : ℝ} :
    ∫ t in Set.Ioc a b, (t - a) ∂μ = ∫ u in Set.Ioc a b, μ.real (Set.Ioc u b) := by
  have hmem : ∀ᵐ t ∂(μ.restrict (Set.Ioc a b)), t ∈ Set.Ioc a b :=
    ae_restrict_mem measurableSet_Ioc
  have hnn : 0 ≤ᵐ[μ.restrict (Set.Ioc a b)] (fun t : ℝ => t - a) := by
    filter_upwards [hmem] with t ht
    show (0 : ℝ) ≤ t - a
    linarith [ht.1.le]
  have hint : Integrable (fun t : ℝ => t - a) (μ.restrict (Set.Ioc a b)) :=
    (integrableOn_id_Ioc μ a b).sub integrableOn_const
  rw [hint.integral_eq_integral_meas_lt hnn]
  have hset : Set.EqOn (fun s : ℝ => (μ.restrict (Set.Ioc a b)).real {t : ℝ | s < t - a})
      (fun s : ℝ => μ.real (Set.Ioc (a + s) b)) (Set.Ioi 0) := by
    intro s hs
    have hs' : (0 : ℝ) < s := hs
    have h1 : {t : ℝ | s < t - a} = Set.Ioi (a + s) := by
      ext t; simp only [Set.mem_setOf_eq, Set.mem_Ioi]; constructor <;> intro h <;> linarith
    have h2 : Set.Ioi (a + s) ∩ Set.Ioc a b = Set.Ioc (a + s) b := by
      ext t
      simp only [Set.mem_inter_iff, Set.mem_Ioi, Set.mem_Ioc]
      exact ⟨fun h => ⟨h.1, h.2.2⟩, fun h => ⟨h.1, by linarith, h.2⟩⟩
    simp only [h1, measureReal_def, Measure.restrict_apply measurableSet_Ioi, h2]
  rw [setIntegral_congr_fun measurableSet_Ioi hset]
  have hshift : ∫ s in Set.Ioi (0 : ℝ), μ.real (Set.Ioc (a + s) b)
      = ∫ u in Set.Ioi a, μ.real (Set.Ioc u b) := by
    have hpre : (fun x : ℝ => a + x) ⁻¹' (Set.Ioi a) = Set.Ioi (0 : ℝ) := by
      ext x; simp only [Set.mem_preimage, Set.mem_Ioi]; constructor <;> intro h <;> linarith
    have h := (measurePreserving_add_left (volume : Measure ℝ) a).setIntegral_preimage_emb
      (measurableEmbedding_addLeft a) (fun u : ℝ => μ.real (Set.Ioc u b)) (Set.Ioi a)
    rw [hpre] at h
    exact h
  rw [hshift]
  refine setIntegral_eq_of_subset_of_ae_sdiff_eq_zero measurableSet_Ioi.nullMeasurableSet
    Set.Ioc_subset_Ioi_self (Filter.Eventually.of_forall ?_)
  rintro u ⟨hu1, hu2⟩
  have hub : b < u := by
    by_contra h
    exact hu2 ⟨hu1, not_lt.mp h⟩
  have he : Set.Ioc u b = (∅ : Set ℝ) := Set.Ioc_eq_empty (by linarith)
  simp [he]

/-- **The first-moment gap on a bounded cell.**  On `(a, b]` the first-moment difference of two
probability laws is a boundary term minus the once-integrated CDF difference.  Nothing is assumed
about the two laws beyond being probability measures: no codebook, no quantiser, no matched
moments, and no relation between `a`, `b` and where the laws live. -/
theorem cell_first_moment_gap (μ ν : Measure ℝ) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    {a b : ℝ} (hab : a ≤ b) :
    (∫ t in Set.Ioc a b, t ∂μ) - (∫ t in Set.Ioc a b, t ∂ν)
      = b * (cdf μ b - cdf ν b) - a * (cdf μ a - cdf ν a) - cdfGapInt μ ν a b := by
  have key : ∀ (ρ : Measure ℝ) (_ : IsProbabilityMeasure ρ),
      (∫ t in Set.Ioc a b, t ∂ρ)
        = a * (cdf ρ b - cdf ρ a) + (b - a) * cdf ρ b - ∫ u in Set.Ioc a b, (cdf ρ) u := by
    intro ρ hρ
    have h1 : ∫ t in Set.Ioc a b, (t - a) ∂ρ
        = (∫ t in Set.Ioc a b, t ∂ρ) - ρ.real (Set.Ioc a b) * a := by
      rw [integral_sub (integrableOn_id_Ioc ρ a b) integrableOn_const, setIntegral_const,
        smul_eq_mul]
    have h2 : ∫ u in Set.Ioc a b, ρ.real (Set.Ioc u b)
        = ∫ u in Set.Ioc a b, ((cdf ρ) b - (cdf ρ) u) :=
      setIntegral_congr_fun measurableSet_Ioc fun u hu => measureReal_Ioc_eq_cdf_sub ρ u b hu.2
    have h3 : ∫ u in Set.Ioc a b, ((cdf ρ) b - (cdf ρ) u)
        = (b - a) * cdf ρ b - ∫ u in Set.Ioc a b, (cdf ρ) u := by
      have hcb : IntegrableOn (fun _ : ℝ => (cdf ρ) b) (Set.Ioc a b) volume := by
        haveI : IsFiniteMeasure ((volume : Measure ℝ).restrict (Set.Ioc a b)) := by
          constructor
          rw [Measure.restrict_apply_univ, Real.volume_Ioc]
          exact ENNReal.ofReal_lt_top
        exact integrable_const _
      rw [integral_sub hcb (integrableOn_cdf_Ioc ρ a b), setIntegral_const, smul_eq_mul,
        Real.volume_real_Ioc, max_eq_left (by linarith)]
    have h4 := tail_atom ρ (a := a) (b := b)
    rw [h1, h2, h3] at h4
    rw [measureReal_Ioc_eq_cdf_sub ρ a b hab] at h4
    linarith
  have hμ := key μ ‹_›
  have hν := key ν ‹_›
  rw [hμ, hν, cdfGapInt_eq_sub]
  ring

/-! ### Additivity of the once-integrated CDF difference -/

/-- `cdfGapInt` is additive over adjoining intervals, which is what lets every cell be measured
from the single left endpoint `a`. -/
theorem cdfGapInt_add (μ ν : Measure ℝ) {a x y : ℝ} (hax : a ≤ x) (hxy : x ≤ y) :
    cdfGapInt μ ν a x + cdfGapInt μ ν x y = cdfGapInt μ ν a y := by
  have hdisj : Disjoint (Set.Ioc a x) (Set.Ioc x y) := by
    rw [Set.disjoint_left]
    rintro t ⟨_, h1⟩ ⟨h2, _⟩
    exact absurd h1 (not_le.mpr h2)
  simp only [cdfGapInt]
  rw [← setIntegral_union hdisj measurableSet_Ioc (integrableOn_cdfGap_Ioc μ ν a x)
    (integrableOn_cdfGap_Ioc μ ν x y), Set.Ioc_union_Ioc_eq_Ioc hax hxy]

/-! ### Support on a half-open interval -/

/-- A law supported in `(a, b]` is supported in `[a, b]`, so every statement of §52 and §53
applies to it. -/
theorem compl_Icc_eq_zero_of_Ioc {ρ : Measure ℝ} {a b : ℝ} (hsupp : ρ (Set.Ioc a b)ᶜ = 0) :
    ρ (Set.Icc a b)ᶜ = 0 :=
  measure_mono_null (Set.compl_subset_compl.mpr Set.Ioc_subset_Icc_self) hsupp

/-- Trimming a mass to a half-open support. -/
theorem measureReal_eq_of_supported_Ioc {ρ : Measure ℝ} {a b : ℝ}
    (hsupp : ρ (Set.Ioc a b)ᶜ = 0) (s : Set ℝ) : ρ.real s = ρ.real (s ∩ Set.Ioc a b) := by
  have hnull : ρ (s \ Set.Ioc a b) = 0 := measure_mono_null (fun _ hx => hx.2) hsupp
  have hadd := measure_inter_add_sdiff (μ := ρ) s (measurableSet_Ioc (a := a) (b := b))
  rw [hnull, add_zero] at hadd
  rw [measureReal_def, measureReal_def, hadd]

/-- Trimming an integral to a half-open support. -/
theorem setIntegral_eq_of_supported_Ioc {ρ : Measure ℝ} {a b : ℝ}
    (hsupp : ρ (Set.Ioc a b)ᶜ = 0) (f : ℝ → ℝ) (s : Set ℝ) :
    ∫ t in s, f t ∂ρ = ∫ t in s ∩ Set.Ioc a b, f t ∂ρ := by
  have key : ρ.restrict s = ρ.restrict (s ∩ Set.Ioc a b) := by
    refine Measure.restrict_congr_set ?_
    rw [Filter.eventuallyEq_set]
    filter_upwards [ae_iff.mpr hsupp] with x hx
    simp [hx]
  rw [key]

/-- **The left endpoint carries no mass below it.**  A law supported in `(a, b]` has `cdf` zero
at `a`; this is the point of taking the support half-open on the left. -/
theorem cdf_eq_zero_of_supported_Ioc {ρ : Measure ℝ} [IsProbabilityMeasure ρ] {a b : ℝ}
    (hsupp : ρ (Set.Ioc a b)ᶜ = 0) : cdf ρ a = 0 := by
  have hsub : Set.Iic a ⊆ (Set.Ioc a b)ᶜ := by
    intro t ht hc
    exact absurd hc.1 (not_lt.mpr ht)
  have h : ρ (Set.Iic a) = 0 := measure_mono_null hsub hsupp
  rw [cdf_eq_real, measureReal_def, h, ENNReal.toReal_zero]

/-- A law supported in `(a, b]` has `cdf` one at `b`. -/
theorem cdf_eq_one_of_supported_Ioc {ρ : Measure ℝ} [IsProbabilityMeasure ρ] {a b : ℝ}
    (hsupp : ρ (Set.Ioc a b)ᶜ = 0) : cdf ρ b = 1 := by
  have hsub : (Set.Iic b)ᶜ ⊆ (Set.Ioc a b)ᶜ := by
    intro t ht hc
    exact ht hc.2
  have h0 : ρ (Set.Iic b)ᶜ = 0 := measure_mono_null hsub hsupp
  have h1 : ρ (Set.Iic b) = ρ Set.univ := by
    refine le_antisymm (measure_mono (Set.subset_univ _)) ?_
    calc ρ Set.univ = ρ (Set.Iic b ∪ (Set.Iic b)ᶜ) := by rw [Set.union_compl_self]
      _ ≤ ρ (Set.Iic b) + ρ (Set.Iic b)ᶜ := measure_union_le _ _
      _ = ρ (Set.Iic b) := by rw [h0, add_zero]
  rw [cdf_eq_real, measureReal_def, h1, measure_univ, ENNReal.toReal_one]

/-! ### The `K + 2` cell boundaries, as one function -/

/-- The thresholds of a codebook, extended to every natural index by the right endpoint `b`.
This is a bookkeeping device: it exists so that `bdry` is a total function on `Fin (K + 2)`. -/
noncomputable def thrExt (cbk : Codebook K) (b : ℝ) (m : ℕ) : ℝ :=
  if h : m < K then thr cbk ⟨m, h⟩ else b

theorem thrExt_of_lt (cbk : Codebook K) (b : ℝ) {m : ℕ} (h : m < K) :
    thrExt cbk b m = thr cbk ⟨m, h⟩ := dif_pos h

theorem thrExt_of_not_lt (cbk : Codebook K) (b : ℝ) {m : ℕ} (h : ¬ m < K) :
    thrExt cbk b m = b := dif_neg h

/-- **The cell boundaries.**  A codebook with `K + 1` codewords has `K + 2` boundaries: the left
endpoint `a` at index `0`, the right endpoint `b` at index `Fin.last (K + 1)`, and the `K`
thresholds in between, the `k`-th at index `k.succ.castSucc`.  Cell `j` runs from boundary
`j.castSucc` to boundary `j.succ`. -/
noncomputable def bdry (cbk : Codebook K) (a b : ℝ) (i : Fin (K + 2)) : ℝ :=
  if (i : ℕ) = 0 then a else thrExt cbk b ((i : ℕ) - 1)

theorem bdry_zero (cbk : Codebook K) (a b : ℝ) : bdry cbk a b 0 = a := by
  simp only [bdry, Fin.val_zero, if_pos]

theorem bdry_last (cbk : Codebook K) (a b : ℝ) : bdry cbk a b (Fin.last (K + 1)) = b := by
  have hv : ((Fin.last (K + 1) : Fin (K + 2)) : ℕ) = K + 1 := Fin.val_last _
  simp only [bdry, hv]
  rw [if_neg (by omega), Nat.add_sub_cancel]
  exact thrExt_of_not_lt cbk b (lt_irrefl K)

/-- The interior boundaries are the thresholds. -/
theorem bdry_succ_castSucc (cbk : Codebook K) (a b : ℝ) (k : Fin K) :
    bdry cbk a b k.succ.castSucc = thr cbk k := by
  have hv : ((k.succ.castSucc : Fin (K + 2)) : ℕ) = (k : ℕ) + 1 := by
    rw [Fin.val_castSucc, Fin.val_succ]
  simp only [bdry, hv]
  rw [if_neg (by omega), Nat.add_sub_cancel, thrExt_of_lt cbk b k.isLt]

/-- **The midpoint property, in the shape the Abel step wants.**  Every interior boundary is the
midpoint of the two codewords flanking it; this is the definition of `thr` and nothing more. -/
theorem c_add_c_eq_two_mul_bdry (cbk : Codebook K) (a b : ℝ) (k : Fin K) :
    cbk.c k.castSucc + cbk.c k.succ = 2 * bdry cbk a b k.succ.castSucc := by
  rw [bdry_succ_castSucc, thr]
  ring

theorem bdry_castSucc_val (cbk : Codebook K) (a b : ℝ) (j : Fin (K + 1)) :
    bdry cbk a b j.castSucc
      = if (j : ℕ) = 0 then a else thrExt cbk b ((j : ℕ) - 1) := by
  simp only [bdry, Fin.val_castSucc]

theorem bdry_succ_val (cbk : Codebook K) (a b : ℝ) (j : Fin (K + 1)) :
    bdry cbk a b j.succ = thrExt cbk b (j : ℕ) := by
  simp only [bdry, Fin.val_succ]
  rw [if_neg (by omega), Nat.add_sub_cancel]

/-! ### The boundaries lie in the interval, and increase along a cell -/

variable {a b : ℝ}

theorem le_thrExt (cbk : Codebook K) (hab : a ≤ b)
    (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b) (m : ℕ) : a ≤ thrExt cbk b m := by
  by_cases h : m < K
  · rw [thrExt_of_lt cbk b h]; exact (hthr ⟨m, h⟩).1
  · rw [thrExt_of_not_lt cbk b h]; exact hab

theorem thrExt_le (cbk : Codebook K)
    (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b) (m : ℕ) : thrExt cbk b m ≤ b := by
  by_cases h : m < K
  · rw [thrExt_of_lt cbk b h]; exact (hthr ⟨m, h⟩).2
  · rw [thrExt_of_not_lt cbk b h]

theorem le_bdry (cbk : Codebook K) (hab : a ≤ b)
    (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b) (i : Fin (K + 2)) :
    a ≤ bdry cbk a b i := by
  simp only [bdry]
  split_ifs
  · exact le_rfl
  · exact le_thrExt cbk hab hthr _

theorem bdry_le (cbk : Codebook K) (hab : a ≤ b)
    (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b) (i : Fin (K + 2)) :
    bdry cbk a b i ≤ b := by
  simp only [bdry]
  split_ifs
  · exact hab
  · exact thrExt_le cbk hthr _

/-- A cell's left boundary is at or below its right boundary. -/
theorem bdry_castSucc_le_bdry_succ (cbk : Codebook K) (hab : a ≤ b)
    (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b) (j : Fin (K + 1)) :
    bdry cbk a b j.castSucc ≤ bdry cbk a b j.succ := by
  rw [bdry_castSucc_val, bdry_succ_val]
  by_cases hj : (j : ℕ) = 0
  · rw [if_pos hj]
    exact le_thrExt cbk hab hthr _
  · rw [if_neg hj]
    by_cases hK : (j : ℕ) < K
    · have hp : (j : ℕ) - 1 < K := by omega
      rw [thrExt_of_lt cbk b hp, thrExt_of_lt cbk b hK]
      exact (thr_strictMono cbk).monotone (Fin.le_def.mpr (by show (j : ℕ) - 1 ≤ (j : ℕ); omega))
    · rw [thrExt_of_not_lt cbk b hK]
      exact thrExt_le cbk hthr _

/-! ### The one geometric fact: a cell, trimmed, is the interval between its boundaries -/

/-- **Every cell, trimmed to `(a, b]`, is the half-open interval between its two boundaries.**
This holds for the two outer cells, which are unbounded rays, as well as for the interior ones,
and it is the single statement that makes the rest of the section uniform in `j`. -/
theorem cell_inter_Ioc (cbk : Codebook K) (hab : a ≤ b)
    (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b) (j : Fin (K + 1)) :
    cell cbk j ∩ Set.Ioc a b = Set.Ioc (bdry cbk a b j.castSucc) (bdry cbk a b j.succ) := by
  ext t
  simp only [Set.mem_inter_iff, mem_cell_iff, Set.mem_Ioc, bdry_castSucc_val, bdry_succ_val]
  constructor
  · rintro ⟨⟨h1, h2⟩, hta, htb⟩
    constructor
    · by_cases hj : (j : ℕ) = 0
      · rw [if_pos hj]; exact hta
      · rw [if_neg hj]
        have hp : (j : ℕ) - 1 < K := by have := j.isLt; omega
        rw [thrExt_of_lt cbk b hp]
        exact h1 ⟨(j : ℕ) - 1, hp⟩ (by show (j : ℕ) - 1 < (j : ℕ); omega)
    · by_cases hK : (j : ℕ) < K
      · rw [thrExt_of_lt cbk b hK]
        exact h2 ⟨(j : ℕ), hK⟩ (by show (j : ℕ) ≤ (j : ℕ); omega)
      · rw [thrExt_of_not_lt cbk b hK]; exact htb
  · rintro ⟨hlo, hhi⟩
    have hAle : a ≤ (if (j : ℕ) = 0 then a else thrExt cbk b ((j : ℕ) - 1)) := by
      split_ifs
      · exact le_rfl
      · exact le_thrExt cbk hab hthr _
    have hBle : thrExt cbk b (j : ℕ) ≤ b := thrExt_le cbk hthr _
    refine ⟨⟨fun k hk => ?_, fun k hk => ?_⟩, lt_of_le_of_lt hAle hlo, le_trans hhi hBle⟩
    · have hj : ¬ ((j : ℕ) = 0) := by omega
      rw [if_neg hj] at hlo
      have hp : (j : ℕ) - 1 < K := by have := j.isLt; omega
      rw [thrExt_of_lt cbk b hp] at hlo
      refine lt_of_le_of_lt ?_ hlo
      exact (thr_strictMono cbk).monotone
        (Fin.le_def.mpr (by show (k : ℕ) ≤ (j : ℕ) - 1; omega))
    · have hK : (j : ℕ) < K := lt_of_le_of_lt hk k.isLt
      rw [thrExt_of_lt cbk b hK] at hhi
      exact le_trans hhi ((thr_strictMono cbk).monotone
        (Fin.le_def.mpr (by show (j : ℕ) ≤ (k : ℕ); omega)))

/-! ### The boundary-indexed CDF gap and its once-integrated form -/

/-- The CDF difference of the two laws at a cell boundary. -/
noncomputable def bdryCdfGap (cbk : Codebook K) (μ ν : Measure ℝ) (a b : ℝ) (i : Fin (K + 2)) :
    ℝ := cdf μ (bdry cbk a b i) - cdf ν (bdry cbk a b i)

/-- The once-integrated CDF difference from `a` up to a cell boundary. -/
noncomputable def bdryGapInt (cbk : Codebook K) (μ ν : Measure ℝ) (a b : ℝ) (i : Fin (K + 2)) :
    ℝ := cdfGapInt μ ν a (bdry cbk a b i)

/-- At the left boundary the CDF gap vanishes, both laws being supported in `(a, b]`. -/
theorem bdryCdfGap_zero (cbk : Codebook K) {μ ν : Measure ℝ} [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] (hsupp_mu : μ (Set.Ioc a b)ᶜ = 0) (hsupp_nu : ν (Set.Ioc a b)ᶜ = 0) :
    bdryCdfGap cbk μ ν a b 0 = 0 := by
  rw [bdryCdfGap, bdry_zero, cdf_eq_zero_of_supported_Ioc hsupp_mu,
    cdf_eq_zero_of_supported_Ioc hsupp_nu, sub_self]

/-- At the right boundary the CDF gap vanishes, both laws being probability measures supported in
`(a, b]`. -/
theorem bdryCdfGap_last (cbk : Codebook K) {μ ν : Measure ℝ} [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] (hsupp_mu : μ (Set.Ioc a b)ᶜ = 0) (hsupp_nu : ν (Set.Ioc a b)ᶜ = 0) :
    bdryCdfGap cbk μ ν a b (Fin.last (K + 1)) = 0 := by
  rw [bdryCdfGap, bdry_last, cdf_eq_one_of_supported_Ioc hsupp_mu,
    cdf_eq_one_of_supported_Ioc hsupp_nu, sub_self]

/-- The once-integrated gap is zero at the left boundary, the interval being empty. -/
theorem bdryGapInt_zero (cbk : Codebook K) (μ ν : Measure ℝ) (a b : ℝ) :
    bdryGapInt cbk μ ν a b 0 = 0 := by
  rw [bdryGapInt, bdry_zero, cdfGapInt]
  simp

/-- The interior values of the two boundary-indexed functions are the ones at the thresholds. -/
theorem bdryCdfGap_succ_castSucc (cbk : Codebook K) (μ ν : Measure ℝ) (a b : ℝ) (k : Fin K) :
    bdryCdfGap cbk μ ν a b k.succ.castSucc = cdf μ (thr cbk k) - cdf ν (thr cbk k) := by
  rw [bdryCdfGap, bdry_succ_castSucc]

theorem bdryGapInt_succ_castSucc (cbk : Codebook K) (μ ν : Measure ℝ) (a b : ℝ) (k : Fin K) :
    bdryGapInt cbk μ ν a b k.succ.castSucc = cdfGapInt μ ν a (thr cbk k) := by
  rw [bdryGapInt, bdry_succ_castSucc]

/-- **The only estimate here.**  A sup-norm bound `η` on the CDF difference bounds every
boundary-indexed once-integrated gap by `η · (b − a)`.  This bounds one term of the identity
below; it bounds no distortion gap. -/
theorem abs_bdryGapInt_le (cbk : Codebook K) (μ ν : Measure ℝ) {η : ℝ} (hab : a ≤ b)
    (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b)
    (hks : ∀ u, |(cdf μ) u - (cdf ν) u| ≤ η) (i : Fin (K + 2)) :
    |bdryGapInt cbk μ ν a b i| ≤ η * (b - a) := by
  have hη : 0 ≤ η := le_trans (abs_nonneg _) (hks a)
  have h3 : a ≤ bdry cbk a b i := le_bdry cbk hab hthr i
  have h2 : bdry cbk a b i ≤ b := bdry_le cbk hab hthr i
  have h1 : |cdfGapInt μ ν a (bdry cbk a b i)| ≤ η * (bdry cbk a b i - a) :=
    abs_cdfGapInt_le μ ν h3 hks
  rw [bdryGapInt]
  refine le_trans h1 ?_
  nlinarith

/-! ### The mass and the first moment of a cell, as CDF quantities -/

/-- **A cell's mass gap is a CDF difference at its two boundaries.** -/
theorem cellMass_sub_cellMass (cbk : Codebook K) {μ ν : Measure ℝ} [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] (hab : a ≤ b) (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b)
    (hsupp_mu : μ (Set.Ioc a b)ᶜ = 0) (hsupp_nu : ν (Set.Ioc a b)ᶜ = 0) (j : Fin (K + 1)) :
    cellMass cbk μ j - cellMass cbk ν j
      = bdryCdfGap cbk μ ν a b j.succ - bdryCdfGap cbk μ ν a b j.castSucc := by
  have hle := bdry_castSucc_le_bdry_succ cbk hab hthr j
  have hm : ∀ (ρ : Measure ℝ), IsProbabilityMeasure ρ → ρ (Set.Ioc a b)ᶜ = 0 →
      cellMass cbk ρ j = cdf ρ (bdry cbk a b j.succ) - cdf ρ (bdry cbk a b j.castSucc) := by
    intro ρ hρ hs
    rw [cellMass, measureReal_eq_of_supported_Ioc hs (cell cbk j), cell_inter_Ioc cbk hab hthr j,
      measureReal_Ioc_eq_cdf_sub ρ _ _ hle]
  rw [hm μ ‹_› hsupp_mu, hm ν ‹_› hsupp_nu, bdryCdfGap, bdryCdfGap]
  ring

/-- **A cell's first-moment gap is a boundary term minus a once-integrated CDF difference.**  This
is `cell_first_moment_gap` on the trimmed cell, with the once-integrated term measured from the
common left endpoint `a` by `cdfGapInt_add`. -/
theorem cellMoment_sub_cellMoment (cbk : Codebook K) {μ ν : Measure ℝ} [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] (hab : a ≤ b) (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b)
    (hsupp_mu : μ (Set.Ioc a b)ᶜ = 0) (hsupp_nu : ν (Set.Ioc a b)ᶜ = 0) (j : Fin (K + 1)) :
    cellMoment cbk μ j - cellMoment cbk ν j
      = bdry cbk a b j.succ * bdryCdfGap cbk μ ν a b j.succ
        - bdry cbk a b j.castSucc * bdryCdfGap cbk μ ν a b j.castSucc
        - (bdryGapInt cbk μ ν a b j.succ - bdryGapInt cbk μ ν a b j.castSucc) := by
  have hle := bdry_castSucc_le_bdry_succ cbk hab hthr j
  have hstart := le_bdry cbk hab hthr j.castSucc
  have hmμ : cellMoment cbk μ j = ∫ t in Set.Ioc (bdry cbk a b j.castSucc)
      (bdry cbk a b j.succ), t ∂μ := by
    rw [cellMoment, setIntegral_eq_of_supported_Ioc hsupp_mu (fun t : ℝ => t) (cell cbk j),
      cell_inter_Ioc cbk hab hthr j]
  have hmν : cellMoment cbk ν j = ∫ t in Set.Ioc (bdry cbk a b j.castSucc)
      (bdry cbk a b j.succ), t ∂ν := by
    rw [cellMoment, setIntegral_eq_of_supported_Ioc hsupp_nu (fun t : ℝ => t) (cell cbk j),
      cell_inter_Ioc cbk hab hthr j]
  have hgap := cell_first_moment_gap μ ν hle
  have hadd := cdfGapInt_add μ ν hstart hle
  rw [hmμ, hmν, hgap, bdryCdfGap, bdryCdfGap, bdryGapInt, bdryGapInt]
  linarith

/-! ### The per-cell gap -/

/-- **The per-cell distortion gap.**  For two probability laws supported in `(a, b]` with *equal
second moments*, and any nearest-codeword map of an ordered codebook whose thresholds lie in
`[a, b]`, the distortion gap is a sum over the `K + 1` cells of a term built only from the CDF
difference at the two cell boundaries and from its once-integrated form.

The second moments cancel by plain algebra; that is the only use of `hsq`.  Equal **means** are
neither assumed nor used here.  No bound is claimed: this is an identity between two real numbers,
and it is the summand of §50's `sum_cell_gap_eq_boundary_sub_threshold`, so the Abel step can be
applied to it verbatim with `c := cbk.c`, `x := bdry cbk a b`, `F := bdryCdfGap cbk μ ν a b` and
`G := bdryGapInt cbk μ ν a b`. -/
theorem distortion_sub_distortion_eq_cellGap (cbk : Codebook K) {q : ℝ → ℝ}
    (hq : IsNearest (Set.range cbk.c) q) (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] (hab : a ≤ b) (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b)
    (hsupp_mu : μ (Set.Ioc a b)ᶜ = 0) (hsupp_nu : ν (Set.Ioc a b)ᶜ = 0)
    (hsq : ∫ t, t ^ 2 ∂μ = ∫ t, t ^ 2 ∂ν) :
    distortion q μ - distortion q ν
      = ∑ j : Fin (K + 1),
          (cbk.c j ^ 2
              * (bdryCdfGap cbk μ ν a b j.succ - bdryCdfGap cbk μ ν a b j.castSucc)
            - 2 * cbk.c j
              * (bdry cbk a b j.succ * bdryCdfGap cbk μ ν a b j.succ
                  - bdry cbk a b j.castSucc * bdryCdfGap cbk μ ν a b j.castSucc
                  - (bdryGapInt cbk μ ν a b j.succ
                      - bdryGapInt cbk μ ν a b j.castSucc))) := by
  have hIccμ : μ (Set.Icc a b)ᶜ = 0 := compl_Icc_eq_zero_of_Ioc hsupp_mu
  have hIccν : ν (Set.Icc a b)ᶜ = 0 := compl_Icc_eq_zero_of_Ioc hsupp_nu
  have hμ := distortion_isNearest_eq_sq_add_cross hq μ hIccμ
  have hν := distortion_isNearest_eq_sq_add_cross hq ν hIccν
  have hcancel : ∀ X S T : ℝ, (X + S) - (X + T) = S - T := fun X S T => by ring
  rw [hμ, hν, hsq, hcancel, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  have h1 := cellMass_sub_cellMass cbk hab hthr hsupp_mu hsupp_nu j
  have h2 := cellMoment_sub_cellMoment cbk hab hthr hsupp_mu hsupp_nu j
  linear_combination (cbk.c j ^ 2) * h1 - 2 * cbk.c j * h2

end Threshold

/-! ## §55  The threshold form of the scalar distortion gap

This is the headline of the threshold sections, and it is an **identity**, not a bound.  For an
ordered scalar codebook and any nearest-codeword map of it, and for two probability laws that
live on a common bounded interval and agree in their first two moments, the difference of the two
distortions is

  `D(q, μ) − D(q, ν) = −2 · Σ_k (c_{k+1} − c_k) · ∫_{(a, τ_k]} (cdf μ − cdf ν)`,

a finite sum over the `K` thresholds `τ_k`, weighted by the codeword increments, of the
once-integrated difference of the two cumulative distribution functions.  Nothing is dropped and
nothing is estimated: both sides are the same real number.

Where each hypothesis is spent.  Equal **second** moments cancel the `∫ t²` term, which is the
only place they are used and is already done in §54.  Equal **means** are used exactly once, at
the very end: together with the half-open support they force `cdfGapInt μ ν a b = 0`, and that is
what kills the last surviving boundary term `2 · c_K · cdfGapInt μ ν a b` left over by the
summation by parts of §50.  Without matched means that term is present, and the identity as
stated does not follow.  The midpoint placement of the thresholds is spent inside §50's
`sum_cell_gap_eq_boundary_sub_threshold`, where it is what makes the mass contributions cancel at
every interior threshold.  No tie convention is used anywhere: §52's `sq_sub_eq_of_isNearest`
makes the value of `q` at a threshold immaterial, so `q` is an arbitrary nearest map.

Two hypotheses are stronger than the bare shape of the statement suggests, and both are stated
honestly rather than hidden.  The support hypothesis is half-open on the left,
`ρ (Ioc a b)ᶜ = 0`, not `ρ (Icc a b)ᶜ = 0`: it is what makes `cdf ρ a = 0`, so that the boundary
term at the left endpoint is an honest zero rather than a convention.  It costs nothing for a
compactly supported law, since `compl_Ioc_eq_zero_of_Icc` moves the left endpoint strictly below
the support, and both laws the paper compares are compactly supported.  The hypothesis `hthr`
places every threshold inside `[a, b]`; it is what identifies the two outer cells with the two
outer intervals, and it is a genuine restriction on the codebook relative to the interval, not a
bookkeeping device.  No hypothesis `a ≤ b` appears: for a probability law supported in `(a, b]`
the interval cannot be empty, which is `le_of_supported_Ioc`.

`abs_distortion_sub_distortion_le` reads the identity as a bound, and is the only inequality
here.  A sup-norm bound `η` on `cdf μ − cdf ν` bounds each once-integrated term by `η · (b − a)`,
and the codeword increments telescope to the spread, giving
`|D(q, μ) − D(q, ν)| ≤ 2 · η · spread cbk · (b − a)`.  This is a conditional statement about a
pair of laws: it says what a Kolmogorov-Smirnov bound buys, and it supplies no such bound.

**What is not claimed.**  Neither theorem says the distortion gap is small.  The identity is an
exact rewriting whose right-hand side is a sum of signed real numbers with no sign attached to
any of them; the bound is vacuous until some `η` is supplied from elsewhere.  In particular
nothing here says that the deployed randomised Hadamard rotation attains the Haar rate `ρ²`, and
nothing here supplies the `η` for the pair of laws the paper compares: that the coordinate law of
`H D_ε v` is close in Kolmogorov-Smirnov distance to the spherical coordinate law is §44's
business, and no theorem in this section invokes it or is specialised to those two laws.
Neither theorem is specific to any codebook the paper ships, and `K` is not claimed to be
the number of
levels of any deployed quantiser. -/

namespace Threshold

variable {K : ℕ}

/-! ### Two hypotheses that discharge themselves -/

/-- A probability law supported in `(a, b]` forces the interval to be nonempty, hence `a ≤ b`.
This is why no separate ordering hypothesis appears below. -/
theorem le_of_supported_Ioc {ρ : Measure ℝ} [IsProbabilityMeasure ρ] {a b : ℝ}
    (hsupp : ρ (Set.Ioc a b)ᶜ = 0) : a ≤ b := by
  by_contra hcon
  have he : Set.Ioc a b = (∅ : Set ℝ) := Set.Ioc_eq_empty fun h => hcon h.le
  have huniv : ρ Set.univ = 0 := by
    rw [← Set.compl_empty, ← he]
    exact hsupp
  rw [measure_univ] at huniv
  exact one_ne_zero huniv

/-- **The half-open support hypothesis costs nothing.**  A law supported in a closed interval is
supported in any half-open interval that contains it with room to spare on the left.  This is how
the two compactly supported laws of §52 meet the hypothesis of the identity below, and it is also
what lets the interval carrying the codebook's thresholds be wider than the one carrying the
laws. -/
theorem compl_Ioc_eq_zero_of_Icc {ρ : Measure ℝ} {a a' b' b : ℝ} (haa : a < a') (hbb : b' ≤ b)
    (hsupp : ρ (Set.Icc a' b')ᶜ = 0) : ρ (Set.Ioc a b)ᶜ = 0 :=
  measure_mono_null
    (Set.compl_subset_compl.mpr fun _t ht => ⟨lt_of_lt_of_le haa ht.1, le_trans ht.2 hbb⟩) hsupp

/-! ### Matched means kill the last boundary term -/

/-- **Matched means make the once-integrated CDF difference vanish over the whole interval.**
For two probability laws supported in `(a, b]` the CDF difference is zero at both endpoints, so
`cell_first_moment_gap` reduces to `cdfGapInt μ ν a b = ∫ t ∂ν − ∫ t ∂μ`.  This is the only place
equal means are used, and it is exactly what removes the boundary term left by the summation by
parts. -/
theorem cdfGapInt_eq_zero_of_mean {μ ν : Measure ℝ} [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] {a b : ℝ} (hsupp_mu : μ (Set.Ioc a b)ᶜ = 0)
    (hsupp_nu : ν (Set.Ioc a b)ᶜ = 0) (hmean : ∫ t, t ∂μ = ∫ t, t ∂ν) :
    cdfGapInt μ ν a b = 0 := by
  have hab : a ≤ b := le_of_supported_Ioc hsupp_mu
  have htrimmu : ∫ t, t ∂μ = ∫ t in Set.Ioc a b, t ∂μ := by
    have h := setIntegral_eq_of_supported_Ioc hsupp_mu (fun t : ℝ => t) Set.univ
    rw [Set.univ_inter, setIntegral_univ] at h
    exact h
  have htrimnu : ∫ t, t ∂ν = ∫ t in Set.Ioc a b, t ∂ν := by
    have h := setIntegral_eq_of_supported_Ioc hsupp_nu (fun t : ℝ => t) Set.univ
    rw [Set.univ_inter, setIntegral_univ] at h
    exact h
  have h := cell_first_moment_gap μ ν hab
  rw [cdf_eq_zero_of_supported_Ioc hsupp_mu, cdf_eq_zero_of_supported_Ioc hsupp_nu,
    cdf_eq_one_of_supported_Ioc hsupp_mu, cdf_eq_one_of_supported_Ioc hsupp_nu,
    ← htrimmu, ← htrimnu, hmean] at h
  linarith

/-! ### The threshold identity -/

/-- **The threshold form of the distortion gap.**  Let `cbk` be an ordered scalar codebook whose
thresholds all lie in `[a, b]`, let `q` be *any* nearest-codeword map for it, and let `μ` and `ν`
be probability laws supported in `(a, b]` with equal means and equal second moments.  Then

  `D(q, μ) − D(q, ν) = −2 · Σ_k (c k.succ − c k.castSucc) · cdfGapInt μ ν a (thr cbk k)`.

This is an exact identity between two real numbers.  It is not a bound, it asserts no sign for
any summand, and it does not say the gap is small.  The right-hand side involves the two laws
only through the once-integrated CDF difference at the `K` thresholds. -/
theorem distortion_sub_distortion_eq_threshold (cbk : Codebook K) {q : ℝ → ℝ}
    (hq : IsNearest (Set.range cbk.c) q) (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] (a b : ℝ) (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b)
    (hsupp_mu : μ (Set.Ioc a b)ᶜ = 0) (hsupp_nu : ν (Set.Ioc a b)ᶜ = 0)
    (hmean : ∫ t, t ∂μ = ∫ t, t ∂ν) (hsq : ∫ t, t ^ 2 ∂μ = ∫ t, t ^ 2 ∂ν) :
    distortion q μ - distortion q ν
      = -2 * ∑ k : Fin K,
          (cbk.c k.succ - cbk.c k.castSucc) * cdfGapInt μ ν a (thr cbk k) := by
  have hab : a ≤ b := le_of_supported_Ioc hsupp_mu
  have hzero : cdfGapInt μ ν a b = 0 :=
    cdfGapInt_eq_zero_of_mean hsupp_mu hsupp_nu hmean
  have hGlast : bdryGapInt cbk μ ν a b (Fin.last (K + 1)) = 0 := by
    rw [bdryGapInt, bdry_last, hzero]
  have hsum : ∑ k : Fin K,
        (cbk.c k.succ - cbk.c k.castSucc) * bdryGapInt cbk μ ν a b k.succ.castSucc
      = ∑ k : Fin K,
          (cbk.c k.succ - cbk.c k.castSucc) * cdfGapInt μ ν a (thr cbk k) :=
    Finset.sum_congr rfl fun k _ => by rw [bdryGapInt_succ_castSucc]
  have hcell := distortion_sub_distortion_eq_cellGap cbk hq μ ν hab hthr hsupp_mu hsupp_nu hsq
  have habel := sum_cell_gap_eq_boundary_sub_threshold (K := K) cbk.c (bdry cbk a b)
    (bdryCdfGap cbk μ ν a b) (bdryGapInt cbk μ ν a b) (c_add_c_eq_two_mul_bdry cbk a b)
  have hmain := hcell.trans habel
  rw [bdryCdfGap_zero cbk hsupp_mu hsupp_nu, bdryCdfGap_last cbk hsupp_mu hsupp_nu,
    bdryGapInt_zero cbk μ ν a b, hGlast, hsum] at hmain
  rw [hmain]
  ring

/-! ### Reading the identity as a bound -/

/-- **A sup-norm bound on the CDF difference bounds the distortion gap.**  Under the hypotheses of
the identity, a uniform bound `η` on `|cdf μ − cdf ν|` gives

  `|D(q, μ) − D(q, ν)| ≤ 2 · η · spread cbk · (b − a)`,

since each once-integrated term is bounded by `η · (b − a)` and the codeword increments telescope
to the spread.  This is conditional on `η`: no bound on the Kolmogorov-Smirnov distance of any
particular pair of laws is proved here or used here. -/
theorem abs_distortion_sub_distortion_le (cbk : Codebook K) {q : ℝ → ℝ}
    (hq : IsNearest (Set.range cbk.c) q) (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] (a b : ℝ) {η : ℝ} (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b)
    (hsupp_mu : μ (Set.Ioc a b)ᶜ = 0) (hsupp_nu : ν (Set.Ioc a b)ᶜ = 0)
    (hmean : ∫ t, t ∂μ = ∫ t, t ∂ν) (hsq : ∫ t, t ^ 2 ∂μ = ∫ t, t ^ 2 ∂ν)
    (hks : ∀ u, |(cdf μ) u - (cdf ν) u| ≤ η) :
    |distortion q μ - distortion q ν| ≤ 2 * η * spread cbk * (b - a) := by
  have hab : a ≤ b := le_of_supported_Ioc hsupp_mu
  have hG : ∀ k : Fin K, |cdfGapInt μ ν a (thr cbk k)| ≤ η * (b - a) := by
    intro k
    have h := abs_bdryGapInt_le cbk μ ν hab hthr hks k.succ.castSucc
    rwa [bdryGapInt_succ_castSucc] at h
  have hw := abs_sum_fin_weighted_le (c := cbk.c) cbk.mono.monotone
    (fun k : Fin K => cdfGapInt μ ν a (thr cbk k)) hG
  rw [distortion_sub_distortion_eq_threshold cbk hq μ ν a b hthr hsupp_mu hsupp_nu hmean hsq,
    abs_mul]
  have habs : |(-2 : ℝ)| = 2 := by norm_num
  rw [habs]
  simp only [spread]
  nlinarith [hw, abs_nonneg (∑ k : Fin K,
    (cbk.c k.succ - cbk.c k.castSucc) * cdfGapInt μ ν a (thr cbk k))]

/-- **A uniform bound on `cdfGapInt` bounds the distortion gap, with no `(b − a)` factor.**  Under
the hypotheses of the identity, a bound `C` on `|cdfGapInt μ ν a x|` uniform in `x` gives

  `|D(q, μ) − D(q, ν)| ≤ 2 · C · spread cbk`.

The proof is shorter than `abs_distortion_sub_distortion_le`'s: `abs_sum_fin_weighted_le` only
ever needed a uniform bound on the summands `cdfGapInt μ ν a (thr cbk k)`, and here that bound is
supplied directly, with no detour through a sup-norm `η` on `cdf μ − cdf ν` and no factor of
`(b − a)`.  This is conditional on `C`: no such bound is proved here for any particular pair of
laws. -/
theorem abs_distortion_sub_distortion_le_of_cdfGapInt (cbk : Codebook K) {q : ℝ → ℝ}
    (hq : IsNearest (Set.range cbk.c) q) (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] (a b : ℝ) {C : ℝ} (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b)
    (hsupp_mu : μ (Set.Ioc a b)ᶜ = 0) (hsupp_nu : ν (Set.Ioc a b)ᶜ = 0)
    (hmean : ∫ t, t ∂μ = ∫ t, t ∂ν) (hsq : ∫ t, t ^ 2 ∂μ = ∫ t, t ^ 2 ∂ν)
    (hC : ∀ x, |cdfGapInt μ ν a x| ≤ C) :
    |distortion q μ - distortion q ν| ≤ 2 * C * spread cbk := by
  have hw := abs_sum_fin_weighted_le (c := cbk.c) cbk.mono.monotone
    (fun k : Fin K => cdfGapInt μ ν a (thr cbk k)) (fun k => hC (thr cbk k))
  rw [distortion_sub_distortion_eq_threshold cbk hq μ ν a b hthr hsupp_mu hsupp_nu hmean hsq,
    abs_mul]
  have habs : |(-2 : ℝ)| = 2 := by norm_num
  rw [habs]
  simp only [spread]
  nlinarith [hw]

end Threshold

/-! ## §56  Reading the threshold bound at the pair of laws the paper compares

§55 turns the threshold identity into a bound: for an ordered scalar codebook, any
nearest-codeword map of it, and two probability laws on a common bounded interval with equal
means and equal second moments, a sup-norm bound `η` on `cdf μ − cdf ν` gives

  `|D(q, μ) − D(q, ν)| ≤ 2 · η · spread cbk · (b − a)`.

This section does two things with that bound and nothing else.

* It repackages it for the laws the development actually has, which come with **closed** supports
  rather than the half-open ones §55 wants, and which need not share the interval the codebook's
  thresholds live in.  `abs_distortion_sub_distortion_le_of_Icc` is that repackaging; it is the
  §55 bound plus §55's `compl_Ioc_eq_zero_of_Icc`, and it proves nothing new.
* It discharges every hypothesis of the bound for the pair `(coordLaw H v i, sphericalCoordLaw d)`
  at a **unit** direction `v`, *except one*, and carries the result through §11c's
  `ScalarGap.hadRate_sub_rhoSq` to the deployed per-pass rate.  The hypotheses discharged here
  are the two supports (§52's `coordLaw_compl_Icc_eq_zero` and `sphericalCoordLaw_compl_Icc_eq_zero`),
  the equality of means (both laws are symmetric: `integral_id_coordLaw_eq_zero` and
  `integral_id_sphericalCoordLaw`) and the equality of second moments (`‖v‖²/d = 1/d` when
  `‖v‖ = 1`, by §36's `signAvg_coord_sq` and §4's `integral_sq_sphericalCoordLaw`).

**The hypothesis that is not discharged, and why.**  The one input left standing is the
Kolmogorov-Smirnov bound `η` between the deployed coordinate law and the spherical coordinate
law.  The development does not contain it.  §44's `abs_cdfR_coordLaw_sub_gaussian_le` compares
the coordinate law with a **Gaussian**, `N(0, ‖v‖²/d)`, not with `sphericalCoordLaw d`, and it
does so in the implicit form `|F − Φ| · (1 − 8M/(π√d a)) ≤ …` rather than as a bare sup-norm
bound.  Nothing *here* composes the two legs, and no Kolmogorov-Smirnov bound between
`sphericalCoordLaw d` and that Gaussian exists anywhere in this development, so the sup-norm route
below is not completed at any point.  The route that is completed is the other one: §57 and §58
bound the once-integrated gap `cdfGapInt` for the two legs, and §59 adds them and discharges `hC`
in the `cdfGapInt`-native theorems of this section.  The `η` of the sup-norm statements below
stays a free variable.  Note also that the Gaussian is not compactly supported,
so it does not itself meet the support hypothesis of the bound below.  Accordingly `η` appears as
an explicit hypothesis in every statement of this section, in the `cdfR` form §42 and §44 speak
in, and `cdf_eq_cdfR_coordLaw` and `cdf_eq_cdfR_sphericalCoordLaw` are the only bridge used.

So `abs_hadRate_sub_rhoSq_le` is a **conditional** statement.  It says exactly what a
Kolmogorov-Smirnov bound between the two coordinate laws would buy, namely that the gap between
the deployed per-pass rate of a coordinatewise nearest-codeword stage and the paper's `ρ²` is at
most `2 · η · spread cbk · (b − a) · d`; it does not say that any such `η` is small, and it does
not supply one.  In particular nothing here shows the deployed randomised Hadamard rotation
attains the Haar rate `ρ²`.  The `d` on the right is the one §11c's identity already carries, so
at a fixed `η` the right-hand side grows linearly in `d`; whether it decays at all is a question
about `η`, and no decay of `η` is proved here.  Nothing here is asymptotic, no codebook the paper
ships is named, and `K` is not claimed to be the number of levels of any deployed quantiser. -/

namespace Threshold

open Hadamard Orthogonal CoordLaw

variable {K : ℕ}

/-! ### The bound, for laws given with a closed support

§55's support hypothesis is `ρ (Ioc a b)ᶜ = 0`, half-open on the left; §52 supplies closed
supports.  §55's `compl_Ioc_eq_zero_of_Icc` is the one lemma that converts, and it also widens the
interval on both sides so that the codebook's thresholds and the two laws need not live in exactly
the same interval. -/

/-- **The §55 bound, for two laws with a common closed support.**  Nothing new is proved: the
half-open support is manufactured from the closed one by §55's `compl_Ioc_eq_zero_of_Icc`, and
the conclusion is §55's verbatim.  The interval `[a, b]` that carries the thresholds is only
required to contain `[a', b']` strictly on the left. -/
theorem abs_distortion_sub_distortion_le_of_Icc (cbk : Codebook K) {q : ℝ → ℝ}
    (hq : IsNearest (Set.range cbk.c) q) (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] {a a' b' b η : ℝ} (haa : a < a') (hbb : b' ≤ b)
    (hsupp_mu : μ (Set.Icc a' b')ᶜ = 0) (hsupp_nu : ν (Set.Icc a' b')ᶜ = 0)
    (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b)
    (hmean : ∫ t, t ∂μ = ∫ t, t ∂ν) (hsq : ∫ t, t ^ 2 ∂μ = ∫ t, t ^ 2 ∂ν)
    (hks : ∀ x, |(cdf μ) x - (cdf ν) x| ≤ η) :
    |distortion q μ - distortion q ν| ≤ 2 * η * spread cbk * (b - a) :=
  abs_distortion_sub_distortion_le cbk hq μ ν a b hthr
    (compl_Ioc_eq_zero_of_Icc haa hbb hsupp_mu)
    (compl_Ioc_eq_zero_of_Icc haa hbb hsupp_nu) hmean hsq hks

/-- **The §55 uniform-`cdfGapInt` bound, for two laws with a common closed support.**  Nothing new
is proved: the half-open support is manufactured from the closed one exactly as in
`abs_distortion_sub_distortion_le_of_Icc`, and the conclusion is
`abs_distortion_sub_distortion_le_of_cdfGapInt`'s verbatim, with no `(b − a)` factor. -/
theorem abs_distortion_sub_distortion_le_of_Icc_cdfGapInt (cbk : Codebook K) {q : ℝ → ℝ}
    (hq : IsNearest (Set.range cbk.c) q) (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] {a a' b' b C : ℝ} (haa : a < a') (hbb : b' ≤ b)
    (hsupp_mu : μ (Set.Icc a' b')ᶜ = 0) (hsupp_nu : ν (Set.Icc a' b')ᶜ = 0)
    (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b)
    (hmean : ∫ t, t ∂μ = ∫ t, t ∂ν) (hsq : ∫ t, t ^ 2 ∂μ = ∫ t, t ^ 2 ∂ν)
    (hC : ∀ x, |cdfGapInt μ ν a x| ≤ C) :
    |distortion q μ - distortion q ν| ≤ 2 * C * spread cbk :=
  abs_distortion_sub_distortion_le_of_cdfGapInt cbk hq μ ν a b hthr
    (compl_Ioc_eq_zero_of_Icc haa hbb hsupp_mu)
    (compl_Ioc_eq_zero_of_Icc haa hbb hsupp_nu) hmean hsq hC

/-! ### Mathlib's `cdf` is §42's `cdfR` on both laws

§42 and §44 state their distribution-function bounds in terms of `cdfR`, the `Iic` mass; §55's
bound is stated in terms of Mathlib's `cdf`.  On a probability measure the two agree by
`cdf_eq_real`, and that is the whole bridge. -/

/-- On the deployed coordinate law, Mathlib's `cdf` is §42's `cdfR`. -/
theorem cdf_eq_cdfR_coordLaw {d : ℕ} (H : Od d) (v : Ed d) (i : Fin d) (x : ℝ) :
    (cdf (coordLaw H v i)) x = cdfR (coordLaw H v i) x := cdf_eq_real _ x

/-- On the spherical coordinate law, Mathlib's `cdf` is §42's `cdfR`.  The probability-measure
instance is a theorem in §4b, not an instance, so `2 ≤ d` has to be supplied. -/
theorem cdf_eq_cdfR_sphericalCoordLaw {d : ℕ} (hd : 2 ≤ d) (x : ℝ) :
    (cdf (sphericalCoordLaw d)) x = cdfR (sphericalCoordLaw d) x := by
  haveI := isProbabilityMeasure_sphericalCoordLaw hd
  exact cdf_eq_real _ x

/-! ### The first two moments of the two laws

Equal means and equal second moments are hypotheses of the threshold identity, and for this pair
they are theorems.  Both laws are symmetric, so both means are zero; the second moments are
`‖v‖²/d` and `1/d`, which agree exactly when `‖v‖ = 1`. -/

/-- **The deployed coordinate law has mean zero.**  Flipping every sign negates the coordinate
and preserves the uniform law on the sign cube, which is §40's `signAvg_odd`.  No flatness and no
hypothesis on `d` is used. -/
theorem integral_id_coordLaw_eq_zero {d : ℕ} (H : Od d) (v : Ed d) (i : Fin d) :
    ∫ t, t ∂(coordLaw H v i) = 0 := by
  rw [integral_coordLaw H v i (g := fun t : ℝ => t) measurable_id]
  simp_rw [hadRot_apply_eq_radSum]
  exact signAvg_odd (fun j => (H : Matrix (Fin d) (Fin d) ℝ) i j * v j) (F := fun x : ℝ => x)
    (fun _ => rfl)

/-- **The second moment of the deployed coordinate law is `‖v‖²/d`**, for a flat `H`.  This is
§36's `signAvg_coord_sq` read through `integral_coordLaw`. -/
theorem integral_sq_coordLaw_eq {d : ℕ} {H : Od d} (hH : IsFlat H) (v : Ed d) (i : Fin d) :
    ∫ t, t ^ 2 ∂(coordLaw H v i) = ‖v‖ ^ 2 / d := by
  rw [integral_coordLaw H v i (g := fun t : ℝ => t ^ 2) (measurable_id.pow_const 2)]
  exact signAvg_coord_sq hH v i

/-- **The spherical coordinate law has mean zero**, its density being even.  This is §4's
`sphericalPdf_first_moment` pushed from an interval integral to an integral against the measure,
exactly as `integral_sq_sphericalCoordLaw` does for the second moment. -/
theorem integral_id_sphericalCoordLaw {d : ℕ} (hd : 2 ≤ d) :
    ∫ t, t ∂(sphericalCoordLaw d) = 0 := by
  have hmeas : Measurable (sphericalPdf d) := by
    unfold sphericalPdf
    fun_prop
  have hrestr : (volume : Measure ℝ).restrict (Set.Icc (-1 : ℝ) 1)
      = (volume : Measure ℝ).restrict (Set.Ioc (-1 : ℝ) 1) :=
    (Measure.restrict_congr_set Ioc_ae_eq_Icc).symm
  rw [sphericalCoordLaw,
    integral_withDensity_eq_integral_toReal_smul
      (f := fun t => ENNReal.ofReal (sphericalPdf d t))
      (ENNReal.measurable_ofReal.comp hmeas)
      (Filter.Eventually.of_forall fun _ => ENNReal.ofReal_lt_top)]
  rw [show (∫ t, (ENNReal.ofReal (sphericalPdf d t)).toReal • t
        ∂(volume.restrict (Set.Icc (-1 : ℝ) 1)))
      = ∫ t, t * sphericalPdf d t ∂(volume.restrict (Set.Icc (-1 : ℝ) 1)) from
    setIntegral_congr_fun measurableSet_Icc fun t ht => by
      rw [ENNReal.toReal_ofReal (sphericalPdf_nonneg ht hd), smul_eq_mul, mul_comm]]
  rw [hrestr, ← intervalIntegral.integral_of_le (by norm_num : (-1 : ℝ) ≤ 1)]
  exact sphericalPdf_first_moment hd

/-! ### The conditional bound at the deployed pair -/

/-- **The distortion gap between the deployed coordinate law and the spherical coordinate law,
given a Kolmogorov-Smirnov bound between them.**  For a flat `H`, a **unit** direction `v`, any
nearest-codeword map of an ordered codebook whose thresholds lie in `[a, b]` with
`a < −‖v‖` and `‖v‖ ≤ b`, and any `η` bounding `|cdfR (coordLaw H v i) − cdfR (sphericalCoordLaw d)|`
everywhere,

  `|D(q, coordLaw H v i) − D(q, sphericalCoordLaw d)| ≤ 2 · η · spread cbk · (b − a)`.

Every other hypothesis of §55 is discharged here: both supports, equal means and equal second
moments.  The hypothesis `hks` is **not** supplied by this development; §44 bounds the distance
from the coordinate law to a Gaussian, which is a different pair, so this statement is
conditional on a bound the development does not have.  `‖v‖ = 1` is used twice, for the common
support and to make the two second moments both `1/d`. -/
theorem abs_distortion_coordLaw_sub_sphericalCoordLaw_le {d : ℕ} (hd : 2 ≤ d) {H : Od d}
    (hH : IsFlat H) (v : Ed d) (hv : ‖v‖ = 1) (i : Fin d) (cbk : Codebook K) {q : ℝ → ℝ}
    (hq : IsNearest (Set.range cbk.c) q) {a b η : ℝ} (ha : a < -‖v‖) (hb : ‖v‖ ≤ b)
    (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b)
    (hks : ∀ x, |cdfR (coordLaw H v i) x - cdfR (sphericalCoordLaw d) x| ≤ η) :
    |distortion q (coordLaw H v i) - distortion q (sphericalCoordLaw d)|
      ≤ 2 * η * spread cbk * (b - a) := by
  haveI := isProbabilityMeasure_sphericalCoordLaw hd
  have hsupp_mu : (coordLaw H v i) (Set.Icc (-1 : ℝ) 1)ᶜ = 0 := by
    have h := coordLaw_compl_Icc_eq_zero H v i
    rwa [hv] at h
  have hsupp_nu : (sphericalCoordLaw d) (Set.Icc (-1 : ℝ) 1)ᶜ = 0 :=
    sphericalCoordLaw_compl_Icc_eq_zero d
  have hmean : ∫ t, t ∂(coordLaw H v i) = ∫ t, t ∂(sphericalCoordLaw d) := by
    rw [integral_id_coordLaw_eq_zero H v i, integral_id_sphericalCoordLaw hd]
  have hsq : ∫ t, t ^ 2 ∂(coordLaw H v i) = ∫ t, t ^ 2 ∂(sphericalCoordLaw d) := by
    rw [integral_sq_coordLaw_eq hH v i, integral_sq_sphericalCoordLaw hd, hv]
    norm_num
  have hcdf : ∀ x, |(cdf (coordLaw H v i)) x - (cdf (sphericalCoordLaw d)) x| ≤ η := by
    intro x
    rw [cdf_eq_cdfR_coordLaw H v i x, cdf_eq_cdfR_sphericalCoordLaw hd x]
    exact hks x
  refine abs_distortion_sub_distortion_le_of_Icc cbk hq _ _ ?_ ?_ hsupp_mu hsupp_nu hthr
    hmean hsq hcdf
  · rwa [hv] at ha
  · rwa [hv] at hb

/-- **The distortion gap between the deployed coordinate law and the spherical coordinate law,
given a uniform bound on `cdfGapInt`.**  Same hypotheses as
`abs_distortion_coordLaw_sub_sphericalCoordLaw_le` except that `hks`, a sup-norm bound on
`cdfR (coordLaw H v i) − cdfR (sphericalCoordLaw d)`, is replaced by `hC`, a bound on
`|cdfGapInt (coordLaw H v i) (sphericalCoordLaw d) a x|` uniform in `x`, and the conclusion drops
the `(b − a)` factor:

  `|D(q, coordLaw H v i) − D(q, sphericalCoordLaw d)| ≤ 2 · C · spread cbk`.

Every support and moment hypothesis is discharged exactly as before; only the estimate changes.
`hC` is **not** supplied by this development. -/
theorem abs_distortion_coordLaw_sub_sphericalCoordLaw_le_of_cdfGapInt {d : ℕ} (hd : 2 ≤ d)
    {H : Od d} (hH : IsFlat H) (v : Ed d) (hv : ‖v‖ = 1) (i : Fin d) (cbk : Codebook K)
    {q : ℝ → ℝ} (hq : IsNearest (Set.range cbk.c) q) {a b C : ℝ} (ha : a < -‖v‖) (hb : ‖v‖ ≤ b)
    (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b)
    (hC : ∀ x, |cdfGapInt (coordLaw H v i) (sphericalCoordLaw d) a x| ≤ C) :
    |distortion q (coordLaw H v i) - distortion q (sphericalCoordLaw d)|
      ≤ 2 * C * spread cbk := by
  haveI := isProbabilityMeasure_sphericalCoordLaw hd
  have hsupp_mu : (coordLaw H v i) (Set.Icc (-1 : ℝ) 1)ᶜ = 0 := by
    have h := coordLaw_compl_Icc_eq_zero H v i
    rwa [hv] at h
  have hsupp_nu : (sphericalCoordLaw d) (Set.Icc (-1 : ℝ) 1)ᶜ = 0 :=
    sphericalCoordLaw_compl_Icc_eq_zero d
  have hmean : ∫ t, t ∂(coordLaw H v i) = ∫ t, t ∂(sphericalCoordLaw d) := by
    rw [integral_id_coordLaw_eq_zero H v i, integral_id_sphericalCoordLaw hd]
  have hsq : ∫ t, t ^ 2 ∂(coordLaw H v i) = ∫ t, t ^ 2 ∂(sphericalCoordLaw d) := by
    rw [integral_sq_coordLaw_eq hH v i, integral_sq_sphericalCoordLaw hd, hv]
    norm_num
  refine abs_distortion_sub_distortion_le_of_Icc_cdfGapInt cbk hq _ _ ?_ ?_ hsupp_mu hsupp_nu hthr
    hmean hsq hC
  · rwa [hv] at ha
  · rwa [hv] at hb

/-- **The deployed per-pass rate against `ρ²`, given a Kolmogorov-Smirnov bound.**  §11c's
`ScalarGap.hadRate_sub_rhoSq` makes the gap between the deployed rate of a coordinatewise stage
and `ρ² = d · D(q, sphericalCoordLaw d)` exactly `d` times a scalar distortion gap; the bound
above bounds that gap.  Hence

  `|hadRate H (blockStage q) v − ρ²| ≤ 2 · η · spread cbk · (b − a) · d`.

This is conditional on `hks` exactly as the statement above is, and the development does not
supply `hks`.  The factor `d` is the one §11c's identity already carries, so at a fixed `η` the
right-hand side grows linearly in `d`; no decay of `η` is proved here, and no claim is made that
the deployed rotation attains `ρ²`.  Flatness of `H`, measurability of `q` and `‖v‖ = 1` are all
used. -/
theorem abs_hadRate_sub_rhoSq_le {d : ℕ} (hd : 2 ≤ d) {H : Od d} (hH : IsFlat H) (v : Ed d)
    (hv : ‖v‖ = 1) (i : Fin d) (cbk : Codebook K) {q : ℝ → ℝ}
    (hq : IsNearest (Set.range cbk.c) q) (hqm : Measurable q) {a b η : ℝ} (ha : a < -‖v‖)
    (hb : ‖v‖ ≤ b) (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b)
    (hks : ∀ x, |cdfR (coordLaw H v i) x - cdfR (sphericalCoordLaw d) x| ≤ η) :
    |hadRate H (blockStage (m := d) (F := ℝ) q) v - rhoSq d q (sphericalCoordLaw d)|
      ≤ 2 * η * spread cbk * (b - a) * (d : ℝ) := by
  have hgap := abs_distortion_coordLaw_sub_sphericalCoordLaw_le hd hH v hv i cbk hq ha hb hthr hks
  have hid : distortion q (radLaw d v) = distortion q (coordLaw H v i) := by
    rw [coordLaw_eq_radLaw hH v i]
  have hd0 : (0 : ℝ) ≤ (d : ℝ) := Nat.cast_nonneg d
  rw [ScalarGap.hadRate_sub_rhoSq hH hqm v, hid, abs_mul, abs_of_nonneg hd0]
  calc (d : ℝ) * |distortion q (coordLaw H v i) - distortion q (sphericalCoordLaw d)|
      ≤ (d : ℝ) * (2 * η * spread cbk * (b - a)) := mul_le_mul_of_nonneg_left hgap hd0
    _ = 2 * η * spread cbk * (b - a) * (d : ℝ) := by ring

/-- **The deployed per-pass rate against `ρ²`, given a uniform bound on `cdfGapInt`.**  Same
hypotheses as `abs_hadRate_sub_rhoSq_le` except that `hks`, a sup-norm bound, is replaced by `hC`,
a bound on `|cdfGapInt (coordLaw H v i) (sphericalCoordLaw d) a x|` uniform in `x`.  §11c's
`ScalarGap.hadRate_sub_rhoSq` still supplies the factor `d`, but there is no factor `(b − a)`:

  `|hadRate H (blockStage q) v − ρ²| ≤ 2 · C · spread cbk · d`.

At a fixed `C` the right side still grows linearly in `d` through the explicit factor, but unlike
the `η · (b − a)` shape, a `C` that itself decays like `1/d` makes the whole right side
`Θ(spread cbk)` rather than growing.  `hC` is **not** discharged in this section, and the theorem
is stated conditionally here.  It is discharged in §59, by adding §57's coupling leg
(`sphericalCoordLaw d` against `N(0, 1/d)`) to §58's Fourier leg (`coordLaw H v i` against the
same Gaussian); `Threshold.abs_hadRate_sub_rhoSq_le_unconditional` and
`Threshold.abs_hadRate_sub_rhoSq_le_of_spread` are the results, the second of which is
`Θ(spread cbk)`.  Nothing in this section proves any of that, and even there no claim is made
that the deployed randomised Hadamard rotation attains the Haar rate `ρ²`. -/
theorem abs_hadRate_sub_rhoSq_le_of_cdfGapInt {d : ℕ} (hd : 2 ≤ d) {H : Od d} (hH : IsFlat H)
    (v : Ed d) (hv : ‖v‖ = 1) (i : Fin d) (cbk : Codebook K) {q : ℝ → ℝ}
    (hq : IsNearest (Set.range cbk.c) q) (hqm : Measurable q) {a b C : ℝ} (ha : a < -‖v‖)
    (hb : ‖v‖ ≤ b) (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b)
    (hC : ∀ x, |cdfGapInt (coordLaw H v i) (sphericalCoordLaw d) a x| ≤ C) :
    |hadRate H (blockStage (m := d) (F := ℝ) q) v - rhoSq d q (sphericalCoordLaw d)|
      ≤ 2 * C * spread cbk * (d : ℝ) := by
  have hgap := abs_distortion_coordLaw_sub_sphericalCoordLaw_le_of_cdfGapInt hd hH v hv i cbk hq
    ha hb hthr hC
  have hid : distortion q (radLaw d v) = distortion q (coordLaw H v i) := by
    rw [coordLaw_eq_radLaw hH v i]
  have hd0 : (0 : ℝ) ≤ (d : ℝ) := Nat.cast_nonneg d
  rw [ScalarGap.hadRate_sub_rhoSq hH hqm v, hid, abs_mul, abs_of_nonneg hd0]
  calc (d : ℝ) * |distortion q (coordLaw H v i) - distortion q (sphericalCoordLaw d)|
      ≤ (d : ℝ) * (2 * C * spread cbk) := mul_le_mul_of_nonneg_left hgap hd0
    _ = 2 * C * spread cbk * (d : ℝ) := by ring

/-- The same, for the explicit step quantiser of the codebook: a check that the hypotheses of
`abs_hadRate_sub_rhoSq_le` are met by something, since `stepQuant` is a nearest-codeword map
(§52's `isNearest_stepQuant`) and is measurable (§52's `measurable_stepQuant`).  It is still
conditional on `hks`. -/
theorem abs_hadRate_stepQuant_sub_rhoSq_le {d : ℕ} (hd : 2 ≤ d) {H : Od d} (hH : IsFlat H)
    (v : Ed d) (hv : ‖v‖ = 1) (i : Fin d) (cbk : Codebook K) {a b η : ℝ} (ha : a < -‖v‖)
    (hb : ‖v‖ ≤ b) (hthr : ∀ k : Fin K, thr cbk k ∈ Set.Icc a b)
    (hks : ∀ x, |cdfR (coordLaw H v i) x - cdfR (sphericalCoordLaw d) x| ≤ η) :
    |hadRate H (blockStage (m := d) (F := ℝ) (stepQuant cbk)) v
        - rhoSq d (stepQuant cbk) (sphericalCoordLaw d)|
      ≤ 2 * η * spread cbk * (b - a) * (d : ℝ) :=
  abs_hadRate_sub_rhoSq_le hd hH v hv i cbk (isNearest_stepQuant cbk) (measurable_stepQuant cbk)
    ha hb hthr hks

end Threshold
/-! ## §57  The spherical-versus-Gaussian leg, by coupling rather than by sup-norm

§55 bounds a distortion gap by `2 · η · spread cbk · (b − a)` out of a *sup-norm* bound `η` on
`cdf μ − cdf ν`, and §56 multiplies that by `d`.  That shape cannot be made to decay: any
Kolmogorov-Smirnov `η` between a coordinate law and its limit is `Θ(1/√d)` at best, so the printed
bound grows like `√d`.  The remedy is not a better `η` but a different quantity.  §55's
`abs_sum_fin_weighted_le` only ever needs a uniform bound on the *summands*, and those summands are
values of `cdfGapInt`, the once-integrated CDF difference of §52.  A uniform bound on `cdfGapInt`
is a Wasserstein-1 quantity: it carries no `(b − a)` factor and it obeys a coupling bound.

This section builds the spherical-versus-Gaussian leg in exactly that form.  It contains three
independent blocks.

* **A characteristic-function bridge.**  `gaussianE`, the development's own standard Gaussian on a
  finite-dimensional inner product space, is identified with Mathlib's `stdGaussian`
  (`gaussianE_eq_stdGaussian`) through the Fourier transform of the raw density
  (`integral_cexp_gaussRaw`, `charFun_gaussianE`).  Reading Mathlib's coordinate marginal back
  through that identification gives `gaussianE_map_ofLp`: a coordinate of a Gaussian vector on
  `Ed d` is `N(0,1)`.  This says nothing about how the `gaussianE`s of different ambient dimension
  relate, and nothing about coordinates in a non-orthonormal basis.
* **A support-free coupling bound on `cdfGapInt`.**  `cdfGapInt μ ν a x` is the difference of the
  two laws' expectations of the clamp `t ↦ (x − t)⁺ − (a − t)⁺`
  (`Threshold.cdfGapInt_eq_integral_clamp_sub`), and that clamp is `1`-Lipschitz
  (`Threshold.abs_clamp_sub_clamp_le`), so any coupling of `μ` and `ν` bounds `|cdfGapInt μ ν a x|`
  by its `L¹` cost (`Threshold.abs_cdfGapInt_le_integral_abs_sub_of_coupling`).  Unlike §55's
  estimate this needs no bounded support and no bound on the CDF difference itself; unlike the
  compactly supported variant recorded alongside it, it applies to a Gaussian second law.  It
  names no coupling and asserts nothing about how small the `L¹` cost is.
* **The coupling, and the rate it buys.**  Take `Z ~ gaussianE (Ed d)` and couple
  `u = Z/‖Z‖` with `Z/√d`.  Coordinatewise `u_i − Z_i/√d = u_i · (√d − ‖Z‖)/√d` exactly, so
  Cauchy-Schwarz splits the `L¹` cost into `√(E[u_i²]) · √(E[(√d − ‖Z‖)²])/√d`.  The first factor
  is `1/√d` by Lemma 1 (§4's `integral_sq_sphericalCoordLaw`).  The second is
  `Var(‖Z‖) + (√d − E‖Z‖)²`, and `Var(‖Z‖) ≤ 1` **independently of the dimension** by the Gaussian
  Poincaré inequality of §32/§39 (`variance_norm_gaussianE_le`), which in turn forces
  `E‖Z‖ ≥ √(d − 1)` and hence `(√d − E‖Z‖)² ≤ 1/(4(d − 1))`.  The product is
  `√(1 + 1/(4(d−1)))/d`.

The result is `abs_cdfGapInt_sphericalCoordLaw_gaussian_le`:

  `|cdfGapInt (sphericalCoordLaw d) (N(0, 1/d)) a x| ≤ √(1 + 1/(4(d−1)))/d`

for every `d ≥ 2` and **every** pair `a ≤ x` (and trivially when `x < a`), with no hypothesis
relating `a` and `x` to the supports.

**What this does not do.**  It is one leg only: the pair compared is `sphericalCoordLaw d` against
the Gaussian `N(0, 1/d)`, not against the deployed coordinate law `coordLaw H v i`, and nothing
here composes it with §44's Kolmogorov-Smirnov bound for the other leg.  It is *not* a sup-norm
bound: no `η` bounding `|cdf μ − cdf ν|` is produced, so §55's and §56's statements are not
discharged by it, and in particular `abs_hadRate_sub_rhoSq_le` remains conditional exactly as
before.  Rewiring §55's threshold sum to consume a uniform `cdfGapInt` bound instead of `η·(b−a)`
is not done here.  No asymptotic statement is made, and no claim is made that the constant
`√(1 + 1/(4(d−1)))` is optimal; only that it is dimension-free. -/

section CharacteristicBridge

open Complex
open scoped InnerProductSpace

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

omit [Nontrivial E] in
/-- The raw (unnormalised) Gaussian's Fourier transform: `∫ e^{i⟪x,t⟫} e^{-‖x‖²/2} dx
  = (2π)^{d/2} e^{-‖t‖²/2}`, obtained from Mathlib's Gaussian-Fourier-transform machinery
  (which itself proceeds by factorising the exponential over an orthonormal basis). This does
  NOT assume `gaussianE` is normalised; the constant `(2π)^{d/2}` is exactly the total mass of
  `gaussRaw`. -/
theorem integral_cexp_gaussRaw (t : E) :
    ∫ x : E, Complex.exp ((⟪x, t⟫_ℝ : ℂ) * Complex.I) ∂(gaussRaw E)
      = (2 * (Real.pi : ℂ)) ^ ((Module.finrank ℝ E : ℂ) / 2)
        * Complex.exp (-((‖t‖:ℂ)) ^ 2 / 2) := by
  have hfmeas : AEMeasurable (fun x : E => (Real.exp (-(‖x‖ ^ 2) / 2)).toNNReal) volume := by
    fun_prop
  have hgd : (gaussDensity : E → ℝ≥0∞)
      = fun x => ((fun x : E => (Real.exp (-(‖x‖ ^ 2) / 2)).toNNReal) x : ℝ≥0∞) := by
    funext x; unfold Progressive.gaussDensity; rw [ENNReal.ofReal]
  rw [gaussRaw, hgd, integral_withDensity_eq_integral_smul₀ hfmeas]
  have hpt : ∀ x : E, ((Real.exp (-(‖x‖ ^ 2) / 2)).toNNReal : ℝ≥0)
        • Complex.exp ((⟪x, t⟫_ℝ : ℂ) * Complex.I)
      = Complex.exp (-((‖x‖:ℂ)) ^ 2 / 2) * Complex.exp ((⟪x, t⟫_ℝ : ℂ) * Complex.I) := by
    intro x
    rw [NNReal.smul_def, Real.coe_toNNReal _ (Real.exp_pos _).le,
      Complex.real_smul, Complex.ofReal_exp]
    congr 2
    push_cast
    ring
  simp_rw [hpt]
  have h := GaussianFourier.integral_cexp_neg_mul_sq_norm_add (V := E) (b := (1/2 : ℂ))
    (by norm_num) Complex.I t
  have hcongr : (fun x : E => Complex.exp (-((‖x‖:ℂ)) ^ 2 / 2)
        * Complex.exp ((⟪x, t⟫_ℝ : ℂ) * Complex.I))
      = (fun x : E => Complex.exp (-(1/2 : ℂ) * (‖x‖:ℂ) ^ 2 + Complex.I * (⟪t, x⟫_ℝ : ℂ))) := by
    funext x
    rw [← Complex.exp_add, real_inner_comm x t]
    ring_nf
  rw [hcongr, h]
  congr 1
  · rw [show (Real.pi:ℂ) / (1/2 : ℂ) = 2 * Real.pi by ring]
  · rw [show Complex.I ^ 2 * (‖t‖:ℂ) ^ 2 / (4 * (1/2 : ℂ)) = -((‖t‖:ℂ))^2/2 by
      rw [Complex.I_sq]; ring]

/-- **The characteristic function of `gaussianE`.**  Matches Mathlib's `charFun_stdGaussian`,
obtained by normalising the raw Gaussian Fourier transform `integral_cexp_gaussRaw` at `t = 0`
against `IsProbabilityMeasure (gaussianE E)`; this sidesteps ever computing the normalising
constant `gaussRaw E Set.univ` explicitly. -/
theorem charFun_gaussianE (t : E) :
    charFun (gaussianE E) t = Complex.exp (-((‖t‖:ℂ)) ^ 2 / 2) := by
  set A : ℂ := ((gaussRaw E Set.univ)⁻¹.toReal : ℂ) with hA
  set B : ℂ := (2 * (Real.pi : ℂ)) ^ ((Module.finrank ℝ E : ℂ) / 2) with hB
  have hscale : ∀ s : E, charFun (gaussianE E) s = A * charFun (gaussRaw E) s := by
    intro s
    rw [hA, charFun_apply, charFun_apply, gaussianE, integral_smul_measure, Complex.real_smul]
  have hraw : ∀ s : E, charFun (gaussRaw E) s = B * Complex.exp (-((‖s‖:ℂ))^2/2) := by
    intro s
    rw [charFun_apply, hB, ← integral_cexp_gaussRaw s]
  have h1 : A * B = 1 := by
    have heq := hscale 0
    rw [hraw 0, charFun_zero] at heq
    have huniv : (gaussianE E).real Set.univ = 1 := by
      rw [measureReal_def, measure_univ, ENNReal.toReal_one]
    rw [huniv] at heq
    norm_num at heq
    exact heq.symm
  rw [hscale t, hraw t, ← mul_assoc, h1, one_mul]

/-- **`gaussianE` is Mathlib's `stdGaussian`.**  Both are probability measures on a
finite-dimensional real inner product space with the same characteristic function
`t ↦ exp(-‖t‖²/2)`, so `Measure.ext_of_charFun` identifies them. -/
theorem gaussianE_eq_stdGaussian :
    gaussianE E = ProbabilityTheory.stdGaussian E := by
  apply Measure.ext_of_charFun
  funext t
  rw [charFun_gaussianE, ProbabilityTheory.charFun_stdGaussian]

end

end CharacteristicBridge

noncomputable section CoordinateMarginal

open Orthogonal

/-- The coordinate marginal of Mathlib's `stdGaussian` on `EuclideanSpace` is `gaussianReal 0 1`.
A pure Mathlib computation: the projection is a norm-one continuous linear functional, so
`IsGaussian.map_eq_gaussianReal` applies and `variance_dual_stdGaussian` evaluates the variance. -/
theorem stdGaussian_map_proj {d : ℕ} (i : Fin d) :
    (stdGaussian (EuclideanSpace ℝ (Fin d))).map (EuclideanSpace.proj i) = gaussianReal 0 1 := by
  have hnorm : ‖EuclideanSpace.proj (𝕜 := ℝ) i‖ = 1 := by
    refine le_antisymm (ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun x => ?_) ?_
    · simpa using PiLp.norm_apply_le x i
    · have := (EuclideanSpace.proj (𝕜 := ℝ) i).le_opNorm (EuclideanSpace.single i (1:ℝ))
      simpa using this
  rw [IsGaussian.map_eq_gaussianReal (EuclideanSpace.proj i)]
  congr 1
  · rw [ContinuousLinearMap.integral_comp_id_comm IsGaussian.integrable_id,
      integral_id_stdGaussian]; simp
  · rw [variance_dual_stdGaussian, hnorm]; simp

/-- **A coordinate of a Gaussian vector is `N(0,1)`.**  The coordinate marginal of the
development's own `gaussianE` on `Ed d`, obtained by identifying `gaussianE` with Mathlib's
`stdGaussian` (`gaussianE_eq_stdGaussian`, via characteristic functions) and then reading off
`stdGaussian_map_proj`.  This does NOT show that the `gaussianE`s of different ambient dimension
are compatible under inclusion, nor does it say anything about coordinates in a non-orthonormal
basis. -/
theorem gaussianE_map_ofLp {d : ℕ} (i : Fin d) :
    (gaussianE (Ed d)).map (fun z => z.ofLp i) = gaussianReal 0 1 := by
  haveI : Nontrivial (Ed d) := by
    refine ⟨WithLp.toLp 2 (Pi.single i (1:ℝ)), 0, ?_⟩
    intro h
    have := congrFun (congrArg WithLp.ofLp h) i
    simp at this
  have hfun : (fun z : Ed d => z.ofLp i) = ⇑(EuclideanSpace.proj (𝕜 := ℝ) i) := by
    funext z; rfl
  rw [hfun, gaussianE_eq_stdGaussian, stdGaussian_map_proj]

/-- The law of `Z_i/√d` when `Z_i` is `N(0,1)`: the Gaussian `N(0, 1/d)`.  A rescaling of
Mathlib's `gaussianReal_map_const_mul`, recorded in the `1/√d` spelling the coupling below uses. -/
theorem gaussianReal_map_div_sqrt {d : ℕ} (hd : 2 ≤ d) :
    (gaussianReal 0 1).map (fun t : ℝ => t / Real.sqrt (d : ℝ))
      = gaussianReal 0 (Real.toNNReal (1 / (d : ℝ))) := by
  have hdpos : (0:ℝ) < (d:ℝ) := by exact_mod_cast (by omega : (0:ℕ) < d)
  have hfun : (fun t : ℝ => t / Real.sqrt (d : ℝ)) = ((Real.sqrt (d : ℝ))⁻¹ * ·) := by
    funext t; rw [div_eq_inv_mul]
  rw [hfun, gaussianReal_map_const_mul]
  congr 1
  · simp
  · rw [mul_one]
    ext
    rw [Real.coe_toNNReal _ (by positivity)]
    show ((Real.sqrt (d : ℝ))⁻¹) ^ 2 = 1 / (d : ℝ)
    rw [inv_pow, Real.sq_sqrt hdpos.le, one_div]

end CoordinateMarginal

/-! ### §57a  A coupling bound on `cdfGapInt`, with no support hypothesis

The three lemmas below are about `cdfGapInt` and couplings and nothing else: no codebook, no
quantiser, no distortion appears.  The key identity is that `cdfGapInt μ ν a x` is the difference
of the two laws' expectations of the clamp `t ↦ (x − t)⁺ − (a − t)⁺`.  That clamp is bounded by
`x − a` and is `1`-Lipschitz, so the difference is controlled by the `L¹` cost of any coupling,
with no hypothesis on the supports of `μ` and `ν`. -/

namespace Threshold

/-- The length of `Ioc a x ∩ Ici s`, in closed form: the positive-part difference
`(x − s)⁺ − (a − s)⁺`.  This is the elementary real-number identity underlying the Fubini step
below; it needs `a ≤ x` because otherwise `Ioc a x` is empty while the right side need not be
zero. -/
theorem length_Ioc_inter_Ici {a x : ℝ} (hax : a ≤ x) (s : ℝ) :
    (volume : Measure ℝ).real (Set.Ioc a x ∩ Set.Ici s) = max (x - s) 0 - max (a - s) 0 := by
  rcases lt_or_ge a s with h1 | h1
  · rcases lt_or_ge x s with h2 | h2
    · have he : Set.Ioc a x ∩ Set.Ici s = (∅ : Set ℝ) := by
        ext u
        simp only [Set.mem_inter_iff, Set.mem_Ioc, Set.mem_Ici, Set.mem_empty_iff_false, iff_false]
        rintro ⟨⟨-, hu2⟩, hu3⟩
        linarith
      rw [he, measureReal_empty, max_eq_right (by linarith), max_eq_right (by linarith)]
      ring
    · have he : Set.Ioc a x ∩ Set.Ici s = Set.Icc s x := by
        ext u
        simp only [Set.mem_inter_iff, Set.mem_Ioc, Set.mem_Ici, Set.mem_Icc]
        constructor
        · exact fun h => ⟨h.2, h.1.2⟩
        · intro h; exact ⟨⟨h1.trans_le h.1, h.2⟩, h.1⟩
      rw [he, Real.volume_real_Icc, max_eq_left (by linarith),
        max_eq_right (by linarith)]
      ring
  · have he : Set.Ioc a x ∩ Set.Ici s = Set.Ioc a x := by
      ext u
      simp only [Set.mem_inter_iff, Set.mem_Ioc, Set.mem_Ici]
      constructor
      · exact fun h => h.1
      · intro h; exact ⟨h, h1.trans h.1.le⟩
    rw [he, Real.volume_real_Ioc, max_eq_left (by linarith), max_eq_left (by linarith),
      max_eq_left (by linarith)]
    ring

/-- Fubini step: the integral of the cdf over `(a, x]` equals the `μ`-expectation of the clamp
function `(x − t)⁺ − (a − t)⁺`.  No support hypothesis on `μ` is used; this is a general fact
about any probability law on `ℝ`. -/
theorem cdf_Ioc_integral_eq_integral_diff (μ : Measure ℝ) [IsProbabilityMeasure μ] {a x : ℝ}
    (hax : a ≤ x) :
    (∫ u in Set.Ioc a x, (cdf μ) u) = ∫ t, (max (x - t) 0 - max (a - t) 0) ∂μ := by
  haveI hfin : IsFiniteMeasure ((volume : Measure ℝ).restrict (Set.Ioc a x)) := by
    constructor
    rw [Measure.restrict_apply_univ, Real.volume_Ioc]
    exact ENNReal.ofReal_lt_top
  set F : ℝ → ℝ → ℝ := fun u t => (Set.Iic u).indicator (1 : ℝ → ℝ) t with hF
  have hmeas : Measurable (Function.uncurry F) := by
    have hset : MeasurableSet {p : ℝ × ℝ | p.2 ≤ p.1} :=
      isClosed_le continuous_snd continuous_fst |>.measurableSet
    have heq : Function.uncurry F = Set.indicator {p : ℝ × ℝ | p.2 ≤ p.1} (fun _ => (1 : ℝ)) := by
      funext p
      simp [hF, Function.uncurry, Set.indicator, Set.mem_Iic]
    rw [heq]
    exact measurable_const.indicator hset
  have hInt : Integrable (Function.uncurry F) ((volume.restrict (Set.Ioc a x)).prod μ) := by
    refine (integrable_const (1:ℝ)).mono' hmeas.aestronglyMeasurable ?_
    filter_upwards with p
    rw [Real.norm_eq_abs, hF]
    simp only [Function.uncurry, Set.indicator, Set.mem_Iic]
    split <;> norm_num
  have hswap := integral_integral_swap (μ := (volume.restrict (Set.Ioc a x))) (ν := μ)
    (f := F) hInt
  have hL : ∀ u, ∫ t, F u t ∂μ = (cdf μ) u := by
    intro u
    rw [hF]
    simp only
    rw [integral_indicator_one measurableSet_Iic, ← cdf_eq_real]
  have hR : ∀ t, ∫ u in Set.Ioc a x, F u t ∂volume = max (x - t) 0 - max (a - t) 0 := by
    intro t
    have hswap2 : ∀ u : ℝ, F u t = (Set.Ici t).indicator (1 : ℝ → ℝ) u := by
      intro u
      rw [hF]
      simp only [Set.indicator, Set.mem_Iic, Set.mem_Ici]
      congr 1
    simp_rw [hswap2]
    rw [setIntegral_indicator measurableSet_Ici]
    simp only [Pi.one_apply, setIntegral_const, smul_eq_mul, mul_one]
    rw [length_Ioc_inter_Ici hax]
  simp only [hL] at hswap
  simp only [hR] at hswap
  exact hswap

/-- With `μ` supported on `[a, ∞)`, the integral of its cdf over `(a, x]` is the `μ`-expectation
of the positive part `(x − t)⁺`, with no boundary term at `a`.  Only the compactly supported leg
uses this; the Gaussian leg below cannot. -/
theorem integral_cdf_Ioc_eq_integral_posPart (μ : Measure ℝ) [IsProbabilityMeasure μ] {a x : ℝ}
    (hax : a ≤ x) (hsupp : μ (Set.Iio a) = 0) :
    (∫ u in Set.Ioc a x, (cdf μ) u) = ∫ t, max (x - t) 0 ∂μ := by
  rw [cdf_Ioc_integral_eq_integral_diff μ hax]
  have hae : ∀ᵐ t ∂μ, a ≤ t := by
    rw [ae_iff]
    have : {t : ℝ | ¬ a ≤ t} = Set.Iio a := by ext y; simp
    rw [this]; exact hsupp
  refine integral_congr_ae ?_
  filter_upwards [hae] with t ht
  rw [max_eq_right (by linarith : a - t ≤ 0), sub_zero]

/-- **The clamp form of `cdfGapInt`.**  For `a ≤ x` and any two probability laws,
`cdfGapInt μ ν a x` is the difference of their expectations of the clamp
`t ↦ (x − t)⁺ − (a − t)⁺`.  No hypothesis is placed on the supports, which is what lets the
Gaussian leg below use it. -/
theorem cdfGapInt_eq_integral_clamp_sub (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] {a x : ℝ} (hax : a ≤ x) :
    cdfGapInt μ ν a x = (∫ t, (max (x - t) 0 - max (a - t) 0) ∂μ)
      - ∫ t, (max (x - t) 0 - max (a - t) 0) ∂ν := by
  rw [cdfGapInt_eq_sub, cdf_Ioc_integral_eq_integral_diff μ hax,
    cdf_Ioc_integral_eq_integral_diff ν hax]

/-- The same identity, for laws that put no mass below `a`: the boundary term drops and the clamp
becomes the bare positive part `(x − t)⁺`. -/
theorem cdfGapInt_eq_integral_posPart_sub (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] {a x : ℝ} (hax : a ≤ x) (hsupp_mu : μ (Set.Iio a) = 0)
    (hsupp_nu : ν (Set.Iio a) = 0) :
    cdfGapInt μ ν a x = (∫ t, max (x - t) 0 ∂μ) - ∫ t, max (x - t) 0 ∂ν := by
  rw [cdfGapInt_eq_sub, integral_cdf_Ioc_eq_integral_posPart μ hax hsupp_mu,
    integral_cdf_Ioc_eq_integral_posPart ν hax hsupp_nu]

/-- The clamp is `1`-Lipschitz.  Both `(x − ·)⁺` and `(a − ·)⁺` are nonincreasing and
`1`-Lipschitz, so their difference moves by at most `|s − t|` even though a naive triangle
inequality would give `2|s − t|`.  No relation between `a` and `x` is needed. -/
theorem abs_clamp_sub_clamp_le (a x : ℝ) (s t : ℝ) :
    |(max (x - s) 0 - max (a - s) 0) - (max (x - t) 0 - max (a - t) 0)| ≤ |s - t| := by
  have key : ∀ u v : ℝ, u ≤ v →
      |(max (x - u) 0 - max (a - u) 0) - (max (x - v) 0 - max (a - v) 0)| ≤ |u - v| := by
    intro u v huv
    have h1 : 0 ≤ max (x - u) 0 - max (x - v) 0 ∧ max (x - u) 0 - max (x - v) 0 ≤ v - u := by
      simp only [max_def]; split_ifs <;> constructor <;> linarith
    have h2 : 0 ≤ max (a - u) 0 - max (a - v) 0 ∧ max (a - u) 0 - max (a - v) 0 ≤ v - u := by
      simp only [max_def]; split_ifs <;> constructor <;> linarith
    rw [abs_sub_comm u v, abs_of_nonneg (by linarith : (0:ℝ) ≤ v - u), abs_le]
    constructor <;> linarith [h1.1, h1.2, h2.1, h2.2]
  rcases le_total s t with h | h
  · exact key s t h
  · rw [abs_sub_comm ((max (x - s) 0 - max (a - s) 0)), abs_sub_comm s t]; exact key t s h

/-- The clamp is bounded by `x − a`, which makes it integrable against any probability law. -/
theorem abs_clamp_le {a x : ℝ} (hax : a ≤ x) (t : ℝ) :
    |max (x - t) 0 - max (a - t) 0| ≤ x - a := by
  rw [abs_le]; simp only [max_def]; split_ifs <;> constructor <;> linarith

/-- **The coupling bound on `cdfGapInt`.**  If `X, Y : Ω → ℝ` are integrable random variables on
a common probability space with laws `μ, ν`, then `|cdfGapInt μ ν a x|` is at most the `L¹` cost
`E|X − Y|` of the coupling, for every `a ≤ x`.  No support hypothesis: `μ` and `ν` may both have
full support, which is what §55's sup-norm route could not accommodate.  Nothing here asserts a
particular coupling is good; it says what any coupling buys. -/
theorem abs_cdfGapInt_le_integral_abs_sub_of_coupling
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {X Y : Ω → ℝ} (hX : AEMeasurable X P) (hY : AEMeasurable Y P)
    (hIntX : Integrable X P) (hIntY : Integrable Y P)
    {μ ν : Measure ℝ} [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (hXeq : Measure.map X P = μ) (hYeq : Measure.map Y P = ν)
    {a x : ℝ} (hax : a ≤ x) :
    |cdfGapInt μ ν a x| ≤ ∫ ω, |X ω - Y ω| ∂P := by
  set g : ℝ → ℝ := fun t => max (x - t) 0 - max (a - t) 0 with hg
  have hgc : Continuous g := by fun_prop
  rw [cdfGapInt_eq_integral_clamp_sub μ ν hax]
  have hMX : (∫ t, g t ∂μ) = ∫ ω, g (X ω) ∂P := by
    rw [← hXeq]; exact integral_map hX hgc.aestronglyMeasurable
  have hMY : (∫ t, g t ∂ν) = ∫ ω, g (Y ω) ∂P := by
    rw [← hYeq]; exact integral_map hY hgc.aestronglyMeasurable
  rw [hMX, hMY]
  have hmX : AEMeasurable (fun ω => g (X ω)) P := hgc.measurable.comp_aemeasurable hX
  have hmY : AEMeasurable (fun ω => g (Y ω)) P := hgc.measurable.comp_aemeasurable hY
  have hIX : Integrable (fun ω => g (X ω)) P := by
    refine (integrable_const (x - a)).mono' hmX.aestronglyMeasurable ?_
    filter_upwards with ω
    rw [Real.norm_eq_abs]
    exact abs_clamp_le hax _
  have hIY : Integrable (fun ω => g (Y ω)) P := by
    refine (integrable_const (x - a)).mono' hmY.aestronglyMeasurable ?_
    filter_upwards with ω
    rw [Real.norm_eq_abs]
    exact abs_clamp_le hax _
  rw [← integral_sub hIX hIY]
  calc |∫ ω, (g (X ω) - g (Y ω)) ∂P|
      ≤ ∫ ω, |g (X ω) - g (Y ω)| ∂P := abs_integral_le_integral_abs
    _ ≤ ∫ ω, |X ω - Y ω| ∂P := by
        refine integral_mono_ae (hIX.sub hIY).abs ((hIntX.sub hIntY).abs) ?_
        filter_upwards with ω
        exact abs_clamp_sub_clamp_le a x (X ω) (Y ω)

end Threshold

/-! ### §57b  The radius of a Gaussian vector

`Var(‖Z‖) ≤ 1` with a constant independent of the dimension is the one nontrivial input, and it is
a two-line consequence of the Gaussian Poincaré inequality §32/§39 already proves.  Everything else
here is bookkeeping around `E‖Z‖² = d`. -/

noncomputable section GaussianRadius

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]
  [BorelSpace E] [FiniteDimensional ℝ E] [Nontrivial E]

/-- `‖Z‖` is integrable, from `‖x‖ ≤ 1 + ‖x‖²` and `integrable_normSq_gaussianE` (§39). -/
theorem integrable_norm_gaussianE : Integrable (fun x : E => ‖x‖) (gaussianE E) := by
  refine ((integrable_const (1:ℝ)).add (integrable_normSq_gaussianE (E := E))).mono'
    (by fun_prop) ?_
  filter_upwards with x
  simp only [Pi.add_apply]
  rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg x)]
  nlinarith [norm_nonneg x, sq_nonneg (‖x‖ - 1)]

/-- **`Var(‖Z‖) ≤ 1`** for the standard Gaussian on any space of dimension at least two, with
constant `1` independent of the dimension. From the Gaussian Poincaré inequality
(`gaussPoincare_gaussianE`, §39) applied to `f = ‖·‖` with the constant slope bound `G = 1/2`:
`|‖x‖ − ‖y‖| ≤ ‖x − y‖ = ‖x − y‖·(1/2 + 1/2)` is a valid two-point bound, so
`Var(‖·‖) ≤ ∫ (2·(1/2))² = 1`.  Does not bound `Var(‖Z‖²)`, and gives no matching lower bound on
the variance itself. -/
theorem variance_norm_gaussianE_le (hd : 2 ≤ Module.finrank ℝ E) :
    ProbabilityTheory.variance (fun x : E => ‖x‖) (gaussianE E) ≤ 1 := by
  have hGP := gaussPoincare_gaussianE (E := E)
  have hf : MemLp (fun x : E => ‖x‖) 2 (gaussianE E) := by
    rw [memLp_two_iff_integrable_sq (by fun_prop)]
    simpa using integrable_normSq_gaussianE (E := E)
  have hint : Integrable (fun _ : E => ((1:ℝ)/2) ^ 2) (gaussianE E) := integrable_const _
  have hbound := hGP.bound hd (fun x : E => ‖x‖) (fun _ => (1:ℝ)/2)
    (continuousOn_const) (fun x y _ _ => by
      have h1 := abs_norm_sub_norm_le x y
      calc |‖x‖ - ‖y‖| ≤ ‖x - y‖ := h1
        _ = ‖x - y‖ * (1/2 + 1/2) := by ring) hf hint
  have heq : (∫ _x : E, (2 * ((1:ℝ)/2)) ^ 2 ∂(gaussianE E)) = 1 := by simp
  linarith [hbound, heq]

/-- **`E‖Z‖ ≥ √(d − 1)`**, from `(E‖Z‖)² = E‖Z‖² − Var(‖Z‖) = d − Var(‖Z‖) ≥ d − 1`
(`variance_norm_gaussianE_le`, `integral_normSq_gaussianE`) and `E‖Z‖ ≥ 0`.  Gives no matching
upper bound on `E‖Z‖`; that direction is not needed by the coupling argument this feeds. -/
theorem le_integral_norm_gaussianE (hd : 2 ≤ Module.finrank ℝ E) :
    Real.sqrt ((Module.finrank ℝ E : ℝ) - 1) ≤ ∫ x, ‖x‖ ∂(gaussianE E) := by
  have hf : MemLp (fun x : E => ‖x‖) 2 (gaussianE E) := by
    rw [memLp_two_iff_integrable_sq (by fun_prop)]
    simpa using integrable_normSq_gaussianE (E := E)
  have hvar := variance_norm_gaussianE_le hd
  have hveq := ProbabilityTheory.variance_eq_sub hf
  simp only [Pi.pow_apply] at hveq
  rw [integral_normSq_gaussianE] at hveq
  have hnn : 0 ≤ ∫ x, ‖x‖ ∂(gaussianE E) := integral_nonneg (fun x => norm_nonneg _)
  have hkey : (Module.finrank ℝ E : ℝ) - 1 ≤ (∫ x, ‖x‖ ∂(gaussianE E)) ^ 2 := by linarith
  calc Real.sqrt ((Module.finrank ℝ E : ℝ) - 1)
      ≤ Real.sqrt ((∫ x, ‖x‖ ∂(gaussianE E)) ^ 2) := Real.sqrt_le_sqrt hkey
    _ = ∫ x, ‖x‖ ∂(gaussianE E) := Real.sqrt_sq hnn

/-- `c − ‖Z‖` is square-integrable, so Cauchy-Schwarz may be applied to it. -/
theorem memLp_two_const_sub_norm (c : ℝ) : MemLp (fun x : E => c - ‖x‖) 2 (gaussianE E) := by
  rw [memLp_two_iff_integrable_sq (by fun_prop)]
  have hIn : Integrable (fun x : E => ‖x‖) (gaussianE E) := integrable_norm_gaussianE
  have h : Integrable (fun x : E => (c ^ 2 - 2 * c * ‖x‖) + ‖x‖ ^ 2) (gaussianE E) :=
    ((integrable_const (c ^ 2)).sub (hIn.const_mul (2 * c))).add
      (integrable_normSq_gaussianE (E := E))
  exact h.congr (Filter.Eventually.of_forall fun x => by ring)

/-- `E[(c − ‖Z‖)²] = c² − 2c·E‖Z‖ + d`: expanding the square and using `E‖Z‖² = d` (§39). -/
theorem integral_sq_const_sub_norm (c : ℝ) :
    ∫ x : E, (c - ‖x‖) ^ 2 ∂(gaussianE E)
      = c ^ 2 - 2 * c * (∫ x : E, ‖x‖ ∂(gaussianE E)) + (Module.finrank ℝ E : ℝ) := by
  have hIn : Integrable (fun x : E => ‖x‖) (gaussianE E) := integrable_norm_gaussianE
  have h1 : ∫ x : E, (c - ‖x‖) ^ 2 ∂(gaussianE E)
      = ∫ x : E, ((c ^ 2 - 2 * c * ‖x‖) + ‖x‖ ^ 2) ∂(gaussianE E) :=
    integral_congr_ae (Filter.Eventually.of_forall fun x => by ring)
  have h2 : ∫ x : E, ((c ^ 2 - 2 * c * ‖x‖) + ‖x‖ ^ 2) ∂(gaussianE E)
      = (∫ x : E, (c ^ 2 - 2 * c * ‖x‖) ∂(gaussianE E)) + ∫ x : E, ‖x‖ ^ 2 ∂(gaussianE E) :=
    integral_add ((integrable_const (c ^ 2)).sub (hIn.const_mul (2 * c)))
      (integrable_normSq_gaussianE (E := E))
  have h3 : ∫ x : E, (c ^ 2 - 2 * c * ‖x‖) ∂(gaussianE E)
      = (∫ _x : E, c ^ 2 ∂(gaussianE E)) - ∫ x : E, (2 * c * ‖x‖) ∂(gaussianE E) :=
    integral_sub (integrable_const (c ^ 2)) (hIn.const_mul (2 * c))
  rw [h1, h2, h3, integral_const_mul, integral_const, integral_normSq_gaussianE,
    measureReal_def, measure_univ, ENNReal.toReal_one, one_smul]

/-- The arithmetic behind the radius estimate, isolated from any measure theory: if `m` is a
number with `m² ≤ n`, `n − m² ≤ 1` and `√(n − 1) ≤ m`, then `2n − 2√n·m ≤ 1 + 1/(4(n−1))`.  The
two summands are `n − m²` (the variance, bounded by `1`) and `(√n − m)²`, and the latter is at
most `(√n − √(n−1))² = 1/(√n + √(n−1))² ≤ 1/(4(n−1))`. -/
theorem two_mul_sub_two_mul_sqrt_mul_le {n m : ℝ} (hn2 : 2 ≤ n) (hm0 : 0 ≤ m) (hvnn : m ^ 2 ≤ n)
    (hvar : n - m ^ 2 ≤ 1) (hmr : Real.sqrt (n - 1) ≤ m) :
    2 * n - 2 * Real.sqrt n * m ≤ 1 + 1 / (4 * (n - 1)) := by
  have hs2 : Real.sqrt n ^ 2 = n := Real.sq_sqrt (by linarith)
  have hr2 : Real.sqrt (n - 1) ^ 2 = n - 1 := Real.sq_sqrt (by linarith)
  have hr0 : 0 ≤ Real.sqrt (n - 1) := Real.sqrt_nonneg _
  have hs0 : 0 ≤ Real.sqrt n := Real.sqrt_nonneg _
  have hr1 : 1 ≤ Real.sqrt (n - 1) := by nlinarith
  have hrs : Real.sqrt (n - 1) ≤ Real.sqrt n := Real.sqrt_le_sqrt (by linarith)
  have hms : m ≤ Real.sqrt n := by nlinarith
  have hsm : 0 ≤ Real.sqrt n - m := by linarith
  have hkey : 2 * Real.sqrt (n - 1) * (Real.sqrt n - m) ≤ 1 := by nlinarith
  have hknn : 0 ≤ 2 * Real.sqrt (n - 1) * (Real.sqrt n - m) := by positivity
  have hsq : (Real.sqrt n - m) ^ 2 * (4 * (n - 1)) ≤ 1 := by nlinarith
  have hpos : (0:ℝ) < 4 * (n - 1) := by linarith
  have hdiv : (Real.sqrt n - m) ^ 2 ≤ 1 / (4 * (n - 1)) := by
    rw [le_div_iff₀ hpos]; exact hsq
  nlinarith [hdiv, hvar, hs2]

/-- **`E[(√d − ‖Z‖)²] ≤ 1 + 1/(4(d−1))`.**  The decomposition
`E[(√d − ‖Z‖)²] = Var(‖Z‖) + (√d − E‖Z‖)²`, with `Var(‖Z‖) ≤ 1` dimension-free
(`variance_norm_gaussianE_le`) and `√(d−1) ≤ E‖Z‖ ≤ √d` (`le_integral_norm_gaussianE` and
`E‖Z‖² = d`).  The bound tends to `1`, not to `0`: the radius does not concentrate at scale
better than `O(1)`, and nothing here claims it does. -/
theorem integral_sq_sqrt_finrank_sub_norm_le (hd : 2 ≤ Module.finrank ℝ E) :
    ∫ x : E, (Real.sqrt (Module.finrank ℝ E : ℝ) - ‖x‖) ^ 2 ∂(gaussianE E)
      ≤ 1 + 1 / (4 * ((Module.finrank ℝ E : ℝ) - 1)) := by
  have hn2 : (2:ℝ) ≤ (Module.finrank ℝ E : ℝ) := by exact_mod_cast hd
  have hf : MemLp (fun x : E => ‖x‖) 2 (gaussianE E) := by
    rw [memLp_two_iff_integrable_sq (by fun_prop)]
    simpa using integrable_normSq_gaussianE (E := E)
  have hveq := ProbabilityTheory.variance_eq_sub hf
  simp only [Pi.pow_apply] at hveq
  rw [integral_normSq_gaussianE] at hveq
  have hvar := variance_norm_gaussianE_le (E := E) hd
  have hvnn := ProbabilityTheory.variance_nonneg (fun x : E => ‖x‖) (gaussianE E)
  have hm0 : 0 ≤ ∫ x : E, ‖x‖ ∂(gaussianE E) := integral_nonneg fun x => norm_nonneg _
  have hmr := le_integral_norm_gaussianE (E := E) hd
  rw [integral_sq_const_sub_norm, Real.sq_sqrt (by linarith)]
  have := two_mul_sub_two_mul_sqrt_mul_le (n := (Module.finrank ℝ E : ℝ))
    (m := ∫ x : E, ‖x‖ ∂(gaussianE E)) hn2 hm0 (by linarith) (by linarith) hmr
  linarith

end GaussianRadius

/-! ### §57c  The coupling, and the leg it proves

`u = Z/‖Z‖` for `Z ~ gaussianE (Ed d)` is uniform on the sphere (§26's `gaussianE_map_dir`), so
`u_i` has law `sphericalCoordLaw d` (§26's `gaussianE_map_dir_coord`); and `Z_i/√d` has law
`N(0, 1/d)` (`gaussianE_map_ofLp` and `gaussianReal_map_div_sqrt` above).  That pair is the
coupling.  Its `L¹` cost is estimated by Cauchy-Schwarz and §57b, and §57a turns the cost into a
bound on `cdfGapInt`. -/

noncomputable section CouplingLeg

open Orthogonal

/-- Cauchy-Schwarz for the integral, in the `Real.sqrt` spelling: Mathlib's Hölder inequality
`integral_mul_le_Lp_mul_Lq_of_nonneg` at the conjugate pair `(2, 2)`, with the `rpow`s converted
to squares and square roots. -/
theorem integral_abs_mul_le_sqrt_mul_sqrt {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    {f g : Ω → ℝ} (hf : MemLp f 2 P) (hg : MemLp g 2 P) :
    ∫ ω, |f ω| * |g ω| ∂P
      ≤ Real.sqrt (∫ ω, f ω ^ 2 ∂P) * Real.sqrt (∫ ω, g ω ^ 2 ∂P) := by
  have h2 : ENNReal.ofReal (2:ℝ) = 2 := by
    rw [show (2:ℝ) = ((2:ℕ):ℝ) by norm_num, ENNReal.ofReal_natCast]; rfl
  have hf' : MemLp (fun ω => |f ω|) (ENNReal.ofReal (2:ℝ)) P := by rw [h2]; exact hf.abs
  have hg' : MemLp (fun ω => |g ω|) (ENNReal.ofReal (2:ℝ)) P := by rw [h2]; exact hg.abs
  have hCS := integral_mul_le_Lp_mul_Lq_of_nonneg (μ := P) (p := 2) (q := 2)
    Real.HolderConjugate.two_two (f := fun ω => |f ω|) (g := fun ω => |g ω|)
    (Filter.Eventually.of_forall fun ω => abs_nonneg _)
    (Filter.Eventually.of_forall fun ω => abs_nonneg _) hf' hg'
  simp only [Real.rpow_two, sq_abs] at hCS
  rwa [← Real.sqrt_eq_rpow, ← Real.sqrt_eq_rpow] at hCS

/-- `Ed d` is nontrivial as soon as it has a coordinate; §26's `measurable_dir` and §30's
`norm_dir_le_one` are stated on a nontrivial space, so this is the instance they need. -/
theorem nontrivial_Ed {d : ℕ} (i : Fin d) : Nontrivial (Ed d) :=
  Module.nontrivial_of_finrank_pos (R := ℝ) (by simpa [Ed] using i.pos)

/-- A coordinate of the direction of a Gaussian vector is bounded by `1`. -/
theorem abs_dir_coord_le_one {d : ℕ} (i : Fin d) (z : Ed d) : |(dir z).ofLp i| ≤ 1 := by
  haveI := nontrivial_Ed i
  exact le_trans (by simpa using PiLp.norm_apply_le (dir z) i) (norm_dir_le_one z)

/-- A coordinate of the direction of a Gaussian vector is measurable. -/
theorem measurable_dir_coord {d : ℕ} (i : Fin d) :
    Measurable (fun z : Ed d => (dir z).ofLp i) := by
  haveI := nontrivial_Ed i
  exact ((measurable_pi_apply i).comp (WithLp.measurable_ofLp 2 _)).comp measurable_dir

/-- `E[u_i²] = 1/d` for `u = Z/‖Z‖`: the pushforward of `gaussianE (Ed d)` along
`z ↦ (dir z)_i` is `sphericalCoordLaw d` (§26), whose second moment is `1/d` (§4). -/
theorem integral_sq_dir_coord {d : ℕ} (hd : 2 ≤ d) (i : Fin d) :
    ∫ z, ((dir z).ofLp i) ^ 2 ∂(gaussianE (Ed d)) = 1 / (d : ℝ) := by
  haveI : Nontrivial (Ed d) := Module.nontrivial_of_finrank_pos (R := ℝ) (by
    have : (0 : ℕ) < d := by omega
    simpa [Ed] using this)
  rw [← integral_sq_sphericalCoordLaw hd, ← gaussianE_map_dir_coord hd i,
    integral_map (measurable_dir_coord i).aemeasurable (by fun_prop)]

/-- **The `L¹` cost of the coupling.**  `E|u_i − Z_i/√d| ≤ √(1 + 1/(4(d−1)))/d`.  The
coordinatewise identity `u_i − Z_i/√d = u_i·(√d − ‖Z‖)/√d` is exact (both sides vanish at
`Z = 0`), Cauchy-Schwarz splits the expectation, `E[u_i²] = 1/d` by Lemma 1 and
`E[(√d − ‖Z‖)²] ≤ 1 + 1/(4(d−1))` by §57b.  The rate is `Θ(1/d)`, not `Θ(1/√d)`: the gain over
the crude bound `|Z_i| ≤ ‖Z‖` is exactly the factor `√(E[u_i²]) = 1/√d`.  This is an `L¹`
statement about one coupling; it is not a bound on the Kolmogorov-Smirnov distance of the two
laws, and no such bound follows from it. -/
theorem integral_abs_dir_coord_sub_coord_div_sqrt_le {d : ℕ} (hd : 2 ≤ d) (i : Fin d) :
    ∫ z, |(dir z).ofLp i - z.ofLp i / Real.sqrt (d : ℝ)| ∂(gaussianE (Ed d))
      ≤ Real.sqrt (1 + 1 / (4 * ((d : ℝ) - 1))) / (d : ℝ) := by
  haveI : Nontrivial (Ed d) := Module.nontrivial_of_finrank_pos (R := ℝ) (by
    have : (0 : ℕ) < d := by omega
    simpa [Ed] using this)
  have hdn : Module.finrank ℝ (Ed d) = d := by simp [Ed]
  have hd0 : (0:ℝ) < (d:ℝ) := by exact_mod_cast (by omega : (0:ℕ) < d)
  have hdR : (2:ℝ) ≤ (d:ℝ) := by exact_mod_cast hd
  have hs : (0:ℝ) < Real.sqrt (d:ℝ) := Real.sqrt_pos.mpr hd0
  have hmf : Measurable (fun z : Ed d => (dir z).ofLp i) := measurable_dir_coord i
  -- the pointwise factorisation of the coupling error
  have hpt : ∀ z : Ed d, |(dir z).ofLp i - z.ofLp i / Real.sqrt (d:ℝ)|
      = (Real.sqrt (d:ℝ))⁻¹ * (|(dir z).ofLp i| * |Real.sqrt (d:ℝ) - ‖z‖|) := by
    intro z
    have hfac : (dir z).ofLp i - z.ofLp i / Real.sqrt (d:ℝ)
        = (Real.sqrt (d:ℝ))⁻¹ * ((dir z).ofLp i * (Real.sqrt (d:ℝ) - ‖z‖)) := by
      rcases eq_or_ne z 0 with h | h
      · subst h; simp [dir]
      · have hz : ‖z‖ ≠ 0 := norm_ne_zero_iff.mpr h
        show ‖z‖⁻¹ * z.ofLp i - z.ofLp i / Real.sqrt (d:ℝ)
          = (Real.sqrt (d:ℝ))⁻¹ * (‖z‖⁻¹ * z.ofLp i * (Real.sqrt (d:ℝ) - ‖z‖))
        field_simp
    rw [hfac, abs_mul, abs_mul, abs_of_nonneg (by positivity : (0:ℝ) ≤ (Real.sqrt (d:ℝ))⁻¹)]
  -- square-integrability of the two factors
  have hMf : MemLp (fun z : Ed d => (dir z).ofLp i) 2 (gaussianE (Ed d)) := by
    rw [memLp_two_iff_integrable_sq hmf.aestronglyMeasurable]
    refine (integrable_const (1:ℝ)).mono' (hmf.pow_const 2).aestronglyMeasurable ?_
    filter_upwards with z
    rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _), ← sq_abs]
    nlinarith [abs_dir_coord_le_one i z, abs_nonneg ((dir z).ofLp i)]
  have hMg : MemLp (fun z : Ed d => Real.sqrt (d:ℝ) - ‖z‖) 2 (gaussianE (Ed d)) :=
    memLp_two_const_sub_norm _
  -- the two second moments
  have hA : ∫ z, ((dir z).ofLp i) ^ 2 ∂(gaussianE (Ed d)) = 1 / (d : ℝ) :=
    integral_sq_dir_coord hd i
  have hB : ∫ z : Ed d, (Real.sqrt (d:ℝ) - ‖z‖) ^ 2 ∂(gaussianE (Ed d))
      ≤ 1 + 1 / (4 * ((d : ℝ) - 1)) := by
    have h := integral_sq_sqrt_finrank_sub_norm_le (E := Ed d) (by rw [hdn]; exact hd)
    rwa [hdn] at h
  have hsqrtA : Real.sqrt (1 / (d:ℝ)) = (Real.sqrt (d:ℝ))⁻¹ := by
    rw [one_div, Real.sqrt_inv]
  have hBnn : (0:ℝ) ≤ ∫ z : Ed d, (Real.sqrt (d:ℝ) - ‖z‖) ^ 2 ∂(gaussianE (Ed d)) :=
    integral_nonneg fun z => sq_nonneg _
  calc ∫ z, |(dir z).ofLp i - z.ofLp i / Real.sqrt (d:ℝ)| ∂(gaussianE (Ed d))
      = ∫ z, (Real.sqrt (d:ℝ))⁻¹
          * (|(dir z).ofLp i| * |Real.sqrt (d:ℝ) - ‖z‖|) ∂(gaussianE (Ed d)) :=
        integral_congr_ae (Filter.Eventually.of_forall hpt)
    _ = (Real.sqrt (d:ℝ))⁻¹
          * ∫ z, |(dir z).ofLp i| * |Real.sqrt (d:ℝ) - ‖z‖| ∂(gaussianE (Ed d)) :=
        integral_const_mul _ _
    _ ≤ (Real.sqrt (d:ℝ))⁻¹
          * (Real.sqrt (∫ z, ((dir z).ofLp i) ^ 2 ∂(gaussianE (Ed d)))
            * Real.sqrt (∫ z : Ed d, (Real.sqrt (d:ℝ) - ‖z‖) ^ 2 ∂(gaussianE (Ed d)))) := by
        refine mul_le_mul_of_nonneg_left ?_ (by positivity)
        exact integral_abs_mul_le_sqrt_mul_sqrt _ hMf hMg
    _ ≤ (Real.sqrt (d:ℝ))⁻¹
          * ((Real.sqrt (d:ℝ))⁻¹ * Real.sqrt (1 + 1 / (4 * ((d : ℝ) - 1)))) := by
        refine mul_le_mul_of_nonneg_left ?_ (by positivity)
        rw [hA, hsqrtA]
        exact mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt hB) (by positivity)
    _ = Real.sqrt (1 + 1 / (4 * ((d : ℝ) - 1))) / (d : ℝ) := by
        rw [← mul_assoc, ← mul_inv, Real.mul_self_sqrt hd0.le, inv_mul_eq_div]

/-- **The spherical-versus-Gaussian leg, in `cdfGapInt` form.**  For every `d ≥ 2` and every pair
`a, x` of reals,

  `|cdfGapInt (sphericalCoordLaw d) (N(0, 1/d)) a x| ≤ √(1 + 1/(4(d−1)))/d`.

The coupling is `u = Z/‖Z‖` against `Z/√d` for a single Gaussian vector `Z ~ gaussianE (Ed d)`;
§57a converts its `L¹` cost into this bound, and §57c estimates the cost.  The bound is uniform in
`a` and `x`, is `Θ(1/d)` in the dimension, and needs no support hypothesis on either law.

What it is **not**.  It is not a Kolmogorov-Smirnov bound: `|cdf μ − cdf ν|` is not bounded here,
and no `η` for §55 or §56 is produced, so `Threshold.abs_hadRate_sub_rhoSq_le` stays exactly as
conditional as it was.  It is one of the two legs the triangle inequality would need: the other
leg, `coordLaw H v i` against the same Gaussian, is §44's business and is not composed with this
one anywhere.  Rewiring §55's threshold sum so that it consumes a uniform `cdfGapInt` bound rather
than `η·(b − a)` is not carried out here, so nothing downstream is improved yet. -/
theorem abs_cdfGapInt_sphericalCoordLaw_gaussian_le {d : ℕ} (hd : 2 ≤ d) (a x : ℝ) :
    |Threshold.cdfGapInt (sphericalCoordLaw d)
        (gaussianReal 0 (Real.toNNReal (1 / (d : ℝ)))) a x|
      ≤ Real.sqrt (1 + 1 / (4 * ((d : ℝ) - 1))) / (d : ℝ) := by
  haveI := isProbabilityMeasure_sphericalCoordLaw hd
  haveI : Nontrivial (Ed d) := Module.nontrivial_of_finrank_pos (R := ℝ) (by
    have : (0 : ℕ) < d := by omega
    simpa [Ed] using this)
  have hd0 : (0:ℝ) < (d:ℝ) := by exact_mod_cast (by omega : (0:ℕ) < d)
  have hrhs : (0:ℝ) ≤ Real.sqrt (1 + 1 / (4 * ((d : ℝ) - 1))) / (d : ℝ) := by positivity
  rcases le_or_gt a x with hax | hax
  · have hi : (0:ℕ) < d := by omega
    set i : Fin d := ⟨0, hi⟩ with hidef
    have hmX : Measurable (fun z : Ed d => (dir z).ofLp i) := measurable_dir_coord i
    have hcoord : Measurable (fun z : Ed d => z.ofLp i) :=
      (measurable_pi_apply i).comp (WithLp.measurable_ofLp 2 _)
    have hmY : Measurable (fun z : Ed d => z.ofLp i / Real.sqrt (d:ℝ)) := hcoord.div_const _
    have hXlaw : Measure.map (fun z : Ed d => (dir z).ofLp i) (gaussianE (Ed d))
        = sphericalCoordLaw d := gaussianE_map_dir_coord hd i
    have hYlaw : Measure.map (fun z : Ed d => z.ofLp i / Real.sqrt (d:ℝ)) (gaussianE (Ed d))
        = gaussianReal 0 (Real.toNNReal (1 / (d : ℝ))) := by
      have h1 : (fun z : Ed d => z.ofLp i / Real.sqrt (d:ℝ))
          = (fun t : ℝ => t / Real.sqrt (d:ℝ)) ∘ (fun z : Ed d => z.ofLp i) := rfl
      have hdiv : Measurable (fun t : ℝ => t / Real.sqrt (d:ℝ)) := measurable_id.div_const _
      rw [h1, ← Measure.map_map hdiv hcoord, gaussianE_map_ofLp i,
        gaussianReal_map_div_sqrt hd]
    have hIX : Integrable (fun z : Ed d => (dir z).ofLp i) (gaussianE (Ed d)) := by
      refine (integrable_const (1:ℝ)).mono' hmX.aestronglyMeasurable ?_
      filter_upwards with z
      rw [Real.norm_eq_abs]
      exact abs_dir_coord_le_one i z
    have hIY : Integrable (fun z : Ed d => z.ofLp i / Real.sqrt (d:ℝ)) (gaussianE (Ed d)) := by
      refine ((integrable_norm_gaussianE (E := Ed d)).div_const
        (Real.sqrt (d:ℝ))).mono' hmY.aestronglyMeasurable ?_
      filter_upwards with z
      rw [Real.norm_eq_abs, abs_div, abs_of_nonneg (Real.sqrt_nonneg _)]
      gcongr
      simpa using PiLp.norm_apply_le z i
    calc |Threshold.cdfGapInt (sphericalCoordLaw d)
            (gaussianReal 0 (Real.toNNReal (1 / (d : ℝ)))) a x|
        ≤ ∫ z, |(dir z).ofLp i - z.ofLp i / Real.sqrt (d:ℝ)| ∂(gaussianE (Ed d)) :=
          Threshold.abs_cdfGapInt_le_integral_abs_sub_of_coupling _ hmX.aemeasurable
            hmY.aemeasurable hIX hIY hXlaw hYlaw hax
      _ ≤ Real.sqrt (1 + 1 / (4 * ((d : ℝ) - 1))) / (d : ℝ) :=
          integral_abs_dir_coord_sub_coord_div_sqrt_le hd i
  · have hempty : Set.Ioc a x = (∅ : Set ℝ) := Set.Ioc_eq_empty (by linarith)
    rw [Threshold.cdfGapInt, hempty, Measure.restrict_empty, integral_zero_measure, abs_zero]
    exact hrhs

end CouplingLeg

/-! ## §58  The deployed-versus-Gaussian leg, by Fourier inversion of the integrated CDF gap

§57 builds one leg of the comparison the paper needs, `sphericalCoordLaw d` against `N(0, 1/d)`,
in `cdfGapInt` form and by coupling.  This section builds the other, `coordLaw H v i` against the
same Gaussian, and it cannot use a coupling: the deployed coordinate law is supported on `2^d`
points and this development exhibits no coupling of it with a Gaussian.  What it does have is the
characteristic-function comparison of §40 and §44.  The route is therefore Fourier inversion, but
of the **once-integrated** CDF difference rather than of the CDF difference itself, which is what
lets a `u^{-2}` weight appear where Esseen's route carries `u^{-1}`.

Six blocks.  §58a and §58b are independent; §58a′ refines §58a; §58c composes §58a with §58b,
and §58c′, §58d and §58d′ are the same composition with one or both constants sharpened.

* **§58a, the kernel and the inversion.**  `dirConst = ∫₀^∞ (1 − cos u)/u² du` is finite and
  `∫₀^∞ (1 − cos(su))/u² du = dirConst · |s|` (`integral_kernel`).  Its exact value is the
  Dirichlet integral `π/2`, and that **is** now formalised (`dirConst_eq`), by reading §43's Fejér
  density at half-width `1/(2π)` and halving by evenness; Mathlib carries `Real.sinc` but no
  integral of it, so the value is not imported.  The earlier lower bound `9/8 ≤ dirConst`
  (`dirConst_ge`, from `sin x > x − x³/6` on `(0, 3]`) is retained, and the §58c statements are
  still phrased through it, so their constants are loose by `(π/2)/(9/8) ≈ 1.40`; §58d repeats
  them with the exact value.  On top of that,
  `abs_cdfGapInt_le_of_charFun` states

    `|cdfGapInt μ ν a x| ≤ (∫₀^∞ ‖φ_μ(u) − φ_ν(u)‖/u² du) / dirConst`

  for any two probability laws with finite first absolute moments, uniformly in `a` and `x` and
  with no support hypothesis.  The identity behind it is
  `(x − t)⁺ − (a − t)⁺ = (x − a)/2 + (|x − t| − |a − t|)/2`, whose constant part cancels between
  the two laws; the mean absolute deviations `∫|y − t| dρ` are then read off the kernel by Tonelli
  (`integrableOn_and_integral_kernel_measure`).  No equality of means is used: what makes the
  `u → 0` end harmless is the cancellation of the two `1`s in `1 − cos`.  A factor `2` is lost at
  `|G(x) − G(a)| ≤ |G(x)| + |G(a)|`.
* **§58a′, the same inversion with that cancellation kept.**  The Fourier representation gives
  `G(x) − G(a)` directly, and by `cos α − cos β = 2 sin((α+β)/2) sin((β−α)/2)` the kernel for the
  difference carries a factor `2 sin((x − a)u/2)`.  `abs_cdfGapInt_le_of_charFun_sin` keeps it:

    `|cdfGapInt μ ν a x| ≤ (∫₀^∞ |sin((x − a)u/2)|·‖φ_μ(u) − φ_ν(u)‖/u² du)/dirConst`,

  which implies `abs_cdfGapInt_le_of_charFun` (`integral_sinWeight_le`) and is strictly better at
  every `u` where `|sin((x − a)u/2)| < 1`.  It does **not** improve the constant uniformly in `a`
  and `x`: for a weight concentrated near one frequency `u₀` the choice `x − a = π/u₀` makes the
  sine factor `≈ 1` across the band, and such weights are realised, so the factor `2` above is
  **sharp** as a statement about arbitrary pairs of laws.  At the particular weight §58b produces
  the supremum is `0.72` of the unweighted integral at `d = 512` and a spread direction, a factor
  `1.39` rather than `2`, and collecting it needs `sup_{c>0} c·∫_c^∞|sin w|/w² dw = 0.7787… < 1`,
  which is **not** proved here.  Both numbers are numerical.  §58c and §58c′ below are therefore
  still proved from `abs_cdfGapInt_le_of_charFun` and carry the factor `2`.
* **§58b, the two-range estimate.**  Split at `√d` and at `√d/M`, where `M` is any bound on the
  coordinates of `v`.  Below `√d/M` §44's damped bound
  `‖φ_μ − φ_ν‖ ≤ (u⁴ ∑ⱼvⱼ⁴/(2d²)) · e^{−u²‖v‖²/(4d)}` applies, and `e^{−z} ≤ 2/z²` makes its tail
  integrable; beyond `√d/M` this development knows nothing about the atomic law's characteristic
  function and the trivial `‖φ_μ − φ_ν‖ ≤ 2` is used.  The two ranges integrate to
  `(97/6 · ∑ⱼvⱼ⁴ + 2M)/√d` (`integral_gapWeight_le`).  The constant `2` in `e^{−z} ≤ 2/z²` is
  very lossy: `max_{z>0} z²e^{−z} = 4e^{−2} = 0.5413…`, so `e^{−z} ≤ (5/9)/z²` holds
  (`exp_neg_le_five_ninths_div_sq`) and is within `2.6%` of the best possible.  Substituting it
  gives `(83/18 · ∑ⱼvⱼ⁴ + 2M)/√d` (`integral_gapWeight_le_sharp`), a factor `3.51` on the
  spikiness term.  The `2M` term is **not** improved by it, and at a spread direction that term
  dominates.
* **§58c, leg 1.**  Composing the two, with `M = (∑ⱼvⱼ⁴)^{1/4}` when no coordinate bound is
  supplied, gives `abs_cdfGapInt_coordLaw_gaussian_le`:

    `|cdfGapInt (coordLaw H v i) (N(0, 1/d)) a x| ≤ (15 · ∑ⱼvⱼ⁴ + 2 · (∑ⱼvⱼ⁴)^{1/4})/√d`

  for `d ≥ 2`, a flat `H`, a **unit** direction `v`, any coordinate `i` and every pair `a`, `x`.
* **§58c′, leg 1 with the sharp damping constant.**  The same three statements over
  `integral_gapWeight_le_sharp`, giving `41/10` in place of `15`
  (`abs_cdfGapInt_coordLaw_gaussian_le_sharp` and its two companions).  The `2 · (∑ⱼvⱼ⁴)^{1/4}` is
  unchanged.  At a spread direction the composed bound would read `(41/10/√d + 2)/d` in place of
  `(15/√d + 2)/d`; nothing in §59 is rewired to use it here, and the originals are kept.
* **§58d, leg 1 with the constant evaluated.**  The same three statements, primed, with `π/2` in
  place of `9/8`: `15` becomes `21/2` and `2` becomes `13/10`.  Nothing else changes, and the
  unprimed statements are retained unchanged.
* **§58d′, both constants at once.**  §58b's sharp damping and §58d's exact kernel constant are
  independent, and taking both gives `abs_cdfGapInt_coordLaw_gaussian_le_sharp'`:

    `|cdfGapInt (coordLaw H v i) (N(0, 1/d)) a x| ≤ (3 · ∑ⱼvⱼ⁴ + (13/10)·(∑ⱼvⱼ⁴)^{1/4})/√d`,

  and at a spread direction `(3/√d + 13/10)/d` in place of `(15/√d + 2)/d`, a factor `1.86` at
  `d = 512`.  This is the smallest constant proved here.  All twelve leg-1 statements are kept;
  none weakens another, and §59 is not rewired to any of them by this section.

**What this does not do.**  It is not a Kolmogorov-Smirnov bound: `|cdf μ − cdf ν|` is bounded
nowhere here, no `η` is produced, and `Threshold.abs_hadRate_sub_rhoSq_le` in its sup-norm form is
untouched by it.  It is one leg only: the second law is the Gaussian `N(0, 1/d)` and not
`sphericalCoordLaw d`, and nothing here composes this bound with §57's
`abs_cdfGapInt_sphericalCoordLaw_gaussian_le` by the triangle inequality.  The rate is **not** the
`d^{-3/2}` that the damped range alone would give: the `2M/√d` term, coming from the range
`|u| > √d/M` on which the atomic law's characteristic function returns near `1`, dominates, and
the lattice structure that would control that range is not exploited.  The constants are not
claimed optimal: the §58c statements enter `dirConst` only through `9/8 ≤ dirConst` and use the
crude `e^{−z} ≤ 2/z²`, and even §58d′, which repairs both, still carries the factor `2` lost at
`|G(x) − G(a)| ≤ |G(x)| + |G(a)|`.  That factor is **sharp** for arbitrary pairs of laws (§58a′),
so it is not slack there, but at the weight §58b produces it is worth about `1.39` and collecting
even that needs an oscillation estimate this development does not have.  The two largest pieces
of slack left are therefore the `M/√d` term, where `‖φ_μ − φ_ν‖ ≤ 2` is used with no information
about the atomic law at all, and the gap between `40/9` and the `√π` that the damped range really
contributes.  Nothing here is asymptotic, and no claim is made about the deployed rotation
attaining the Haar rate `ρ²`. -/

noncomputable section FourierLeg

/-! ### §58a  The kernel `(1 − cos u)/u²` and the inversion bound

Nothing in this block mentions a codebook, a quantiser, a rotation or a dimension: it is about two
arbitrary probability laws on `ℝ` with finite first absolute moments.  `dirConst` is evaluated
here: the Dirichlet integral `∫₀^∞ (1 − cos u)/u² du = π/2` is `dirConst_eq`, proved from §43 and
not imported from Mathlib, which does not contain it. -/

namespace FourierGap

/-- **The kernel constant** `∫₀^∞ (1 − cos u)/u² du`.  It is finite
(`integrableOn_kernel'`) and its exact value is the Dirichlet integral `π/2`, proved as
`dirConst_eq`.  The weaker `9/8 ≤ dirConst` (`dirConst_ge`) is retained because the §58c
statements are phrased through it; those are therefore at most `(π/2)/(9/8) ≈ 1.40` times the
sharp constant, and §58d repeats them with `dirConst_eq`.  Evaluating this one number does not
make any downstream constant sharp: see `dirConst_eq` for what is still lost. -/
def dirConst : ℝ := ∫ u in Set.Ioi (0:ℝ), (1 - Real.cos u) / u ^ 2

theorem oneSubCos_nonneg (u : ℝ) : 0 ≤ 1 - Real.cos u := by linarith [Real.cos_le_one u]

theorem kernel_nonneg (s u : ℝ) : 0 ≤ (1 - Real.cos (s * u)) / u ^ 2 :=
  div_nonneg (oneSubCos_nonneg _) (sq_nonneg u)

theorem measurable_kernel (s : ℝ) :
    Measurable fun u : ℝ => (1 - Real.cos (s * u)) / u ^ 2 := by fun_prop

theorem rpow_neg_two {u : ℝ} (hu : 0 < u) : u ^ (-2 : ℝ) = 1 / u ^ 2 := by
  rw [Real.rpow_neg hu.le, show ((2:ℝ)) = ((2:ℕ):ℝ) by norm_num, Real.rpow_natCast, one_div]

/-- `1 − cos u ≤ u²/2`, so the kernel is bounded near `0`. -/
theorem oneSubCos_le (u : ℝ) : 1 - Real.cos u ≤ u ^ 2 / 2 := by
  linarith [Real.one_sub_sq_div_two_le_cos (x := u)]

theorem integrableOn_kernel_one (s : ℝ) :
    IntegrableOn (fun u : ℝ => (1 - Real.cos (s * u)) / u ^ 2) (Set.Ioi 1) := by
  have hbase : IntegrableOn (fun u : ℝ => u ^ (-2 : ℝ)) (Set.Ioi 1) :=
    integrableOn_Ioi_rpow_of_lt (by norm_num) one_pos
  refine (hbase.const_mul 2).mono' (measurable_kernel s).aestronglyMeasurable ?_
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with u hu
  have hu0 : (0:ℝ) < u := lt_trans one_pos hu
  rw [Real.norm_eq_abs, abs_of_nonneg (kernel_nonneg s u), rpow_neg_two hu0, mul_one_div]
  have h2 : 1 - Real.cos (s * u) ≤ 2 := by linarith [Real.neg_one_le_cos (s * u)]
  gcongr

theorem integrableOn_kernel_zero (s : ℝ) :
    IntegrableOn (fun u : ℝ => (1 - Real.cos (s * u)) / u ^ 2) (Set.Ioc 0 1) := by
  refine Measure.integrableOn_of_bounded (M := s ^ 2 / 2) (by simp)
    (measurable_kernel s).aestronglyMeasurable ?_
  filter_upwards [ae_restrict_mem measurableSet_Ioc] with u hu
  rw [Real.norm_eq_abs, abs_of_nonneg (kernel_nonneg s u)]
  rw [div_le_iff₀ (pow_pos hu.1 2)]
  nlinarith [oneSubCos_le (s * u), sq_nonneg u, hu.1, hu.2, sq_nonneg (s * u)]

theorem integrableOn_kernel (s : ℝ) :
    IntegrableOn (fun u : ℝ => (1 - Real.cos (s * u)) / u ^ 2) (Set.Ioi 0) := by
  have hsplit : Set.Ioi (0:ℝ) = Set.Ioc 0 1 ∪ Set.Ioi 1 := by
    ext u; simp only [Set.mem_Ioi, Set.mem_union, Set.mem_Ioc]
    constructor
    · intro h; rcases le_or_gt u 1 with h1 | h1
      · exact Or.inl ⟨h, h1⟩
      · exact Or.inr h1
    · rintro (⟨h, -⟩ | h)
      · exact h
      · linarith
  rw [hsplit]
  exact (integrableOn_kernel_zero s).union (integrableOn_kernel_one s)


theorem integrableOn_kernel' :
    IntegrableOn (fun u : ℝ => (1 - Real.cos u) / u ^ 2) (Set.Ioi 0) := by
  simpa using integrableOn_kernel 1

/-- `(1 − cos u)/u² ≥ 1/2 − u²/24` on `(0, 3]`, from `sin x > x − x³/6`. -/
theorem kernel_ge {u : ℝ} (hu0 : 0 < u) (hu3 : u ≤ 3) :
    1 / 2 - u ^ 2 / 24 ≤ (1 - Real.cos u) / u ^ 2 := by
  have hs : u / 2 - (u / 2) ^ 3 / 6 < Real.sin (u / 2) := Real.sin_gt_sub_cube (by linarith)
  have hu2 : u ^ 2 ≤ 9 := by nlinarith
  have hpos : 0 ≤ u / 2 - (u / 2) ^ 3 / 6 := by
    nlinarith [mul_nonneg hu0.le (show (0:ℝ) ≤ 24 - u ^ 2 by linarith)]
  have hsq : (u / 2 - (u / 2) ^ 3 / 6) ^ 2 ≤ Real.sin (u / 2) ^ 2 := by nlinarith
  have hid : 1 - Real.cos u = 2 * Real.sin (u / 2) ^ 2 := by
    have h := Real.sin_sq_eq_half_sub (u / 2)
    rw [show 2 * (u / 2) = u by ring] at h
    linarith
  have hexp : 2 * (u / 2 - (u / 2) ^ 3 / 6) ^ 2 = u ^ 2 / 2 - u ^ 4 / 24 + u ^ 6 / 1152 := by
    ring
  rw [hid, le_div_iff₀ (pow_pos hu0 2)]
  nlinarith [pow_nonneg hu0.le 6]

theorem integral_affine_Ioc : ∫ u in Set.Ioc (0:ℝ) 3, (1 / 2 - u ^ 2 / 24) = 9 / 8 := by
  rw [← intervalIntegral.integral_of_le (by norm_num : (0:ℝ) ≤ 3)]
  rw [intervalIntegral.integral_sub intervalIntegrable_const
    ((intervalIntegral.intervalIntegrable_pow 2).div_const 24)]
  simp only [intervalIntegral.integral_div, integral_pow, intervalIntegral.integral_const,
    smul_eq_mul]
  norm_num

/-- **The kernel constant is at least `9/8`**, by `sin x > x − x³/6` on `(0, 3]`.  Its exact value
`π/2 ≈ 1.5708` is proved separately as `dirConst_eq`; this weaker bound is kept because the
unprimed §58c and §59 statements are phrased through it, and it is elementary where `dirConst_eq`
routes through §43's Fourier inversion. -/
theorem dirConst_ge : (9:ℝ) / 8 ≤ dirConst := by
  have hIoc : IntegrableOn (fun u : ℝ => (1 - Real.cos u) / u ^ 2) (Set.Ioc (0:ℝ) 3) :=
    integrableOn_kernel'.mono_set (fun u hu => hu.1)
  have haff : IntegrableOn (fun u : ℝ => 1 / 2 - u ^ 2 / 24) (Set.Ioc (0:ℝ) 3) := by
    apply Continuous.integrableOn_Ioc
    fun_prop
  have h1 : (9:ℝ) / 8 ≤ ∫ u in Set.Ioc (0:ℝ) 3, (1 - Real.cos u) / u ^ 2 := by
    rw [← integral_affine_Ioc]
    exact setIntegral_mono_on haff hIoc measurableSet_Ioc fun u hu => kernel_ge hu.1 hu.2
  refine h1.trans ?_
  refine setIntegral_mono_set integrableOn_kernel' ?_ ?_
  · filter_upwards with u using div_nonneg (oneSubCos_nonneg u) (sq_nonneg u)
  · exact Filter.Eventually.of_forall fun u hu => hu.1

theorem dirConst_pos : 0 < dirConst := lt_of_lt_of_le (by norm_num) dirConst_ge

/-- **The whole-line kernel integral** `∫_ℝ (1 − cos u)/u² du = π`.  This is §43's Fejér density
read at half-width `T = 1/(2π)`, where `(1 − cos(2πTy))/(2π²Ty²)` collapses to `(1 − cos y)/(πy²)`,
combined with `integral_fejerDensity`, which says that density integrates to `1`.  That identity is
Fourier inversion of the triangle at the origin, so all the analytic content is §43's
`fourier_triC`; nothing new is assumed here and no Laplace-transform or contour argument is used.
Mathlib carries `Real.sinc` but no integral of it, so the value is not imported. -/
theorem integral_kernel_univ : ∫ u : ℝ, (1 - Real.cos u) / u ^ 2 = π := by
  have hπ : (0:ℝ) < π := Real.pi_pos
  have hT : (0:ℝ) < 1 / (2 * π) := by positivity
  have h1 := integral_fejerDensity hT
  have h2 : ∫ y : ℝ, fejerDensity (1 / (2 * π)) y
      = (∫ y : ℝ, (1 - Real.cos y) / y ^ 2) / π := by
    rw [← integral_div]
    refine integral_congr_ae ?_
    filter_upwards [Measure.ae_ne volume (0:ℝ)] with y hy
    rw [fejerDensity_eq hT hy]
    rw [show 2 * π * (1 / (2 * π)) * y = y by field_simp]
    rw [show 2 * π ^ 2 * (1 / (2 * π)) * y ^ 2 = y ^ 2 * π by field_simp]
    rw [div_div]
  rw [h2] at h1
  field_simp at h1
  linarith [h1]

/-- **The kernel constant is exactly `π/2`**: the Dirichlet integral, evaluated.  The integrand is
even, so `integral_comp_abs` halves `integral_kernel_univ`.

This supersedes `dirConst_ge`, which is kept because the unprimed statements below are phrased
through it; those therefore carry constants loose by the factor `(π/2)/(9/8) ≈ 1.396`, and the
primed statements at the end of §58 and in §59 carry the sharpened ones.

**What this does not do.**  It evaluates one real number.  No rate in this development becomes
sharp because of it: the factor `2` at `|G(x) − G(a)| ≤ |G(x)| + |G(a)|`, the bound `e^{−z} ≤ 2/z²`
inside §44, and §59's `3/2` for `√(1 + 1/(4(d−1)))` are untouched and remain unquantified losses,
so no constant downstream is claimed near-sharp even after this substitution. -/
theorem dirConst_eq : dirConst = π / 2 := by
  have h := integral_kernel_univ
  have heven : ∫ u : ℝ, (1 - Real.cos u) / u ^ 2
      = 2 * ∫ u in Set.Ioi (0:ℝ), (1 - Real.cos u) / u ^ 2 := by
    rw [← integral_comp_abs (f := fun x : ℝ => (1 - Real.cos x) / x ^ 2)]
    refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
    simp only [Real.cos_abs, sq_abs]
  rw [heven] at h
  rw [dirConst]
  linarith

/-- **The scaling law**: `∫₀^∞ (1 − cos (s u))/u² du = dirConst · |s|`. -/
theorem integral_kernel (s : ℝ) :
    ∫ u in Set.Ioi (0:ℝ), (1 - Real.cos (s * u)) / u ^ 2 = dirConst * |s| := by
  have key : ∀ r : ℝ, 0 < r →
      ∫ u in Set.Ioi (0:ℝ), (1 - Real.cos (r * u)) / u ^ 2 = dirConst * r := by
    intro r hr
    have hg : ∀ u : ℝ, (1 - Real.cos (r * u)) / u ^ 2
        = r ^ 2 * ((1 - Real.cos (r * u)) / (r * u) ^ 2) := by
      intro u
      rcases eq_or_ne u 0 with rfl | hu
      · simp
      · field_simp
    simp_rw [hg]
    rw [integral_comp_mul_left_Ioi (fun w : ℝ => r ^ 2 * ((1 - Real.cos w) / w ^ 2)) 0 hr,
      mul_zero, integral_const_mul, smul_eq_mul, ← dirConst]
    field_simp
  rcases lt_trichotomy s 0 with hs | hs | hs
  · have hcos : ∀ u : ℝ, Real.cos (s * u) = Real.cos (-s * u) := by
      intro u; rw [show -s * u = -(s * u) by ring, Real.cos_neg]
    simp_rw [hcos]
    rw [key (-s) (by linarith), abs_of_neg hs]
  · subst hs; simp
  · rw [key s hs, abs_of_pos hs]


/-! ### The kernel representation of the mean absolute deviation -/

/-- **Tonelli for the kernel.**  For a probability law `ρ` with finite mean absolute deviation at
`y`, the `u`-integrand `u ↦ (∫ (1 − cos((y − t)u)) dρ(t))/u²` is integrable on `(0, ∞)` and its
integral is `dirConst · ∫ |y − t| dρ(t)`.  Both statements come from the same product-integrability
of the nonnegative kernel; no cancellation is involved. -/
theorem integrableOn_and_integral_kernel_measure (ρ : Measure ℝ) [IsProbabilityMeasure ρ] (y : ℝ)
    (hρ : Integrable (fun t : ℝ => |y - t|) ρ) :
    IntegrableOn (fun u : ℝ => (∫ t, (1 - Real.cos ((y - t) * u)) ∂ρ) / u ^ 2) (Set.Ioi 0)
      ∧ (∫ u in Set.Ioi (0:ℝ), (∫ t, (1 - Real.cos ((y - t) * u)) ∂ρ) / u ^ 2)
          = dirConst * ∫ t, |y - t| ∂ρ := by
  set F : ℝ × ℝ → ℝ := fun p => (1 - Real.cos ((y - p.1) * p.2)) / p.2 ^ 2 with hFdef
  have hFm : Measurable F := by fun_prop
  have hFnn : ∀ p : ℝ × ℝ, 0 ≤ F p := fun p => kernel_nonneg (y - p.1) p.2
  have hrow : ∀ t : ℝ, (∫ u in Set.Ioi (0:ℝ), ‖F (t, u)‖) = dirConst * |y - t| := by
    intro t
    have hcongr : (fun u : ℝ => ‖F (t, u)‖)
        = fun u : ℝ => (1 - Real.cos ((y - t) * u)) / u ^ 2 := by
      funext u
      rw [Real.norm_eq_abs, abs_of_nonneg (hFnn (t, u))]
    rw [hcongr]
    exact integral_kernel (y - t)
  have hInt : Integrable F (ρ.prod (volume.restrict (Set.Ioi 0))) := by
    rw [integrable_prod_iff hFm.aestronglyMeasurable]
    refine ⟨Filter.Eventually.of_forall fun t => integrableOn_kernel (y - t), ?_⟩
    exact (hρ.const_mul dirConst).congr (Filter.Eventually.of_forall fun t => (hrow t).symm)
  have hrow2 : ∀ t : ℝ, (∫ u in Set.Ioi (0:ℝ), F (t, u)) = dirConst * |y - t| :=
    fun t => integral_kernel (y - t)
  have hcol : ∀ u : ℝ, (∫ t, F (t, u) ∂ρ)
      = (∫ t, (1 - Real.cos ((y - t) * u)) ∂ρ) / u ^ 2 := by
    intro u
    simp only [hFdef]
    rw [integral_div]
  constructor
  · have h := ((integrable_prod_iff' hFm.aestronglyMeasurable).mp hInt).2
    refine h.congr (Filter.Eventually.of_forall fun u => ?_)
    show (∫ t, ‖F (t, u)‖ ∂ρ) = (∫ t, (1 - Real.cos ((y - t) * u)) ∂ρ) / u ^ 2
    rw [← hcol u]
    refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
    show ‖F (t, u)‖ = F (t, u)
    rw [Real.norm_eq_abs, abs_of_nonneg (hFnn (t, u))]
  · have hswap := integral_integral_swap (f := fun t u => F (t, u)) hInt
    have hgoal : (∫ u in Set.Ioi (0:ℝ), (∫ t, (1 - Real.cos ((y - t) * u)) ∂ρ) / u ^ 2)
        = ∫ u in Set.Ioi (0:ℝ), (∫ t, F (t, u) ∂ρ) :=
      integral_congr_ae (Filter.Eventually.of_forall fun u => (hcol u).symm)
    rw [hgoal, ← hswap]
    simp_rw [hrow2]
    exact integral_const_mul _ _


/-! ### From the kernel to the characteristic functions -/

/-- `cos (u ·)` is integrable against any probability law, being bounded by `1`. -/
theorem integrable_cos (ρ : Measure ℝ) [IsProbabilityMeasure ρ] (u : ℝ) :
    Integrable (fun t : ℝ => Real.cos (u * t)) ρ :=
  (integrable_const (1:ℝ)).mono' (by fun_prop)
    (Filter.Eventually.of_forall fun t => by
      rw [Real.norm_eq_abs]; exact Real.abs_cos_le_one _)

theorem integrable_sin (ρ : Measure ℝ) [IsProbabilityMeasure ρ] (u : ℝ) :
    Integrable (fun t : ℝ => Real.sin (u * t)) ρ :=
  (integrable_const (1:ℝ)).mono' (by fun_prop)
    (Filter.Eventually.of_forall fun t => by
      rw [Real.norm_eq_abs]; exact Real.abs_sin_le_one _)

/-- **The characteristic function in real and imaginary parts.**  Nothing but `e^{iθ} = cos θ +
i sin θ` integrated term by term; both terms are bounded, hence integrable. -/
theorem charFun_eq_cos_add_sin (ρ : Measure ℝ) [IsProbabilityMeasure ρ] (u : ℝ) :
    charFun ρ u = ((∫ t, Real.cos (u * t) ∂ρ : ℝ) : ℂ)
      + ((∫ t, Real.sin (u * t) ∂ρ : ℝ) : ℂ) * Complex.I := by
  rw [charFun_apply_real]
  have hexp : ∀ t : ℝ, Complex.exp ((u : ℂ) * (t : ℂ) * Complex.I)
      = ((Real.cos (u * t) : ℝ) : ℂ) + ((Real.sin (u * t) : ℝ) : ℂ) * Complex.I := by
    intro t
    rw [← Complex.ofReal_mul, Complex.exp_mul_I, Complex.ofReal_cos, Complex.ofReal_sin]
  simp_rw [hexp]
  have hc : Integrable (fun t : ℝ => ((Real.cos (u * t) : ℝ) : ℂ)) ρ :=
    (integrable_cos ρ u).ofReal
  have hs : Integrable (fun t : ℝ => ((Real.sin (u * t) : ℝ) : ℂ) * Complex.I) ρ :=
    ((integrable_sin ρ u).ofReal).mul_const _
  rw [integral_add hc hs, integral_mul_const, integral_complex_ofReal, integral_complex_ofReal]

/-- **The shifted cosine average against the characteristic-function gap.**  For any two
probability laws and any `y`, `u`, the gap between the two averages of `cos((y − t)u)` is at most
`‖φ_μ(u) − φ_ν(u)‖`.  The `y` enters only through `cos(yu)` and `sin(yu)`, whose squares sum to
`1`; this is Cauchy-Schwarz and nothing more. -/
theorem abs_integral_cos_shift_sub_le (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] (y u : ℝ) :
    |(∫ t, Real.cos ((y - t) * u) ∂μ) - ∫ t, Real.cos ((y - t) * u) ∂ν|
      ≤ ‖charFun μ u - charFun ν u‖ := by
  have hsplit : ∀ ρ : Measure ℝ, ∀ _ : IsProbabilityMeasure ρ,
      (∫ t, Real.cos ((y - t) * u) ∂ρ)
        = Real.cos (y * u) * (∫ t, Real.cos (u * t) ∂ρ)
          + Real.sin (y * u) * ∫ t, Real.sin (u * t) ∂ρ := by
    intro ρ hρ
    have hpt : ∀ t : ℝ, Real.cos ((y - t) * u)
        = Real.cos (y * u) * Real.cos (u * t) + Real.sin (y * u) * Real.sin (u * t) := by
      intro t
      rw [show (y - t) * u = y * u - u * t by ring, Real.cos_sub]
    simp_rw [hpt]
    rw [integral_add ((integrable_cos ρ u).const_mul _) ((integrable_sin ρ u).const_mul _),
      integral_const_mul, integral_const_mul]
  set A : ℝ := (∫ t, Real.cos (u * t) ∂μ) - ∫ t, Real.cos (u * t) ∂ν with hA
  set B : ℝ := (∫ t, Real.sin (u * t) ∂μ) - ∫ t, Real.sin (u * t) ∂ν with hB
  have hgap : (∫ t, Real.cos ((y - t) * u) ∂μ) - ∫ t, Real.cos ((y - t) * u) ∂ν
      = Real.cos (y * u) * A + Real.sin (y * u) * B := by
    rw [hsplit μ ‹_›, hsplit ν ‹_›, hA, hB]; ring
  have hnorm : ‖charFun μ u - charFun ν u‖ = Real.sqrt (A ^ 2 + B ^ 2) := by
    rw [charFun_eq_cos_add_sin μ u, charFun_eq_cos_add_sin ν u]
    rw [show (((∫ t, Real.cos (u * t) ∂μ : ℝ) : ℂ)
          + ((∫ t, Real.sin (u * t) ∂μ : ℝ) : ℂ) * Complex.I)
        - (((∫ t, Real.cos (u * t) ∂ν : ℝ) : ℂ)
          + ((∫ t, Real.sin (u * t) ∂ν : ℝ) : ℂ) * Complex.I)
        = ((A : ℝ) : ℂ) + ((B : ℝ) : ℂ) * Complex.I by rw [hA, hB]; push_cast; ring]
    exact Complex.norm_add_mul_I A B
  rw [hgap, hnorm]
  have hpyth : Real.cos (y * u) ^ 2 + Real.sin (y * u) ^ 2 = 1 := by
    rw [add_comm]; exact Real.sin_sq_add_cos_sq _
  have hsq : (Real.cos (y * u) * A + Real.sin (y * u) * B) ^ 2 ≤ A ^ 2 + B ^ 2 := by
    nlinarith [sq_nonneg (Real.sin (y * u) * A - Real.cos (y * u) * B)]
  calc |Real.cos (y * u) * A + Real.sin (y * u) * B|
      = Real.sqrt ((Real.cos (y * u) * A + Real.sin (y * u) * B) ^ 2) :=
        (Real.sqrt_sq_eq_abs _).symm
    _ ≤ Real.sqrt (A ^ 2 + B ^ 2) := Real.sqrt_le_sqrt hsq


/-! ### The inversion bound on `cdfGapInt` -/

theorem integrable_cos_shift (ρ : Measure ℝ) [IsProbabilityMeasure ρ] (y u : ℝ) :
    Integrable (fun t : ℝ => Real.cos ((y - t) * u)) ρ :=
  (integrable_const (1:ℝ)).mono' (by fun_prop)
    (Filter.Eventually.of_forall fun t => by
      rw [Real.norm_eq_abs]; exact Real.abs_cos_le_one _)

/-- **The mean absolute deviation gap, bounded by the characteristic-function integral.**  For two
probability laws with finite first absolute moments, and at every `y`,

  `|∫ |y − t| dμ − ∫ |y − t| dν| ≤ (∫₀^∞ ‖φ_μ(u) − φ_ν(u)‖/u² du) / dirConst`.

The `1` in `1 − cos` cancels between the two laws, which is why no hypothesis beyond the two
first moments is needed; no equality of means is used here. -/
theorem abs_integral_abs_sub_le (μ ν : Measure ℝ) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (y : ℝ) (hμ : Integrable (fun t : ℝ => |y - t|) μ) (hν : Integrable (fun t : ℝ => |y - t|) ν)
    (hcf : IntegrableOn (fun u : ℝ => ‖charFun μ u - charFun ν u‖ / u ^ 2) (Set.Ioi 0)) :
    |(∫ t, |y - t| ∂μ) - ∫ t, |y - t| ∂ν|
      ≤ (∫ u in Set.Ioi (0:ℝ), ‖charFun μ u - charFun ν u‖ / u ^ 2) / dirConst := by
  obtain ⟨hIμ, hJμ⟩ := integrableOn_and_integral_kernel_measure μ y hμ
  obtain ⟨hIν, hJν⟩ := integrableOn_and_integral_kernel_measure ν y hν
  have hdiff : dirConst * ((∫ t, |y - t| ∂μ) - ∫ t, |y - t| ∂ν)
      = ∫ u in Set.Ioi (0:ℝ), ((∫ t, (1 - Real.cos ((y - t) * u)) ∂μ) / u ^ 2
          - (∫ t, (1 - Real.cos ((y - t) * u)) ∂ν) / u ^ 2) := by
    rw [integral_sub hIμ hIν, hJμ, hJν]; ring
  have hone : ∀ ρ : Measure ℝ, ∀ _ : IsProbabilityMeasure ρ, ∀ u : ℝ,
      (∫ t, (1 - Real.cos ((y - t) * u)) ∂ρ) = 1 - ∫ t, Real.cos ((y - t) * u) ∂ρ := by
    intro ρ hρ u
    haveI := hρ
    rw [integral_sub (integrable_const 1) (integrable_cos_shift ρ y u)]
    simp
  have hpt : ∀ u ∈ Set.Ioi (0:ℝ),
      |(∫ t, (1 - Real.cos ((y - t) * u)) ∂μ) / u ^ 2
          - (∫ t, (1 - Real.cos ((y - t) * u)) ∂ν) / u ^ 2|
        ≤ ‖charFun μ u - charFun ν u‖ / u ^ 2 := by
    intro u hu
    have hu2 : (0:ℝ) < u ^ 2 := pow_pos hu 2
    rw [div_sub_div_same, abs_div, abs_of_pos hu2]
    have hnum : |(∫ t, (1 - Real.cos ((y - t) * u)) ∂μ)
        - ∫ t, (1 - Real.cos ((y - t) * u)) ∂ν| ≤ ‖charFun μ u - charFun ν u‖ := by
      rw [hone μ ‹_› u, hone ν ‹_› u,
        show (1 - ∫ t, Real.cos ((y - t) * u) ∂μ) - (1 - ∫ t, Real.cos ((y - t) * u) ∂ν)
          = -((∫ t, Real.cos ((y - t) * u) ∂μ) - ∫ t, Real.cos ((y - t) * u) ∂ν) by ring,
        abs_neg]
      exact abs_integral_cos_shift_sub_le μ ν y u
    gcongr
  have hsubint : IntegrableOn (fun u : ℝ => (∫ t, (1 - Real.cos ((y - t) * u)) ∂μ) / u ^ 2
      - (∫ t, (1 - Real.cos ((y - t) * u)) ∂ν) / u ^ 2) (Set.Ioi 0) := hIμ.sub hIν
  have habs : dirConst * |(∫ t, |y - t| ∂μ) - ∫ t, |y - t| ∂ν|
      ≤ ∫ u in Set.Ioi (0:ℝ), ‖charFun μ u - charFun ν u‖ / u ^ 2 := by
    rw [← abs_of_pos dirConst_pos, ← abs_mul, hdiff]
    calc |∫ u in Set.Ioi (0:ℝ), ((∫ t, (1 - Real.cos ((y - t) * u)) ∂μ) / u ^ 2
            - (∫ t, (1 - Real.cos ((y - t) * u)) ∂ν) / u ^ 2)|
        ≤ ∫ u in Set.Ioi (0:ℝ), |(∫ t, (1 - Real.cos ((y - t) * u)) ∂μ) / u ^ 2
            - (∫ t, (1 - Real.cos ((y - t) * u)) ∂ν) / u ^ 2| := abs_integral_le_integral_abs
      _ ≤ _ := setIntegral_mono_on hsubint.abs hcf measurableSet_Ioi hpt
  rw [le_div_iff₀ dirConst_pos]
  linarith [habs]


theorem max_eq_add_abs_div_two (s : ℝ) : max s 0 = (s + |s|) / 2 := by
  rcases le_total 0 s with h | h
  · rw [max_eq_left h, abs_of_nonneg h]; ring
  · rw [max_eq_right h, abs_of_nonpos h]; ring

/-- **Fourier inversion for the once-integrated CDF gap.**  For two probability laws with finite
first absolute moments whose characteristic-function gap is `u⁻²`-integrable on `(0, ∞)`,

  `|cdfGapInt μ ν a x| ≤ (∫₀^∞ ‖φ_μ(u) − φ_ν(u)‖/u² du) / dirConst`

for **every** pair `a`, `x`, with no support hypothesis and no relation between `a` and `x`.  The
route is the identity `(x − t)⁺ − (a − t)⁺ = (x − a)/2 + (|x − t| − |a − t|)/2`, in which the
`(x − a)/2` cancels between the two laws; the two mean absolute deviations are then read through
the kernel `∫₀^∞ (1 − cos(su))/u² du = dirConst·|s|`.

This is **not** a bound on `|cdf μ − cdf ν|`: nothing here controls the CDF gap itself, only its
integral.  A factor `2` is spent at `|G(x) − G(a)| ≤ |G(x)| + |G(a)|`.
`abs_cdfGapInt_le_of_charFun_sin` below keeps the cancellation between `x` and `a` that this step
discards and is never worse, but it does not improve the constant uniformly in `a` and `x`: the
factor `2` here is sharp for arbitrary pairs of laws, with the witness recorded in the §58a′
header.  This statement is what §58c and §58c′ use. -/
theorem abs_cdfGapInt_le_of_charFun (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] (hμ : ∀ y : ℝ, Integrable (fun t : ℝ => |y - t|) μ)
    (hν : ∀ y : ℝ, Integrable (fun t : ℝ => |y - t|) ν)
    (hcf : IntegrableOn (fun u : ℝ => ‖charFun μ u - charFun ν u‖ / u ^ 2) (Set.Ioi 0))
    (a x : ℝ) :
    |Threshold.cdfGapInt μ ν a x|
      ≤ (∫ u in Set.Ioi (0:ℝ), ‖charFun μ u - charFun ν u‖ / u ^ 2) / dirConst := by
  set I : ℝ := ∫ u in Set.Ioi (0:ℝ), ‖charFun μ u - charFun ν u‖ / u ^ 2 with hIdef
  have hInn : 0 ≤ I / dirConst := by
    refine div_nonneg ?_ dirConst_pos.le
    exact setIntegral_nonneg measurableSet_Ioi fun u _ => by positivity
  rcases le_or_gt a x with hax | hax
  · have hclamp : ∀ ρ : Measure ℝ, ∀ _ : IsProbabilityMeasure ρ,
        Integrable (fun t : ℝ => |x - t|) ρ → Integrable (fun t : ℝ => |a - t|) ρ →
        (∫ t, (max (x - t) 0 - max (a - t) 0) ∂ρ)
          = ((x - a) + ((∫ t, |x - t| ∂ρ) - ∫ t, |a - t| ∂ρ)) / 2 := by
      intro ρ hρ hix hia
      haveI := hρ
      have hpt : ∀ t : ℝ, max (x - t) 0 - max (a - t) 0
          = ((x - a) + (|x - t| - |a - t|)) / 2 := by
        intro t
        rw [max_eq_add_abs_div_two (x - t), max_eq_add_abs_div_two (a - t)]; ring
      have hd : Integrable (fun t : ℝ => |x - t| - |a - t|) ρ := hix.sub hia
      simp_rw [hpt]
      rw [integral_div, integral_add (integrable_const (x - a)) hd, integral_sub hix hia]
      simp
    rw [Threshold.cdfGapInt_eq_integral_clamp_sub μ ν hax, hclamp μ ‹_› (hμ x) (hμ a),
      hclamp ν ‹_› (hν x) (hν a),
      show ((x - a) + ((∫ t, |x - t| ∂μ) - ∫ t, |a - t| ∂μ)) / 2
          - ((x - a) + ((∫ t, |x - t| ∂ν) - ∫ t, |a - t| ∂ν)) / 2
        = (((∫ t, |x - t| ∂μ) - ∫ t, |x - t| ∂ν)
            - ((∫ t, |a - t| ∂μ) - ∫ t, |a - t| ∂ν)) / 2 by ring,
      abs_div, abs_of_nonneg (by norm_num : (0:ℝ) ≤ 2)]
    have h1 := abs_integral_abs_sub_le μ ν x (hμ x) (hν x) hcf
    have h2 := abs_integral_abs_sub_le μ ν a (hμ a) (hν a) hcf
    have hsum : |((∫ t, |x - t| ∂μ) - ∫ t, |x - t| ∂ν)
        - ((∫ t, |a - t| ∂μ) - ∫ t, |a - t| ∂ν)| ≤ I / dirConst + I / dirConst :=
      (abs_sub _ _).trans (add_le_add h1 h2)
    linarith
  · have hempty : Set.Ioc a x = (∅ : Set ℝ) := Set.Ioc_eq_empty (by linarith)
    rw [Threshold.cdfGapInt, hempty, Measure.restrict_empty, integral_zero_measure, abs_zero]
    exact hInn


/-! ### §58a′  The same inversion with the cancellation between `x` and `a` kept

`abs_cdfGapInt_le_of_charFun` above bounds `|G(x) − G(a)|` by `|G(x)| + |G(a)|` and then bounds
each half by the same Fourier integral, which costs a factor `2`.  The Fourier representation in
fact delivers `G(x) − G(a)` directly: the kernel for the difference is the difference of the two
kernels, and by `cos α − cos β = 2 sin((α+β)/2) sin((β−α)/2)` that difference carries an extra
factor `2 sin((x − a)u/2)`.  Keeping it gives `abs_cdfGapInt_le_of_charFun_sin`, which is never
worse than `abs_cdfGapInt_le_of_charFun` (`integral_sinWeight_le`) and is strictly better at every
`u` where `|sin((x − a)u/2)| < 1`.

**The factor `2` is nevertheless sharp for the general statement, and this block says why.**  The
refined bound is `(∫₀^∞ |sin((x − a)u/2)|·‖φ_μ − φ_ν‖/u² du)/dirConst`, and taking the supremum
over `a` and `x` recovers the unrefined one: for any weight `w` concentrated near a single
frequency `u₀`, the choice `x − a = π/u₀` makes `|sin((x − a)u/2)| ≈ 1` across the whole band.
Such weights are realised: if `φ_μ − φ_ν` is a narrow bump near `±u₀`, then `G(y)` is
approximately a cosine in `y` of amplitude equal to the full Fourier integral, so `G` attains
`+B` and `−B` and `sup_{a,x}|G(x) − G(a)| = 2B` is attained in the limit.  The requirement that
`‖φ_μ − φ_ν‖/u²` be integrable at `0` forces the two means to agree and so rules out the cruder
witnesses, but it does not rule these out.  **So no constant below `1` is available in
`abs_cdfGapInt_le_of_charFun` uniformly in the pair of laws, and the factor `2` there is not slack
but sharpness.**

**What is still recoverable, and what it would take.**  At the particular weight §58b produces the
supremum over `x − a` is not attained: numerical evaluation at `d = 512` and a spread direction
gives `sup_h ∫|sin(hu/2)|w / ∫w = 0.72`, a factor `1.39` and not `2`.  Extracting it needs
`sup_{c>0} c·∫_c^∞ |sin w|/w² dw = 0.7787… < 1` on the high range, an oscillation estimate which
is **not** proved here; both numbers are numerical and neither is formalised.  The theorems below
are exactly the inequality, with no such estimate in them. -/

/-- The shifted cosine average in terms of the two real characteristic-function integrals.  This
is the `hsplit` of `abs_integral_cos_shift_sub_le` named, so that the two-point version can reuse
it; it is `cos((y − t)u) = cos(yu)cos(ut) + sin(yu)sin(ut)` integrated. -/
theorem integral_cos_shift_eq (ρ : Measure ℝ) [IsProbabilityMeasure ρ] (y u : ℝ) :
    (∫ t, Real.cos ((y - t) * u) ∂ρ)
      = Real.cos (y * u) * (∫ t, Real.cos (u * t) ∂ρ)
        + Real.sin (y * u) * ∫ t, Real.sin (u * t) ∂ρ := by
  have hpt : ∀ t : ℝ, Real.cos ((y - t) * u)
      = Real.cos (y * u) * Real.cos (u * t) + Real.sin (y * u) * Real.sin (u * t) := by
    intro t
    rw [show (y - t) * u = y * u - u * t by ring, Real.cos_sub]
  simp_rw [hpt]
  rw [integral_add ((integrable_cos ρ u).const_mul _) ((integrable_sin ρ u).const_mul _),
    integral_const_mul, integral_const_mul]

/-- **Cauchy-Schwarz in `ℝ²` against the characteristic-function gap.**  For any real `p`, `q`,
the combination `p·(cosine-average gap) + q·(sine-average gap)` is at most
`√(p² + q²)·‖φ_μ(u) − φ_ν(u)‖`.  `abs_integral_cos_shift_sub_le` is the case
`(p, q) = (cos(yu), sin(yu))`, where `√(p² + q²) = 1`; the point of stating it for general
`(p, q)` is that the two-point coefficient vector has norm `2|sin((x − a)u/2)|`, which is smaller
than `2` off a discrete set of `u`. -/
theorem abs_comb_charFun_gap_le (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] (p q u : ℝ) :
    |p * ((∫ t, Real.cos (u * t) ∂μ) - ∫ t, Real.cos (u * t) ∂ν)
        + q * ((∫ t, Real.sin (u * t) ∂μ) - ∫ t, Real.sin (u * t) ∂ν)|
      ≤ Real.sqrt (p ^ 2 + q ^ 2) * ‖charFun μ u - charFun ν u‖ := by
  set A : ℝ := (∫ t, Real.cos (u * t) ∂μ) - ∫ t, Real.cos (u * t) ∂ν with hA
  set B : ℝ := (∫ t, Real.sin (u * t) ∂μ) - ∫ t, Real.sin (u * t) ∂ν with hB
  have hnorm : ‖charFun μ u - charFun ν u‖ = Real.sqrt (A ^ 2 + B ^ 2) := by
    rw [charFun_eq_cos_add_sin μ u, charFun_eq_cos_add_sin ν u]
    rw [show (((∫ t, Real.cos (u * t) ∂μ : ℝ) : ℂ)
          + ((∫ t, Real.sin (u * t) ∂μ : ℝ) : ℂ) * Complex.I)
        - (((∫ t, Real.cos (u * t) ∂ν : ℝ) : ℂ)
          + ((∫ t, Real.sin (u * t) ∂ν : ℝ) : ℂ) * Complex.I)
        = ((A : ℝ) : ℂ) + ((B : ℝ) : ℂ) * Complex.I by rw [hA, hB]; push_cast; ring]
    exact Complex.norm_add_mul_I A B
  rw [hnorm, ← Real.sqrt_mul (by positivity)]
  have hsq : (p * A + q * B) ^ 2 ≤ (p ^ 2 + q ^ 2) * (A ^ 2 + B ^ 2) := by
    nlinarith [sq_nonneg (q * A - p * B)]
  calc |p * A + q * B| = Real.sqrt ((p * A + q * B) ^ 2) := (Real.sqrt_sq_eq_abs _).symm
    _ ≤ Real.sqrt ((p ^ 2 + q ^ 2) * (A ^ 2 + B ^ 2)) := Real.sqrt_le_sqrt hsq

/-- **The chord identity.**  The squared distance between the two unit vectors `(cos(xu), sin(xu))`
and `(cos(au), sin(au))` is `4 sin²((x − a)u/2)`.  This is the whole of the extra cancellation the
two-point kernel carries: its coefficient vector has norm `2|sin((x − a)u/2)|` rather than `2`. -/
theorem sq_add_sq_cos_sin_sub (a x u : ℝ) :
    (Real.cos (x * u) - Real.cos (a * u)) ^ 2 + (Real.sin (x * u) - Real.sin (a * u)) ^ 2
      = (2 * |Real.sin ((x - a) * u / 2)|) ^ 2 := by
  have h1 := Real.sin_sq_add_cos_sq (x * u)
  have h2 := Real.sin_sq_add_cos_sq (a * u)
  have h4 : Real.sin ((x - a) * u / 2) ^ 2 = 1 / 2 - Real.cos (2 * ((x - a) * u / 2)) / 2 :=
    Real.sin_sq_eq_half_sub _
  rw [show 2 * ((x - a) * u / 2) = x * u - a * u by ring, Real.cos_sub] at h4
  have habs : |Real.sin ((x - a) * u / 2)| ^ 2 = Real.sin ((x - a) * u / 2) ^ 2 := sq_abs _
  nlinarith [h1, h2, h4, habs]

/-- **The two-point kernel bound.**  The gap between the two laws of
`cos((x − t)u) − cos((a − t)u)` is at most `2|sin((x − a)u/2)|·‖φ_μ(u) − φ_ν(u)‖`.  Applying
`abs_integral_cos_shift_sub_le` at `x` and at `a` separately and adding gives `2·‖φ_μ − φ_ν‖`
instead, which is where the factor `2` of `abs_cdfGapInt_le_of_charFun` comes from; here the two
coefficient vectors are subtracted before the norm is taken. -/
theorem abs_integral_cos_shift_diff_sub_le (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] (a x u : ℝ) :
    |((∫ t, Real.cos ((x - t) * u) ∂μ) - ∫ t, Real.cos ((x - t) * u) ∂ν)
        - ((∫ t, Real.cos ((a - t) * u) ∂μ) - ∫ t, Real.cos ((a - t) * u) ∂ν)|
      ≤ 2 * |Real.sin ((x - a) * u / 2)| * ‖charFun μ u - charFun ν u‖ := by
  set p : ℝ := Real.cos (x * u) - Real.cos (a * u) with hp
  set q : ℝ := Real.sin (x * u) - Real.sin (a * u) with hq
  have hrw : ((∫ t, Real.cos ((x - t) * u) ∂μ) - ∫ t, Real.cos ((x - t) * u) ∂ν)
      - ((∫ t, Real.cos ((a - t) * u) ∂μ) - ∫ t, Real.cos ((a - t) * u) ∂ν)
      = p * ((∫ t, Real.cos (u * t) ∂μ) - ∫ t, Real.cos (u * t) ∂ν)
        + q * ((∫ t, Real.sin (u * t) ∂μ) - ∫ t, Real.sin (u * t) ∂ν) := by
    rw [integral_cos_shift_eq μ x u, integral_cos_shift_eq ν x u, integral_cos_shift_eq μ a u,
      integral_cos_shift_eq ν a u, hp, hq]
    ring
  rw [hrw]
  refine (abs_comb_charFun_gap_le μ ν p q u).trans ?_
  have hsq : p ^ 2 + q ^ 2 = (2 * |Real.sin ((x - a) * u / 2)|) ^ 2 :=
    sq_add_sq_cos_sin_sub a x u
  rw [hsq, Real.sqrt_sq (by positivity)]

/-- The sine-weighted integrand is integrable whenever the unweighted one is, since
`|sin| ≤ 1`. -/
theorem integrableOn_sinWeight (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] (h : ℝ)
    (hcf : IntegrableOn (fun u : ℝ => ‖charFun μ u - charFun ν u‖ / u ^ 2) (Set.Ioi 0)) :
    IntegrableOn (fun u : ℝ => |Real.sin (h * u / 2)| * ‖charFun μ u - charFun ν u‖ / u ^ 2)
      (Set.Ioi 0) := by
  have hc : Continuous fun u : ℝ => charFun μ u - charFun ν u :=
    continuous_charFun.sub continuous_charFun
  have hmeas : Measurable fun u : ℝ =>
      |Real.sin (h * u / 2)| * ‖charFun μ u - charFun ν u‖ / u ^ 2 := by
    refine Measurable.div (Measurable.mul ?_ hc.norm.measurable) (by fun_prop)
    fun_prop
  refine hcf.mono' hmeas.aestronglyMeasurable ?_
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with u hu
  have hu2 : (0:ℝ) < u ^ 2 := pow_pos hu 2
  rw [Real.norm_eq_abs, abs_of_nonneg (by positivity), div_le_div_iff_of_pos_right hu2]
  nlinarith [Real.abs_sin_le_one (h * u / 2), norm_nonneg (charFun μ u - charFun ν u)]

theorem integrableOn_two_sinWeight (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] (h : ℝ)
    (hcf : IntegrableOn (fun u : ℝ => ‖charFun μ u - charFun ν u‖ / u ^ 2) (Set.Ioi 0)) :
    IntegrableOn (fun u : ℝ => 2 * |Real.sin (h * u / 2)| * ‖charFun μ u - charFun ν u‖ / u ^ 2)
      (Set.Ioi 0) := by
  have h2 : IntegrableOn (fun u : ℝ => 2 * (|Real.sin (h * u / 2)|
      * ‖charFun μ u - charFun ν u‖ / u ^ 2)) (Set.Ioi 0) :=
    (integrableOn_sinWeight μ ν h hcf).const_mul 2
  refine h2.congr_fun (fun u _ => ?_) measurableSet_Ioi
  ring

/-- **The refined bound is never worse than the unrefined one.**  `|sin| ≤ 1` pointwise, so the
sine-weighted Fourier integral is at most the plain one and `abs_cdfGapInt_le_of_charFun_sin`
implies `abs_cdfGapInt_le_of_charFun`.  It says nothing about how much smaller it is: at
`x − a` large the two are equal in the limit for a narrow-band weight, which is the sharpness
recorded in this block's header. -/
theorem integral_sinWeight_le (μ ν : Measure ℝ) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (h : ℝ) (hcf : IntegrableOn (fun u : ℝ => ‖charFun μ u - charFun ν u‖ / u ^ 2) (Set.Ioi 0)) :
    (∫ u in Set.Ioi (0:ℝ), |Real.sin (h * u / 2)| * ‖charFun μ u - charFun ν u‖ / u ^ 2)
      ≤ ∫ u in Set.Ioi (0:ℝ), ‖charFun μ u - charFun ν u‖ / u ^ 2 := by
  refine setIntegral_mono_on (integrableOn_sinWeight μ ν h hcf) hcf measurableSet_Ioi ?_
  intro u hu
  have hu2 : (0:ℝ) < u ^ 2 := pow_pos hu 2
  rw [div_le_div_iff_of_pos_right hu2]
  nlinarith [Real.abs_sin_le_one (h * u / 2), norm_nonneg (charFun μ u - charFun ν u)]

/-- **The mean-absolute-deviation gap, two points at once.**  For two probability laws with finite
first absolute moments and `u⁻²`-integrable characteristic-function gap,

  `|(∫|x − t| dμ − ∫|x − t| dν) − (∫|a − t| dμ − ∫|a − t| dν)|
     ≤ (∫₀^∞ 2|sin((x − a)u/2)|·‖φ_μ − φ_ν‖/u² du)/dirConst`.

`abs_integral_abs_sub_le` applied at `x` and at `a` and added gives the same statement with
`2·‖φ_μ − φ_ν‖` in place of `2|sin((x − a)u/2)|·‖φ_μ − φ_ν‖`, so this is the version that keeps
the cancellation.  It does **not** improve the supremum over `a` and `x`: see the block header. -/
theorem abs_integral_abs_sub_diff_le (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] (a x : ℝ)
    (hμx : Integrable (fun t : ℝ => |x - t|) μ) (hνx : Integrable (fun t : ℝ => |x - t|) ν)
    (hμa : Integrable (fun t : ℝ => |a - t|) μ) (hνa : Integrable (fun t : ℝ => |a - t|) ν)
    (hcf : IntegrableOn (fun u : ℝ => ‖charFun μ u - charFun ν u‖ / u ^ 2) (Set.Ioi 0)) :
    |((∫ t, |x - t| ∂μ) - ∫ t, |x - t| ∂ν) - ((∫ t, |a - t| ∂μ) - ∫ t, |a - t| ∂ν)|
      ≤ (∫ u in Set.Ioi (0:ℝ),
          2 * |Real.sin ((x - a) * u / 2)| * ‖charFun μ u - charFun ν u‖ / u ^ 2) / dirConst := by
  obtain ⟨hIμx, hJμx⟩ := integrableOn_and_integral_kernel_measure μ x hμx
  obtain ⟨hIνx, hJνx⟩ := integrableOn_and_integral_kernel_measure ν x hνx
  obtain ⟨hIμa, hJμa⟩ := integrableOn_and_integral_kernel_measure μ a hμa
  obtain ⟨hIνa, hJνa⟩ := integrableOn_and_integral_kernel_measure ν a hνa
  have hone : ∀ ρ : Measure ℝ, ∀ _ : IsProbabilityMeasure ρ, ∀ y u : ℝ,
      (∫ t, (1 - Real.cos ((y - t) * u)) ∂ρ) = 1 - ∫ t, Real.cos ((y - t) * u) ∂ρ := by
    intro ρ hρ y u
    haveI := hρ
    rw [integral_sub (integrable_const 1) (integrable_cos_shift ρ y u)]
    simp
  have hX : (∫ u in Set.Ioi (0:ℝ), ((∫ t, (1 - Real.cos ((x - t) * u)) ∂μ) / u ^ 2
        - (∫ t, (1 - Real.cos ((x - t) * u)) ∂ν) / u ^ 2))
      = dirConst * ((∫ t, |x - t| ∂μ) - ∫ t, |x - t| ∂ν) := by
    rw [integral_sub hIμx hIνx, hJμx, hJνx]; ring
  have hA : (∫ u in Set.Ioi (0:ℝ), ((∫ t, (1 - Real.cos ((a - t) * u)) ∂μ) / u ^ 2
        - (∫ t, (1 - Real.cos ((a - t) * u)) ∂ν) / u ^ 2))
      = dirConst * ((∫ t, |a - t| ∂μ) - ∫ t, |a - t| ∂ν) := by
    rw [integral_sub hIμa hIνa, hJμa, hJνa]; ring
  have hOuter : (∫ u in Set.Ioi (0:ℝ), (((∫ t, (1 - Real.cos ((x - t) * u)) ∂μ) / u ^ 2
          - (∫ t, (1 - Real.cos ((x - t) * u)) ∂ν) / u ^ 2)
        - ((∫ t, (1 - Real.cos ((a - t) * u)) ∂μ) / u ^ 2
          - (∫ t, (1 - Real.cos ((a - t) * u)) ∂ν) / u ^ 2)))
      = (∫ u in Set.Ioi (0:ℝ), ((∫ t, (1 - Real.cos ((x - t) * u)) ∂μ) / u ^ 2
          - (∫ t, (1 - Real.cos ((x - t) * u)) ∂ν) / u ^ 2))
        - (∫ u in Set.Ioi (0:ℝ), ((∫ t, (1 - Real.cos ((a - t) * u)) ∂μ) / u ^ 2
          - (∫ t, (1 - Real.cos ((a - t) * u)) ∂ν) / u ^ 2)) :=
    integral_sub (hIμx.sub hIνx) (hIμa.sub hIνa)
  have hdiff : dirConst * (((∫ t, |x - t| ∂μ) - ∫ t, |x - t| ∂ν)
        - ((∫ t, |a - t| ∂μ) - ∫ t, |a - t| ∂ν))
      = ∫ u in Set.Ioi (0:ℝ), (((∫ t, (1 - Real.cos ((x - t) * u)) ∂μ) / u ^ 2
            - (∫ t, (1 - Real.cos ((x - t) * u)) ∂ν) / u ^ 2)
          - ((∫ t, (1 - Real.cos ((a - t) * u)) ∂μ) / u ^ 2
            - (∫ t, (1 - Real.cos ((a - t) * u)) ∂ν) / u ^ 2)) := by
    rw [hOuter, hX, hA]; ring
  have hpt : ∀ u ∈ Set.Ioi (0:ℝ),
      |((∫ t, (1 - Real.cos ((x - t) * u)) ∂μ) / u ^ 2
            - (∫ t, (1 - Real.cos ((x - t) * u)) ∂ν) / u ^ 2)
          - ((∫ t, (1 - Real.cos ((a - t) * u)) ∂μ) / u ^ 2
            - (∫ t, (1 - Real.cos ((a - t) * u)) ∂ν) / u ^ 2)|
        ≤ 2 * |Real.sin ((x - a) * u / 2)| * ‖charFun μ u - charFun ν u‖ / u ^ 2 := by
    intro u hu
    have hu2 : (0:ℝ) < u ^ 2 := pow_pos hu 2
    have hcomb : (((∫ t, (1 - Real.cos ((x - t) * u)) ∂μ) / u ^ 2
            - (∫ t, (1 - Real.cos ((x - t) * u)) ∂ν) / u ^ 2)
          - ((∫ t, (1 - Real.cos ((a - t) * u)) ∂μ) / u ^ 2
            - (∫ t, (1 - Real.cos ((a - t) * u)) ∂ν) / u ^ 2))
        = (-(((∫ t, Real.cos ((x - t) * u) ∂μ) - ∫ t, Real.cos ((x - t) * u) ∂ν)
            - ((∫ t, Real.cos ((a - t) * u) ∂μ) - ∫ t, Real.cos ((a - t) * u) ∂ν))) / u ^ 2 := by
      rw [hone μ ‹_› x u, hone ν ‹_› x u, hone μ ‹_› a u, hone ν ‹_› a u]
      ring
    rw [hcomb, abs_div, abs_of_pos hu2, abs_neg, div_le_div_iff_of_pos_right hu2]
    exact abs_integral_cos_shift_diff_sub_le μ ν a x u
  have hsubint : IntegrableOn (fun u : ℝ => (((∫ t, (1 - Real.cos ((x - t) * u)) ∂μ) / u ^ 2
        - (∫ t, (1 - Real.cos ((x - t) * u)) ∂ν) / u ^ 2)
      - ((∫ t, (1 - Real.cos ((a - t) * u)) ∂μ) / u ^ 2
        - (∫ t, (1 - Real.cos ((a - t) * u)) ∂ν) / u ^ 2))) (Set.Ioi 0) :=
    (hIμx.sub hIνx).sub (hIμa.sub hIνa)
  have hmaj := integrableOn_two_sinWeight μ ν (x - a) hcf
  have habs : dirConst * |((∫ t, |x - t| ∂μ) - ∫ t, |x - t| ∂ν)
        - ((∫ t, |a - t| ∂μ) - ∫ t, |a - t| ∂ν)|
      ≤ ∫ u in Set.Ioi (0:ℝ),
          2 * |Real.sin ((x - a) * u / 2)| * ‖charFun μ u - charFun ν u‖ / u ^ 2 := by
    rw [← abs_of_pos dirConst_pos, ← abs_mul, hdiff]
    calc |∫ u in Set.Ioi (0:ℝ), (((∫ t, (1 - Real.cos ((x - t) * u)) ∂μ) / u ^ 2
              - (∫ t, (1 - Real.cos ((x - t) * u)) ∂ν) / u ^ 2)
            - ((∫ t, (1 - Real.cos ((a - t) * u)) ∂μ) / u ^ 2
              - (∫ t, (1 - Real.cos ((a - t) * u)) ∂ν) / u ^ 2))|
        ≤ ∫ u in Set.Ioi (0:ℝ), |((∫ t, (1 - Real.cos ((x - t) * u)) ∂μ) / u ^ 2
              - (∫ t, (1 - Real.cos ((x - t) * u)) ∂ν) / u ^ 2)
            - ((∫ t, (1 - Real.cos ((a - t) * u)) ∂μ) / u ^ 2
              - (∫ t, (1 - Real.cos ((a - t) * u)) ∂ν) / u ^ 2)| :=
          abs_integral_le_integral_abs
      _ ≤ _ := setIntegral_mono_on hsubint.abs hmaj measurableSet_Ioi hpt
  rw [le_div_iff₀ dirConst_pos]
  linarith [habs]

/-- **Fourier inversion for the once-integrated CDF gap, with the `x`-against-`a` cancellation
kept.**  For two probability laws with finite first absolute moments whose characteristic-function
gap is `u⁻²`-integrable on `(0, ∞)`, and for **every** pair `a`, `x`,

  `|cdfGapInt μ ν a x| ≤ (∫₀^∞ |sin((x − a)u/2)|·‖φ_μ(u) − φ_ν(u)‖/u² du)/dirConst`.

Since `|sin| ≤ 1` this implies `abs_cdfGapInt_le_of_charFun` (`integral_sinWeight_le`), so it is
never worse, and it is strictly better at every `u` where `|sin((x − a)u/2)| < 1`.  Both
statements are kept; neither weakens the other.

**What it does not do.**  It is still not a bound on `|cdf μ − cdf ν|`.  And it does **not**
improve the constant uniformly in `a` and `x`: taking `x − a = π/u₀` when the weight
`‖φ_μ − φ_ν‖/u²` is concentrated near `u₀` makes the sine factor `≈ 1` across the band, and such
weights are realised by pairs whose characteristic-function gap is a narrow bump near `±u₀`, for
which `G(y) = ∫(y − t)⁺ dμ − ∫(y − t)⁺ dν` is approximately a cosine in `y` and so attains both
`+B` and `−B`.  The factor `2` of `abs_cdfGapInt_le_of_charFun` is therefore **sharp** as a
statement about arbitrary pairs of laws, and the gain here is available only against a specific
weight.  At the weight §58b produces the gain is a factor `1.39` at `d = 512` and a spread
direction, not `2`; that number is numerical, is not formalised, and is not used below.  The leg-1
bounds of §58c and §58c′ are proved from `abs_cdfGapInt_le_of_charFun`, not from this. -/
theorem abs_cdfGapInt_le_of_charFun_sin (μ ν : Measure ℝ) [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν] (hμ : ∀ y : ℝ, Integrable (fun t : ℝ => |y - t|) μ)
    (hν : ∀ y : ℝ, Integrable (fun t : ℝ => |y - t|) ν)
    (hcf : IntegrableOn (fun u : ℝ => ‖charFun μ u - charFun ν u‖ / u ^ 2) (Set.Ioi 0))
    (a x : ℝ) :
    |Threshold.cdfGapInt μ ν a x|
      ≤ (∫ u in Set.Ioi (0:ℝ),
          |Real.sin ((x - a) * u / 2)| * ‖charFun μ u - charFun ν u‖ / u ^ 2) / dirConst := by
  set J : ℝ := ∫ u in Set.Ioi (0:ℝ),
    |Real.sin ((x - a) * u / 2)| * ‖charFun μ u - charFun ν u‖ / u ^ 2 with hJdef
  have hJnn : 0 ≤ J := by
    rw [hJdef]
    exact setIntegral_nonneg measurableSet_Ioi fun u _ => by positivity
  have hInn : 0 ≤ J / dirConst := div_nonneg hJnn dirConst_pos.le
  have htwo : (∫ u in Set.Ioi (0:ℝ),
        2 * |Real.sin ((x - a) * u / 2)| * ‖charFun μ u - charFun ν u‖ / u ^ 2) = 2 * J := by
    rw [hJdef, ← integral_const_mul]
    exact integral_congr_ae (Filter.Eventually.of_forall fun u => by ring)
  rcases le_or_gt a x with hax | hax
  · have hclamp : ∀ ρ : Measure ℝ, ∀ _ : IsProbabilityMeasure ρ,
        Integrable (fun t : ℝ => |x - t|) ρ → Integrable (fun t : ℝ => |a - t|) ρ →
        (∫ t, (max (x - t) 0 - max (a - t) 0) ∂ρ)
          = ((x - a) + ((∫ t, |x - t| ∂ρ) - ∫ t, |a - t| ∂ρ)) / 2 := by
      intro ρ hρ hix hia
      haveI := hρ
      have hpt : ∀ t : ℝ, max (x - t) 0 - max (a - t) 0
          = ((x - a) + (|x - t| - |a - t|)) / 2 := by
        intro t
        rw [max_eq_add_abs_div_two (x - t), max_eq_add_abs_div_two (a - t)]; ring
      have hd : Integrable (fun t : ℝ => |x - t| - |a - t|) ρ := hix.sub hia
      simp_rw [hpt]
      rw [integral_div, integral_add (integrable_const (x - a)) hd, integral_sub hix hia]
      simp
    rw [Threshold.cdfGapInt_eq_integral_clamp_sub μ ν hax, hclamp μ ‹_› (hμ x) (hμ a),
      hclamp ν ‹_› (hν x) (hν a),
      show ((x - a) + ((∫ t, |x - t| ∂μ) - ∫ t, |a - t| ∂μ)) / 2
          - ((x - a) + ((∫ t, |x - t| ∂ν) - ∫ t, |a - t| ∂ν)) / 2
        = (((∫ t, |x - t| ∂μ) - ∫ t, |x - t| ∂ν)
            - ((∫ t, |a - t| ∂μ) - ∫ t, |a - t| ∂ν)) / 2 by ring,
      abs_div, abs_of_nonneg (by norm_num : (0:ℝ) ≤ 2)]
    have h := abs_integral_abs_sub_diff_le μ ν a x (hμ x) (hν x) (hμ a) (hν a) hcf
    rw [htwo] at h
    rw [div_le_iff₀ (by norm_num : (0:ℝ) < 2)]
    have h2 : 2 * J / dirConst = J / dirConst * 2 := by ring
    linarith [h]
  · have hempty : Set.Ioc a x = (∅ : Set ℝ) := Set.Ioc_eq_empty (by linarith)
    rw [Threshold.cdfGapInt, hempty, Measure.restrict_empty, integral_zero_measure, abs_zero]
    exact hInn


/-! ### Elementary integrals used by the two-range estimate -/

/-- `e^{−z} ≤ 2/z²` for `z > 0`, from `1 + z + z²/2 ≤ e^z`. -/
theorem exp_neg_le_two_div_sq {z : ℝ} (hz : 0 < z) : Real.exp (-z) ≤ 2 / z ^ 2 := by
  have hq := Real.quadratic_le_exp_of_nonneg hz.le
  have hge : z ^ 2 / 2 ≤ Real.exp z := by linarith
  have hpos : (0:ℝ) < z ^ 2 / 2 := by positivity
  rw [Real.exp_neg]
  calc (Real.exp z)⁻¹ ≤ (z ^ 2 / 2)⁻¹ := by
        exact inv_anti₀ hpos hge
    _ = 2 / z ^ 2 := by field_simp

/-- `z² ≤ 4·e^{z−2}` for `z ≥ 0`: square `z/2 ≤ e^{z/2 − 1}`, which is `1 + y ≤ e^y` at
`y = z/2 − 1`.  Equality holds at `z = 2` and nowhere else, so this is the sharp quadratic
comparison for the exponential and `4e^{−2}` below cannot be lowered. -/
theorem sq_le_four_mul_exp_sub_two {z : ℝ} (hz : 0 ≤ z) : z ^ 2 ≤ 4 * Real.exp (z - 2) := by
  have h : z / 2 ≤ Real.exp (z / 2 - 1) := by
    have h1 := Real.add_one_le_exp (z / 2 - 1)
    linarith
  have hexp : Real.exp (z - 2) = Real.exp (z / 2 - 1) * Real.exp (z / 2 - 1) := by
    rw [← Real.exp_add]; congr 1; ring
  rw [hexp]
  nlinarith [Real.exp_pos (z / 2 - 1)]

/-- `36/5 < e²`.  The true value is `7.389…`; `36/5 = 7.2` is all that the constant `5/9` of
`exp_neg_le_five_ninths_div_sq` needs, and nothing here evaluates `e²`. -/
theorem exp_two_gt : (36:ℝ) / 5 < Real.exp 2 := by
  have h : (2.7182818283 : ℝ) < Real.exp 1 := Real.exp_one_gt_d9
  have he : Real.exp 2 = Real.exp 1 * Real.exp 1 := by
    rw [← Real.exp_add]; norm_num
  rw [he]
  nlinarith [h]

/-- **The sharp middle-range damping estimate**, `e^{−z} ≤ (5/9)/z²` for `z > 0`.  The extremal
constant for a bound of this shape is `max_{z>0} z²e^{−z} = 4e^{−2} = 0.5413…`, attained at
`z = 2`; the rational `5/9 = 0.5555…` used here loses `2.6%` against it, and **no** `k < 4e^{−2}`
works in `e^{−z} ≤ k/z²`.  Against `exp_neg_le_two_div_sq`, the same inequality with `2` in place
of `5/9` and the version §58b used, this is a factor `18/5 = 3.6`.

What it does **not** do: it is still a pointwise bound on the Gaussian damping factor, so the
`∫₀^∞ u²e^{−u²/(4d)} du = √π·d^{3/2}` that the damped range really contributes is not reached.
The best any split of `(0, ∞)` into `e^{−z} ≤ 1` and `e^{−z} ≤ 4e^{−2}/z²` can give is
`(16/3)(4e^{−2})^{3/4}·∑ⱼvⱼ⁴/√d = 3.36·∑ⱼvⱼ⁴/√d`, against the true `√π·∑ⱼvⱼ⁴/√d = 1.77·…`;
the split at `√d` kept below gives `83/18 = 4.61`.  `exp_neg_le_two_div_sq` is untouched. -/
theorem exp_neg_le_five_ninths_div_sq {z : ℝ} (hz : 0 < z) : Real.exp (-z) ≤ 5 / 9 / z ^ 2 := by
  have hz2 : (0:ℝ) < z ^ 2 := by positivity
  have hez : (0:ℝ) < Real.exp z := Real.exp_pos z
  have hmul : z ^ 2 * Real.exp 2 ≤ 4 * Real.exp z := by
    have h := sq_le_four_mul_exp_sub_two hz.le
    have hsum : Real.exp (z - 2) * Real.exp 2 = Real.exp z := by
      rw [← Real.exp_add]; congr 1; ring
    calc z ^ 2 * Real.exp 2 ≤ 4 * Real.exp (z - 2) * Real.exp 2 :=
          mul_le_mul_of_nonneg_right h (Real.exp_pos 2).le
      _ = 4 * Real.exp z := by rw [mul_assoc, hsum]
  have hfin : z ^ 2 ≤ 5 / 9 * Real.exp z := by
    nlinarith [hmul, mul_pos hz2 (sub_pos.mpr exp_two_gt)]
  rw [le_div_iff₀ hz2, Real.exp_neg, inv_mul_eq_div, div_le_iff₀ hez]
  linarith

theorem integrableOn_const_div_sq {c : ℝ} (hc : 0 < c) (k : ℝ) :
    IntegrableOn (fun u : ℝ => k / u ^ 2) (Set.Ioi c) := by
  have hbase : IntegrableOn (fun u : ℝ => u ^ (-2 : ℝ)) (Set.Ioi c) :=
    integrableOn_Ioi_rpow_of_lt (by norm_num) hc
  have h2 : IntegrableOn (fun u : ℝ => k * u ^ (-2 : ℝ)) (Set.Ioi c) := hbase.const_mul k
  refine h2.congr_fun (fun u hu => ?_) measurableSet_Ioi
  show k * u ^ (-2 : ℝ) = k / u ^ 2
  rw [rpow_neg_two (lt_trans hc hu), mul_one_div]

theorem integral_Ioi_const_div_sq {c : ℝ} (hc : 0 < c) (k : ℝ) :
    ∫ u in Set.Ioi c, k / u ^ 2 = k / c := by
  have hcongr : ∀ u ∈ Set.Ioi c, k / u ^ 2 = k * u ^ (-2 : ℝ) := by
    intro u hu
    rw [rpow_neg_two (lt_trans hc hu)]; ring
  rw [setIntegral_congr_fun measurableSet_Ioi hcongr, integral_const_mul,
    integral_Ioi_rpow_of_lt (by norm_num) hc]
  rw [show (-2 : ℝ) + 1 = -1 by norm_num, Real.rpow_neg_one]
  field_simp

theorem integral_Ioc_sq {b : ℝ} (hb : 0 ≤ b) : ∫ u in Set.Ioc (0:ℝ) b, u ^ 2 = b ^ 3 / 3 := by
  rw [← intervalIntegral.integral_of_le hb, integral_pow]
  norm_num

theorem integrableOn_sq_Ioc (b : ℝ) : IntegrableOn (fun u : ℝ => u ^ 2) (Set.Ioc (0:ℝ) b) :=
  (continuous_pow 2).integrableOn_Ioc


/-! ### §58b  The two-range estimate for the deployed coordinate law

From here on the pair is fixed: `coordLaw H v i` against `N(0, 1/d)` at a **unit** direction `v`.
The only inputs are §44's damped characteristic-function bound and `‖φ‖ ≤ 1`. -/

section Deployed

open Orthogonal Hadamard

variable {d : ℕ}

/-- At a unit direction the Gaussian of §44 is `N(0, 1/d)`. -/
theorem gaussian_unit {v : Ed d} (hv : ‖v‖ = 1) :
    gaussianReal 0 (Real.toNNReal (‖v‖ ^ 2 / (d:ℝ)))
      = gaussianReal 0 (Real.toNNReal (1 / (d:ℝ))) := by
  rw [hv]; norm_num

/-- §44's damped bound at a unit direction, on the range `u·M ≤ √d` that a sup-norm bound `M` on
the coordinates of `v` certifies. -/
theorem norm_gap_le_damped {H : Od d} (hH : IsFlat H) {v : Ed d} (hv : ‖v‖ = 1) (i : Fin d)
    {M u : ℝ} (hM : ∀ j, |v j| ≤ M) (hu : 0 < u) (huM : u * M ≤ Real.sqrt d) :
    ‖charFun (coordLaw H v i) u - charFun (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) u‖
      ≤ u ^ 4 * (∑ j, v j ^ 4) / (2 * (d:ℝ) ^ 2) * Real.exp (-(u ^ 2 / (d:ℝ)) / 4) := by
  have ht : ∀ j, |u * v j| ≤ Real.sqrt d := by
    intro j
    rw [abs_mul, abs_of_pos hu]
    exact le_trans (by gcongr; exact hM j) huM
  have h := norm_charFun_coordLaw_sub_gaussian_le_damped hH v i ht
  rw [hv] at h
  norm_num at h
  rw [one_div]
  exact h

theorem norm_charFun_sub_le_two (μ ν : Measure ℝ) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (u : ℝ) : ‖charFun μ u - charFun ν u‖ ≤ 2 := by
  calc ‖charFun μ u - charFun ν u‖ ≤ ‖charFun μ u‖ + ‖charFun ν u‖ := norm_sub_le _ _
    _ ≤ 1 + 1 := add_le_add (norm_charFun_le_one _) (norm_charFun_le_one _)
    _ = 2 := by norm_num


/-- The `u⁻²`-weighted characteristic-function gap of the pair leg 1 compares: the integrand of
the inversion bound. -/
def gapWeight (H : Od d) (v : Ed d) (i : Fin d) (u : ℝ) : ℝ :=
  ‖charFun (coordLaw H v i) u - charFun (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) u‖ / u ^ 2

theorem gapWeight_nonneg (H : Od d) (v : Ed d) (i : Fin d) (u : ℝ) : 0 ≤ gapWeight H v i u :=
  div_nonneg (norm_nonneg _) (sq_nonneg u)

theorem measurable_gapWeight (H : Od d) (v : Ed d) (i : Fin d) :
    Measurable (gapWeight H v i) := by
  have hc : Continuous fun u : ℝ => charFun (coordLaw H v i) u
      - charFun (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) u :=
    continuous_charFun.sub continuous_charFun
  exact hc.norm.measurable.div (by fun_prop)

/-- **Low range.**  For `0 < u ≤ √d` the damped bound of §44 gives `gapWeight ≤ (∑ⱼvⱼ⁴/(2d²))·u²`;
the damping factor is thrown away here. -/
theorem gapWeight_le_low {H : Od d} (hH : IsFlat H) {v : Ed d} (hv : ‖v‖ = 1) (i : Fin d)
    {M : ℝ} (hM : ∀ j, |v j| ≤ M) (hM1 : M ≤ 1) {u : ℝ} (hu : 0 < u)
    (hud : u ≤ Real.sqrt d) :
    gapWeight H v i u ≤ (∑ j, v j ^ 4) / (2 * (d:ℝ) ^ 2) * u ^ 2 := by
  have hM0 : 0 ≤ M := le_trans (abs_nonneg _) (hM i)
  have huM : u * M ≤ Real.sqrt d := le_trans (by nlinarith) hud
  have h := norm_gap_le_damped hH hv i hM hu huM
  have hS : 0 ≤ ∑ j, v j ^ 4 := Finset.sum_nonneg fun j _ => by positivity
  have hexp : Real.exp (-(u ^ 2 / (d:ℝ)) / 4) ≤ 1 := by
    rw [Real.exp_le_one_iff]
    have : 0 ≤ u ^ 2 / (d:ℝ) := by positivity
    linarith
  have hA : (0:ℝ) ≤ u ^ 4 * (∑ j, v j ^ 4) / (2 * (d:ℝ) ^ 2) := by positivity
  rw [gapWeight, div_le_iff₀ (pow_pos hu 2)]
  calc ‖charFun (coordLaw H v i) u - charFun (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) u‖
      ≤ u ^ 4 * (∑ j, v j ^ 4) / (2 * (d:ℝ) ^ 2) * Real.exp (-(u ^ 2 / (d:ℝ)) / 4) := h
    _ ≤ u ^ 4 * (∑ j, v j ^ 4) / (2 * (d:ℝ) ^ 2) * 1 := by gcongr
    _ = (∑ j, v j ^ 4) / (2 * (d:ℝ) ^ 2) * u ^ 2 * u ^ 2 := by ring

/-- **Middle range.**  For `√d < u` with `u·M ≤ √d`, the Gaussian damping `e^{−u²/(4d)} ≤ 32d²/u⁴`
turns the quartic growth into the integrable `16·∑ⱼvⱼ⁴/u²`. -/
theorem gapWeight_le_mid {H : Od d} (hH : IsFlat H) {v : Ed d} (hv : ‖v‖ = 1) (i : Fin d)
    {M : ℝ} (hM : ∀ j, |v j| ≤ M) {u : ℝ} (hd0 : (0:ℝ) < (d:ℝ)) (hu : 0 < u)
    (huM : u * M ≤ Real.sqrt d) :
    gapWeight H v i u ≤ 16 * (∑ j, v j ^ 4) / u ^ 2 := by
  have h := norm_gap_le_damped hH hv i hM hu huM
  have hS : 0 ≤ ∑ j, v j ^ 4 := Finset.sum_nonneg fun j _ => by positivity
  have hz : (0:ℝ) < u ^ 2 / (4 * (d:ℝ)) := by positivity
  have hexp : Real.exp (-(u ^ 2 / (d:ℝ)) / 4) ≤ 2 / (u ^ 2 / (4 * (d:ℝ))) ^ 2 := by
    have heq : -(u ^ 2 / (d:ℝ)) / 4 = -(u ^ 2 / (4 * (d:ℝ))) := by ring
    rw [heq]
    exact exp_neg_le_two_div_sq hz
  have hA : (0:ℝ) ≤ u ^ 4 * (∑ j, v j ^ 4) / (2 * (d:ℝ) ^ 2) := by positivity
  have hkey : u ^ 4 * (∑ j, v j ^ 4) / (2 * (d:ℝ) ^ 2) * (2 / (u ^ 2 / (4 * (d:ℝ))) ^ 2)
      = 16 * (∑ j, v j ^ 4) := by
    field_simp
    ring
  rw [gapWeight, div_le_div_iff_of_pos_right (pow_pos hu 2)]
  calc ‖charFun (coordLaw H v i) u - charFun (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) u‖
      ≤ u ^ 4 * (∑ j, v j ^ 4) / (2 * (d:ℝ) ^ 2) * Real.exp (-(u ^ 2 / (d:ℝ)) / 4) := h
    _ ≤ u ^ 4 * (∑ j, v j ^ 4) / (2 * (d:ℝ) ^ 2) * (2 / (u ^ 2 / (4 * (d:ℝ))) ^ 2) := by gcongr
    _ = 16 * (∑ j, v j ^ 4) := hkey

/-- **Middle range, sharpened.**  `gapWeight_le_mid` with the extremal damping constant of
`exp_neg_le_five_ninths_div_sq` in place of `exp_neg_le_two_div_sq`: for `√d < u` with
`u·M ≤ √d`, `e^{−u²/(4d)} ≤ (5/9)(4d/u²)²` replaces `16·∑ⱼvⱼ⁴/u²` by `(40/9)·∑ⱼvⱼ⁴/u²`, a
factor `18/5 = 3.6`.

The floor for this argument is `32e^{−2}·∑ⱼvⱼ⁴/u² = 4.33·∑ⱼvⱼ⁴/u²`, since `4e^{−2}` is the
largest value of `z²e^{−z}`; `40/9 = 4.44` is within `2.6%` of it.  Reaching the `√π·∑ⱼvⱼ⁴/√d`
that the Gaussian tail really contributes needs the damping factor integrated rather than bounded
pointwise, which is not done here.  `gapWeight_le_mid` is kept and is not weakened. -/
theorem gapWeight_le_mid_sharp {H : Od d} (hH : IsFlat H) {v : Ed d} (hv : ‖v‖ = 1) (i : Fin d)
    {M : ℝ} (hM : ∀ j, |v j| ≤ M) {u : ℝ} (hd0 : (0:ℝ) < (d:ℝ)) (hu : 0 < u)
    (huM : u * M ≤ Real.sqrt d) :
    gapWeight H v i u ≤ 40 / 9 * (∑ j, v j ^ 4) / u ^ 2 := by
  have h := norm_gap_le_damped hH hv i hM hu huM
  have hS : 0 ≤ ∑ j, v j ^ 4 := Finset.sum_nonneg fun j _ => by positivity
  have hz : (0:ℝ) < u ^ 2 / (4 * (d:ℝ)) := by positivity
  have hexp : Real.exp (-(u ^ 2 / (d:ℝ)) / 4) ≤ 5 / 9 / (u ^ 2 / (4 * (d:ℝ))) ^ 2 := by
    have heq : -(u ^ 2 / (d:ℝ)) / 4 = -(u ^ 2 / (4 * (d:ℝ))) := by ring
    rw [heq]
    exact exp_neg_le_five_ninths_div_sq hz
  have hA : (0:ℝ) ≤ u ^ 4 * (∑ j, v j ^ 4) / (2 * (d:ℝ) ^ 2) := by positivity
  have hkey : u ^ 4 * (∑ j, v j ^ 4) / (2 * (d:ℝ) ^ 2) * (5 / 9 / (u ^ 2 / (4 * (d:ℝ))) ^ 2)
      = 40 / 9 * (∑ j, v j ^ 4) := by
    field_simp
    ring
  rw [gapWeight, div_le_div_iff_of_pos_right (pow_pos hu 2)]
  calc ‖charFun (coordLaw H v i) u - charFun (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) u‖
      ≤ u ^ 4 * (∑ j, v j ^ 4) / (2 * (d:ℝ) ^ 2) * Real.exp (-(u ^ 2 / (d:ℝ)) / 4) := h
    _ ≤ u ^ 4 * (∑ j, v j ^ 4) / (2 * (d:ℝ) ^ 2) * (5 / 9 / (u ^ 2 / (4 * (d:ℝ))) ^ 2) := by
        gcongr
    _ = 40 / 9 * (∑ j, v j ^ 4) := hkey

/-- **High range.**  Beyond `√d/M` nothing is known about the atomic law's characteristic function
and the trivial bound `‖φ_μ − φ_ν‖ ≤ 2` is used; this term is what stops the estimate short of
`Θ(d^{-3/2})`. -/
theorem gapWeight_le_high (H : Od d) (v : Ed d) (i : Fin d) {u : ℝ} (hu : 0 < u) :
    gapWeight H v i u ≤ 2 / u ^ 2 := by
  rw [gapWeight, div_le_div_iff_of_pos_right (pow_pos hu 2)]
  exact norm_charFun_sub_le_two _ _ u


/-! ### Integrability and the two-range integral estimate -/

theorem integrableOn_gapWeight_Ioc {H : Od d} (hH : IsFlat H) {v : Ed d} (hv : ‖v‖ = 1)
    (i : Fin d) {M : ℝ} (hM : ∀ j, |v j| ≤ M) (hM1 : M ≤ 1) :
    IntegrableOn (gapWeight H v i) (Set.Ioc 0 (Real.sqrt d)) := by
  have hg : IntegrableOn (fun u : ℝ => (∑ j, v j ^ 4) / (2 * (d:ℝ) ^ 2) * u ^ 2)
      (Set.Ioc (0:ℝ) (Real.sqrt d)) := (integrableOn_sq_Ioc _).const_mul _
  refine hg.mono' (measurable_gapWeight H v i).aestronglyMeasurable ?_
  filter_upwards [ae_restrict_mem measurableSet_Ioc] with u hu
  rw [Real.norm_eq_abs, abs_of_nonneg (gapWeight_nonneg H v i u)]
  exact gapWeight_le_low hH hv i hM hM1 hu.1 hu.2

theorem integrableOn_gapWeight_Ioi (H : Od d) (v : Ed d) (i : Fin d) (hd0 : (0:ℝ) < (d:ℝ)) :
    IntegrableOn (gapWeight H v i) (Set.Ioi (Real.sqrt d)) := by
  have hsd : 0 < Real.sqrt d := Real.sqrt_pos.mpr hd0
  refine (integrableOn_const_div_sq hsd 2).mono'
    (measurable_gapWeight H v i).aestronglyMeasurable ?_
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with u hu
  rw [Real.norm_eq_abs, abs_of_nonneg (gapWeight_nonneg H v i u)]
  exact gapWeight_le_high H v i (lt_trans hsd hu)

theorem Ioi_zero_split (b : ℝ) (hb : 0 < b) : Set.Ioi (0:ℝ) = Set.Ioc 0 b ∪ Set.Ioi b := by
  ext u
  simp only [Set.mem_Ioi, Set.mem_union, Set.mem_Ioc]
  constructor
  · intro h
    rcases le_or_gt u b with h1 | h1
    · exact Or.inl ⟨h, h1⟩
    · exact Or.inr h1
  · rintro (⟨h, -⟩ | h)
    · exact h
    · linarith

theorem Ioi_split {b c : ℝ} (hbc : b ≤ c) : Set.Ioi b = Set.Ioc b c ∪ Set.Ioi c := by
  ext u
  simp only [Set.mem_Ioi, Set.mem_union, Set.mem_Ioc]
  constructor
  · intro h
    rcases le_or_gt u c with h1 | h1
    · exact Or.inl ⟨h, h1⟩
    · exact Or.inr h1
  · rintro (⟨h, -⟩ | h)
    · exact h
    · linarith

theorem integrableOn_gapWeight {H : Od d} (hH : IsFlat H) {v : Ed d} (hv : ‖v‖ = 1) (i : Fin d)
    {M : ℝ} (hM : ∀ j, |v j| ≤ M) (hM1 : M ≤ 1) (hd0 : (0:ℝ) < (d:ℝ)) :
    IntegrableOn (gapWeight H v i) (Set.Ioi 0) := by
  rw [Ioi_zero_split _ (Real.sqrt_pos.mpr hd0)]
  exact (integrableOn_gapWeight_Ioc hH hv i hM hM1).union
    (integrableOn_gapWeight_Ioi H v i hd0)

theorem arith_three {S M r : ℝ} (hr : 0 < r) :
    S / (2 * (r ^ 2) ^ 2) * (r ^ 3 / 3) + (16 * S / r + 2 * M / r)
      = (97 / 6 * S + 2 * M) / r := by
  field_simp
  ring

/-- **The two-range estimate.**  For a unit direction `v` whose coordinates are bounded by
`M ≤ 1`, the `u⁻²`-weighted characteristic-function gap of leg 1 integrates to at most
`(97/6·∑ⱼvⱼ⁴ + 2M)/√d`.  The first term is the damped Gaussian comparison of §44 on
`|u| ≤ √d/M`; the second is the trivial bound `‖φ_μ − φ_ν‖ ≤ 2` beyond that range, and it is the
term that dominates. -/
theorem integral_gapWeight_le {H : Od d} (hH : IsFlat H) {v : Ed d} (hv : ‖v‖ = 1) (i : Fin d)
    {M : ℝ} (hM : ∀ j, |v j| ≤ M) (hM0 : 0 < M) (hM1 : M ≤ 1) (hd0 : (0:ℝ) < (d:ℝ)) :
    (∫ u in Set.Ioi (0:ℝ), gapWeight H v i u)
      ≤ (97 / 6 * (∑ j, v j ^ 4) + 2 * M) / Real.sqrt d := by
  have hsd : 0 < Real.sqrt d := Real.sqrt_pos.mpr hd0
  set S : ℝ := ∑ j, v j ^ 4 with hSdef
  have hS : 0 ≤ S := Finset.sum_nonneg fun j _ => by positivity
  set T : ℝ := Real.sqrt d / M with hTdef
  have hTpos : 0 < T := div_pos hsd hM0
  have hTge : Real.sqrt d ≤ T := by
    rw [hTdef, le_div_iff₀ hM0]
    nlinarith
  have hintA : IntegrableOn (gapWeight H v i) (Set.Ioc 0 (Real.sqrt d)) :=
    integrableOn_gapWeight_Ioc hH hv i hM hM1
  have hintBC : IntegrableOn (gapWeight H v i) (Set.Ioi (Real.sqrt d)) :=
    integrableOn_gapWeight_Ioi H v i hd0
  have hintB : IntegrableOn (gapWeight H v i) (Set.Ioc (Real.sqrt d) T) :=
    hintBC.mono_set fun u hu => hu.1
  have hintC : IntegrableOn (gapWeight H v i) (Set.Ioi T) :=
    hintBC.mono_set fun u hu => lt_of_le_of_lt hTge hu
  have hdisj1 : Disjoint (Set.Ioc (0:ℝ) (Real.sqrt d)) (Set.Ioi (Real.sqrt d)) := by
    rw [Set.disjoint_left]
    intro u hu hu'
    exact absurd hu' (not_lt.mpr hu.2)
  have hdisj2 : Disjoint (Set.Ioc (Real.sqrt d) T) (Set.Ioi T) := by
    rw [Set.disjoint_left]
    intro u hu hu'
    exact absurd hu' (not_lt.mpr hu.2)
  have hE : (∫ u in Set.Ioi (0:ℝ), gapWeight H v i u)
      = (∫ u in Set.Ioc (0:ℝ) (Real.sqrt d), gapWeight H v i u)
        + ((∫ u in Set.Ioc (Real.sqrt d) T, gapWeight H v i u)
          + ∫ u in Set.Ioi T, gapWeight H v i u) := by
    rw [Ioi_zero_split _ hsd, setIntegral_union hdisj1 measurableSet_Ioi hintA hintBC]
    congr 1
    rw [Ioi_split hTge, setIntegral_union hdisj2 measurableSet_Ioi hintB hintC]
  have hA : (∫ u in Set.Ioc (0:ℝ) (Real.sqrt d), gapWeight H v i u)
      ≤ S / (2 * (d:ℝ) ^ 2) * (Real.sqrt d ^ 3 / 3) := by
    have hmaj : IntegrableOn (fun u : ℝ => S / (2 * (d:ℝ) ^ 2) * u ^ 2)
        (Set.Ioc (0:ℝ) (Real.sqrt d)) := (integrableOn_sq_Ioc _).const_mul _
    calc (∫ u in Set.Ioc (0:ℝ) (Real.sqrt d), gapWeight H v i u)
        ≤ ∫ u in Set.Ioc (0:ℝ) (Real.sqrt d), S / (2 * (d:ℝ) ^ 2) * u ^ 2 :=
          setIntegral_mono_on hintA hmaj measurableSet_Ioc fun u hu =>
            gapWeight_le_low hH hv i hM hM1 hu.1 hu.2
      _ = S / (2 * (d:ℝ) ^ 2) * (Real.sqrt d ^ 3 / 3) := by
          rw [integral_const_mul, integral_Ioc_sq hsd.le]
  have hB : (∫ u in Set.Ioc (Real.sqrt d) T, gapWeight H v i u) ≤ 16 * S / Real.sqrt d := by
    have hmaj : IntegrableOn (fun u : ℝ => 16 * S / u ^ 2) (Set.Ioi (Real.sqrt d)) :=
      integrableOn_const_div_sq hsd (16 * S)
    have hmajB : IntegrableOn (fun u : ℝ => 16 * S / u ^ 2) (Set.Ioc (Real.sqrt d) T) :=
      hmaj.mono_set fun u hu => hu.1
    calc (∫ u in Set.Ioc (Real.sqrt d) T, gapWeight H v i u)
        ≤ ∫ u in Set.Ioc (Real.sqrt d) T, 16 * S / u ^ 2 :=
          setIntegral_mono_on hintB hmajB measurableSet_Ioc fun u hu =>
            gapWeight_le_mid hH hv i hM hd0 (lt_trans hsd hu.1) ((le_div_iff₀ hM0).mp hu.2)
      _ ≤ ∫ u in Set.Ioi (Real.sqrt d), 16 * S / u ^ 2 := by
          refine setIntegral_mono_set hmaj ?_ (Filter.Eventually.of_forall fun u hu => hu.1)
          filter_upwards [ae_restrict_mem measurableSet_Ioi] with u hu
          have : 0 < u := lt_trans hsd hu
          positivity
      _ = 16 * S / Real.sqrt d := integral_Ioi_const_div_sq hsd _
  have hC : (∫ u in Set.Ioi T, gapWeight H v i u) ≤ 2 * M / Real.sqrt d := by
    have hmaj : IntegrableOn (fun u : ℝ => 2 / u ^ 2) (Set.Ioi T) :=
      integrableOn_const_div_sq hTpos 2
    calc (∫ u in Set.Ioi T, gapWeight H v i u)
        ≤ ∫ u in Set.Ioi T, 2 / u ^ 2 :=
          setIntegral_mono_on hintC hmaj measurableSet_Ioi fun u hu =>
            gapWeight_le_high H v i (lt_trans hTpos hu)
      _ = 2 / T := integral_Ioi_const_div_sq hTpos 2
      _ = 2 * M / Real.sqrt d := by rw [hTdef]; field_simp
  have harith := arith_three (S := S) (M := M) hsd
  rw [Real.sq_sqrt hd0.le] at harith
  calc (∫ u in Set.Ioi (0:ℝ), gapWeight H v i u)
      = (∫ u in Set.Ioc (0:ℝ) (Real.sqrt d), gapWeight H v i u)
        + ((∫ u in Set.Ioc (Real.sqrt d) T, gapWeight H v i u)
          + ∫ u in Set.Ioi T, gapWeight H v i u) := hE
    _ ≤ S / (2 * (d:ℝ) ^ 2) * (Real.sqrt d ^ 3 / 3) + (16 * S / Real.sqrt d
          + 2 * M / Real.sqrt d) := add_le_add hA (add_le_add hB hC)
    _ = (97 / 6 * S + 2 * M) / Real.sqrt d := harith


theorem arith_three_sharp {S M r : ℝ} (hr : 0 < r) :
    S / (2 * (r ^ 2) ^ 2) * (r ^ 3 / 3) + (40 / 9 * S / r + 2 * M / r)
      = (83 / 18 * S + 2 * M) / r := by
  field_simp
  ring

/-- **The two-range estimate, sharpened.**  `integral_gapWeight_le` with `gapWeight_le_mid_sharp`
in place of `gapWeight_le_mid`: for a unit direction `v` whose coordinates are bounded by
`M ≤ 1`,

  `∫₀^∞ ‖φ_μ − φ_ν‖/u² du ≤ (83/18·∑ⱼvⱼ⁴ + 2M)/√d`,

against the `(97/6·∑ⱼvⱼ⁴ + 2M)/√d` of `integral_gapWeight_le`.  The spikiness coefficient
improves by `97/6 ÷ 83/18 = 3.51`; `97/6 = 16.17` was `16` from the middle range plus `1/6` from
the low range, and `83/18 = 4.61` is `40/9` plus the same `1/6`.

**The `2M` is untouched.**  It comes from `gapWeight_le_high`, the range `u > √d/M` on which this
development knows nothing about the atomic law's characteristic function beyond `‖φ‖ ≤ 1`, and it
is the term that dominates at a spread direction.  Nothing here improves it, and it is the
largest single piece of slack left on this route.  `integral_gapWeight_le` is kept as it was. -/
theorem integral_gapWeight_le_sharp {H : Od d} (hH : IsFlat H) {v : Ed d} (hv : ‖v‖ = 1)
    (i : Fin d) {M : ℝ} (hM : ∀ j, |v j| ≤ M) (hM0 : 0 < M) (hM1 : M ≤ 1)
    (hd0 : (0:ℝ) < (d:ℝ)) :
    (∫ u in Set.Ioi (0:ℝ), gapWeight H v i u)
      ≤ (83 / 18 * (∑ j, v j ^ 4) + 2 * M) / Real.sqrt d := by
  have hsd : 0 < Real.sqrt d := Real.sqrt_pos.mpr hd0
  set S : ℝ := ∑ j, v j ^ 4 with hSdef
  have hS : 0 ≤ S := Finset.sum_nonneg fun j _ => by positivity
  set T : ℝ := Real.sqrt d / M with hTdef
  have hTpos : 0 < T := div_pos hsd hM0
  have hTge : Real.sqrt d ≤ T := by
    rw [hTdef, le_div_iff₀ hM0]
    nlinarith
  have hintA : IntegrableOn (gapWeight H v i) (Set.Ioc 0 (Real.sqrt d)) :=
    integrableOn_gapWeight_Ioc hH hv i hM hM1
  have hintBC : IntegrableOn (gapWeight H v i) (Set.Ioi (Real.sqrt d)) :=
    integrableOn_gapWeight_Ioi H v i hd0
  have hintB : IntegrableOn (gapWeight H v i) (Set.Ioc (Real.sqrt d) T) :=
    hintBC.mono_set fun u hu => hu.1
  have hintC : IntegrableOn (gapWeight H v i) (Set.Ioi T) :=
    hintBC.mono_set fun u hu => lt_of_le_of_lt hTge hu
  have hdisj1 : Disjoint (Set.Ioc (0:ℝ) (Real.sqrt d)) (Set.Ioi (Real.sqrt d)) := by
    rw [Set.disjoint_left]
    intro u hu hu'
    exact absurd hu' (not_lt.mpr hu.2)
  have hdisj2 : Disjoint (Set.Ioc (Real.sqrt d) T) (Set.Ioi T) := by
    rw [Set.disjoint_left]
    intro u hu hu'
    exact absurd hu' (not_lt.mpr hu.2)
  have hE : (∫ u in Set.Ioi (0:ℝ), gapWeight H v i u)
      = (∫ u in Set.Ioc (0:ℝ) (Real.sqrt d), gapWeight H v i u)
        + ((∫ u in Set.Ioc (Real.sqrt d) T, gapWeight H v i u)
          + ∫ u in Set.Ioi T, gapWeight H v i u) := by
    rw [Ioi_zero_split _ hsd, setIntegral_union hdisj1 measurableSet_Ioi hintA hintBC]
    congr 1
    rw [Ioi_split hTge, setIntegral_union hdisj2 measurableSet_Ioi hintB hintC]
  have hA : (∫ u in Set.Ioc (0:ℝ) (Real.sqrt d), gapWeight H v i u)
      ≤ S / (2 * (d:ℝ) ^ 2) * (Real.sqrt d ^ 3 / 3) := by
    have hmaj : IntegrableOn (fun u : ℝ => S / (2 * (d:ℝ) ^ 2) * u ^ 2)
        (Set.Ioc (0:ℝ) (Real.sqrt d)) := (integrableOn_sq_Ioc _).const_mul _
    calc (∫ u in Set.Ioc (0:ℝ) (Real.sqrt d), gapWeight H v i u)
        ≤ ∫ u in Set.Ioc (0:ℝ) (Real.sqrt d), S / (2 * (d:ℝ) ^ 2) * u ^ 2 :=
          setIntegral_mono_on hintA hmaj measurableSet_Ioc fun u hu =>
            gapWeight_le_low hH hv i hM hM1 hu.1 hu.2
      _ = S / (2 * (d:ℝ) ^ 2) * (Real.sqrt d ^ 3 / 3) := by
          rw [integral_const_mul, integral_Ioc_sq hsd.le]
  have hB : (∫ u in Set.Ioc (Real.sqrt d) T, gapWeight H v i u) ≤ 40 / 9 * S / Real.sqrt d := by
    have hmaj : IntegrableOn (fun u : ℝ => 40 / 9 * S / u ^ 2) (Set.Ioi (Real.sqrt d)) :=
      integrableOn_const_div_sq hsd (40 / 9 * S)
    have hmajB : IntegrableOn (fun u : ℝ => 40 / 9 * S / u ^ 2) (Set.Ioc (Real.sqrt d) T) :=
      hmaj.mono_set fun u hu => hu.1
    calc (∫ u in Set.Ioc (Real.sqrt d) T, gapWeight H v i u)
        ≤ ∫ u in Set.Ioc (Real.sqrt d) T, 40 / 9 * S / u ^ 2 :=
          setIntegral_mono_on hintB hmajB measurableSet_Ioc fun u hu =>
            gapWeight_le_mid_sharp hH hv i hM hd0 (lt_trans hsd hu.1) ((le_div_iff₀ hM0).mp hu.2)
      _ ≤ ∫ u in Set.Ioi (Real.sqrt d), 40 / 9 * S / u ^ 2 := by
          refine setIntegral_mono_set hmaj ?_ (Filter.Eventually.of_forall fun u hu => hu.1)
          filter_upwards [ae_restrict_mem measurableSet_Ioi] with u hu
          have : 0 < u := lt_trans hsd hu
          positivity
      _ = 40 / 9 * S / Real.sqrt d := integral_Ioi_const_div_sq hsd _
  have hC : (∫ u in Set.Ioi T, gapWeight H v i u) ≤ 2 * M / Real.sqrt d := by
    have hmaj : IntegrableOn (fun u : ℝ => 2 / u ^ 2) (Set.Ioi T) :=
      integrableOn_const_div_sq hTpos 2
    calc (∫ u in Set.Ioi T, gapWeight H v i u)
        ≤ ∫ u in Set.Ioi T, 2 / u ^ 2 :=
          setIntegral_mono_on hintC hmaj measurableSet_Ioi fun u hu =>
            gapWeight_le_high H v i (lt_trans hTpos hu)
      _ = 2 / T := integral_Ioi_const_div_sq hTpos 2
      _ = 2 * M / Real.sqrt d := by rw [hTdef]; field_simp
  have harith := arith_three_sharp (S := S) (M := M) hsd
  rw [Real.sq_sqrt hd0.le] at harith
  calc (∫ u in Set.Ioi (0:ℝ), gapWeight H v i u)
      = (∫ u in Set.Ioc (0:ℝ) (Real.sqrt d), gapWeight H v i u)
        + ((∫ u in Set.Ioc (Real.sqrt d) T, gapWeight H v i u)
          + ∫ u in Set.Ioi T, gapWeight H v i u) := hE
    _ ≤ S / (2 * (d:ℝ) ^ 2) * (Real.sqrt d ^ 3 / 3) + (40 / 9 * S / Real.sqrt d
          + 2 * M / Real.sqrt d) := add_le_add hA (add_le_add hB hC)
    _ = (83 / 18 * S + 2 * M) / Real.sqrt d := harith


/-! ### Spikiness bookkeeping -/

theorem sum_pow_four_nonneg (v : Ed d) : 0 ≤ ∑ j, v j ^ 4 :=
  Finset.sum_nonneg fun j _ => by positivity

/-- `∑ⱼ vⱼ⁴ ≤ 1` at a unit direction, since `∑ aⱼ² ≤ (∑ aⱼ)²` for nonnegative `aⱼ`. -/
theorem sum_pow_four_le_one {v : Ed d} (hv : ‖v‖ = 1) : (∑ j, v j ^ 4) ≤ 1 := by
  have hsum : ∑ j, v j ^ 2 = 1 := by
    have h := norm_sq_eq_sum_sq v
    rw [hv] at h
    simpa using h.symm
  calc ∑ j, v j ^ 4 = ∑ j, (v j ^ 2) ^ 2 := Finset.sum_congr rfl fun j _ => by ring
    _ ≤ (∑ j, v j ^ 2) ^ 2 := sum_sq_le_sq_sum_of_nonneg fun j _ => sq_nonneg _
    _ = 1 := by rw [hsum]; norm_num

/-- `0 < ∑ⱼ vⱼ⁴` at a unit direction: a vanishing fourth-power sum forces `v = 0`. -/
theorem sum_pow_four_pos {v : Ed d} (hv : ‖v‖ = 1) : 0 < ∑ j, v j ^ 4 := by
  rcases (sum_pow_four_nonneg v).lt_or_eq with h | h
  · exact h
  · exfalso
    have hz : ∀ j ∈ Finset.univ, v j ^ 4 = 0 :=
      (Finset.sum_eq_zero_iff_of_nonneg fun j _ => by positivity).mp h.symm
    have hsum : ∑ j, v j ^ 2 = 0 :=
      Finset.sum_eq_zero fun j hj => by have := hz j hj; nlinarith [sq_nonneg (v j)]
    have h2 := norm_sq_eq_sum_sq v
    rw [hv, hsum] at h2
    norm_num at h2

/-- Every coordinate is bounded by `(∑ⱼ vⱼ⁴)^{1/4}`, which is the sup-norm bound the estimate
below consumes when none is supplied. -/
theorem abs_coord_le_sqrt_sqrt (v : Ed d) (j : Fin d) :
    |v j| ≤ Real.sqrt (Real.sqrt (∑ k, v k ^ 4)) := by
  have hS : 0 ≤ ∑ k, v k ^ 4 := sum_pow_four_nonneg v
  have h1 : v j ^ 4 ≤ ∑ k, v k ^ 4 :=
    Finset.single_le_sum (f := fun k => v k ^ 4) (fun k _ => by positivity) (Finset.mem_univ j)
  have h2 : |v j| ^ 2 ≤ Real.sqrt (∑ k, v k ^ 4) := by
    rw [Real.le_sqrt (by positivity) hS]
    calc (|v j| ^ 2) ^ 2 = v j ^ 4 := by rw [sq_abs]; ring
      _ ≤ _ := h1
  rw [Real.le_sqrt (abs_nonneg _) (Real.sqrt_nonneg _)]
  exact h2


/-! ### The two first-moment facts leg 1 needs -/

theorem integrable_abs_sub_coordLaw (H : Od d) (v : Ed d) (i : Fin d) (y : ℝ) :
    Integrable (fun t : ℝ => |y - t|) (coordLaw H v i) :=
  Integrable.abs (Integrable.sub (integrable_const y) (Threshold.integrable_id_coordLaw H v i))

theorem integrable_abs_sub_gaussianReal (σ : NNReal) (y : ℝ) :
    Integrable (fun t : ℝ => |y - t|) (gaussianReal 0 σ) :=
  Integrable.abs (Integrable.sub (integrable_const y)
    (IsGaussian.integrable_fun_id : Integrable (fun t : ℝ => t) (gaussianReal 0 σ)))

end Deployed

end FourierGap

/-! ### §58c  Leg 1

The estimate of §58b, fed through the inversion bound of §58a.  Only the two statements below
leave the `FourierGap` namespace. -/

section Leg1

open Orthogonal Hadamard FourierGap

variable {d : ℕ}

/-- **Leg 1, in `cdfGapInt` form, with an explicit sup-norm bound on the direction.**  For `d ≥ 2`,
a flat `H`, a **unit** direction `v` whose coordinates satisfy `|vⱼ| ≤ M` with `0 < M ≤ 1`, any
coordinate `i` and **every** pair `a`, `x`,

  `|cdfGapInt (coordLaw H v i) (N(0, 1/d)) a x| ≤ (15·∑ⱼvⱼ⁴ + 2M)/√d`.

The route is Fourier inversion of the once-integrated CDF gap
(`abs_cdfGapInt_le_of_charFun`) fed with §44's damped characteristic-function bound on
`|u| ≤ √d/M` and the trivial bound `‖φ_μ − φ_ν‖ ≤ 2` beyond it.

**What this is not.**  It is not a Kolmogorov-Smirnov bound: `|cdf μ − cdf ν|` is not bounded
here, so §55 and §56 in their sup-norm form are not discharged by it.  It is one leg only: the
second law is the Gaussian `N(0, 1/d)`, not `sphericalCoordLaw d`, and nothing here composes it
with `abs_cdfGapInt_sphericalCoordLaw_gaussian_le`.  The constant is not claimed to be optimal;
in particular the kernel constant is used here only through the lower bound `9/8` where its exact
value `π/2` is available as `dirConst_eq` and is used in §58d's primed form of this statement,
and the `2M/√d` term comes from a range beyond which nothing is known about the atomic law's
characteristic function, so the bound decays like `M/√d` and not like the `d^{-3/2}` that the
leading term `15·∑ⱼvⱼ⁴/√d` alone would give at a spread direction. -/
theorem abs_cdfGapInt_coordLaw_gaussian_le_of_bound (hd : 2 ≤ d) {H : Od d} (hH : IsFlat H)
    {v : Ed d} (hv : ‖v‖ = 1) (i : Fin d) {M : ℝ} (hM : ∀ j, |v j| ≤ M) (hM0 : 0 < M)
    (hM1 : M ≤ 1) (a x : ℝ) :
    |Threshold.cdfGapInt (coordLaw H v i) (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) a x|
      ≤ (15 * (∑ j, v j ^ 4) + 2 * M) / Real.sqrt d := by
  have hd0 : (0:ℝ) < (d:ℝ) := by exact_mod_cast (by omega : (0:ℕ) < d)
  have hsd : 0 < Real.sqrt d := Real.sqrt_pos.mpr hd0
  have hS : 0 ≤ ∑ j, v j ^ 4 := sum_pow_four_nonneg v
  have hcf : IntegrableOn (fun u : ℝ => ‖charFun (coordLaw H v i) u
      - charFun (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) u‖ / u ^ 2) (Set.Ioi 0) :=
    integrableOn_gapWeight hH hv i hM hM1 hd0
  have hI : (∫ u in Set.Ioi (0:ℝ), ‖charFun (coordLaw H v i) u
      - charFun (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) u‖ / u ^ 2)
      ≤ (97 / 6 * (∑ j, v j ^ 4) + 2 * M) / Real.sqrt d :=
    integral_gapWeight_le hH hv i hM hM0 hM1 hd0
  have hInn : 0 ≤ ∫ u in Set.Ioi (0:ℝ), ‖charFun (coordLaw H v i) u
      - charFun (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) u‖ / u ^ 2 :=
    setIntegral_nonneg measurableSet_Ioi fun u _ => by positivity
  refine (abs_cdfGapInt_le_of_charFun (coordLaw H v i)
    (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ))))
    (integrable_abs_sub_coordLaw H v i) (integrable_abs_sub_gaussianReal _) hcf a x).trans ?_
  have hstep : (∫ u in Set.Ioi (0:ℝ), ‖charFun (coordLaw H v i) u
      - charFun (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) u‖ / u ^ 2) / dirConst
      ≤ 8 / 9 * ∫ u in Set.Ioi (0:ℝ), ‖charFun (coordLaw H v i) u
          - charFun (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) u‖ / u ^ 2 := by
    rw [div_le_iff₀ dirConst_pos]
    nlinarith [dirConst_ge, hInn]
  refine hstep.trans ?_
  have hnum : 8 / 9 * (97 / 6 * (∑ j, v j ^ 4) + 2 * M) ≤ 15 * (∑ j, v j ^ 4) + 2 * M := by
    nlinarith [hS, hM0.le]
  calc 8 / 9 * ∫ u in Set.Ioi (0:ℝ), ‖charFun (coordLaw H v i) u
          - charFun (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) u‖ / u ^ 2
      ≤ 8 / 9 * ((97 / 6 * (∑ j, v j ^ 4) + 2 * M) / Real.sqrt d) := by gcongr
    _ = (8 / 9 * (97 / 6 * (∑ j, v j ^ 4) + 2 * M)) / Real.sqrt d := by ring
    _ ≤ (15 * (∑ j, v j ^ 4) + 2 * M) / Real.sqrt d := by gcongr

/-- **Leg 1, in `cdfGapInt` form, in the spikiness alone.**  Taking `M = (∑ⱼ vⱼ⁴)^{1/4}`, which is
a valid coordinate bound at any direction and is `≤ 1` at a unit one,

  `|cdfGapInt (coordLaw H v i) (N(0, 1/d)) a x| ≤ (15·∑ⱼvⱼ⁴ + 2·(∑ⱼvⱼ⁴)^{1/4})/√d`

for every `a` and `x`.  At a maximally spread direction, where `|vⱼ| = d^{-1/2}` and so
`∑ⱼ vⱼ⁴ = 1/d`, the right-hand side is `15·d^{-3/2} + 2·d^{-3/4}`; at a coordinate direction,
where `∑ⱼ vⱼ⁴ = 1`, it is `17/√d`.  Both tend to zero in `d`, which is the point of measuring the
gap by `cdfGapInt` rather than by a sup norm; but the sup-norm hypothesis `η` of §55 and §56 is a
different quantity and is not supplied by this or any statement here.

The caveats of `abs_cdfGapInt_coordLaw_gaussian_le_of_bound` apply verbatim: this is not a
Kolmogorov-Smirnov bound, it is one leg only, it is not composed with §57's leg anywhere, and the
constants are not claimed optimal. -/
theorem abs_cdfGapInt_coordLaw_gaussian_le (hd : 2 ≤ d) {H : Od d} (hH : IsFlat H) {v : Ed d}
    (hv : ‖v‖ = 1) (i : Fin d) (a x : ℝ) :
    |Threshold.cdfGapInt (coordLaw H v i) (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) a x|
      ≤ (15 * (∑ j, v j ^ 4) + 2 * Real.sqrt (Real.sqrt (∑ j, v j ^ 4))) / Real.sqrt d := by
  have hpos : 0 < ∑ j, v j ^ 4 := sum_pow_four_pos hv
  have hle : (∑ j, v j ^ 4) ≤ 1 := sum_pow_four_le_one hv
  refine abs_cdfGapInt_coordLaw_gaussian_le_of_bound hd hH hv i (abs_coord_le_sqrt_sqrt v)
    (Real.sqrt_pos.mpr (Real.sqrt_pos.mpr hpos)) ?_ a x
  calc Real.sqrt (Real.sqrt (∑ j, v j ^ 4)) ≤ Real.sqrt (Real.sqrt 1) := by
        gcongr
    _ = 1 := by simp

/-- **Leg 1 at a spread direction.**  If every coordinate of the unit direction `v` satisfies
`|vⱼ| ≤ d^{-1/2}`, which is the flat case and the smallest such bound a unit vector admits, then

  `|cdfGapInt (coordLaw H v i) (N(0, 1/d)) a x| ≤ 15·∑ⱼvⱼ⁴/√d + 2/d`

for every `a` and `x`; and `∑ⱼvⱼ⁴ ≤ 1/d` under that hypothesis, so the right-hand side is at most
`15·d^{-3/2} + 2·d^{-1}`.  This is the instance of `abs_cdfGapInt_coordLaw_gaussian_le_of_bound`
at `M = d^{-1/2}` and nothing more; the second term still comes from the range on which the atomic
law's characteristic function is not controlled, and the caveats there apply verbatim. -/
theorem abs_cdfGapInt_coordLaw_gaussian_le_of_spread (hd : 2 ≤ d) {H : Od d} (hH : IsFlat H)
    {v : Ed d} (hv : ‖v‖ = 1) (i : Fin d) (hspread : ∀ j, |v j| ≤ 1 / Real.sqrt d) (a x : ℝ) :
    |Threshold.cdfGapInt (coordLaw H v i) (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) a x|
      ≤ (15 * (∑ j, v j ^ 4) + 2 * (1 / Real.sqrt d)) / Real.sqrt d := by
  have hd0 : (0:ℝ) < (d:ℝ) := by exact_mod_cast (by omega : (0:ℕ) < d)
  have hsd : 0 < Real.sqrt d := Real.sqrt_pos.mpr hd0
  have h1 : (1:ℝ) ≤ Real.sqrt d := by
    rw [show (1:ℝ) = Real.sqrt 1 by simp]
    exact Real.sqrt_le_sqrt (by exact_mod_cast (by omega : (1:ℕ) ≤ d))
  exact abs_cdfGapInt_coordLaw_gaussian_le_of_bound hd hH hv i hspread (by positivity)
    (by rw [div_le_one hsd]; exact h1) a x

/-! ### §58d  The same leg with the Dirichlet constant evaluated

`dirConst_eq` replaces the lower bound `9/8` by the exact value `π/2`, so the division by
`dirConst` costs `2/π ≈ 0.6366` rather than `8/9 ≈ 0.8889`.  Each statement below is its unprimed
counterpart with that substitution and nothing else; the unprimed ones are retained unchanged.
The rational constants are rounded up from `(2/π)·(97/6) ≈ 10.292` to `21/2` and from
`(2/π)·2 ≈ 1.273` to `13/10`, which loses a further `2%` in each.  Every caveat recorded on the
unprimed statements applies verbatim: these are not Kolmogorov-Smirnov bounds, they are one leg
only, and the slack listed at `dirConst_eq` is untouched. -/

/-- **Leg 1 with the Dirichlet constant evaluated.**  For `d ≥ 2`, a flat `H`, a unit direction `v`
with `|vⱼ| ≤ M` and `0 < M ≤ 1`, any coordinate `i` and every pair `a`, `x`,

  `|cdfGapInt (coordLaw H v i) (N(0, 1/d)) a x| ≤ ((21/2)·∑ⱼvⱼ⁴ + (13/10)·M)/√d`.

This is `abs_cdfGapInt_coordLaw_gaussian_le_of_bound` with `dirConst_eq` in place of
`dirConst_ge`, improving `15` to `21/2` and `2` to `13/10`.  It is still not a Kolmogorov-Smirnov
bound, still one leg only, and the `M/√d` term still comes from a range beyond which nothing is
known about the atomic law's characteristic function. -/
theorem abs_cdfGapInt_coordLaw_gaussian_le_of_bound' (hd : 2 ≤ d) {H : Od d} (hH : IsFlat H)
    {v : Ed d} (hv : ‖v‖ = 1) (i : Fin d) {M : ℝ} (hM : ∀ j, |v j| ≤ M) (hM0 : 0 < M)
    (hM1 : M ≤ 1) (a x : ℝ) :
    |Threshold.cdfGapInt (coordLaw H v i) (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) a x|
      ≤ (21 / 2 * (∑ j, v j ^ 4) + 13 / 10 * M) / Real.sqrt d := by
  have hd0 : (0:ℝ) < (d:ℝ) := by exact_mod_cast (by omega : (0:ℕ) < d)
  have hsd : 0 < Real.sqrt d := Real.sqrt_pos.mpr hd0
  have hS : 0 ≤ ∑ j, v j ^ 4 := sum_pow_four_nonneg v
  have hcf : IntegrableOn (fun u : ℝ => ‖charFun (coordLaw H v i) u
      - charFun (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) u‖ / u ^ 2) (Set.Ioi 0) :=
    integrableOn_gapWeight hH hv i hM hM1 hd0
  have hI : (∫ u in Set.Ioi (0:ℝ), ‖charFun (coordLaw H v i) u
      - charFun (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) u‖ / u ^ 2)
      ≤ (97 / 6 * (∑ j, v j ^ 4) + 2 * M) / Real.sqrt d :=
    integral_gapWeight_le hH hv i hM hM0 hM1 hd0
  refine (abs_cdfGapInt_le_of_charFun (coordLaw H v i)
    (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ))))
    (integrable_abs_sub_coordLaw H v i) (integrable_abs_sub_gaussianReal _) hcf a x).trans ?_
  have hstep : (∫ u in Set.Ioi (0:ℝ), ‖charFun (coordLaw H v i) u
      - charFun (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) u‖ / u ^ 2) / dirConst
      = 2 / π * ∫ u in Set.Ioi (0:ℝ), ‖charFun (coordLaw H v i) u
          - charFun (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) u‖ / u ^ 2 := by
    rw [dirConst_eq]
    field_simp
  have hkey : 2 / π * (97 / 6 * (∑ j, v j ^ 4) + 2 * M)
      ≤ 21 / 2 * (∑ j, v j ^ 4) + 13 / 10 * M := by
    rw [div_mul_eq_mul_div, div_le_iff₀ Real.pi_pos]
    nlinarith [Real.pi_gt_d2, hS, hM0.le,
      mul_nonneg (by linarith : (0:ℝ) ≤ 21 / 2 * (∑ j, v j ^ 4) + 13 / 10 * M)
        (by linarith [Real.pi_gt_d2] : (0:ℝ) ≤ π - 3.14)]
  rw [hstep]
  calc 2 / π * ∫ u in Set.Ioi (0:ℝ), ‖charFun (coordLaw H v i) u
          - charFun (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) u‖ / u ^ 2
      ≤ 2 / π * ((97 / 6 * (∑ j, v j ^ 4) + 2 * M) / Real.sqrt d) :=
        mul_le_mul_of_nonneg_left hI (by positivity)
    _ = (2 / π * (97 / 6 * (∑ j, v j ^ 4) + 2 * M)) / Real.sqrt d := by ring
    _ ≤ (21 / 2 * (∑ j, v j ^ 4) + 13 / 10 * M) / Real.sqrt d := by gcongr

/-- **Leg 1 in the spikiness alone, with the Dirichlet constant evaluated:**

  `|cdfGapInt (coordLaw H v i) (N(0, 1/d)) a x| ≤ ((21/2)·∑ⱼvⱼ⁴ + (13/10)·(∑ⱼvⱼ⁴)^{1/4})/√d`.

The sharpened form of `abs_cdfGapInt_coordLaw_gaussian_le`, whose caveats apply verbatim. -/
theorem abs_cdfGapInt_coordLaw_gaussian_le' (hd : 2 ≤ d) {H : Od d} (hH : IsFlat H) {v : Ed d}
    (hv : ‖v‖ = 1) (i : Fin d) (a x : ℝ) :
    |Threshold.cdfGapInt (coordLaw H v i) (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) a x|
      ≤ (21 / 2 * (∑ j, v j ^ 4) + 13 / 10 * Real.sqrt (Real.sqrt (∑ j, v j ^ 4)))
          / Real.sqrt d := by
  have hpos : 0 < ∑ j, v j ^ 4 := sum_pow_four_pos hv
  refine abs_cdfGapInt_coordLaw_gaussian_le_of_bound' hd hH hv i (abs_coord_le_sqrt_sqrt v)
    (Real.sqrt_pos.mpr (Real.sqrt_pos.mpr hpos)) ?_ a x
  calc Real.sqrt (Real.sqrt (∑ j, v j ^ 4)) ≤ Real.sqrt (Real.sqrt 1) := by
        gcongr
        exact sum_pow_four_le_one hv
    _ = 1 := by simp

/-- **Leg 1 at a spread direction, with the Dirichlet constant evaluated:**

  `|cdfGapInt (coordLaw H v i) (N(0, 1/d)) a x| ≤ ((21/2)·∑ⱼvⱼ⁴ + (13/10)/√d)/√d`.

The sharpened form of `abs_cdfGapInt_coordLaw_gaussian_le_of_spread`, whose caveats apply
verbatim. -/
theorem abs_cdfGapInt_coordLaw_gaussian_le_of_spread' (hd : 2 ≤ d) {H : Od d} (hH : IsFlat H)
    {v : Ed d} (hv : ‖v‖ = 1) (i : Fin d) (hspread : ∀ j, |v j| ≤ 1 / Real.sqrt d) (a x : ℝ) :
    |Threshold.cdfGapInt (coordLaw H v i) (gaussianReal 0 (Real.toNNReal (1 / (d:ℝ)))) a x|
      ≤ (21 / 2 * (∑ j, v j ^ 4) + 13 / 10 * (1 / Real.sqrt d)) / Real.sqrt d := by
  have hd0 : (0:ℝ) < (d:ℝ) := by exact_mod_cast (by omega : (0:ℕ) < d)
  have hsd : 0 < Real.sqrt d := Real.sqrt_pos.mpr hd0
  have h1 : (1:ℝ) ≤ Real.sqrt d := by
    rw [show (1:ℝ) = Real.sqrt 1 by simp]
    exact Real.sqrt_le_sqrt (by exact_mod_cast (by omega : (1:ℕ) ≤ d))
  exact abs_cdfGapInt_coordLaw_gaussian_le_of_bound' hd hH hv i hspread (by positivity)
    (by rw [div_le_one hsd]; exact h1) a x

/-! ### §58c′  Leg 1 with the sharp damping constant

The same three statements with `integral_gapWeight_le_sharp` in place of `integral_gapWeight_le`.
Only the spikiness coefficient moves, `15 → 41/10`; the `2M` term, which dominates at a spread
direction, is identical.  The originals above are kept and are not weakened by these. -/

/-- **Leg 1 with an explicit sup-norm bound, sharpened.**  For `d ≥ 2`, a flat `H`, a unit
direction `v` with `|vⱼ| ≤ M` and `0 < M ≤ 1`, any `i` and **every** pair `a`, `x`,

  `|cdfGapInt (coordLaw H v i) (N(0, 1/d)) a x| ≤ (41/10·∑ⱼvⱼ⁴ + 2M)/√d`,

against `15·∑ⱼvⱼ⁴ + 2M` in `abs_cdfGapInt_coordLaw_gaussian_le_of_bound`: a factor `3.66` on the
spikiness term and nothing at all on `2M`.

**What has not changed.**  It is not a Kolmogorov-Smirnov bound, it is one leg only, and the
route, the hypotheses and the caveats of `abs_cdfGapInt_coordLaw_gaussian_le_of_bound` are those
